2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] function prg(bytes: Uint8Array): string[] {
2025-12-08 13:03:20 [gemini-3-pro] 	// Invert tokens map for lookup (Value -> Key)
2025-12-08 13:03:20 [gemini-3-pro] 	const tokenMap = new Map<number, string>();
2025-12-08 13:03:20 [gemini-3-pro] 	for (const [k, v] of Object.entries(c64_tokens)) {
2025-12-08 13:03:20 [gemini-3-pro] 		tokenMap.set(v, k);
2025-12-08 13:03:20 [gemini-3-pro] 	}
2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] 	const lines: string[] = [];
2025-12-08 13:03:20 [gemini-3-pro] 	let pc = 2; // Skip Load Address (usually 0x0801)
2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] 	while (pc < bytes.length - 1) {
2025-12-08 13:03:20 [gemini-3-pro] 		// Line Header: [NextLo, NextHi, LineLo, LineHi]
2025-12-08 13:03:20 [gemini-3-pro] 		const nextLo = bytes[pc++];
2025-12-08 13:03:20 [gemini-3-pro] 		const nextHi = bytes[pc++];
2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] 		if (nextLo === 0 && nextHi === 0) break; // End of Program
2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] 		const lineNum = bytes[pc++] + (bytes[pc++] << 8);
2025-12-08 13:03:20 [gemini-3-pro] 		let line = `${lineNum} `;
2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] 		// Parse Line Content
2025-12-08 13:03:20 [gemini-3-pro] 		while (pc < bytes.length) {
2025-12-08 13:03:20 [gemini-3-pro] 			const b = bytes[pc++];
2025-12-08 13:03:20 [gemini-3-pro] 			if (b === 0) break; // End of Line
2025-12-08 13:03:20 [gemini-3-pro] 
2025-12-08 13:03:20 [gemini-3-pro] 			if (b > 127 && tokenMap.has(b)) {
2025-12-08 13:03:20 [gemini-3-pro] 				line += tokenMap.get(b) + " "; // Add space after token for readability
2025-12-08 13:03:20 [gemini-3-pro] 			} else {
2025-12-08 13:03:20 [gemini-3-pro] 				// Simple PETSCII to ASCII mapping (sufficient for basic alphanumeric)
2025-12-08 13:03:20 [gemini-3-pro] 				const char = b >= 65 && b <= 90 ? String.fromCharCode(b + 32) : String.fromCharCode(b);
2025-12-08 13:03:20 [gemini-3-pro] 				line += char;
2025-12-08 13:03:20 [gemini-3-pro] 			}
2025-12-08 13:03:20 [gemini-3-pro] 		}
2025-12-08 13:03:20 [gemini-3-pro] 		lines.push(line.trim());
2025-12-08 13:03:20 [gemini-3-pro] 	}
2025-12-08 13:03:20 [gemini-3-pro] 	return lines;
2025-12-08 13:03:20 [gemini-3-pro] }
