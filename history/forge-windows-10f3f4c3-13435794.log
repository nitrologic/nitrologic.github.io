2025-12-06 11:38:20 [gemini-3-pro] 				}
2025-12-06 11:38:20 [gemini-3-pro] 			}
2025-12-06 11:38:20 [gemini-3-pro] 		}
2025-12-06 11:38:20 [gemini-3-pro] 		emit(dict.get(prefix)!);
2025-12-06 11:38:20 [gemini-3-pro] 		emit(eoiCode);
2025-12-06 11:38:20 [gemini-3-pro] 		if(bits>0)out.push(buf&255);
