2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] # pull in the SDK
2025-12-12 13:16:20 [kimi-k2-0905] include(${PICO_SDK_PATH}/external/pico_sdk_import.cmake)
2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] project(my_pico2_app C CXX ASM)
2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] # optional chip-wide flags
2025-12-12 13:16:20 [kimi-k2-0905] add_compile_definitions(
2025-12-12 13:16:20 [kimi-k2-0905]     PICO_STDIO_USB_ENABLE_RESET_VIA_BAUD_RATE=0
2025-12-12 13:16:20 [kimi-k2-0905]     PICO_STDIO_USB_ENABLE_RESET_VIA_VENDOR_INTERFACE=0
2025-12-12 13:16:20 [kimi-k2-0905] )
2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] # initialise the SDK (must be after project())
2025-12-12 13:16:20 [kimi-k2-0905] pico_sdk_init()
2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] # your targets follow
2025-12-12 13:16:20 [kimi-k2-0905] add_executable(my_app
2025-12-12 13:16:20 [kimi-k2-0905]     main.c
2025-12-12 13:16:20 [kimi-k2-0905] )
2025-12-12 13:16:20 [kimi-k2-0905] target_link_libraries(my_app pico_stdlib)
2025-12-12 13:16:20 [kimi-k2-0905] pico_enable_stdio_usb(my_app 1)
2025-12-12 13:16:20 [kimi-k2-0905] pico_enable_stdio_uart(my_app 0)
2025-12-12 13:16:20 [kimi-k2-0905] pico_add_extra_outputs(my_app)
2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] 
2025-12-12 13:16:20 [kimi-k2-0905] Build in a separate folder (`build-rp2350`) and you’re done—no second `CMakeLists.txt`, no repeated
