2025-12-21 22:48:45 [gemini-3-pro] 	sm_config_set_fifo_join(&config[SyncIndex], PIO_FIFO_JOIN_RX);
2025-12-21 22:48:45 [gemini-3-pro] 
2025-12-21 22:48:45 [gemini-3-pro] 	int status1 = pio_sm_init(pio, SyncIndex, offset1, &config[SyncIndex]);
2025-12-21 22:48:45 [gemini-3-pro] 
2025-12-21 22:48:45 [gemini-3-pro] 	// --- SampleIndex Setup ---
2025-12-21 22:48:45 [gemini-3-pro] 	const pio_program_t *program2 = &luma2sample_program;
2025-12-21 22:48:45 [gemini-3-pro] 	uint offset2 = pio_add_program(pio, program2);
2025-12-21 22:48:45 [gemini-3-pro] 	config[SampleIndex] = luma2sample_program_get_default_config(offset2);
2025-12-21 22:48:45 [gemini-3-pro] 
2025-12-21 22:48:45 [gemini-3-pro] 	pio_gpio_init(pio, 3);
2025-12-21 22:48:45 [gemini-3-pro] 	gpio_pull_up(3);
2025-12-21 22:48:45 [gemini-3-pro] 
2025-12-21 22:48:45 [gemini-3-pro] 	sm_config_set_in_pins(&config[SampleIndex], 3);
2025-12-21 22:48:45 [gemini-3-pro] 	sm_config_set_in_shift(&config[SampleIndex], true, true, 1);
2025-12-21 22:48:45 [gemini-3-pro] 
2025-12-21 22:48:45 [gemini-3-pro] 	// FIX: Sample pulls data, so we want a deep TX FIFO (JOIN_TX), not RX.
2025-12-21 22:48:45 [gemini-3-pro] 	// Note: If Sample also pushes data back to CPU, do not join FIFOs (leave default).
2025-12-21 22:48:45 [gemini-3-pro] 	// Assuming it only consumes sync data:
2025-12-21 22:48:45 [gemini-3-pro] 	sm_config_set_fifo_join(&config[SampleIndex], PIO_FIFO_JOIN_TX);
2025-12-21 22:48:45 [gemini-3-pro] 
