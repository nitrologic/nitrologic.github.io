2025-12-10 11:57:14 [kimi-k2-0905] // ip232-chat.js
2025-12-10 11:57:14 [kimi-k2-0905] // listens on 25232, sends every C64 line back as
2025-12-10 11:57:14 [kimi-k2-0905] // "YOU SAID: <upper-cased line>", then CRLF
2025-12-10 11:57:14 [kimi-k2-0905] 
2025-12-10 11:57:14 [kimi-k2-0905] import { serve } from "jsr:@std/net";
2025-12-10 11:57:14 [kimi-k2-0905] 
2025-12-10 11:57:14 [kimi-k2-0905] const port = 25232;
2025-12-10 11:57:14 [kimi-k2-0905] const enc = new TextEncoder();
2025-12-10 11:57:14 [kimi-k2-0905] const dec = new TextDecoder();
2025-12-10 11:57:14 [kimi-k2-0905] 
2025-12-10 11:57:14 [kimi-k2-0905] function send(conn, str) {
2025-12-10 11:57:14 [kimi-k2-0905] 	conn.write(enc.encode(str + "\r\n"));
2025-12-10 11:57:14 [kimi-k2-0905] }
2025-12-10 11:57:14 [kimi-k2-0905] 
2025-12-10 11:57:14 [kimi-k2-0905] async function handle(conn) {
2025-12-10 11:57:14 [kimi-k2-0905] 	console.log("client connected");
2025-12-10 11:57:14 [kimi-k2-0905] 	try {
2025-12-10 11:57:14 [kimi-k2-0905] 		const buf = new Uint8Array(1024);
2025-12-10 11:57:14 [kimi-k2-0905] 		let line = "";
2025-12-10 11:57:14 [kimi-k2-0905] 		while (true) {
2025-12-10 11:57:14 [kimi-k2-0905] 			const n = await conn.read(buf);
2025-12-10 11:57:14 [kimi-k2-0905] 			if (!n) break; // eof
2025-12-10 11:57:14 [kimi-k2-0905] 
2025-12-10 11:57:14 [kimi-k2-0905] 			for (let i = 0; i < n; i++) {
2025-12-10 11:57:14 [kimi-k2-0905] 				const ch = buf[i];
2025-12-10 11:57:14 [kimi-k2-0905] 				if (ch === 0x0d) {
2025-12-10 11:57:14 [kimi-k2-0905] 					// got CR, ignore LF if it follows
2025-12-10 11:57:14 [kimi-k2-0905] 					if (i + 1 < n && buf[i + 1] === 0x0a) i++;
2025-12-10 11:57:14 [kimi-k2-0905] 					send(conn, "YOU SAID: " + line.toUpperCase());
2025-12-10 11:57:14 [kimi-k2-0905] 					line = "";
2025-12-10 11:57:14 [kimi-k2-0905] 				} else {
2025-12-10 11:57:14 [kimi-k2-0905] 					line += String.fromCharCode(ch);
2025-12-10 11:57:14 [kimi-k2-0905] 				}
2025-12-10 11:57:14 [kimi-k2-0905] 			}
2025-12-10 11:57:14 [kimi-k2-0905] 		}
2025-12-10 11:57:14 [kimi-k2-0905] 	} catch (_) {}
2025-12-10 11:57:14 [kimi-k2-0905] 	console.log("client gone");
2025-12-10 11:57:14 [kimi-k2-0905] }
2025-12-10 11:57:14 [kimi-k2-0905] 
2025-12-10 11:57:14 [kimi-k2-0905] const listener = Deno.listen({ port });
2025-12-10 11:57:14 [kimi-k2-0905] console.log("IP232 chat on port", port);
2025-12-10 11:57:14 [kimi-k2-0905] for await (const c of listener) handle(c);
