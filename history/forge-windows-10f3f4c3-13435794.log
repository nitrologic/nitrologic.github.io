2025-12-21 22:48:45 [gemini-3-pro] 		&c,
2025-12-21 22:48:45 [gemini-3-pro] 		&pio->txf[SampleIndex], // Destination: Sample TX FIFO
2025-12-21 22:48:45 [gemini-3-pro] 		&pio->rxf[SyncIndex],   // Source: Sync RX FIFO
2025-12-21 22:48:45 [gemini-3-pro] 		0xFFFFFFFF,             // Count: Max (effectively infinite)
2025-12-21 22:48:45 [gemini-3-pro] 		true                    // Start immediately
2025-12-21 22:48:45 [gemini-3-pro] 	);
2025-12-21 22:48:45 [gemini-3-pro] 
