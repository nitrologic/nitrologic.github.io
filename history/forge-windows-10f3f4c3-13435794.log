2025-12-08 12:11:40 [gemini-3-pro] 	if (bytes.length < 2) return "";
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 	// First 2 bytes are load address (usually 08 01), skip them
2025-12-08 12:11:40 [gemini-3-pro] 	let offset = 2;
