2025-12-08 19:13:37 [kimi-k2-0905] 
2025-12-08 19:13:37 [kimi-k2-0905] // 1. BASIC header:  2-byte next-ptr, 2-byte line#, 2-byte sys address, 0
2025-12-08 19:13:37 [kimi-k2-0905] pokeWord(pass0: boolean, value: string) {
2025-12-08 19:13:37 [kimi-k2-0905] 	if (pass0) return;
2025-12-08 19:13:37 [kimi-k2-0905] 	const csv = value.split(",");
2025-12-08 19:13:37 [kimi-k2-0905] 	const addr = this.labels.get(csv[0]) ?? parseInt(csv[0], 16);
2025-12-08 19:13:37 [kimi-k2-0905] 	this.poke(addr & 0xff);
2025-12-08 19:13:37 [kimi-k2-0905] 	this.poke(addr >> 8);
2025-12-08 19:13:37 [kimi-k2-0905] }
