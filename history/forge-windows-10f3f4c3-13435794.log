2025-12-06 11:38:20 [gemini-3-pro] 		initDict();
2025-12-06 11:38:20 [gemini-3-pro] 
2025-12-06 11:38:20 [gemini-3-pro] 		let buf=0,bits=0;
2025-12-06 11:38:20 [gemini-3-pro] 		const emit=(c:number)=>{
