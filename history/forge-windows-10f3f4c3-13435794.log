2025-12-08 12:14:30 [gemini-3-pro] function prg(bytes: Uint8Array): string[] {
2025-12-08 12:14:30 [gemini-3-pro] 	const lines: string[] = [];
2025-12-08 12:14:30 [gemini-3-pro] 	// Skip Load Address (2 bytes, usually 01 08)
2025-12-08 12:14:30 [gemini-3-pro] 	let pc = 2;
2025-12-08 12:14:30 [gemini-3-pro] 
2025-12-08 12:14:30 [gemini-3-pro] 	while (pc < bytes.length - 1) {
2025-12-08 12:14:30 [gemini-3-pro] 		// Next Line Pointer (2 bytes)
2025-12-08 12:14:30 [gemini-3-pro] 		const nextPtr = bytes[pc] | (bytes[pc + 1] << 8);
2025-12-08 12:14:30 [gemini-3-pro] 		pc += 2;
2025-12-08 12:14:30 [gemini-3-pro] 		if (nextPtr === 0) break; // End of program
2025-12-08 12:14:30 [gemini-3-pro] 
2025-12-08 12:14:30 [gemini-3-pro] 		// Line Number (2 bytes)
2025-12-08 12:14:30 [gemini-3-pro] 		const lineNum = bytes[pc] | (bytes[pc + 1] << 8);
2025-12-08 12:14:30 [gemini-3-pro] 		pc += 2;
2025-12-08 12:14:30 [gemini-3-pro] 
2025-12-08 12:14:30 [gemini-3-pro] 		let line = `${lineNum} `;
2025-12-08 12:14:30 [gemini-3-pro] 
2025-12-08 12:14:30 [gemini-3-pro] 		// Line Data (Tokens + ASCII) until NULL (0)
2025-12-08 12:14:30 [gemini-3-pro] 		while (pc < bytes.length) {
2025-12-08 12:14:30 [gemini-3-pro] 			const b = bytes[pc++];
2025-12-08 12:14:30 [gemini-3-pro] 			if (b === 0) break; // End of line
2025-12-08 12:14:30 [gemini-3-pro] 
2025-12-08 12:14:30 [gemini-3-pro] 			if (b >= 128 && tokenMap.has(b)) {
2025-12-08 12:14:30 [gemini-3-pro] 				line += tokenMap.get(b);
2025-12-08 12:14:30 [gemini-3-pro] 			} else {
2025-12-08 12:14:30 [gemini-3-pro] 				// Simple ASCII mapping, adequate for alphanumeric
2025-12-08 12:14:30 [gemini-3-pro] 				// Full PETSCII conversion would require a specific mapping table
2025-12-08 12:14:30 [gemini-3-pro] 				line += String.fromCharCode(b);
2025-12-08 12:14:30 [gemini-3-pro] 			}
2025-12-08 12:14:30 [gemini-3-pro] 		}
2025-12-08 12:14:30 [gemini-3-pro] 		lines.push(line);
2025-12-08 12:14:30 [gemini-3-pro] 	}
2025-12-08 12:14:30 [gemini-3-pro] 	return lines;
2025-12-08 12:14:30 [gemini-3-pro] }
