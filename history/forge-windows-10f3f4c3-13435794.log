2025-12-08 12:11:40 [gemini-3-pro] 		// Next Line Pointer (2 bytes)
2025-12-08 12:11:40 [gemini-3-pro] 		if (offset + 1 >= bytes.length) break;
2025-12-08 12:11:40 [gemini-3-pro] 		const nextPtr = bytes[offset] | (bytes[offset + 1] << 8);
2025-12-08 12:11:40 [gemini-3-pro] 		offset += 2;
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 		// End of program check
2025-12-08 12:11:40 [gemini-3-pro] 		if (nextPtr === 0) break;
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 		// Line Number (2 bytes)
2025-12-08 12:11:40 [gemini-3-pro] 		if (offset + 1 >= bytes.length) break;
2025-12-08 12:11:40 [gemini-3-pro] 		const lineNum = bytes[offset] | (bytes[offset + 1] << 8);
2025-12-08 12:11:40 [gemini-3-pro] 		offset += 2;
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 		output += `${lineNum} `;
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 		// Line Content
2025-12-08 12:11:40 [gemini-3-pro] 		let inQuote = false;
2025-12-08 12:11:40 [gemini-3-pro] 		while (offset < bytes.length) {
2025-12-08 12:11:40 [gemini-3-pro] 			const b = bytes[offset++];
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 			// Null byte marks end of line
2025-12-08 12:11:40 [gemini-3-pro] 			if (b === 0) break;
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 			if (b === 34) inQuote = !inQuote;
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 			if (!inQuote && b >= 128 && tokenMap.has(b)) {
2025-12-08 12:11:40 [gemini-3-pro] 				output += tokenMap.get(b);
2025-12-08 12:11:40 [gemini-3-pro] 			} else {
2025-12-08 12:11:40 [gemini-3-pro] 				// Basic PETSCII to ASCII mapping
2025-12-08 12:11:40 [gemini-3-pro] 				// Lowercase/Uppercase switching is complex, handling basic alphanumeric here
2025-12-08 12:11:40 [gemini-3-pro] 				const char = (b >= 65 && b <= 90) ? String.fromCharCode(b + 32) : String.fromCharCode(b);
2025-12-08 12:11:40 [gemini-3-pro] 				output += char;
2025-12-08 12:11:40 [gemini-3-pro] 			}
2025-12-08 12:11:40 [gemini-3-pro] 		}
2025-12-08 12:11:40 [gemini-3-pro] 		output += "\n";
2025-12-08 12:11:40 [gemini-3-pro] 	}
2025-12-08 12:11:40 [gemini-3-pro] 
2025-12-08 12:11:40 [gemini-3-pro] 	return output;
2025-12-08 12:11:40 [gemini-3-pro] }
