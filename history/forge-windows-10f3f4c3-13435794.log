2025-12-08 15:54:41 [kimi-k2-0905] 		const imm = Number(v);
2025-12-08 15:54:41 [kimi-k2-0905] 		return Number.isNaN(imm) ? { mode: "imm", label: v } : { mode: "imm", byte: imm & 0xFF };
2025-12-08 15:54:41 [kimi-k2-0905] 	}
2025-12-08 15:54:41 [kimi-k2-0905] 
2025-12-08 15:54:41 [kimi-k2-0905] 	// (zp,x)  or  (abs,x)  or  (abs),y  etc.
2025-12-08 15:54:41 [kimi-k2-0905] 	const indx = txt.match(/^\(\s*([^,]+)\s*,\s*x\s*\)$/);
2025-12-08 15:54:41 [kimi-k2-0905] 	if (indx) {
2025-12-08 15:54:41 [kimi-k2-0905] 		const v = indx[1];
2025-12-08 15:54:41 [kimi-k2-0905] 		const n = Number(v);
2025-12-08 15:54:41 [kimi-k2-0905] 		return Number.isNaN(n) ? { mode: "indx", label: v } : { mode: "indx", byte: n & 0xFF };
2025-12-08 15:54:41 [kimi-k2-0905] 	}
2025-12-08 15:54:41 [kimi-k2-0905] 	const indy = txt.match(/^\(\s*([^)]+)\s*\)\s*,\s*y$/);
2025-12-08 15:54:41 [kimi-k2-0905] 	if (indy) {
2025-12-08 15:54:41 [kimi-k2-0905] 		const v = indy[1];
2025-12-08 15:54:41 [kimi-k2-0905] 		const n = Number(v);
2025-12-08 15:54:41 [kimi-k2-0905] 		return Number.isNaN(n) ? { mode: "indy", label: v } : { mode: "indy", byte: n & 0xFF };
2025-12-08 15:54:41 [kimi-k2-0905] 	}
2025-12-08 15:54:41 [kimi-k2-0905] 
2025-12-08 15:54:41 [kimi-k2-0905] 	// abs,x / abs,y / zp,x / zp,y
2025-12-08 15:54:41 [kimi-k2-0905] 	const absX = txt.match(/^\(\s*([^,]+)\s*\)\s*,\s*x$/);
2025-12-08 15:54:41 [kimi-k2-0905] 	if (absX) {
2025-12-08 15:54:41 [kimi-k2-0905] 		const v = absX[1];
2025-12-08 15:54:41 [kimi-k2-0905] 		const n = Number(v);
2025-12-08 15:54:41 [kimi-k2-0905] 		return Number.isNaN(n) ? { mode: "absx", label: v } : { mode: "absx", word: n & 0xFFFF };
2025-12-08 15:54:41 [kimi-k2-0905] 	}
2025-12-08 15:54:41 [kimi-k2-0905] 	const absY = txt.match(/^\(\s*([^,]+)\s*\)\s*,\s*y$/);
2025-12-08 15:54:41 [kimi-k2-0905] 	if (absY) {
2025-12-08 15:54:41 [kimi-k2-0905] 		const v = absY[1];
2025-12-08 15:54:41 [kimi-k2-0905] 		const n = Number(v);
2025-12-08 15:54:41 [kimi-k2-0905] 		return Number.isNaN(n) ? { mode: "absy", label: v } : { mode: "absy", word: n & 0xFFFF };
2025-12-08 15:54:41 [kimi-k2-0905] 	}
2025-12-08 15:54:41 [kimi-k2-0905] 	const zpx = txt.match(/^\(\s*([^,]+)\s*,\s*x\s*\)$/);
2025-12-08 15:54:41 [kimi-k2-0905] 	if (zpx) {
