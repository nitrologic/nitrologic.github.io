2025-12-08 13:29:44 [gemini-3-pro] function listPrg(bytes: Uint8Array): string {
2025-12-08 13:29:44 [gemini-3-pro] 	if (bytes.length < 2) return "!prg";
2025-12-08 13:29:44 [gemini-3-pro] 	const basic = (bytes[0] == 1 && bytes[1] == 8);
2025-12-08 13:29:44 [gemini-3-pro] 	if (!basic) return "!basic";
2025-12-08 13:29:44 [gemini-3-pro] 	let offset = 2;
2025-12-08 13:29:44 [gemini-3-pro] 	let output = "";
2025-12-08 13:29:44 [gemini-3-pro] 	while (offset < bytes.length) {
2025-12-08 13:29:44 [gemini-3-pro] 		if (offset + 1 >= bytes.length) break;
2025-12-08 13:29:44 [gemini-3-pro] 		const nextPtr = bytes[offset] | (bytes[offset + 1] << 8);
2025-12-08 13:29:44 [gemini-3-pro] 		offset += 2;
2025-12-08 13:29:44 [gemini-3-pro] 		if (nextPtr === 0) break;
2025-12-08 13:29:44 [gemini-3-pro] 		if (offset + 1 >= bytes.length) break;
2025-12-08 13:29:44 [gemini-3-pro] 		const lineNum = bytes[offset] | (bytes[offset + 1] << 8);
2025-12-08 13:29:44 [gemini-3-pro] 		offset += 2;
2025-12-08 13:29:44 [gemini-3-pro] 		output += `${lineNum} `;
2025-12-08 13:29:44 [gemini-3-pro] 		let inQuote = false;
2025-12-08 13:29:44 [gemini-3-pro] 		while (offset < bytes.length) {
2025-12-08 13:29:44 [gemini-3-pro] 			const b = bytes[offset++];
2025-12-08 13:29:44 [gemini-3-pro] 			if (b === 0) break;
2025-12-08 13:29:44 [gemini-3-pro] 			if (b === 34) inQuote = !inQuote;
2025-12-08 13:29:44 [gemini-3-pro] 			if (!inQuote && b >= 128 && tokenMap.has(b)) {
2025-12-08 13:29:44 [gemini-3-pro] 				output += tokenMap.get(b);
2025-12-08 13:29:44 [gemini-3-pro] 			} else {
2025-12-08 13:29:44 [gemini-3-pro] 				const char = (b >= 65 && b <= 90) ? String.fromCharCode(b + 32) : String.fromCharCode(b);
2025-12-08 13:29:44 [gemini-3-pro] 				output += char;
2025-12-08 13:29:44 [gemini-3-pro] 			}
2025-12-08 13:29:44 [gemini-3-pro] 		}
2025-12-08 13:29:44 [gemini-3-pro] 		output += "\n";
2025-12-08 13:29:44 [gemini-3-pro] 	}
2025-12-08 13:29:44 [gemini-3-pro] 	return output;
2025-12-08 13:29:44 [gemini-3-pro] }
