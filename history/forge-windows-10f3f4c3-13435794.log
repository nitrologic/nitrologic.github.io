2025-12-08 17:00:56 [kimi-k2-0905] // ---------- assembler ----------
2025-12-08 17:00:56 [kimi-k2-0905] class assembler{
2025-12-08 17:00:56 [kimi-k2-0905]   #org=0;
2025-12-08 17:00:56 [kimi-k2-0905]   #bytes=new Uint8Array(CartSize);
2025-12-08 17:00:56 [kimi-k2-0905]   #pos=0;
2025-12-08 17:00:56 [kimi-k2-0905]   #syms=new Map<string,number>();
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905]   pc(){ return this.#org + this.#pos; }
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905]   emit(b:number){ this.#bytes[this.#pos++]=b&0xFF; }
2025-12-08 17:00:56 [kimi-k2-0905]   emitWord(w:number){ this.emit(w); this.emit(w>>>8); }
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905]   // parse operand and return {mode,value}
2025-12-08 17:00:56 [kimi-k2-0905]   parseOp(s:string):{mode:number,val:number}{
2025-12-08 17:00:56 [kimi-k2-0905]     s=s.trim();
2025-12-08 17:00:56 [kimi-k2-0905]     if(s==='') throw "missing operand";
2025-12-08 17:00:56 [kimi-k2-0905]     if(s[0]==='#'){                                    // #imm
2025-12-08 17:00:56 [kimi-k2-0905]       return {mode:IMM, val:this.parseExpr(s.slice(1))};
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     if(s.endsWith(',x')){                              // ...,x
2025-12-08 17:00:56 [kimi-k2-0905]       const v=this.parseExpr(s.slice(0,-2));
2025-12-08 17:00:56 [kimi-k2-0905]       if(s.startsWith('(')) return {mode:INDX,val:v};  // (zp,x)
2025-12-08 17:00:56 [kimi-k2-0905]       return v<256? {mode:ZPX,val:v} : {mode:ABSX,val:v};
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     if(s.endsWith(',y')){                              // ...,y
2025-12-08 17:00:56 [kimi-k2-0905]       const v=this.parseExpr(s.slice(0,-2));
2025-12-08 17:00:56 [kimi-k2-0905]       return v<256? {mode:ZPY,val:v} : {mode:ABSY,val:v};
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     if(s.startsWith('(') && s.endsWith(')')){          // (ind)
2025-12-08 17:00:56 [kimi-k2-0905]       const v=this.parseExpr(s.slice(1,-1));
2025-12-08 17:00:56 [kimi-k2-0905]       return {mode:IND,val:v};
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     // plain absolute / zp
2025-12-08 17:00:56 [kimi-k2-0905]     const v=this.parseExpr(s);
2025-12-08 17:00:56 [kimi-k2-0905]     return v<256? {mode:ZP,val:v} : {mode:ABS,val:v};
2025-12-08 17:00:56 [kimi-k2-0905]   }
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905]   // decimal, hex $..., label, or char "A"
2025-12-08 17:00:56 [kimi-k2-0905]   parseExpr(s:string):number{
2025-12-08 17:00:56 [kimi-k2-0905]     s=s.trim();
2025-12-08 17:00:56 [kimi-k2-0905]     if(s[0]==='$') return parseInt(s.slice(1),16);
2025-12-08 17:00:56 [kimi-k2-0905]     if(/^\d+$/.test(s)) return parseInt(s,10);
2025-12-08 17:00:56 [kimi-k2-0905]     if(s[0]==='"' && s.length===3 && s[2]==='"') return s.charCodeAt(1);
2025-12-08 17:00:56 [kimi-k2-0905]     if(this.#syms.has(s)) return this.#syms.get(s)!;
2025-12-08 17:00:56 [kimi-k2-0905]     throw `unknown symbol "${s}"`;
2025-12-08 17:00:56 [kimi-k2-0905]   }
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905]   // main line dispatcher
2025-12-08 17:00:56 [kimi-k2-0905]   add(label:string,op:string,value:string,comment:string){
2025-12-08 17:00:56 [kimi-k2-0905]     // label definition
2025-12-08 17:00:56 [kimi-k2-0905]     if(label){
2025-12-08 17:00:56 [kimi-k2-0905]       if(!/^[a-z_][a-z0-9_]*$/i.test(label)) throw `bad label ${label}`;
2025-12-08 17:00:56 [kimi-k2-0905]       this.#syms.set(label,this.pc());
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     // directives
2025-12-08 17:00:56 [kimi-k2-0905]     if(op.startsWith('!')){
2025-12-08 17:00:56 [kimi-k2-0905]       const dir=op.slice(1);
2025-12-08 17:00:56 [kimi-k2-0905]       switch(dir){
2025-12-08 17:00:56 [kimi-k2-0905]         case 'byte':{
2025-12-08 17:00:56 [kimi-k2-0905]           for(const t of value.split(',')) this.emit(this.parseExpr(t));
2025-12-08 17:00:56 [kimi-k2-0905]           return;
2025-12-08 17:00:56 [kimi-k2-0905]         }
2025-12-08 17:00:56 [kimi-k2-0905]         case 'word':{
2025-12-08 17:00:56 [kimi-k2-0905]           for(const t of value.split(',')) this.emitWord(this.parseExpr(t));
2025-12-08 17:00:56 [kimi-k2-0905]           return;
2025-12-08 17:00:56 [kimi-k2-0905]         }
2025-12-08 17:00:56 [kimi-k2-0905]         case 'text':{
2025-12-08 17:00:56 [kimi-k2-0905]           const txt=value.slice(1,-1);
2025-12-08 17:00:56 [kimi-k2-0905]           for(let i=0;i<txt.length;i++) this.emit(txt.charCodeAt(i));
2025-12-08 17:00:56 [kimi-k2-0905]           return;
2025-12-08 17:00:56 [kimi-k2-0905]         }
2025-12-08 17:00:56 [kimi-k2-0905]         case 'pet':{
2025-12-08 17:00:56 [kimi-k2-0905]           const txt=value.slice(1,-1);
2025-12-08 17:00:56 [kimi-k2-0905]           for(let i=0;i<txt.length;i++){
2025-12-08 17:00:56 [kimi-k2-0905]             let c=txt.charCodeAt(i);
2025-12-08 17:00:56 [kimi-k2-0905]             if(c>=65 && c<=90) c^=0x80; // flip case bit
2025-12-08 17:00:56 [kimi-k2-0905]             this.emit(c);
2025-12-08 17:00:56 [kimi-k2-0905]           }
2025-12-08 17:00:56 [kimi-k2-0905]           if(value.endsWith(',0')) this.emit(0);
2025-12-08 17:00:56 [kimi-k2-0905]           return;
2025-12-08 17:00:56 [kimi-k2-0905]         }
2025-12-08 17:00:56 [kimi-k2-0905]         default: throw `unknown directive ${op}`;
2025-12-08 17:00:56 [kimi-k2-0905]       }
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     // origin
2025-12-08 17:00:56 [kimi-k2-0905]     if(op==='*'){
2025-12-08 17:00:56 [kimi-k2-0905]       this.#org=parseInt(value.slice(2),16);
2025-12-08 17:00:56 [kimi-k2-0905]       this.#pos=0;
2025-12-08 17:00:56 [kimi-k2-0905]       return;
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]     // implied/single-byte
2025-12-08 17:00:56 [kimi-k2-0905]     if(!OPC[op]) throw `unknown instruction ${op}`;
2025-12-08 17:00:56 [kimi-k2-0905]     const table=OPC[op];
2025-12-08 17:00:56 [kimi-k2-0905]     if(typeof table==='number'){ emit(table); return; } // implied
2025-12-08 17:00:56 [kimi-k2-0905]     // full addressing
2025-12-08 17:00:56 [kimi-k2-0905]     const {mode,val}=this.parseOp(value);
2025-12-08 17:00:56 [kimi-k2-0905]     if(table[mode]===undefined) throw `${op} does not support mode ${mode}`;
2025-12-08 17:00:56 [kimi-k2-0905]     const opcode=table[mode];
2025-12-08 17:00:56 [kimi-k2-0905]     this.emit(opcode);
2025-12-08 17:00:56 [kimi-k2-0905]     if(mode>=ZP && mode<=ZPY) this.emit(val);
2025-12-08 17:00:56 [kimi-k2-0905]     else if(mode>=ABS && mode<=ABSY) this.emitWord(val);
2025-12-08 17:00:56 [kimi-k2-0905]     else if(mode===IND) this.emitWord(val);
2025-12-08 17:00:56 [kimi-k2-0905]     else if(mode===INDX || mode===INDY) this.emit(val);
2025-12-08 17:00:56 [kimi-k2-0905]     // branches
2025-12-08 17:00:56 [kimi-k2-0905]     if(op.startsWith('b')){
2025-12-08 17:00:56 [kimi-k2-0905]       const off=(val - (this.pc())) & 0xFF;
2025-12-08 17:00:56 [kimi-k2-0905]       this.emit(off);
2025-12-08 17:00:56 [kimi-k2-0905]     }
2025-12-08 17:00:56 [kimi-k2-0905]   }
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905]   flush(){ return this.#bytes.slice(0,this.#pos); }
2025-12-08 17:00:56 [kimi-k2-0905] }
2025-12-08 17:00:56 [kimi-k2-0905] 
2025-12-08 17:00:56 [kimi-k2-0905] function assemble6510(asm:string):Uint8Array{
2025-12-08 17:00:56 [kimi-k2-0905]   const pet=new assembler();
2025-12-08 17:00:56 [kimi-k2-0905]   const lines=asm.split(/\r?\n/).filter(l=>l.trim().length && !l.trim().startsWith(';'));
2025-12-08 17:00:56 [kimi-k2-0905]   // two-pass: first collect labels, second emit
2025-12-08 17:00:56 [kimi-k2-0905]   for(let pass=1;pass<=2;pass++){
2025-12-08 17:00:56 [kimi-k2-0905]     for(const raw of lines){
2025-12-08 17:00:56 [kimi-k2-0905]       let label='',op='',operand='';
2025-12-08 17:00:56 [kimi-k2-0905]       const s=raw.replace(/\s+/g,' ').trim();
2025-12-08 17:00:56 [kimi-k2-0905]       const c=s.indexOf(';');
2025-12-08 17:00:56 [kimi-k2-0905]       const line=c===-1?s:s.slice(0,c);
2025-12-08 17:00:56 [kimi-k2-0905]       const parts=line.split(' ');
2025-12-08 17:00:56 [kimi-k2-0905]       if(parts[0] && !parts[0].startsWith(' ')) { label=parts[0]; parts.shift(); }
