2025-12-22 00:01:32 [gemini-3-pro] 	// Clear the interrupt request
2025-12-22 00:01:32 [gemini-3-pro] 	dma_channel_acknowledge_irq0(lumaChannel);
2025-12-22 00:01:32 [gemini-3-pro] 
2025-12-22 00:01:32 [gemini-3-pro] 	// Reset write address to start of buffer and trigger immediately
2025-12-22 00:01:32 [gemini-3-pro] 	dma_channel_set_write_addr(lumaChannel, pixelBuffer, true);
2025-12-22 00:01:32 [gemini-3-pro] }
