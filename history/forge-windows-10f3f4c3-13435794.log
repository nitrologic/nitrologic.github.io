2025-12-08 15:54:41 [kimi-k2-0905] type Mode = "imp" | "imm" | "abs" | "zp" | "zpx" | "zpy" | "absx" | "absy" | "indx" | "indy" | "rel";
2025-12-08 15:54:41 [kimi-k2-0905] 
2025-12-08 15:54:41 [kimi-k2-0905] interface Operand {
2025-12-08 15:54:41 [kimi-k2-0905] 	mode: Mode;
2025-12-08 15:54:41 [kimi-k2-0905] 	byte?: number;   // 8-bit value  (zp/imm/rel)
2025-12-08 15:54:41 [kimi-k2-0905] 	word?: number;   // 16-bit value (abs)
2025-12-08 15:54:41 [kimi-k2-0905] 	label?: string;  // unresolved symbol
2025-12-08 15:54:41 [kimi-k2-0905] }
2025-12-08 15:54:41 [kimi-k2-0905] 
2025-12-08 15:54:41 [kimi-k2-0905] function parseOperand(txt: string): Operand {
2025-12-08 15:54:41 [kimi-k2-0905] 	txt = txt.trim();
2025-12-08 15:54:41 [kimi-k2-0905] 	if (!txt) return { mode: "imp" };
2025-12-08 15:54:41 [kimi-k2-0905] 
2025-12-08 15:54:41 [kimi-k2-0905] 	// immediate
2025-12-08 15:54:41 [kimi-k2-0905] 	if (txt.startsWith("#")) {
