2025-12-08 12:09:07 [gemini-3-pro] Here is the code to set up a Deno server on port 8081, including the named reusable functions for
2025-12-08 12:09:07 [gemini-3-pro] string extensions and reading bytes as requested.
2025-12-08 12:09:07 [gemini-3-pro] 
2025-12-08 12:09:07 [gemini-3-pro] 
2025-12-08 12:09:07 [gemini-3-pro] import { extname, join } from "jsr:@std/path";
2025-12-08 12:09:07 [gemini-3-pro] 
2025-12-08 12:09:07 [gemini-3-pro] const PORT = 8081;
2025-12-08 12:09:07 [gemini-3-pro] const BASE_DIR = "cbmpico/cbm1541";
2025-12-08 12:09:07 [gemini-3-pro] 
2025-12-08 12:09:07 [gemini-3-pro] function getStringExtension(filename: string): string {
2025-12-08 12:09:07 [gemini-3-pro] 	return extname(filename);
2025-12-08 12:09:07 [gemini-3-pro] }
2025-12-08 12:09:07 [gemini-3-pro] 
2025-12-08 12:09:07 [gemini-3-pro] async function readBytes(dir: string, filename: string): Promise<Uint8Array | null> {
2025-12-08 12:09:07 [gemini-3-pro] 	try {
2025-12-08 12:09:07 [gemini-3-pro] 		const filePath = join(dir, filename);
2025-12-08 12:09:07 [gemini-3-pro] 		const info = await Deno.stat(filePath);
2025-12-08 12:09:07 [gemini-3-pro] 		if (info.isFile) {
2025-12-08 12:09:07 [gemini-3-pro] 			return await Deno.readFile(filePath);
2025-12-08 12:09:07 [gemini-3-pro] 		}
2025-12-08 12:09:07 [gemini-3-pro] 	} catch (error) {
2025-12-08 12:09:07 [gemini-3-pro] 		console.error(`Error reading ${filename}:`, error);
2025-12-08 12:09:07 [gemini-3-pro] 	}
2025-12-08 12:09:07 [gemini-3-pro] 	return null;
2025-12-08 12:09:08 [gemini-3-pro] }
2025-12-08 12:09:08 [gemini-3-pro] 
2025-12-08 12:09:08 [gemini-3-pro] async function handleRequest(req: Request): Promise<Response> {
2025-12-08 12:09:08 [gemini-3-pro] 	const url = new URL(req.url);
2025-12-08 12:09:08 [gemini-3-pro] 
2025-12-08 12:09:08 [gemini-3-pro] 	// Example: /?file=game.prg
2025-12-08 12:09:08 [gemini-3-pro] 	const filename = url.searchParams.get("file");
2025-12-08 12:09:08 [gemini-3-pro] 
2025-12-08 12:09:08 [gemini-3-pro] 	if (filename) {
2025-12-08 12:09:08 [gemini-3-pro] 		const ext = getStringExtension(filename);
2025-12-08 12:09:08 [gemini-3-pro] 		const bytes = await readBytes(BASE_DIR, filename);
2025-12-08 12:09:08 [gemini-3-pro] 
2025-12-08 12:09:08 [gemini-3-pro] 		if (bytes) {
2025-12-08 12:09:08 [gemini-3-pro] 			console.log(`Serving ${filename} (${ext}) - ${bytes.length} bytes`);
2025-12-08 12:09:08 [gemini-3-pro] 			return new Response(bytes, {
2025-12-08 12:09:08 [gemini-3-pro] 				headers: { "Content-Type": "application/octet-stream" }
2025-12-08 12:09:08 [gemini-3-pro] 			});
2025-12-08 12:09:08 [gemini-3-pro] 		}
2025-12-08 12:09:08 [gemini-3-pro] 		return new Response("File not found", { status: 404 });
2025-12-08 12:09:08 [gemini-3-pro] 	}
2025-12-08 12:09:08 [gemini-3-pro] 
2025-12-08 12:09:08 [gemini-3-pro] 	return new Response("Listening for slop...", { status: 200 });
2025-12-08 12:09:08 [gemini-3-pro] }
2025-12-08 12:09:08 [gemini-3-pro] 
2025-12-08 12:09:08 [gemini-3-pro] if (import.meta.main) {
2025-12-08 12:09:08 [gemini-3-pro] 	console.log(`Server running on http://localhost:${PORT}`);
2025-12-08 12:09:08 [gemini-3-pro] 	Deno.serve({ port: PORT, handler: handleRequest });
2025-12-08 12:09:08 [gemini-3-pro] }
