2025-12-08 15:57:52 [kimi-k2-0905] Tiny helper to split the three parts cleanly (and keep the comment for later):
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:52 [kimi-k2-0905] function splitLine(raw: string): { label: string; op: string; trim: string; comment: string } {
2025-12-08 15:57:52 [kimi-k2-0905] 	let comment = "";
2025-12-08 15:57:52 [kimi-k2-0905] 	let body = raw;
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:52 [kimi-k2-0905] 	// strip comment
2025-12-08 15:57:52 [kimi-k2-0905] 	const cPos = body.indexOf(";");
2025-12-08 15:57:52 [kimi-k2-0905] 	if (cPos !== -1) {
2025-12-08 15:57:52 [kimi-k2-0905] 		comment = body.slice(cPos);
2025-12-08 15:57:52 [kimi-k2-0905] 		body = body.slice(0, cPos);
2025-12-08 15:57:52 [kimi-k2-0905] 	}
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:52 [kimi-k2-0905] 	body = body.trim();
2025-12-08 15:57:52 [kimi-k2-0905] 	if (!body) return { label: "", op: "", trim: "", comment };
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:52 [kimi-k2-0905] 	// label?
2025-12-08 15:57:52 [kimi-k2-0905] 	let label = "";
2025-12-08 15:57:52 [kimi-k2-0905] 	if (!body.startsWith(" ") && !body.startsWith("\t")) {
2025-12-08 15:57:52 [kimi-k2-0905] 		const m = body.match(/^([A-Za-z_]\w*)\s+(.*)$/);
2025-12-08 15:57:52 [kimi-k2-0905] 		if (m) {
2025-12-08 15:57:52 [kimi-k2-0905] 			label = m[1];
2025-12-08 15:57:52 [kimi-k2-0905] 			body = m[2];
2025-12-08 15:57:52 [kimi-k2-0905] 		}
2025-12-08 15:57:52 [kimi-k2-0905] 	}
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:52 [kimi-k2-0905] 	// op + operand
2025-12-08 15:57:52 [kimi-k2-0905] 	body = body.trim();
2025-12-08 15:57:52 [kimi-k2-0905] 	const o = body.search(/\s/);
2025-12-08 15:57:52 [kimi-k2-0905] 	const op = o === -1 ? body : body.slice(0, o);
2025-12-08 15:57:52 [kimi-k2-0905] 	const trim = o === -1 ? "" : body.slice(o + 1).trim();
2025-12-08 15:57:52 [kimi-k2-0905] 
2025-12-08 15:57:53 [kimi-k2-0905] 	return { label, op, trim, comment };
2025-12-08 15:57:53 [kimi-k2-0905] }
2025-12-08 15:57:53 [kimi-k2-0905] 
2025-12-08 15:57:53 [kimi-k2-0905] 
