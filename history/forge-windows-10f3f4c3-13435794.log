2025-12-21 23:57:07 [gemini-3-pro] void luma_dma_handler() {
2025-12-21 23:57:07 [gemini-3-pro] 	// Clear the interrupt request for this channel
2025-12-21 23:57:07 [gemini-3-pro] 	dma_hw->ints0 = 1u << lumaChannel;
2025-12-21 23:57:07 [gemini-3-pro] 
2025-12-21 23:57:07 [gemini-3-pro] 	// Reset the write address to the beginning of the buffer and re-trigger
2025-12-21 23:57:07 [gemini-3-pro] 	dma_channel_set_write_addr(lumaChannel, pixelBuffer, true);
2025-12-21 23:57:07 [gemini-3-pro] }
