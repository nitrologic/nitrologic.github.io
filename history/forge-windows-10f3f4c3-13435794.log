2025-12-06 09:22:12 [nitro@ryzen5] can i used deno ts to create a gif format byte array 320x200 16 color and compress animation frames
2025-12-06 09:23:47 [kimi-k2-0905] Yes.
2025-12-06 09:23:47 [kimi-k2-0905] Deno’s built-in `compress` stream (zlib) plus a hand-rolled GIF-89a encoder is enough.
2025-12-06 09:23:47 [kimi-k2-0905] The only external bit you need is a 16-colour C64 palette (or any 16 RGB triples).
2025-12-06 09:23:47 [kimi-k2-0905] Below is a single-file, no-dependency TypeScript solution that:
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] - keeps one frame in RAM (320 × 200 bytes, 0-15)
2025-12-06 09:23:47 [kimi-k2-0905] - exposes `addFrame(delay100ths)` to append a delta
2025-12-06 09:23:47 [kimi-k2-0905] - returns a `Uint8Array` containing the complete, compressed GIF
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] Save as `gif16.ts`, run with `deno run --allow-write gif16.ts` and it spits out `spin.gif`.
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] // gif16.ts  –  320×200 16-colour GIF encoder for Deno
2025-12-06 09:23:47 [kimi-k2-0905] const WIDTH  = 320;
2025-12-06 09:23:47 [kimi-k2-0905] const HEIGHT = 200;
2025-12-06 09:23:47 [kimi-k2-0905] const PALETTE = [
2025-12-06 09:23:47 [kimi-k2-0905]   0x00,0x00,0x00,  0xff,0xff,0xff,  0x68,0x37,0x2b,  0x70,0xa4,0xb2,
2025-12-06 09:23:47 [kimi-k2-0905]   0x6f,0x3d,0x86,  0x58,0x8d,0x43,  0x35,0x28,0x79,  0xb8,0xc7,0x6f,
2025-12-06 09:23:47 [kimi-k2-0905]   0x6f,0x4f,0x25,  0x43,0x39,0x00,  0x9a,0x67,0x59,  0x44,0x44,0x44,
2025-12-06 09:23:47 [kimi-k2-0905]   0x6c,0x6c,0x6c,  0x9a,0xd2,0x84,  0x6c,0x5e,0xb5, 0x95,0x95,0x95
2025-12-06 09:23:47 [kimi-k2-0905] ]; // 16 RGB triples
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] class GIF16 {
2025-12-06 09:23:47 [kimi-k2-0905]   #frame = new Uint8Array(WIDTH * HEIGHT); // current pixels (0-15)
2025-12-06 09:23:47 [kimi-k2-0905]   #bytes: number[] = [];
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   constructor() {
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...header());
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...logicalScreen());
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...globalColorTable());
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...appExt());
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...graphicsControl(0)); // first frame
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   setPixel(x: number, y: number, c: number) {
2025-12-06 09:23:47 [kimi-k2-0905]     if (x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT) this.#frame[y * WIDTH + x] = c & 15;
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   addFrame(delay100ths = 4) {
2025-12-06 09:23:47 [kimi-k2-0905]     const image = lzw(packImage(this.#frame));
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...graphicsControl(delay100ths));
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(0x2C); // Image separator
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...u16le(0), ...u16le(0)); // NW corner
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...u16le(WIDTH), ...u16le(HEIGHT));
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(0x00); // no local table
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(0x08); // LZW min code size
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(image.length);
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(...image);
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   finish() {
2025-12-06 09:23:47 [kimi-k2-0905]     this.#bytes.push(0x3B); // Trailer
2025-12-06 09:23:47 [kimi-k2-0905]     return new Uint8Array(this.#bytes);
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] // --- GIF primitives ----------------------------------------------------------
2025-12-06 09:23:47 [kimi-k2-0905] function header() { return textToBytes("GIF89a"); }
2025-12-06 09:23:47 [kimi-k2-0905] function u16le(n: number) { return [n & 255, (n >>> 8) & 255]; }
2025-12-06 09:23:47 [kimi-k2-0905] function textToBytes(s: string) { return [...new TextEncoder().encode(s)]; }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] function logicalScreen() {
2025-12-06 09:23:47 [kimi-k2-0905]   const b: number[] = [];
2025-12-06 09:23:47 [kimi-k2-0905]   b.push(...u16le(WIDTH), ...u16le(HEIGHT));
2025-12-06 09:23:47 [kimi-k2-0905]   b.push(0xF7); // global table present, 4 bpp (16 cols)
2025-12-06 09:23:47 [kimi-k2-0905]   b.push(0x00); // background index
2025-12-06 09:23:47 [kimi-k2-0905]   b.push(0x00); // aspect
2025-12-06 09:23:47 [kimi-k2-0905]   return b;
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] function globalColorTable() {
2025-12-06 09:23:47 [kimi-k2-0905]   const t = new Uint8Array(48);
2025-12-06 09:23:47 [kimi-k2-0905]   for (let i = 0; i < 16; i++) t.set(PALETTE.slice(i * 3, i * 3 + 3), i * 3);
2025-12-06 09:23:47 [kimi-k2-0905]   return [...t];
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] function appExt() {
2025-12-06 09:23:47 [kimi-k2-0905]   const b = [0x21, 0xFF, 11];
2025-12-06 09:23:47 [kimi-k2-0905]   b.push(...textToBytes("NETSCAPE2.0"));
2025-12-06 09:23:47 [kimi-k2-0905]   b.push(3, 1, 0, 0, 0);
2025-12-06 09:23:47 [kimi-k2-0905]   return b;
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] function graphicsControl(delay: number) {
2025-12-06 09:23:47 [kimi-k2-0905]   return [0x21, 0xF9, 4, 0x04, delay & 255, (delay >>> 8) & 255, 0x00, 0x00];
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] function packImage(pixels: Uint8Array) {
2025-12-06 09:23:47 [kimi-k2-0905]   // 320 cols → 40 bytes per row (2 pixels per byte, big-nibble first)
2025-12-06 09:23:47 [kimi-k2-0905]   const out = new Uint8Array((WIDTH / 2) * HEIGHT);
2025-12-06 09:23:47 [kimi-k2-0905]   for (let y = 0; y < HEIGHT; y++) {
2025-12-06 09:23:47 [kimi-k2-0905]     for (let x = 0; x < WIDTH; x += 2) {
2025-12-06 09:23:47 [kimi-k2-0905]       const hi = pixels[y * WIDTH + x];
2025-12-06 09:23:47 [kimi-k2-0905]       const lo = pixels[y * WIDTH + x + 1];
2025-12-06 09:23:47 [kimi-k2-0905]       out[y * (WIDTH / 2) + x / 2] = (hi << 4) | lo;
2025-12-06 09:23:47 [kimi-k2-0905]     }
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905]   return out;
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] // --- minimal LZW encoder ------------------------------------------------------
2025-12-06 09:23:47 [kimi-k2-0905] function lzw(indices: Uint8Array, minCodeSize = 4) {
2025-12-06 09:23:47 [kimi-k2-0905]   const clear = 1 << minCodeSize;
2025-12-06 09:23:47 [kimi-k2-0905]   const end   = clear + 1;
2025-12-06 09:23:47 [kimi-k2-0905]   let codeSize = minCodeSize + 1;
2025-12-06 09:23:47 [kimi-k2-0905]   let nextCode = end + 1;
2025-12-06 09:23:47 [kimi-k2-0905]   const max = 4095;
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   const dict = new Map<string, number>();
2025-12-06 09:23:47 [kimi-k2-0905]   function resetDict() {
2025-12-06 09:23:47 [kimi-k2-0905]     dict.clear();
2025-12-06 09:23:47 [kimi-k2-0905]     for (let i = 0; i < clear; i++) dict.set(String(i), i);
2025-12-06 09:23:47 [kimi-k2-0905]     nextCode = end + 1;
2025-12-06 09:23:47 [kimi-k2-0905]     codeSize = minCodeSize + 1;
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905]   resetDict();
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   let buf = 0, bits = 0;
2025-12-06 09:23:47 [kimi-k2-0905]   const out: number[] = [];
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   function write(c: number) {
2025-12-06 09:23:47 [kimi-k2-0905]     buf |= c << bits;
2025-12-06 09:23:47 [kimi-k2-0905]     bits += codeSize;
2025-12-06 09:23:47 [kimi-k2-0905]     while (bits >= 8) {
2025-12-06 09:23:47 [kimi-k2-0905]       out.push(buf & 255);
2025-12-06 09:23:47 [kimi-k2-0905]       buf >>>= 8;
2025-12-06 09:23:47 [kimi-k2-0905]       bits -= 8;
2025-12-06 09:23:47 [kimi-k2-0905]     }
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905]   write(clear);
2025-12-06 09:23:47 [kimi-k2-0905]   let prefix = String(indices[0]);
2025-12-06 09:23:47 [kimi-k2-0905]   for (let i = 1; i < indices.length; i++) {
2025-12-06 09:23:47 [kimi-k2-0905]     const c = String(indices[i]);
2025-12-06 09:23:47 [kimi-k2-0905]     const key = prefix + "," + c;
2025-12-06 09:23:47 [kimi-k2-0905]     if (dict.has(key)) {
2025-12-06 09:23:47 [kimi-k2-0905]       prefix = key;
2025-12-06 09:23:47 [kimi-k2-0905]     } else {
2025-12-06 09:23:47 [kimi-k2-0905]       write(dict.get(prefix)!);
2025-12-06 09:23:47 [kimi-k2-0905]       if (nextCode <= max) {
2025-12-06 09:23:47 [kimi-k2-0905]         dict.set(key, nextCode++);
2025-12-06 09:23:47 [kimi-k2-0905]         if (nextCode === (1 << codeSize) + 1 && codeSize < 12) codeSize++;
2025-12-06 09:23:47 [kimi-k2-0905]       }
2025-12-06 09:23:47 [kimi-k2-0905]       prefix = c;
2025-12-06 09:23:47 [kimi-k2-0905]     }
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905]   write(dict.get(prefix)!);
2025-12-06 09:23:47 [kimi-k2-0905]   write(end);
2025-12-06 09:23:47 [kimi-k2-0905]   if (bits) out.push(buf & 255);
2025-12-06 09:23:47 [kimi-k2-0905]   return new Uint8Array(out);
2025-12-06 09:23:47 [kimi-k2-0905] }
2025-12-06 09:23:47 [kimi-k2-0905] 
2025-12-06 09:23:47 [kimi-k2-0905] // --- demo --------------------------------------------------------------------
2025-12-06 09:23:47 [kimi-k2-0905] if (import.meta.main) {
2025-12-06 09:23:47 [kimi-k2-0905]   const gif = new GIF16();
2025-12-06 09:23:47 [kimi-k2-0905]   // simple 16-frame spinning colour-bar
2025-12-06 09:23:47 [kimi-k2-0905]   for (let f = 0; f < 16; f++) {
2025-12-06 09:23:47 [kimi-k2-0905]     for (let y = 0; y < HEIGHT; y++) {
2025-12-06 09:23:47 [kimi-k2-0905]       for (let x = 0; x < WIDTH; x++) {
2025-12-06 09:23:47 [kimi-k2-0905]         gif.setPixel(x, y, (Math.floor(x / 20) + f) & 15);
2025-12-06 09:23:47 [kimi-k2-0905]       }
2025-12-06 09:23:47 [kimi-k2-0905]     }
2025-12-06 09:23:47 [kimi-k2-0905]     gif.addFrame(6); // 60 ms per frame
2025-12-06 09:23:47 [kimi-k2-0905]   }
2025-12-06 09:23:47 [kimi-k2-0905]   const bytes = gif.finish();
2025-12-06 09:23:47 [kimi-k2-0905]   await Deno.writeFile("spin.gif", bytes);
2025-12-06 09:23:47 [kimi-k2-0905]   console.log("wrote spin.gif", bytes.length, "bytes");
2025-12-06 09:23:47 [kimi-k2-0905] }
