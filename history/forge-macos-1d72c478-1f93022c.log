2026-05-11 21:07:14 [gemini-3.1-pro] 	gpio_put(PB_PIN, false);
2026-05-11 21:07:14 [gemini-3.1-pro] 	gpio_put(PR_PIN, false);
2026-05-11 21:07:14 [gemini-3.1-pro] 
2026-05-11 21:07:14 [gemini-3.1-pro] 	// --- 1. Initialize Color Pump (pio, sm) ---
2026-05-11 21:07:14 [gemini-3.1-pro] 	const pio_program_t *program6 = &colorpump_program;
2026-05-11 21:07:14 [gemini-3.1-pro] 	if (!pio_can_add_program(pio, program6)) return false;
2026-05-11 21:07:14 [gemini-3.1-pro] 	uint offset6 = pio_add_program(pio, program6);
