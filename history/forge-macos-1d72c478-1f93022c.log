2026-05-11 21:07:14 [gemini-3.1-pro] 	pio_sm_set_consecutive_pindirs(pio, sm, PUMP0_ENABLE, 4, true);
2026-05-11 21:07:14 [gemini-3.1-pro] 
2026-05-11 21:07:14 [gemini-3.1-pro] 	pio_sm_init(pio, sm, offset6, &config6);
2026-05-11 21:07:14 [gemini-3.1-pro] 	pio_sm_set_enabled(pio, sm, true);
