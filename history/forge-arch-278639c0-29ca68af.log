2026-09-28 11:07:34 [deepseek-flash] stats(){
2026-09-28 11:07:34 [deepseek-flash] 	const frame=this.frameCount;
2026-09-28 11:07:34 [deepseek-flash] 	const minFrame=frame-20;
2026-09-28 11:07:34 [deepseek-flash] 	const grid=this._tileGrid;
2026-09-28 11:07:34 [deepseek-flash] 	let count=0;
2026-09-28 11:07:34 [deepseek-flash] 	let active=0;
2026-09-28 11:07:34 [deepseek-flash] 	let cached=0;
2026-09-28 11:07:34 [deepseek-flash] 	let orphan=0;
2026-09-28 11:07:34 [deepseek-flash] 	let fetched=0;
2026-09-28 11:07:34 [deepseek-flash] 	let ready=0;
2026-09-28 11:07:34 [deepseek-flash] 	let meshed=0;
2026-09-28 11:07:34 [deepseek-flash] 	let bytes=0;
2026-09-28 11:07:34 [deepseek-flash] 	for(const y in grid){
2026-09-28 11:07:34 [deepseek-flash] 		const row=grid[y];
2026-09-28 11:07:34 [deepseek-flash] 		for(const x in row){
2026-09-28 11:07:34 [deepseek-flash] 			const tile=row[x];
2026-09-28 11:07:34 [deepseek-flash] 			count++;
2026-09-28 11:07:34 [deepseek-flash] 			if(tile.frame && tile.frame>=minFrame){
2026-09-28 11:07:34 [deepseek-flash] 				active++;
2026-09-28 11:07:34 [deepseek-flash] 			}else{
2026-09-28 11:07:34 [deepseek-flash] 				cached++;
2026-09-28 11:07:34 [deepseek-flash] 				if(!tile.fetched) orphan++;
2026-09-28 11:07:34 [deepseek-flash] 			}
2026-09-28 11:07:34 [deepseek-flash] 			if(tile.fetched) fetched++;
2026-09-28 11:07:34 [deepseek-flash] 			if(tile.ready) ready++;
2026-09-28 11:07:34 [deepseek-flash] 			if(tile.tilemesh) meshed++;
2026-09-28 11:07:34 [deepseek-flash] 			bytes+=tileBytes(tile);
2026-09-28 11:07:34 [deepseek-flash] 		}
2026-09-28 11:07:34 [deepseek-flash] 	}
2026-09-28 11:07:34 [deepseek-flash] 	return {level:this.gridlevel,count,active,cached,orphan,fetched,ready,meshed,bytes};
