2026-09-19 13:31:42 [claude-sonnet-5] 		method: "POST",
2026-09-19 13:31:42 [claude-sonnet-5] 		headers: {
2026-09-19 13:31:42 [claude-sonnet-5] 			AccessKey: apiKey,
2026-09-19 13:31:42 [claude-sonnet-5] 		},
2026-09-19 13:31:42 [claude-sonnet-5] 	});
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 	return response.json();
2026-09-19 13:31:42 [claude-sonnet-5] }
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Usage:
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] purgeSingleFile("YOUR_API_KEY", "https://cdn.example.com/js/app.js");
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 2. Purge by Wildcard/Path Prefix
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Useful if you version your files or have multiple JS assets to clear together.
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Enable "Enable URL Purge with Wildcards" in your Pull Zone settings, then:
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] async function purgeByPattern(apiKey, pullZoneId, urlPattern) {
2026-09-19 13:31:42 [claude-sonnet-5] 	const endpoint = `https://api.bunny.net/pullzone/${pullZoneId}/purgeCache`;
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 	const response = await fetch(endpoint, {
2026-09-19 13:31:42 [claude-sonnet-5] 		method: "POST",
2026-09-19 13:31:42 [claude-sonnet-5] 		headers: {
2026-09-19 13:31:42 [claude-sonnet-5] 			AccessKey: apiKey,
2026-09-19 13:31:42 [claude-sonnet-5] 			"Content-Type": "application/json",
2026-09-19 13:31:42 [claude-sonnet-5] 		},
2026-09-19 13:31:42 [claude-sonnet-5] 		body: JSON.stringify({ url: urlPattern }),
2026-09-19 13:31:42 [claude-sonnet-5] 	});
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 	return response.json();
2026-09-19 13:31:42 [claude-sonnet-5] }
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Example pattern: `https://cdn.example.com/js/*`
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 3. Use Cache-Busting Query Strings (Avoids Purging Entirely)
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Instead of purging, force fresh files by changing the URL itself:
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] <script src="/js/app.js?v=1.2.3"></script>
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Or use a content hash from your build tool:
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] <script src="/js/app.a1b2c3d.js"></script>
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] This is often the best long-term strategy — no manual purge step needed, and users always
2026-09-19 13:31:42 [claude-sonnet-5] get the correct version instantly.
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 4. Set Shorter Cache-Control Headers for JS
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] If you frequently update JS during active development, configure your origin server to send shorter
2026-09-19 13:31:42 [claude-sonnet-5] cache lifetimes:
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Cache-Control: public, max-age=300
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Then BunnyCDN will naturally refetch every 5 minutes without needing manual purges.
2026-09-19 13:31:42 [claude-sonnet-5] 
2026-09-19 13:31:42 [claude-sonnet-5] Recommendation
2026-09-19 13:31:42 [claude-sonnet-5] 
