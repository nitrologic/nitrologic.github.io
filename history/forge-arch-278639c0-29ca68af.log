2026-09-29 20:30:46 [deepseek-flash] • Two-threshold sweep:*
2026-09-29 20:30:46 [deepseek-flash] 
2026-09-29 20:30:46 [deepseek-flash] sweep(){
2026-09-29 20:30:46 [deepseek-flash] 	const unmesh=[];
2026-09-29 20:30:46 [deepseek-flash] 	const retire=[];
2026-09-29 20:30:46 [deepseek-flash] 	const minFrame=this.frameCount-20;
2026-09-29 20:30:46 [deepseek-flash] 	const killFrame=this.frameCount-200;
2026-09-29 20:30:46 [deepseek-flash] 	const grid=this._tileGrid;
2026-09-29 20:30:46 [deepseek-flash] 	for(const y in grid){
2026-09-29 20:30:46 [deepseek-flash] 		const row=grid[y];
2026-09-29 20:30:46 [deepseek-flash] 		for(const x in row){
2026-09-29 20:30:46 [deepseek-flash] 			const tile=row[x];
2026-09-29 20:30:46 [deepseek-flash] 			if(!tile.frame) continue;
2026-09-29 20:30:46 [deepseek-flash] 			if(tile.frame<killFrame){
2026-09-29 20:30:46 [deepseek-flash] 				retire.push(tile);
2026-09-29 20:30:46 [deepseek-flash] 				delete row[x];
2026-09-29 20:30:46 [deepseek-flash] 				tile.frame=0;
2026-09-29 20:30:46 [deepseek-flash] 			}else if(tile.frame<minFrame){
2026-09-29 20:30:46 [deepseek-flash] 				unmesh.push(tile);
2026-09-29 20:30:46 [deepseek-flash] 			}
2026-09-29 20:30:46 [deepseek-flash] 		}
2026-09-29 20:30:46 [deepseek-flash] 	}
2026-09-29 20:30:46 [deepseek-flash] 	return {unmesh,retire};
2026-09-29 20:30:46 [deepseek-flash] }
2026-09-29 20:30:46 [deepseek-flash] 
