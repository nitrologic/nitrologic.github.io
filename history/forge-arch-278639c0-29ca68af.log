2026-09-05 08:28:51 [gemini-3.8-flash] Here is a standalone `SceneTree` script that queries `ClassDB` and the engine's built-in
2026-09-05 08:28:51 [gemini-3.8-flash] singletons, formats the catalog, and writes it to a file.
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] Indentation uses tabs, and the logic is broken into named reusable functions.
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] extends SceneTree
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] func _init() -> void:
2026-09-05 08:28:51 [gemini-3.8-flash] 	export_engine_schema("res://godot_api_schema.json")
2026-09-05 08:28:51 [gemini-3.8-flash] 	quit()
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] func get_variant_names() -> Array[String]:
2026-09-05 08:28:51 [gemini-3.8-flash] 	var names: Array[String] = ["Variant"]
2026-09-05 08:28:51 [gemini-3.8-flash] 	for type_id in range(1, TYPE_MAX):
2026-09-05 08:28:51 [gemini-3.8-flash] 		var type_name: String = type_string(type_id)
2026-09-05 08:28:51 [gemini-3.8-flash] 		if not type_name.is_empty() and not names.has(type_name):
2026-09-05 08:28:51 [gemini-3.8-flash] 			names.append(type_name)
2026-09-05 08:28:51 [gemini-3.8-flash] 	names.sort()
2026-09-05 08:28:51 [gemini-3.8-flash] 	return names
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] func is_editor_class(class_name: String) -> bool:
2026-09-05 08:28:51 [gemini-3.8-flash] 	return class_name.begins_with("Editor") or class_name.begins_with("ResourceImporter")
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] func populate_categories(classes: PackedStringArray, nodes: Array[String], resources: Array[String], objects: Array[String], editors: Array[String]) -> void:
2026-09-05 08:28:51 [gemini-3.8-flash] 	for current_class in classes:
2026-09-05 08:28:51 [gemini-3.8-flash] 		var class_name: String = str(current_class)
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 		if ClassDB.is_parent_class(class_name, "Node"):
2026-09-05 08:28:51 [gemini-3.8-flash] 			nodes.append(class_name)
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 		if ClassDB.is_parent_class(class_name, "Resource"):
2026-09-05 08:28:51 [gemini-3.8-flash] 			resources.append(class_name)
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 		if ClassDB.is_parent_class(class_name, "Object"):
2026-09-05 08:28:51 [gemini-3.8-flash] 			objects.append(class_name)
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 		if is_editor_class(class_name):
2026-09-05 08:28:51 [gemini-3.8-flash] 			editors.append(class_name)
2026-09-05 08:28:51 [gemini-3.8-flash] 
2026-09-05 08:28:51 [gemini-3.8-flash] 	nodes.sort()
2026-09-05 08:28:51 [gemini-3.8-flash] 	resources.sort()
2026-09-05 08:28:51 [gemini-3.8-flash] 	objects.sort()
2026-09-05 08:28:51 [gemini-3.8-flash] 	editors.sort()
