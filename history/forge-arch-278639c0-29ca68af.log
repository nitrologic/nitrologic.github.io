2026-09-29 20:30:46 [deepseek-flash] • `flushTile` keeps CPU data, drops GL:*
2026-09-29 20:30:46 [deepseek-flash] 
2026-09-29 20:30:46 [deepseek-flash] flushTile(tile){
2026-09-29 20:30:46 [deepseek-flash] 	const meesh=[tile.tilemesh,tile.floramesh,tile.staticmeesh,tile.flatmeesh].flat();
2026-09-29 20:30:46 [deepseek-flash] 	for(const mesh of meesh){
2026-09-29 20:30:46 [deepseek-flash] 		if(mesh){
2026-09-29 20:30:46 [deepseek-flash] 			this.graphicsLayers[0].removeMesh(mesh);
2026-09-29 20:30:46 [deepseek-flash] 		}
2026-09-29 20:30:46 [deepseek-flash] 	}
2026-09-29 20:30:46 [deepseek-flash] 	this._activeTiles.delete(tile);
2026-09-29 20:30:46 [deepseek-flash] 	tile.flushMesh();
2026-09-29 20:30:46 [deepseek-flash] }
