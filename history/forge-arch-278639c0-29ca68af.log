2026-09-23 07:08:45 [gemini-3.8-flash] function formatBytes(bytes: number): string {
2026-09-23 07:08:45 [gemini-3.8-flash] 	const units: string[] = ["B", "KB", "MB", "GB", "TB"];
2026-09-23 07:08:45 [gemini-3.8-flash] 	let size: number = bytes;
2026-09-23 07:08:45 [gemini-3.8-flash] 	let unitIndex: number = 0;
2026-09-23 07:08:45 [gemini-3.8-flash] 
2026-09-23 07:08:45 [gemini-3.8-flash] 	while (size >= 1024 && unitIndex < units.length - 1) {
2026-09-23 07:08:45 [gemini-3.8-flash] 		size /= 1024;
2026-09-23 07:08:45 [gemini-3.8-flash] 		unitIndex += 1;
2026-09-23 07:08:45 [gemini-3.8-flash] 	}
2026-09-23 07:08:45 [gemini-3.8-flash] 
2026-09-23 07:08:45 [gemini-3.8-flash] 	return `${size.toFixed(2)} ${units[unitIndex]}`;
