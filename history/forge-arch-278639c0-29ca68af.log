2026-09-28 11:07:34 [deepseek-flash] function heightmapBytes(heightmap){
2026-09-28 11:07:34 [deepseek-flash] 	if(!heightmap) return 0;
2026-09-28 11:07:34 [deepseek-flash] 	let bytes=0;
2026-09-28 11:07:34 [deepseek-flash] 	if(heightmap.topo) bytes+=heightmap.topo.byteLength;
2026-09-28 11:07:34 [deepseek-flash] 	if(heightmap.diff) bytes+=heightmap.diff.byteLength;
2026-09-28 11:07:34 [deepseek-flash] 	if(heightmap.ground) bytes+=heightmap.ground.byteLength;
2026-09-28 11:07:34 [deepseek-flash] 	return bytes;
2026-09-28 11:07:34 [deepseek-flash] }
2026-09-28 11:07:34 [deepseek-flash] 
2026-09-28 11:07:34 [deepseek-flash] function surfaceBytes(surface){
2026-09-28 11:07:34 [deepseek-flash] 	if(!surface) return 0;
2026-09-28 11:07:34 [deepseek-flash] 	let bytes=0;
2026-09-28 11:07:34 [deepseek-flash] 	if(surface.verts32) bytes+=surface.verts32.byteLength;
2026-09-28 11:07:34 [deepseek-flash] 	if(surface.tris){
2026-09-28 11:07:34 [deepseek-flash] 		const index=surface.vertCount>65535?4:2;
2026-09-28 11:07:34 [deepseek-flash] 		bytes+=surface.tris.length*index;
2026-09-28 11:07:34 [deepseek-flash] 	}
2026-09-28 11:07:34 [deepseek-flash] 	return bytes;
2026-09-28 11:07:34 [deepseek-flash] }
2026-09-28 11:07:34 [deepseek-flash] 
2026-09-28 11:07:34 [deepseek-flash] function shapeBytes(shape){
2026-09-28 11:07:34 [deepseek-flash] 	if(!shape) return 0;
2026-09-28 11:07:34 [deepseek-flash] 	let bytes=shape.bufferBytes||0;
2026-09-28 11:07:34 [deepseek-flash] 	if(shape.posrotdim16) bytes+=shape.posrotdim16.byteLength;
2026-09-28 11:07:34 [deepseek-flash] 	if(shape.transforms){
2026-09-28 11:07:34 [deepseek-flash] 		for(const t of shape.transforms){
2026-09-28 11:07:34 [deepseek-flash] 			bytes+=t.byteLength;
2026-09-28 11:07:34 [deepseek-flash] 		}
2026-09-28 11:07:34 [deepseek-flash] 	}
2026-09-28 11:07:34 [deepseek-flash] 	return bytes;
2026-09-28 11:07:34 [deepseek-flash] }
2026-09-28 11:07:34 [deepseek-flash] 
2026-09-28 11:07:34 [deepseek-flash] function tileBytes(tile){
2026-09-28 11:07:34 [deepseek-flash] 	let bytes=heightmapBytes(tile.heightmap);
2026-09-28 11:07:34 [deepseek-flash] 	bytes+=surfaceBytes(tile.topoSurface);
2026-09-28 11:07:34 [deepseek-flash] 	bytes+=surfaceBytes(tile.floraSurface);
2026-09-28 11:07:34 [deepseek-flash] 	bytes+=shapeBytes(tile.tilemesh);
2026-09-28 11:07:34 [deepseek-flash] 	bytes+=shapeBytes(tile.floramesh);
2026-09-28 11:07:34 [deepseek-flash] 	for(const mesh of tile.staticmeesh) bytes+=shapeBytes(mesh);
2026-09-28 11:07:34 [deepseek-flash] 	for(const mesh of tile.flatmeesh) bytes+=shapeBytes(mesh);
