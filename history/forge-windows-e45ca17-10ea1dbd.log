2025-11-03 10:11:20 [kimi-k2-0905] The range of ☐ (the box symbol) depends on context:
2025-11-03 10:11:20 [kimi-k2-0905] 
2025-11-03 10:11:20 [kimi-k2-0905] - In mathematics: It’s a placeholder—range is whatever you define it to be.
2025-11-03 10:11:20 [kimi-k2-0905] - In Unicode: U+2610 (decimal 9744).
2025-11-03 10:11:20 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] The logic you have now only distinguishes ASCII (1) vs. everything else (2).
2025-11-03 10:12:10 [kimi-k2-0905] Discord’s actual rules are:
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] - ASCII printable (0x20-0x7E) → 1
2025-11-03 10:12:10 [kimi-k2-0905] - East-Asian Fullwidth (U+1100-U+115F, U+2E80-U+A4CF, U+AC00-U+D7AF, U+F900-U+FAFF, U+FE10-U+FE1F,
2025-11-03 10:12:10 [kimi-k2-0905] U+FE30-U+FE6F, U+FF00-U+FF60, U+FFE0-U+FFE6, and the “Wide” category from the Unicode
2025-11-03 10:12:10 [kimi-k2-0905] East-Asian-Width file) → 2
2025-11-03 10:12:10 [kimi-k2-0905] - Everything else → 1
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] Below is a drop-in replacement that encodes those ranges in a small helper so you don’t need an
2025-11-03 10:12:10 [kimi-k2-0905] external data file.
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] export function discordStringWidth(text: string): number {
2025-11-03 10:12:10 [kimi-k2-0905] 	let w = 0;
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 	for (const ch of text) {
2025-11-03 10:12:10 [kimi-k2-0905] 		const cp = ch.codePointAt(0) ?? 0;
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 		// skip variation selectors
2025-11-03 10:12:10 [kimi-k2-0905] 		if (cp === 0xFE0F) continue;
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 		w += isFullWidth(cp) ? 2 : 1;
2025-11-03 10:12:10 [kimi-k2-0905] 	}
2025-11-03 10:12:10 [kimi-k2-0905] 	return w;
2025-11-03 10:12:10 [kimi-k2-0905] }
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] /* ---------- helpers ---------- */
2025-11-03 10:12:10 [kimi-k2-0905] function isFullWidth(cp: number): boolean {
2025-11-03 10:12:10 [kimi-k2-0905] 	// fast ASCII path
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp < 0x0020) return false;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp <= 0x007E) return false;          // printable ASCII
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 	// ranges known to be width 2 in Discord
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0x1100 && cp <= 0x115F) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0x2E80 && cp <= 0xA4CF) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0xAC00 && cp <= 0xD7AF) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0xF900 && cp <= 0xFAFF) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0xFE10 && cp <= 0xFE1F) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0xFE30 && cp <= 0xFE6F) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0xFF00 && cp <= 0xFF60) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 	if (cp >= 0xFFE0 && cp <= 0xFFE6) return true;
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 	return false;
2025-11-03 10:12:10 [kimi-k2-0905] }
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:10 [kimi-k2-0905] That gives the same column count Discord uses when it truncates or pads messages.
2025-11-03 10:12:10 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] export function discordStringWidth(text: string): number {
2025-11-03 10:12:25 [kimi-k2-0905] 	let w = 0;
2025-11-03 10:12:25 [kimi-k2-0905] 	let insideMath = false;
2025-11-03 10:12:25 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] 	for (let i = 0; i < text.length; ) {
2025-11-03 10:12:25 [kimi-k2-0905] 		const cp = text.codePointAt(i) ?? 0;
2025-11-03 10:12:25 [kimi-k2-0905] 		const ch = String.fromCodePoint(cp);
2025-11-03 10:12:25 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] 		// toggle math block markers
2025-11-03 10:12:25 [kimi-k2-0905] 		if (ch === '`') {
2025-11-03 10:12:25 [kimi-k2-0905] 			let k = i + ch.length;
2025-11-03 10:12:25 [kimi-k2-0905] 			let backticks = 1;
2025-11-03 10:12:25 [kimi-k2-0905] 			while (k < text.length && text.codePointAt(k) === 0x60) {
2025-11-03 10:12:25 [kimi-k2-0905] 				backticks++;
2025-11-03 10:12:25 [kimi-k2-0905] 				k++;
2025-11-03 10:12:25 [kimi-k2-0905] 			}
2025-11-03 10:12:25 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] 			if (backticks >= 3) {
2025-11-03 10:12:25 [kimi-k2-0905] 				insideMath = !insideMath;
2025-11-03 10:12:25 [kimi-k2-0905] 				i = k;               // skip whole marker
2025-11-03 10:12:25 [kimi-k2-0905] 				continue;
2025-11-03 10:12:25 [kimi-k2-0905] 			}
2025-11-03 10:12:25 [kimi-k2-0905] 		}
2025-11-03 10:12:25 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] 		if (insideMath) {
2025-11-03 10:12:25 [kimi-k2-0905] 			w += 1;                  // everything inside math counts as 1
2025-11-03 10:12:25 [kimi-k2-0905] 		} else {
2025-11-03 10:12:25 [kimi-k2-0905] 			if (cp === 0xFE0F) {     // skip variation selector
2025-11-03 10:12:25 [kimi-k2-0905] 				i += ch.length;
2025-11-03 10:12:25 [kimi-k2-0905] 				continue;
2025-11-03 10:12:25 [kimi-k2-0905] 			}
2025-11-03 10:12:25 [kimi-k2-0905] 			w += (cp < 128) ? 1 : 2;
2025-11-03 10:12:25 [kimi-k2-0905] 		}
2025-11-03 10:12:25 [kimi-k2-0905] 		i += ch.length;
2025-11-03 10:12:25 [kimi-k2-0905] 	}
2025-11-03 10:12:25 [kimi-k2-0905] 	return w;
2025-11-03 10:12:25 [kimi-k2-0905] }
2025-11-03 10:12:25 [kimi-k2-0905] 
2025-11-03 10:12:25 [kimi-k2-0905] 
