2025-11-28 12:22:38 [kimi-k2-0905] ARM side (snippets)
2025-11-28 12:22:38 [kimi-k2-0905] 
2025-11-28 12:22:38 [kimi-k2-0905] #include "luma_sync.h"
2025-11-28 12:22:38 [kimi-k2-0905] #include "hardware/irq.h"
2025-11-28 12:22:38 [kimi-k2-0905] 
2025-11-28 12:22:38 [kimi-k2-0905] static volatile bool vsync_flag = false;
2025-11-28 12:22:38 [kimi-k2-0905] static volatile uint32_t hsync_count = 0;
2025-11-28 12:22:38 [kimi-k2-0905] 
2025-11-28 12:22:38 [kimi-k2-0905] void pio0_irq0_handler(void) {
2025-11-28 12:22:38 [kimi-k2-0905]     if (pio0->ints0 & (1 << (PIO_IRQ0_INTS_SM0_RXNEMPTY_BITS + 0))) {
2025-11-28 12:22:38 [kimi-k2-0905]         pio0->irq = 1 << 0;          // clear HSYNC irq
2025-11-28 12:22:38 [kimi-k2-0905]         hsync_count++;
2025-11-28 12:22:38 [kimi-k2-0905]     }
2025-11-28 12:22:38 [kimi-k2-0905] }
2025-11-28 12:22:38 [kimi-k2-0905] 
2025-11-28 12:22:38 [kimi-k2-0905] void pio0_irq1_handler(void) {
2025-11-28 12:22:39 [kimi-k2-0905]     if (pio0->ints0 & (1 << (PIO_IRQ0_INTS_SM0_RXNEMPTY_BITS + 1))) {
