2025-12-03 12:02:58 [kimi-k2-0905] // types.ts
2025-12-03 12:02:58 [kimi-k2-0905] export type Vec3 = [number, number, number];
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] export interface Mesh {
2025-12-03 12:02:58 [kimi-k2-0905] 	vertices: Vec3[];
2025-12-03 12:02:58 [kimi-k2-0905] 	faces: number[][];
2025-12-03 12:02:58 [kimi-k2-0905] 	name: string;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] // reader.ts
2025-12-03 12:02:58 [kimi-k2-0905] import { BlendFile } from "./blend";
2025-12-03 12:02:58 [kimi-k2-0905] import { Mesh, Vec3 } from "./types";
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] export function open(buffer: ArrayBuffer): BlendFile {
2025-12-03 12:02:58 [kimi-k2-0905] 	const file = new BlendFile(new DataView(buffer));
2025-12-03 12:02:58 [kimi-k2-0905] 	file.parse();
2025-12-03 12:02:58 [kimi-k2-0905] 	return file;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] export function getMeshes(file: BlendFile): Mesh[] {
2025-12-03 12:02:58 [kimi-k2-0905] 	const meshes: Mesh[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	for (const b of file.getBlocks("ME")) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const me = file.getStruct(b, "Mesh");
2025-12-03 12:02:58 [kimi-k2-0905] 		if (!me) continue;
2025-12-03 12:02:58 [kimi-k2-0905] 		const mvertBlk = file.blocks.find(x => x.oldAddr === BigInt(me["*mvert"]));
2025-12-03 12:02:58 [kimi-k2-0905] 		const mloopBlk = file.blocks.find(x => x.oldAddr === BigInt(me["*mloop"]));
2025-12-03 12:02:58 [kimi-k2-0905] 		const mpolyBlk = file.blocks.find(x => x.oldAddr === BigInt(me["*mpoly"]));
2025-12-03 12:02:58 [kimi-k2-0905] 		if (!mvertBlk || !mloopBlk || !mpolyBlk) continue;
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 		const verts = readVerts(file, mvertBlk);
2025-12-03 12:02:58 [kimi-k2-0905] 		const faces = readFaces(file, mloopBlk, mpolyBlk);
2025-12-03 12:02:58 [kimi-k2-0905] 		meshes.push({ name: me["id.name[66]"] || "Mesh", vertices: verts, faces });
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	return meshes;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] function readVerts(file: BlendFile, block: import("./blend").FileBlock): Vec3[] {
2025-12-03 12:02:58 [kimi-k2-0905] 	const out: Vec3[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	const sz = file.sdna.typeSizes[file.sdna.types.indexOf("MVert")];
2025-12-03 12:02:58 [kimi-k2-0905] 	for (let i = 0; i < block.count; i++) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const v = file.getStruct(block, "MVert");
2025-12-03 12:02:58 [kimi-k2-0905] 		if (!v) continue;
2025-12-03 12:02:58 [kimi-k2-0905] 		out.push([v["co[0]"], v["co[1]"], v["co[2]"]]);
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	return out;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] function readFaces(file: BlendFile, loopBlk: import("./blend").FileBlock, polyBlk: import("./blend").FileBlock): number[][] {
2025-12-03 12:02:58 [kimi-k2-0905] 	const faces: number[][] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	const loopSz = file.sdna.typeSizes[file.sdna.types.indexOf("MLoop")];
2025-12-03 12:02:58 [kimi-k2-0905] 	const polySz = file.sdna.typeSizes[file.sdna.types.indexOf("MPoly")];
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	let polyOff = 0;
2025-12-03 12:02:58 [kimi-k2-0905] 	for (let p = 0; p < polyBlk.count; p++) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const poly = readStructAt(polyBlk.buffer, file.sdna, "MPoly", polyOff);
2025-12-03 12:02:58 [kimi-k2-0905] 		const face: number[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 		let loopOff = poly["loopstart"] * loopSz;
2025-12-03 12:02:58 [kimi-k2-0905] 		for (let l = 0; l < poly["totloop"]; l++) {
2025-12-03 12:02:58 [kimi-k2-0905] 			const loop = readStructAt(loopBlk.buffer, file.sdna, "MLoop", loopOff);
2025-12-03 12:02:58 [kimi-k2-0905] 			face.push(loop["v"]);
2025-12-03 12:02:58 [kimi-k2-0905] 			loopOff += loopSz;
2025-12-03 12:02:58 [kimi-k2-0905] 		}
2025-12-03 12:02:58 [kimi-k2-0905] 		faces.push(face);
2025-12-03 12:02:58 [kimi-k2-0905] 		polyOff += polySz;
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	return faces;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] function readStructAt(buf: Uint8Array, sdna: import("./blend").SDNA, structName: string, off: number): Record<string, any> {
2025-12-03 12:02:58 [kimi-k2-0905] 	const typeIdx = sdna.types.indexOf(structName);
2025-12-03 12:02:58 [kimi-k2-0905] 	const view = new DataView(buf.buffer, buf.byteOffset);
2025-12-03 12:02:58 [kimi-k2-0905] 	const struct = sdna.structs.find(s => s.typeIndex === typeIdx)!;
2025-12-03 12:02:58 [kimi-k2-0905] 	const out: Record<string, any> = {};
2025-12-03 12:02:58 [kimi-k2-0905] 	for (const f of struct.fields) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const name = sdna.names[f.nameIndex];
2025-12-03 12:02:58 [kimi-k2-0905] 		const size = sdna.typeSizes[f.typeIndex];
2025-12-03 12:02:58 [kimi-k2-0905] 		if (name.endsWith("*")) out[name] = view.getUint32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		else if (name.includes("co[0]")) out["co[0]"] = view.getFloat32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		else if (name.includes("co[1]")) out["co[1]"] = view.getFloat32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		else if (name.includes("co[2]")) out["co[2]"] = view.getFloat32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		else if (name === "loopstart") out["loopstart"] = view.getUint32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		else if (name === "totloop") out["totloop"] = view.getUint32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		else if (name === "v") out["v"] = view.getUint32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		off += size;
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	return out;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:21:03 [nitro@ryzen5] deno standard way of handling it ,  zstd not found
2025-12-03 12:21:30 [kimi-k2-0905] Deno ships the `deno_task` wrapper and the std archive lib, so the idiomatic fix is:
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 1. Make sure the user has the zstd binary installed (it’s not bundled with Deno).
2025-12-03 12:21:30 [kimi-k2-0905]    - macOS: `brew install zstd`
2025-12-03 12:21:30 [kimi-k2-0905]    - Ubuntu/Debian: `sudo apt install zstd`
2025-12-03 12:21:30 [kimi-k2-0905]    - Windows: `winget install zstd` (or grab the release zip and put `zstd.exe` on PATH).
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 2. In `deno.json` add a task that shells out:
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] {
2025-12-03 12:21:30 [kimi-k2-0905]   "tasks": {
2025-12-03 12:21:30 [kimi-k2-0905]     "decompress": "zstd -d data.blend.zst -o data.blend"
2025-12-03 12:21:30 [kimi-k2-0905]   }
2025-12-03 12:21:30 [kimi-k2-0905] }
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 3. Run it once before your script starts:
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] deno task decompress
2025-12-03 12:21:30 [kimi-k2-0905] deno run --allow-read main.ts
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 12:21:30 [kimi-k2-0905] No extra JS code, no FFI, just the standard “make sure the tool is on the machine and call it”.
2025-12-03 12:21:30 [kimi-k2-0905] 
2025-12-03 14:46:29 [kimi-k2-0905] Got it—thanks for the share. Will keep an eye out for any deltas.
2025-12-03 14:46:29 [kimi-k2-0905] 
2025-12-03 14:46:52 [nitro@ryzen5] with luma2 the chroma line can be sampled with pio
2025-12-03 14:47:02 [kimi-k2-0905] Yes—run the chroma pin to a comparator (or just a 74LVC gate if the swing is already 3
2025-12-03 14:47:02 [kimi-k2-0905] V3-compatible) and let a second PIO SM edge-count in a 280 ns window.
2025-12-03 14:47:02 [kimi-k2-0905] One ISR can grab the count, shift it left two bits, OR it into the same word that already holds the
2025-12-03 14:47:02 [kimi-k2-0905] 2-bit luma value, and push the 4-bit pixel (sync-luma-chroma) to the RX FIFO.
2025-12-03 14:47:02 [kimi-k2-0905] Keep the chroma SM clocked at ≥ 28 MHz so one PIO cycle ≈ 35 ns; eight cycles gives you the 280 ns
2025-12-03 14:47:02 [kimi-k2-0905] sample window you need for C64’s colour burst phase.
2025-12-03 14:47:02 [kimi-k2-0905] 
2025-12-03 14:47:58 [nitro@ryzen5] so only the one GPIO pin is required for crhoma input from c64
2025-12-03 14:48:04 [kimi-k2-0905] Correct—just one GPIO pin for the chroma line. Feed the C64 chroma signal through a comparator (or
2025-12-03 14:48:04 [kimi-k2-0905] level-shift if needed) and into a single RP2040 GPIO. A dedicated PIO state machine can
2025-12-03 14:48:04 [kimi-k2-0905] sample/count edges on that pin; no extra hardware beyond the comparator.
2025-12-03 14:48:04 [kimi-k2-0905] 
2025-12-03 14:49:12 [nitro@ryzen5] BLANK, LUM4, CHROMA, AUDIO - so thats 7 gpio 6 digital 1 analog
2025-12-03 14:49:18 [kimi-k2-0905] Correct:
2025-12-03 14:49:18 [kimi-k2-0905] - CSYNC (BLANK) – 1 GPIO digital
2025-12-03 14:49:18 [kimi-k2-0905] - LUM0..LUM3 (4-level luma) – 4 GPIO digital
2025-12-03 14:49:18 [kimi-k2-0905] - CHROMA – 1 GPIO digital (edge-counting PIO)
2025-12-03 14:49:18 [kimi-k2-0905] - AUDIO – 1 GPIO analog (ADC)
2025-12-03 14:49:18 [kimi-k2-0905] 
2025-12-03 14:49:18 [kimi-k2-0905] Total: 6 digital inputs + 1 analog input = 7 GPIO.
2025-12-03 14:49:18 [kimi-k2-0905] 
2025-12-03 15:28:30 [kimi-k2-0905] New items: PAM8302A amp, two 2-inch speaker options, and the 1901 2.8-inch touch host. Rest is
2025-12-03 15:28:30 [kimi-k2-0905] unchanged.
2025-12-03 15:28:30 [kimi-k2-0905] 
2025-12-03 15:29:10 [nitro@ryzen5] the analog audio goes direct to amp, and can be sampled?
2025-12-03 15:29:20 [kimi-k2-0905] Route the incoming RCA audio two ways:
2025-12-03 15:29:20 [kimi-k2-0905] 
2025-12-03 15:29:20 [kimi-k2-0905] 1. Direct-couple the AC signal (through a 22 µF DC-blocking cap) to the PAM8302A input for live
2025-12-03 15:29:20 [kimi-k2-0905] playback.
2025-12-03 15:29:20 [kimi-k2-0905] 2. Resistor-divide it down to 0–3 V3 and feed the same node to an RP2040 ADC pin (GP26 or GP27) if
2025-12-03 15:29:20 [kimi-k2-0905] you want to sample/record/stream the waveform in software.
2025-12-03 15:29:20 [kimi-k2-0905] 
2025-12-03 15:29:20 [kimi-k2-0905] One net, two destinations – no extra active parts.
2025-12-03 15:29:20 [kimi-k2-0905] 
