2025-11-04 09:19:02 [kimi-k2-0905] const payload = {
2025-11-04 09:19:02 [kimi-k2-0905] 	content: "",           // empty if you only want the embed
2025-11-04 09:19:02 [kimi-k2-0905] 	embeds: [{
2025-11-04 09:19:02 [kimi-k2-0905] 		title: "Test Embed",
2025-11-04 09:19:02 [kimi-k2-0905] 		description: "It works!",
2025-11-04 09:19:02 [kimi-k2-0905] 		color: 0x57F287
2025-11-04 09:19:02 [kimi-k2-0905] 	}]
2025-11-04 09:19:02 [kimi-k2-0905] };
2025-11-04 09:19:02 [kimi-k2-0905] 
2025-11-04 09:19:02 [kimi-k2-0905] fetch(WEBHOOK_URL, {
2025-11-04 09:19:02 [kimi-k2-0905] 	method: "POST",
2025-11-04 09:19:02 [kimi-k2-0905] 	headers: { "Content-Type": "application/json" },
2025-11-04 09:19:02 [kimi-k2-0905] 	body: JSON.stringify(payload)
2025-11-04 09:19:02 [kimi-k2-0905] });
