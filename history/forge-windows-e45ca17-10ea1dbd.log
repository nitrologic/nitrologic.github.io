2025-12-01 17:23:14 [gemini-3-pro] This is a very complete specification for an RP2040-based retro input adapter. The architecture is
2025-12-01 17:23:14 [gemini-3-pro] sound: using 74LS374s to drive 2N7000 FETs is an excellent way to simulate the "open
2025-12-01 17:23:14 [gemini-3-pro] collector/drain" switching to ground required by Commodore, Atari, and Sega hardware while keeping
2025-12-01 17:23:14 [gemini-3-pro] the logic side safe.
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] Here is a JavaScript implementation (targeting an RP2040 JS runtime like Kaluma or Espruino) that
2025-12-01 17:23:14 [gemini-3-pro] implements the driver logic based on your BOM and pinout.
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] firmware/drivers/joy-hub.js
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] const config = require('./project-joy-config'); // Assuming your snippet is saved here
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] class JoyHub {
2025-12-01 17:23:14 [gemini-3-pro] 	constructor() {
2025-12-01 17:23:14 [gemini-3-pro] 		this.pins = {};
2025-12-01 17:23:14 [gemini-3-pro] 		this.state = {
2025-12-01 17:23:14 [gemini-3-pro] 			digital: new Uint8Array(5), // 5x 74HC165
2025-12-01 17:23:14 [gemini-3-pro] 			analog: new Uint16Array(16) // 2x CD4051 (8 channels each)
2025-12-01 17:23:14 [gemini-3-pro] 		};
2025-12-01 17:23:14 [gemini-3-pro] 		this.initGPIO();
2025-12-01 17:23:14 [gemini-3-pro] 	}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 	initGPIO() {
2025-12-01 17:23:14 [gemini-3-pro] 		// Setup Control Pins
2025-12-01 17:23:14 [gemini-3-pro] 		const p = config.gpio;
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Shift Register Control
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[2].name, OUTPUT); // CLK
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[3].name, OUTPUT); // SH/LD
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[4].name, INPUT);  // DATA IN
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Mux Control
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[6].name, OUTPUT); // S0
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[7].name, OUTPUT); // S1
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[8].name, OUTPUT); // S2
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Latch Bus (D0-D7)
2025-12-01 17:23:14 [gemini-3-pro] 		for (let i = 10; i <= 17; i++) {
2025-12-01 17:23:14 [gemini-3-pro] 			pinMode(p[i].name, OUTPUT);
2025-12-01 17:23:14 [gemini-3-pro] 		}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Latch Clocks
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[18].name, OUTPUT); // CP0
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[19].name, OUTPUT); // CP1
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[20].name, OUTPUT); // CP2
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[21].name, OUTPUT); // OE
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Sega Select
2025-12-01 17:23:14 [gemini-3-pro] 		pinMode(p[5].name, OUTPUT);
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(p[5].name, HIGH); // Default High
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Enable Latches (Active Low)
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(p[21].name, LOW);
2025-12-01 17:23:14 [gemini-3-pro] 	}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 	/**
2025-12-01 17:23:14 [gemini-3-pro] 	 * Reads the 5 cascaded 74HC165 shift registers
2025-12-01 17:23:14 [gemini-3-pro] 	 */
2025-12-01 17:23:14 [gemini-3-pro] 	readDigitalInputs() {
2025-12-01 17:23:14 [gemini-3-pro] 		const clk = config.gpio[2].name;
2025-12-01 17:23:14 [gemini-3-pro] 		const sh_ld = config.gpio[3].name;
2025-12-01 17:23:14 [gemini-3-pro] 		const data = config.gpio[4].name;
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Latch data into registers
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(sh_ld, LOW);
2025-12-01 17:23:14 [gemini-3-pro] 		delayMicroseconds(1);
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(sh_ld, HIGH);
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Read 40 bits (5 chips * 8 bits)
2025-12-01 17:23:14 [gemini-3-pro] 		for (let i = 0; i < 5; i++) {
2025-12-01 17:23:14 [gemini-3-pro] 			let byteVal = 0;
2025-12-01 17:23:14 [gemini-3-pro] 			for (let b = 0; b < 8; b++) {
2025-12-01 17:23:14 [gemini-3-pro] 				byteVal = (byteVal << 1) | digitalRead(data);
2025-12-01 17:23:14 [gemini-3-pro] 				digitalWrite(clk, HIGH);
2025-12-01 17:23:14 [gemini-3-pro] 				// delayMicroseconds(1) // Uncomment if signal integrity issues arise
2025-12-01 17:23:14 [gemini-3-pro] 				digitalWrite(clk, LOW);
2025-12-01 17:23:14 [gemini-3-pro] 			}
2025-12-01 17:23:14 [gemini-3-pro] 			this.state.digital[i] = byteVal;
2025-12-01 17:23:14 [gemini-3-pro] 		}
2025-12-01 17:23:14 [gemini-3-pro] 	}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 	/**
2025-12-01 17:23:14 [gemini-3-pro] 	 * Writes data to the shared bus and latches it to specific 74LS374
2025-12-01 17:23:14 [gemini-3-pro] 	 * @param {number} latchId - 0, 1, or 2 (corresponding to CP0, CP1, CP2)
2025-12-01 17:23:14 [gemini-3-pro] 	 * @param {number} byteVal - The 8-bit value to write
2025-12-01 17:23:14 [gemini-3-pro] 	 */
2025-12-01 17:23:14 [gemini-3-pro] 	writeLatch(latchId, byteVal) {
2025-12-01 17:23:14 [gemini-3-pro] 		// Set Bus D0-D7
2025-12-01 17:23:14 [gemini-3-pro] 		for (let i = 0; i < 8; i++) {
2025-12-01 17:23:14 [gemini-3-pro] 			// GP10 is D0, so GP10+i is Di
2025-12-01 17:23:14 [gemini-3-pro] 			digitalWrite(config.gpio[10 + i].name, (byteVal >> i) & 1);
2025-12-01 17:23:14 [gemini-3-pro] 		}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Pulse specific Clock Pin
2025-12-01 17:23:14 [gemini-3-pro] 		// CP0=GP18, CP1=GP19, CP2=GP20
2025-12-01 17:23:14 [gemini-3-pro] 		const cpPin = config.gpio[18 + latchId].name;
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(cpPin, HIGH);
2025-12-01 17:23:14 [gemini-3-pro] 		// LS374 latches on rising edge, ensure setup time
2025-12-01 17:23:14 [gemini-3-pro] 		delayMicroseconds(1);
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(cpPin, LOW);
2025-12-01 17:23:14 [gemini-3-pro] 	}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 	/**
2025-12-01 17:23:14 [gemini-3-pro] 	 * Reads all 16 analog channels via CD4051 muxes
2025-12-01 17:23:14 [gemini-3-pro] 	 */
2025-12-01 17:23:14 [gemini-3-pro] 	readAnalogInputs() {
2025-12-01 17:23:14 [gemini-3-pro] 		const s0 = config.gpio[6].name;
2025-12-01 17:23:14 [gemini-3-pro] 		const s1 = config.gpio[7].name;
2025-12-01 17:23:14 [gemini-3-pro] 		const s2 = config.gpio[8].name;
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		for (let i = 0; i < 8; i++) {
2025-12-01 17:23:14 [gemini-3-pro] 			// Set Address
2025-12-01 17:23:14 [gemini-3-pro] 			digitalWrite(s0, i & 1);
2025-12-01 17:23:14 [gemini-3-pro] 			digitalWrite(s1, (i >> 1) & 1);
2025-12-01 17:23:14 [gemini-3-pro] 			digitalWrite(s2, (i >> 2) & 1);
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 			// Stabilize Mux
2025-12-01 17:23:14 [gemini-3-pro] 			delayMicroseconds(10);
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 			// Read ADC0 (GP26) and ADC1 (GP27)
2025-12-01 17:23:14 [gemini-3-pro] 			// Assuming analogRead returns 0-1 (float) or 0-65535 depending on runtime
2025-12-01 17:23:14 [gemini-3-pro] 			this.state.analog[i] = analogRead(config.gpio[26].name);     // Mux U9
2025-12-01 17:23:14 [gemini-3-pro] 			this.state.analog[i + 8] = analogRead(config.gpio[27].name); // Mux U10
2025-12-01 17:23:14 [gemini-3-pro] 		}
2025-12-01 17:23:14 [gemini-3-pro] 	}
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 	/**
2025-12-01 17:23:14 [gemini-3-pro] 	 * Handles Sega 6-button multiplexing logic
2025-12-01 17:23:14 [gemini-3-pro] 	 * Requires toggling GP5 (Select) and re-reading inputs
2025-12-01 17:23:14 [gemini-3-pro] 	 */
2025-12-01 17:23:14 [gemini-3-pro] 	processSegaCycle() {
2025-12-01 17:23:14 [gemini-3-pro] 		const sel = config.gpio[5].name;
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// 1. Read standard (Select HIGH)
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(sel, HIGH);
2025-12-01 17:23:14 [gemini-3-pro] 		delayMicroseconds(20);
2025-12-01 17:23:14 [gemini-3-pro] 		this.readDigitalInputs();
2025-12-01 17:23:14 [gemini-3-pro] 		const highState = new Uint8Array(this.state.digital);
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// 2. Read extended (Select LOW)
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(sel, LOW);
2025-12-01 17:23:14 [gemini-3-pro] 		delayMicroseconds(20);
2025-12-01 17:23:14 [gemini-3-pro] 		this.readDigitalInputs();
2025-12-01 17:23:14 [gemini-3-pro] 		const lowState = new Uint8Array(this.state.digital);
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 		// Logic to merge standard and extended inputs would go here
2025-12-01 17:23:14 [gemini-3-pro] 		// restoring Select High for next loop
2025-12-01 17:23:14 [gemini-3-pro] 		digitalWrite(sel, HIGH);
2025-12-01 17:23:14 [gemini-3-pro] 	}
2025-12-01 17:23:14 [gemini-3-pro] }
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] module.exports = JoyHub;
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] Hardware Implementation Notes
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 1.  Sega Pin 7 Safety: Your note regarding DB9 Pin 7 is critical.
2025-12-01 17:23:14 [gemini-3-pro]     *   Atari: Pin 7 is +5V.
2025-12-01 17:23:14 [gemini-3-pro]     *   Sega: Pin 7 is Select (Input).
2025-12-01 17:23:14 [gemini-3-pro]     *   Risk: If you drive GP5 LOW (0V) while an Atari stick is plugged in (Pin 7 at 5V),
2025-12-01 17:23:14 [gemini-3-pro] you create a direct short through the RP2040 GPIO.
2025-12-01 17:23:14 [gemini-3-pro]     *   Mitigation: Ensure there is a series resistor (e.g., 220Ω - 330Ω) on GP5 to limit
2025-12-01 17:23:14 [gemini-3-pro] current to ~15-20mA in case of a short, or use a polyfuse/switchable header as defined in your
2025-12-01 17:23:14 [gemini-3-pro] notes.
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 2.  Shared Bus Timing:
2025-12-01 17:23:14 [gemini-3-pro]     *   The 74LS374 latches on the Rising Edge of CP.
2025-12-01 17:23:14 [gemini-3-pro]     *   The code sets the Data Bus (D0-D7) first, then pulses CP HIGH then LOW. Ensure the data bus
2025-12-01 17:23:14 [gemini-3-pro] is stable before the rising edge of CP.
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 3.  FET Logic Inversion:
2025-12-01 17:23:14 [gemini-3-pro]     *   Your spec: "Latch HIGH = FET ON = joystick line pulled LOW".
2025-12-01 17:23:14 [gemini-3-pro]     *   This is correct. When you write a `1` to the latch, the 2N7000 Gate goes high, Drain
2025-12-01 17:23:14 [gemini-3-pro] connects to Source (GND), simulating a button press.
2025-12-01 17:23:14 [gemini-3-pro]     *   When you write a `0`, FET is OFF, line floats (High impedance), allowing the console
2025-12-01 17:23:14 [gemini-3-pro] internal pull-up to register logic High (not pressed).
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:23:14 [gemini-3-pro] 4.  Analog Mux:
2025-12-01 17:23:14 [gemini-3-pro]     *   The CD4051 inputs must not exceed VDD (3.3V). Since retro consoles often supply 5V on
2025-12-01 17:23:14 [gemini-3-pro] potentiometer lines (e.g., Apple II), ensure the voltage dividers on the inputs (implied by your
2025-12-01 17:23:14 [gemini-3-pro] protection notes) bring the max signal below 3.3V.
2025-12-01 17:23:14 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] Based on the project definition and wiring provided, here is a Node.js UDP server script. It
2025-12-01 17:41:51 [gemini-3-pro] listens on port 8081 for JSON state objects, maps the logical inputs to the hardware latch wiring
2025-12-01 17:41:51 [gemini-3-pro] (U6, U7, U8), and generates the 3-byte buffer required by the RP2040 to drive the FETs.
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] /**
2025-12-01 17:41:51 [gemini-3-pro]  * joy-server.js
2025-12-01 17:41:51 [gemini-3-pro]  * Project Joy Remote Driver
2025-12-01 17:41:51 [gemini-3-pro]  * Listens for JSON command "slop" on UDP 8081 and maps to hardware latches.
2025-12-01 17:41:51 [gemini-3-pro]  *
2025-12-01 17:41:51 [gemini-3-pro]  * Usage: echo '{"joy1":{"up":1,"fire":1}}' | nc -u 127.0.0.1 8081
2025-12-01 17:41:51 [gemini-3-pro]  */
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] const dgram = require('node:dgram');
2025-12-01 17:41:51 [gemini-3-pro] const server = dgram.createSocket('udp4');
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] const PORT = 8081;
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] // Hardware Mapping: [Latch ID (6=U6, 7=U7, 8=U8), Bit Position (0-7)]
2025-12-01 17:41:51 [gemini-3-pro] // Based on wiring: U6 drives Joy1+Joy2(part), U7 drives Joy2(part)+Joy3+Joy4(part), U8 drives Joy4(part)+Apple
2025-12-01 17:41:51 [gemini-3-pro] const PIN_MAP = {
2025-12-01 17:41:51 [gemini-3-pro] 	joy1: {
2025-12-01 17:41:51 [gemini-3-pro] 		up: [6, 0], dn: [6, 1], lt: [6, 2], rt: [6, 3], fire: [6, 4]
2025-12-01 17:41:51 [gemini-3-pro] 	},
2025-12-01 17:41:51 [gemini-3-pro] 	joy2: {
2025-12-01 17:41:51 [gemini-3-pro] 		up: [6, 5], dn: [6, 6], lt: [6, 7], rt: [7, 0], fire: [7, 1]
2025-12-01 17:41:51 [gemini-3-pro] 	},
2025-12-01 17:41:51 [gemini-3-pro] 	joy3: {
2025-12-01 17:41:51 [gemini-3-pro] 		up: [7, 2], dn: [7, 3], lt: [7, 4], rt: [7, 5], fire: [7, 6]
2025-12-01 17:41:51 [gemini-3-pro] 	},
2025-12-01 17:41:51 [gemini-3-pro] 	joy4: {
2025-12-01 17:41:51 [gemini-3-pro] 		up: [7, 7], dn: [8, 0], lt: [8, 1], rt: [8, 2], fire: [8, 3]
2025-12-01 17:41:51 [gemini-3-pro] 	},
2025-12-01 17:41:51 [gemini-3-pro] 	apple: {
2025-12-01 17:41:51 [gemini-3-pro] 		sw0: [8, 4], sw1: [8, 5], sw2: [8, 6], an0: [8, 7]
2025-12-01 17:41:51 [gemini-3-pro] 	}
2025-12-01 17:41:51 [gemini-3-pro] };
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] function generateLatchBytes(state) {
2025-12-01 17:41:51 [gemini-3-pro] 	// Initialize latch bytes: U6, U7, U8
2025-12-01 17:41:51 [gemini-3-pro] 	const latches = { 6: 0x00, 7: 0x00, 8: 0x00 };
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] 	for (const [device, inputs] of Object.entries(state)) {
2025-12-01 17:41:51 [gemini-3-pro] 		if (!PIN_MAP[device]) continue;
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] 		for (const [input, active] of Object.entries(inputs)) {
2025-12-01 17:41:51 [gemini-3-pro] 			if (active && PIN_MAP[device][input]) {
2025-12-01 17:41:51 [gemini-3-pro] 				const [latchId, bit] = PIN_MAP[device][input];
2025-12-01 17:41:51 [gemini-3-pro] 				// Latch HIGH = FET ON = Line LOW (Active)
2025-12-01 17:41:51 [gemini-3-pro] 				latches[latchId] |= (1 << bit);
2025-12-01 17:41:51 [gemini-3-pro] 			}
2025-12-01 17:41:51 [gemini-3-pro] 		}
2025-12-01 17:41:51 [gemini-3-pro] 	}
2025-12-01 17:41:51 [gemini-3-pro] 
2025-12-01 17:41:51 [gemini-3-pro] 	return Buffer.from([latches[6], latches[7], latches[8]]);
2025-12-01 17:41:51 [gemini-3-pro] }
