2025-11-03 12:17:33 [deepseek-chat] function calculateUserLines(logData: string): Record<string, number> {
2025-11-03 12:17:33 [deepseek-chat]     const userTotals: Record<string, number> = {};
2025-11-03 12:17:33 [deepseek-chat]     const lines = logData.split('\n');
2025-11-03 12:17:33 [deepseek-chat] 
2025-11-03 12:17:33 [deepseek-chat]     for (const line of lines) {
2025-11-03 12:17:33 [deepseek-chat]         // Look for lines with user counts in format: username[count]
2025-11-03 12:17:33 [deepseek-chat]         const userMatches = line.matchAll(/(\w+[@\w-]+)\[(\d+)\]/g);
2025-11-03 12:17:33 [deepseek-chat] 
2025-11-03 12:17:33 [deepseek-chat]         for (const match of userMatches) {
2025-11-03 12:17:33 [deepseek-chat]             const username = match[1];
2025-11-03 12:17:33 [deepseek-chat]             const count = parseInt(match[2]);
2025-11-03 12:17:33 [deepseek-chat] 
2025-11-03 12:17:33 [deepseek-chat]             if (!isNaN(count)) {
2025-11-03 12:17:33 [deepseek-chat]                 userTotals[username] = (userTotals[username] || 0) + count;
2025-11-03 12:17:33 [deepseek-chat]             }
2025-11-03 12:17:33 [deepseek-chat]         }
2025-11-03 12:17:33 [deepseek-chat]     }
2025-11-03 12:17:33 [deepseek-chat] 
2025-11-03 12:17:33 [deepseek-chat]     return userTotals;
2025-11-03 12:17:33 [deepseek-chat] }
