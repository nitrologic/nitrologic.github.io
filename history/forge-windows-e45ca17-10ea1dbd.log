2025-11-27 14:22:20 [nitro@ryzen5] how about remove earliest use of duplicate I
2025-11-27 14:23:04 [gemini-3-pro] Here is a named function to process the JSON object. It identifies any code appearing more than
2025-11-27 14:23:04 [gemini-3-pro] once (either within the same list or across different orders) and removes the very first occurrence
2025-11-27 14:23:04 [gemini-3-pro] found, preserving the later ones.
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] function removeEarliestDuplicates(taxonomyData) {
2025-11-27 14:23:04 [gemini-3-pro] 	const codeMap = new Map();
2025-11-27 14:23:04 [gemini-3-pro] 	const indicesToRemove = new Set();
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 	// Pass 1: Map every code to a list of its locations {order, index}
2025-11-27 14:23:04 [gemini-3-pro] 	for (const orderName in taxonomyData.orders) {
2025-11-27 14:23:04 [gemini-3-pro] 		const codes = taxonomyData.orders[orderName].codes;
2025-11-27 14:23:04 [gemini-3-pro] 		for (let i = 0; i < codes.length; i++) {
2025-11-27 14:23:04 [gemini-3-pro] 			const code = codes[i];
2025-11-27 14:23:04 [gemini-3-pro] 			if (!codeMap.has(code)) {
2025-11-27 14:23:04 [gemini-3-pro] 				codeMap.set(code, []);
2025-11-27 14:23:04 [gemini-3-pro] 			}
2025-11-27 14:23:04 [gemini-3-pro] 			codeMap.get(code).push({ order: orderName, index: i });
2025-11-27 14:23:04 [gemini-3-pro] 		}
2025-11-27 14:23:04 [gemini-3-pro] 	}
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 	// Pass 2: Identify the first index of any code appearing > 1 time
2025-11-27 14:23:04 [gemini-3-pro] 	for (const [code, locations] of codeMap) {
2025-11-27 14:23:04 [gemini-3-pro] 		if (locations.length > 1) {
2025-11-27 14:23:04 [gemini-3-pro] 			// locations[0] is the earliest occurrence
2025-11-27 14:23:04 [gemini-3-pro] 			const firstLoc = locations[0];
2025-11-27 14:23:04 [gemini-3-pro] 			indicesToRemove.add(firstLoc.order + ":" + firstLoc.index);
2025-11-27 14:23:04 [gemini-3-pro] 			// Optional: log removal
2025-11-27 14:23:04 [gemini-3-pro] 			// console.log("Removing earliest duplicate:", code, "from", firstLoc.order);
2025-11-27 14:23:04 [gemini-3-pro] 		}
2025-11-27 14:23:04 [gemini-3-pro] 	}
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 	// Pass 3: Rebuild arrays excluding the marked indices
2025-11-27 14:23:04 [gemini-3-pro] 	for (const orderName in taxonomyData.orders) {
2025-11-27 14:23:04 [gemini-3-pro] 		const originalCodes = taxonomyData.orders[orderName].codes;
2025-11-27 14:23:04 [gemini-3-pro] 		const cleanCodes = [];
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 		for (let i = 0; i < originalCodes.length; i++) {
2025-11-27 14:23:04 [gemini-3-pro] 			const key = orderName + ":" + i;
2025-11-27 14:23:04 [gemini-3-pro] 			if (!indicesToRemove.has(key)) {
2025-11-27 14:23:04 [gemini-3-pro] 				cleanCodes.push(originalCodes[i]);
2025-11-27 14:23:04 [gemini-3-pro] 			}
2025-11-27 14:23:04 [gemini-3-pro] 		}
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 		taxonomyData.orders[orderName].codes = cleanCodes;
2025-11-27 14:23:04 [gemini-3-pro] 	}
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 	return taxonomyData;
2025-11-27 14:23:04 [gemini-3-pro] }
2025-11-27 14:23:04 [gemini-3-pro] 
2025-11-27 14:23:04 [gemini-3-pro] 
