2025-11-28 12:20:32 [kimi-k2-0905]     dma_channel_config c = dma_channel_get_default_config(dma_chan);
2025-11-28 12:20:32 [kimi-k2-0905]     channel_config_set_transfer_data_size(&c, DMA_SIZE_32);
2025-11-28 12:20:32 [kimi-k2-0905]     channel_config_set_read_increment(&c, false);
2025-11-28 12:20:32 [kimi-k2-0905]     channel_config_set_write_increment(&c, true);
2025-11-28 12:20:32 [kimi-k2-0905]     channel_config_set_dreq(&c, pio_get_dreq(pio, sm, false));
2025-11-28 12:20:32 [kimi-k2-0905] 
