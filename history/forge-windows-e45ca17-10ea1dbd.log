2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] // Middleware for parsing JSON and raw "slop" (binary/text streams)
2025-12-02 17:02:00 [gemini-3-pro] app.use(express.json());
2025-12-02 17:02:00 [gemini-3-pro] app.use(express.raw({ type: 'application/octet-stream', limit: '10mb' }));
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] /**
2025-12-02 17:02:00 [gemini-3-pro]  * Returns the full registry of retro hardware definitions
2025-12-02 17:02:00 [gemini-3-pro]  */
2025-12-02 17:02:00 [gemini-3-pro] function handleGetRegistry(req, res) {
2025-12-02 17:02:00 [gemini-3-pro] 	res.status(200).json({
2025-12-02 17:02:00 [gemini-3-pro] 		host: "Vintage Kid Host",
2025-12-02 17:02:00 [gemini-3-pro] 		location: "Auckland, New Zealand",
2025-12-02 17:02:00 [gemini-3-pro] 		devices: devices
2025-12-02 17:02:00 [gemini-3-pro] 	});
2025-12-02 17:02:00 [gemini-3-pro] }
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] /**
2025-12-02 17:02:00 [gemini-3-pro]  * Handles incoming data stream from RP2040 devices
2025-12-02 17:02:00 [gemini-3-pro]  * Intended for debug logging or data capture from UART bridges
2025-12-02 17:02:00 [gemini-3-pro]  */
2025-12-02 17:02:00 [gemini-3-pro] function handleIncomingSlop(req, res) {
2025-12-02 17:02:00 [gemini-3-pro] 	const deviceId = req.params.device;
2025-12-02 17:02:00 [gemini-3-pro] 	const timestamp = new Date().toISOString();
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] 	if (!devices[deviceId]) {
2025-12-02 17:02:00 [gemini-3-pro] 		return res.status(404).json({ error: "Unknown Device ID" });
2025-12-02 17:02:00 [gemini-3-pro] 	}
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] 	// Log data receipt (Mocking buffer processing)
2025-12-02 17:02:00 [gemini-3-pro] 	const dataLength = req.body.length || 0;
2025-12-02 17:02:00 [gemini-3-pro] 	console.log(`[${timestamp}] <${devices[deviceId].name}> RX: ${dataLength} bytes`);
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] 	res.status(200).send({ status: "ACK", device: deviceId });
2025-12-02 17:02:00 [gemini-3-pro] }
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] /**
2025-12-02 17:02:00 [gemini-3-pro]  * Start the server
2025-12-02 17:02:00 [gemini-3-pro]  */
2025-12-02 17:02:00 [gemini-3-pro] function startServer() {
2025-12-02 17:02:00 [gemini-3-pro] 	// API Routes
2025-12-02 17:02:00 [gemini-3-pro] 	app.get('/api/registry', handleGetRegistry);
2025-12-02 17:02:00 [gemini-3-pro] 	app.post('/api/slop/:device', handleIncomingSlop);
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] 	// Root status
2025-12-02 17:02:00 [gemini-3-pro] 	app.get('/', (req, res) => {
2025-12-02 17:02:00 [gemini-3-pro] 		res.send(`<pre>
2025-12-02 17:02:00 [gemini-3-pro]    VINTAGE KID HOST ACTIVE
2025-12-02 17:02:00 [gemini-3-pro]    -----------------------
2025-12-02 17:02:00 [gemini-3-pro]    PORT: ${PORT}
2025-12-02 17:02:00 [gemini-3-pro]    DEVICES LOADED: ${Object.keys(devices).join(', ')}
2025-12-02 17:02:00 [gemini-3-pro]    LISTENING FOR SLOP...
2025-12-02 17:02:00 [gemini-3-pro] 		</pre>`);
2025-12-02 17:02:00 [gemini-3-pro] 	});
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] 	server.listen(PORT, () => {
2025-12-02 17:02:00 [gemini-3-pro] 		console.log(`\n> Project Hub online.`);
2025-12-02 17:02:00 [gemini-3-pro] 		console.log(`> Listening for slop on port ${PORT}`);
2025-12-02 17:02:00 [gemini-3-pro] 		console.log(`> Loaded definitions: [${Object.keys(devices).join(' ')}]`);
2025-12-02 17:02:00 [gemini-3-pro] 	});
2025-12-02 17:02:00 [gemini-3-pro] }
2025-12-02 17:02:00 [gemini-3-pro] 
2025-12-02 17:02:00 [gemini-3-pro] startServer();
