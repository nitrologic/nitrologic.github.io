2025-12-02 12:41:42 [gemini-3-pro] 
2025-12-02 12:41:42 [gemini-3-pro] 	// Traverse down common style containers
2025-12-02 12:41:42 [gemini-3-pro] 	const refs = getRefs(e.params);
2025-12-02 12:41:42 [gemini-3-pro] 	for (const refId of refs) {
2025-12-02 12:41:42 [gemini-3-pro] 		const col = resolveColor(refId, map, depth + 1);
2025-12-02 12:41:42 [gemini-3-pro] 		if (col) return col;
2025-12-02 12:41:42 [gemini-3-pro] 	}
2025-12-02 12:41:42 [gemini-3-pro] 	return null;
