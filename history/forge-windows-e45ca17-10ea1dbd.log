2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] function createGLTF(steps: { entities: any[] }) {
2025-12-02 12:03:22 [gemini-3-pro] 	const meta = kiCadMeta(steps.entities);
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	// Generate palette
2025-12-02 12:03:22 [gemini-3-pro] 	const materials = getCGAMaterials();
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	const points = steps.entities
2025-12-02 12:03:22 [gemini-3-pro] 		.filter(e => e.type === "CARTESIAN_POINT")
2025-12-02 12:03:22 [gemini-3-pro] 		.map(e => {
2025-12-02 12:03:22 [gemini-3-pro] 			const match = /\(([^)]+)\)/.exec(e.params);
2025-12-02 12:03:22 [gemini-3-pro] 			if (!match) return [0, 0, 0];
2025-12-02 12:03:22 [gemini-3-pro] 			return match[1].split(",").map(Number);
2025-12-02 12:03:22 [gemini-3-pro] 		});
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	const vertices = new Float32Array(points.flat());
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	const edges = steps.entities
2025-12-02 12:03:22 [gemini-3-pro] 		.filter(e => e.type === "ORIENTED_EDGE" || e.type === "EDGE_CURVE");
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	const indices: number[] = [];
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	edges.forEach(e => {
2025-12-02 12:03:22 [gemini-3-pro] 		const refs = e.params.match(/#\d+/g)?.map(r => parseInt(r.replace("#", "")) - 1);
2025-12-02 12:03:22 [gemini-3-pro] 		if (refs && refs.length >= 3) {
2025-12-02 12:03:22 [gemini-3-pro] 			indices.push(refs[0], refs[1], refs[2]);
2025-12-02 12:03:22 [gemini-3-pro] 		}
2025-12-02 12:03:22 [gemini-3-pro] 	});
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	const indexArray = new Uint16Array(indices);
2025-12-02 12:03:22 [gemini-3-pro] 	const base64 = encodeGLTFBuffer(vertices, indexArray);
2025-12-02 12:03:22 [gemini-3-pro] 
2025-12-02 12:03:22 [gemini-3-pro] 	const gltf = {
2025-12-02 12:03:22 [gemini-3-pro] 		asset: { version: "2.0" },
2025-12-02 12:03:22 [gemini-3-pro] 		scenes: [{ nodes: [0] }],
2025-12-02 12:03:22 [gemini-3-pro] 		nodes: [{ mesh: 0, extras: { meta } }],
2025-12-02 12:03:22 [gemini-3-pro] 		materials: materials,
2025-12-02 12:03:22 [gemini-3-pro] 		meshes: [{
2025-12-02 12:03:22 [gemini-3-pro] 			primitives: [{
2025-12-02 12:03:22 [gemini-3-pro] 				attributes: { POSITION: 0 },
2025-12-02 12:03:22 [gemini-3-pro] 				indices: 1,
2025-12-02 12:03:22 [gemini-3-pro] 				mode: 4, // 4 is TRIANGLES, 1 is LINES.
2025-12-02 12:03:22 [gemini-3-pro] 				material: 1 // Assigning Cyan (index 1) to everything for now
2025-12-02 12:03:22 [gemini-3-pro] 			}]
2025-12-02 12:03:22 [gemini-3-pro] 		}],
2025-12-02 12:03:22 [gemini-3-pro] 		accessors: [
2025-12-02 12:03:22 [gemini-3-pro] 			{ bufferView: 0, componentType: 5126, count: vertices.length / 3, type: "VEC3" },
2025-12-02 12:03:22 [gemini-3-pro] 			{ bufferView: 1, componentType: 5123, count: indexArray.length, type: "SCALAR" }
2025-12-02 12:03:22 [gemini-3-pro] 		],
2025-12-02 12:03:22 [gemini-3-pro] 		bufferViews: [
2025-12-02 12:03:22 [gemini-3-pro] 			{ buffer: 0, byteOffset: 0, byteLength: vertices.byteLength },
2025-12-02 12:03:22 [gemini-3-pro] 			{ buffer: 0, byteOffset: vertices.byteLength, byteLength: indexArray.byteLength }
2025-12-02 12:03:22 [gemini-3-pro] 		],
2025-12-02 12:03:22 [gemini-3-pro] 		buffers: [
2025-12-02 12:03:22 [gemini-3-pro] 			{
2025-12-02 12:03:22 [gemini-3-pro] 				byteLength: vertices.byteLength + indexArray.byteLength,
2025-12-02 12:03:22 [gemini-3-pro] 				uri: "data:application/octet-stream;base64," + btoa(base64)
2025-12-02 12:03:22 [gemini-3-pro] 			}
2025-12-02 12:03:22 [gemini-3-pro] 		]
2025-12-02 12:03:22 [gemini-3-pro] 	};
2025-12-02 12:03:22 [gemini-3-pro] 	return gltf;
2025-12-02 12:03:22 [gemini-3-pro] }
