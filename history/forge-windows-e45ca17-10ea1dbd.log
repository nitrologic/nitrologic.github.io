2025-12-03 12:02:58 [kimi-k2-0905] // blend.ts
2025-12-03 12:02:58 [kimi-k2-0905] export interface BlendHeader {
2025-12-03 12:02:58 [kimi-k2-0905] 	magic: string;
2025-12-03 12:02:58 [kimi-k2-0905] 	pointerSize: 4 | 8;
2025-12-03 12:02:58 [kimi-k2-0905] 	endian: "L" | "B";
2025-12-03 12:02:58 [kimi-k2-0905] 	version: string;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] export interface FileBlock {
2025-12-03 12:02:58 [kimi-k2-0905] 	code: string;
2025-12-03 12:02:58 [kimi-k2-0905] 	size: number;
2025-12-03 12:02:58 [kimi-k2-0905] 	oldAddr: bigint;
2025-12-03 12:02:58 [kimi-k2-0905] 	count: number;
2025-12-03 12:02:58 [kimi-k2-0905] 	sdNdx: number;
2025-12-03 12:02:58 [kimi-k2-0905] 	buffer: Uint8Array;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] export interface SDNA {
2025-12-03 12:02:58 [kimi-k2-0905] 	names: string[];
2025-12-03 12:02:58 [kimi-k2-0905] 	types: string[];
2025-12-03 12:02:58 [kimi-k2-0905] 	typeSizes: number[];
2025-12-03 12:02:58 [kimi-k2-0905] 	structs: { typeIndex: number; fields: { nameIndex: number; typeIndex: number }[] }[];
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] export class BlendFile {
2025-12-03 12:02:58 [kimi-k2-0905] 	private blocks: FileBlock[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	private sdna: SDNA = { names: [], types: [], typeSizes: [], structs: [] };
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	constructor(private view: DataView) {}
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	parse(): void {
2025-12-03 12:02:58 [kimi-k2-0905] 		const hdr = readHeader(this.view);
2025-12-03 12:02:58 [kimi-k2-0905] 		let off = 12;
2025-12-03 12:02:58 [kimi-k2-0905] 		while (off < this.view.byteLength) {
2025-12-03 12:02:58 [kimi-k2-0905] 			const b = readBlock(this.view, off, hdr.pointerSize);
2025-12-03 12:02:58 [kimi-k2-0905] 			this.blocks.push(b);
2025-12-03 12:02:58 [kimi-k2-0905] 			off += b.size + (hdr.pointerSize === 8 ? 24 : 16);
2025-12-03 12:02:58 [kimi-k2-0905] 			if (b.code === "DNA1") this.sdna = parseDNA(b.buffer);
2025-12-03 12:02:58 [kimi-k2-0905] 		}
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	getBlocks(code: string): FileBlock[] {
2025-12-03 12:02:58 [kimi-k2-0905] 		return this.blocks.filter(b => b.code === code);
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	getStruct(block: FileBlock, structName: string): Record<string, any> | null {
2025-12-03 12:02:58 [kimi-k2-0905] 		const typeIdx = this.sdna.types.indexOf(structName);
2025-12-03 12:02:58 [kimi-k2-0905] 		if (typeIdx < 0) return null;
2025-12-03 12:02:58 [kimi-k2-0905] 		return readStruct(block.buffer, this.sdna, typeIdx, 0);
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] function readHeader(view: DataView): BlendHeader {
2025-12-03 12:02:58 [kimi-k2-0905] 	const magic = ascii(view, 0, 7);
2025-12-03 12:02:58 [kimi-k2-0905] 	const pointerSize = view.getUint8(7) === 45 ? 8 : 4;
2025-12-03 12:02:58 [kimi-k2-0905] 	const endian = view.getUint8(8) === 118 ? "L" : "B";
2025-12-03 12:02:58 [kimi-k2-0905] 	const version = ascii(view, 9, 12);
2025-12-03 12:02:58 [kimi-k2-0905] 	return { magic, pointerSize, endian, version };
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] function readBlock(view: DataView, off: number, ptr: number): FileBlock {
2025-12-03 12:02:58 [kimi-k2-0905] 	const code = ascii(view, off, 4);
2025-12-03 12:02:58 [kimi-k2-0905] 	const size = view.getUint32(off + 4, true);
2025-12-03 12:02:58 [kimi-k2-0905] 	const oldAddr = ptr === 8 ? view.getBigUint64(off + 8, true) : BigInt(view.getUint32(off + 8, true));
2025-12-03 12:02:58 [kimi-k2-0905] 	const sdNdx = view.getUint32(off + (ptr === 8 ? 16 : 12), true);
2025-12-03 12:02:58 [kimi-k2-0905] 	const count = view.getUint32(off + (ptr === 8 ? 20 : 16), true);
2025-12-03 12:02:58 [kimi-k2-0905] 	const start = off + (ptr === 8 ? 24 : 20);
2025-12-03 12:02:58 [kimi-k2-0905] 	return { code, size, oldAddr, count, sdNdx, buffer: new Uint8Array(view.buffer, start, size) };
2025-12-03 12:02:58 [kimi-k2-0905] }
