2025-12-02 19:23:34 [gemini-3-pro] Here is a Node.js implementation using named functions and the specified port configuration.
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] const http = require('http');
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] const PORT = 8081;
2025-12-02 19:23:34 [gemini-3-pro] const TARGET_DEPTH_VAL = 1541;
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] function checkDepthConsistency(data) {
2025-12-02 19:23:34 [gemini-3-pro] 	try {
2025-12-02 19:23:34 [gemini-3-pro] 		const parsed = JSON.parse(data);
2025-12-02 19:23:34 [gemini-3-pro] 		// Example logic: checking if a specific property matches the 1541 requirement
2025-12-02 19:23:34 [gemini-3-pro] 		return parsed.depth === TARGET_DEPTH_VAL;
2025-12-02 19:23:34 [gemini-3-pro] 	} catch (e) {
2025-12-02 19:23:34 [gemini-3-pro] 		return false;
2025-12-02 19:23:34 [gemini-3-pro] 	}
2025-12-02 19:23:34 [gemini-3-pro] }
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] function handleIncomingData(req, res) {
2025-12-02 19:23:34 [gemini-3-pro] 	let body = [];
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] 	req.on('data', function(chunk) {
2025-12-02 19:23:34 [gemini-3-pro] 		body.push(chunk);
2025-12-02 19:23:34 [gemini-3-pro] 	});
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] 	req.on('end', function() {
2025-12-02 19:23:34 [gemini-3-pro] 		const buffer = Buffer.concat(body).toString();
2025-12-02 19:23:34 [gemini-3-pro] 		const isConsistent = checkDepthConsistency(buffer);
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] 		res.writeHead(isConsistent ? 200 : 400, { 'Content-Type': 'text/plain' });
2025-12-02 19:23:34 [gemini-3-pro] 		res.end(isConsistent ? 'Depth Consistent' : 'Depth Mismatch');
2025-12-02 19:23:34 [gemini-3-pro] 	});
2025-12-02 19:23:34 [gemini-3-pro] }
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] function startServer() {
2025-12-02 19:23:34 [gemini-3-pro] 	const server = http.createServer(handleIncomingData);
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] 	server.listen(PORT, function() {
2025-12-02 19:23:34 [gemini-3-pro] 		console.log(`Listening for slop on port ${PORT}`);
2025-12-02 19:23:34 [gemini-3-pro] 	});
2025-12-02 19:23:34 [gemini-3-pro] }
2025-12-02 19:23:34 [gemini-3-pro] 
2025-12-02 19:23:34 [gemini-3-pro] startServer();
2025-12-02 19:23:34 [gemini-3-pro] 
