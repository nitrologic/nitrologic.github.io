2025-11-05 10:12:20 [kimi-k2-0905] function discordWide(cp: number): boolean {
2025-11-05 10:12:20 [kimi-k2-0905] 	// East-Asian “W” / “F” width from Unicode 15.1
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x1100 && cp <= 0x115F) return true; // Hangul Jamo
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x2E80 && cp <= 0xA4CF) return true; // CJK … Yi
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0xAC00 && cp <= 0xD7AF) return true; // Hangul Syllables
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0xF900 && cp <= 0xFAFF) return true; // CJK Compat.
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0xFE10 && cp <= 0xFE1F) return true; // Vert. Forms
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0xFE30 && cp <= 0xFE6F) return true; // CJK Compat. Forms
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0xFF00 && cp <= 0xFF60) return true; // Full-width Latin
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0xFFE0 && cp <= 0xFFE6) return true; // Full-width symbols
2025-11-05 10:12:20 [kimi-k2-0905] 
2025-11-05 10:12:20 [kimi-k2-0905] 	// Emoji blocks that Discord treats as wide
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x1F300 && cp <= 0x1F5FF) return true; // Misc Pictographs
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x1F600 && cp <= 0x1F64F) return true; // Emoticons
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x1F680 && cp <= 0x1F6FF) return true; // Transport & Map
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x1F900 && cp <= 0x1F9FF) return true; // Supplemental
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp >= 0x1FA00 && cp <= 0x1FAFF) return true; // Symbols & Pictographs Ext-A
2025-11-05 10:12:20 [kimi-k2-0905] 
2025-11-05 10:12:20 [kimi-k2-0905] 	// Discord still wants these legacy single-codepoints to be wide
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp === 0x26F2) return true; // ⛲
2025-11-05 10:12:20 [kimi-k2-0905] 	if (cp === 0x26C5) return true; // ⛅
2025-11-05 10:12:20 [kimi-k2-0905] 
2025-11-05 10:12:20 [kimi-k2-0905] 	return false;
2025-11-05 10:12:20 [kimi-k2-0905] }
