2025-12-03 12:02:58 [kimi-k2-0905] function readStruct(buf: Uint8Array, sdna: SDNA, typeIdx: number, baseOff: number): Record<string, any> {
2025-12-03 12:02:58 [kimi-k2-0905] 	const struct = sdna.structs.find(s => s.typeIndex === typeIdx)!;
2025-12-03 12:02:58 [kimi-k2-0905] 	const view = new DataView(buf.buffer, buf.byteOffset);
2025-12-03 12:02:58 [kimi-k2-0905] 	const out: Record<string, any> = {};
2025-12-03 12:02:58 [kimi-k2-0905] 	let off = baseOff;
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	for (const f of struct.fields) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const name = sdna.names[f.nameIndex];
2025-12-03 12:02:58 [kimi-k2-0905] 		const type = sdna.types[f.typeIndex];
2025-12-03 12:02:58 [kimi-k2-0905] 		const size = sdna.typeSizes[f.typeIndex];
2025-12-03 12:02:58 [kimi-k2-0905] 		if (name.endsWith("*")) {
2025-12-03 12:02:58 [kimi-k2-0905] 			out[name] = view.getUint32(off, true); // store pointer as number
2025-12-03 12:02:58 [kimi-k2-0905] 		} else if (type === "int") {
2025-12-03 12:02:58 [kimi-k2-0905] 			out[name] = view.getInt32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		} else if (type === "float") {
2025-12-03 12:02:58 [kimi-k2-0905] 			out[name] = view.getFloat32(off, true);
2025-12-03 12:02:58 [kimi-k2-0905] 		} else {
2025-12-03 12:02:58 [kimi-k2-0905] 			out[name] = null; // skip unknown
2025-12-03 12:02:58 [kimi-k2-0905] 		}
2025-12-03 12:02:58 [kimi-k2-0905] 		off += size;
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	return out;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] function ascii(view: DataView, off: number, len: number): string {
2025-12-03 12:02:58 [kimi-k2-0905] 	return String.fromCharCode(...new Uint8Array(view.buffer, view.byteOffset + off, len));
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] function cstr(view: DataView, off: number): string {
2025-12-03 12:02:58 [kimi-k2-0905] 	let s = "";
2025-12-03 12:02:58 [kimi-k2-0905] 	let i = 0;
2025-12-03 12:02:58 [kimi-k2-0905] 	while (view.getUint8(off + i) !== 0) s += String.fromCharCode(view.getUint8(off + i++));
2025-12-03 12:02:58 [kimi-k2-0905] 	return s;
2025-12-03 12:02:58 [kimi-k2-0905] }
2025-12-03 12:02:58 [kimi-k2-0905] function align4(n: number): number { return (n + 3) & ~3; }
