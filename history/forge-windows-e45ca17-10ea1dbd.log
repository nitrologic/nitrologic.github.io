2025-12-03 12:02:58 [kimi-k2-0905] function parseDNA(buf: Uint8Array): SDNA {
2025-12-03 12:02:58 [kimi-k2-0905] 	const v = new DataView(buf.buffer, buf.byteOffset);
2025-12-03 12:02:58 [kimi-k2-0905] 	let off = 8; // skip "DNA1" + 4-byte padding
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	const nameCount = v.getUint32(off, true); off += 4;
2025-12-03 12:02:58 [kimi-k2-0905] 	const names: string[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	for (let i = 0; i < nameCount; i++) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const s = cstr(v, off);
2025-12-03 12:02:58 [kimi-k2-0905] 		names.push(s);
2025-12-03 12:02:58 [kimi-k2-0905] 		off += s.length + 1;
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	align4(off); off = align4(off);
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	const typeCount = v.getUint32(off, true); off += 4;
2025-12-03 12:02:58 [kimi-k2-0905] 	const types: string[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	for (let i = 0; i < typeCount; i++) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const s = cstr(v, off);
2025-12-03 12:02:58 [kimi-k2-0905] 		types.push(s);
2025-12-03 12:02:58 [kimi-k2-0905] 		off += s.length + 1;
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	align4(off); off = align4(off);
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	const typeSizes: number[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	for (let i = 0; i < typeCount; i++) {
2025-12-03 12:02:58 [kimi-k2-0905] 		typeSizes.push(v.getUint32(off, true)); off += 4;
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 
2025-12-03 12:02:58 [kimi-k2-0905] 	const structCount = v.getUint32(off, true); off += 4;
2025-12-03 12:02:58 [kimi-k2-0905] 	const structs: SDNA["structs"] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 	for (let i = 0; i < structCount; i++) {
2025-12-03 12:02:58 [kimi-k2-0905] 		const typeIndex = v.getUint16(off, true); off += 2;
2025-12-03 12:02:58 [kimi-k2-0905] 		const fieldCount = v.getUint16(off, true); off += 2;
2025-12-03 12:02:58 [kimi-k2-0905] 		const fields: { nameIndex: number; typeIndex: number }[] = [];
2025-12-03 12:02:58 [kimi-k2-0905] 		for (let j = 0; j < fieldCount; j++) {
2025-12-03 12:02:58 [kimi-k2-0905] 			fields.push({ typeIndex: v.getUint16(off, true), nameIndex: v.getUint16(off + 2, true) });
2025-12-03 12:02:58 [kimi-k2-0905] 			off += 4;
2025-12-03 12:02:58 [kimi-k2-0905] 		}
2025-12-03 12:02:58 [kimi-k2-0905] 		structs.push({ typeIndex, fields });
2025-12-03 12:02:58 [kimi-k2-0905] 	}
2025-12-03 12:02:58 [kimi-k2-0905] 	return { names, types, typeSizes, structs };
2025-12-03 12:02:58 [kimi-k2-0905] }
