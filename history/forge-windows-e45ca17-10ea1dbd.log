2025-11-27 06:45:43 [kimi-k2-0905] 
2025-11-27 06:45:43 [kimi-k2-0905] import { serve } from "https://deno.land/std/http/server.ts";
2025-11-27 06:45:43 [kimi-k2-0905] 
2025-11-27 06:45:43 [kimi-k2-0905] function mustAuth(req: Request): string {
2025-11-27 06:45:43 [kimi-k2-0905] 	const u = req.headers.get("x-user");
2025-11-27 06:45:43 [kimi-k2-0905] 	if (!u) throw new Error("Unauthorized");
2025-11-27 06:45:43 [kimi-k2-0905] 	return u;
2025-11-27 06:45:43 [kimi-k2-0905] }
2025-11-27 06:45:43 [kimi-k2-0905] 
2025-11-27 06:45:43 [kimi-k2-0905] serve((req) => {
2025-11-27 06:45:43 [kimi-k2-0905] 	try {
2025-11-27 06:45:43 [kimi-k2-0905] 		return new Response(`hello ${mustAuth(req)} from Deno\n`);
2025-11-27 06:45:43 [kimi-k2-0905] 	} catch {
