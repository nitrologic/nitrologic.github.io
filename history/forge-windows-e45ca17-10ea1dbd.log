2025-11-15 12:57:26 [deepseek-chat]         const item = {..._item};
2025-11-15 12:57:26 [deepseek-chat]         const src = "[" + itemSource(item) + "] ";
2025-11-15 12:57:26 [deepseek-chat]         const content = src + item.content;
2025-11-15 12:57:26 [deepseek-chat] 
2025-11-15 12:57:26 [deepseek-chat]         switch (item.role) {
2025-11-15 12:57:26 [deepseek-chat]             case "system":
2025-11-15 12:57:26 [deepseek-chat]                 list.push({role: "system", content});
2025-11-15 12:57:26 [deepseek-chat]                 break;
2025-11-15 12:57:26 [deepseek-chat]             case "assistant":
2025-11-15 12:57:26 [deepseek-chat]                 if (item.tool_calls) {
2025-11-15 12:57:26 [deepseek-chat]                     list.push({role: item.role, content, tool_calls: item.tool_calls});
2025-11-15 12:57:26 [deepseek-chat]                 } else {
2025-11-15 12:57:26 [deepseek-chat]                     list.push({role: "assistant", content});
2025-11-15 12:57:26 [deepseek-chat]                 }
2025-11-15 12:57:26 [deepseek-chat]                 break;
2025-11-15 12:57:26 [deepseek-chat]             case "user":
2025-11-15 12:57:26 [deepseek-chat]                 list.push({role: item.role, content});
2025-11-15 12:57:26 [deepseek-chat]                 break;
2025-11-15 12:57:26 [deepseek-chat]             case "tool":  // ← This case expects tool entries to exist!
2025-11-15 12:57:26 [deepseek-chat]                 list.push({...item});
2025-11-15 12:57:26 [deepseek-chat]                 break;
2025-11-15 12:57:26 [deepseek-chat]         }
2025-11-15 12:57:26 [deepseek-chat]     }
2025-11-15 12:57:26 [deepseek-chat]     return list;
2025-11-15 12:57:26 [deepseek-chat] }
