2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] Here is the logic to isolate those redundant codes and the resulting JSON array of codes that can
2025-11-27 14:21:22 [gemini-3-pro] be safely deleted.
2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] function findInternalDuplicates(data) {
2025-11-27 14:21:22 [gemini-3-pro] 	const redundantCodes = [];
2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] 	Object.keys(data.orders).forEach(orderName => {
2025-11-27 14:21:22 [gemini-3-pro] 		const codes = data.orders[orderName].codes;
2025-11-27 14:21:22 [gemini-3-pro] 		const seen = new Set();
2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] 		codes.forEach(code => {
2025-11-27 14:21:22 [gemini-3-pro] 			if (seen.has(code)) {
2025-11-27 14:21:22 [gemini-3-pro] 				redundantCodes.push(code);
2025-11-27 14:21:22 [gemini-3-pro] 			} else {
2025-11-27 14:21:22 [gemini-3-pro] 				seen.add(code);
2025-11-27 14:21:22 [gemini-3-pro] 			}
2025-11-27 14:21:22 [gemini-3-pro] 		});
2025-11-27 14:21:22 [gemini-3-pro] 	});
2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] 	// Return unique list of codes that were found to be redundant
2025-11-27 14:21:22 [gemini-3-pro] 	return [...new Set(redundantCodes)];
2025-11-27 14:21:22 [gemini-3-pro] }
2025-11-27 14:21:22 [gemini-3-pro] 
2025-11-27 14:21:22 [gemini-3-pro] 
