2025-12-02 12:41:42 [gemini-3-pro] // Helper: Recursive generic lookup for RGB color
2025-12-02 12:41:42 [gemini-3-pro] function resolveColor(id: number, map: Map<number, any>, depth: number = 0): number[] | null {
2025-12-02 12:41:42 [gemini-3-pro] 	if (depth > 10) return null; // Prevent cycles
2025-12-02 12:41:42 [gemini-3-pro] 	const e = map.get(id);
