2025-12-02 12:03:22 [gemini-3-pro] 			pbrMetallicRoughness: { baseColorFactor: [0.0, 0.0, 0.0, 1.0] },
2025-12-02 12:03:22 [gemini-3-pro] 			doubleSided: true
2025-12-02 12:03:22 [gemini-3-pro] 		},
2025-12-02 12:03:22 [gemini-3-pro] 		{
2025-12-02 12:03:22 [gemini-3-pro] 			name: "Cyan",
2025-12-02 12:03:22 [gemini-3-pro] 			pbrMetallicRoughness: { baseColorFactor: [0.0, 1.0, 1.0, 1.0] },
2025-12-02 12:03:22 [gemini-3-pro] 			doubleSided: true
2025-12-02 12:03:22 [gemini-3-pro] 		},
2025-12-02 12:03:22 [gemini-3-pro] 		{
2025-12-02 12:03:22 [gemini-3-pro] 			name: "Magenta",
2025-12-02 12:03:22 [gemini-3-pro] 			pbrMetallicRoughness: { baseColorFactor: [1.0, 0.0, 1.0, 1.0] },
2025-12-02 12:03:22 [gemini-3-pro] 			doubleSided: true
