2025-11-27 14:14:11 [claude-haiku-4-5] function findDuplicateCodes(orders) {
2025-11-27 14:14:11 [claude-haiku-4-5] 	const duplicates = {};
2025-11-27 14:14:11 [claude-haiku-4-5] 
2025-11-27 14:14:11 [claude-haiku-4-5] 	Object.entries(orders).forEach(([orderName, order]) => {
2025-11-27 14:14:11 [claude-haiku-4-5] 		if (Array.isArray(order.codes)) {
2025-11-27 14:14:11 [claude-haiku-4-5] 			const seen = new Set();
2025-11-27 14:14:11 [claude-haiku-4-5] 			const dups = [];
2025-11-27 14:14:11 [claude-haiku-4-5] 
2025-11-27 14:14:11 [claude-haiku-4-5] 			order.codes.forEach(code => {
2025-11-27 14:14:11 [claude-haiku-4-5] 				if (seen.has(code)) {
2025-11-27 14:14:11 [claude-haiku-4-5] 					dups.push(code);
2025-11-27 14:14:11 [claude-haiku-4-5] 				}
2025-11-27 14:14:11 [claude-haiku-4-5] 				seen.add(code);
2025-11-27 14:14:11 [claude-haiku-4-5] 			});
2025-11-27 14:14:11 [claude-haiku-4-5] 
2025-11-27 14:14:11 [claude-haiku-4-5] 			if (dups.length > 0) {
2025-11-27 14:14:11 [claude-haiku-4-5] 				duplicates[orderName] = dups;
2025-11-27 14:14:11 [claude-haiku-4-5] 			}
2025-11-27 14:14:11 [claude-haiku-4-5] 		}
2025-11-27 14:14:11 [claude-haiku-4-5] 	});
2025-11-27 14:14:11 [claude-haiku-4-5] 
2025-11-27 14:14:11 [claude-haiku-4-5] 	return duplicates;
2025-11-27 14:14:11 [claude-haiku-4-5] }
2025-11-27 14:14:11 [claude-haiku-4-5] 
2025-11-27 14:14:11 [claude-haiku-4-5] 
2025-11-27 14:14:11 [claude-haiku-4-5] Usage:
2025-11-27 14:14:11 [claude-haiku-4-5] 
