2025-11-04 12:58:20 [kimi-k2-0905] 
2025-11-04 12:58:20 [kimi-k2-0905] 
2025-11-04 12:58:20 [kimi-k2-0905] const stamp = slopmark();
2025-11-04 12:58:20 [kimi-k2-0905] const portUser = "⚠️FAIL";
2025-11-04 12:58:20 [kimi-k2-0905] const detail = `[${stamp} ${rohaModel} ${rohaUser}] ${error}`;
2025-11-04 12:58:20 [kimi-k2-0905] const line   = "!"+detail;          // keep the leading bang for log parsers
2025-11-04 12:58:20 [kimi-k2-0905] send.push(line);
2025-11-04 12:58:20 [kimi-k2-0905] rohaPush(detail, portUser);
2025-11-04 12:58:20 [kimi-k2-0905] await logForge(detail, portUser);
2025-11-04 12:58:20 [kimi-k2-0905] 
2025-11-04 12:58:20 [kimi-k2-0905] 
2025-11-04 12:58:20 [kimi-k2-0905] History entry becomes:
2025-11-04 12:58:20 [kimi-k2-0905] 
2025-11-04 12:58:20 [kimi-k2-0905] 
2025-11-04 12:58:20 [kimi-k2-0905] role:"user", name:"⚠️FAIL", content:"[2c9b7ca gpt-5-nano simon@nitrologic] Socket hang up"
