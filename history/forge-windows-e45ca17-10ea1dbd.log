2025-11-27 06:45:42 [kimi-k2-0905]       - --cookie-domain=.demo.local
2025-11-27 06:45:42 [kimi-k2-0905]       - --redis-connection-url=redis://redis:6379
2025-11-27 06:45:42 [kimi-k2-0905]       - --session-store-type=redis
