2025-11-04 10:11:21 [kimi-k2-0905] 
2025-11-04 10:11:21 [kimi-k2-0905] utf8 maskIPv6(const utf8 &ip) {
2025-11-04 10:11:21 [kimi-k2-0905]     size_t pos = ip.rfind(":");
2025-11-04 10:11:21 [kimi-k2-0905]     if (pos != std::string::npos && pos + 1 < ip.size()) {
2025-11-04 10:11:21 [kimi-k2-0905]         return ip.substr(0, pos + 1) + "****";
2025-11-04 10:11:21 [kimi-k2-0905]     }
2025-11-04 10:11:21 [kimi-k2-0905]     return ip;
2025-11-04 10:11:21 [kimi-k2-0905] }
