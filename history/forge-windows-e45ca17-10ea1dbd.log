2025-12-02 13:03:05 [claude-opus-4-5] function logStyles(entities: any[]) {
2025-12-02 13:03:05 [claude-opus-4-5] 	const colors = parseColors(entities);
2025-12-02 13:03:05 [claude-opus-4-5] 	const entityMap = new Map<number, any>();
2025-12-02 13:03:06 [claude-opus-4-5] 	entities.forEach(e => entityMap.set(e.id, e));
2025-12-02 13:03:06 [claude-opus-4-5] 
2025-12-02 13:03:06 [claude-opus-4-5] 	function resolveColorId(id: number, depth = 0): number | null {
2025-12-02 13:03:06 [claude-opus-4-5] 		if (depth > 12 || !entityMap.has(id)) return null;
2025-12-02 13:03:06 [claude-opus-4-5] 		if (colors.has(id)) return id;
2025-12-02 13:03:06 [claude-opus-4-5] 		const refs = entityMap.get(id).params.match(/#\d+/g) || [];
2025-12-02 13:03:06 [claude-opus-4-5] 		for (const ref of refs) {
2025-12-02 13:03:06 [claude-opus-4-5] 			const found = resolveColorId(parseInt(ref.slice(1), 10), depth + 1);
2025-12-02 13:03:06 [claude-opus-4-5] 			if (found) return found;
2025-12-02 13:03:06 [claude-opus-4-5] 		}
2025-12-02 13:03:06 [claude-opus-4-5] 		return null;
2025-12-02 13:03:06 [claude-opus-4-5] 	}
2025-12-02 13:03:06 [claude-opus-4-5] 
2025-12-02 13:03:06 [claude-opus-4-5] 	entities
2025-12-02 13:03:06 [claude-opus-4-5] 		.filter(e => e.type === "STYLED_ITEM")
2025-12-02 13:03:06 [claude-opus-4-5] 		.forEach(item => {
2025-12-02 13:03:06 [claude-opus-4-5] 			const refs = item.params.match(/#\d+/g) || [];
2025-12-02 13:03:06 [claude-opus-4-5] 			const styleRef = parseInt(refs[0].slice(1), 10);
2025-12-02 13:03:06 [claude-opus-4-5] 			const targetId = refs[1];
2025-12-02 13:03:06 [claude-opus-4-5] 			const colorId = resolveColorId(styleRef);
2025-12-02 13:03:06 [claude-opus-4-5] 			const rgb = colorId ? colors.get(colorId) : null;
2025-12-02 13:03:06 [claude-opus-4-5] 			const rgbStr = rgb ? rgb.map(n => n.toFixed(3)).join(", ") : "none";
2025-12-02 13:03:06 [claude-opus-4-5] 			console.log(`RGB(${rgbStr}) -> ${targetId}`);
2025-12-02 13:03:06 [claude-opus-4-5] 		});
2025-12-02 13:03:06 [claude-opus-4-5] }
