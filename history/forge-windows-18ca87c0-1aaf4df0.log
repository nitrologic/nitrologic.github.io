2026-03-31 20:01:32 [gemini-3.1-pro] 
2026-03-31 20:01:32 [gemini-3.1-pro] 	; blanking = 12.28 µs = 1,824 cycles (including 3 from line setup)
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	pindirs, 0
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	pins, 0
2026-03-31 20:01:32 [gemini-3.1-pro] 
2026-03-31 20:01:32 [gemini-3.1-pro] 	; front porch = ~1.64 µs = 243 cycles (8 * 30 + 3 setup)
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	y, 7
2026-03-31 20:01:32 [gemini-3.1-pro] frontporch:
2026-03-31 20:01:32 [gemini-3.1-pro] 	jmp	y--,frontporch [29]
2026-03-31 20:01:32 [gemini-3.1-pro] 
2026-03-31 20:01:32 [gemini-3.1-pro] 	; hsync = ~4.66 µs = 692 cycles (23 * 30 + 2 setup)
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	pindirs, 1
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	y, 22
2026-03-31 20:01:32 [gemini-3.1-pro] hsync:
2026-03-31 20:01:32 [gemini-3.1-pro] 	jmp	y--,hsync [29]
2026-03-31 20:01:32 [gemini-3.1-pro] 
2026-03-31 20:01:32 [gemini-3.1-pro] 	; back porch = ~5.87 µs = 872 cycles (29 * 30 + 2 setup)
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	pindirs, 0
2026-03-31 20:01:32 [gemini-3.1-pro] 	set	y, 28
