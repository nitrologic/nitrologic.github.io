2026-03-30 09:02:20 [deepseek-chat] 
2026-03-30 09:02:20 [deepseek-chat] // 4. Configure DMA
2026-03-30 09:02:20 [deepseek-chat] dma_channel_configure(
2026-03-30 09:02:20 [deepseek-chat]     dma_chan,
2026-03-30 09:02:20 [deepseek-chat]     &c,
2026-03-30 09:02:20 [deepseek-chat]     &pio->txf[sm], // PIO TX FIFO address
2026-03-30 09:02:20 [deepseek-chat]     data_buffer,
2026-03-30 09:02:20 [deepseek-chat]     BUFFER_SIZE,
