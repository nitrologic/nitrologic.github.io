2026-08-18 20:05:00 [gemini-3.7-flash] 🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.007 20.89KB 3.28s
2026-08-18 20:05:00 [gemini-3.7-flash] On the Commodore PET, the 6520 PIA 1 handles keyboard scanning via two registers at address
2026-08-18 20:05:00 [gemini-3.7-flash] range `E810`–`E813`:
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 1. Row Selection (Output)
2026-08-18 20:05:00 [gemini-3.7-flash] • Address: `$E810` (PIA 1 Port A — `PRA`)
2026-08-18 20:05:00 [gemini-3.7-flash] • Bits: Bits 0–3 (`PA0`–`PA3`)
2026-08-18 20:05:00 [gemini-3.7-flash] • Function: These 4 bits are connected to a 74145 BCD-to-Decimal Decoder, which
2026-08-18 20:05:00 [gemini-3.7-flash] pulls one of the 10 matrix rows (0–9) LOW (`0`).
2026-08-18 20:05:00 [gemini-3.7-flash] • Value: Values `0x0` through `0x9` select Row 0 through Row 9. Values `0xA`–`0xF` deselect
2026-08-18 20:05:00 [gemini-3.7-flash] all rows.
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 2. Column Selection / Input (Read)
2026-08-18 20:05:00 [gemini-3.7-flash] • Address: `$E812` (PIA 1 Port B — `PRB`)
2026-08-18 20:05:00 [gemini-3.7-flash] • Bits: Bits 0–7 (`PB0`–`PB7`)
2026-08-18 20:05:00 [gemini-3.7-flash] • Function: The matrix columns are connected directly to Port B inputs with pull-up
2026-08-18 20:05:00 [gemini-3.7-flash] resistors.
2026-08-18 20:05:00 [gemini-3.7-flash] • Logic:
2026-08-18 20:05:00 [gemini-3.7-flash]   * `1` = Key is open / released
2026-08-18 20:05:00 [gemini-3.7-flash]   * `0` = Key is pressed (pulls line to ground)
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] Emulator Register Mapping Example
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] // Memory addresses
2026-08-18 20:05:00 [gemini-3.7-flash] const PET_PIA1_PRA: number = 0xE810; // Row select (PA0..PA3)
2026-08-18 20:05:00 [gemini-3.7-flash] const PET_PIA1_PRB: number = 0xE812; // Column data read (PB0..PB7)
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] let pia1PortA: number = 0x00;
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] export function writePetMemory(address: number, value: number): void {
2026-08-18 20:05:00 [gemini-3.7-flash] 	if (address === PET_PIA1_PRA) {
2026-08-18 20:05:00 [gemini-3.7-flash] 		// Bits 0..3 drive the 74145 decoder (Row 0-9)
2026-08-18 20:05:00 [gemini-3.7-flash] 		pia1PortA = value & 0x0F;
2026-08-18 20:05:00 [gemini-3.7-flash] 	}
2026-08-18 20:05:00 [gemini-3.7-flash] }
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] export function readPetMemory(address: number): number {
2026-08-18 20:05:00 [gemini-3.7-flash] 	if (address === PET_PIA1_PRB) {
2026-08-18 20:05:00 [gemini-3.7-flash] 		// Returns 8-bit columns (PB0..PB7) for current row (0-9)
2026-08-18 20:05:00 [gemini-3.7-flash] 		return readPetKeyboardMatrix(pia1PortA);
2026-08-18 20:05:00 [gemini-3.7-flash] 	}
2026-08-18 20:05:00 [gemini-3.7-flash] 	return 0xFF;
2026-08-18 20:05:00 [gemini-3.7-flash] }
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] function readPetKeyboardMatrix(rowIndex: number): number {
2026-08-18 20:05:00 [gemini-3.7-flash] 	if (rowIndex > 9) {
2026-08-18 20:05:00 [gemini-3.7-flash] 		return 0xFF; // Decoder disabled for inputs 10-15
2026-08-18 20:05:00 [gemini-3.7-flash] 	}
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 	let columns: number = 0xFF;
2026-08-18 20:05:00 [gemini-3.7-flash] 	const rowOffset: number = rowIndex * 8;
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 	for (let column: number = 0; column < 8; column = column + 1) {
2026-08-18 20:05:00 [gemini-3.7-flash] 		const keyCode: number = PetKeycodes[rowOffset + column];
2026-08-18 20:05:00 [gemini-3.7-flash] 		if (isMacVirtualKeyPressed(keyCode)) {
2026-08-18 20:05:00 [gemini-3.7-flash] 			// Column line goes LOW when pressed
2026-08-18 20:05:00 [gemini-3.7-flash] 			columns = columns & ~(1 << column);
2026-08-18 20:05:00 [gemini-3.7-flash] 		}
2026-08-18 20:05:00 [gemini-3.7-flash] 	}
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 	return columns;
2026-08-18 20:05:00 [gemini-3.7-flash] }
2026-08-18 20:05:00 [gemini-3.7-flash] 
2026-08-18 20:05:00 [gemini-3.7-flash] 
