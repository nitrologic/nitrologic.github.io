2026-08-18 19:39:43 [gemini-3.7-flash] 		}
2026-08-18 19:39:43 [gemini-3.7-flash] 	}
2026-08-18 19:39:43 [gemini-3.7-flash] 
2026-08-18 19:39:43 [gemini-3.7-flash] 	return bits;
