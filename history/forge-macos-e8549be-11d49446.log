2025-11-27 21:02:36 [grok-4-1] 			if (n === null) break; // EOF
2025-11-27 21:02:36 [grok-4-1] 
2025-11-27 21:02:36 [grok-4-1] 			const text = decoder.decode(buffer.subarray(0, n));
2025-11-27 21:02:36 [grok-4-1] 			const lines = text.split('\n');
2025-11-27 21:02:36 [grok-4-1] 
2025-11-27 21:02:36 [grok-4-1] 			for (const line of lines) {
2025-11-27 21:02:36 [grok-4-1] 				const trimmed = line.trim();
2025-11-27 21:02:36 [grok-4-1] 				if (trimmed === 'exit') {
2025-11-27 21:02:36 [grok-4-1] 					await session.print('SloppyPipe Closed\r\n');
2025-11-27 21:02:36 [grok-4-1] 					delete connections[rid];
2025-11-27 21:02:36 [grok-4-1] 					connection.close();
2025-11-27 21:02:36 [grok-4-1] 					return;
2025-11-27 21:02:36 [grok-4-1] 				}
2025-11-27 21:02:36 [grok-4-1] 				if (trimmed.length) {
2025-11-27 21:02:36 [grok-4-1] 					const blob = {messages: [{message: trimmed, from: `pipe:${rid}`}]};
2025-11-27 21:02:36 [grok-4-1] 					await writeFountain(JSON.stringify(blob) + '\n');
2025-11-27 21:02:36 [grok-4-1] 				}
2025-11-27 21:02:36 [grok-4-1] 			}
2025-11-27 21:02:36 [grok-4-1] 		}
2025-11-27 21:02:36 [grok-4-1] 	} catch (err) {
2025-11-27 21:02:36 [grok-4-1] 		console.error('Stream error:', err);
2025-11-27 21:02:36 [grok-4-1] 	} finally {
2025-11-27 21:02:36 [grok-4-1] 		delete connections[rid];
2025-11-27 21:02:36 [grok-4-1] 		connection.close();
2025-11-27 21:02:36 [grok-4-1] 	}
2025-11-27 21:02:36 [grok-4-1] }
