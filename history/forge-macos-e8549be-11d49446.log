2025-11-18 16:16:09 [gpt-5.1-2025] 
2025-11-18 16:16:09 [gpt-5.1-2025] int main() {
2025-11-18 16:16:09 [gpt-5.1-2025] 	std::cout << "v8io - 0.0 " << std::endl;
2025-11-18 16:16:09 [gpt-5.1-2025] 
2025-11-18 16:16:09 [gpt-5.1-2025] 	// Option 1: string from helper
2025-11-18 16:16:09 [gpt-5.1-2025] 	std::cout << "V8::GetVersion(): " << v8::V8::GetVersion() << std::endl;
2025-11-18 16:16:09 [gpt-5.1-2025] 
2025-11-18 16:16:09 [gpt-5.1-2025] 	// Option 2: numeric components from macros (v8-version.h)
2025-11-18 16:16:09 [gpt-5.1-2025] 	std::cout << "V8 numeric version: "
2025-11-18 16:16:09 [gpt-5.1-2025] 	          << V8_MAJOR_VERSION << "."
