2025-11-26 15:53:06 [grok-4-1] int main() {
2025-11-26 15:53:06 [grok-4-1]     int sock = socket(AF_UNIX, SOCK_STREAM, 0);
2025-11-26 15:53:06 [grok-4-1]     sockaddr_un addr = {};
2025-11-26 15:53:06 [grok-4-1]     addr.sun_family = AF_UNIX;
2025-11-26 15:53:06 [grok-4-1]     strcpy(addr.sun_path, "/tmp/slop.sock");
2025-11-26 15:53:06 [grok-4-1]     unlink("/tmp/slop.sock");
2025-11-26 15:53:06 [grok-4-1]     bind(sock, (sockaddr*)&addr, sizeof(addr));
2025-11-26 15:53:06 [grok-4-1]     listen(sock, 1);
2025-11-26 15:53:06 [grok-4-1] 
2025-11-26 15:53:06 [grok-4-1]     int client = accept(sock, 0, 0);
2025-11-26 15:53:06 [grok-4-1]     char buf[1024];
2025-11-26 15:53:06 [grok-4-1]     read(client, buf, sizeof(buf));
2025-11-26 15:53:06 [grok-4-1]     printf("Received: %s\n", buf);
2025-11-26 15:53:06 [grok-4-1] 
2025-11-26 15:53:06 [grok-4-1]     close(client);
2025-11-26 15:53:06 [grok-4-1]     close(sock);
2025-11-26 15:53:06 [grok-4-1]     return 0;
2025-11-26 15:53:06 [grok-4-1] }
