2025-11-27 18:13:22 [grok-4-1] The error is because `conn.r` isn't an async iterable. Unix socket connections in Deno return
2025-11-27 18:13:22 [grok-4-1] `Deno.Conn` which needs explicit `read()` calls. Here's the fixed `readStream`:
2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] async function readStream(conn, rid) {
2025-11-27 18:13:22 [grok-4-1] 	const decoder = new TextDecoder();
2025-11-27 18:13:22 [grok-4-1] 	const session = connections[rid];
2025-11-27 18:13:22 [grok-4-1] 	const buffer = new Uint8Array(1024);
2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] 	try {
2025-11-27 18:13:22 [grok-4-1] 		while (true) {
2025-11-27 18:13:22 [grok-4-1] 			const n = await conn.read(buffer);
2025-11-27 18:13:22 [grok-4-1] 			if (n === null) break; // EOF
2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] 			const text = decoder.decode(buffer.subarray(0, n));
2025-11-27 18:13:22 [grok-4-1] 			const lines = text.split('\n');
2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] 			for (const line of lines) {
2025-11-27 18:13:22 [grok-4-1] 				const trimmed = line.trim();
2025-11-27 18:13:22 [grok-4-1] 				if (trimmed === 'exit') {
2025-11-27 18:13:22 [grok-4-1] 					await session.print('Goodbye!\r\n');
2025-11-27 18:13:22 [grok-4-1] 					delete connections[rid];
2025-11-27 18:13:22 [grok-4-1] 					return;
2025-11-27 18:13:22 [grok-4-1] 				}
2025-11-27 18:13:22 [grok-4-1] 				if (trimmed.length) {
2025-11-27 18:13:22 [grok-4-1] 					const blob = {messages: [{message: trimmed, from: 'pipe:' + rid}]};
2025-11-27 18:13:22 [grok-4-1] 					await writeFountain(JSON.stringify(blob) + '\n');
2025-11-27 18:13:22 [grok-4-1] 				}
2025-11-27 18:13:22 [grok-4-1] 			}
2025-11-27 18:13:22 [grok-4-1] 		}
2025-11-27 18:13:22 [grok-4-1] 	} catch (err) {
2025-11-27 18:13:22 [grok-4-1] 		console.error('Stream error:', err);
2025-11-27 18:13:22 [grok-4-1] 	} finally {
2025-11-27 18:13:22 [grok-4-1] 		delete connections[rid];
2025-11-27 18:13:22 [grok-4-1] 	}
2025-11-27 18:13:22 [grok-4-1] }
2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] 
