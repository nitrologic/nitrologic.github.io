2025-11-27 20:49:19 [grok-4-1] • Critical bug*: `readStream` has `while(true)` loop that awaits `connection.read()` but
2025-11-27 20:49:19 [grok-4-1] never yields back to event loop inside the loop. This will block the entire server.
2025-11-27 20:49:19 [grok-4-1] 
2025-11-27 20:49:19 [grok-4-1] • Fix*:
2025-11-27 20:49:19 [grok-4-1] 
2025-11-27 20:49:19 [grok-4-1] async function readStream(connection) {
2025-11-27 20:49:19 [grok-4-1] 	const rid = connection.rid;
2025-11-27 20:49:19 [grok-4-1] 	const decoder = new TextDecoder();
2025-11-27 20:49:19 [grok-4-1] 	const session = connections[rid];
2025-11-27 20:49:19 [grok-4-1] 	if (!session) return;
2025-11-27 20:49:19 [grok-4-1] 
2025-11-27 20:49:19 [grok-4-1] 	const buffer = new Uint8Array(1024);
2025-11-27 20:49:19 [grok-4-1] 
2025-11-27 20:49:19 [grok-4-1] 	while (true) {
2025-11-27 20:49:19 [grok-4-1] 		const n = await connection.read(buffer);
2025-11-27 20:49:19 [grok-4-1] 		if (n === null) break; // EOF
2025-11-27 20:49:19 [grok-4-1] 
2025-11-27 20:49:19 [grok-4-1] 		const text = decoder.decode(buffer.subarray(0, n));
2025-11-27 20:49:19 [grok-4-1] 		const lines = text.split('\n');
2025-11-27 20:49:19 [grok-4-1] 
2025-11-27 20:49:19 [grok-4-1] 		for (const line of lines) {
2025-11-27 20:49:19 [grok-4-1] 			const trimmed = line.trim();
2025-11-27 20:49:19 [grok-4-1] 			if (trimmed === 'exit') {
2025-11-27 20:49:19 [grok-4-1] 				await session.print('SloppyPipe Closed\r\n');
2025-11-27 20:49:19 [grok-4-1] 				delete connections[rid];
2025-11-27 20:49:19 [grok-4-1] 				connection.close();
2025-11-27 20:49:19 [grok-4-1] 				return;
2025-11-27 20:49:19 [grok-4-1] 			}
2025-11-27 20:49:19 [grok-4-1] 			if (trimmed.length) {
2025-11-27 20:49:19 [grok-4-1] 				const blob = {messages: [{message: trimmed, from: 'pipe:' + rid}]};
2025-11-27 20:49:19 [grok-4-1] 				await writeFountain(JSON.stringify(blob) + '\n');
2025-11-27 20:49:19 [grok-4-1] 			}
2025-11-27 20:49:19 [grok-4-1] 		}
2025-11-27 20:49:19 [grok-4-1] 		await new Promise(resolve => setImmediate(resolve)); // Yield control
2025-11-27 20:49:19 [grok-4-1] 	}
2025-11-27 20:49:19 [grok-4-1] }
