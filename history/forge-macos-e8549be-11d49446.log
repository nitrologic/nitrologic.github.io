2025-11-05 14:28:45 [kimi-k2-0905]     static int               s_sock;
2025-11-05 14:28:45 [kimi-k2-0905]     static std::mutex        s_txMtx;
2025-11-05 14:28:45 [kimi-k2-0905]     static std::mutex        s_rxMtx;
2025-11-05 14:28:45 [kimi-k2-0905]     static std::deque<std::string> s_rxQueue;
2025-11-05 14:28:45 [kimi-k2-0905]     static std::thread       s_ioThread;
2025-11-05 14:28:45 [kimi-k2-0905] 
2025-11-05 14:28:45 [kimi-k2-0905]     static void ioLoop()
2025-11-05 14:28:45 [kimi-k2-0905]     {
2025-11-05 14:28:45 [kimi-k2-0905]         std::vector<char> buf(1 << 20);
2025-11-05 14:28:45 [kimi-k2-0905]         std::string tail;
2025-11-05 14:28:45 [kimi-k2-0905]         while (s_running)
2025-11-05 14:28:45 [kimi-k2-0905]         {
2025-11-05 14:28:45 [kimi-k2-0905]             ssize_t n = ::recv(s_sock, buf.data(), buf.size(), 0);
2025-11-05 14:28:45 [kimi-k2-0905]             if (n <= 0) { std::this_thread::sleep_for(std::chrono::milliseconds(500)); continue; }
2025-11-05 14:28:45 [kimi-k2-0905] 
2025-11-05 14:28:45 [kimi-k2-0905]             tail.append(buf.data(), n);
2025-11-05 14:28:45 [kimi-k2-0905]             size_t pos;
2025-11-05 14:28:45 [kimi-k2-0905]             while ((pos = tail.find('\n')) != std::string::npos)
2025-11-05 14:28:45 [kimi-k2-0905]             {
2025-11-05 14:28:45 [kimi-k2-0905]                 std::lock_guard<std::mutex> lk(s_rxMtx);
2025-11-05 14:28:45 [kimi-k2-0905]                 s_rxQueue.emplace_back(tail.substr(0, pos));
2025-11-05 14:28:45 [kimi-k2-0905]                 tail.erase(0, pos + 1);
2025-11-05 14:28:45 [kimi-k2-0905]             }
2025-11-05 14:28:45 [kimi-k2-0905]         }
2025-11-05 14:28:45 [kimi-k2-0905]     }
2025-11-05 14:28:45 [kimi-k2-0905] };
