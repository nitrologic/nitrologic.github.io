2025-11-27 21:02:36 [grok-4-1] async function writeSloppy(message: string, from: string) {
2025-11-27 21:02:36 [grok-4-1] 	const text = `[${from}] ${message}\r\n`;
2025-11-27 21:02:36 [grok-4-1] 	const promises = Object.values(connections).map(session =>
2025-11-27 21:02:36 [grok-4-1] 		session.print(text).catch(() => {}) // ignore closed connections
2025-11-27 21:02:36 [grok-4-1] 	);
