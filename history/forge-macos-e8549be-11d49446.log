2025-11-19 08:44:00 [simon@midnightblue] what is wrong with link_dir?
2025-11-19 08:44:01 [simon@midnightblue] if(APPLE)	execute_process(COMMAND brew --prefix v8 OUTPUT_VARIABLE BREW_V8 OUTPUT_STRIP_TRAILING_WHITESPACE)	set(V8_INC "${BREW_V8}/include")	target_link_directories(v8io "${BREW_V8}/lib")	target_link_libraries(v8io v8 v8_libplatform v8_libbase)
2025-11-19 08:44:08 [gpt-5.1-2025] The issue is that `targetlinkdirectories` is being called with a plain argument instead of
2025-11-19 08:44:08 [gpt-5.1-2025] using the `PRIVATE/PUBLIC/INTERFACE` signature that modern CMake expects.
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] You currently have (single line, but formatted):
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] target_link_directories(v8io "${BREW_V8}/lib")
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] The correct form is:
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] target_link_directories(v8io PRIVATE "${BREW_V8}/lib")
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] Full fixed Apple block:
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] 
2025-11-19 08:44:08 [gpt-5.1-2025] if(APPLE)
2025-11-19 08:44:08 [gpt-5.1-2025] 	execute_process(
2025-11-19 08:44:08 [gpt-5.1-2025] 		COMMAND brew --prefix v8
2025-11-19 08:44:08 [gpt-5.1-2025] 		OUTPUT_VARIABLE BREW_V8
2025-11-19 08:44:08 [gpt-5.1-2025] 		OUTPUT_STRIP_TRAILING_WHITESPACE
2025-11-19 08:44:08 [gpt-5.1-2025] 	)
2025-11-19 08:44:08 [gpt-5.1-2025] 	set(V8_INC "${BREW_V8}/include")
2025-11-19 08:44:08 [gpt-5.1-2025] 	target_include_directories(v8io PRIVATE "${V8_INC}")
2025-11-19 08:44:08 [gpt-5.1-2025] 	target_link_directories(v8io PRIVATE "${BREW_V8}/lib")
2025-11-19 08:44:08 [gpt-5.1-2025] 	target_link_libraries(v8io PRIVATE v8 v8_libplatform v8_libbase)
2025-11-19 08:44:08 [gpt-5.1-2025] endif()
