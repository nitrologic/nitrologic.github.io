2025-11-27 18:13:22 [grok-4-1] 
2025-11-27 18:13:22 [grok-4-1] async function onConnection(connection) {
2025-11-27 18:13:22 [grok-4-1] 	const rid = connection.rid;
2025-11-27 18:13:22 [grok-4-1] 	const session = new SocketSession(connection);
2025-11-27 18:13:22 [grok-4-1] 	connections[rid] = session;
