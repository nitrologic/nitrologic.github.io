2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905] class FountainBridge
2025-11-05 14:33:48 [kimi-k2-0905] {
2025-11-05 14:33:48 [kimi-k2-0905] public:
2025-11-05 14:33:48 [kimi-k2-0905]     using ReadyCb = std::function<void()>;          // invoked when link (re)established
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     // 1.  life-time
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     static bool init(ReadyCb onReady = nullptr)           // call once
2025-11-05 14:33:48 [kimi-k2-0905]     {
2025-11-05 14:33:48 [kimi-k2-0905]         s_onReady = std::move(onReady);
2025-11-05 14:33:48 [kimi-k2-0905]         return tryConnect();
2025-11-05 14:33:48 [kimi-k2-0905]     }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]     static void shutdown()                                // call once at exit
2025-11-05 14:33:48 [kimi-k2-0905]     {
2025-11-05 14:33:48 [kimi-k2-0905]         s_running = false;
2025-11-05 14:33:48 [kimi-k2-0905]         {   // wake I/O thread blocked in poll()
2025-11-05 14:33:48 [kimi-k2-0905]             std::lock_guard<std::mutex> lk(s_txMtx);
2025-11-05 14:33:48 [kimi-k2-0905]             if (s_sock >= 0) ::close(s_sock);
2025-11-05 14:33:48 [kimi-k2-0905]             s_sock = -1;
2025-11-05 14:33:48 [kimi-k2-0905]         }
2025-11-05 14:33:48 [kimi-k2-0905]         if (s_ioThread.joinable()) s_ioThread.join();
2025-11-05 14:33:48 [kimi-k2-0905]     }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     // 2.  producer  (thread-safe)
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     static void push(const std::string& json)
2025-11-05 14:33:48 [kimi-k2-0905]     {
2025-11-05 14:33:48 [kimi-k2-0905]         std::string line = json.back() == '\n' ? json : json + '\n';
2025-11-05 14:33:48 [kimi-k2-0905]         std::lock_guard<std::mutex> lk(s_txMtx);
2025-11-05 14:33:48 [kimi-k2-0905]         if (s_sock >= 0) ::send(s_sock, line.data(), line.size(), MSG_NOSIGNAL);
2025-11-05 14:33:48 [kimi-k2-0905]     }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     // 3.  consumer  (non-blocking)
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     static bool pop(std::string& out)
2025-11-05 14:33:48 [kimi-k2-0905]     {
2025-11-05 14:33:48 [kimi-k2-0905]         std::lock_guard<std::mutex> lk(s_rxMtx);
2025-11-05 14:33:48 [kimi-k2-0905]         if (s_rxQueue.empty()) return false;
2025-11-05 14:33:48 [kimi-k2-0905]         out = std::move(s_rxQueue.front());
2025-11-05 14:33:48 [kimi-k2-0905]         s_rxQueue.pop_front();
2025-11-05 14:33:48 [kimi-k2-0905]         return true;
2025-11-05 14:33:48 [kimi-k2-0905]     }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905] private:
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     //  connection attempt with exponential back-off
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     static bool tryConnect()
2025-11-05 14:33:48 [kimi-k2-0905]     {
2025-11-05 14:33:48 [kimi-k2-0905]         std::lock_guard<std::mutex> lk(s_txMtx);
2025-11-05 14:33:48 [kimi-k2-0905]         if (s_sock >= 0) return true;               // already up
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]         int fd = ::socket(AF_INET, SOCK_STREAM, 0);
2025-11-05 14:33:48 [kimi-k2-0905]         if (fd < 0) return false;
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]         sockaddr_in addr{};
2025-11-05 14:33:48 [kimi-k2-0905]         addr.sin_family = AF_INET;
2025-11-05 14:33:48 [kimi-k2-0905]         addr.sin_port   = htons(8081);
2025-11-05 14:33:48 [kimi-k2-0905]         if (::inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr) != 1 ||
2025-11-05 14:33:48 [kimi-k2-0905]             ::connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0)
2025-11-05 14:33:48 [kimi-k2-0905]         {
2025-11-05 14:33:48 [kimi-k2-0905]             ::close(fd);
2025-11-05 14:33:48 [kimi-k2-0905]             return false;
2025-11-05 14:33:48 [kimi-k2-0905]         }
2025-11-05 14:33:48 [kimi-k2-0905]         s_sock = fd;
2025-11-05 14:33:48 [kimi-k2-0905]         if (!s_ioThread.joinable())          // first successful connect
2025-11-05 14:33:48 [kimi-k2-0905]         {
2025-11-05 14:33:48 [kimi-k2-0905]             s_running = true;
2025-11-05 14:33:48 [kimi-k2-0905]             s_ioThread = std::thread(ioLoop);
2025-11-05 14:33:48 [kimi-k2-0905]         }
2025-11-05 14:33:48 [kimi-k2-0905]         if (s_onReady) s_onReady();          // notify user code
2025-11-05 14:33:48 [kimi-k2-0905]         return true;
2025-11-05 14:33:48 [kimi-k2-0905]     }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     //  I/O thread : recv() + auto-reconnect
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     static void ioLoop()
2025-11-05 14:33:48 [kimi-k2-0905]     {
2025-11-05 14:33:48 [kimi-k2-0905]         std::vector<char> buf(1 << 20);
2025-11-05 14:33:48 [kimi-k2-0905]         std::string tail;
2025-11-05 14:33:48 [kimi-k2-0905]         using clock = std::chrono::steady_clock;
2025-11-05 14:33:48 [kimi-k2-0905]         auto nextAttempt = clock::now();
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]         while (s_running)
2025-11-05 14:33:48 [kimi-k2-0905]         {
2025-11-05 14:33:48 [kimi-k2-0905]             // ---- socket alive? ----
2025-11-05 14:33:48 [kimi-k2-0905]             {
2025-11-05 14:33:48 [kimi-k2-0905]                 std::lock_guard<std::mutex> lk(s_txMtx);
2025-11-05 14:33:48 [kimi-k2-0905]                 if (s_sock < 0)
2025-11-05 14:33:48 [kimi-k2-0905]                 {
2025-11-05 14:33:48 [kimi-k2-0905]                     auto now = clock::now();
2025-11-05 14:33:48 [kimi-k2-0905]                     if (now >= nextAttempt && tryConnect())
2025-11-05 14:33:48 [kimi-k2-0905]                         tail.clear();               // drop partial lines after reconnect
2025-11-05 14:33:48 [kimi-k2-0905]                     else
2025-11-05 14:33:48 [kimi-k2-0905]                         nextAttempt = now + std::chrono::milliseconds(500);
2025-11-05 14:33:48 [kimi-k2-0905]                     continue;
2025-11-05 14:33:48 [kimi-k2-0905]                 }
2025-11-05 14:33:48 [kimi-k2-0905]             }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]             // ---- receive ----
2025-11-05 14:33:48 [kimi-k2-0905]             ssize_t n = ::recv(s_sock, buf.data(), buf.size(), 0);
2025-11-05 14:33:48 [kimi-k2-0905]             if (n <= 0)                                // peer gone
2025-11-05 14:33:48 [kimi-k2-0905]             {
2025-11-05 14:33:48 [kimi-k2-0905]                 std::lock_guard<std::mutex> lk(s_txMtx);
2025-11-05 14:33:48 [kimi-k2-0905]                 if (s_sock >= 0) { ::close(s_sock); s_sock = -1; }
2025-11-05 14:33:48 [kimi-k2-0905]                 continue;
2025-11-05 14:33:48 [kimi-k2-0905]             }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]             tail.append(buf.data(), n);
2025-11-05 14:33:48 [kimi-k2-0905]             size_t pos;
2025-11-05 14:33:48 [kimi-k2-0905]             while ((pos = tail.find('\n')) != std::string::npos)
2025-11-05 14:33:48 [kimi-k2-0905]             {
2025-11-05 14:33:48 [kimi-k2-0905]                 std::lock_guard<std::mutex> lk(s_rxMtx);
2025-11-05 14:33:48 [kimi-k2-0905]                 s_rxQueue.emplace_back(tail.substr(0, pos));
2025-11-05 14:33:48 [kimi-k2-0905]                 tail.erase(0, pos + 1);
2025-11-05 14:33:48 [kimi-k2-0905]             }
2025-11-05 14:33:48 [kimi-k2-0905]         }
2025-11-05 14:33:48 [kimi-k2-0905]     }
2025-11-05 14:33:48 [kimi-k2-0905] 
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
2025-11-05 14:33:48 [kimi-k2-0905]     //  static storage
2025-11-05 14:33:48 [kimi-k2-0905]     //------------------------------------------------------------------
