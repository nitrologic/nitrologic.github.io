2025-11-19 10:10:30 [gpt-5.1-2025] 	std::cout << "AllocatePages" << std::endl;
2025-11-19 10:10:30 [gpt-5.1-2025] 
2025-11-19 10:10:30 [gpt-5.1-2025] 	int prot = ToProt(permissions);
2025-11-19 10:10:30 [gpt-5.1-2025] 	int flags = MAP_PRIVATE | MAP_ANONYMOUS;
2025-11-19 10:10:30 [gpt-5.1-2025] 
2025-11-19 10:10:30 [gpt-5.1-2025] 	// If V8 passes a non-null address, treat it as a hint.
2025-11-19 10:10:30 [gpt-5.1-2025] 	// If null, let the kernel choose.
2025-11-19 10:10:30 [gpt-5.1-2025] 	void* hint = address;
2025-11-19 10:10:30 [gpt-5.1-2025] 
2025-11-19 10:10:30 [gpt-5.1-2025] 	// Most V8 requests are page-aligned; if alignment is larger and not 0, you may need a more
2025-11-19 10:10:30 [gpt-5.1-2025] 	// complex scheme. For now we trust that V8's request is compatible with the OS.
2025-11-19 10:10:30 [gpt-5.1-2025] 	(void)alignment;
2025-11-19 10:10:30 [gpt-5.1-2025] 
2025-11-19 10:10:30 [gpt-5.1-2025] 	void* addr = mmap(hint, size, prot, flags, -1, 0);
2025-11-19 10:10:30 [gpt-5.1-2025] 	return addr == MAP_FAILED ? nullptr : addr;
2025-11-19 10:10:30 [gpt-5.1-2025] }
