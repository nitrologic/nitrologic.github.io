2025-11-05 14:25:03 [kimi-k2-0905] Here is a self-contained C++17 "shim" you can drop into your existing server.
2025-11-05 14:25:03 [kimi-k2-0905] It opens a single TCP connection to Fountain (localhost:8081), keeps it alive, and exposes
2025-11-05 14:25:03 [kimi-k2-0905] two trivial calls you can make from anywhere in your native code:
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] // fountain_bridge.hpp  (C++17)
2025-11-05 14:25:03 [kimi-k2-0905] #pragma once
2025-11-05 14:25:03 [kimi-k2-0905] #include <string>
2025-11-05 14:25:03 [kimi-k2-0905] #include <vector>
2025-11-05 14:25:03 [kimi-k2-0905] #include <mutex>
2025-11-05 14:25:03 [kimi-k2-0905] #include <thread>
2025-11-05 14:25:03 [kimi-k2-0905] #include <atomic>
2025-11-05 14:25:03 [kimi-k2-0905] #include <deque>
2025-11-05 14:25:03 [kimi-k2-0905] #include <sys/socket.h>
2025-11-05 14:25:03 [kimi-k2-0905] #include <netinet/in.h>
2025-11-05 14:25:03 [kimi-k2-0905] #include <arpa/inet.h>
2025-11-05 14:25:03 [kimi-k2-0905] #include <unistd.h>
2025-11-05 14:25:03 [kimi-k2-0905] #include <cstring>
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] class FountainBridge {
2025-11-05 14:25:03 [kimi-k2-0905] public:
2025-11-05 14:25:03 [kimi-k2-0905]     // Call once at start-up; spawns background I/O thread
2025-11-05 14:25:03 [kimi-k2-0905]     static bool init();
2025-11-05 14:25:03 [kimi-k2-0905]     // Push a message into Fountain (thread-safe)
2025-11-05 14:25:03 [kimi-k2-0905]     static void push(const std::string& jsonMsg);
2025-11-05 14:25:03 [kimi-k2-0905]     // Pop the next broadcast received from Fountain (non-blocking)
2025-11-05 14:25:03 [kimi-k2-0905]     static bool pop(std::string& out);  // returns false if empty
2025-11-05 14:25:03 [kimi-k2-0905]     // Shutdown nicely
2025-11-05 14:25:03 [kimi-k2-0905]     static void shutdown();
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] private:
2025-11-05 14:25:03 [kimi-k2-0905]     static std::atomic<bool> s_running;
2025-11-05 14:25:03 [kimi-k2-0905]     static int                 s_sock;
2025-11-05 14:25:03 [kimi-k2-0905]     static std::mutex          s_txMtx;
2025-11-05 14:25:03 [kimi-k2-0905]     static std::mutex          s_rxMtx;
2025-11-05 14:25:03 [kimi-k2-0905]     static std::deque<std::string> s_rxQueue;
2025-11-05 14:25:03 [kimi-k2-0905]     static std::thread         s_ioThread;
2025-11-05 14:25:03 [kimi-k2-0905]     static void ioLoop();
2025-11-05 14:25:03 [kimi-k2-0905] };
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] // -----------------------------------------------------------
2025-11-05 14:25:03 [kimi-k2-0905] // fountain_bridge.cpp
2025-11-05 14:25:03 [kimi-k2-0905] #include "fountain_bridge.hpp"
2025-11-05 14:25:03 [kimi-k2-0905] #include <iostream>
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] std::atomic<bool> FountainBridge::s_running{false};
2025-11-05 14:25:03 [kimi-k2-0905] int FountainBridge::s_sock = -1;
2025-11-05 14:25:03 [kimi-k2-0905] std::mutex FountainBridge::s_txMtx;
2025-11-05 14:25:03 [kimi-k2-0905] std::mutex FountainBridge::s_rxMtx;
2025-11-05 14:25:03 [kimi-k2-0905] std::deque<std::string> FountainBridge::s_rxQueue;
2025-11-05 14:25:03 [kimi-k2-0905] std::thread FountainBridge::s_ioThread;
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] bool FountainBridge::init() {
2025-11-05 14:25:03 [kimi-k2-0905]     if (s_running) return true;
2025-11-05 14:25:03 [kimi-k2-0905]     s_sock = ::socket(AF_INET, SOCK_STREAM, 0);
2025-11-05 14:25:03 [kimi-k2-0905]     if (s_sock < 0) return false;
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905]     sockaddr_in addr{};
2025-11-05 14:25:03 [kimi-k2-0905]     addr.sin_family = AF_INET;
2025-11-05 14:25:03 [kimi-k2-0905]     addr.sin_port   = htons(8081);
2025-11-05 14:25:03 [kimi-k2-0905]     if (::inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr) != 1) {
2025-11-05 14:25:03 [kimi-k2-0905]         ::close(s_sock);
2025-11-05 14:25:03 [kimi-k2-0905]         return false;
2025-11-05 14:25:03 [kimi-k2-0905]     }
2025-11-05 14:25:03 [kimi-k2-0905]     if (::connect(s_sock, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
2025-11-05 14:25:03 [kimi-k2-0905]         ::close(s_sock);
2025-11-05 14:25:03 [kimi-k2-0905]         return false;
2025-11-05 14:25:03 [kimi-k2-0905]     }
2025-11-05 14:25:03 [kimi-k2-0905]     s_running = true;
2025-11-05 14:25:03 [kimi-k2-0905]     s_ioThread = std::thread(ioLoop);
2025-11-05 14:25:03 [kimi-k2-0905]     return true;
2025-11-05 14:25:03 [kimi-k2-0905] }
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] void FountainBridge::shutdown() {
2025-11-05 14:25:03 [kimi-k2-0905]     s_running = false;
2025-11-05 14:25:03 [kimi-k2-0905]     if (s_sock >= 0) {
2025-11-05 14:25:03 [kimi-k2-0905]         ::shutdown(s_sock, SHUT_RDWR);
2025-11-05 14:25:03 [kimi-k2-0905]         ::close(s_sock);
2025-11-05 14:25:03 [kimi-k2-0905]     }
2025-11-05 14:25:03 [kimi-k2-0905]     if (s_ioThread.joinable()) s_ioThread.join();
2025-11-05 14:25:03 [kimi-k2-0905] }
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] void FountainBridge::push(const std::string& jsonMsg) {
2025-11-05 14:25:03 [kimi-k2-0905]     std::string line = jsonMsg.back() == '\n' ? jsonMsg : jsonMsg + '\n';
2025-11-05 14:25:03 [kimi-k2-0905]     std::lock_guard<std::mutex> lk(s_txMtx);
2025-11-05 14:25:03 [kimi-k2-0905]     if (s_sock >= 0) ::send(s_sock, line.data(), line.size(), MSG_NOSIGNAL);
2025-11-05 14:25:03 [kimi-k2-0905] }
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] bool FountainBridge::pop(std::string& out) {
2025-11-05 14:25:03 [kimi-k2-0905]     std::lock_guard<std::mutex> lk(s_rxMtx);
2025-11-05 14:25:03 [kimi-k2-0905]     if (s_rxQueue.empty()) return false;
2025-11-05 14:25:03 [kimi-k2-0905]     out = std::move(s_rxQueue.front());
2025-11-05 14:25:03 [kimi-k2-0905]     s_rxQueue.pop_front();
2025-11-05 14:25:03 [kimi-k2-0905]     return true;
2025-11-05 14:25:03 [kimi-k2-0905] }
2025-11-05 14:25:03 [kimi-k2-0905] 
2025-11-05 14:25:03 [kimi-k2-0905] void FountainBridge::ioLoop() {
2025-11-05 14:25:03 [kimi-k2-0905]     std::vector<char> buf(1 << 20);
2025-11-05 14:25:03 [kimi-k2-0905]     std::string tail;
2025-11-05 14:25:03 [kimi-k2-0905]     while (s_running) {
2025-11-05 14:25:03 [kimi-k2-0905]         ssize_t n = ::recv(s_sock, buf.data(), buf.size(), 0);
2025-11-05 14:25:03 [kimi-k2-0905]         if (n <= 0) { std::this_thread::sleep_for(std::chrono::milliseconds(500)); continue; }
2025-11-05 14:25:03 [kimi-k2-0905]         tail.append(buf.data(), n);
2025-11-05 14:25:03 [kimi-k2-0905]         size_t pos;
2025-11-05 14:25:03 [kimi-k2-0905]         while ((pos = tail.find('\n')) != std::string::npos) {
2025-11-05 14:25:03 [kimi-k2-0905]             std::string line = tail.substr(0, pos);
2025-11-05 14:25:03 [kimi-k2-0905]             tail.erase(0, pos + 1);
2025-11-05 14:25:03 [kimi-k2-0905]             {  // push into queue
2025-11-05 14:25:03 [kimi-k2-0905]                 std::lock_guard<std::mutex> lk(s_rxMtx);
2025-11-05 14:25:03 [kimi-k2-0905]                 s_rxQueue.emplace_back(std::move(line));
2025-11-05 14:25:03 [kimi-k2-0905]             }
2025-11-05 14:25:03 [kimi-k2-0905]         }
2025-11-05 14:25:03 [kimi-k2-0905]     }
2025-11-05 14:25:03 [kimi-k2-0905] }
2025-11-05 14:25:03 [kimi-k2-0905] 
