2026-05-03 13:06:02 [deepseek-v4] I propose modularizing the accept logic so that adding new bot ports is as simple as calling:
2026-05-03 13:06:02 [deepseek-v4] 
2026-05-03 13:06:02 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] startListener("mybot", 8084);
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] Under the hood, we maintain a listener registry – a `Map<string, ListenerEntry>` where each
2026-05-03 13:06:03 [deepseek-v4] entry stores the `Deno.Listener`, the current accept promise, and the name/port. The main loop
2026-05-03 13:06:03 [deepseek-v4] (`slopPrompt`) will race all current accept promises in that registry.
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] Step 1 – Define types and the registry
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] interface ListenerEntry {
2026-05-03 13:06:03 [deepseek-v4] 	listener: Deno.Listener;
2026-05-03 13:06:03 [deepseek-v4] 	port: number;
2026-05-03 13:06:03 [deepseek-v4] 	acceptPromise: Promise<{ connection: Deno.TcpConn; name: string; port: number }>;
2026-05-03 13:06:03 [deepseek-v4] }
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] const listenerRegistry = new Map<string, ListenerEntry>();
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] Step 2 – `startListener(name, port)` – creates and starts
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] export function startListener(name: string, port: number): void {
2026-05-03 13:06:03 [deepseek-v4] 	// Already registered? skip
2026-05-03 13:06:03 [deepseek-v4] 	if (listenerRegistry.has(name)) {
2026-05-03 13:06:03 [deepseek-v4] 		console.warn(`[PROMPT] Listener '${name}' already running on port ${port}`);
2026-05-03 13:06:03 [deepseek-v4] 		return;
2026-05-03 13:06:03 [deepseek-v4] 	}
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 	const listener = Deno.listen({ hostname: "localhost", port, transport: "tcp" });
2026-05-03 13:06:03 [deepseek-v4] 	const entry: ListenerEntry = {
2026-05-03 13:06:03 [deepseek-v4] 		listener,
2026-05-03 13:06:03 [deepseek-v4] 		port,
2026-05-03 13:06:03 [deepseek-v4] 		acceptPromise: acceptLoop(listener, name, port)
2026-05-03 13:06:03 [deepseek-v4] 	};
2026-05-03 13:06:03 [deepseek-v4] 	listenerRegistry.set(name, entry);
2026-05-03 13:06:03 [deepseek-v4] 	console.log(`[PROMPT] listening for '${name}' on port ${port}`);
2026-05-03 13:06:03 [deepseek-v4] }
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] The `acceptLoop` helper creates a promise that resolves on first accept and then re‑arms itself:
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] async function acceptLoop(listener: Deno.Listener, name: string, port: number) {
2026-05-03 13:06:03 [deepseek-v4] 	const connection = await listener.accept();
2026-05-03 13:06:03 [deepseek-v4] 	// Re‑arm: update the registry entry's promise for next connection
2026-05-03 13:06:03 [deepseek-v4] 	listenerRegistry.set(name, {
2026-05-03 13:06:03 [deepseek-v4] 		listener,
2026-05-03 13:06:03 [deepseek-v4] 		port,
2026-05-03 13:06:03 [deepseek-v4] 		acceptPromise: acceptLoop(listener, name, port)
2026-05-03 13:06:03 [deepseek-v4] 	});
2026-05-03 13:06:03 [deepseek-v4] 	return { connection, name, port };
2026-05-03 13:06:03 [deepseek-v4] }
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] 
2026-05-03 13:06:03 [deepseek-v4] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
