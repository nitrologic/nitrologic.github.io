2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] Add a `stopListener(name)` to remove from registry and close the listener:
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] export function stopListener(name: string): void {
2026-05-03 13:06:04 [deepseek-v4] 	const entry = listenerRegistry.get(name);
2026-05-03 13:06:04 [deepseek-v4] 	if (!entry) return;
2026-05-03 13:06:04 [deepseek-v4] 	entry.listener.close();
2026-05-03 13:06:04 [deepseek-v4] 	listenerRegistry.delete(name);
2026-05-03 13:06:04 [deepseek-v4] }
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
