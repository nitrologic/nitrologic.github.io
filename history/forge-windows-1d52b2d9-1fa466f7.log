2026-05-03 13:03:38 [deepseek-v4] 	try {
2026-05-03 13:03:38 [deepseek-v4] 		sloppyListener = Deno.listen({ hostname: "localhost", port: 8081 });
2026-05-03 13:03:38 [deepseek-v4] 		riffListener = Deno.listen({ hostname: "localhost", port: 8082 });
2026-05-03 13:03:38 [deepseek-v4] 		foggyListener = Deno.listen({ hostname: "localhost", port: 8083 });
2026-05-03 13:03:38 [deepseek-v4] 		console.log("[PROMPT] listening 8081 (sloppy) 8082 (riff) 8083(foggy)");
2026-05-03 13:03:38 [deepseek-v4] 
2026-05-03 13:03:38 [deepseek-v4] 		// Start accept promises
2026-05-03 13:03:38 [deepseek-v4] 		sloppyAcceptPromise = acceptFromListener(sloppyListener, "sloppy", 8081);
2026-05-03 13:03:38 [deepseek-v4] 		riffAcceptPromise = acceptFromListener(riffListener, "riff", 8082);
2026-05-03 13:03:38 [deepseek-v4] 		foggyAcceptPromise = acceptFromListener(foggyListener, "foggy", 8083);
2026-05-03 13:03:38 [deepseek-v4] 	} catch (e) {
