2026-05-07 19:19:16 [gemini-3.1-pro] 	pio_sm_config config5 = chroma_program_get_default_config(offset5);
2026-05-07 19:19:16 [gemini-3.1-pro] 	sm_config_set_set_pins(&config5, CHROMA100_PIN, 2);
