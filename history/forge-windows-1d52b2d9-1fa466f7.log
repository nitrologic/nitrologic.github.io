2026-05-03 16:27:01 [nitro@ryzen5] i need to accept connections on port 8081
2026-05-03 16:27:10 [deepseek-v4] Below is a minimal modification to accept multiple TCP connections on port 8081.
2026-05-03 16:27:10 [deepseek-v4] I’ve extracted the event loop into a reusable function so it can be called at startup or toggled
2026-05-03 16:27:10 [deepseek-v4] with `/listen`.
2026-05-03 16:27:10 [deepseek-v4] 
2026-05-03 16:27:10 [deepseek-v4] 
2026-05-03 16:27:10 [deepseek-v4] // Add to slopprompt.ts or relay.ts (where raw mode isn't active)
2026-05-03 16:27:10 [deepseek-v4] 
2026-05-03 16:27:10 [deepseek-v4] async function acceptLoop(listener: Deno.Listener) {
2026-05-03 16:27:10 [deepseek-v4] 	while (true) {
2026-05-03 16:27:10 [deepseek-v4] 		try {
2026-05-03 16:27:10 [deepseek-v4] 			const conn = await listener.accept();
2026-05-03 16:27:10 [deepseek-v4] 			const name = `conn-${Date.now()}`;
2026-05-03 16:27:10 [deepseek-v4] 			slopConnections.set(name, conn);
2026-05-03 16:27:10 [deepseek-v4] 			echo("[RELAY] accepted", name);
2026-05-03 16:27:10 [deepseek-v4] 			// Start reading from this connection in the background
2026-05-03 16:27:10 [deepseek-v4] 			readNamedConnection(name, conn).then(result => {
2026-05-03 16:27:10 [deepseek-v4] 				// handle result in the main race loop
2026-05-03 16:27:10 [deepseek-v4] 				receivePromises[name] = result;
2026-05-03 16:27:10 [deepseek-v4] 			});
2026-05-03 16:27:10 [deepseek-v4] 		} catch (e) {
2026-05-03 16:27:10 [deepseek-v4] 			echo("[RELAY] accept error:", e.message);
2026-05-03 16:27:10 [deepseek-v4] 			break;
2026-05-03 16:27:10 [deepseek-v4] 		}
2026-05-03 16:27:10 [deepseek-v4] 	}
2026-05-03 16:27:10 [deepseek-v4] }
2026-05-03 16:27:10 [deepseek-v4] 
2026-05-03 16:27:10 [deepseek-v4] // Then replace the simple one‑time accept with the loop:
2026-05-03 16:27:10 [deepseek-v4] let botListener: Deno.Listener | null = null;
2026-05-03 16:27:10 [deepseek-v4] export function listenService() {
2026-05-03 16:27:10 [deepseek-v4] 	if (botListener) return;
2026-05-03 16:27:10 [deepseek-v4] 	try {
2026-05-03 16:27:10 [deepseek-v4] 		botListener = Deno.listen({ hostname: "localhost", port: 8081 });
2026-05-03 16:27:10 [deepseek-v4] 		echo("[RELAY] listening on port 8081");
2026-05-03 16:27:10 [deepseek-v4] 		acceptLoop(botListener); // start the infinite loop
2026-05-03 16:27:10 [deepseek-v4] 	} catch (e) {
2026-05-03 16:27:11 [deepseek-v4] 		console.error("[RELAY] listen failed:", e);
2026-05-03 16:27:11 [deepseek-v4] 	}
2026-05-03 16:27:11 [deepseek-v4] }
2026-05-03 16:27:11 [deepseek-v4] 
2026-05-03 16:27:11 [deepseek-v4] 
