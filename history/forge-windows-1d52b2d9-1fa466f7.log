2026-05-05 14:16:29 [deepseek-v4]     delete receivePromises[name];
2026-05-05 14:16:29 [deepseek-v4]     throw(error); // this will cause a crash
2026-05-05 14:16:29 [deepseek-v4] }
2026-05-05 14:16:29 [deepseek-v4] 
2026-05-05 14:16:30 [deepseek-v4] 
