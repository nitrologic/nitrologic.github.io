2026-05-07 15:57:42 [gemini-3.1-lite] /**
2026-05-07 15:57:42 [gemini-3.1-lite]  * Prepares the buffer for the vidbit state machine.
2026-05-07 15:57:42 [gemini-3.1-lite]  * @param buffer Pointer to the array to be filled.
2026-05-07 15:57:42 [gemini-3.1-lite]  * @param width Number of pixels per line.
2026-05-07 15:57:42 [gemini-3.1-lite]  * @param height Number of lines.
2026-05-07 15:57:42 [gemini-3.1-lite]  */
2026-05-07 15:57:42 [gemini-3.1-lite] void prepare_red_video_data(uint32_t* buffer, int width, int height) {
2026-05-07 15:57:42 [gemini-3.1-lite]     int index = 0;
2026-05-07 15:57:42 [gemini-3.1-lite] 
2026-05-07 15:57:42 [gemini-3.1-lite]     // 1. Vsync pulse train configuration
2026-05-07 15:57:42 [gemini-3.1-lite]     buffer[index++] = 31; // [0] vsync pulse counter
2026-05-07 15:57:42 [gemini-3.1-lite]     buffer[index++] = 31965 - 64; // [1] pulse width
2026-05-07 15:57:42 [gemini-3.1-lite] 
2026-05-07 15:57:42 [gemini-3.1-lite]     // 2. Line/Pixel counters
2026-05-07 15:57:42 [gemini-3.1-lite]     buffer[index++] = height; // Line counter
2026-05-07 15:57:42 [gemini-3.1-lite]     buffer[index++] = width;  // Pixel counter
2026-05-07 15:57:42 [gemini-3.1-lite] 
2026-05-07 15:57:42 [gemini-3.1-lite]     // 3. Populate bitmap data
2026-05-07 15:57:42 [gemini-3.1-lite]     // For a red-only signal, ensure the data bits are formatted
2026-05-07 15:57:42 [gemini-3.1-lite]     // to align with the 'out pins, 1' instruction in your PIO
2026-05-07 15:57:42 [gemini-3.1-lite]     for (int y = 0; y < height; ++y) {
2026-05-07 15:57:42 [gemini-3.1-lite]         for (int x = 0; x < width / 32; ++x) {
2026-05-07 15:57:42 [gemini-3.1-lite]             // Example: Fill with a pattern or actual image data
