2026-05-03 13:03:39 [deepseek-v4] // Single accept helper for a given listener; re‑arms itself after each connection
2026-05-03 13:03:39 [deepseek-v4] async function acceptFromListener(
2026-05-03 13:03:39 [deepseek-v4] 	listener: Deno.Listener,
2026-05-03 13:03:39 [deepseek-v4] 	name: string,
2026-05-03 13:03:39 [deepseek-v4] 	port: number
2026-05-03 13:03:39 [deepseek-v4] ): Promise<{connection: Deno.TcpConn, name: string, port: number}> {
2026-05-03 13:03:39 [deepseek-v4] 	const connection = await listener.accept();
2026-05-03 13:03:39 [deepseek-v4] 	// Re‑arm immediately for the next connection (one per listener)
2026-05-03 13:03:39 [deepseek-v4] 	switch (name) {
2026-05-03 13:03:39 [deepseek-v4] 		case "sloppy": sloppyAcceptPromise = acceptFromListener(listener, name, port); break;
2026-05-03 13:03:39 [deepseek-v4] 		case "riff":   riffAcceptPromise   = acceptFromListener(listener, name, port); break;
2026-05-03 13:03:39 [deepseek-v4] 		case "foggy":  foggyAcceptPromise  = acceptFromListener(listener, name, port); break;
2026-05-03 13:03:39 [deepseek-v4] 	}
2026-05-03 13:03:39 [deepseek-v4] 	return { connection, name, port };
2026-05-03 13:03:39 [deepseek-v4] }
