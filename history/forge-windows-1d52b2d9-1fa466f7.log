2026-05-05 10:32:10 [deepseek-v4] if (response.messages) {
2026-05-05 10:32:10 [deepseek-v4] 	const messages = response.messages;
2026-05-05 10:32:10 [deepseek-v4] 	for (const m of messages) {
2026-05-05 10:32:10 [deepseek-v4] 		// ...
