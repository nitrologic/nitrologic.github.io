2026-05-07 15:07:42 [gemini-3.1-lite]     }
2026-05-07 15:07:42 [gemini-3.1-lite]     pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 9, true);
2026-05-07 15:07:42 [gemini-3.1-lite] 
2026-05-07 15:07:42 [gemini-3.1-lite]     // Set shift to pull automatically when OSR is empty
2026-05-07 15:07:42 [gemini-3.1-lite]     sm_config_set_out_shift(&c, true, true, 32);
2026-05-07 15:07:42 [gemini-3.1-lite] 
