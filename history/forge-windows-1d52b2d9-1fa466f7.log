2026-05-03 13:03:38 [deepseek-v4] // Global accept promises
2026-05-03 13:03:38 [deepseek-v4] let sloppyAcceptPromise: Promise<{connection: Deno.TcpConn, name: string, port: number}> | null = null;
2026-05-03 13:03:38 [deepseek-v4] let riffAcceptPromise: Promise<{connection: Deno.TcpConn, name: string, port: number}> | null = null;
2026-05-03 13:03:38 [deepseek-v4] let foggyAcceptPromise: Promise<{connection: Deno.TcpConn, name: string, port: number}> | null = null;
2026-05-03 13:03:38 [deepseek-v4] 
2026-05-03 13:03:38 [deepseek-v4] // Replaces old listenService
2026-05-03 13:03:38 [deepseek-v4] export function listenService(): void {
2026-05-03 13:03:38 [deepseek-v4] 	if (sloppyListener) return; // already listening
