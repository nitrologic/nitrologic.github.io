2026-05-03 16:18:05 [deepseek-v4] 		slopListener[port].accept().then(conn => ({ port, conn }))
2026-05-03 16:18:05 [deepseek-v4] 	);
2026-05-03 16:18:05 [deepseek-v4] 	while (true) {
