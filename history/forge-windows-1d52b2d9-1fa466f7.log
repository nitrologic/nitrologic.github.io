2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] Then build `race` as:
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] const race: Promise<any>[] = [
2026-05-03 13:06:04 [deepseek-v4] 	readPromise,
2026-05-03 13:06:04 [deepseek-v4] 	timerPromise,
2026-05-03 13:06:04 [deepseek-v4] 	...acceptPromises,
2026-05-03 13:06:04 [deepseek-v4] 	...Object.values(receivePromises)
2026-05-03 13:06:04 [deepseek-v4] ];
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] When a winner is a connection, handle it exactly as before:
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] if (winner.connection) {
2026-05-03 13:06:04 [deepseek-v4] 	const { connection, name } = winner;
2026-05-03 13:06:04 [deepseek-v4] 	slopConnections.set(name, connection);
2026-05-03 13:06:04 [deepseek-v4] 	const receiver = readNamedConnection(name, connection);
2026-05-03 13:06:04 [deepseek-v4] 	receivePromises[name] = receiver;
2026-05-03 13:06:04 [deepseek-v4] 	continue;
2026-05-03 13:06:04 [deepseek-v4] }
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] 
2026-05-03 13:06:04 [deepseek-v4] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
