2026-05-15 13:38:31 [claude-haiku-4-5] 
2026-05-15 13:38:31 [claude-haiku-4-5] void cdcReceiveCallback(void *user) {
2026-05-15 13:38:31 [claude-haiku-4-5]     int c = getchar_timeout_us(0);
2026-05-15 13:38:31 [claude-haiku-4-5]     while (c != PICO_ERROR_TIMEOUT) {
2026-05-15 13:38:31 [claude-haiku-4-5]         if (c == 10) {  // Newline
2026-05-15 13:38:31 [claude-haiku-4-5]             lines.push_back(std::string(buffer, charCount));
2026-05-15 13:38:31 [claude-haiku-4-5]             charCount = 0;
