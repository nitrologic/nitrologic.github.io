2026-05-15 13:38:29 [claude-haiku-4-5] 
2026-05-15 13:38:29 [claude-haiku-4-5] void vid_fieldi(int field) {
2026-05-15 13:38:29 [claude-haiku-4-5]     if (field & 1) {
2026-05-15 13:38:29 [claude-haiku-4-5]         dma_channel_set_trans_count(video_dma_chan, oddWords, false);
2026-05-15 13:38:29 [claude-haiku-4-5]         dma_channel_set_read_addr(video_dma_chan, oddFrame, true);
2026-05-15 13:38:29 [claude-haiku-4-5]         // WST updates
2026-05-15 13:38:29 [claude-haiku-4-5]     } else {
2026-05-15 13:38:29 [claude-haiku-4-5]         dma_channel_set_trans_count(video_dma_chan, evenWords, false);
2026-05-15 13:38:29 [claude-haiku-4-5]         dma_channel_set_read_addr(video_dma_chan, evenFrame, true);
2026-05-15 13:38:29 [claude-haiku-4-5]         // WST updates
2026-05-15 13:38:29 [claude-haiku-4-5]     }
2026-05-15 13:38:29 [claude-haiku-4-5] }
