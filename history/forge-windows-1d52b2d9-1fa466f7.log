2026-05-03 13:03:39 [deepseek-v4] 
2026-05-03 13:03:39 [deepseek-v4] 
2026-05-03 13:03:39 [deepseek-v4] // Inside slopPrompt, replace the race construction:
2026-05-03 13:03:39 [deepseek-v4] const race: Promise<any>[] = [readPromise, timerPromise];
2026-05-03 13:03:39 [deepseek-v4] if (listenerPromise) {
2026-05-03 13:03:39 [deepseek-v4] 	race.push(listenerPromise);
2026-05-03 13:03:39 [deepseek-v4] }
2026-05-03 13:03:39 [deepseek-v4] // Instead, collect all accept promises that are alive:
2026-05-03 13:03:39 [deepseek-v4] const acceptPromises: Promise<{connection: Deno.TcpConn, name: string, port: number}>[] = [];
2026-05-03 13:03:39 [deepseek-v4] if (sloppyAcceptPromise) acceptPromises.push(sloppyAcceptPromise);
2026-05-03 13:03:39 [deepseek-v4] if (riffAcceptPromise)   acceptPromises.push(riffAcceptPromise);
2026-05-03 13:03:39 [deepseek-v4] if (foggyAcceptPromise)  acceptPromises.push(foggyAcceptPromise);
2026-05-03 13:03:39 [deepseek-v4] 
2026-05-03 13:03:39 [deepseek-v4] race.push(...acceptPromises);
2026-05-03 13:03:39 [deepseek-v4] // Also keep the existing receivers
2026-05-03 13:03:39 [deepseek-v4] race.push(...Object.values(receivePromises));
2026-05-03 13:03:39 [deepseek-v4] 
2026-05-03 13:03:39 [deepseek-v4] winner = await Promise.race(race);
