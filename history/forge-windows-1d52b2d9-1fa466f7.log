2026-05-03 10:18:42 [deepseek-v4] Replace the main loop with a simpler approach:
2026-05-03 10:18:42 [deepseek-v4] 
2026-05-03 10:18:42 [deepseek-v4] 
2026-05-03 10:18:42 [deepseek-v4] async function run() {
2026-05-03 10:18:42 [deepseek-v4]   await connectFountain(portNumber);
2026-05-03 10:18:42 [deepseek-v4]   writeFountain("{\"action\":\"connect\"}");
2026-05-03 10:18:42 [deepseek-v4]   // Read fountain continuously without blocking the event loop
2026-05-03 10:18:43 [deepseek-v4]   (async () => {
2026-05-03 10:18:43 [deepseek-v4]     while (true) {
2026-05-03 10:18:43 [deepseek-v4]       const result = await readFountain();
2026-05-03 10:18:43 [deepseek-v4]       if (result == null) break;
2026-05-03 10:18:43 [deepseek-v4]       await onFountain(result.message);
2026-05-03 10:18:43 [deepseek-v4]     }
2026-05-03 10:18:43 [deepseek-v4]   })();
2026-05-03 10:18:43 [deepseek-v4]   // Wait for SIGINT to exit
2026-05-03 10:18:43 [deepseek-v4]   await initSystem();
2026-05-03 10:18:43 [deepseek-v4] }
2026-05-03 10:18:43 [deepseek-v4] 
2026-05-03 10:18:43 [deepseek-v4] 
2026-05-03 10:18:43 [deepseek-v4] This keeps the Discord event loop free. You can still react to `SIGINT` from the main function.
