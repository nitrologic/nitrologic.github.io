2026-05-07 18:11:08 [gemini-3.1-lite] 	nop [31] ; 32 cycles
2026-05-07 18:11:08 [gemini-3.1-lite] 	nop [31] ; 32 cycles
2026-05-07 18:11:08 [gemini-3.1-lite] 	irq	set 4
