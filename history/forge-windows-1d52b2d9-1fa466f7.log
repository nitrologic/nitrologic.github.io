2026-05-05 10:32:10 [deepseek-v4] 			const content = m.message.content || m.message.message || JSON.stringify(m.message) || "<nocontent>";
2026-05-05 10:32:10 [deepseek-v4] 			lines.push(content);
2026-05-05 10:32:10 [deepseek-v4] 			logForge(content, m.from);  // ← logs but not echoed to console
2026-05-05 10:32:10 [deepseek-v4] 		}
2026-05-05 10:32:10 [deepseek-v4] 	}
2026-05-05 10:32:10 [deepseek-v4] 	break;
2026-05-05 10:32:10 [deepseek-v4] }
