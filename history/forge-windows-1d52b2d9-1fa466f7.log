2026-05-12 16:27:36 [gemini-3.1-pro] 		&c,
2026-05-12 16:27:36 [gemini-3.1-pro] 		&pio->txf[sm],
2026-05-12 16:27:36 [gemini-3.1-pro] 		NULL,             // Will be set by the control channel
2026-05-12 16:27:36 [gemini-3.1-pro] 		0,                // Will be set by the control channel
2026-05-12 16:27:36 [gemini-3.1-pro] 		false
2026-05-12 16:27:36 [gemini-3.1-pro] 	);
