2026-06-24 12:03:49 [glm-5.2]  ꔀ Relay 1.9.4 glm-5.2 Z 🪠 0.7° $0.092 28.42KB 172.87s
2026-06-24 12:03:49 [glm-5.2] Here is a basic, clean implementation for a Thumb-2 disassembler. It handles the most common 16-bit
2026-06-24 12:03:49 [glm-5.2] instructions (T1-T18) and the 32-bit branch/move instructions defined in your `thumb2.h`.
2026-06-24 12:03:49 [glm-5.2] 
2026-06-24 12:03:49 [glm-5.2] You can save this as `thumb2_disasm.h` and include it in `elfutil.cpp`.
2026-06-24 12:03:49 [glm-5.2] 
2026-06-24 12:03:49 [glm-5.2] 
2026-06-24 12:03:49 [glm-5.2] // thumb2_disasm.h
2026-06-24 12:03:49 [glm-5.2] #pragma once
2026-06-24 12:03:49 [glm-5.2] 
2026-06-24 12:03:49 [glm-5.2] #include <cstdint>
2026-06-24 12:03:49 [glm-5.2] #include <string>
2026-06-24 12:03:49 [glm-5.2] #include <iostream>
2026-06-24 12:03:49 [glm-5.2] #include <cstdio>
2026-06-24 12:03:49 [glm-5.2] 
2026-06-24 12:03:49 [glm-5.2] std::string get_reg_name(int r) {
2026-06-24 12:03:49 [glm-5.2] 	switch (r) {
2026-06-24 12:03:49 [glm-5.2] 		case 13: return "SP";
2026-06-24 12:03:49 [glm-5.2] 		case 14: return "LR";
2026-06-24 12:03:49 [glm-5.2] 		case 15: return "PC";
2026-06-24 12:03:49 [glm-5.2] 		default: return "R" + std::to_string(r);
2026-06-24 12:03:49 [glm-5.2] 	}
2026-06-24 12:03:49 [glm-5.2] }
2026-06-24 12:03:49 [glm-5.2] 
2026-06-24 12:03:49 [glm-5.2] std::string format_reg_list(int rlist) {
2026-06-24 12:03:49 [glm-5.2] 	std::string s = "{";
2026-06-24 12:03:49 [glm-5.2] 	bool first = true;
2026-06-24 12:03:49 [glm-5.2] 	for (int i = 0; i < 16; i++) {
2026-06-24 12:03:49 [glm-5.2] 		if (rlist & (1 << i)) {
2026-06-24 12:03:50 [glm-5.2] 			if (!first) s += ", ";
2026-06-24 12:03:50 [glm-5.2] 			s += get_reg_name(i);
2026-06-24 12:03:50 [glm-5.2] 			first = false;
2026-06-24 12:03:50 [glm-5.2] 		}
2026-06-24 12:03:50 [glm-5.2] 	}
2026-06-24 12:03:50 [glm-5.2] 	s += "}";
2026-06-24 12:03:50 [glm-5.2] 	return s;
2026-06-24 12:03:50 [glm-5.2] }
2026-06-24 12:03:50 [glm-5.2] 
2026-06-24 12:03:50 [glm-5.2] std::string disasm_16bit(uint16_t code, uint32_t addr) {
2026-06-24 12:03:50 [glm-5.2] 	int rd = code & 7;
2026-06-24 12:03:50 [glm-5.2] 	int rs = (code >> 3) & 7;
2026-06-24 12:03:50 [glm-5.2] 	int ro = (code >> 6) & 7;
2026-06-24 12:03:50 [glm-5.2] 	int imm5 = (code >> 6) & 0x1f;
2026-06-24 12:03:50 [glm-5.2] 	int imm8 = code & 0xff;
2026-06-24 12:03:50 [glm-5.2] 	int d4 = (code & 7) | (((code >> 7) & 1) << 3);
2026-06-24 12:03:50 [glm-5.2] 	int s4 = (code >> 3) & 7;
2026-06-24 12:03:50 [glm-5.2] 	char buf[128];
2026-06-24 12:03:50 [glm-5.2] 
