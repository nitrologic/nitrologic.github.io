2026-06-24 14:12:57 [kimi-k2.7-code] Here is a small bitwise CRC-32 implementation that should compile to a dense mix of Thumb-2
2026-06-24 14:12:57 [kimi-k2.7-code] logical, shift, and branch instructions. It is intentionally plain C so the symbol remains visible
2026-06-24 14:12:57 [kimi-k2.7-code] and the loop body is easy to follow in the disassembly.
2026-06-24 14:12:57 [kimi-k2.7-code] 
2026-06-24 14:12:57 [kimi-k2.7-code] 
2026-06-24 14:12:57 [kimi-k2.7-code] #include <stdint.h>
2026-06-24 14:12:57 [kimi-k2.7-code] #include <stddef.h>
2026-06-24 14:12:57 [kimi-k2.7-code] 
2026-06-24 14:12:57 [kimi-k2.7-code] uint32_t crc32_update(uint32_t crc, uint8_t byte)
2026-06-24 14:12:57 [kimi-k2.7-code] {
2026-06-24 14:12:57 [kimi-k2.7-code] 	crc ^= byte;
2026-06-24 14:12:57 [kimi-k2.7-code] 	for (int bit = 0; bit < 8; ++bit)
2026-06-24 14:12:57 [kimi-k2.7-code] 	{
2026-06-24 14:12:57 [kimi-k2.7-code] 		int lsb = crc & 1u;
2026-06-24 14:12:57 [kimi-k2.7-code] 		crc >>= 1;
2026-06-24 14:12:57 [kimi-k2.7-code] 		if (lsb)
2026-06-24 14:12:57 [kimi-k2.7-code] 		{
2026-06-24 14:12:57 [kimi-k2.7-code] 			crc ^= 0xEDB88320u;
2026-06-24 14:12:57 [kimi-k2.7-code] 		}
2026-06-24 14:12:57 [kimi-k2.7-code] 	}
2026-06-24 14:12:57 [kimi-k2.7-code] 	return crc;
2026-06-24 14:12:57 [kimi-k2.7-code] }
2026-06-24 14:12:57 [kimi-k2.7-code] 
2026-06-24 14:12:58 [kimi-k2.7-code] uint32_t crc32_buffer(const uint8_t* data, size_t length)
2026-06-24 14:12:58 [kimi-k2.7-code] {
2026-06-24 14:12:58 [kimi-k2.7-code] 	uint32_t crc = 0xFFFFFFFFu;
2026-06-24 14:12:58 [kimi-k2.7-code] 	for (size_t i = 0; i < length; ++i)
2026-06-24 14:12:58 [kimi-k2.7-code] 	{
2026-06-24 14:12:58 [kimi-k2.7-code] 		crc = crc32_update(crc, data[i]);
2026-06-24 14:12:58 [kimi-k2.7-code] 	}
2026-06-24 14:12:58 [kimi-k2.7-code] 	return crc ^ 0xFFFFFFFFu;
2026-06-24 14:12:58 [kimi-k2.7-code] }
2026-06-24 14:12:58 [kimi-k2.7-code] 
2026-06-24 14:12:58 [kimi-k2.7-code] 
2026-06-24 14:12:58 [kimi-k2.7-code] Notes:
2026-06-24 14:12:58 [kimi-k2.7-code] 
