2025-08-05 13:31:58 [deepseek-chat]     for (let i = 0; i < size; i += 16) {
2025-08-05 13:31:58 [deepseek-chat]         const st_name  = view.getUint32(offset + i, true);
2025-08-05 13:31:58 [deepseek-chat]         const st_value = view.getUint32(offset + i + 4, true);
2025-08-05 13:31:58 [deepseek-chat]         const st_size = view.getUint32(offset + i + 8, true);
2025-08-05 13:31:58 [deepseek-chat]         const st_info = view.getUint8(offset + i + 12);
2025-08-05 13:31:58 [deepseek-chat]         // Get symbol name
2025-08-05 13:31:58 [deepseek-chat]         let name = '';
2025-08-05 13:31:58 [deepseek-chat]         if (st_name) {
2025-08-05 13:31:58 [deepseek-chat]             for (let j = st_name; ; j++) {
