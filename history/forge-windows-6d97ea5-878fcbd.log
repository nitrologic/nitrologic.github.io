2025-08-09 11:15:15 [claude-sonnet-4] I've created a script that mimics DOS `dir /b` but outputs all filenames on a single line,
2025-08-09 11:15:15 [claude-sonnet-4] separated by spaces. Here's the code:
2025-08-09 11:15:15 [claude-sonnet-4] const fs = require('fs');
2025-08-09 11:15:15 [claude-sonnet-4] const path = require('path');
2025-08-09 11:15:15 [claude-sonnet-4] function skid(directory = '.') {
2025-08-09 11:15:15 [claude-sonnet-4] 	try {
2025-08-09 11:15:15 [claude-sonnet-4] 		const files = fs.readdirSync(directory);
2025-08-09 11:15:15 [claude-sonnet-4] 		console.log(files.join(' '));
2025-08-09 11:15:15 [claude-sonnet-4] 	} catch (error) {
2025-08-09 11:15:15 [claude-sonnet-4] 		console.error(`Cannot access '${directory}': ${error.message}`);
2025-08-09 11:15:15 [claude-sonnet-4] 		process.exit(1);
2025-08-09 11:15:15 [claude-sonnet-4] 	}
2025-08-09 11:15:15 [claude-sonnet-4] }
2025-08-09 11:15:15 [claude-sonnet-4] // Get directory from command line argument or use current directory
2025-08-09 11:15:15 [claude-sonnet-4] const targetDir = process.argv[2] || '.';
