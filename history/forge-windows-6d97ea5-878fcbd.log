2025-08-14 08:58:02 [kimi-k2-0711] function using a message channel approach:
2025-08-14 08:58:02 [kimi-k2-0711] // Add near the top
2025-08-14 08:58:02 [kimi-k2-0711] let relayTaskPromise: Promise<void> | null = null;
2025-08-14 08:58:02 [kimi-k2-0711] let completionQueue: string[] = [];
2025-08-14 08:58:02 [kimi-k2-0711] const completionChan = new (Deno as any).Core ? (Deno as any).Core.opPing : function(){}; // Fallback
2025-08-14 08:58:02 [kimi-k2-0711] async function relayAsync() {
2025-08-14 08:58:02 [kimi-k2-0711]     const send = () => {
2025-08-14 08:58:02 [kimi-k2-0711]         if (completionQueue.length === 0) return;
2025-08-14 08:58:02 [kimi-k2-0711]         const text = completionQueue.shift();
2025-08-14 08:58:02 [kimi-k2-0711]         rohaHistory.push({role:"assistant", content:text});
2025-08-14 08:58:02 [kimi-k2-0711]         flush();
2025-08-14 08:58:02 [kimi-k2-0711]     };
2025-08-14 08:58:02 [kimi-k2-0711]     const spend = await relay(0);
2025-08-14 08:58:02 [kimi-k2-0711]     completionQueue.push("completion ready");
2025-08-14 08:58:02 [kimi-k2-0711]     setImmediate(send);
2025-08-14 08:58:02 [kimi-k2-0711] }
2025-08-14 08:58:02 [kimi-k2-0711] // In your chat loop, replace await relay(0) with:
2025-08-14 08:58:02 [kimi-k2-0711] if (!relayTaskPromise) {
2025-08-14 08:58:02 [kimi-k2-0711]     relayTaskPromise = relayAsync();
2025-08-14 08:58:02 [kimi-k2-0711] } else {
2025-08-14 08:58:02 [kimi-k2-0711]     if (completionQueue.length > 0) {
2025-08-14 08:58:02 [kimi-k2-0711]         completionQueue.shift();
2025-08-14 08:58:02 [kimi-k2-0711]         relayTaskPromise = null;
2025-08-14 08:58:02 [kimi-k2-0711]     }
2025-08-14 08:58:02 [kimi-k2-0711] }
2025-08-14 08:58:02 [kimi-k2-0711] This keeps the prompt responsive while relay runs in the background, with results appearing as
2025-08-14 08:58:02 [kimi-k2-0711] they're ready.
