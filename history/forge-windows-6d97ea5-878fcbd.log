2025-08-05 13:31:58 [deepseek-chat] function parseSymbolTable(view, offset, size, elfData, shoff, shentsize) {
2025-08-05 13:31:58 [deepseek-chat]     const symbols = [];
2025-08-05 13:31:58 [deepseek-chat]     const strtab_offset = /* ... find linked string table ... */;
