2025-08-20 08:51:10 [deepseek-chat]   "F5": "\u001B[15~",
2025-08-20 08:51:10 [deepseek-chat]   "F6": "\u001B[17~",
2025-08-20 08:51:10 [deepseek-chat]   "F7": "\u001B[18~",
2025-08-20 08:51:10 [deepseek-chat]   "F8": "\u001B[19~",
2025-08-20 08:51:10 [deepseek-chat]   "F9": "\u001B[20~",
