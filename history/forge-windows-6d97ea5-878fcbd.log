2025-08-19 09:32:17 [gemini-2.5-flash] runtimes, but you can achieve simple wildcard support using JavaScript's native `RegExp` (Regular
2025-08-19 09:32:17 [gemini-2.5-flash] Expressions).
2025-08-19 09:32:17 [gemini-2.5-flash] Here's how you can modify your `sharePath` function to support simple `` wildcards, where
2025-08-19 09:32:17 [gemini-2.5-flash] `` matches any sequence of characters:
2025-08-19 09:32:17 [gemini-2.5-flash] function sharePath(paths: string[], path: string): boolean {
2025-08-19 09:32:18 [gemini-2.5-flash]   const patternToRegExp = (pattern: string): RegExp => {
2025-08-19 09:32:18 [gemini-2.5-flash]     // Escape special regex characters in the pattern, except for '*'
2025-08-19 09:32:18 [gemini-2.5-flash]     const escapedPattern = pattern.replace(/[.+?^${}()|[\]\\]/g, '\\$&');
2025-08-19 09:32:18 [gemini-2.5-flash]     // Replace '*' with '.*' to match any character zero or more times
2025-08-19 09:32:18 [gemini-2.5-flash]     const regexString = '^' + escapedPattern.replace(/\*/g, '.*') + '$';
2025-08-19 09:32:18 [gemini-2.5-flash]     return new RegExp(regexString);
2025-08-19 09:32:18 [gemini-2.5-flash]   };
2025-08-19 09:32:18 [gemini-2.5-flash]   for (const pattern of paths) {
2025-08-19 09:32:18 [gemini-2.5-flash]     const regex = patternToRegExp(pattern);
2025-08-19 09:32:18 [gemini-2.5-flash]     if (regex.test(path)) {
2025-08-19 09:32:18 [gemini-2.5-flash]       return true;
2025-08-19 09:32:18 [gemini-2.5-flash]     }
2025-08-19 09:32:18 [gemini-2.5-flash]   }
2025-08-19 09:32:18 [gemini-2.5-flash]   return false;
2025-08-19 09:32:18 [gemini-2.5-flash] }
