2025-08-08 12:00:36 [claude-sonnet-4] Hi! To recognize if a file is plain text in Deno, you can use several approaches. Here are the most
2025-08-08 12:00:36 [claude-sonnet-4] effective methods:
2025-08-08 12:00:36 [claude-sonnet-4] Method 1: Check file extension
2025-08-08 12:00:36 [claude-sonnet-4] function isTextFileByExtension(filename) {
2025-08-08 12:00:36 [claude-sonnet-4] 	const textExtensions = [
2025-08-08 12:00:36 [claude-sonnet-4] 		'.txt', '.md', '.js', '.ts', '.json', '.html', '.css', '.xml',
2025-08-08 12:00:36 [claude-sonnet-4] 		'.csv', '.log', '.ini', '.cfg', '.yml', '.yaml', '.toml'
2025-08-08 12:00:36 [claude-sonnet-4] 	];
2025-08-08 12:00:36 [claude-sonnet-4] 	return textExtensions.some(ext => filename.toLowerCase().endsWith(ext));
2025-08-08 12:00:36 [claude-sonnet-4] }
2025-08-08 12:00:36 [claude-sonnet-4] Method 2: Detect binary content by reading bytes
2025-08-08 12:00:36 [claude-sonnet-4] async function isTextFile(filePath) {
2025-08-08 12:00:36 [claude-sonnet-4] 	try {
2025-08-08 12:00:36 [claude-sonnet-4] 		const file = await Deno.open(filePath, { read: true });
2025-08-08 12:00:36 [claude-sonnet-4] 		const buffer = new Uint8Array(1024); // Read first 1KB
2025-08-08 12:00:36 [claude-sonnet-4] 		const bytesRead = await file.read(buffer);
2025-08-08 12:00:36 [claude-sonnet-4] 		file.close();
2025-08-08 12:00:36 [claude-sonnet-4] 		if (bytesRead === null) return true; // Empty file
2025-08-08 12:00:36 [claude-sonnet-4] 		// Check for null bytes (common in binary files)
2025-08-08 12:00:36 [claude-sonnet-4] 		for (let i = 0; i < bytesRead; i++) {
2025-08-08 12:00:36 [claude-sonnet-4] 			if (buffer[i] === 0) return false;
2025-08-08 12:00:36 [claude-sonnet-4] 		}
2025-08-08 12:00:36 [claude-sonnet-4] 		// Check for high percentage of printable ASCII characters
2025-08-08 12:00:36 [claude-sonnet-4] 		let printableCount = 0;
2025-08-08 12:00:36 [claude-sonnet-4] 		for (let i = 0; i < bytesRead; i++) {
2025-08-08 12:00:36 [claude-sonnet-4] 			const byte = buffer[i];
2025-08-08 12:00:36 [claude-sonnet-4] 			if ((byte >= 32 && byte <= 126) || byte === 9 || byte === 10 || byte === 13) {
2025-08-08 12:00:36 [claude-sonnet-4] 				printableCount++;
2025-08-08 12:00:36 [claude-sonnet-4] 			}
2025-08-08 12:00:36 [claude-sonnet-4] 		}
2025-08-08 12:00:36 [claude-sonnet-4] 		return (printableCount / bytesRead) > 0.85; // 85% printable threshold
2025-08-08 12:00:36 [claude-sonnet-4] 	} catch (error) {
2025-08-08 12:00:36 [claude-sonnet-4] 		console.error('Error reading file:', error);
2025-08-08 12:00:36 [claude-sonnet-4] 		return false;
2025-08-08 12:00:36 [claude-sonnet-4] 	}
2025-08-08 12:00:36 [claude-sonnet-4] }
2025-08-08 12:00:36 [claude-sonnet-4] Method 3: Combined approach
2025-08-08 12:00:36 [claude-sonnet-4] async function detectTextFile(filePath) {
2025-08-08 12:00:36 [claude-sonnet-4] 	// First check extension
2025-08-08 12:00:36 [claude-sonnet-4] 	if (isTextFileByExtension(filePath)) {
2025-08-08 12:00:36 [claude-sonnet-4] 		return true;
2025-08-08 12:00:36 [claude-sonnet-4] 	}
2025-08-08 12:00:36 [claude-sonnet-4] 	// Then check content
2025-08-08 12:00:36 [claude-sonnet-4] 	return await isTextFile(filePath);
2025-08-08 12:00:36 [claude-sonnet-4] }
2025-08-08 12:00:36 [claude-sonnet-4] The content-based detection is more reliable for the Anthropic API since it actually examines the
2025-08-08 12:00:36 [claude-sonnet-4] file data. Would you like me to help you integrate this with your specific use case?
2025-08-08 12:01:12 [nitro@ryzen5] what is linux standard for say a file named LICENSE
2025-08-08 12:01:21 [claude-sonnet-4] In Linux, a file named `LICENSE` (without extension) is considered a plain text file by standard
2025-08-08 12:01:21 [claude-sonnet-4] convention. Here are the key points:
2025-08-08 12:01:21 [claude-sonnet-4] Linux File Type Detection Standards
2025-08-08 12:01:21 [claude-sonnet-4] • By convention:*
2025-08-08 12:01:21 [claude-sonnet-4] - `LICENSE` files are always plain text
2025-08-08 12:01:21 [claude-sonnet-4] - Other common extensionless text files: `README`, `CHANGELOG`, `COPYING`, `AUTHORS`, `INSTALL`
2025-08-08 12:01:21 [claude-sonnet-4] • System tools recognize these:*
2025-08-08 12:01:21 [claude-sonnet-4] file LICENSE          # Usually shows "ASCII text" or "UTF-8 text"
2025-08-08 12:01:21 [claude-sonnet-4] mimetype LICENSE      # Shows "text/plain"
2025-08-08 12:01:21 [claude-sonnet-4] Updated detection for Deno:
2025-08-08 12:01:21 [claude-sonnet-4] function isTextFileByConvention(filename) {
2025-08-08 12:01:21 [claude-sonnet-4] 	const baseName = filename.split('/').pop().toUpperCase();
2025-08-08 12:01:21 [claude-sonnet-4] 	// Common plain text files without extensions
2025-08-08 12:01:21 [claude-sonnet-4] 	const textFiles = [
2025-08-08 12:01:21 [claude-sonnet-4] 		'LICENSE', 'README', 'CHANGELOG', 'COPYING', 'AUTHORS',
2025-08-08 12:01:21 [claude-sonnet-4] 		'INSTALL', 'NEWS', 'TODO', 'CONTRIBUTORS', 'NOTICE',
2025-08-08 12:01:21 [claude-sonnet-4] 		'CREDITS', 'THANKS', 'HISTORY', 'MANIFEST'
2025-08-08 12:01:21 [claude-sonnet-4] 	];
2025-08-08 12:01:21 [claude-sonnet-4] 	if (textFiles.includes(baseName)) return true;
2025-08-08 12:01:21 [claude-sonnet-4] 	// Standard extensions
2025-08-08 12:01:21 [claude-sonnet-4] 	const textExtensions = [
2025-08-08 12:01:21 [claude-sonnet-4] 		'.txt', '.md', '.js', '.ts', '.json', '.html', '.css',
2025-08-08 12:01:21 [claude-sonnet-4] 		'.xml', '.csv', '.log', '.ini', '.cfg', '.yml', '.yaml'
2025-08-08 12:01:21 [claude-sonnet-4] 	];
2025-08-08 12:01:21 [claude-sonnet-4] 	return textExtensions.some(ext => filename.toLowerCase().endsWith(ext));
2025-08-08 12:01:21 [claude-sonnet-4] }
2025-08-08 12:01:21 [claude-sonnet-4] So yes, `LICENSE` files should definitely be treated as plain text for the Anthropic API. The Linux
2025-08-08 12:01:21 [claude-sonnet-4] `file` command and MIME type detection will confirm this.
