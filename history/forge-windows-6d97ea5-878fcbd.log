2025-08-16 11:24:59 [deepseek-chat]     }
2025-08-16 11:24:59 [deepseek-chat]     // Calculate new index
2025-08-16 11:24:59 [deepseek-chat]     const newIndex = Math.max(-1,
2025-08-16 11:24:59 [deepseek-chat]         Math.min(historyIndex + (direction === 'up' ? 1 : -1),
2025-08-16 11:24:59 [deepseek-chat]                 history.length - 1));
2025-08-16 11:24:59 [deepseek-chat]     if (newIndex === historyIndex) return;
2025-08-16 11:24:59 [deepseek-chat]     historyIndex = newIndex;
2025-08-16 11:24:59 [deepseek-chat]     // Get the history item or current input
2025-08-16 11:24:59 [deepseek-chat]     const displayText = historyIndex >= 0
2025-08-16 11:24:59 [deepseek-chat]         ? history[historyIndex]
2025-08-16 11:24:59 [deepseek-chat]         : currentInput;
2025-08-16 11:24:59 [deepseek-chat]     // ANSI sequence to:
2025-08-16 11:24:59 [deepseek-chat]     // 1. Move to start of line
2025-08-16 11:24:59 [deepseek-chat]     // 2. Clear line
2025-08-16 11:24:59 [deepseek-chat]     // 3. Write new content
2025-08-16 11:24:59 [deepseek-chat]     await writer.write(encoder.encode(
2025-08-16 11:24:59 [deepseek-chat]         '\r' + CLEAR_LINE + displayText
2025-08-16 11:24:59 [deepseek-chat]     ));
2025-08-16 11:24:59 [deepseek-chat]     // Update our buffer
2025-08-16 11:24:59 [deepseek-chat]     promptBuffer = encoder.encode(displayText);
2025-08-16 11:25:00 [deepseek-chat] }
