2025-08-05 13:31:58 [deepseek-chat]                 if (!char) break;
2025-08-05 13:31:58 [deepseek-chat]                 name += String.fromCharCode(char);
2025-08-05 13:31:58 [deepseek-chat]             }
2025-08-05 13:31:58 [deepseek-chat]         }
2025-08-05 13:31:58 [deepseek-chat]         symbols.push({
2025-08-05 13:31:58 [deepseek-chat]             name,
2025-08-05 13:31:58 [deepseek-chat]             value: st_value,
2025-08-05 13:31:58 [deepseek-chat]             size: st_size,
2025-08-05 13:31:58 [deepseek-chat]             type: st_info & 0xF,
2025-08-05 13:31:58 [deepseek-chat]             binding: st_info >> 4
2025-08-05 13:31:58 [deepseek-chat]         });
2025-08-05 13:31:58 [deepseek-chat]     }
2025-08-05 13:31:58 [deepseek-chat]     return symbols;
2025-08-05 13:31:58 [deepseek-chat] }
