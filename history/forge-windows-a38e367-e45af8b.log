2025-10-30 19:46:26 [kimi-k2-0905] [kimi-k2-0905] To switch between the front and back camera in your DSPTool video section, add a
2025-10-30 19:46:26 [kimi-k2-0905] simple toggle that re-requests the media stream with the desired `facingMode`. Drop this small
2025-10-30 19:46:26 [kimi-k2-0905] patch into `dspvideo.js` after the existing `enumerateVideo()` function:
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] // ---- camera switcher ----
2025-10-30 19:46:26 [kimi-k2-0905] var currentFacing = 'environment';          // start with back camera
2025-10-30 19:46:26 [kimi-k2-0905] var videoTrack = null;                      // hold the current video track
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] function switchCamera() {
2025-10-30 19:46:26 [kimi-k2-0905]   if (videoStreamer && videoStreamer.mediaStreams.length) {
2025-10-30 19:46:26 [kimi-k2-0905]     // stop only the video track so we can re-acquire with new constraint
2025-10-30 19:46:26 [kimi-k2-0905]     const stream = videoStreamer.mediaStreams[0];
2025-10-30 19:46:26 [kimi-k2-0905]     videoTrack = stream.getVideoTracks()[0];
2025-10-30 19:46:26 [kimi-k2-0905]     if (videoTrack) videoTrack.stop();
2025-10-30 19:46:26 [kimi-k2-0905]   }
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905]   currentFacing = (currentFacing === 'environment') ? 'user' : 'environment';
2025-10-30 19:46:26 [kimi-k2-0905]   const constraints = {
2025-10-30 19:46:26 [kimi-k2-0905]     video: { deviceId: undefined, facingMode: currentFacing },
2025-10-30 19:46:26 [kimi-k2-0905]     audio: true
2025-10-30 19:46:26 [kimi-k2-0905]   };
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905]   navigator.mediaDevices.getUserMedia(constraints)
2025-10-30 19:46:26 [kimi-k2-0905]     .then(stream => {
2025-10-30 19:46:26 [kimi-k2-0905]       // replace the old video track in the existing stream
2025-10-30 19:46:26 [kimi-k2-0905]       const oldStream = videoStreamer.mediaStreams[0];
2025-10-30 19:46:26 [kimi-k2-0905]       oldStream.removeTrack(oldStream.getVideoTracks()[0]);
2025-10-30 19:46:26 [kimi-k2-0905]       oldStream.addTrack(stream.getVideoTracks()[0]);
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905]       // update the <video> element source
2025-10-30 19:46:26 [kimi-k2-0905]       const vid = document.querySelector('#video video');
2025-10-30 19:46:26 [kimi-k2-0905]       vid.srcObject = null;          // force re-bind
2025-10-30 19:46:26 [kimi-k2-0905]       vid.srcObject = oldStream;
2025-10-30 19:46:26 [kimi-k2-0905]       vid.play();
2025-10-30 19:46:26 [kimi-k2-0905]       log('Switched to ' + currentFacing + ' camera');
2025-10-30 19:46:26 [kimi-k2-0905]     })
2025-10-30 19:46:26 [kimi-k2-0905]     .catch(err => log('switchCamera: ' + err));
2025-10-30 19:46:26 [kimi-k2-0905] }
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] // add a button in initVideo()
2025-10-30 19:46:26 [kimi-k2-0905] function initVideo() {
2025-10-30 19:46:26 [kimi-k2-0905]   ...
2025-10-30 19:46:26 [kimi-k2-0905]   addTool(videoTools, 'Switch', 'video.switch', switchCamera);
2025-10-30 19:46:26 [kimi-k2-0905]   ...
2025-10-30 19:46:26 [kimi-k2-0905] }
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] Usage:
2025-10-30 19:46:26 [kimi-k2-0905] 1. Load the page, hit “Stream” to start with the back camera.
2025-10-30 19:46:26 [kimi-k2-0905] 2. Hit the new “Switch” button to flip to the front camera; hit again to flip back.
2025-10-30 19:46:26 [kimi-k2-0905] 
2025-10-30 19:46:26 [kimi-k2-0905] The audio track stays alive, so you won’t hear a glitch.
