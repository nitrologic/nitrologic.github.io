2025-10-12 16:17:03 [kimi-k2-0905] 			dstChars.push('\uFFFD');
2025-10-12 16:17:03 [kimi-k2-0905] 			dstBytes.push(b);
2025-10-12 16:17:03 [kimi-k2-0905] 			++i;
2025-10-12 16:17:03 [kimi-k2-0905] 			continue;
2025-10-12 16:17:03 [kimi-k2-0905] 		}
2025-10-12 16:17:03 [kimi-k2-0905] 
2025-10-12 16:17:03 [kimi-k2-0905] 		// Not enough bytes left?  Replace with U+FFFD and move on
2025-10-12 16:17:03 [kimi-k2-0905] 		if (i + need > n) {
2025-10-12 16:17:03 [kimi-k2-0905] 			dstChars.push('\uFFFD');
2025-10-12 16:17:03 [kimi-k2-0905] 			dstBytes.push(b);
2025-10-12 16:17:03 [kimi-k2-0905] 			++i;
2025-10-12 16:17:03 [kimi-k2-0905] 			continue;
2025-10-12 16:17:03 [kimi-k2-0905] 		}
2025-10-12 16:17:03 [kimi-k2-0905] 
2025-10-12 16:17:03 [kimi-k2-0905] 		// Verify continuation bytes
2025-10-12 16:17:03 [kimi-k2-0905] 		let ok = true;
2025-10-12 16:17:03 [kimi-k2-0905] 		for (let j = 1; j < need; ++j) {
