2025-10-12 07:13:32 [kimi-k2-0905] 	tmp.set(carry);
2025-10-12 07:13:32 [kimi-k2-0905] 	tmp.set(chunk, carry.length);
2025-10-12 07:13:32 [kimi-k2-0905] 
2025-10-12 07:13:32 [kimi-k2-0905] 	let end = tmp.length;
2025-10-12 07:13:32 [kimi-k2-0905] 	// back-track to last valid sequence start
