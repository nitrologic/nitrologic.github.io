2025-09-14 06:11:16 [grok-code-fast-1] To post a message with an attachment using Discord.js in Deno, use the `files` array in
2025-09-14 06:11:16 [grok-code-fast-1] `channel.send()` or `message.reply()`. Here's a concise example:
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] import { Client, GatewayIntentBits } from "npm:discord.js@14.14.1";
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] const client = new Client({
2025-09-14 06:11:16 [grok-code-fast-1] 	intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages]
2025-09-14 06:11:16 [grok-code-fast-1] });
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] // Named function to post message with attachment
2025-09-14 06:11:16 [grok-code-fast-1] async function postWithAttachment(channel, messageText, attachmentPath) {
2025-09-14 06:11:16 [grok-code-fast-1] 	try {
2025-09-14 06:11:16 [grok-code-fast-1] 		await channel.send({
2025-09-14 06:11:16 [grok-code-fast-1] 			content: messageText,
2025-09-14 06:11:16 [grok-code-fast-1] 			files: [{
2025-09-14 06:11:16 [grok-code-fast-1] 				attachment: attachmentPath,
2025-09-14 06:11:16 [grok-code-fast-1] 				name: 'filename.txt'  // Optional custom name
2025-09-14 06:11:16 [grok-code-fast-1] 			}]
2025-09-14 06:11:16 [grok-code-fast-1] 		});
2025-09-14 06:11:16 [grok-code-fast-1] 	} catch (error) {
2025-09-14 06:11:16 [grok-code-fast-1] 		console.error('Error posting attachment:', error);
2025-09-14 06:11:16 [grok-code-fast-1] 	}
2025-09-14 06:11:16 [grok-code-fast-1] }
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] client.on("ready", () => {
2025-09-14 06:11:16 [grok-code-fast-1] 	const channel = client.channels.cache.get("YOUR_CHANNEL_ID");
2025-09-14 06:11:16 [grok-code-fast-1] 	if (channel) {
2025-09-14 06:11:16 [grok-code-fast-1] 		postWithAttachment(channel, "Here's your file!", "/path/to/your/file.png");
2025-09-14 06:11:16 [grok-code-fast-1] 	}
2025-09-14 06:11:16 [grok-code-fast-1] });
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] client.login("YOUR_BOT_TOKEN");
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] 
2025-09-14 06:11:16 [grok-code-fast-1] Ensure the file path is accessible, and the bot has permissions. For multiple files, add to the
2025-09-14 06:11:16 [grok-code-fast-1] `files` array. If you need more details, let me know.
