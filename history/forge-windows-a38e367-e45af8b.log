2025-10-12 16:17:03 [kimi-k2-0905] function decodeUtf8Block(src, dstChars, dstBytes) {
2025-10-12 16:17:03 [kimi-k2-0905] 	let i = 0;
2025-10-12 16:17:03 [kimi-k2-0905] 	const n = src.length;
2025-10-12 16:17:03 [kimi-k2-0905] 	while (i < n) {
2025-10-12 16:17:03 [kimi-k2-0905] 		const b = src[i];
2025-10-12 16:17:03 [kimi-k2-0905] 
2025-10-12 16:17:03 [kimi-k2-0905] 		// ASCII fast-path
2025-10-12 16:17:03 [kimi-k2-0905] 		if (b < 0x80) {
2025-10-12 16:17:03 [kimi-k2-0905] 			dstChars.push(String.fromCharCode(b));
2025-10-12 16:17:03 [kimi-k2-0905] 			dstBytes.push(b);
2025-10-12 16:17:03 [kimi-k2-0905] 			++i;
2025-10-12 16:17:03 [kimi-k2-0905] 			continue;
2025-10-12 16:17:03 [kimi-k2-0905] 		}
2025-10-12 16:17:03 [kimi-k2-0905] 
2025-10-12 16:17:03 [kimi-k2-0905] 		// Work out expected sequence length
2025-10-12 16:17:03 [kimi-k2-0905] 		let need = 0;
2025-10-12 16:17:03 [kimi-k2-0905] 		if ((b & 0xE0) === 0xC0) need = 2;
2025-10-12 16:17:03 [kimi-k2-0905] 		else if ((b & 0xF0) === 0xE0) need = 3;
2025-10-12 16:17:03 [kimi-k2-0905] 		else if ((b & 0xF8) === 0xF0) need = 4;
2025-10-12 16:17:03 [kimi-k2-0905] 		else {
