2025-10-12 16:17:04 [kimi-k2-0905] 			}
2025-10-12 16:17:04 [kimi-k2-0905] 		}
2025-10-12 16:17:04 [kimi-k2-0905] 		if (!ok) {
2025-10-12 16:17:04 [kimi-k2-0905] 			dstChars.push('\uFFFD');
2025-10-12 16:17:04 [kimi-k2-0905] 			dstBytes.push(b);
2025-10-12 16:17:04 [kimi-k2-0905] 			++i;
