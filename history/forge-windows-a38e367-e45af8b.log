2025-09-25 07:59:38 [o4-mini-2025] Here are a few small, focussed tweaks you can drop into slopfountain.ts to get:
2025-09-25 07:59:38 [o4-mini-2025] 
2025-09-25 07:59:38 [o4-mini-2025] • an “audit” command that walks your modelSpecs and prints release dates
2025-09-25 07:59:38 [o4-mini-2025] • a “drop” command that takes an index to delete one share
2025-09-25 07:59:38 [o4-mini-2025] 
2025-09-25 07:59:38 [o4-mini-2025] 1) In your callCommand switch add:
2025-09-25 07:59:38 [o4-mini-2025] 
2025-09-25 07:59:38 [o4-mini-2025] 
2025-09-25 07:59:38 [o4-mini-2025] case "audit":
2025-09-25 07:59:38 [o4-mini-2025]   // list modelSpecs sorted by release date
2025-09-25 07:59:38 [o4-mini-2025]   const entries = Object.entries(modelSpecs)
2025-09-25 07:59:38 [o4-mini-2025]     .map(([m,s]) => ({ model:m, released: s.released||"?" }))
2025-09-25 07:59:38 [o4-mini-2025]     .sort((a,b)=> new Date(a.released).getTime() - new Date(b.released).getTime());
2025-09-25 07:59:38 [o4-mini-2025]   for(const e of entries){
2025-09-25 07:59:38 [o4-mini-2025]     echo(e.model, "–", e.released);
2025-09-25 07:59:38 [o4-mini-2025]   }
2025-09-25 07:59:38 [o4-mini-2025]   break;
2025-09-25 07:59:38 [o4-mini-2025] 
2025-09-25 07:59:38 [o4-mini-2025] case "drop":
2025-09-25 07:59:38 [o4-mini-2025]   // drop a single shared file by index
2025-09-25 07:59:38 [o4-mini-2025]   if(words.length>1){
2025-09-25 07:59:38 [o4-mini-2025]     const idx=Number(words[1]);
2025-09-25 07:59:38 [o4-mini-2025]     if(!isNaN(idx) && roha.sharedFiles[idx]){
