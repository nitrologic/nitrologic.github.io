2025-09-24 08:14:46 [nitro@ryzen5] my deno ope4nai lib doesn't support this format?
2025-09-24 08:15:17 [deepseek-chat] You're right! The standard OpenAI Deno library doesn't support the `/v1/responses` endpoint - it's
2025-09-24 08:15:17 [deepseek-chat] a legacy/experimental endpoint. You'll need to implement it manually.
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] Here's how to add responses support to your OpenAI endpoint:
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] • In your `connectOpenAI` function, add a responses handler:*
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] async function connectOpenAI(account, config) {
2025-09-24 08:15:17 [deepseek-chat]     try {
2025-09-24 08:15:17 [deepseek-chat]         const apiKey = getEnv(config.env);
2025-09-24 08:15:17 [deepseek-chat]         const endpoint = new OpenAI({ apiKey, baseURL: config.url });
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat]         // Add responses endpoint support
2025-09-24 08:15:17 [deepseek-chat]         endpoint.responses = {
2025-09-24 08:15:17 [deepseek-chat]             create: async (payload) => {
2025-09-24 08:15:17 [deepseek-chat]                 const url = `${config.url}/responses`;
2025-09-24 08:15:17 [deepseek-chat]                 const response = await fetch(url, {
2025-09-24 08:15:17 [deepseek-chat]                     method: "POST",
2025-09-24 08:15:17 [deepseek-chat]                     headers: {
2025-09-24 08:15:17 [deepseek-chat]                         "Authorization": `Bearer ${apiKey}`,
2025-09-24 08:15:17 [deepseek-chat]                         "Content-Type": "application/json"
2025-09-24 08:15:17 [deepseek-chat]                     },
2025-09-24 08:15:17 [deepseek-chat]                     body: JSON.stringify(payload)
2025-09-24 08:15:17 [deepseek-chat]                 });
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat]                 if (!response.ok) {
2025-09-24 08:15:17 [deepseek-chat]                     throw new Error(`Responses API error: ${response.statusText}`);
2025-09-24 08:15:17 [deepseek-chat]                 }
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat]                 return await response.json();
2025-09-24 08:15:17 [deepseek-chat]             }
2025-09-24 08:15:17 [deepseek-chat]         };
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat]         // Rest of your existing code...
2025-09-24 08:15:17 [deepseek-chat]         const models = await endpoint.models.list();
2025-09-24 08:15:17 [deepseek-chat]         // ... etc
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] • Then in your relay function, use it like this:*
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat] if(responses){
2025-09-24 08:15:17 [deepseek-chat]     // Convert messages to string format for responses endpoint
2025-09-24 08:15:17 [deepseek-chat]     const inputText = payload.messages
2025-09-24 08:15:17 [deepseek-chat]         .map(msg => {
2025-09-24 08:15:17 [deepseek-chat]             if (msg.role === 'system') return `System: ${msg.content}`;
2025-09-24 08:15:17 [deepseek-chat]             if (msg.role === 'user') return `User: ${msg.content}`;
2025-09-24 08:15:17 [deepseek-chat]             if (msg.role === 'assistant') return `Assistant: ${msg.content}`;
2025-09-24 08:15:17 [deepseek-chat]             return `${msg.role}: ${msg.content}`;
2025-09-24 08:15:17 [deepseek-chat]         })
2025-09-24 08:15:17 [deepseek-chat]         .join('\n');
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat]     const responsePrompt = {
2025-09-24 08:15:17 [deepseek-chat]         model: payload.model,
2025-09-24 08:15:17 [deepseek-chat]         input: inputText,
2025-09-24 08:15:17 [deepseek-chat]         max_tokens: payload.max_tokens || 2048,
2025-09-24 08:15:17 [deepseek-chat]         temperature: payload.temperature || 0.7
2025-09-24 08:15:17 [deepseek-chat]     };
2025-09-24 08:15:17 [deepseek-chat] 
2025-09-24 08:15:17 [deepseek-chat]     const completion = await endpoint.responses.create(responsePrompt);
2025-09-24 08:15:17 [deepseek-chat]     // Handle the simpler responses format
2025-09-24 08:15:17 [deepseek-chat] } else {
2025-09-24 08:15:17 [deepseek-chat]     // Existing chat/completions logic
2025-09-24 08:15:17 [deepseek-chat]     const completion = await endpoint.chat.completions.create(payload);
2025-09-24 08:15:17 [deepseek-chat] }
2025-09-24 08:15:17 [deepseek-chat] 
