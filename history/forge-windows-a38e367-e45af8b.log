2025-10-11 09:13:08 [grok-4-fast-non]     "default_temp": 0.5,
2025-10-11 09:13:08 [grok-4-fast-non]     "cold": false
2025-10-11 09:13:08 [grok-4-fast-non]   },
2025-10-11 09:13:08 [grok-4-fast-non]   "gemini-1.5-pro@google": {
