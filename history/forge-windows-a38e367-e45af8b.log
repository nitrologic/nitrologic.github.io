2025-10-09 17:53:04 [gemini-2.5-flash] Here's the updated `playEvent` function and a new helper function `decodeHex16ToFloat64` to be
2025-10-09 17:53:04 [gemini-2.5-flash] added to your `dspmidi.js` file.
2025-10-09 17:53:04 [gemini-2.5-flash] 
2025-10-09 17:53:04 [gemini-2.5-flash] First, add the `decodeHex16ToFloat64` helper function. You can place this at the top of your
2025-10-09 17:53:04 [gemini-2.5-flash] `dspmidi.js` file or anywhere logically accessible to `playEvent`.
2025-10-09 17:53:04 [gemini-2.5-flash] 
2025-10-09 17:53:04 [gemini-2.5-flash] 
2025-10-09 17:53:04 [gemini-2.5-flash] // Add this helper function to dspmidi.js, e.g., near the top or within a utility section.
2025-10-09 17:53:04 [gemini-2.5-flash] function decodeHex16ToFloat64(hex16String) {
2025-10-09 17:53:04 [gemini-2.5-flash]     const n = hex16String.length / 4; // Each 16-bit sample is 4 hex characters
2025-10-09 17:53:04 [gemini-2.5-flash]     const mem64 = new Float64Array(n);
2025-10-09 17:53:04 [gemini-2.5-flash]     const gain16 = 0x7fff; // Maximum positive value for a 16-bit signed integer (32767)
2025-10-09 17:53:04 [gemini-2.5-flash] 
2025-10-09 17:53:04 [gemini-2.5-flash]     for (let i = 0; i < n; i++) {
2025-10-09 17:53:04 [gemini-2.5-flash]         const hexword = hex16String.substring(i * 4, i * 4 + 4);
2025-10-09 17:53:04 [gemini-2.5-flash]         let word = parseInt(hexword, 16);
2025-10-09 17:53:04 [gemini-2.5-flash] 
2025-10-09 17:53:04 [gemini-2.5-flash]         // Sign extend the 16-bit value to handle negative numbers
2025-10-09 17:53:04 [gemini-2.5-flash]         // If the 15th bit (0-indexed) is set, it's a negative number.
2025-10-09 17:53:04 [gemini-2.5-flash]         if (word & 0x8000) {
2025-10-09 17:53:04 [gemini-2.5-flash]             word = word - 0x10000; // Subtract 2^16 to get the correct negative value
2025-10-09 17:53:04 [gemini-2.5-flash]         }
