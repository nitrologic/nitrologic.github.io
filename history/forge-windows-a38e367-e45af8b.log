2025-10-11 10:26:27 [kimi-k2-0905] 
2025-10-11 10:26:27 [kimi-k2-0905] // one reusable encoder / decoder
2025-10-11 10:26:27 [kimi-k2-0905] const encoder = new TextEncoder();
2025-10-11 10:26:27 [kimi-k2-0905] const decoder = new TextDecoder();
2025-10-11 10:26:27 [kimi-k2-0905] 
2025-10-11 10:26:27 [kimi-k2-0905] function pushChar(bytes, view, pos, len) {
2025-10-11 10:26:27 [kimi-k2-0905] 	const seq = view.subarray(pos, pos + len);   // 1–4 raw bytes
2025-10-11 10:26:27 [kimi-k2-0905] 	const ch  = decoder.decode(seq);             // Unicode scalar
2025-10-11 10:26:27 [kimi-k2-0905] 	bytes.push(...encoder.encode(ch));           // re-encode → UTF-8
2025-10-11 10:26:27 [kimi-k2-0905] 	return ch;                                   // return so caller can use it
2025-10-11 10:26:27 [kimi-k2-0905] }
2025-10-11 10:26:27 [kimi-k2-0905] 
2025-10-11 10:26:27 [kimi-k2-0905] /* ---------- inside the main loop ---------- */
2025-10-11 10:26:27 [kimi-k2-0905] const n = value.byteLength;
2025-10-11 10:26:27 [kimi-k2-0905] 
2025-10-11 10:26:27 [kimi-k2-0905] for (let i = 0; i < n; ) {
2025-10-11 10:26:27 [kimi-k2-0905] 	const len = utf8SequenceLength(value[i]);    // how many bytes this char needs
2025-10-11 10:26:27 [kimi-k2-0905] 	if (i + len > n) break;                      // truncated sequence – ignore / handle
2025-10-11 10:26:27 [kimi-k2-0905] 
2025-10-11 10:26:27 [kimi-k2-0905] 	const ch = pushChar(bytes, value, i, len);
2025-10-11 10:26:27 [kimi-k2-0905] 	addInput(ch);                                // whatever you do with the char
2025-10-11 10:26:27 [kimi-k2-0905] 
2025-10-11 10:26:27 [kimi-k2-0905] 	i += len;                                    // move to next character
2025-10-11 10:26:27 [kimi-k2-0905] }
