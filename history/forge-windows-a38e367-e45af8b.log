2025-10-24 08:39:42 [qwen3-coder-plus]     if (charText && !charText.includes('\uFFFD')) { // Skip replacement characters
2025-10-24 08:39:42 [qwen3-coder-plus]         addInput(charText);
2025-10-24 08:39:42 [qwen3-coder-plus]         bytes.push(...sequence);
2025-10-24 08:39:42 [qwen3-coder-plus]         console.log("[RAW] skipping ",bytesNeeded,sequence,charText);
2025-10-24 08:39:42 [qwen3-coder-plus]         return bytesNeeded - 1;
2025-10-24 08:39:42 [qwen3-coder-plus]     }
2025-10-24 08:39:42 [qwen3-coder-plus] } catch (e) {
2025-10-24 08:39:42 [qwen3-coder-plus]     // Fall through to single byte handling
2025-10-24 08:39:42 [qwen3-coder-plus] }
2025-10-24 08:39:42 [qwen3-coder-plus] 
2025-10-24 08:39:42 [qwen3-coder-plus] 
2025-10-24 08:39:42 [qwen3-coder-plus] This prevents invalid decoded sequences from being added to the input buffer.
