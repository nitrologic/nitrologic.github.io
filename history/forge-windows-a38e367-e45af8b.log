2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] 1.  Store the real device-id in the option
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] function onEnumerateVideo(infos) {
2025-10-27 17:15:35 [kimi-k2-0905]   videoInSelect.innerHTML = "";
2025-10-27 17:15:35 [kimi-k2-0905]   for (const info of infos) {
2025-10-27 17:15:35 [kimi-k2-0905]     if (info.kind !== "videoinput") continue;
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905]     /*  KEEP THE REAL deviceId  */
2025-10-27 17:15:35 [kimi-k2-0905]     addOption(videoInSelect,
2025-10-27 17:15:35 [kimi-k2-0905]               info.deviceId,          // << value is deviceId
2025-10-27 17:15:35 [kimi-k2-0905]               info.label || "camera");
2025-10-27 17:15:35 [kimi-k2-0905]   }
2025-10-27 17:15:35 [kimi-k2-0905] }
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] 2.  Build the constraint object exactly like this
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] function streamVideo(){
2025-10-27 17:15:35 [kimi-k2-0905]   if (videoStreamTool.hasAttribute("on")) {     // already running → stop
2025-10-27 17:15:35 [kimi-k2-0905]     stopVideo();
2025-10-27 17:15:35 [kimi-k2-0905]     return;
2025-10-27 17:15:35 [kimi-k2-0905]   }
2025-10-27 17:15:35 [kimi-k2-0905]   videoStreamTool.setAttribute("on", "");
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905]   const deviceId = videoInSelect.value;         // <select> now has the real id
2025-10-27 17:15:35 [kimi-k2-0905]   if (!deviceId) {                               // user picked “no selection”
2025-10-27 17:15:35 [kimi-k2-0905]     log("no camera chosen");
2025-10-27 17:15:35 [kimi-k2-0905]     return;
2025-10-27 17:15:35 [kimi-k2-0905]   }
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905]   /*  Constraint that mobile browsers accept  */
2025-10-27 17:15:35 [kimi-k2-0905]   const constraints = {
2025-10-27 17:15:35 [kimi-k2-0905]     video: {
2025-10-27 17:15:35 [kimi-k2-0905]       deviceId: { exact: deviceId }   // ← exact match required on phone
2025-10-27 17:15:35 [kimi-k2-0905]     },
2025-10-27 17:15:35 [kimi-k2-0905]     audio: false                      // or true if you want mic
2025-10-27 17:15:35 [kimi-k2-0905]   };
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905]   navigator.mediaDevices
2025-10-27 17:15:35 [kimi-k2-0905]            .getUserMedia(constraints)
2025-10-27 17:15:35 [kimi-k2-0905]            .then(videoGranted)
2025-10-27 17:15:35 [kimi-k2-0905]            .catch(videoDenied);
2025-10-27 17:15:35 [kimi-k2-0905] }
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] 3.  (Optional) re-enumerate after the first call
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] Some phones only expose the back camera until the user has granted permission once.
2025-10-27 17:15:35 [kimi-k2-0905] After the first successful stream, re-run `enumerateVideo()` so the front camera appears in the
2025-10-27 17:15:35 [kimi-k2-0905] list.
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] 4.  Quick test
2025-10-27 17:15:35 [kimi-k2-0905] ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2025-10-27 17:15:35 [kimi-k2-0905] - reload the page
2025-10-27 17:15:35 [kimi-k2-0905] - pick “camera 1” or “camera 2” in the drop-down
2025-10-27 17:15:35 [kimi-k2-0905] - press Stream
2025-10-27 17:15:35 [kimi-k2-0905] You should now get the camera you selected instead of always the back one.
2025-10-27 17:15:35 [kimi-k2-0905] 
2025-10-27 17:15:35 [kimi-k2-0905] That is all that is required—no extra flags, no `ideal`, no `facingMode`.
2025-10-27 17:15:35 [kimi-k2-0905] If it still fails, the browser is probably remembering a previous persistent permission; clear site
2025-10-27 17:15:35 [kimi-k2-0905] settings or use a private tab.
