2025-10-12 16:20:08 [kimi-k2-0905] U+FFFD (decimal 65533) is the official Unicode “REPLACEMENT CHARACTER”.
2025-10-12 16:20:08 [kimi-k2-0905] It is inserted wherever a decoder encounters bytes that do not form a valid UTF-8 sequence, so the
2025-10-12 16:20:08 [kimi-k2-0905] caller sees one visible glyph (�) instead of a crash or silent drop.
2025-10-12 16:20:08 [kimi-k2-0905] 
2025-10-12 16:20:44 [nitro@ryzen5] is there a better helper I can use in Deno?
2025-10-12 16:21:07 [kimi-k2-0905] Yes—let TextDecoder do the hard work and only slice once.
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] const utf8 = new TextDecoder('utf-8', { fatal: false, ignoreBOM: true });
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] /** Return the Unicode string and the exact byte count consumed. */
2025-10-12 16:21:07 [kimi-k2-0905] export function decodeBlock(buf: Uint8Array, offset = 0): { str: string; used: number } {
2025-10-12 16:21:07 [kimi-k2-0905] 	if (offset >= buf.length) return { str: '', used: 0 };
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] 	// Find the longest valid UTF-8 prefix starting at offset
2025-10-12 16:21:07 [kimi-k2-0905] 	let end = buf.length;
2025-10-12 16:21:07 [kimi-k2-0905] 	while (end > offset) {
2025-10-12 16:21:07 [kimi-k2-0905] 		try {
2025-10-12 16:21:07 [kimi-k2-0905] 			const slice = buf.subarray(offset, end);
2025-10-12 16:21:07 [kimi-k2-0905] 			// TextDecoder never throws when fatal=false; it replaces bad bytes with �
2025-10-12 16:21:07 [kimi-k2-0905] 			const str = utf8.decode(slice, { stream: false });
2025-10-12 16:21:07 [kimi-k2-0905] 			return { str, used: slice.length };
2025-10-12 16:21:07 [kimi-k2-0905] 		} catch {
2025-10-12 16:21:07 [kimi-k2-0905] 			--end; // shorten until we fit a complete sequence
2025-10-12 16:21:07 [kimi-k2-0905] 		}
2025-10-12 16:21:07 [kimi-k2-0905] 	}
2025-10-12 16:21:07 [kimi-k2-0905] 	// Only invalid bytes left
2025-10-12 16:21:07 [kimi-k2-0905] 	return { str: utf8.decode(buf.subarray(offset, offset + 1)), used: 1 };
2025-10-12 16:21:07 [kimi-k2-0905] }
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] Usage:
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] const value = Deno.readFileSync('some.txt');
2025-10-12 16:21:07 [kimi-k2-0905] let pos = 0;
2025-10-12 16:21:07 [kimi-k2-0905] while (pos < value.length) {
2025-10-12 16:21:07 [kimi-k2-0905] 	const { str, used } = decodeBlock(value, pos);
2025-10-12 16:21:07 [kimi-k2-0905] 	console.log(str); // one logical chunk
2025-10-12 16:21:07 [kimi-k2-0905] 	pos += used;
2025-10-12 16:21:07 [kimi-k2-0905] }
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] 
2025-10-12 16:21:07 [kimi-k2-0905] No manual bit-masking, no surrogate handling, zero dependencies, and works on every Deno version.
