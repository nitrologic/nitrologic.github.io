2025-10-24 08:21:41 [nitro@ryzen5] only on windows pasting some unicode emoji causes 2 undefined ? symbols instead
2025-10-24 08:21:49 [qwen3-coder-plus] The issue occurs in the UTF-8 multi-byte sequence handling. When pasting emoji on Windows, the
2025-10-24 08:21:49 [qwen3-coder-plus] sequence gets fragmented across multiple `reader.read()` calls, causing incomplete sequences to be
2025-10-24 08:21:49 [qwen3-coder-plus] processed as replacement characters.
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] Here's the fix for the UTF-8 sequence handling:
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] let utf8Buffer = new Uint8Array(4);
2025-10-24 08:21:49 [qwen3-coder-plus] let utf8BufferLen = 0;
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] for(let i=0;i<n;i++){
2025-10-24 08:21:49 [qwen3-coder-plus] 	const byte=value[i];
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 	// Handle UTF-8 multi-byte sequences with buffering
2025-10-24 08:21:49 [qwen3-coder-plus] 	if (byte >= 0xC0) { // Start of UTF-8 sequence
2025-10-24 08:21:49 [qwen3-coder-plus] 		utf8Buffer.fill(0);
2025-10-24 08:21:49 [qwen3-coder-plus] 		utf8Buffer[0] = byte;
2025-10-24 08:21:49 [qwen3-coder-plus] 		utf8BufferLen = 1;
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 		let bytesNeeded = 0;
2025-10-24 08:21:49 [qwen3-coder-plus] 		if ((byte & 0xE0) === 0xC0) bytesNeeded = 2;
2025-10-24 08:21:49 [qwen3-coder-plus] 		else if ((byte & 0xF0) === 0xE0) bytesNeeded = 3;
2025-10-24 08:21:49 [qwen3-coder-plus] 		else if ((byte & 0xF8) === 0xF0) bytesNeeded = 4;
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 		// Collect remaining bytes in sequence
2025-10-24 08:21:49 [qwen3-coder-plus] 		for(let j = 1; j < bytesNeeded && i + j < n; j++) {
2025-10-24 08:21:49 [qwen3-coder-plus] 			utf8Buffer[j] = value[i + j];
2025-10-24 08:21:49 [qwen3-coder-plus] 			utf8BufferLen++;
2025-10-24 08:21:49 [qwen3-coder-plus] 		}
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 		if (utf8BufferLen === bytesNeeded) {
2025-10-24 08:21:49 [qwen3-coder-plus] 			// Complete sequence - process and skip bytes
2025-10-24 08:21:49 [qwen3-coder-plus] 			const chartext = decoder.decode(utf8Buffer.subarray(0, bytesNeeded));
2025-10-24 08:21:49 [qwen3-coder-plus] 			addInput(chartext);
2025-10-24 08:21:49 [qwen3-coder-plus] 			bytes.push(...utf8Buffer.subarray(0, bytesNeeded));
2025-10-24 08:21:49 [qwen3-coder-plus] 			i += bytesNeeded - 1;
2025-10-24 08:21:49 [qwen3-coder-plus] 			continue;
2025-10-24 08:21:49 [qwen3-coder-plus] 		} else {
2025-10-24 08:21:49 [qwen3-coder-plus] 			// Incomplete sequence - buffer for next read
2025-10-24 08:21:49 [qwen3-coder-plus] 			console.log("[RAW] incomplete UTF-8 sequence");
2025-10-24 08:21:49 [qwen3-coder-plus] 			continue;
2025-10-24 08:21:49 [qwen3-coder-plus] 		}
2025-10-24 08:21:49 [qwen3-coder-plus] 	}
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 	// Handle continuation bytes
2025-10-24 08:21:49 [qwen3-coder-plus] 	if (byte >= 0x80 && byte < 0xC0 && utf8BufferLen > 0) {
2025-10-24 08:21:49 [qwen3-coder-plus] 		utf8Buffer[utf8BufferLen++] = byte;
2025-10-24 08:21:49 [qwen3-coder-plus] 		continue;
2025-10-24 08:21:49 [qwen3-coder-plus] 	}
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 	// Process any completed buffered sequence
2025-10-24 08:21:49 [qwen3-coder-plus] 	if (utf8BufferLen > 0) {
2025-10-24 08:21:49 [qwen3-coder-plus] 		try {
2025-10-24 08:21:49 [qwen3-coder-plus] 			const chartext = decoder.decode(utf8Buffer.subarray(0, utf8BufferLen));
2025-10-24 08:21:49 [qwen3-coder-plus] 			addInput(chartext);
2025-10-24 08:21:49 [qwen3-coder-plus] 			bytes.push(...utf8Buffer.subarray(0, utf8BufferLen));
2025-10-24 08:21:49 [qwen3-coder-plus] 		} catch(e) {
2025-10-24 08:21:49 [qwen3-coder-plus] 			console.log("[RAW] decode error", e);
2025-10-24 08:21:49 [qwen3-coder-plus] 		}
2025-10-24 08:21:49 [qwen3-coder-plus] 		utf8BufferLen = 0;
2025-10-24 08:21:49 [qwen3-coder-plus] 	}
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 	// Rest of existing byte processing...
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] The key changes:
2025-10-24 08:21:49 [qwen3-coder-plus] 1. Maintain a `utf8Buffer` to accumulate fragmented sequences
2025-10-24 08:21:49 [qwen3-coder-plus] 2. Complete sequences only when all bytes are available
2025-10-24 08:21:49 [qwen3-coder-plus] 3. Buffer incomplete sequences across read boundaries
2025-10-24 08:21:49 [qwen3-coder-plus] 4. Process buffered sequences when single-byte processing occurs
2025-10-24 08:21:49 [qwen3-coder-plus] 
2025-10-24 08:21:49 [qwen3-coder-plus] This ensures emoji paste operations work correctly on Windows by properly reassembling fragmented
2025-10-24 08:21:49 [qwen3-coder-plus] UTF-8 sequences.
