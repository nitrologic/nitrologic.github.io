2025-10-22 12:48:11 [nitro@ryzen5] need alternative to unicode abacus it looks bad on various backgrounds ��
2025-10-22 12:49:20 [kimi-k2-0905] Try a seven-segment look instead of the abacus dots.
2025-10-22 12:49:20 [kimi-k2-0905] It’s just seven thin strokes that you can tint to match any background, so it never “pops” the
2025-10-22 12:49:20 [kimi-k2-0905] wrong colour and stays crisp at tiny sizes.
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] HTML
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] <canvas id="digits" width="240" height="40"></canvas>
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] CSS
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] canvas { background: transparent; }   /* adapts to whatever is behind it */
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] JS
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] const SEG = [                          // which segments are “on” for 0-9
2025-10-22 12:49:20 [kimi-k2-0905] 	0x3F, 0x06, 0x5B, 0x4F, 0x66,        // 0 1 2 3 4
2025-10-22 12:49:20 [kimi-k2-0905] 	0x6D, 0x7D, 0x07, 0x7F, 0x6F         // 5 6 7 8 9
2025-10-22 12:49:20 [kimi-k2-0905] ];
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] function drawSegment(ctx, x, y, w, h, mask) {
2025-10-22 12:49:20 [kimi-k2-0905] 	const seg = [
2025-10-22 12:49:20 [kimi-k2-0905] 		[x+2, y,   x+w-2, y],            // top
2025-10-22 12:49:20 [kimi-k2-0905] 		[x+w, y+2, x+w,   y+h/2-2],      // upper right
2025-10-22 12:49:20 [kimi-k2-0905] 		[x+w, y+h/2+2, x+w, y+h-2],      // lower right
2025-10-22 12:49:20 [kimi-k2-0905] 		[x+2, y+h, x+w-2, y+h],          // bottom
2025-10-22 12:49:20 [kimi-k2-0905] 		[x,   y+h/2+2, x,   y+h-2],      // lower left
2025-10-22 12:49:20 [kimi-k2-0905] 		[x,   y+2, x,     y+h/2-2],      // upper left
2025-10-22 12:49:20 [kimi-k2-0905] 		[x+2, y+h/2, x+w-2, y+h/2]       // middle
2025-10-22 12:49:20 [kimi-k2-0905] 	];
2025-10-22 12:49:20 [kimi-k2-0905] 	ctx.strokeStyle = '#555';          // pick any colour that contrasts
2025-10-22 12:49:20 [kimi-k2-0905] 	ctx.lineWidth = 2;
2025-10-22 12:49:20 [kimi-k2-0905] 	seg.forEach((s, i) => {
2025-10-22 12:49:20 [kimi-k2-0905] 		if (mask & (1 << i)) {
2025-10-22 12:49:20 [kimi-k2-0905] 			ctx.beginPath();
2025-10-22 12:49:20 [kimi-k2-0905] 			ctx.moveTo(s[0], s[1]);
2025-10-22 12:49:20 [kimi-k2-0905] 			ctx.lineTo(s[2], s[3]);
2025-10-22 12:49:20 [kimi-k2-0905] 			ctx.stroke();
2025-10-22 12:49:20 [kimi-k2-0905] 		}
2025-10-22 12:49:20 [kimi-k2-0905] 	});
2025-10-22 12:49:20 [kimi-k2-0905] }
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] function drawDigits(canvas, n) {
2025-10-22 12:49:20 [kimi-k2-0905] 	const ctx = canvas.getContext('2d');
2025-10-22 12:49:20 [kimi-k2-0905] 	ctx.clearRect(0, 0, canvas.width, canvas.height);
2025-10-22 12:49:20 [kimi-k2-0905] 	const str = String(n).padStart(6, ' ');
2025-10-22 12:49:20 [kimi-k2-0905] 	let x = 0;
2025-10-22 12:49:20 [kimi-k2-0905] 	for (const ch of str) {
2025-10-22 12:49:20 [kimi-k2-0905] 		if (ch !== ' ') drawSegment(ctx, x, 5, 30, 40, SEG[+ch]);
2025-10-22 12:49:20 [kimi-k2-0905] 		x += 35;
2025-10-22 12:49:20 [kimi-k2-0905] 	}
2025-10-22 12:49:20 [kimi-k2-0905] }
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] drawDigits(document.getElementById('digits'), 314159);
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] 
2025-10-22 12:49:20 [kimi-k2-0905] Drop the canvas on any background colour or image; the strokes inherit their colour from
2025-10-22 12:49:20 [kimi-k2-0905] `strokeStyle`, so you can theme them once and forget about contrast issues.
2025-10-22 12:49:20 [kimi-k2-0905] 
