2025-10-29 13:40:30 [nitro@ryzen5] const input=raw..normalize("NFC").replace(/\uFE0F/g, "");
2025-10-29 13:40:30 [nitro@ryzen5] //grapheme.push(...(input.match(/(\p{Emoji}\uFE0F?|\p{Emoji_Presentation}|\p{Extended_Pictographic}\u200D?[\p{Emoji_Modifier}\uFE0F]*)+|./gu) || []));
