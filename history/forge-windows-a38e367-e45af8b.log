2025-10-29 09:15:59 [kimi-k2-0905] 
2025-10-29 09:15:59 [kimi-k2-0905] int fsSave(JSValue *params, utf8 &result){
2025-10-29 09:15:59 [kimi-k2-0905]     utf8 session = params->stringMember("session");
2025-10-29 09:15:59 [kimi-k2-0905]     utf8 name    = params->stringMember("name");
2025-10-29 09:15:59 [kimi-k2-0905]     utf8 content = params->stringMember("content");
2025-10-29 09:15:59 [kimi-k2-0905] 
2025-10-29 09:15:59 [kimi-k2-0905]     utf8 dir  = CachePath + "/" + session;
2025-10-29 09:15:59 [kimi-k2-0905]     mkdir(dir.c_str(), 0755);
2025-10-29 09:15:59 [kimi-k2-0905] 
2025-10-29 09:15:59 [kimi-k2-0905]     utf8 path = dir + "/" + name;
2025-10-29 09:15:59 [kimi-k2-0905]     int  fd   = open(path.c_str(), O_CREAT|O_WRONLY|O_TRUNC, 0644);
2025-10-29 09:15:59 [kimi-k2-0905]     if(fd<0) return -1;
2025-10-29 09:15:59 [kimi-k2-0905]     ssize_t n = write(fd, content.data(), content.size());
2025-10-29 09:15:59 [kimi-k2-0905]     close(fd);
2025-10-29 09:15:59 [kimi-k2-0905]     result = "{\"bytes\":"+std::to_string(n)+","
2025-10-29 09:15:59 [kimi-k2-0905]              "\"path\":"+quoted(path)+"}";
2025-10-29 09:15:59 [kimi-k2-0905]     return 0;
2025-10-29 09:15:59 [kimi-k2-0905] }
