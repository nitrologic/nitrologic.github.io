2026-07-16 19:21:21 [deepseek-v4-flash]   // Try: game.pushKey(0x7F);
2026-07-16 19:21:21 [deepseek-v4-flash]   // Or simply ignore it if you want backspace to erase a character in your own display helper.
2026-07-16 19:21:21 [deepseek-v4-flash]   break;
2026-07-16 19:21:21 [deepseek-v4-flash] case 8:  // Backspace
2026-07-16 19:21:21 [deepseek-v4-flash]   // Option: push $08 (standard backspace)
2026-07-16 19:21:21 [deepseek-v4-flash]   game.pushKey(8);
2026-07-16 19:21:21 [deepseek-v4-flash]   break;
