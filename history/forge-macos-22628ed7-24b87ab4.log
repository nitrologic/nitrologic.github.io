2026-07-13 21:34:23 [gpt-5.6-terra] 	{
2026-07-13 21:34:23 [gpt-5.6-terra] 		this.get8(pc + 1); // BRK is two bytes, including its padding byte
2026-07-13 21:34:23 [gpt-5.6-terra] 
2026-07-13 21:34:23 [gpt-5.6-terra] 		const returnAddress=(pc + 2) & 0xFFFF;
2026-07-13 21:34:23 [gpt-5.6-terra] 		let sp=this.registers[register.SP];
2026-07-13 21:34:23 [gpt-5.6-terra] 
2026-07-13 21:34:23 [gpt-5.6-terra] 		this.memory[0x0100 + sp]=(returnAddress >> 8) & 0xFF;
2026-07-13 21:34:23 [gpt-5.6-terra] 		sp--;
2026-07-13 21:34:23 [gpt-5.6-terra] 
2026-07-13 21:34:23 [gpt-5.6-terra] 		this.memory[0x0100 + sp]=returnAddress & 0xFF;
2026-07-13 21:34:23 [gpt-5.6-terra] 		sp--;
2026-07-13 21:34:23 [gpt-5.6-terra] 
2026-07-13 21:34:23 [gpt-5.6-terra] 		this.memory[0x0100 + sp]=this.registers[register.ST] | BFLAG | GFLAG;
2026-07-13 21:34:23 [gpt-5.6-terra] 		sp--;
