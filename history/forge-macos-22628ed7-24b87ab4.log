2026-07-05 13:10:26 [grok-build-0.1] 
2026-07-05 13:10:26 [grok-build-0.1] export function pollKeyboard(): number {
2026-07-05 13:10:26 [grok-build-0.1]   const up    = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_UpArrow)    !== 0;
2026-07-05 13:10:26 [grok-build-0.1]   const down  = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_DownArrow)  !== 0;
2026-07-05 13:10:26 [grok-build-0.1]   const left  = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_LeftArrow)  !== 0;
2026-07-05 13:10:26 [grok-build-0.1]   const right = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_RightArrow) !== 0;
2026-07-05 13:10:26 [grok-build-0.1]   const space = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_Space)      !== 0;
2026-07-05 13:10:26 [grok-build-0.1]   const esc   = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_Escape)     !== 0;
2026-07-05 13:10:26 [grok-build-0.1] 
2026-07-05 13:10:26 [grok-build-0.1]   return (up    ? 1  : 0) |
2026-07-05 13:10:26 [grok-build-0.1]          (down  ? 2  : 0) |
