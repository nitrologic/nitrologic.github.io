2026-07-05 13:10:26 [grok-build-0.1] const kVK_DownArrow  = 0x7d;
2026-07-05 13:10:26 [grok-build-0.1] const kVK_Space      = 0x31;
2026-07-05 13:10:26 [grok-build-0.1] const kVK_Escape     = 0x35;
2026-07-05 13:10:26 [grok-build-0.1] 
2026-07-05 13:10:26 [grok-build-0.1] const appServices = Deno.dlopen(
2026-07-05 13:10:26 [grok-build-0.1]   "/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices",
2026-07-05 13:10:26 [grok-build-0.1]   {
2026-07-05 13:10:26 [grok-build-0.1]     CGEventSourceKeyState: {
2026-07-05 13:10:26 [grok-build-0.1]       parameters: ["i32", "u16"],
