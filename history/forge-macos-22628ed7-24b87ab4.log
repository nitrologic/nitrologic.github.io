2026-07-09 18:48:05 [grok-build-0.1] 
2026-07-09 18:48:05 [grok-build-0.1] case 0x64: // Illegal NOP (read zero page, do nothing)
2026-07-09 18:48:05 [grok-build-0.1] {
2026-07-09 18:48:05 [grok-build-0.1]     let target = this.get8(pc + 1);
2026-07-09 18:48:05 [grok-build-0.1]     this.read(target);          // still do the read (in case it hits I/O or POKEY)
2026-07-09 18:48:05 [grok-build-0.1]     this.step(2);
2026-07-09 18:48:05 [grok-build-0.1]     return "NOP\t$" + hex(target) + " (64)";
2026-07-09 18:48:05 [grok-build-0.1] }
2026-07-09 18:48:05 [grok-build-0.1] 
2026-07-09 18:48:05 [grok-build-0.1] 
