2026-07-09 18:48:38 [grok-build-0.1] 
2026-07-09 18:48:38 [grok-build-0.1] case 0x40: // RTI
2026-07-09 18:48:38 [grok-build-0.1] {
2026-07-09 18:48:38 [grok-build-0.1]     // Pull status register
2026-07-09 18:48:38 [grok-build-0.1]     this.registers[register.SP]++;
2026-07-09 18:48:38 [grok-build-0.1]     let status = this.memory[0x0100 + this.registers[register.SP]];
2026-07-09 18:48:38 [grok-build-0.1]     this.registers[register.ST] = (status & ~0x10) | 0x20; // clear B, set unused bit
2026-07-09 18:48:38 [grok-build-0.1] 
2026-07-09 18:48:38 [grok-build-0.1]     // Pull low byte of return address
2026-07-09 18:48:38 [grok-build-0.1]     this.registers[register.SP]++;
2026-07-09 18:48:38 [grok-build-0.1]     let low = this.memory[0x0100 + this.registers[register.SP]];
2026-07-09 18:48:38 [grok-build-0.1] 
2026-07-09 18:48:38 [grok-build-0.1]     // Pull high byte of return address
2026-07-09 18:48:38 [grok-build-0.1]     this.registers[register.SP]++;
2026-07-09 18:48:38 [grok-build-0.1]     let high = this.memory[0x0100 + this.registers[register.SP]];
2026-07-09 18:48:38 [grok-build-0.1] 
2026-07-09 18:48:38 [grok-build-0.1]     this.pc[0] = (high << 8) | low;
2026-07-09 18:48:38 [grok-build-0.1]     return "RTI\t";
2026-07-09 18:48:38 [grok-build-0.1] }
2026-07-09 18:48:38 [grok-build-0.1] 
