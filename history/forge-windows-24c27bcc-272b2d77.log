2026-08-19 17:59:14 [gemini-3.7-flash] 			if ((crb & 4) === 0) {
2026-08-19 17:59:14 [gemini-3.7-flash] 				this.ddrb = value;
2026-08-19 17:59:14 [gemini-3.7-flash] 				return;
2026-08-19 17:59:14 [gemini-3.7-flash] 			}
2026-08-19 17:59:14 [gemini-3.7-flash] 			break;
2026-08-19 17:59:14 [gemini-3.7-flash] 		}
2026-08-19 17:59:14 [gemini-3.7-flash] 		case 0xE813:
2026-08-19 17:59:14 [gemini-3.7-flash] 			value = (mem[0xE813] & 0xC0) | (value & 0x3F);
2026-08-19 17:59:14 [gemini-3.7-flash] 			break;
2026-08-19 17:59:14 [gemini-3.7-flash] 	}
2026-08-19 17:59:14 [gemini-3.7-flash] 
2026-08-19 17:59:14 [gemini-3.7-flash] 	mem[address] = value;
2026-08-19 17:59:14 [gemini-3.7-flash] }
