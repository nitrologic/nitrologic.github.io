2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0x0300 && codePoint <= 0x036F) ||
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0x1AB0 && codePoint <= 0x1AFF) ||
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0x1DC0 && codePoint <= 0x1DFF) ||
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0x20D0 && codePoint <= 0x20FF) ||
