2026-08-18 18:18:49 [gemini-3.7-flash] function readViaPortB(mem: Uint8Array, cycleCount: number): number {
2026-08-18 18:18:49 [gemini-3.7-flash] 	let value = mem[0xE840] & ~0x20; // Clear bit 5
2026-08-18 18:18:49 [gemini-3.7-flash] 
2026-08-18 18:18:49 [gemini-3.7-flash] 	if (isPETBlanking(cycleCount)) {
2026-08-18 18:18:49 [gemini-3.7-flash] 		value |= 0x20; // Set bit 5 when in blanking/retrace
