2026-08-26 16:14:12 [deepseek-v4-flash-vision] }
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 
2026-08-26 16:14:12 [deepseek-v4-flash-vision] export function stringWidth(text: string): number {
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	let totalCells = 0;
2026-08-26 16:14:13 [deepseek-v4-flash-vision] 	for (const cluster of graphemeSegmenter.segment(text)) {
2026-08-26 16:14:13 [deepseek-v4-flash-vision] 		totalCells += graphemeWidth(cluster.segment);
2026-08-26 16:14:13 [deepseek-v4-flash-vision] 	}
2026-08-26 16:14:13 [deepseek-v4-flash-vision] 	return totalCells;
2026-08-26 16:14:13 [deepseek-v4-flash-vision] }
