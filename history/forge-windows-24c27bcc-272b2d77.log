2026-08-26 16:14:12 [deepseek-v4-flash-vision] export function graphemeWidth(grapheme: string): number {
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// If the cluster contains a ZWJ (U+200D) or multiple emoji code points,
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// treat it as a single wide glyph. Many terminals render emoji sequences
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// as one character, but not all. This heuristic agrees with modern xterm‑based
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// terminals (Windows Terminal, iTerm2, etc.).
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	if (grapheme.includes("\u200D")) {
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		return 2;
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	}
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// If the cluster contains a variation selector, it's still an emoji or symbol,
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// so it's wide if the base is wide.
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	const characters = Array.from(grapheme);
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// Count wide code points. If more than one, it's an emoji sequence.
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	const wideCount = characters.filter(isWideCodePoint).length;
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	if (wideCount > 1) {
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		return 2;
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	}
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	// Otherwise, sum the widths of the individual code points.
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	let width = 0;
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	for (const character of characters) {
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		if (containsZeroWidthCodePoint(character)) continue;
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		width += isWideCodePoint(character) ? 2 : 1;
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 	}
