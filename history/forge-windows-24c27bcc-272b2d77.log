2026-08-18 18:18:48 [gemini-3.7-flash] 2. Implementation
2026-08-18 18:18:48 [gemini-3.7-flash] 
2026-08-18 18:18:48 [gemini-3.7-flash] Define the timing constants and helper evaluation function:
2026-08-18 18:18:48 [gemini-3.7-flash] 
2026-08-18 18:18:48 [gemini-3.7-flash] 
2026-08-18 18:18:48 [gemini-3.7-flash] // PET 1 MHz NTSC video timing constants
2026-08-18 18:18:48 [gemini-3.7-flash] const CYCLES_PER_LINE = 64;
2026-08-18 18:18:48 [gemini-3.7-flash] const VISIBLE_CYCLES_PER_LINE = 44; // Remaining 20 cycles are H-Blank
2026-08-18 18:18:48 [gemini-3.7-flash] const LINES_PER_FRAME = 260;
2026-08-18 18:18:48 [gemini-3.7-flash] const VISIBLE_LINES = 200;          // Remaining 60 lines are V-Blank
2026-08-18 18:18:48 [gemini-3.7-flash] const CYCLES_PER_FRAME = LINES_PER_FRAME * CYCLES_PER_LINE; // 16640 cycles (~60.09 Hz)
2026-08-18 18:18:48 [gemini-3.7-flash] 
2026-08-18 18:18:48 [gemini-3.7-flash] function isPETBlanking(cycleCount: number): boolean {
2026-08-18 18:18:48 [gemini-3.7-flash] 	const frameCycle = cycleCount % CYCLES_PER_FRAME;
2026-08-18 18:18:48 [gemini-3.7-flash] 	const currentLine = (frameCycle / CYCLES_PER_LINE) | 0;
2026-08-18 18:18:48 [gemini-3.7-flash] 	const lineCycle = frameCycle % CYCLES_PER_LINE;
2026-08-18 18:18:48 [gemini-3.7-flash] 
2026-08-18 18:18:48 [gemini-3.7-flash] 	const isVerticalBlank = currentLine >= VISIBLE_LINES;
2026-08-18 18:18:48 [gemini-3.7-flash] 	const isHorizontalBlank = lineCycle >= VISIBLE_CYCLES_PER_LINE;
2026-08-18 18:18:49 [gemini-3.7-flash] 
2026-08-18 18:18:49 [gemini-3.7-flash] 	// Master blanking is active during either H-Blank or V-Blank
2026-08-18 18:18:49 [gemini-3.7-flash] 	return isVerticalBlank || isHorizontalBlank;
2026-08-18 18:18:49 [gemini-3.7-flash] }
2026-08-18 18:18:49 [gemini-3.7-flash] 
