2026-08-05 17:44:48 [claude-haiku-4-5]     const mem = this.memory;
2026-08-05 17:44:48 [claude-haiku-4-5] 
2026-08-05 17:44:48 [claude-haiku-4-5]     switch(address) {
2026-08-05 17:44:48 [claude-haiku-4-5]         case 0xFF3E: // ROM enabled
2026-08-05 17:44:48 [claude-haiku-4-5]             this.ramBanked = false;
2026-08-05 17:44:48 [claude-haiku-4-5]             break;
2026-08-05 17:44:48 [claude-haiku-4-5]         case 0xFF3F: // RAM enabled (switches $4000–$BFFF to RAM)
