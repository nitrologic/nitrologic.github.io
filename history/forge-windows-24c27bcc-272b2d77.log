2026-08-19 17:59:14 [gemini-3.7-flash] readPET(address: number) {
2026-08-19 17:59:14 [gemini-3.7-flash] 	const label = this.addresLabel(address);
2026-08-19 17:59:14 [gemini-3.7-flash] 	const mem = this.memory;
