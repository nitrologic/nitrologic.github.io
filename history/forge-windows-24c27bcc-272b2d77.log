2026-08-01 17:46:41 [deepseek-v4-flash] 
2026-08-01 17:46:41 [deepseek-v4-flash] const lowBits = (secondary >> (2 * (k % 3))) & 0x03;
2026-08-01 17:46:41 [deepseek-v4-flash] bytes[k] = (temp[k + 86] << 2) | lowBits;
