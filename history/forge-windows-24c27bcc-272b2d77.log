2026-08-20 10:55:39 [gemini-3.7-flash] 	{
2026-08-20 10:55:39 [gemini-3.7-flash] 		/* $FF00-$FF3F: Includes addresses where bits 7 and 6 are both 0 */
2026-08-20 10:55:39 [gemini-3.7-flash] 		return ((address & 0x00C0) == 0x0000);
2026-08-20 10:55:39 [gemini-3.7-flash] 	}
