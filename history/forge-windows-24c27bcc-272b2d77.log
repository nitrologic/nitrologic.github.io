2026-08-19 17:59:14 [gemini-3.7-flash] 
2026-08-19 17:59:14 [gemini-3.7-flash] 	switch (address) {
2026-08-19 17:59:14 [gemini-3.7-flash] 		case 0xE810: {
2026-08-19 17:59:14 [gemini-3.7-flash] 			const cra = mem[0xE811];
2026-08-19 17:59:14 [gemini-3.7-flash] 			if ((cra & 4) === 0) {
2026-08-19 17:59:14 [gemini-3.7-flash] 				this.ddra = value;
2026-08-19 17:59:14 [gemini-3.7-flash] 				return;
2026-08-19 17:59:14 [gemini-3.7-flash] 			}
2026-08-19 17:59:14 [gemini-3.7-flash] 			scanKeyboard(value & 0x0F);
2026-08-19 17:59:14 [gemini-3.7-flash] 			traceLog("[PET] scanning column", value & 0x0F);
2026-08-19 17:59:14 [gemini-3.7-flash] 			break;
2026-08-19 17:59:14 [gemini-3.7-flash] 		}
2026-08-19 17:59:14 [gemini-3.7-flash] 		case 0xE811:
2026-08-19 17:59:14 [gemini-3.7-flash] 			value = (mem[0xE811] & 0xC0) | (value & 0x3F);
2026-08-19 17:59:14 [gemini-3.7-flash] 			break;
2026-08-19 17:59:14 [gemini-3.7-flash] 		case 0xE812: {
