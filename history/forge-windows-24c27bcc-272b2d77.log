2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0xFE30 && codePoint <= 0xFE4F) ||
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0xFF00 && codePoint <= 0xFF60) ||
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0xFFE0 && codePoint <= 0xFFE6) ||
2026-08-26 16:14:12 [deepseek-v4-flash-vision] 		(codePoint >= 0x1F300 && codePoint <= 0x1FAFF) ||
