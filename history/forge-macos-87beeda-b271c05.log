2025-08-25 14:04:59 [deepseek-chat] // Add this near your signal listeners
2025-08-25 14:04:59 [deepseek-chat] Deno.addSignalListener("SIGINT", () => {
2025-08-25 14:04:59 [deepseek-chat]   // ... existing code ...
2025-08-25 14:04:59 [deepseek-chat] });
2025-08-25 14:04:59 [deepseek-chat] // Add escape key listener
2025-08-25 14:04:59 [deepseek-chat] if (Deno.stdin.setRaw) {
2025-08-25 14:04:59 [deepseek-chat]   Deno.stdin.setRaw(true);
2025-08-25 14:04:59 [deepseek-chat]   const buf = new Uint8Array(1);
2025-08-25 14:04:59 [deepseek-chat]   while (true) {
2025-08-25 14:04:59 [deepseek-chat]     const n = await Deno.stdin.read(buf);
2025-08-25 14:04:59 [deepseek-chat]     if (n === null) break;
2025-08-25 14:04:59 [deepseek-chat]     if (buf[0] === 27) { // Escape key
