2025-08-25 14:04:59 [deepseek-chat]       client.destroy();
2025-08-25 14:04:59 [deepseek-chat]       Deno.exit(0);
2025-08-25 14:04:59 [deepseek-chat]     }
2025-08-25 14:04:59 [deepseek-chat]   }
2025-08-25 14:04:59 [deepseek-chat] }
