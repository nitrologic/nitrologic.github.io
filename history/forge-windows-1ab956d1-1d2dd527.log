2026-04-23 21:33:27 [gemini-3.1-pro] 	jmp	y--, hsync [29]		; 3 setup + (26 iterations * 30 cycles) = 783
2026-04-23 21:33:27 [gemini-3.1-pro] 
2026-04-23 21:33:27 [gemini-3.1-pro] 	; back porch = ~5.79 µs = 964 cycles
2026-04-23 21:33:27 [gemini-3.1-pro] 	set	pindirs, 0
2026-04-23 21:33:27 [gemini-3.1-pro] 	set	pins, 1
