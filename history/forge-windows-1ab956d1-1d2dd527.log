2026-04-07 19:52:46 [gemini-3.1-pro] function wordWrap(text:string,cols:number=terminalColumns):string{
2026-04-07 19:52:46 [gemini-3.1-pro] 	const result=[];
2026-04-07 19:52:46 [gemini-3.1-pro] 	let pos=0;
2026-04-07 19:52:46 [gemini-3.1-pro] 	while(pos<text.length){
2026-04-07 19:52:46 [gemini-3.1-pro] 		let line=text.substring(pos,pos+cols);
2026-04-07 19:52:46 [gemini-3.1-pro] 		let n=line.length;
2026-04-07 19:52:46 [gemini-3.1-pro] 		if(n==cols){
2026-04-07 19:52:46 [gemini-3.1-pro] 			let i=line.lastIndexOf(" ",n);
2026-04-07 19:52:46 [gemini-3.1-pro] 			if(i>0){
2026-04-07 19:52:46 [gemini-3.1-pro] 				line=line.substring(0,i);
2026-04-07 19:52:46 [gemini-3.1-pro] 				n=i+1;
2026-04-07 19:52:46 [gemini-3.1-pro] 			}
2026-04-07 19:52:46 [gemini-3.1-pro] 		}
2026-04-07 19:52:46 [gemini-3.1-pro] 		result.push(line);
2026-04-07 19:52:46 [gemini-3.1-pro] 		pos+=n;
2026-04-07 19:52:46 [gemini-3.1-pro] 	}
2026-04-07 19:52:46 [gemini-3.1-pro] 	return result.join("\r\n");
2026-04-07 19:52:46 [gemini-3.1-pro] }
