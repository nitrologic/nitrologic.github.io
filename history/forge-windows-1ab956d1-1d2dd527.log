2026-04-07 19:52:48 [gemini-3.1-pro] function prepareGeminiPrompt(payload){
2026-04-07 19:52:48 [gemini-3.1-pro] 	const debugging=roha.config.debugging;
2026-04-07 19:52:48 [gemini-3.1-pro] 	if(debugging) echo("[GEMINI] payload",payload);
2026-04-07 19:52:48 [gemini-3.1-pro] 	const contents=[];
2026-04-07 19:52:48 [gemini-3.1-pro] 	const sysparts=[];	// GenerateContentRequest systemInstruction content
2026-04-07 19:52:48 [gemini-3.1-pro] 	let blob={};
2026-04-07 19:52:49 [gemini-3.1-pro] 	for(const item of payload.messages){
2026-04-07 19:52:49 [gemini-3.1-pro] 		if(debugging) echo("[GEMINI] item",item);
2026-04-07 19:52:49 [gemini-3.1-pro] 		const text=item.content;
2026-04-07 19:52:49 [gemini-3.1-pro] 		if(debugging) echo("[GEMINI] text",text);
2026-04-07 19:52:49 [gemini-3.1-pro] 		switch(item.role){
2026-04-07 19:52:49 [gemini-3.1-pro] 			case "system":
2026-04-07 19:52:49 [gemini-3.1-pro] 				sysparts.push({text});
2026-04-07 19:52:49 [gemini-3.1-pro] 				break;
2026-04-07 19:52:49 [gemini-3.1-pro] 			case "assistant":{
2026-04-07 19:52:49 [gemini-3.1-pro] 					if (item.tool_calls) {
2026-04-07 19:52:49 [gemini-3.1-pro] 						const parts = [];
2026-04-07 19:52:49 [gemini-3.1-pro] 						for (const tc of item.tool_calls) {
2026-04-07 19:52:49 [gemini-3.1-pro] 							parts.push({
2026-04-07 19:52:49 [gemini-3.1-pro] 								functionCall: {
2026-04-07 19:52:49 [gemini-3.1-pro] 									name: tc.function.name,
2026-04-07 19:52:49 [gemini-3.1-pro] 									args: JSON.parse(tc.function.arguments)
2026-04-07 19:52:49 [gemini-3.1-pro] 								}
2026-04-07 19:52:49 [gemini-3.1-pro] 							});
2026-04-07 19:52:49 [gemini-3.1-pro] 						}
2026-04-07 19:52:49 [gemini-3.1-pro] 						contents.push({ role: "model", parts });
2026-04-07 19:52:49 [gemini-3.1-pro] 					} else {
2026-04-07 19:52:49 [gemini-3.1-pro] 						contents.push({ role: "model", parts: [{ text: item.content || "" }] });
2026-04-07 19:52:49 [gemini-3.1-pro] 					}
2026-04-07 19:52:49 [gemini-3.1-pro] 				}
2026-04-07 19:52:49 [gemini-3.1-pro] 				break;
2026-04-07 19:52:49 [gemini-3.1-pro] 			case "user":{
2026-04-07 19:52:49 [gemini-3.1-pro] 					if(debugging) echo("[GEMINI] prepare",item);
2026-04-07 19:52:49 [gemini-3.1-pro] 					if(item.name=="blob"){
2026-04-07 19:52:49 [gemini-3.1-pro] 						blob=JSON.parse(text);
2026-04-07 19:52:49 [gemini-3.1-pro] 						continue;
2026-04-07 19:52:49 [gemini-3.1-pro] 					}
2026-04-07 19:52:49 [gemini-3.1-pro] 					// should this be title?
2026-04-07 19:52:49 [gemini-3.1-pro] 					if(item.name=="image"){
2026-04-07 19:52:49 [gemini-3.1-pro] 						const mimeType=blob.type;
2026-04-07 19:52:49 [gemini-3.1-pro] 						const data=text;
2026-04-07 19:52:49 [gemini-3.1-pro] 						echo("[GEMINI] image",mimeType);
2026-04-07 19:52:49 [gemini-3.1-pro] 						contents.push({role:"user",parts:[{inlineData:{mimeType,data}}]});
2026-04-07 19:52:49 [gemini-3.1-pro] 						continue;
2026-04-07 19:52:49 [gemini-3.1-pro] 					}
2026-04-07 19:52:49 [gemini-3.1-pro] 					if(item.content?.length){
2026-04-07 19:52:49 [gemini-3.1-pro] 						contents.push({role:"user",parts:[{text:item.content}]});
2026-04-07 19:52:49 [gemini-3.1-pro] 					}
2026-04-07 19:52:49 [gemini-3.1-pro] 				}
2026-04-07 19:52:49 [gemini-3.1-pro] 				break;
2026-04-07 19:52:49 [gemini-3.1-pro] 			case "tool":{
2026-04-07 19:52:49 [gemini-3.1-pro] 					try{
2026-04-07 19:52:49 [gemini-3.1-pro] 						const functionResponse={name:item.name,response:JSON.parse(text)};
2026-04-07 19:52:49 [gemini-3.1-pro] 						if (debugging) echo("[GEMINI] functionResponse",functionResponse);
2026-04-07 19:52:49 [gemini-3.1-pro] 						contents.push({role:"function",parts:[{functionResponse}] });
2026-04-07 19:52:49 [gemini-3.1-pro] 					}catch(e){
2026-04-07 19:52:49 [gemini-3.1-pro] 						if (debugging) echo("[GEMINI] tool crash",e);
2026-04-07 19:52:49 [gemini-3.1-pro] 					}
2026-04-07 19:52:49 [gemini-3.1-pro] 				}
2026-04-07 19:52:49 [gemini-3.1-pro] 				break;
2026-04-07 19:52:49 [gemini-3.1-pro] 		}
2026-04-07 19:52:49 [gemini-3.1-pro] 	}
2026-04-07 19:52:49 [gemini-3.1-pro] 
2026-04-07 19:52:49 [gemini-3.1-pro] 	// TODO: enable disable tools
2026-04-07 19:52:49 [gemini-3.1-pro] 	// TODO: tools and toolsconfig support
2026-04-07 19:52:49 [gemini-3.1-pro] 
2026-04-07 19:52:49 [gemini-3.1-pro] 	const tools=payload.tools?geminiTools(payload):[];
2026-04-07 19:52:49 [gemini-3.1-pro] 
2026-04-07 19:52:50 [gemini-3.1-pro] 	//system_instruction
2026-04-07 19:52:50 [gemini-3.1-pro] 
2026-04-07 19:52:50 [gemini-3.1-pro] 	const temperature=grokTemperature;
2026-04-07 19:52:50 [gemini-3.1-pro] 
