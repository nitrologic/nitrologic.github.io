2026-04-18 00:18:33 [kimi-k2.5] constexpr float PIO_CLOCK_FREQ = 148.5f; // MHz
2026-04-18 00:18:33 [kimi-k2.5] constexpr float WST_CLKDIV = PIO_CLOCK_FREQ / (WST_BIT_RATE * 2.0f); // 2 cycles per bit
