2026-04-07 19:52:52 [gemini-3.1-pro] function prepareCohereRequest(payload){
2026-04-07 19:52:52 [gemini-3.1-pro] 	const history=[];
2026-04-07 19:52:52 [gemini-3.1-pro] 	let blob={};
2026-04-07 19:52:52 [gemini-3.1-pro] 	for(const item of payload.messages){
2026-04-07 19:52:52 [gemini-3.1-pro] 		const content=item.content;
2026-04-07 19:52:52 [gemini-3.1-pro] 		switch(item.role){
2026-04-07 19:52:52 [gemini-3.1-pro] 			case "system":
2026-04-07 19:52:52 [gemini-3.1-pro] 				history.push({role:"system",content});
2026-04-07 19:52:52 [gemini-3.1-pro] 				break;
2026-04-07 19:52:52 [gemini-3.1-pro] 			case "user":
2026-04-07 19:52:52 [gemini-3.1-pro] 				if(item.name=="blob"){
2026-04-07 19:52:52 [gemini-3.1-pro] 					blob=JSON.parse(content);
2026-04-07 19:52:52 [gemini-3.1-pro] 					continue;
2026-04-07 19:52:52 [gemini-3.1-pro] 				}
2026-04-07 19:52:52 [gemini-3.1-pro] 				if(item.name=="image"){
2026-04-07 19:52:52 [gemini-3.1-pro] 					const image_url={url:"https://jpeg.org/images/jpeg-home.jpg"}
2026-04-07 19:52:52 [gemini-3.1-pro] 					history.push({role:"user",content:[{type:"image_url",image_url}]});
2026-04-07 19:52:52 [gemini-3.1-pro] 					continue;
2026-04-07 19:52:52 [gemini-3.1-pro] 				}
2026-04-07 19:52:52 [gemini-3.1-pro] 				history.push({role:"user",content});
2026-04-07 19:52:52 [gemini-3.1-pro] 				break;
2026-04-07 19:52:52 [gemini-3.1-pro] 			case "assistant":
2026-04-07 19:52:52 [gemini-3.1-pro] 				history.push({role:"assistant",content});
2026-04-07 19:52:52 [gemini-3.1-pro] 				break;
2026-04-07 19:52:52 [gemini-3.1-pro] 		}
2026-04-07 19:52:52 [gemini-3.1-pro] 	}
2026-04-07 19:52:52 [gemini-3.1-pro] 	const temperature=grokTemperature;
2026-04-07 19:52:52 [gemini-3.1-pro] 	const request={
2026-04-07 19:52:52 [gemini-3.1-pro] 		model:payload.model,
2026-04-07 19:52:52 [gemini-3.1-pro] 		temperature,
2026-04-07 19:52:52 [gemini-3.1-pro] 		stream:false,
2026-04-07 19:52:52 [gemini-3.1-pro] 		messages:history
2026-04-07 19:52:52 [gemini-3.1-pro] 	};
2026-04-07 19:52:52 [gemini-3.1-pro] 	return request;
2026-04-07 19:52:52 [gemini-3.1-pro] }
