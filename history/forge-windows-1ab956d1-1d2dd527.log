2026-04-17 19:19:25 [gemini-3.1-pro] 	for(int y=0;y<2;y++){
2026-04-17 19:19:25 [gemini-3.1-pro] 		for(int x=0;x<32;x++){
2026-04-17 19:19:25 [gemini-3.1-pro] 			int cc=x+y*32;
2026-04-17 19:19:25 [gemini-3.1-pro] 			// Doubled Y (120, 20)
2026-04-17 19:19:25 [gemini-3.1-pro] 			drawC64Char(cc,420+x*8,120+y*20);
2026-04-17 19:19:25 [gemini-3.1-pro] 		}
2026-04-17 19:19:25 [gemini-3.1-pro] 	}
2026-04-17 19:19:25 [gemini-3.1-pro] 	return 0;
