2026-04-07 19:52:39 [gemini-3.1-pro] function listHistory(){
2026-04-07 19:52:39 [gemini-3.1-pro] 	const wide=terminalColumns-statsColumn;
2026-04-07 19:52:39 [gemini-3.1-pro] 	const history=rohaHistory;
2026-04-07 19:52:39 [gemini-3.1-pro] 	let total=0;
2026-04-07 19:52:39 [gemini-3.1-pro] 	let cost=0;
2026-04-07 19:52:39 [gemini-3.1-pro] 	for(let i=0;i<history.length;i++){
2026-04-07 19:52:39 [gemini-3.1-pro] 		const item=history[i];
2026-04-07 19:52:39 [gemini-3.1-pro] 		const content=readable(item.content);
2026-04-07 19:52:39 [gemini-3.1-pro] 		const clip=content.substring(0,wide);
2026-04-07 19:52:39 [gemini-3.1-pro] 		const size="("+content.length+"B)";
2026-04-07 19:52:39 [gemini-3.1-pro] 		const role=item.role.padEnd(12," ");
2026-04-07 19:52:39 [gemini-3.1-pro] 		const from=itemSource(item).padEnd(15," ");
2026-04-07 19:52:39 [gemini-3.1-pro] 		const name=("["+itemSource(item)+"]");
2026-04-07 19:52:39 [gemini-3.1-pro] 		const iii=String(i).padStart(3,"0");
2026-04-07 19:52:39 [gemini-3.1-pro] 		const spend=item.price?("$"+item.price.toFixed(4)):"";	//item.emoji+" "+
2026-04-07 19:52:39 [gemini-3.1-pro] 		const seconds=item.elapsed?(item.elapsed.toFixed(2)+"s"):"";
2026-04-07 19:52:39 [gemini-3.1-pro] 		echo(iii,name,clip,size,spend,seconds);
2026-04-07 19:52:39 [gemini-3.1-pro] 		total+=content.length;
2026-04-07 19:52:39 [gemini-3.1-pro] 		cost+=item.price||0;
2026-04-07 19:52:39 [gemini-3.1-pro] 	}
2026-04-07 19:52:39 [gemini-3.1-pro] 	const size=unitString(total,4,"B");
2026-04-07 19:52:39 [gemini-3.1-pro] 	echo("History size",size," cost ",cost.toFixed(4));
2026-04-07 19:52:39 [gemini-3.1-pro] }
2026-04-07 19:52:39 [gemini-3.1-pro] function logHistory(){
