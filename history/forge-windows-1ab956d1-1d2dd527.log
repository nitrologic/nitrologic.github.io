2026-04-07 19:52:53 [gemini-3.1-pro] 		async function createCohereCompletion(payload) {
2026-04-07 19:52:53 [gemini-3.1-pro] 			const model=payload.model;
2026-04-07 19:52:53 [gemini-3.1-pro] 			const content=prepareCohereRequest(payload);
