2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] void initTeletext() {
2026-04-17 22:09:02 [gemini-3.1-pro] 	int p = 0;
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 	// --- EVEN FIELD ---
2026-04-17 22:09:02 [gemini-3.1-pro] 	for(int i=0; i<6; i++) wstEven[p++] = 0; // Skip 6
2026-04-17 22:09:02 [gemini-3.1-pro] 	wstEven[p++] = 359;                      // Transmit Command
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 	// Generate Page 100 (Mag 1, Tens 0, Units 0)
2026-04-17 22:09:02 [gemini-3.1-pro] 	build_wst_header(1, 0, 0, " TOUCHGRASS WST GENERATOR 2026  ", &wstEven[p]);
2026-04-17 22:09:02 [gemini-3.1-pro] 	p += 12;
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 	for(int i=0; i<305; i++) wstEven[p++] = 0; // Skip 305
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 	// --- ODD FIELD ---
2026-04-17 22:09:02 [gemini-3.1-pro] 	p = 0;
2026-04-17 22:09:02 [gemini-3.1-pro] 	for(int i=0; i<6; i++) wstOdd[p++] = 0;  // Skip 6
2026-04-17 22:09:02 [gemini-3.1-pro] 	wstOdd[p++] = 359;                       // Transmit Command
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 	build_wst_header(1, 0, 0, " TOUCHGRASS WST GENERATOR 2026  ", &wstOdd[p]);
2026-04-17 22:09:02 [gemini-3.1-pro] 	p += 12;
2026-04-17 22:09:02 [gemini-3.1-pro] 
2026-04-17 22:09:02 [gemini-3.1-pro] 	for(int i=0; i<306; i++) wstOdd[p++] = 0; // Skip 306
2026-04-17 22:09:02 [gemini-3.1-pro] }
2026-04-17 22:09:02 [gemini-3.1-pro] 
