2026-04-07 19:52:47 [gemini-3.1-pro] async function geminiSay(content:string,voiceName="Kore"){
2026-04-07 19:52:47 [gemini-3.1-pro] 	const endpoint=rohaEndpoint["gemini"];
2026-04-07 19:52:47 [gemini-3.1-pro] 	const apiKey=endpoint.apiKey;
2026-04-07 19:52:47 [gemini-3.1-pro] 	const genAI=new GoogleGenerativeAI(apiKey);
2026-04-07 19:52:47 [gemini-3.1-pro] 	const model = genAI.getGenerativeModel({ model: previewTTS });
2026-04-07 19:52:47 [gemini-3.1-pro] 	const packet = {
2026-04-07 19:52:47 [gemini-3.1-pro] 		contents: [{parts: [{ text: content }],},],
2026-04-07 19:52:47 [gemini-3.1-pro] 		generationConfig:{responseModalities:["AUDIO"],speechConfig:{voiceConfig:{prebuiltVoiceConfig:{voiceName},},},},
