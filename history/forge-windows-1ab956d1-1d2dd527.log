2026-04-17 22:17:34 [gemini-3.1-pro] // Builds a 46-byte packet (1 byte delay + 45 byte WST) and packs into 12 words
2026-04-17 22:17:34 [gemini-3.1-pro] void build_wst_header(int mag, int page_tens, int page_units, const char* text, uint32_t* out_words) {
2026-04-17 22:17:34 [gemini-3.1-pro] 	uint8_t packet[48] = {0}; // Zero initialized
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[0] = 0x00; // 1.15us Delay to hit the 12.0us CRI sweet spot
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[1] = 0x55; packet[2] = 0x55; // Clock Run-In
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[3] = 0x27; // Framing Code (11100100 transmitted LSB first)
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] 	// Magazine and Row Address (Row = 0 for Header)
2026-04-17 22:17:34 [gemini-3.1-pro] 	mag &= 7;
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[4] = HAMMING_84[mag & 1];
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[5] = HAMMING_84[(mag >> 1) & 3];
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] 	// Page Number (Tens and Units)
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[6] = HAMMING_84[page_units & 0xF];
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[7] = HAMMING_84[page_tens & 0xF];
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] 	// Subcode (0000) and Control Bits (Defaults)
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[8] = HAMMING_84[0]; packet[9] = HAMMING_84[0];
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[10] = HAMMING_84[0]; packet[11] = HAMMING_84[0];
2026-04-17 22:17:34 [gemini-3.1-pro] 	packet[12] = HAMMING_84[0]; packet[13] = HAMMING_84[0];
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] 	// 32 characters of Header Text
2026-04-17 22:17:34 [gemini-3.1-pro] 	for (int i = 0; i < 32; i++) {
2026-04-17 22:17:34 [gemini-3.1-pro] 		char c = (text && text[i]) ? text[i] : ' ';
2026-04-17 22:17:34 [gemini-3.1-pro] 		packet[14 + i] = oddParity(c);
2026-04-17 22:17:34 [gemini-3.1-pro] 	}
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] 	// Pack into 12 uint32_t DMA words (LSB first)
2026-04-17 22:17:34 [gemini-3.1-pro] 	for (int i = 0; i < 12; i++) {
2026-04-17 22:17:34 [gemini-3.1-pro] 		out_words[i] = 0;
2026-04-17 22:17:34 [gemini-3.1-pro] 		for (int b = 0; b < 4; b++) {
2026-04-17 22:17:34 [gemini-3.1-pro] 			int idx = (i * 4) + b;
2026-04-17 22:17:34 [gemini-3.1-pro] 			out_words[i] |= (uint32_t)packet[idx] << (b * 8);
2026-04-17 22:17:35 [gemini-3.1-pro] 		}
2026-04-17 22:17:35 [gemini-3.1-pro] 	}
2026-04-17 22:17:35 [gemini-3.1-pro] }
