2026-04-07 19:52:50 [gemini-3.1-pro] 		generationConfig:{temperature},
2026-04-07 19:52:50 [gemini-3.1-pro] 		contents,
2026-04-07 19:52:50 [gemini-3.1-pro] 		tools
2026-04-07 19:52:50 [gemini-3.1-pro] 	};
2026-04-07 19:52:50 [gemini-3.1-pro] 
2026-04-07 19:52:50 [gemini-3.1-pro] 	if(debugging) echo("[GEMINI] request",request);
2026-04-07 19:52:50 [gemini-3.1-pro] 
2026-04-07 19:52:50 [gemini-3.1-pro] 	return request;
2026-04-07 19:52:50 [gemini-3.1-pro] }
