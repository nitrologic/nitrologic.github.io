2026-04-17 22:17:34 [gemini-3.1-pro] // Pre-calculated Hamming 8/4 encoding table
2026-04-17 22:17:34 [gemini-3.1-pro] const uint8_t HAMMING_84[16] = {
2026-04-17 22:17:34 [gemini-3.1-pro] 	0x15, 0x02, 0x49, 0x5E, 0x64, 0x73, 0x38, 0x2F,
2026-04-17 22:17:34 [gemini-3.1-pro] 	0xD0, 0xC7, 0x8C, 0x9B, 0xA1, 0xB6, 0xFD, 0xEA
2026-04-17 22:17:34 [gemini-3.1-pro] };
2026-04-17 22:17:34 [gemini-3.1-pro] 
2026-04-17 22:17:34 [gemini-3.1-pro] uint8_t oddParity(char c) {
2026-04-17 22:17:34 [gemini-3.1-pro] 	uint8_t b = c & 0x7F;
2026-04-17 22:17:34 [gemini-3.1-pro] 	uint8_t parity = 1;
2026-04-17 22:17:34 [gemini-3.1-pro] 	for (int i = 0; i < 7; i++) {
2026-04-17 22:17:34 [gemini-3.1-pro] 		if (b & (1 << i)) parity ^= 1;
2026-04-17 22:17:34 [gemini-3.1-pro] 	}
2026-04-17 22:17:34 [gemini-3.1-pro] 	return b | (parity << 7);
2026-04-17 22:17:34 [gemini-3.1-pro] }
