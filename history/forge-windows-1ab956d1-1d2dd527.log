2026-04-23 12:23:03 [gemini-3.1-pro] 	for(int i=0; i<skip1; i++) wstEven[p++] = 0;
2026-04-23 12:23:03 [gemini-3.1-pro] 	wstEven[p++] = 368+16;
2026-04-23 12:23:03 [gemini-3.1-pro] 	wstHeader(1, 0, 0, title32, &wstEven[p]);p += 12;
2026-04-23 12:23:03 [gemini-3.1-pro] 	wstEven[p++] = 368+16;
2026-04-23 12:23:03 [gemini-3.1-pro] 	wstBody(1, 1, line40, &wstEven[p]);p += 12;
