2026-04-07 19:52:39 [gemini-3.1-pro] 		const spend=item.price?(item.emoji+" "+item.price.toFixed(4)) :"";
2026-04-07 19:52:39 [gemini-3.1-pro] 		const seconds=item.elapsed?(item.elapsed.toFixed(2)+"s"):"";
2026-04-07 19:52:39 [gemini-3.1-pro] 		const src=itemSource(item);
