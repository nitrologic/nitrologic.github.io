2026-04-07 19:52:38 [gemini-3.1-pro] function echoContent(content,wide,left,right){
2026-04-07 19:52:38 [gemini-3.1-pro] 	const chars=wide-(left+right);
2026-04-07 19:52:38 [gemini-3.1-pro] 	const indent=" ".repeat(left);
2026-04-07 19:52:38 [gemini-3.1-pro] 	let cursor=0;
2026-04-07 19:52:38 [gemini-3.1-pro] 	while(cursor<content.length){
2026-04-07 19:52:38 [gemini-3.1-pro] 		let line=content.substring(cursor,cursor+chars);
2026-04-07 19:52:38 [gemini-3.1-pro] 		let n=line.indexOf("\n");
2026-04-07 19:52:38 [gemini-3.1-pro] 		if(n==-1) n=line.lastIndexOf(" ");
2026-04-07 19:52:38 [gemini-3.1-pro] 		if(n!=-1) line=line.substring(0,n+1);
2026-04-07 19:52:38 [gemini-3.1-pro] 		if(line.length){
2026-04-07 19:52:38 [gemini-3.1-pro] 			echo(indent+line);
2026-04-07 19:52:38 [gemini-3.1-pro] 			cursor+=line.length;
2026-04-07 19:52:38 [gemini-3.1-pro] 		}
2026-04-07 19:52:38 [gemini-3.1-pro] 	}
2026-04-07 19:52:38 [gemini-3.1-pro] }
