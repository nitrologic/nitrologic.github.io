2026-04-07 19:52:41 [gemini-3.1-pro] function unitString(value,precision=2,type=""){
2026-04-07 19:52:41 [gemini-3.1-pro] 	if (typeof value !== 'number' || isNaN(value)) return "NaN";
2026-04-07 19:52:41 [gemini-3.1-pro] 	const units=["","K","M","G","T"];
2026-04-07 19:52:41 [gemini-3.1-pro] 	const abs=Math.abs(value);
2026-04-07 19:52:41 [gemini-3.1-pro] 	const unit=(Math.log10(abs)/3)|0;
2026-04-07 19:52:41 [gemini-3.1-pro] 	if(unit>0){
2026-04-07 19:52:41 [gemini-3.1-pro] 		if(unit>4)unit=4;
2026-04-07 19:52:41 [gemini-3.1-pro] 		let n=value / Math.pow(10, unit*3);
2026-04-07 19:52:41 [gemini-3.1-pro] 		const digits=Math.max(1, String(Math.floor(n)).length);
2026-04-07 19:52:41 [gemini-3.1-pro] 		n=n.toFixed(Math.max(0, precision - digits));
2026-04-07 19:52:41 [gemini-3.1-pro] 		return n+units[unit]+type;
2026-04-07 19:52:41 [gemini-3.1-pro] 	}
2026-04-07 19:52:41 [gemini-3.1-pro] 	return String(value)+type;
