2026-04-08 19:45:35 [gemini-3.1-pro] The `400 Invalid request: toolcallid is not found` error with Kimi (and other strict
2026-04-08 19:45:35 [gemini-3.1-pro] OpenAI-compatible APIs) usually occurs when the API fails to map a `tool` message back to its
2026-04-08 19:45:35 [gemini-3.1-pro] preceding `assistant` message.
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] There are three issues in your payload formatting causing this:
2026-04-08 19:45:35 [gemini-3.1-pro] 1. Missing `content: null`: Strict APIs require the `content` field to be present in
2026-04-08 19:45:35 [gemini-3.1-pro] `assistant` messages, even if it's `null`. If it's `undefined`, `JSON.stringify` strips the key
2026-04-08 19:45:35 [gemini-3.1-pro] entirely, causing the API to reject or misinterpret the message and drop its `tool_calls`.
2026-04-08 19:45:35 [gemini-3.1-pro] 2. Extra fields in `tool` messages: OpenAI's spec for `role: "tool"` only allows `role`,
2026-04-08 19:45:35 [gemini-3.1-pro] `content`, and `toolcallid`. Passing `name` can cause strict API gateways to silently drop
2026-04-08 19:45:35 [gemini-3.1-pro] the `toolcallid` or fail validation.
2026-04-08 19:45:35 [gemini-3.1-pro] 3. Switching on the wrong variable: In `plainHistory`, you reassign `role` to `"user"` if
2026-04-08 19:45:35 [gemini-3.1-pro] the names don't match, but then mistakenly switch on `item.role` instead of the evaluated `role`.
2026-04-08 19:45:35 [gemini-3.1-pro] 4. Invalid fallback ID: In `processToolCalls`, `!tool.function?.name` evaluates to a
2026-04-08 19:45:35 [gemini-3.1-pro] boolean (`false`), which Kimi will reject if it ever falls back to it.
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] Here are the corrected functions.
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] function plainHistory(history, model) {
2026-04-08 19:45:35 [gemini-3.1-pro] 	const list = [];
2026-04-08 19:45:35 [gemini-3.1-pro] 	for (const _item of history) {
2026-04-08 19:45:35 [gemini-3.1-pro] 		const item = { ..._item };
2026-04-08 19:45:35 [gemini-3.1-pro] 		const name = item.name || "anon";
2026-04-08 19:45:35 [gemini-3.1-pro] 		let role = item.role;
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] 		if (role == "assistant") {
2026-04-08 19:45:35 [gemini-3.1-pro] 			if (name != model) {
2026-04-08 19:45:35 [gemini-3.1-pro] 				role = "user";
2026-04-08 19:45:35 [gemini-3.1-pro] 			}
2026-04-08 19:45:35 [gemini-3.1-pro] 		}
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] 		switch (role) {
2026-04-08 19:45:35 [gemini-3.1-pro] 			case "system":
2026-04-08 19:45:35 [gemini-3.1-pro] 				list.push({ role: "system", content: item.content });
2026-04-08 19:45:35 [gemini-3.1-pro] 				break;
2026-04-08 19:45:35 [gemini-3.1-pro] 			case "assistant":
2026-04-08 19:45:35 [gemini-3.1-pro] 				const content = item.content !== undefined ? item.content : null;
2026-04-08 19:45:35 [gemini-3.1-pro] 				if (item.tool_calls) {
2026-04-08 19:45:35 [gemini-3.1-pro] 					list.push({ role: "assistant", content: content, tool_calls: item.tool_calls });
2026-04-08 19:45:35 [gemini-3.1-pro] 				} else {
2026-04-08 19:45:35 [gemini-3.1-pro] 					list.push({ role: "assistant", content: content || "" });
2026-04-08 19:45:35 [gemini-3.1-pro] 				}
2026-04-08 19:45:35 [gemini-3.1-pro] 				break;
2026-04-08 19:45:35 [gemini-3.1-pro] 			case "user": {
2026-04-08 19:45:35 [gemini-3.1-pro] 					list.push({ role: role, content: item.content || "", name });
2026-04-08 19:45:35 [gemini-3.1-pro] 				}
2026-04-08 19:45:35 [gemini-3.1-pro] 				break;
2026-04-08 19:45:35 [gemini-3.1-pro] 			case "tool":
2026-04-08 19:45:35 [gemini-3.1-pro] 				if (roha.config.debugging) echo("[TOOL]", item);
2026-04-08 19:45:35 [gemini-3.1-pro] 				const toolContent = textify(item.content);
2026-04-08 19:45:35 [gemini-3.1-pro] 				// Strict APIs reject the "name" field on "tool" role messages
2026-04-08 19:45:35 [gemini-3.1-pro] 				const entry = { role: "tool", tool_call_id: item.tool_call_id, content: toolContent };
2026-04-08 19:45:35 [gemini-3.1-pro] 				list.push(entry);
2026-04-08 19:45:35 [gemini-3.1-pro] 				break;
2026-04-08 19:45:35 [gemini-3.1-pro] 		}
2026-04-08 19:45:35 [gemini-3.1-pro] 	}
2026-04-08 19:45:35 [gemini-3.1-pro] 	return list;
2026-04-08 19:45:35 [gemini-3.1-pro] }
2026-04-08 19:45:35 [gemini-3.1-pro] 
2026-04-08 19:45:35 [gemini-3.1-pro] async function processToolCalls(calls) {
2026-04-08 19:45:35 [gemini-3.1-pro] 	const results = [];
2026-04-08 19:45:35 [gemini-3.1-pro] 	for (const tool of calls) {
2026-04-08 19:45:35 [gemini-3.1-pro] 		// Fallback to Kimi/OpenAI compatible generated ID instead of a boolean
2026-04-08 19:45:35 [gemini-3.1-pro] 		const id = tool.id || ("call_" + Math.random().toString(36).substring(2, 10));
2026-04-08 19:45:36 [gemini-3.1-pro] 		const name = tool.function?.name || "unknown";
2026-04-08 19:45:36 [gemini-3.1-pro] 		if (roha.config.debugging) echo("[RELAY] processToolCalls", id, tool);
2026-04-08 19:45:36 [gemini-3.1-pro] 
2026-04-08 19:45:36 [gemini-3.1-pro] 		if (!tool.id || !tool.function?.name) {
2026-04-08 19:45:36 [gemini-3.1-pro] 			const result = { tool_call_id: id, name, content: JSON.stringify({ error: "Invalid tool call format" }) };
2026-04-08 19:45:36 [gemini-3.1-pro] 			rohaCallNames[id] = result.name;
2026-04-08 19:45:36 [gemini-3.1-pro] 			results.push(result);
2026-04-08 19:45:36 [gemini-3.1-pro] 			await logForge("processToolCalls error");
2026-04-08 19:45:36 [gemini-3.1-pro] 			continue;
2026-04-08 19:45:36 [gemini-3.1-pro] 		}
2026-04-08 19:45:36 [gemini-3.1-pro] 
2026-04-08 19:45:36 [gemini-3.1-pro] 		try {
2026-04-08 19:45:36 [gemini-3.1-pro] 			const result = await onCall(tool);
2026-04-08 19:45:36 [gemini-3.1-pro] 			rohaCallNames[id] = name;
2026-04-08 19:45:36 [gemini-3.1-pro] 			results.push({ tool_call_id: id, name, content: result });
2026-04-08 19:45:36 [gemini-3.1-pro] 		} catch (e) {
2026-04-08 19:45:36 [gemini-3.1-pro] 			echo("[RELAY] processToolCalls error", e);
2026-04-08 19:45:36 [gemini-3.1-pro] 		}
2026-04-08 19:45:36 [gemini-3.1-pro] 	}
2026-04-08 19:45:36 [gemini-3.1-pro] 	return results;
2026-04-08 19:45:36 [gemini-3.1-pro] }
