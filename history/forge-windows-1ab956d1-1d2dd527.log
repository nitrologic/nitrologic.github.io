2026-04-07 19:52:53 [gemini-3.1-pro] 			try{
2026-04-07 19:52:53 [gemini-3.1-pro] 				const response=await fetch(url,{method:"POST",headers,body:JSON.stringify(content)});
2026-04-07 19:52:53 [gemini-3.1-pro] 				if(roha.config.debugging){
2026-04-07 19:52:53 [gemini-3.1-pro] 					echo("[cohere] response.ok",response.ok);
2026-04-07 19:52:53 [gemini-3.1-pro] 				}
2026-04-07 19:52:53 [gemini-3.1-pro] 				if (response.ok) {
2026-04-07 19:52:53 [gemini-3.1-pro] 					const reply=[];
2026-04-07 19:52:53 [gemini-3.1-pro] 					const json=await response.json();
2026-04-07 19:52:53 [gemini-3.1-pro] 					const role=json.message.role;
2026-04-07 19:52:53 [gemini-3.1-pro] 					for(const item of json.message.content){
2026-04-07 19:52:53 [gemini-3.1-pro] 						if(item.type=="text") reply.push(item.text);
2026-04-07 19:52:53 [gemini-3.1-pro] 					}
2026-04-07 19:52:53 [gemini-3.1-pro] 					const text=reply.join("\n");
2026-04-07 19:52:53 [gemini-3.1-pro] 					// echo("[cohere]",text)
2026-04-07 19:52:53 [gemini-3.1-pro] 					const tokens=json.usage.tokens;
2026-04-07 19:52:53 [gemini-3.1-pro] 					const total_tokens=tokens.input_tokens+tokens.output_tokens;
2026-04-07 19:52:53 [gemini-3.1-pro] 					const usage={prompt_tokens:tokens.input_tokens,completion_tokens:tokens.output_tokens,total_tokens};
2026-04-07 19:52:53 [gemini-3.1-pro] 					return {model,choices:[{message:{content:text}}],usage};
2026-04-07 19:52:53 [gemini-3.1-pro] 				}
2026-04-07 19:52:53 [gemini-3.1-pro] 				if(roha.config.debugging){
2026-04-07 19:52:53 [gemini-3.1-pro] 					echo("[cohere] status",response.status,response.statusText);
2026-04-07 19:52:53 [gemini-3.1-pro] 					echo("[cohere] content",content);
2026-04-07 19:52:53 [gemini-3.1-pro] 				}
2026-04-07 19:52:53 [gemini-3.1-pro] 			}catch(e){
2026-04-07 19:52:53 [gemini-3.1-pro] 				echo("[cohere] exception",e.message);
2026-04-07 19:52:53 [gemini-3.1-pro] 			}
2026-04-07 19:52:53 [gemini-3.1-pro] 			const temperature=grokTemperature;
2026-04-07 19:52:53 [gemini-3.1-pro] 			return {model,temperature,choices:[],usage};
