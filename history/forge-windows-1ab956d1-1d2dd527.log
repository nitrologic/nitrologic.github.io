2026-04-07 19:52:45 [gemini-3.1-pro] 				table.length = 0;
2026-04-07 19:52:45 [gemini-3.1-pro] 			}
2026-04-07 19:52:45 [gemini-3.1-pro] 			if (line.startsWith("```")) {
