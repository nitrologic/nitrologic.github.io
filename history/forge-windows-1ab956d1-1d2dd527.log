2026-04-07 19:52:48 [gemini-3.1-pro] // Create a WAV header (44 bytes)
2026-04-07 19:52:48 [gemini-3.1-pro] 	const header = new Uint8Array(44);
2026-04-07 19:52:48 [gemini-3.1-pro] 	const view = new DataView(header.buffer);
2026-04-07 19:52:48 [gemini-3.1-pro] // RIFF chunk descriptor
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(0, 0x52494646, false); // "RIFF"
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(4, 36 + audio.length, true); // File size - 8
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(8, 0x57415645, false); // "WAVE"
2026-04-07 19:52:48 [gemini-3.1-pro] // Format subchunk
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(12, 0x666d7420, false); // "fmt "
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(16, 16, true); // Subchunk size (16 for PCM)
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint16(20, 1, true); // Audio format (1 = PCM)
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint16(22, 1, true); // Channels (1 = mono)
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(24, 24000, true); // Sample rate (24kHz)
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(28, 24000 * 2, true); // Byte rate (sample rate * bytes per sample)
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint16(32, 2, true); // Block align (channels * bytes per sample)
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint16(34, 16, true); // Bits per sample (16-bit)
2026-04-07 19:52:48 [gemini-3.1-pro] // Data subchunk
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(36, 0x64617461, false); // "data"
2026-04-07 19:52:48 [gemini-3.1-pro] 	view.setUint32(40, audio.length, true); // Data size
2026-04-07 19:52:48 [gemini-3.1-pro] // Combine header and audio data
2026-04-07 19:52:48 [gemini-3.1-pro] 	const wavBytes = new Uint8Array(header.length + audio.length);
2026-04-07 19:52:48 [gemini-3.1-pro] 	wavBytes.set(header, 0);
2026-04-07 19:52:48 [gemini-3.1-pro] 	wavBytes.set(audio, header.length);
2026-04-07 19:52:48 [gemini-3.1-pro] 	try {
2026-04-07 19:52:48 [gemini-3.1-pro] 		await Deno.writeFile(filePath, wavBytes);
2026-04-07 19:52:48 [gemini-3.1-pro] 		echo("[SAY]", line);
2026-04-07 19:52:48 [gemini-3.1-pro] 		return filePath;
2026-04-07 19:52:48 [gemini-3.1-pro] 	} catch (error) {
2026-04-07 19:52:48 [gemini-3.1-pro] 		echo("[SAY] Speech save error", error.message);
2026-04-07 19:52:48 [gemini-3.1-pro] 		throw error; // Re-throw to handle the error upstream
2026-04-07 19:52:48 [gemini-3.1-pro] 	}
2026-04-07 19:52:48 [gemini-3.1-pro] }
