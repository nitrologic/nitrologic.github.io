2026-04-07 19:52:47 [gemini-3.1-pro] async function saveGeminiSpeech(audio: Uint8Array, mimeType:string, metaData:string[]): Promise<string> {
2026-04-07 19:52:47 [gemini-3.1-pro] 	// expecting audio/L16;codec=pcm;rate=24000
2026-04-07 19:52:47 [gemini-3.1-pro] 	const format:string = "wav";
2026-04-07 19:52:47 [gemini-3.1-pro] 	const timestamp=Math.floor(Date.now()/1000).toString(16);
2026-04-07 19:52:47 [gemini-3.1-pro] 	const filename=("speech-"+timestamp)+"."+format;
2026-04-07 19:52:48 [gemini-3.1-pro] 	const filePath=resolve(forgePath,filename);
2026-04-07 19:52:48 [gemini-3.1-pro] 	const line="saved "+filename;
