2026-04-06 12:01:57 [gemini-3.1-lite] 		this.bytes.push(this.buffer & 0xFF);
2026-04-06 12:01:57 [gemini-3.1-lite] 	}
2026-04-06 12:01:57 [gemini-3.1-lite] 	return new Uint8Array(this.bytes);
2026-04-06 12:01:57 [gemini-3.1-lite] }
