2026-04-07 19:52:43 [gemini-3.1-pro] function latinString(latin, line: string, space=ThinSpace): string {
2026-04-07 19:52:43 [gemini-3.1-pro] 	const upper=Array.from(latin.upper);
2026-04-07 19:52:43 [gemini-3.1-pro] 	const digits=Array.from(latin.digits);
2026-04-07 19:52:43 [gemini-3.1-pro] 	const lower=latin.lower?Array.from(latin.lower):upper;
2026-04-07 19:52:43 [gemini-3.1-pro] 	let out="";
2026-04-07 19:52:43 [gemini-3.1-pro] 	for (const ch of line) {
2026-04-07 19:52:43 [gemini-3.1-pro] 		const c = ch.charCodeAt(0);
2026-04-07 19:52:43 [gemini-3.1-pro] 		if (c >= 48 && c <= 57) out += digits[c-48];
2026-04-07 19:52:43 [gemini-3.1-pro] 		else if (c >= 65 && c <= 90) out += upper[c-65]+space;
2026-04-07 19:52:43 [gemini-3.1-pro] 		else if (c >= 97 && c <= 122) out += lower[c-97]+space;
2026-04-07 19:52:43 [gemini-3.1-pro] 		else out += ch;
2026-04-07 19:52:43 [gemini-3.1-pro] 	}
2026-04-07 19:52:43 [gemini-3.1-pro] 	return out;
2026-04-07 19:52:43 [gemini-3.1-pro] }
