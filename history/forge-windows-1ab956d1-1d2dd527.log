2026-04-17 22:45:13 [gemini-3.1-pro] 	evenFrame[1] = 308;   // 309 lines of video
2026-04-17 22:45:13 [gemini-3.1-pro] 	evenFrame[2] = 767;
2026-04-17 22:45:13 [gemini-3.1-pro] 
