2026-04-07 19:52:48 [gemini-3.1-pro] function geminiTools(payload){
2026-04-07 19:52:48 [gemini-3.1-pro] 	const functions=[];
2026-04-07 19:52:48 [gemini-3.1-pro] 	for(const tool of payload.tools){
2026-04-07 19:52:48 [gemini-3.1-pro] 		if(tool.type=="function"){
2026-04-07 19:52:48 [gemini-3.1-pro] 			const f=tool.function;
2026-04-07 19:52:48 [gemini-3.1-pro] 			if(f.parameters){
2026-04-07 19:52:48 [gemini-3.1-pro] 				const p=f.parameters;
2026-04-07 19:52:48 [gemini-3.1-pro] 				const d={name:f.name,description:f.description,parameters:{type:p.type,properties:p.properties,required:p.required}};
2026-04-07 19:52:48 [gemini-3.1-pro] 				functions.push(d);
2026-04-07 19:52:48 [gemini-3.1-pro] 			}else{
2026-04-07 19:52:48 [gemini-3.1-pro] 				const d={name:f.name,description:f.description};
2026-04-07 19:52:48 [gemini-3.1-pro] 				functions.push(d);
2026-04-07 19:52:48 [gemini-3.1-pro] 			}
2026-04-07 19:52:48 [gemini-3.1-pro] 		}
2026-04-07 19:52:48 [gemini-3.1-pro] 	}
2026-04-07 19:52:48 [gemini-3.1-pro] 	return [{functionDeclarations:functions}];
2026-04-07 19:52:48 [gemini-3.1-pro] }
