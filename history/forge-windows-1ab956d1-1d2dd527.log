2026-04-23 12:23:03 [gemini-3.1-pro] 	int p = 0;
2026-04-23 12:23:03 [gemini-3.1-pro] 	int skip1=10;
2026-04-23 12:23:03 [gemini-3.1-pro] 	int skip2=297;
