2026-04-01 20:59:31 [nitro@ryzen5] simple way to determine in js if a string is json?
2026-04-01 20:59:35 [gemini-3.1-lite] The most reliable and standard way to check if a string is valid JSON is to attempt to parse it
2026-04-01 20:59:35 [gemini-3.1-lite] within a `try...catch` block.
2026-04-01 20:59:35 [gemini-3.1-lite] 
2026-04-01 20:59:35 [gemini-3.1-lite] 
2026-04-01 20:59:35 [gemini-3.1-lite] function isJson(str) {
2026-04-01 20:59:35 [gemini-3.1-lite] 	try {
2026-04-01 20:59:35 [gemini-3.1-lite] 		JSON.parse(str);
2026-04-01 20:59:35 [gemini-3.1-lite] 	} catch (e) {
2026-04-01 20:59:35 [gemini-3.1-lite] 		return false;
2026-04-01 20:59:35 [gemini-3.1-lite] 	}
2026-04-01 20:59:35 [gemini-3.1-lite] 	return true;
2026-04-01 20:59:35 [gemini-3.1-lite] }
2026-04-01 20:59:36 [gemini-3.1-lite] 
2026-04-01 20:59:36 [gemini-3.1-lite] 
2026-04-01 20:59:36 [gemini-3.1-lite] Important Note
2026-04-01 20:59:36 [gemini-3.1-lite] `JSON.parse()` will return `true` for some values that are technically valid JSON but might not be
2026-04-01 20:59:36 [gemini-3.1-lite] what you expect (like `"123"`, `"true"`, or `"null"`). If you specifically need to ensure the
2026-04-01 20:59:36 [gemini-3.1-lite] string represents a JSON Object or Array, add a type check:
2026-04-01 20:59:36 [gemini-3.1-lite] 
2026-04-01 20:59:36 [gemini-3.1-lite] 
2026-04-01 20:59:36 [gemini-3.1-lite] function isJsonObject(str) {
2026-04-01 20:59:36 [gemini-3.1-lite] 	try {
2026-04-01 20:59:36 [gemini-3.1-lite] 		const result = JSON.parse(str);
2026-04-01 20:59:36 [gemini-3.1-lite] 		return result !== null && typeof result === 'object';
2026-04-01 20:59:36 [gemini-3.1-lite] 	} catch (e) {
2026-04-01 20:59:36 [gemini-3.1-lite] 		return false;
2026-04-01 20:59:36 [gemini-3.1-lite] 	}
2026-04-01 20:59:36 [gemini-3.1-lite] }
2026-04-01 20:59:36 [gemini-3.1-lite] 
2026-04-01 20:59:36 [gemini-3.1-lite] 
