2026-04-07 19:52:45 [gemini-3.1-pro] 			}
2026-04-07 19:52:45 [gemini-3.1-pro] 			result.push(line);
2026-04-07 19:52:45 [gemini-3.1-pro] 		}
2026-04-07 19:52:45 [gemini-3.1-pro] 	}
2026-04-07 19:52:45 [gemini-3.1-pro] 	if (table.length) {
2026-04-07 19:52:45 [gemini-3.1-pro] 		insertTable(result, table, !fenced, true);
2026-04-07 19:52:45 [gemini-3.1-pro] 	}
2026-04-07 19:52:45 [gemini-3.1-pro] 	return result.join("\n");
