27a3ae98 [grok-build-0.1] #🟠nitrologic Relay 2.0.2 grok-build-0.1 𝕏 🪠 0.7° $0.002 3.775KB 13.33s
27a3ae99 [grok-build-0.1] #Yes, Godot has several command-line flags for dumping documentation and API information. These work
27a3ae99 [grok-build-0.1] #well with `--headless`.
27a3ae99 [grok-build-0.1] #
27a3ae99 [grok-build-0.1] #Here are the relevant flags:
27a3ae9a [grok-build-0.1] #
27a3ae9a [grok-build-0.1] #Main Documentation Flags
27a3ae9a [grok-build-0.1] #
27a3ae9a [grok-build-0.1] #╭─────────────────────────────────────┬───────────────────────────────────────────────────────────────────────────────┬─────────────────────────────────────────────╮
27a3ae9b [grok-build-0.1] #│  Flag                               │  Description                                                                  │  Typical Use Case                           │
27a3ae9b [grok-build-0.1] #├─────────────────────────────────────┼───────────────────────────────────────────────────────────────────────────────┼─────────────────────────────────────────────┤
27a3ae9b [grok-build-0.1] #│  `--doctool`                        │  Generates or updates class reference documentation (XML)                     │  Updating docs or generating project docs   │
27a3ae9b [grok-build-0.1] #│  `--dump-extension-api`             │  Dumps the full GDExtension API as `extension_api.json`                       │  GDExtension / C++ binding development      │
27a3ae9c [grok-build-0.1] #│  `--dump-gdextension-interface`     │  Dumps the `gdextension_interface.h` header                                   │  GDExtension development                    │
27a3ae9c [grok-build-0.1] #╰─────────────────────────────────────┴───────────────────────────────────────────────────────────────────────────────┴─────────────────────────────────────────────╯
27a3ae9c [grok-build-0.1] #
27a3ae9c [grok-build-0.1] #Usage Examples
27a3ae9d [grok-build-0.1] #
27a3ae9d [grok-build-0.1] #• 1. Dump the GDExtension API (most commonly used)*
27a3ae9d [grok-build-0.1] #
27a3ae9d [grok-build-0.1] #godot --headless --dump-extension-api
27a3ae9e [grok-build-0.1] #
27a3ae9e [grok-build-0.1] #
27a3ae9e [grok-build-0.1] #This will create a file called `extension_api.json` in the current directory.
27a3ae9e [grok-build-0.1] #
27a3ae9f [grok-build-0.1] #You can also specify an output path:
27a3ae9f [grok-build-0.1] #
27a3ae9f [grok-build-0.1] #godot --headless --dump-extension-api ./api/extension_api.json
27a3aea0 [grok-build-0.1] #
27a3aea0 [grok-build-0.1] #
27a3aea0 [grok-build-0.1] #• 2. Generate documentation with `--doctool`*
27a3aea0 [grok-build-0.1] #
27a3aea1 [grok-build-0.1] ## Basic usage (dumps current engine classes)
27a3aea1 [grok-build-0.1] #godot --headless --doctool
27a3aea1 [grok-build-0.1] #
27a3aea1 [grok-build-0.1] ## Point to a specific output folder
27a3aea2 [grok-build-0.1] #godot --headless --doctool ./docs
27a3aea2 [grok-build-0.1] #
27a3aea2 [grok-build-0.1] #
27a3aea2 [grok-build-0.1] #• 3. Generate documentation for your own project/classes*
27a3aea3 [grok-build-0.1] #
27a3aea3 [grok-build-0.1] #godot --headless --doctool res:// --path /path/to/your/project
27a3aea3 [grok-build-0.1] #
27a3aea3 [grok-build-0.1] #
27a3aea4 [grok-build-0.1] #• 4. Dump the GDExtension interface header*
27a3aea4 [grok-build-0.1] #
27a3aea4 [grok-build-0.1] #godot --headless --dump-gdextension-interface
27a3aea5 [grok-build-0.1] #
27a3aea5 [grok-build-0.1] #
27a3aea5 [grok-build-0.1] #Practical Examples
27a3aea5 [grok-build-0.1] #
27a3aea6 [grok-build-0.1] #
27a3aea6 [grok-build-0.1] ## Dump extension API (very common for GDExtension)
27a3aea6 [grok-build-0.1] #godot --headless --dump-extension-api extension_api.json
27a3aea6 [grok-build-0.1] #
27a3aea7 [grok-build-0.1] ## Generate documentation in a specific folder
27a3aea7 [grok-build-0.1] #godot --headless --doctool ./class_reference
27a3aea7 [grok-build-0.1] #
27a3aea8 [grok-build-0.1] ## Combine with project path
27a3aea8 [grok-build-0.1] #godot --headless --path /path/to/project --dump-extension-api
27a3aea8 [grok-build-0.1] #
27a3aea8 [grok-build-0.1] #
