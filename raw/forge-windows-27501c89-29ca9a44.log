278b7527 [glm-5.3-flash] #🟠nitrologic Relay 2.0.2 glm-5.3-flash Z 🪠 0.7° $0.003 78.26KB 78.06s
278b7527 [glm-5.3-flash] #Yes — TinyUSB's CDC has several checks worth wiring in before you push bursts of samples through
278b7527 [glm-5.3-flash] #it. In rough order of value for what you're about to do:
278b7528 [glm-5.3-flash] #
278b7528 [glm-5.3-flash] #1. DTR — is the port actually open?
278b7528 [glm-5.3-flash] #
278b7528 [glm-5.3-flash] #Your `connected` flag is set by a `vidbit.set` handshake, but USB knows definitively via DTR.
278b7529 [glm-5.3-flash] #Writing into a closed port just silently fills the TX buffer. TinyUSB exposes a weak callback that
278b7529 [glm-5.3-flash] #fires on open/close:
278b7529 [glm-5.3-flash] #
278b7529 [glm-5.3-flash] #
278b752a [glm-5.3-flash] #bool hostOpen=false;
278b752a [glm-5.3-flash] #bool hostClosed=false;
278b752a [glm-5.3-flash] #
278b752a [glm-5.3-flash] #void tud_cdc_line_state_cb(uint8_t itf,bool dtr,bool rts){
278b752b [glm-5.3-flash] #	hostOpen=dtr;
278b752b [glm-5.3-flash] #	if(!dtr){
278b752b [glm-5.3-flash] #		hostClosed=true;	// host vanished mid-stream: abort capture output
278b752b [glm-5.3-flash] #	}
278b752c [glm-5.3-flash] #}
278b752c [glm-5.3-flash] #
278b752c [glm-5.3-flash] #
278b752c [glm-5.3-flash] #If your `picosdk` wrapper already implements this callback, have it expose the same flags rather
278b752d [glm-5.3-flash] #than redefining it. Gate `rpcSend` on `hostOpen` and check `hostClosed` in the sample-stream loop
278b752d [glm-5.3-flash] #next to `watchdog_update()`.
278b752d [glm-5.3-flash] #
278b752e [glm-5.3-flash] #2. TX backpressure
278b752e [glm-5.3-flash] #
278b752e [glm-5.3-flash] #`cdcFlush()` presumably calls `tud_cdc_write_flush()`, which returns the bytes actually moved to
278b752e [glm-5.3-flash] #USB — and accepts less than you gave it when the buffer is full. Checking return values gives you a
278b752f [glm-5.3-flash] #drop counter:
278b752f [glm-5.3-flash] #
278b752f [glm-5.3-flash] #
278b752f [glm-5.3-flash] #uint32_t flushShort=0;
278b752f [glm-5.3-flash] #
278b7530 [glm-5.3-flash] #void cdcFlushChecked(){
278b7530 [glm-5.3-flash] #	uint32_t written=tud_cdc_write_flush();
278b7530 [glm-5.3-flash] #	if(written<tud_cdc_n_write_available(0)){
278b7530 [glm-5.3-flash] #		flushShort++;
278b7531 [glm-5.3-flash] #	}
278b7531 [glm-5.3-flash] #}
278b7531 [glm-5.3-flash] #
278b7532 [glm-5.3-flash] #
278b7532 [glm-5.3-flash] #Also useful before streaming a burst: `tud_cdc_n_write_available(0)` tells you how much room is
278b7532 [glm-5.3-flash] #left, so you can wait for drain instead of overwriting. TX buffer size is `CFG_TUD_CDC_TX_BUFSIZE`
278b7532 [glm-5.3-flash] #in the wrapper's config — worth knowing the number, since your ring buffer sizing depends on how
278b7533 [glm-5.3-flash] #fast the link drains.
278b7533 [glm-5.3-flash] #
278b7533 [glm-5.3-flash] #3. RX overflow
278b7533 [glm-5.3-flash] #
278b7534 [glm-5.3-flash] #If the host floods you while you're busy streaming samples and you don't call `tud_task()` often
278b7534 [glm-5.3-flash] #enough, the RX buffer drops bytes silently — there's no error flag. You can detect the risk
278b7534 [glm-5.3-flash] #condition: buffer completely full means data was almost certainly lost:
278b7534 [glm-5.3-flash] #
278b7535 [glm-5.3-flash] #
278b7535 [glm-5.3-flash] #bool cdcRxOverflow(){
278b7535 [glm-5.3-flash] #	return tud_cdc_n_available(0)>=CFG_TUD_CDC_RX_BUFSIZE;
278b7535 [glm-5.3-flash] #}
278b7536 [glm-5.3-flash] #
278b7536 [glm-5.3-flash] #
278b7536 [glm-5.3-flash] #Call it after long streaming sections. Your shell loop calls `tud_task()` every iteration, so
278b7536 [glm-5.3-flash] #you're probably fine, but during `sampleRom` output the 10 ms sleeps are where backlog builds.
278b7537 [glm-5.3-flash] #
278b7537 [glm-5.3-flash] #4. Free integrity check you already have
278b7537 [glm-5.3-flash] #
278b7537 [glm-5.3-flash] #Your sample lines carry sequential ids (`200001`, `200002`, …). Add a continuity check to rpccoms:
278b7538 [glm-5.3-flash] #if `id != lastId + 1`, lines were lost in transport. Zero device code, and it validates the whole
278b7538 [glm-5.3-flash] #chain — exactly what you want proven before blaming the PIO path for gaps.
278b7538 [glm-5.3-flash] #
278b7538 [glm-5.3-flash] #5. Throughput budget before sizing the PIO ring
278b7539 [glm-5.3-flash] #
278b7539 [glm-5.3-flash] #Worth measuring now: your current `sampleRom` emits ~85-byte JSON lines, 65536 of them, flushing
278b7539 [glm-5.3-flash] #every 8 with `sleep_ms(10)` — that's a floor of ~82 seconds per capture, roughly 70 KB/s. USB FS
278b7539 [glm-5.3-flash] #CDC can do ~1 MB/s, so the sleeps dominate, not the link. A bench method like `vidbit.keys` but
278b753a [glm-5.3-flash] #echoing a few hundred KB, timed on the host, tells you the real drain rate — and that number sizes
278b753a [glm-5.3-flash] #the PIO ring buffer and tells you how many samples per flush you can afford before `sleep_ms`
278b753a [glm-5.3-flash] #becomes unnecessary.
278b753a [glm-5.3-flash] #
278b753b [glm-5.3-flash] #Order of work: DTR callback first (it's the one that prevents silent garbage), then the
278b753b [glm-5.3-flash] #flush-return counter, then the bench. The RX check is nice-to-have.
278b753b [glm-5.3-flash] #
