27a0b0b1 [grok-build-0.1] #Yes, you need a root node.
27a0b0b1 [grok-build-0.1] #
27a0b0b2 [grok-build-0.1] #In Godot you cannot save a scene without at least one node (the root).
27a0b0b2 [grok-build-0.1] #
27a0b0b2 [grok-build-0.1] #Recommended way in the editor:
27a0b0b2 [grok-build-0.1] #
27a0b0b3 [grok-build-0.1] #1. Go to Scene → New Scene.
27a0b0b3 [grok-build-0.1] #2. Click Other Node.
27a0b0b3 [grok-build-0.1] #3. Search for and select `Node` (this is the lightest root).
27a0b0b3 [grok-build-0.1] #4. In the Scene dock, select the new `Node`.
27a0b0b4 [grok-build-0.1] #5. Drag your `main.gd` file from the FileSystem onto the node (or click the Attach Script
27a0b0b4 [grok-build-0.1] #button in the toolbar).
27a0b0b4 [grok-build-0.1] #6. Save the scene as `main.tscn` (File → Save Scene As...).
27a0b0b4 [grok-build-0.1] #
27a0b0b5 [grok-build-0.1] #After that:
27a0b0b5 [grok-build-0.1] #- Go to Project → Project Settings → Application → Run
27a0b0b5 [grok-build-0.1] #- Set Main Scene to `res://main.tscn`
27a0b0b5 [grok-build-0.1] #
