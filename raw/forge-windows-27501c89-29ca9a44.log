278f154b [grok-build-0.1] #🟠nitrologic Relay 2.0.2 grok-build-0.1 𝕏 🪠 0.7° $0.262 652.6KB 10.62s
278f154b [grok-build-0.1] #• Short answer:*
278f154c [grok-build-0.1] #
278f154c [grok-build-0.1] #• No, C++ does not* have a standard library function that escapes control
278f154c [grok-build-0.1] #characters like `\n`, `\t`, `\"`, `\\`, etc. into their escaped form (i.e. turning an actual
278f154c [grok-build-0.1] #newline into the two characters `\` and `n`).
278f154c [grok-build-0.1] #
278f154d [grok-build-0.1] #Details
278f154d [grok-build-0.1] #
278f154d [grok-build-0.1] #╭─────────────────────┬───────────────┬─────────────────────────────────────────────┬───────────────────────────────╮
278f154d [grok-build-0.1] #│  Function           │  Exists?      │  What it does                               │  Suitable for `\n` → `\n`?    │
278f154e [grok-build-0.1] #├─────────────────────┼───────────────┼─────────────────────────────────────────────┼───────────────────────────────┤
278f154e [grok-build-0.1] #│  `std::quoted`      │  Yes (C++14)  │  Adds quotes + escapes `"` and `\`          │  No                           │
