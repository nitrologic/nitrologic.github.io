2823c99e [deepseek-flash] #silently ignores the whole directory.
2823c99e [deepseek-flash] #
2823c99e [deepseek-flash] #Once installed, re-open the export dialog; the “No export template found” errors should clear.
2823c99e [deepseek-flash] #
