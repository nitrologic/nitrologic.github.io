27a37a2a [grok-build-0.1] #🟠nitrologic Relay 2.0.2 grok-build-0.1 𝕏 🪠 0.7° $0.001 485B 17.27s
27a37a2a [grok-build-0.1] #• Godot Headless Options*
27a37a2a [grok-build-0.1] #
27a37a2b [grok-build-0.1] #Godot supports a proper headless mode using the `--headless` flag. This disables the window,
27a37a2b [grok-build-0.1] #rendering, and most graphics-related systems.
27a37a2b [grok-build-0.1] #
27a37a2b [grok-build-0.1] #Basic Headless Commands
27a37a2c [grok-build-0.1] #
27a37a2c [grok-build-0.1] #╭──────────────────────────────────────────────┬─────────────────────────────────────────────────────╮
27a37a2c [grok-build-0.1] #│  Command                                     │  Description                                        │
27a37a2c [grok-build-0.1] #├──────────────────────────────────────────────┼─────────────────────────────────────────────────────┤
27a37a2d [grok-build-0.1] #│  `godot --headless`                          │  Run Godot in headless mode (no window)             │
27a37a2d [grok-build-0.1] #│  `godot --headless --quit`                   │  Run headless and exit immediately (useful for CI)  │
27a37a2d [grok-build-0.1] #│  `godot --headless --path /path/to/project`  │  Run a specific project headless                    │
27a37a2d [grok-build-0.1] #╰──────────────────────────────────────────────┴─────────────────────────────────────────────────────╯
27a37a2e [grok-build-0.1] #
27a37a2e [grok-build-0.1] #Common Use Cases
27a37a2e [grok-build-0.1] #
27a37a2e [grok-build-0.1] #• 1. Run a script headless*
27a37a2f [grok-build-0.1] #
27a37a2f [grok-build-0.1] #godot --headless --script res://scripts/my_script.gd
27a37a2f [grok-build-0.1] #
27a37a2f [grok-build-0.1] #
27a37a30 [grok-build-0.1] #• 2. Export a project (recommended in CI)*
27a37a30 [grok-build-0.1] #
27a37a30 [grok-build-0.1] ## Godot 4
27a37a30 [grok-build-0.1] #godot --headless --export-release "Linux" ./build/game
27a37a31 [grok-build-0.1] #
27a37a31 [grok-build-0.1] ## Godot 3
27a37a31 [grok-build-0.1] #godot --headless --export "Linux/X11" ./build/game
27a37a31 [grok-build-0.1] #
27a37a32 [grok-build-0.1] #
27a37a32 [grok-build-0.1] #• 3. Run a dedicated server*
27a37a32 [grok-build-0.1] #
27a37a32 [grok-build-0.1] #godot --headless --main-pack game.pck
27a37a32 [grok-build-0.1] ## or
27a37a32 [grok-build-0.1] #godot --headless res://server/server.tscn
27a37a33 [grok-build-0.1] #
27a37a33 [grok-build-0.1] #
27a37a33 [grok-build-0.1] #• 4. CI / Testing*
27a37a33 [grok-build-0.1] #
27a37a34 [grok-build-0.1] #godot --headless --quit
27a37a34 [grok-build-0.1] ## or with a test script
27a37a34 [grok-build-0.1] #godot --headless --script res://tests/run_tests.gd --quit
27a37a34 [grok-build-0.1] #
27a37a34 [grok-build-0.1] #
27a37a35 [grok-build-0.1] #Additional Useful Flags with Headless
27a37a35 [grok-build-0.1] #
27a37a35 [grok-build-0.1] #╭────────────────────────────┬──────────────────────────────────────────────────────╮
27a37a35 [grok-build-0.1] #│  Flag                      │  Purpose                                             │
27a37a36 [grok-build-0.1] #├────────────────────────────┼──────────────────────────────────────────────────────┤
27a37a36 [grok-build-0.1] #│  `--disable-render-loop`   │  Disables the render loop (can save some CPU)        │
27a37a36 [grok-build-0.1] #│  `--audio-driver Dummy`    │  Use dummy audio driver                              │
27a37a36 [grok-build-0.1] #│  `--display-driver dummy`  │  Use dummy display driver                            │
27a37a37 [grok-build-0.1] #│  `--verbose`               │  More output (helpful when debugging headless runs)  │
27a37a37 [grok-build-0.1] #│  `--no-header`             │  Cleaner output in CI                                │
27a37a37 [grok-build-0.1] #│  `--fixed-fps 60`          │  Force a fixed frame rate                            │
27a37a37 [grok-build-0.1] #╰────────────────────────────┴──────────────────────────────────────────────────────╯
27a37a37 [grok-build-0.1] #
27a37a38 [grok-build-0.1] #Full Example (CI-style)
27a37a38 [grok-build-0.1] #
27a37a38 [grok-build-0.1] #
27a37a38 [grok-build-0.1] #godot --headless \
27a37a38 [grok-build-0.1] #  --path /path/to/project \
27a37a39 [grok-build-0.1] #  --audio-driver Dummy \
27a37a39 [grok-build-0.1] #  --display-driver dummy \
27a37a39 [grok-build-0.1] #  --script res://ci/build_and_test.gd \
27a37a39 [grok-build-0.1] #  --quit
27a37a3a [grok-build-0.1] #
27a37a3a [grok-build-0.1] #
27a37a3a [grok-build-0.1] #Notes
27a37a3a [grok-build-0.1] #
27a37a3b [grok-build-0.1] #- `--headless` is the modern/recommended way (Godot 4+).
27a37a3b [grok-build-0.1] #- In Godot 3, `--headless` also works, but some people used `--no-window` instead.
27a37a3b [grok-build-0.1] #- For dedicated servers, consider building a Server export template instead of relying only
27a37a3b [grok-build-0.1] #on `--headless` for better performance.
27a37a3b [grok-build-0.1] #
27a37a3c [grok-build-0.1] #Would you like the options focused on a specific use case (CI, dedicated server, exporting, etc.)?
27a37a3c [grok-build-0.1] #
