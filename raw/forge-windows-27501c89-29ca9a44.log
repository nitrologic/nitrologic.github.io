27a2020d [grok-build-0.1] #Why Node2D is the right choice here
27a2020d [grok-build-0.1] #
27a2020d [grok-build-0.1] #╭─────────────────┬──────────────────────────┬─────────────────────────────┬─────────────────────────────────────────────────────────────╮
27a2020d [grok-build-0.1] #│  Node Type      │  Can use `draw_line()`?  │  Good for vector display?   │  Notes                                                      │
27a2020e [grok-build-0.1] #├─────────────────┼──────────────────────────┼─────────────────────────────┼─────────────────────────────────────────────────────────────┤
27a2020e [grok-build-0.1] #│  **Node2D**     │  Yes                     │  **Best**                   │  Clean, lightweight, meant for 2D drawing                   │
27a2020e [grok-build-0.1] #│  **Control**    │  Yes                     │  Okay                       │  More UI-oriented, brings layout behavior you may not need  │
27a2020e [grok-build-0.1] #│  **Node**       │  No                      │  No                         │  This is your current problem                               │
27a2020f [grok-build-0.1] #│  **Sprite2D**   │  No (not directly)       │  No                         │  Not suitable for custom drawing                            │
27a2020f [grok-build-0.1] #╰─────────────────┴──────────────────────────┴─────────────────────────────┴─────────────────────────────────────────────────────────────╯
27a2020f [grok-build-0.1] #
