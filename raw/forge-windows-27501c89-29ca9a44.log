29325f83 [nitro@ryzen5] can it log for each new copy
29325fb2 [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.000 1.868KB 2.28s
29325fb2 [deepseek-flash] #Yes. `rsync` has `--out-format` (or the older `-i` / `--itemize-changes`) for per-file logging, and
29325fb2 [deepseek-flash] #you can write that to a file with `--log-file`.
29325fb3 [deepseek-flash] #
29325fb3 [deepseek-flash] #• Log each transferred file to stdout:*
29325fb3 [deepseek-flash] #
29325fb3 [deepseek-flash] #
29325fb4 [deepseek-flash] #rsync -ruav --out-format='%t %i %n' /source/path/ /destination/path/
29325fb4 [deepseek-flash] #
29325fb4 [deepseek-flash] #
29325fb4 [deepseek-flash] #- `%t` — timestamp
29325fb5 [deepseek-flash] #- `%i` — itemized change flags (e.g. `>f+++++++++` for a new file)
29325fb5 [deepseek-flash] #- `%n` — filename
29325fb5 [deepseek-flash] #
29325fb5 [deepseek-flash] #• Log to a file instead:*
29325fb6 [deepseek-flash] #
29325fb6 [deepseek-flash] #
29325fb6 [deepseek-flash] #rsync -ruav --log-file=/var/log/rsync-copy.log --out-format='%t %i %n' /source/path/ /destination/path/
29325fb6 [deepseek-flash] #
29325fb7 [deepseek-flash] #
29325fb7 [deepseek-flash] #With `--log-file`, rsync writes its own transfer lines to that file. By default it only logs files
29325fb7 [deepseek-flash] #that are actually transferred (new or updated), which is what you want.
29325fb7 [deepseek-flash] #
29325fb8 [deepseek-flash] #• Only show newly created files (not updates):*
29325fb8 [deepseek-flash] #
29325fb8 [deepseek-flash] #`--out-format` prints every change. To filter to new files only, you can post-process:
29325fb8 [deepseek-flash] #
29325fb9 [deepseek-flash] #
29325fb9 [deepseek-flash] #rsync -ruav --out-format='%i %n' /source/path/ /destination/path/ \
29325fb9 [deepseek-flash] #	| grep '^>f+++++++++'
29325fb9 [deepseek-flash] #
29325fba [deepseek-flash] #
29325fba [deepseek-flash] #• Useful `%i` flags for interpretation:*
29325fba [deepseek-flash] #
29325fba [deepseek-flash] #- `>f+++++++++` — new file created on destination
29325fbb [deepseek-flash] #- `>f.st......` — file updated (size/time changed)
29325fbb [deepseek-flash] #- `.d..t......` — directory timestamp changed only
29325fbb [deepseek-flash] #
29325fbb [deepseek-flash] #• Quieter alternative* if you just want the names of transferred files:
29325fbc [deepseek-flash] #
29325fbc [deepseek-flash] #
29325fbc [deepseek-flash] #rsync -rua --info=name /source/path/ /destination/path/
29325fbc [deepseek-flash] #
29325fbd [deepseek-flash] #
29325fbd [deepseek-flash] #That prints one line per transferred file with no extra chatter.
29325fbd [deepseek-flash] #
