278f9b82 [grok-build-0.1] #🟠nitrologic Relay 2.0.2 grok-build-0.1 𝕏 🪠 0.7° $0.269 677.1KB 16.42s
278f9b82 [grok-build-0.1] #• Answer:*
278f9b82 [grok-build-0.1] #
278f9b82 [grok-build-0.1] #In PIO, `push` always sends the current value of the ISR register. There is no
278f9b83 [grok-build-0.1] #direct "push pins" instruction.
278f9b83 [grok-build-0.1] #
278f9b83 [grok-build-0.1] #To push the pins value, you must first move the pins into the `ISR`, then `push`.
278f9b84 [grok-build-0.1] #
278f9b84 [grok-build-0.1] #How to do it properly (without resetting the tick)
278f9b84 [grok-build-0.1] #
278f9b84 [grok-build-0.1] #Here’s the correct pattern for the `changed` section if you want to push both tick and
278f9b85 [grok-build-0.1] #pins while keeping the tick counter running continuously:
278f9b85 [grok-build-0.1] #
278f9b85 [grok-build-0.1] #
278f9b85 [grok-build-0.1] #changed:
278f9b86 [grok-build-0.1] #    mov     y, x              ; y = new pins value
278f9b86 [grok-build-0.1] #    push                      ; 1. push tick (ISR currently holds the tick)
278f9b86 [grok-build-0.1] #
278f9b86 [grok-build-0.1] #    mov     isr, y            ; 2. put the new pins into ISR
278f9b87 [grok-build-0.1] #    push                      ; 3. push pins
278f9b87 [grok-build-0.1] #
278f9b87 [grok-build-0.1] #    ; 4. Restore the tick back into ISR so it can keep counting
278f9b87 [grok-build-0.1] #    mov     isr, x            ; (we saved the tick in x earlier)
278f9b88 [grok-build-0.1] #    jmp     loop
278f9b88 [grok-build-0.1] #
278f9b88 [grok-build-0.1] #
278f9b88 [grok-build-0.1] #Full clean version of the `changed` block:
278f9b89 [grok-build-0.1] #
278f9b89 [grok-build-0.1] #
278f9b89 [grok-build-0.1] #changed:
278f9b89 [grok-build-0.1] #    mov     y, x              ; y = new pins
278f9b8a [grok-build-0.1] #    mov     x, isr            ; save current tick into x
278f9b8a [grok-build-0.1] #    push                      ; push the tick
278f9b8a [grok-build-0.1] #    mov     isr, y            ; load pins into ISR
278f9b8a [grok-build-0.1] #    push                      ; push the pins
278f9b8b [grok-build-0.1] #    mov     isr, x            ; restore the tick so it continues decrementing
278f9b8b [grok-build-0.1] #    jmp     loop
278f9b8b [grok-build-0.1] #
278f9b8b [grok-build-0.1] #
278f9b8c [grok-build-0.1] #Why this order?
278f9b8c [grok-build-0.1] #
278f9b8c [grok-build-0.1] #- `push` can only push whatever is currently in `ISR`.
278f9b8c [grok-build-0.1] #- We have to temporarily overwrite `ISR` with the pins to push them.
278f9b8d [grok-build-0.1] #- We must put the tick value back into `ISR` afterwards, otherwise the normal decrement logic in
278f9b8d [grok-build-0.1] #the `loop` will break.
278f9b8d [grok-build-0.1] #
278f9b8d [grok-build-0.1] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
278f9b8e [grok-build-0.1] #
278f9b8e [grok-build-0.1] #Would you like a version where the tick counts up instead of down? That would be cleaner
278f9b8e [grok-build-0.1] #for "not resetting".
278f9b8e [grok-build-0.1] #
