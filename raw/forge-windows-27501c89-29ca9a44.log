28728f8b [kimi-k2.7-code] #🟠nitrologic Relay 2.0.3 kimi-k2.7-code 🜁 🪠 🧊 $0.003 2.344KB 7.78s
28728f8b [kimi-k2.7-code] #For an internet-facing server running nginx, yes, use a firewall. At minimum you want to
28728f8b [kimi-k2.7-code] #allow only SSH, HTTP, and HTTPS, and drop everything else.
28728f8b [kimi-k2.7-code] #
28728f8c [kimi-k2.7-code] #The cleanest choice on Arch is nftables — it’s the modern standard, installed by default
28728f8c [kimi-k2.7-code] #with the kernel, and has no extra dependencies.
28728f8c [kimi-k2.7-code] #
28728f8c [kimi-k2.7-code] #Important warning
28728f8d [kimi-k2.7-code] #
28728f8d [kimi-k2.7-code] #If you’re doing this over SSH, make sure you allow SSH first and keep your current
28728f8d [kimi-k2.7-code] #session open until you confirm you can reconnect. Otherwise you can lock yourself out.
28728f8d [kimi-k2.7-code] #
28728f8e [kimi-k2.7-code] #Minimal nftables setup for nginx
28728f8e [kimi-k2.7-code] #
28728f8e [kimi-k2.7-code] #Create `/etc/nftables.conf`:
28728f8e [kimi-k2.7-code] #
28728f8f [kimi-k2.7-code] #
28728f8f [kimi-k2.7-code] ##!/usr/bin/nft -f
28728f8f [kimi-k2.7-code] #
28728f8f [kimi-k2.7-code] #flush ruleset
28728f90 [kimi-k2.7-code] #
28728f90 [kimi-k2.7-code] #table inet filter {
28728f90 [kimi-k2.7-code] #	chain input {
28728f90 [kimi-k2.7-code] #		type filter hook input priority 0; policy drop;
28728f91 [kimi-k2.7-code] #
28728f91 [kimi-k2.7-code] #		# Allow loopback
28728f91 [kimi-k2.7-code] #		iif "lo" accept
28728f91 [kimi-k2.7-code] #
28728f92 [kimi-k2.7-code] #		# Allow established and related traffic
28728f92 [kimi-k2.7-code] #		ct state established,related accept
28728f92 [kimi-k2.7-code] #
28728f92 [kimi-k2.7-code] #		# Drop invalid packets
28728f93 [kimi-k2.7-code] #		ct state invalid drop
28728f93 [kimi-k2.7-code] #
28728f93 [kimi-k2.7-code] #		# Allow SSH
28728f94 [kimi-k2.7-code] #		tcp dport 22 accept
28728f94 [kimi-k2.7-code] #
28728f94 [kimi-k2.7-code] #		# Allow HTTP and HTTPS
28728f94 [kimi-k2.7-code] #		tcp dport { 80, 443 } accept
28728f95 [kimi-k2.7-code] #
28728f95 [kimi-k2.7-code] #		# Optional: allow ICMP (ping, path MTU discovery, etc.)
28728f95 [kimi-k2.7-code] #		ip protocol icmp accept
28728f95 [kimi-k2.7-code] #		ip6 nexthdr icmpv6 accept
28728f96 [kimi-k2.7-code] #	}
28728f96 [kimi-k2.7-code] #
28728f96 [kimi-k2.7-code] #	chain forward {
28728f96 [kimi-k2.7-code] #		type filter hook forward priority 0; policy drop;
28728f97 [kimi-k2.7-code] #	}
28728f97 [kimi-k2.7-code] #
28728f97 [kimi-k2.7-code] #	chain output {
28728f97 [kimi-k2.7-code] #		type filter hook output priority 0; policy accept;
28728f98 [kimi-k2.7-code] #	}
28728f98 [kimi-k2.7-code] #}
28728f98 [kimi-k2.7-code] #
28728f98 [kimi-k2.7-code] #
28728f99 [kimi-k2.7-code] #Enable and start it:
28728f99 [kimi-k2.7-code] #
28728f99 [kimi-k2.7-code] #
28728f99 [kimi-k2.7-code] #sudo systemctl enable --now nftables
28728f9a [kimi-k2.7-code] #sudo nft -f /etc/nftables.conf
28728f9a [kimi-k2.7-code] #
28728f9a [kimi-k2.7-code] #
28728f9a [kimi-k2.7-code] #Check the active rules:
28728f9b [kimi-k2.7-code] #
28728f9b [kimi-k2.7-code] #
28728f9b [kimi-k2.7-code] #sudo nft list ruleset
28728f9b [kimi-k2.7-code] #
28728f9c [kimi-k2.7-code] #
28728f9c [kimi-k2.7-code] #If your SSH runs on a non-standard port
28728f9c [kimi-k2.7-code] #
28728f9c [kimi-k2.7-code] #Change the `22` in the rule to your actual port, e.g.:
28728f9d [kimi-k2.7-code] #
28728f9d [kimi-k2.7-code] #
28728f9d [kimi-k2.7-code] #tcp dport 2222 accept
28728f9d [kimi-k2.7-code] #
28728f9e [kimi-k2.7-code] #
28728f9e [kimi-k2.7-code] #If you prefer something simpler
28728f9e [kimi-k2.7-code] #
28728f9e [kimi-k2.7-code] #`ufw` works fine too:
28728f9f [kimi-k2.7-code] #
28728f9f [kimi-k2.7-code] #
28728f9f [kimi-k2.7-code] #sudo pacman -S ufw
28728f9f [kimi-k2.7-code] #sudo ufw default deny incoming
28728fa0 [kimi-k2.7-code] #sudo ufw default allow outgoing
28728fa0 [kimi-k2.7-code] #sudo ufw allow 22/tcp
28728fa0 [kimi-k2.7-code] #sudo ufw allow 'Nginx Full'
28728fa0 [kimi-k2.7-code] #sudo ufw enable
28728fa1 [kimi-k2.7-code] #
28728fa1 [kimi-k2.7-code] #
28728fa1 [kimi-k2.7-code] #If you use fail2ban
28728fa1 [kimi-k2.7-code] #
28728fa2 [kimi-k2.7-code] #If you later add fail2ban, it works with both nftables and ufw backends, but make sure nftables
28728fa2 [kimi-k2.7-code] #rules are persistent.
28728fa2 [kimi-k2.7-code] #
28728fa2 [kimi-k2.7-code] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28728fa3 [kimi-k2.7-code] #
