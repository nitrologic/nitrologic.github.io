29325b95 [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.000 527B 1.80s
29325b96 [deepseek-flash] #Use `rsync` with `-r` (recursive) and `-u` (update, skip files that are newer on the destination):
29325b96 [deepseek-flash] #
29325b96 [deepseek-flash] #
29325b96 [deepseek-flash] #rsync -ru /source/path/ /destination/path/
29325b97 [deepseek-flash] #
29325b97 [deepseek-flash] #
29325b97 [deepseek-flash] #Key points:
29325b97 [deepseek-flash] #
29325b98 [deepseek-flash] #- Trailing slash on source matters. `/source/path/` means "copy the contents of path";
29325b98 [deepseek-flash] #`/source/path` means "copy the path directory itself into the destination".
29325b98 [deepseek-flash] #- `-u` skips any file on the destination that is newer than the source. It does not delete
29325b98 [deepseek-flash] #or overwrite newer destination files.
29325b99 [deepseek-flash] #- Add `-v` for verbose output and `-n` for a dry run to preview what would be transferred:
29325b99 [deepseek-flash] #
29325b99 [deepseek-flash] #
29325b99 [deepseek-flash] #rsync -ruvn /source/path/ /destination/path/
29325b9a [deepseek-flash] #
29325b9a [deepseek-flash] #
29325b9a [deepseek-flash] #- If you also want to preserve timestamps, permissions, and recurse cleanly:
29325b9a [deepseek-flash] #
29325b9b [deepseek-flash] #
29325b9b [deepseek-flash] #rsync -ruav /source/path/ /destination/path/
29325b9b [deepseek-flash] #
29325b9b [deepseek-flash] #
29325b9c [deepseek-flash] #- For remote copies:
29325b9c [deepseek-flash] #
29325b9c [deepseek-flash] #
29325b9c [deepseek-flash] #rsync -ruav /local/path/ user@host:/remote/path/
29325b9d [deepseek-flash] #rsync -ruav user@host:/remote/path/ /local/path/
29325b9d [deepseek-flash] #
29325b9d [deepseek-flash] #
29325b9d [deepseek-flash] #Note: `-u` compares mtime only. If you want rsync's normal "transfer only changed files" behaviour
29325b9e [deepseek-flash] #(based on size + mtime, regardless of which is newer), drop `-u`:
29325b9e [deepseek-flash] #
29325b9e [deepseek-flash] #
29325b9e [deepseek-flash] #rsync -rav /source/path/ /destination/path/
29325b9f [deepseek-flash] #
