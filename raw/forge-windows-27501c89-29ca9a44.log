27a1d90e [grok-build-0.1] #
27a1d90e [grok-build-0.1] #How Clean Can 2D Vector Lines Be Represented in glTF?
27a1d90e [grok-build-0.1] #
27a1d90f [grok-build-0.1] #It can be reasonably clean if you treat glTF purely as a typed buffer container,
27a1d90f [grok-build-0.1] #not as a full 3D asset.
27a1d90f [grok-build-0.1] #
27a1d90f [grok-build-0.1] #Recommended Representation (Cleanest Path)
27a1d910 [grok-build-0.1] #
27a1d910 [grok-build-0.1] #Use a minimal `Mesh` with `mode: 1` (LINES):
27a1d910 [grok-build-0.1] #
27a1d910 [grok-build-0.1] #
27a1d911 [grok-build-0.1] #{
27a1d911 [grok-build-0.1] #  "meshes": [{
