27a0c7c7 [grok-build-0.1] #.tscn stands for Text Scene.
27a0c7c7 [grok-build-0.1] #
27a0c7c8 [grok-build-0.1] #Breakdown:
27a0c7c8 [grok-build-0.1] #
27a0c7c8 [grok-build-0.1] #╭─────────────┬────────────────────┬────────────────────────────────────────────────╮
27a0c7c8 [grok-build-0.1] #│  Extension  │  Full Name         │  Meaning                                       │
27a0c7c9 [grok-build-0.1] #├─────────────┼────────────────────┼────────────────────────────────────────────────┤
27a0c7c9 [grok-build-0.1] #│  `.tscn`    │  **Text Scene**    │  Human-readable scene file                     │
27a0c7c9 [grok-build-0.1] #│  `.scn`     │  Binary Scene      │  Compiled/binary version of a scene            │
27a0c7ca [grok-build-0.1] #│  `.tres`    │  Text Resource     │  Human-readable resource file                  │
27a0c7ca [grok-build-0.1] #│  `.res`     │  Binary Resource   │  Compiled/binary resource                      │
27a0c7ca [grok-build-0.1] #╰─────────────┴────────────────────┴────────────────────────────────────────────────╯
27a0c7ca [grok-build-0.1] #
27a0c7cb [grok-build-0.1] #Simple explanation:
27a0c7cb [grok-build-0.1] #
27a0c7cb [grok-build-0.1] #- A `.tscn` file contains all the nodes, properties, and connections of a scene in plain text.
27a0c7cb [grok-build-0.1] #- Godot saves scenes as `.tscn` by default so they are easy to read, edit, and version control
27a0c7cb [grok-build-0.1] #(with Git, for example).
27a0c7cc [grok-build-0.1] #- You can open a `.tscn` file in any text editor and see what's inside.
27a0c7cc [grok-build-0.1] #
27a0c7cc [grok-build-0.1] #Example from your project:
27a0c7cc [grok-build-0.1] #Your `control.tscn` is a text scene that describes your `Control` node and attaches `control.gd` to
27a0c7cd [grok-build-0.1] #it.
27a0c7cd [grok-build-0.1] #
27a0c7cd [grok-build-0.1] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
27a0c7cd [grok-build-0.1] #
27a0c7ce [grok-build-0.1] #Would you like to see what the inside of a `.tscn` file actually represents?
27a0c7ce [grok-build-0.1] #
27a0c9d9 [nitro@ryzen5] cool i can see control.gd in there
