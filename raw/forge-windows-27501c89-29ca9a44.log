28235f82 [deepseek-flash] #🟠nitrologic Relay 2.0.3 deepseek-flash 🐋 🪠 0.7° $0.004 41.05KB 12.22s
28235f82 [deepseek-flash] #Good idea — WebSocket already has binary frames, so you don't need base64 at all for the payload.
28235f82 [deepseek-flash] #You can mirror GLB’s chunked layout so one binary frame carries a JSON header plus a raw BIN chunk.
28235f82 [deepseek-flash] #
28235f82 [deepseek-flash] #Frame layout (little-endian, GLB-style)
28235f83 [deepseek-flash] #
28235f83 [deepseek-flash] #
28235f83 [deepseek-flash] #offset  size  field
28235f83 [deepseek-flash] #0       4     magic        'NTRL'
28235f84 [deepseek-flash] #4       4     version      1
28235f84 [deepseek-flash] #8       4     total length (whole frame)
28235f84 [deepseek-flash] #12      4     chunkLength  (JSON chunk, padded)
28235f84 [deepseek-flash] #16      4     chunkType    'JSON'
28235f85 [deepseek-flash] #20      n     JSON bytes, padded to 4 with 0x20
28235f85 [deepseek-flash] #...     4     chunkLength  (BIN chunk, padded)
28235f85 [deepseek-flash] #...     4     chunkType    'BIN\0'
28235f85 [deepseek-flash] #...     n     BIN bytes, padded to 4 with 0x00
28235f86 [deepseek-flash] #
28235f86 [deepseek-flash] #
28235f86 [deepseek-flash] #`chunkLength` includes its own padding, matching glTF 2.0. Unknown chunk types are skipped.
28235f87 [deepseek-flash] #
