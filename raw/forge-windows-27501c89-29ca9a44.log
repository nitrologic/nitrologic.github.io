28235f93 [deepseek-flash] #Hook-in
28235f93 [deepseek-flash] #
28235f93 [deepseek-flash] #In `pollNetwork`, `get_packet()` gives you a `PackedByteArray` already — you don't have to call
28235f94 [deepseek-flash] #`get_string_from_utf8()`. So the client loop becomes:
28235f94 [deepseek-flash] #
28235f94 [deepseek-flash] #
28235f94 [deepseek-flash] #var data := client.get_packet()
28235f95 [deepseek-flash] #if data.size() > 0 and data.decode_u32(0) == FRAME_MAGIC:
28235f95 [deepseek-flash] #	var frame := parse_frame(data)
28235f95 [deepseek-flash] #	onFrame(client, frame.header, frame.binary)
28235f95 [deepseek-flash] #else:
28235f96 [deepseek-flash] #	onPacket(client, data)   # existing text/JSON path
28235f96 [deepseek-flash] #
28235f96 [deepseek-flash] #
28235f96 [deepseek-flash] #And `onFrame` is a sibling of `onPacket` that dispatches on `header.method`, with the raw bytes
28235f97 [deepseek-flash] #handed straight to `base64_to_vec2_array`’s replacement — no `Marshalls.base64_to_raw` step.
28235f97 [deepseek-flash] #
28235f97 [deepseek-flash] #Notes
28235f97 [deepseek-flash] #
28235f98 [deepseek-flash] #- The header chunk is where your `params` live, minus `buffer`. Add `"bin_size"` or a checksum if
28235f98 [deepseek-flash] #you want integrity checks.
28235f98 [deepseek-flash] #- `PackedByteArray.decode_u32` is little-endian on all platforms, so no byte-order swap is needed.
28235f98 [deepseek-flash] #- `slice()` copies; if buffers get large, decode directly out of `data` with an offset instead.
28235f99 [deepseek-flash] #- If you want to keep base64 for small payloads and only use frames for big ones, gate on
28235f99 [deepseek-flash] #`header.bin_offset` being present rather than on the magic.
28235f99 [deepseek-flash] #
