27a0ca30 [grok-build-0.1] #The actual code stays in the separate `control.gd` file. This separation is intentional — it keeps
27a0ca30 [grok-build-0.1] #your scene file small and makes it easier to reuse scripts across different scenes.
27a0ca30 [grok-build-0.1] #
27a0ca30 [grok-build-0.1] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
27a0ca31 [grok-build-0.1] #
