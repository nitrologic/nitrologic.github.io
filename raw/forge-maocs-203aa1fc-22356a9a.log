20e58305 [gemini-3.5] # ꔀ nitrologic Relay 1.8.8 ⛲  gemini-3.5 🌟 🪣 0.7° (484+1419[2621]) 1.680KB 7.34s
20e58305 [gemini-3.5] #Yes, I can certainly provide information regarding the pricing for the Gemini API (available
20e58305 [gemini-3.5] #through Google AI Studio and Vertex AI).
20e58305 [gemini-3.5] #
20e58305 [gemini-3.5] #Google offers two primary ways to access the Gemini API: a Free Tier (ideal for development
20e58305 [gemini-3.5] #and testing) and a Pay-as-you-go Tier (for production use).
20e58305 [gemini-3.5] #
20e58305 [gemini-3.5] #Below is the standard pricing structure for the primary models, Gemini 1.5 Flash and
20e58305 [gemini-3.5] #Gemini 1.5 Pro, via Google AI Studio:
20e58305 [gemini-3.5] #
20e58305 [gemini-3.5] #1. Gemini 1.5 Flash
20e58305 [gemini-3.5] #This model is highly lightweight, fast, and cost-efficient.
20e58305 [gemini-3.5] #
20e58305 [gemini-3.5] #• Free Tier:
20e58305 [gemini-3.5] #    *   Cost: Free
20e58305 [gemini-3.5] #    *   Rate Limits: 15 Requests per Minute (RPM), 1 Million Tokens per Minute (TPM), 1,500
20e58305 [gemini-3.5] #Requests per Day (RPD)
20e58305 [gemini-3.5] #• Pay-as-you-go Tier:
20e58306 [gemini-3.5] #    *   Prompt (under 128k tokens): $0.075 per 1 million tokens
20e58306 [gemini-3.5] #    *   Prompt (over 128k tokens): $0.15 per 1 million tokens
20e58306 [gemini-3.5] #    *   Candidates/Output (under 128k tokens): $0.30 per 1 million tokens
20e58306 [gemini-3.5] #    *   Candidates/Output (over 128k tokens): $0.60 per 1 million tokens
20e58306 [gemini-3.5] #
20e58306 [gemini-3.5] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
20e58306 [gemini-3.5] #
20e58306 [gemini-3.5] #2. Gemini 1.5 Pro
20e58306 [gemini-3.5] #This is our most powerful multimodal model for complex reasoning and large-scale tasks.
20e58306 [gemini-3.5] #
20e58306 [gemini-3.5] #• Free Tier:
20e58306 [gemini-3.5] #    *   Cost: Free
20e58306 [gemini-3.5] #    *   Rate Limits: 2 Requests per Minute (RPM), 32,000 Tokens per Minute (TPM), 50
20e58306 [gemini-3.5] #Requests per Day (RPD)
20e58306 [gemini-3.5] #• Pay-as-you-go Tier:
20e58306 [gemini-3.5] #    *   Prompt (under 128k tokens): $1.25 per 1 million tokens
20e58306 [gemini-3.5] #    *   Prompt (over 128k tokens): $2.50 per 1 million tokens
20e58306 [gemini-3.5] #    *   Candidates/Output (under 128k tokens): $5.00 per 1 million tokens
20e58306 [gemini-3.5] #    *   Candidates/Output (over 128k tokens): $10.00 per 1 million tokens
20e58306 [gemini-3.5] #
20e58306 [gemini-3.5] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
20e58306 [gemini-3.5] #
20e58306 [gemini-3.5] #Additional Features & Costs
20e58306 [gemini-3.5] #• Context Caching: If you reuse large amounts of context (like long documents or
20e58307 [gemini-3.5] #codebases), you can cache it to reduce costs. Caching costs are significantly lower than standard
20e58307 [gemini-3.5] #input rates (approximately 25% of the input prompt cost), plus a small storage fee per hour.
20e58307 [gemini-3.5] #• Tuning: Fine-tuning is supported for Gemini models. The training cost is typically billed
20e58307 [gemini-3.5] #per million tokens processed during the tuning phase.
20e58307 [gemini-3.5] #
