218b0382 [kimi-k2.7-code] # ꔀ Relay 1.9.4 kimi-k2.7-code 🜁 🪣 🧊 $0.003 572B 42.02s
218b0382 [kimi-k2.7-code] #To forward arguments in a shell script on macOS, use `"$@"`. This preserves each argument as a
218b0382 [kimi-k2.7-code] #separate word, including empty or quoted strings.
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #Example wrapper:
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] ##!/bin/bash
218b0382 [kimi-k2.7-code] ## relaypushd
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #dir="$1"
218b0382 [kimi-k2.7-code] #shift
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #pushd "$dir" >/dev/null || exit 1
218b0382 [kimi-k2.7-code] #"$@"
218b0382 [kimi-k2.7-code] #status=$?
218b0382 [kimi-k2.7-code] #popd >/dev/null
218b0382 [kimi-k2.7-code] #exit $status
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #Usage:
218b0382 [kimi-k2.7-code] #
218b0382 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #relaypushd ~/relaydeno task relaypopd
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #- `"$@"` expands to every remaining argument, exactly as given.
218b0383 [kimi-k2.7-code] #- Use `*` or unquoted `@` only if you want word-splitting.
218b0383 [kimi-k2.7-code] #- `$#` gives the argument count.
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #If `relaypushd` should simply pass all arguments through to another command without consuming the
218b0383 [kimi-k2.7-code] #first one:
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] ##!/bin/bash
218b0383 [kimi-k2.7-code] #some-other-command "$@"
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #
218b0383 [kimi-k2.7-code] #If that doesn't match what you're trying to do, paste the current `relaypushd` file and the exact
218b0383 [kimi-k2.7-code] #error or behavior you want.
218b0383 [kimi-k2.7-code] #
