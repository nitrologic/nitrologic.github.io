262b34ee [gemini-3.7-flash] #Yes, these memory-mapped I/O addresses and register definitions are correct for the Commodore PET
262b34ee [gemini-3.7-flash] #series (2001, 3000, 4000, 8000 series, and SuperPET).
262b34ef [gemini-3.7-flash] #
262b34ef [gemini-3.7-flash] #Here is a summary of how these hardware chips map into the `E800–E84F` address space:
262b34ef [gemini-3.7-flash] #
262b34ef [gemini-3.7-flash] #PIA 1 (MOS 6520) — `E810–E813`
262b34f0 [gemini-3.7-flash] #Primary uses: Keyboard row scan, cassette 1 control, screen blanking status, and diagnostic sense.
262b34f0 [gemini-3.7-flash] #• `$E810` – PIA1_PA: Port A Data / Data Direction Register A
262b34f0 [gemini-3.7-flash] #• `$E811` – PIA1_CRA: Control Register A
262b34f0 [gemini-3.7-flash] #• `$E812` – PIA1_PB: Port B Data / Data Direction Register B
262b34f1 [gemini-3.7-flash] #• `$E813` – PIA1_CRB: Control Register B
262b34f1 [gemini-3.7-flash] #
262b34f1 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b34f1 [gemini-3.7-flash] #
262b34f2 [gemini-3.7-flash] #PIA 2 (MOS 6520) — `E820–E823`
262b34f2 [gemini-3.7-flash] #Primary uses: IEEE-488 bus interface (data lines and handshaking signals).
262b34f2 [gemini-3.7-flash] #• `$E820` – PIA2_PA: Port A Data / Data Direction Register A
262b34f2 [gemini-3.7-flash] #• `$E821` – PIA2_CRA: Control Register A
262b34f3 [gemini-3.7-flash] #• `$E822` – PIA2_PB: Port B Data / Data Direction Register B
262b34f3 [gemini-3.7-flash] #• `$E823` – PIA2_CRB: Control Register B
262b34f3 [gemini-3.7-flash] #
262b34f3 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b34f4 [gemini-3.7-flash] #
262b34f4 [gemini-3.7-flash] #VIA (MOS 6522) — `E840–E84F`
262b34f4 [gemini-3.7-flash] #Primary uses: User port, cassette 2 control, CB2 audio chirps/tones, vertical sync detection, and
262b34f4 [gemini-3.7-flash] #system timing.
262b34f5 [gemini-3.7-flash] #• `$E840` – VIA_ORB: Port B Data Register (with handshake)
262b34f5 [gemini-3.7-flash] #• `$E841` – VIA_ORA: Port A Data Register (with handshake)
262b34f5 [gemini-3.7-flash] #• `$E842` – VIA_DDRB: Port B Data Direction Register
262b34f5 [gemini-3.7-flash] #• `$E843` – VIA_DDRA: Port A Data Direction Register
262b34f6 [gemini-3.7-flash] #• `$E844` – VIA_T1C_L: Timer 1 Low-Order Latches / Counter
262b34f6 [gemini-3.7-flash] #• `$E845` – VIA_T1C_H: Timer 1 High-Order Counter
262b34f6 [gemini-3.7-flash] #• `$E846` – VIA_T1L_L: Timer 1 Low-Order Latches
262b34f6 [gemini-3.7-flash] #• `$E847` – VIA_T1L_H: Timer 1 High-Order Latches
262b34f7 [gemini-3.7-flash] #• `$E848` – VIA_T2C_L: Timer 2 Low-Order Latches / Counter
262b34f7 [gemini-3.7-flash] #• `$E849` – VIA_T2C_H: Timer 2 High-Order Counter
262b34f7 [gemini-3.7-flash] #• `$E84A` – VIA_SR: Shift Register
262b34f8 [gemini-3.7-flash] #• `$E84B` – VIA_ACR: Auxiliary Control Register
262b34f8 [gemini-3.7-flash] #• `$E84C` – VIA_PCR: Peripheral Control Register
262b34f8 [gemini-3.7-flash] #• `$E84D` – VIA_IFR: Interrupt Flag Register
262b34f8 [gemini-3.7-flash] #• `$E84E` – VIA_IER: Interrupt Enable Register
262b34f8 [gemini-3.7-flash] #• `$E84F` – VIA_ORA_NH: Port A Data Register (no handshake)
262b34f9 [gemini-3.7-flash] #
262b34f9 [gemini-3.7-flash] #• (Note: On late-model PET/CBM machines equipped with the MOS 6545/Hitachi HD6845 CRTC video
262b34f9 [gemini-3.7-flash] #controller, addresses `E880` and `E881` are additionally reserved for the CRTC Address and Register
262b34fa [gemini-3.7-flash] #data ports).*
