260efb85 [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.009 18.29KB 4.46s
260efb85 [gemini-3.7-flash] #The Commodore VIC-20 does have a physical `CTRL` key.
260efb85 [gemini-3.7-flash] #
260efb85 [gemini-3.7-flash] #Physical Location
260efb86 [gemini-3.7-flash] #On the VIC-20 keyboard, the `CTRL` key is located on the far-left edge, directly to the
260efb86 [gemini-3.7-flash] #left of the `Q` key.
260efb86 [gemini-3.7-flash] #
260efb86 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
260efb86 [gemini-3.7-flash] #
260efb87 [gemini-3.7-flash] #What the `CTRL` Key Does on the VIC-20
260efb87 [gemini-3.7-flash] #
260efb87 [gemini-3.7-flash] #1. Changing Text Colors:
260efb88 [gemini-3.7-flash] #   Holding `CTRL` while pressing number keys `1` through `8` changes the text color in direct mode
260efb88 [gemini-3.7-flash] #or inside strings:
260efb88 [gemini-3.7-flash] #   * `CTRL` + `1` = Black
260efb88 [gemini-3.7-flash] #   * `CTRL` + `2` = White
260efb89 [gemini-3.7-flash] #   * `CTRL` + `3` = Red
260efb89 [gemini-3.7-flash] #   * `CTRL` + `4` = Cyan
260efb89 [gemini-3.7-flash] #   * `CTRL` + `5` = Purple
260efb89 [gemini-3.7-flash] #   * `CTRL` + `6` = Green
260efb8a [gemini-3.7-flash] #   * `CTRL` + `7` = Blue
260efb8a [gemini-3.7-flash] #   * `CTRL` + `8` = Yellow
260efb8a [gemini-3.7-flash] #
260efb8a [gemini-3.7-flash] #2. Reverse Video:
260efb8b [gemini-3.7-flash] #   * `CTRL` + `9` = Reverse Video ON (`RVS ON`)
260efb8b [gemini-3.7-flash] #   * `CTRL` + `0` = Reverse Video OFF (`RVS OFF`)
260efb8b [gemini-3.7-flash] #
260efb8b [gemini-3.7-flash] #3. Slowing Down Scrolling:
260efb8c [gemini-3.7-flash] #   Holding down `CTRL` while a BASIC program is listing (`LIST`) or executing slows down screen
260efb8c [gemini-3.7-flash] #scrolling so text can be read.
260efb8c [gemini-3.7-flash] #
260efb8c [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
260efb8d [gemini-3.7-flash] #
260efb8d [gemini-3.7-flash] #Distinction Between `CTRL` and the `C=` (Commodore) Key
260efb8d [gemini-3.7-flash] #
260efb8d [gemini-3.7-flash] #• `CTRL` Key (next to `Q`): Used for color selection, reverse mode, and slowing scrolling.
260efb8e [gemini-3.7-flash] #• `C=` Key (bottom-left corner, next to Left Shift): Used for typing the PETSCII graphics
260efb8e [gemini-3.7-flash] #characters printed on the front of the keycaps, switching character sets (`C=` + `SHIFT`), and
260efb8e [gemini-3.7-flash] #secondary color sets.
260efb8e [gemini-3.7-flash] #
