26239d3b [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.002 11.08KB 2.30s
26239d3b [gemini-3.7-flash] #Screen memory on the Commodore PET is located at `8000`–`83E7` (40 columns × 25 lines =
26239d3b [gemini-3.7-flash] #1,000 bytes) or `8000`–`87CF` on 80-column models (80 × 25 = 2,000 bytes).
26239d3c [gemini-3.7-flash] #
26239d3c [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26239d3c [gemini-3.7-flash] #
26239d3c [gemini-3.7-flash] #Key Memory Map Details
26239d3d [gemini-3.7-flash] #
26239d3d [gemini-3.7-flash] #• Start Address: `$8000`
26239d3d [gemini-3.7-flash] #• End Address (40-column PET): `$83E7` (1,000 characters)
26239d3d [gemini-3.7-flash] #• End Address (80-column PET): `$87CF` (2,000 characters)
26239d3e [gemini-3.7-flash] #• Total Address Space Allocated: `8000`–`87FF` (2 KB of static RAM wired to the video
26239d3e [gemini-3.7-flash] #display circuitry)
26239d3e [gemini-3.7-flash] #
26239d3e [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26239d3f [gemini-3.7-flash] #
26239d3f [gemini-3.7-flash] #Organization
26239d3f [gemini-3.7-flash] #
26239d3f [gemini-3.7-flash] #1. Linear Layout: Screen RAM is mapped contiguously from top-left to bottom-right:
26239d40 [gemini-3.7-flash] #   * `$8000`: Row 0, Column 0 (top-left corner)
26239d40 [gemini-3.7-flash] #   * `$8027`: Row 0, Column 39 (top-right on 40-col models)
26239d40 [gemini-3.7-flash] #   * `$8028`: Row 1, Column 0
26239d40 [gemini-3.7-flash] #   * `$83E7`: Row 24, Column 39 (bottom-right on 40-col models)
26239d41 [gemini-3.7-flash] #
26239d41 [gemini-3.7-flash] #2. Screen Codes (Not ASCII/PETSCII):
26239d41 [gemini-3.7-flash] #   The bytes in screen memory are PET Screen Codes, which map directly to character glyphs
26239d41 [gemini-3.7-flash] #in the character ROM (e.g., Screen Code `00` = `@`, `01` = `A`, `20` = Space, `80`–`$FF` = Inverted
26239d42 [gemini-3.7-flash] #characters).
26239d42 [gemini-3.7-flash] #
26239d42 [gemini-3.7-flash] #3. No Color RAM:
26239d42 [gemini-3.7-flash] #   Unlike the VIC-20 or C64, standard PET hardware is monochrome and has no separate Color RAM
26239d43 [gemini-3.7-flash] #area. Characters are displayed directly using only the byte at `$8000` + offset.
26239d43 [gemini-3.7-flash] #
