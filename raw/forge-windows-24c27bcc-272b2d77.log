260eb94a [gemini-3.7-flash] #• Left Shift is located on Row 3, Column 1 (alongside `Z`, `C`, `B`, `M`, `,`,
260eb94a [gemini-3.7-flash] #`/`).
260eb94a [gemini-3.7-flash] #• Right Shift is located on Row 4, Column 6 (alongside `SPACE`, `X`, `V`, `N`, `.`,
260eb94b [gemini-3.7-flash] #`CURSOR UP/DOWN`).
260eb94b [gemini-3.7-flash] #
260eb94b [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
