2640d9ac [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.135 495.6KB 6.22s
2640d9ac [gemini-3.7-flash] #Understood: no full-file refactors, only targeted diffs and discussion.
2640d9ad [gemini-3.7-flash] #
2640d9ad [gemini-3.7-flash] #Here is the exact issue causing `INC $E810` to not cycle through the keyboard rows properly:
2640d9ad [gemini-3.7-flash] #
2640d9ad [gemini-3.7-flash] #The Cause
2640d9ae [gemini-3.7-flash] #In `readAddressBus()`, reads to `$E800` range are routed through `this.readPET(address)`. In your
2640d9ae [gemini-3.7-flash] #current code:
2640d9ae [gemini-3.7-flash] #
2640d9af [gemini-3.7-flash] #
2640d9af [gemini-3.7-flash] #case 0xe810: // PIA1_PA
2640d9af [gemini-3.7-flash] #	const cra = mem[0xE811];
2640d9af [gemini-3.7-flash] #	if ((cra&4)===0) {
2640d9b0 [gemini-3.7-flash] #		traceLog("[PET] read ddra",hex(this.ddra));
2640d9b0 [gemini-3.7-flash] #		return this.ddra;
2640d9b0 [gemini-3.7-flash] #	}
2640d9b0 [gemini-3.7-flash] #	mem[0xE811]&=0x3f;
2640d9b0 [gemini-3.7-flash] #	value=0xc0|(value&15);
2640d9b1 [gemini-3.7-flash] #	break;
2640d9b1 [gemini-3.7-flash] #
2640d9b1 [gemini-3.7-flash] #
2640d9b1 [gemini-3.7-flash] #When `INC $E810` executes:
2640d9b2 [gemini-3.7-flash] #1. It reads `E810`, returning `0xC0 | (value & 15)` (e.g. `C0`).
2640d9b2 [gemini-3.7-flash] #2. It increments the value in the CPU (`C0` \rightarrow `C1`).
2640d9b2 [gemini-3.7-flash] #3. It writes `$C1` back via `writePET()`, which executes `scanKeyboard(value & 15)`.
2640d9b3 [gemini-3.7-flash] #4. However, inside `writePET(0xE810)`, the early `return` when `(cra & 4) === 0` is fine, but on
2640d9b3 [gemini-3.7-flash] #normal writes `mem[address] = value` was being bypassed or masked out in `writeAddress`.
2640d9b3 [gemini-3.7-flash] #
2640d9b3 [gemini-3.7-flash] #The Diff
2640d9b3 [gemini-3.7-flash] #
2640d9b4 [gemini-3.7-flash] #Here is the simple diff for `readPET` and `writePET` to make sure the row select register stores
2640d9b4 [gemini-3.7-flash] #and returns the latched row:
2640d9b4 [gemini-3.7-flash] #
2640d9b4 [gemini-3.7-flash] #
2640d9b5 [gemini-3.7-flash] #--- a/machine.ts
2640d9b5 [gemini-3.7-flash] #+++ b/machine.ts
2640d9b5 [gemini-3.7-flash] #@@ -628,7 +628,7 @@ class Machine {
2640d9b5 [gemini-3.7-flash] # 					return this.ddra;
2640d9b6 [gemini-3.7-flash] # 				}
2640d9b6 [gemini-3.7-flash] # 				mem[0xE811]&=0x3f;
2640d9b6 [gemini-3.7-flash] #-				value=0xc0|(value&15);
2640d9b6 [gemini-3.7-flash] #+				value=0xc0|(mem[0xE810]&15);
2640d9b7 [gemini-3.7-flash] # 				break;
2640d9b7 [gemini-3.7-flash] # 			case 0xe812: //	PIA1_PB
2640d9b7 [gemini-3.7-flash] # 				const crb = mem[0xE813];
2640d9b8 [gemini-3.7-flash] #@@ -669,6 +669,7 @@ class Machine {
2640d9b8 [gemini-3.7-flash] # 		}
2640d9b8 [gemini-3.7-flash] # 		const label=this.addresLabel(address);
2640d9b8 [gemini-3.7-flash] # 		traceLog("[PET] write",label,hex(address),hex(value));
2640d9b9 [gemini-3.7-flash] #+		mem[address]=value;
2640d9b9 [gemini-3.7-flash] # 	}
2640d9b9 [gemini-3.7-flash] #
2640d9b9 [gemini-3.7-flash] #
2640d9ba [gemini-3.7-flash] #Discussion
2640d9ba [gemini-3.7-flash] #1. `scanKeyboard(value & 15)` needs to tell your terminal/FFI matrix layer which row (0–9) is
2640d9ba [gemini-3.7-flash] #actively being driven low so that the subsequent `readPetMatrix()` call for `$E812` returns the 8
2640d9ba [gemini-3.7-flash] #column bits for that specific row.
2640d9bb [gemini-3.7-flash] #2. In `readPetMatrix()`, unpressed keys must return `0xFF` (all bits high), and any pressed key
2640d9bb [gemini-3.7-flash] #must pull its column bit low (`0`).
2640d9bb [gemini-3.7-flash] #
