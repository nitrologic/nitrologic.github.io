25b97034 [gemini-3.6-flash] #🟠nitrologic Relay 2.0.1 gemini-3.6-flash 🌟 🪠 0.7° $0.184 245.6KB 21.85s
25b97034 [gemini-3.6-flash] #To fully define the Motorola 6800 instruction set using this schema, you need 16 spec
25b97034 [gemini-3.6-flash] #profiles (indexed `0` through `15`).
25b97035 [gemini-3.6-flash] #
25b97035 [gemini-3.6-flash] #Because Motorola organized the 6800 opcodes into regular addressing mode blocks, its timing
25b97035 [gemini-3.6-flash] #patterns condense into 16 profile entries (matching the count of the 6502).
25b97035 [gemini-3.6-flash] #
25b97035 [gemini-3.6-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
25b97036 [gemini-3.6-flash] #
25b97036 [gemini-3.6-flash] #Complete `specprofile` for 6800
25b97036 [gemini-3.6-flash] #
25b97036 [gemini-3.6-flash] #
25b97037 [gemini-3.6-flash] #	"specprofile": [
25b97037 [gemini-3.6-flash] #		{"bytes": [1], "cycles": [2]},
25b97037 [gemini-3.6-flash] #		{"bytes": [1], "cycles": [4]},
25b97037 [gemini-3.6-flash] #		{"bytes": [1, 1], "cycles": [4, 4]},
25b97038 [gemini-3.6-flash] #		{"bytes": [1], "cycles": [10]},
25b97038 [gemini-3.6-flash] #		{"bytes": [1], "cycles": [12]},
25b97038 [gemini-3.6-flash] #		{"bytes": [2], "cycles": [4]},
25b97038 [gemini-3.6-flash] #		{"bytes": [2], "cycles": [8]},
25b97038 [gemini-3.6-flash] #		{"bytes": [1], "cycles": [5]},
25b97039 [gemini-3.6-flash] #		{"bytes": [2, 3], "cycles": [4, 3]},
25b97039 [gemini-3.6-flash] #		{"bytes": [2, 3], "cycles": [8, 9]},
25b97039 [gemini-3.6-flash] #		{"bytes": [2, 2, 3], "cycles": [5, 7, 6]},
25b97039 [gemini-3.6-flash] #		{"bytes": [3, 2, 2, 3], "cycles": [3, 4, 6, 5]},
25b9703a [gemini-3.6-flash] #		{"bytes": [1, 1, 2, 3], "cycles": [2, 2, 7, 6]},
25b9703a [gemini-3.6-flash] #		{"bytes": [1], "cycles": [9]},
25b9703a [gemini-3.6-flash] #		{"bytes": [2, 2, 3, 2, 2, 3], "cycles": [4, 6, 5, 4, 6, 5]},
25b9703b [gemini-3.6-flash] #		{"bytes": [2, 2, 2, 3, 2, 2, 3], "cycles": [2, 3, 5, 4, 2, 3, 5, 4]}
25b9703b [gemini-3.6-flash] #	]
25b9703b [gemini-3.6-flash] #
25b9703b [gemini-3.6-flash] #
25b9703c [gemini-3.6-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
25b9703c [gemini-3.6-flash] #
25b9703c [gemini-3.6-flash] #Profile Index Mapping Breakdown
25b9703c [gemini-3.6-flash] #
25b9703d [gemini-3.6-flash] #╭────────────────┬───────────────────────────────────────────────────────────────────────────────────────────────────────────┬───────────────────────────────────────────────────────────────────────────┬─────────────────────────────────────────────────────────────────────────╮
25b9703d [gemini-3.6-flash] #│  `spec` Index  │  Used By Instructions                                                                                     │  Profile Pattern (`bytes` / `cycles`)                                     │  Description / Addressing Modes                                         │
25b9703d [gemini-3.6-flash] #├────────────────┼───────────────────────────────────────────────────────────────────────────────────────────────────────────┼───────────────────────────────────────────────────────────────────────────┼─────────────────────────────────────────────────────────────────────────┤
25b9703d [gemini-3.6-flash] #│  :---:         │  :---                                                                                                     │  :---                                                                     │  :---                                                                   │
25b9703e [gemini-3.6-flash] #│  **`0`**       │  `ABA`, `CBA`, `CLC`, `CLI`, `CLV`, `DAA`, `NOP`, `SBA`, `SEC`, `SEI`, `SEV`, `TAB`, `TAP`, `TBA`, `TPA`  │  `bytes: [1]`<br>`cycles: [2]`                                            │  1-byte, 2-cycle Inherent instructions                                  │
25b9703e [gemini-3.6-flash] #│  **`1`**       │  `DES`, `DEX`, `INS`, `INX`, `TSX`, `TXS`                                                                 │  `bytes: [1]`<br>`cycles: [4]`                                            │  1-byte, 4-cycle Index/Stack operations                                 │
25b9703e [gemini-3.6-flash] #│  **`2`**       │  `PSH`, `PUL`                                                                                             │  `bytes: [1, 1]`<br>`cycles: [4, 4]`                                      │  Stack Push/Pull (Accumulators A and B)                                 │
25b9703f [gemini-3.6-flash] #│  **`3`**       │  `RTI`                                                                                                    │  `bytes: [1]`<br>`cycles: [10]`                                           │  Return from Interrupt                                                  │
25b9703f [gemini-3.6-flash] #│  **`4`**       │  `SWI`                                                                                                    │  `bytes: [1]`<br>`cycles: [12]`                                           │  Software Interrupt                                                     │
25b9703f [gemini-3.6-flash] #│  **`5`**       │  `BCC`, `BCS`, `BEQ`, `BGE`, `BGT`, `BHI`, `BLE`, `BLS`, `BLT`, `BMI`, `BNE`, `BPL`, `BRA`, `BVC`, `BVS`  │  `bytes: [2]`<br>`cycles: [4]`                                            │  Relative Conditional Branches                                          │
25b9703f [gemini-3.6-flash] #│  **`6`**       │  `BSR`                                                                                                    │  `bytes: [2]`<br>`cycles: [8]`                                            │  Branch to Subroutine (Relative)                                        │
25b97040 [gemini-3.6-flash] #│  **`7`**       │  `RTS`                                                                                                    │  `bytes: [1]`<br>`cycles: [5]`                                            │  Return from Subroutine                                                 │
25b97040 [gemini-3.6-flash] #│  **`8`**       │  `JMP`                                                                                                    │  `bytes: [2, 3]`<br>`cycles: [4, 3]`                                      │  Jump (Indexed, Extended)                                               │
25b97040 [gemini-3.6-flash] #│  **`9`**       │  `JSR`                                                                                                    │  `bytes: [2, 3]`<br>`cycles: [8, 9]`                                      │  Jump to Subroutine (Indexed, Extended)                                 │
25b97040 [gemini-3.6-flash] #│  **`10`**      │  `STS`, `STX`                                                                                             │  `bytes: [2, 2, 3]`<br>`cycles: [5, 7, 6]`                                │  16-bit Register Stores (Direct, Indexed, Extended)                     │
25b97041 [gemini-3.6-flash] #│  **`11`**      │  `CPX`, `LDS`, `LDX`                                                                                      │  `bytes: [3, 2, 2, 3]`<br>`cycles: [3, 4, 6, 5]`                          │  16-bit Register Loads/Compares (Immediate, Direct, Indexed, Extended)  │
25b97041 [gemini-3.6-flash] #│  **`12`**      │  `ASL`, `ASR`, `CLR`, `COM`, `DEC`, `INC`, `LSR`, `NEG`, `ROL`, `ROR`, `TST`                              │  `bytes: [1, 1, 2, 3]`<br>`cycles: [2, 2, 7, 6]`                          │  Read-Modify-Write (Accumulator A, Accumulator B, Indexed, Extended)    │
25b97041 [gemini-3.6-flash] #│  **`13`**      │  `WAI`                                                                                                    │  `bytes: [1]`<br>`cycles: [9]`                                            │  Wait for Interrupt                                                     │
25b97041 [gemini-3.6-flash] #│  **`14`**      │  `STA`                                                                                                    │  `bytes: [2, 2, 3, 2, 2, 3]`<br>`cycles: [4, 6, 5, 4, 6, 5]`              │  8-bit Accumulator Stores (DIR, IDX, EXT for A & B)                     │
25b97042 [gemini-3.6-flash] #│  **`15`**      │  `ADC`, `ADD`, `AND`, `BIT`, `CMP`, `EOR`, `LDA`, `ORA`, `SBC`, `SUB`                                     │  `bytes: [2, 2, 2, 3, 2, 2, 2, 3]`<br>`cycles: [2, 3, 5, 4, 2, 3, 5, 4]`  │  8-bit Arithmetic & Logic (IMM, DIR, IDX, EXT for A & B)                │
25b97042 [gemini-3.6-flash] #╰────────────────┴───────────────────────────────────────────────────────────────────────────────────────────────────────────┴───────────────────────────────────────────────────────────────────────────┴─────────────────────────────────────────────────────────────────────────╯
