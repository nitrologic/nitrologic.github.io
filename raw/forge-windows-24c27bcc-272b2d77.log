264f49e9 [gemini-3.7-flash] #
264f49e9 [gemini-3.7-flash] #2. Cartridge / Function ROM Header Layout
264f49e9 [gemini-3.7-flash] #
264f49ea [gemini-3.7-flash] #For every bank it selects, the KERNAL checks the header located at `8000–8009` in memory:
264f49ea [gemini-3.7-flash] #
264f49ea [gemini-3.7-flash] #╭─────────────────────┬────────────────────────────────────────────────────┬─────────────────────────────────────────────────────────────────────╮
264f49ea [gemini-3.7-flash] #│  Address            │  Description                                       │  Expected Value                                                     │
264f49eb [gemini-3.7-flash] #├─────────────────────┼────────────────────────────────────────────────────┼─────────────────────────────────────────────────────────────────────┤
264f49eb [gemini-3.7-flash] #│  :---               │  :---                                              │  :---                                                               │
264f49eb [gemini-3.7-flash] #│  **`$8000–$8001`**  │  Cold start entry point address (low, high)        │  Address pointer                                                    │
264f49eb [gemini-3.7-flash] #│  **`$8002–$8003`**  │  Warm start entry point address (low, high)        │  Address pointer                                                    │
264f49ec [gemini-3.7-flash] #│  **`$8004–$8005`**  │  Cartridge signature string continuation or flags  │  Optional                                                           │
264f49ec [gemini-3.7-flash] #│  **`$8006`**        │  **Cartridge Boot Type / Autostart Byte**          │  `$01` = Autostart immediately<br>`$00` / other = Do not autostart  │
264f49ec [gemini-3.7-flash] #│  **`$8007–$8009`**  │  **Identification Magic String**                   │  ASCII `"CBM"` (`$43`, `$42`, `$4D`)                                │
264f49ed [gemini-3.7-flash] #╰─────────────────────┴────────────────────────────────────────────────────┴─────────────────────────────────────────────────────────────────────╯
264f49ed [gemini-3.7-flash] #
264f49ed [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264f49ed [gemini-3.7-flash] #
264f49ee [gemini-3.7-flash] #3. Required Simulator Implementation
264f49ee [gemini-3.7-flash] #
264f49ee [gemini-3.7-flash] #To correctly handle this sequence in your memory controller:
264f49ee [gemini-3.7-flash] #
264f49ef [gemini-3.7-flash] #1. Strobe Decoding on `FDD0–FDDF`:
264f49ef [gemini-3.7-flash] #   * Intercept any read or write access to `FDD0–FDDF`.
264f49ef [gemini-3.7-flash] #   * Extract the lower 4 bits `(address & 0x0F)`.
264f49ef [gemini-3.7-flash] #   * Switch the active memory buffer mapped at `8000–BFFF` (and `C000–FFFF` if applicable) to match
264f49f0 [gemini-3.7-flash] #the selected internal ROM image, external cartridge file, or open bus/RAM if no ROM is plugged into
264f49f0 [gemini-3.7-flash] #that socket.
264f49f0 [gemini-3.7-flash] #
264f49f1 [gemini-3.7-flash] #2. Open Bus Behavior for Empty Sockets:
264f49f1 [gemini-3.7-flash] #   * If an internal ROM (like the 3+1 suite) or cartridge is not loaded for a particular bank,
264f49f1 [gemini-3.7-flash] #reading `8007–8009` should not return `"CBM"`.
264f49f1 [gemini-3.7-flash] #   * In your current trace, all banks are returning `"CBM"`, which means the simulator is mapping
264f49f2 [gemini-3.7-flash] #the same ROM image across all banks or leaving data on the bus matching that signature.
264f49f2 [gemini-3.7-flash] #
