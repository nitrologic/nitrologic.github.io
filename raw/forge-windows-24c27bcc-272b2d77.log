262ba114 [gemini-3.7-flash] #This is the middle section of the BASIC Zero-Page `CHRGET` Routine Initialization.
262ba115 [gemini-3.7-flash] #
262ba115 [gemini-3.7-flash] #What is Being Copied:
262ba115 [gemini-3.7-flash] #In Microsoft 6502 BASIC (including Commodore BASIC 1.0/2.0/4.0), the fundamental character-getting
262ba115 [gemini-3.7-flash] #subroutine `CHRGET` (and `CHRGOT`) is copied directly into Zero Page RAM starting at `0070`
262ba116 [gemini-3.7-flash] #(or `00C1` in this specific PET ROM revision layout).
262ba116 [gemini-3.7-flash] #
262ba116 [gemini-3.7-flash] #Because `CHRGET` is executed for almost every byte of BASIC text parsed during program execution,
262ba116 [gemini-3.7-flash] #running it out of zero page allows the code to use fast Zero-Page addressing and self-modifying
262ba117 [gemini-3.7-flash] #pointers (`INC $xx` / `BNE`).
262ba117 [gemini-3.7-flash] #
262ba117 [gemini-3.7-flash] #Breakdown of the Opcodes Being Copied:
262ba118 [gemini-3.7-flash] #The bytes copied in this trace comprise the core text scanning and numeric-validation logic:
262ba118 [gemini-3.7-flash] #
262ba118 [gemini-3.7-flash] #
262ba118 [gemini-3.7-flash] #; Bytes being written to zero page:
262ba119 [gemini-3.7-flash] #$CB: CMP #$3A      ; C9 3A    - Check if character is ':' (statement separator) or > '9'
262ba119 [gemini-3.7-flash] #$CD: BCS ...       ; B0 ...   - Branch if >= ':' (not a digit)
262ba119 [gemini-3.7-flash] #$CF: CMP #$20      ; C9 20    - Check if character is a space
262ba119 [gemini-3.7-flash] #$D1: BEQ ...       ; F0 ...   - Skip spaces automatically
262ba11a [gemini-3.7-flash] #$D3: SEC           ; 38       - Prepare Carry for subtraction
262ba11a [gemini-3.7-flash] #$D4: SBC #$30      ; E9 30    - Convert ASCII/PETSCII digit ('0'-'9') to binary value
262ba11a [gemini-3.7-flash] #$D6: SEC           ; 38
262ba11a [gemini-3.7-flash] #$D7: SBC #$D0      ; E9 D0    - Validate range / carry flag state
262ba11b [gemini-3.7-flash] #$D9: RTS           ; 60       - Return to caller with character in A and status flags set
262ba11b [gemini-3.7-flash] #
262ba11b [gemini-3.7-flash] #
262ba11b [gemini-3.7-flash] #Once this loop completes (counting `X` down to `0`), BASIC will proceed to memory sizing (`RAMTAS`)
262ba11c [gemini-3.7-flash] #to detect the top of available RAM.
262ba11c [gemini-3.7-flash] #
