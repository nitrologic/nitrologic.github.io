264fa156 [gemini-3.7-flash] #• No, not all writes to `F000–FFFF` go to RAM.*
264fa156 [gemini-3.7-flash] #
264fa156 [gemini-3.7-flash] #Whether a write goes to RAM or triggers a hardware register depends entirely on the exact
264fa156 [gemini-3.7-flash] #sub-range within the `$Fxxx` block.
264fa157 [gemini-3.7-flash] #
264fa157 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264fa157 [gemini-3.7-flash] #
264fa158 [gemini-3.7-flash] #Write Behavior Map for `F000–FFFF`
264fa158 [gemini-3.7-flash] #
264fa158 [gemini-3.7-flash] #
264fa158 [gemini-3.7-flash] #╭─────────────────────┬──────────────────┬─────────────────────────────────────────────────────────────╮
264fa159 [gemini-3.7-flash] #│  Address Range      │  Target on WRITE │  Description / Hardware Target                              │
264fa159 [gemini-3.7-flash] #├─────────────────────┼──────────────────┼─────────────────────────────────────────────────────────────┤
264fa159 [gemini-3.7-flash] #│  :---               │  :---:           │  :---                                                       │
264fa159 [gemini-3.7-flash] #│  **`$F000–$FCFF`**  │  **RAM**         │  Standard underlying RAM (Writes pass straight through).    │
264fa159 [gemini-3.7-flash] #│  **`$FD00–$FD0F`**  │  **Hardware**    │  **MOS 6551 ACIA** (RS-232 UART Registers).                │
264fa15a [gemini-3.7-flash] #│  **`$FD10–$FD1F`**  │  **Hardware**    │  **MOS 6529B SPI** (User Port Data Register).               │
264fa15a [gemini-3.7-flash] #│  **`$FD20–$FD2F`**  │  **Hardware**    │  **Speech / Open Bus** (Unconnected on stock Plus/4).       │
264fa15a [gemini-3.7-flash] #│  **`$FD30–$FDCF`**  │  **Hardware**    │  **Unassigned I/O** (Open bus / unmapped I/O area).         │
264fa15a [gemini-3.7-flash] #│  **`$FDD0–$FDDF`**  │  **Hardware**    │  **PLA ROM Bank Latches** (Selects Banks 0–3).              │
264fa15b [gemini-3.7-flash] #│  **`$FDE0–$FEFF`**  │  **RAM**         │  Standard underlying RAM (Kernal workspace variables).      │
264fa15b [gemini-3.7-flash] #│  **`$FF00–$FF1F`**  │  **Hardware**    │  **MOS 7360/8360 TED Registers** (Audio, Video, Timers).    │
264fa15b [gemini-3.7-flash] #│  **`$FF20–$FF3D`**  │  **Hardware**    │  **TED Register Mirrors** (Mirrors `$FF00–$FF1F`).          │
264fa15c [gemini-3.7-flash] #│  **`$FF3E`**        │  **Hardware**    │  **ROM Enable Strobe** (Switches ROM in, value is ignored). │
264fa15c [gemini-3.7-flash] #│  **`$FF3F`**        │  **Hardware**    │  **RAM Enable Strobe** (Switches RAM in, value is ignored). │
264fa15c [gemini-3.7-flash] #│  **`$FF40–$FFFF`**  │  **RAM**         │  **Underlying RAM** (CPU Vectors & RESET trampoline).       │
264fa15c [gemini-3.7-flash] #╰─────────────────────┴──────────────────┴─────────────────────────────────────────────────────────────╯
264fa15d [gemini-3.7-flash] #
264fa15d [gemini-3.7-flash] #
264fa15d [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264fa15d [gemini-3.7-flash] #
264fa15e [gemini-3.7-flash] #Key Takeaways for Simulator Architecture
264fa15e [gemini-3.7-flash] #
264fa15e [gemini-3.7-flash] #1. The I/O Holes (`FD00–FDDF` and `FF00–FF3F`):
264fa15e [gemini-3.7-flash] #   Writes to these ranges are intercepted by the PLA and routed to on-board peripheral
264fa15f [gemini-3.7-flash] #chips or bank-switching latches. They do not write to underlying RAM.
264fa15f [gemini-3.7-flash] #
264fa15f [gemini-3.7-flash] #2. The Vector / Trampoline Hole (`FF40–FFFF`):
264fa160 [gemini-3.7-flash] #   This area at the very top of the memory map contains no I/O chips.
264fa160 [gemini-3.7-flash] #   * Reads return the KERNAL ROM (when ROM is enabled via `$FF3E`).
264fa160 [gemini-3.7-flash] #   * Writes always pass through to underlying RAM.
264fa160 [gemini-3.7-flash] #   * This is why the loop in your trace (`LDA FFF6,X` \rightarrow `STA FFF6,X`) successfully clones
264fa161 [gemini-3.7-flash] #the ROM interrupt and reset vectors into RAM.
264fa161 [gemini-3.7-flash] #
