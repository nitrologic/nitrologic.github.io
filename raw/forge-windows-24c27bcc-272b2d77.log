263f5cd7 [nitro@ryzen5] 	ddra=0;	readPET(address:number){		const label=this.addresLabel(address);		const mem=this.memory;		const cycle=this.cycleCount;		let value=mem[address];		switch(address){			case 0xe810: // kb matrix				mem[0xE811]&=0x3f;				const cra = mem[0xE811];				if ((cra & 0x04) === 0) {					return this.ddra; // Accessing DDRA				}				return value|0xc0;			case 0xe812: //	"E812": "PIA1_PB",				traceLog("[PET] PIA1_PB polling keys clearing CB1|CB2");				mem[0xE813]&=0x3f;				return readPetMatrix();			case 0xe840: // video blanking=bit 5							value&=~0x20;	     		if (vidBlanking(cycle)) value |= 0x20;				break;        }		traceLog("[PET] read",label,hex(address),hex(value));		return value;	}	writePET(address:number,value:number){		const label=this.addresLabel(address);		traceLog("[PET] write",label,hex(address),hex(value));		const mem=this.memory;		switch(address){			case 0xE810:				let cra=mem[0xe811];				if(cra&4){					scanKeyboard(value&15);				}else{					this.ddra=value;					return;				}				break;			case 0xE811:				value=(mem[0xE811]&0xc0)|(value&0x3f);				break;		}		mem[address]=value;	}
