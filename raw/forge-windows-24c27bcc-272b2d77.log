25ba2bf7 [deepseek-v4-flash] #Why
25ba2bf7 [deepseek-v4-flash] #
25ba2bf7 [deepseek-v4-flash] #╭─────────────────────┬─────────────────────────────────────────────────────┬────────────────╮
25ba2bf7 [deepseek-v4-flash] #│  Mode               │  ADC variants                                       │  Opcode count  │
25ba2bf8 [deepseek-v4-flash] #├─────────────────────┼─────────────────────────────────────────────────────┼────────────────┤
25ba2bf8 [deepseek-v4-flash] #│  Immediate          │  `ADC A, n`                                         │  1             │
25ba2bf8 [deepseek-v4-flash] #│  Register           │  `ADC A, r` (7 choices) + `ADC HL, rr` (4 choices)  │  11            │
25ba2bf9 [deepseek-v4-flash] #│  Register indirect  │  `ADC A, (HL)`                                      │  1             │
25ba2bf9 [deepseek-v4-flash] #│  Indexed            │  `ADC A, (IX+d)` + `ADC A, (IY+d)`                  │  2             │
