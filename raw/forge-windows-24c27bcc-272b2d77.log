25ba1ccf [deepseek-v4-flash] #The 10‑bit mode mask identifies which addressing modes a mnemonic uses, but not how
25ba1ccf [deepseek-v4-flash] #many opcodes it has. For `ADC`, the four modes expand to 15 distinct opcodes/encodings:
25ba1ccf [deepseek-v4-flash] #
25ba1cd0 [deepseek-v4-flash] #╭─────────────────────┬─────────────────────────────────────────────────────────────┬────────────────╮
25ba1cd0 [deepseek-v4-flash] #│  Addressing mode    │  Variants                                                   │  Opcode count  │
25ba1cd0 [deepseek-v4-flash] #├─────────────────────┼─────────────────────────────────────────────────────────────┼────────────────┤
25ba1cd0 [deepseek-v4-flash] #│  Register           │  ADC A, A/B/C/D/E/H/L                                       │  7             │
25ba1cd0 [deepseek-v4-flash] #│  Register indirect  │  ADC A, (HL)                                                │  1             │
25ba1cd1 [deepseek-v4-flash] #│  Immediate          │  ADC A, n                                                   │  1             │
25ba1cd1 [deepseek-v4-flash] #│  Indexed            │  ADC A, (IX+d) / (IY+d)                                     │  2             │
25ba1cd1 [deepseek-v4-flash] #│  —                  │  ADC HL, BC/DE/HL/SP (uses register mode, but 16‑bit form)  │  4             │
25ba1cd1 [deepseek-v4-flash] #╰─────────────────────┴─────────────────────────────────────────────────────────────┴────────────────╯
25ba1cd2 [deepseek-v4-flash] #
25ba1cd2 [deepseek-v4-flash] #Total 15.
25ba1cd2 [deepseek-v4-flash] #
25ba1cd3 [deepseek-v4-flash] #So the mode mask says “ADC can use these four addressing modes”, but the actual opcode
25ba1cd3 [deepseek-v4-flash] #count is larger because the same mode can combine with different register choices, 8‑ vs 16‑bit
25ba1cd3 [deepseek-v4-flash] #operands, and index prefixes.
25ba1cd3 [deepseek-v4-flash] #
25ba1cd4 [deepseek-v4-flash] #If you want to store opcode counts in your spec, a separate field like `"opcodeCount": 15` or a
25ba1cd4 [deepseek-v4-flash] #detailed variant list would be needed. The mask alone is only a high‑level summary.
25ba1cd4 [deepseek-v4-flash] #
