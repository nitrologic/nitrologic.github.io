\t}\r\n\r\n\tenable(flag:boolean){\r\n\t\tthis.enabled=flag;\r\n\t}\r\n\r\n\tLABS(address:number){\r\n\t\tconst mem=this.memory;\r\n\t\tthis.scale=mem[address+0];\r\n\t\tthis.intensity=mem[address+1]&0xf;\r\n\t\tthis.beam[0]=mem[address+2];\r\n\t\tthis.beam[1]=mem[address+3];\r\n\t\tconsole.log(\"[VEC] LABS\",{intensity:this.intensity,scale:this.scale,beam:this.beam});\r\n\t}\r\n\r\n\tSVEC(address:number){\r\n\t\tconst mem=this.memory;\r\n\t\tconst word0 = ((mem[address+1]&15) << 8) | mem[address+0];\r\n\t\tconsole.log(\"[VEC] \",hex(address,4),\"SVEC\",hex(word0, 4));\r\n\t}\r\n\r\n\tVEC(address:number){\r\n\t\tconst mem=this.memory;\r\n\t\tconst word0 = ((mem[address+1]&15) << 8) | mem[address+0];\r\n\t\tconst word1 = (mem[address+3] << 8) | mem[address+2];\r\n\t\tconsole.log(\"[VEC] \",hex(address,4),\"VEC\",hex(word0, 4),hex(word1, 4));\r\n\t}\r\n\r\n\tJSRL(address:number){\r\n\t\tconst mem=this.memory;\r\n\t\tconst target=((mem[address+1]<<8)|mem[address+0])&0xfff;\r\n\t\tconst sp=this.stackPointer++;\r\n\t\tthis.stack[sp]=(address+2);\r\n\t\tconsole.log(\"[VEC] \",hex(address,4),\"JSRL\",hex(target,4),sp);\r\n\t\treturn target;\r\n\t}\r\n\r\n\tRTSL():number{\r\n\t\tconst sp=--this.stackPointer;\r\n\t\tconst address=this.stack[sp];\r\n\t\tconsole.log(\"[VEC] \",hex(address,4),\"RTSL\",sp);\r\n\t\treturn address;\r\n\t}\r\n\r\n\tonGo(go:number){\t// location 0x3000 signal\r\n\t\tconsole.log(\"[VEC] onGo:\",hex(go));\r\n\t\tstepping=false;\r\n\t\tthis.memory[0x3000]=0;\r\n\t\tlet index=0;\r\n\t\tlet cycling=true;\r\n\t\tlet count=0;\r\n\t\tlet address=(this.memory[0x4001]&1)?0x4400:0x4000;\r\n\t\twhile (cycling&&(count++<20000)){\r\n\t\t\tconst op16=this.memory[address]|(this.memory[address+1]<<8);\r\n\t\t\tconst opcode=(op16>>12)&15;\r\n\t\t\tif (opcode <= 0x09) {\r\n\t\t\t\tthis.VEC(address);\r\n\t\t\t\taddress += 4;\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tswitch(opcode){\r\n\t\t\t\tcase 0x0a: //LABS\r\n\t\t\t\t\tthis.LABS(address);\r\n\t\t\t\t\taddress+=4;\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 0x0b: //HALT\r\n\t\t\t\t\tcycling=false;\r\n\t\t\t\t\tconsole.log(\"[VEC] HALT cycles:\",count);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 0x0c: //JSRL\r\n\t\t\t\t\taddress=0x4000+2*this.JSRL(address);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 0x0d: //RTSL\r\n\t\t\t\t\taddress=this.RTSL();\r\n\t\t\t\t\tconsole.log(\"[VEC] RTSL\",hex(address,4));\r\n//\t\t\t\t\tstepping=false;\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 0x0e://JMP\r\n\t\t\t\t\taddress=0x4000+2*(op16&0xfff);\r\n\t\t\t\t\tconsole.log(\"[VEC] JMP\",hex(address,4));\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 0x0f://\r\n\t\t\t\t\tthis.SVEC(address);\r\n\t\t\t\t\taddress+=2;\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tconsole.log(\"[VEC] fail on op\",hex(op16),opcode);\r\n\t\t\t\t\tstepping=false;\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n//\t\t\tconsole.log(\":\"+hex(address,4),hex(op16,4));\r\n\t\t}\r\n\t}\r\n}\r\nclass AudioOut{\r\n    tape:number[]=[];\r\n    recordTime:number;\r\n    recordLength:number;\r\n\r\n\tconstructor() {\r\n        this.clear();\r\n    }\r\n\r\n\tclear(){\r\n        this.tape=[];\r\n        this.recordTime=0;\r\n        this.recordLength=0;\r\n\t}\r\n\r\n    output(cycle:number){\r\n        const t=this.recordTime;\r\n        this.recordTime=cycle;\r\n        if(t){\r\n            const delta=cycle-t;\r\n            this.tape.push(delta);\r\n            this.recordLength+=delta;\r\n        }\r\n    }\r\n\r\n\r\n}\r\nclass CassetteRecorder{\r\n    tape:number[]=[];\r\n    recordTime:number;\r\n    recordLength:number;\r\n    playTime:number;\r\n    playIndex:number;\r\n\r\n    constructor() {\r\n        this.clear();\r\n    }\r\n\r\n    async writeFile(filename:string,fields:InfoFields){\r\n        return writeWavFile(filename,this.recordLength,this.tape,fields);\r\n    }\r\n\r\n    clear(){\r\n        this.tape=[];\r\n        this.recordTime=0;\r\n        this.recordLength=0;\r\n        this.playTime=0;\r\n        this.playIndex=0;\r\n    }\r\n\r\n    // record period\r\n\r\n    output(cycle:number){\r\n        const t=this.recordTime;\r\n        this.recordTime=cycle;\r\n        if(t){\r\n            const delta=cycle-t;\r\n            this.tape.push(delta);\r\n            this.recordLength+=delta;\r\n        }\r\n    }\r\n\r\n    // playback state\r\n    // advances playIndex through tape cycle durations and updates hardware state in bit 7\r\n    input(cycle: number): number {\r\n        const tape = this.tape;\r\n        const length = tape.length;\r\n        if (length==0) return 0;\r\n        if (this.playTime==0) {\r\n            this.playTime = cycle;\r\n            this.playIndex = 0;\r\n            return 0;\r\n        }\r\n        let elapsed = cycle - this.playTime;\r\n        while (this.playIndex < length && elapsed >= tape[this.playIndex]) {\r\n            elapsed -= tape[this.playIndex];\r\n            this.playIndex++;\r\n        }\r\n        this.playTime = cycle - elapsed;\r\n        if (this.playIndex >= length) {\r\n                return 0;\r\n        }\r\n        // Toggle state on every index step and return signal in Bit 7 ($80)\r\n        return (this.playIndex & 1) ? 0x80 : 0x00;\r\n    }\r\n\r\n    diagnostics(){\r\n        const bits=this.tape;\r\n        console.log(\"[TAPE] record diagnostics:\",{bits:bits.length,cycles:this.recordLength});\r\n        const histogram: Record<number, number> = {};\r\n        for (let i = 0; i < bits.length; i++) {\r\n            const delta = bits[i];// - bits[i - 1];\r\n            histogram[delta] = (histogram[delta] ?? 0) + 1;\r\n            if(delta>10000) console.log(\"[TAPE] delta max:\",{delta,index:i})\r\n        }\r\n        console.log(\"[TAPE] counts:\",histogram);\r\n    }\r\n}\r\n\r\n// 𝗗𝗔𝗧𝗔𝗦𝗘𝗧𝗧𝗘 ₀₀₁⬛⁰⁰⁰⁰\r\n\r\n// ⯬◀ ▶⯮\r\n// ▫□▢▢□▫\r\n// ⯬◀ ▶⯮\r\n// ▪■▣▣■▪\r\n\r\nfunction extractSampleLevel(view: DataView, offset: number, bitsPerSample: number): boolean {\r\n\tif (bitsPerSample==8) return view.getUint8(offset)>=128;\r\n\tif (bitsPerSample==16) return view.getInt16(offset,true)>=0;\r\n\treturn false;\r\n}\r\n\r\nfunction tristateSampleLevel(view: DataView, offset: number, bitsPerSample: number): number {\r\n\tconst sense=0.08;\r\n\tlet sample=0.0;\r\n\tif (bitsPerSample==8) {\r\n\t\tsample=(view.getUint8(offset)-128)/128.0;\r\n\t}\r\n\tif (bitsPerSample==16) {\r\n\t\tsample=view.getInt16(offset,true)/32768.0;\r\n\t}\r\n\tif(sample<-sense) return-1;\r\n\tif(sample>sense) return 1;\r\n\treturn 0;\r\n}\r\n\r\n\r\n/*\r\n\r\nconsole.log(\"wav located\",wav);\r\nconst bytes=await zip.decompress(wav);\r\nconsole.log(\"wav expanded\",bytes);\r\n//zip.dump();\r\n\r\n\r\nimport { parseWavHeader } from \"./wavfileutil.ts\";\r\nconst info = await parseWavHeader(bytes);\r\nconsole.log(\"WAV metadata:\", info);\r\n*/\r\n\r\n\r\nexport async function readCassetteFile(filename: string, recorder: CassetteRecorder): Promise<boolean> {\r\n\tlet bytes;\r\n\tif(filename.endsWith(\".zip\")){\r\n\t\tconst zip:ZipFile=await unZip(filename);\r\n\t\tconst wav=zip.get(\"\");\r\n\t\tconsole.log(\"wav located\",JSON.stringify(wav));\r\n\t\tbytes=await zip.decompress(wav);\r\n\t\tconsole.log(\"wav expanded\",bytes.length);\r\n\t}\r\n\tif(filename.endsWith(\".wav\")){\r\n\t\tbytes = await Deno.readFile(filename);\r\n\t}\r\n\ttry {\r\n\t\tconst buffer=bytes;\r\n\t\tconst header = parseWavHeader(buffer);\r\n\t\tconst meta = parseWavFile(buffer);\r\n\t\tconsole.log(\"[WAV]\",header,meta);\r\n\t\tconst view = new DataView(buffer.buffer, buffer.byteOffset, buffer.byteLength);\r\n\t\tconst clockRate = 1023000; // Apple II CPU clock frequency (Hz)\r\n\t\tconst bytesPerSample = (header.bitsPerSample >> 3) * header.channels;\r\n\t\tconst totalSamples = (header.dataLength / bytesPerSample) | 0;\r\n\t\tlet sampleCount = 0;\r\n\t\trecorder.clear();\r\n\r\n\t\tif(false){\r\n\t\t\tlet lastState = false;\r\n\t\t\tfor (let i = 0; i < totalSamples; i++) {\r\n\t\t\t\tconst sampleOffset = header.dataOffset + (i * bytesPerSample);\r\n\t\t\t\tconst currentState = ex