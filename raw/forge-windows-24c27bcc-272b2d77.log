25ba0c8d [deepseek-v4-flash] #- bit 0 = immediate
25ba0c8e [deepseek-v4-flash] #- bit 5 = indexed
25ba0c8e [deepseek-v4-flash] #- bit 6 = register
25ba0c8e [deepseek-v4-flash] #- bit 7 = register indirect
25ba0c8e [deepseek-v4-flash] #
