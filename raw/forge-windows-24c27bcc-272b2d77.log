25ba39ef [deepseek-v4-flash] #  "modes": "1000011100",
25ba39f0 [deepseek-v4-flash] #  "opbits": ["CE", "88", "8E", "DD8E"],
25ba39f0 [deepseek-v4-flash] #  "label": "add with carry",
25ba39f0 [deepseek-v4-flash] #  "flags": "SZHPNC"
25ba39f0 [deepseek-v4-flash] #}
25ba39f1 [deepseek-v4-flash] #
25ba39f1 [deepseek-v4-flash] #
25ba39f1 [deepseek-v4-flash] #Mapping:
25ba39f1 [deepseek-v4-flash] #- `CE` → immediate
25ba39f2 [deepseek-v4-flash] #- `88` → register (masked, for `ADC A,r` with r=000)
25ba39f2 [deepseek-v4-flash] #- `8E` → register indirect
25ba39f2 [deepseek-v4-flash] #- `DD8E` → indexed (using IX; IY version is omitted for simplicity)
25ba39f3 [deepseek-v4-flash] #
25ba39f3 [deepseek-v4-flash] #But note: `register` also has the `ADC HL,rr` forms (`ED 4A`, etc.), and `indexed` has both IX and
25ba39f3 [deepseek-v4-flash] #IY variants. Those are lost in this version. That's fine if your spec doesn't need them.
25ba39f3 [deepseek-v4-flash] #
25ba39f4 [deepseek-v4-flash] #If you want to keep the array exactly one byte per mode, you could store only the primary opcode
25ba39f4 [deepseek-v4-flash] #byte and ignore prefixes:
25ba39f4 [deepseek-v4-flash] #
25ba39f4 [deepseek-v4-flash] #
25ba39f5 [deepseek-v4-flash] #"opbits": ["CE", "88", "8E", "8E"]
25ba39f5 [deepseek-v4-flash] #
25ba39f5 [deepseek-v4-flash] #
25ba39f5 [deepseek-v4-flash] #…but then the prefixes (`DD`) and the duplicate `8E` make it ambiguous. Using strings like `"DD8E"`
25ba39f6 [deepseek-v4-flash] #is clearer while still being compact.
25ba39f6 [deepseek-v4-flash] #
25ba39f6 [deepseek-v4-flash] #Either way, the key is that `opbits` is now a list of representative masked opcodes, one per mode,
25ba39f7 [deepseek-v4-flash] #not a claim about total opcode count. That's a reasonable trade-off for a human-readable summary.
25ba39f7 [deepseek-v4-flash] #
25ba40d6 [nitro@ryzen5] hmmm i can live with this format
25ba40dd [nitro@ryzen5] 		"ADC":{			"opcodes": {"immediate": ["CE"],"register": ["88", "ED 4A"],"register indirect": ["8E"],"indexed": ["DD 8E", "FD 8E"]},			"label":"add with carry",			"flags":"SZHPNC"		},
25ba414c [deepseek-v4-flash] #🟠nitrologic Relay 2.0.1 deepseek-v4-flash 🐋 🪠 0.7° $0.001 27.25KB 6.56s
25ba414c [deepseek-v4-flash] #That format works well — it's explicit, unambiguous, and still human-readable. For `ADC` it
25ba414d [deepseek-v4-flash] #correctly captures both the 8‑bit register forms (`88` base) and the 16‑bit `HL` forms (`ED 4A`),
25ba414d [deepseek-v4-flash] #plus both index prefixes (`DD`/`FD`).
25ba414d [deepseek-v4-flash] #
25ba414d [deepseek-v4-flash] #If you ever need the 10‑bit mask again, you can derive it from the object keys:
25ba414e [deepseek-v4-flash] #
25ba414e [deepseek-v4-flash] #
25ba414e [deepseek-v4-flash] #immediate           → bit 0
25ba414e [deepseek-v4-flash] #immediate extended  → bit 1
25ba414e [deepseek-v4-flash] #modified page zero  → bit 2
25ba414f [deepseek-v4-flash] #relative            → bit 3
25ba414f [deepseek-v4-flash] #extended            → bit 4
25ba414f [deepseek-v4-flash] #indexed             → bit 5
25ba414f [deepseek-v4-flash] #register            → bit 6
25ba4150 [deepseek-v4-flash] #register indirect   → bit 7
25ba4150 [deepseek-v4-flash] #implied             → bit 8
25ba4150 [deepseek-v4-flash] #bit address         → bit 9
25ba4150 [deepseek-v4-flash] #
25ba4151 [deepseek-v4-flash] #
25ba4151 [deepseek-v4-flash] #So for `ADC`:
25ba4151 [deepseek-v4-flash] #
25ba4151 [deepseek-v4-flash] #
25ba4151 [deepseek-v4-flash] #indexed (bit5), register (bit6), register indirect (bit7), immediate (bit0)
25ba4151 [deepseek-v4-flash] #→ mask = 0b1000011100 = 0xE1 = 225
25ba4151 [deepseek-v4-flash] #
25ba4152 [deepseek-v4-flash] #
25ba4152 [deepseek-v4-flash] #But storing the explicit `opcodes` object is arguably better than a mask alone — it gives you the
25ba4152 [deepseek-v4-flash] #actual opcode patterns, not just a summary. The mask becomes a derived convenience, not the source
25ba4152 [deepseek-v4-flash] #of truth.
25ba4152 [deepseek-v4-flash] #
25ba4153 [deepseek-v4-flash] #One small suggestion: keep the key names consistent with your `addressmode` list (e.g. `"register
25ba4153 [deepseek-v4-flash] #indirect"` vs `"registerIndirect"`). That way tooling can map between them automatically.
25ba4153 [deepseek-v4-flash] #
25ba4153 [deepseek-v4-flash] #Looks good to me.
25ba4154 [deepseek-v4-flash] #
25bab5cc [deepseek-v4-flash] #🟠nitrologic Relay 2.0.1 deepseek-v4-flash 🐋 🪠 0.7° $0.012 226.4KB 26.77s
25bab5cc [deepseek-v4-flash] #Thanks for sharing the current state of the specs. A few observations:
25bab5cc [deepseek-v4-flash] #
25bab5cc [deepseek-v4-flash] #z80.json
25bab5cd [deepseek-v4-flash] #
25bab5cd [deepseek-v4-flash] #The `ADC` entry now uses the `forms` array, which matches the masked‑opcode idea we discussed:
25bab5cd [deepseek-v4-flash] #
25bab5cd [deepseek-v4-flash] #
25bab5cd [deepseek-v4-flash] #"ADC":{
25bab5ce [deepseek-v4-flash] #  "forms": ["CE","88","ED 4A","8E","DD 8E","FD 8E"],
25bab5ce [deepseek-v4-flash] #  "label":"add with carry",
25bab5ce [deepseek-v4-flash] #  "flags":"SZHPNC"
25bab5ce [deepseek-v4-flash] #}
25bab5cf [deepseek-v4-flash] #
25bab5cf [deepseek-v4-flash] #
25bab5cf [deepseek-v4-flash] #That's correct as a compact summary:
25bab5d0 [deepseek-v4-flash] #
25bab5d0 [deepseek-v4-flash] #- `CE` → `ADC A,n`
25bab5d0 [deepseek-v4-flash] #- `88` → base for `ADC A,r` (register bits masked out)
25bab5d0 [deepseek-v4-flash] #- `ED 4A` → base for `ADC HL,rr`
25bab5d1 [deepseek-v4-flash] #- `8E` → `ADC A,(HL)`
25bab5d1 [deepseek-v4-flash] #- `DD 8E` / `FD 8E` → `ADC A,(IX+d)` / `ADC A,(IY+d)`
25bab5d1 [deepseek-v4-flash] #
25bab5d1 [deepseek-v4-flash] #One thing to keep in mind: the `encoding` object in your z80.json currently covers only the
25bab5d2 [deepseek-v4-flash] #base 256 opcodes. `CB`, `ED`, `DD`, `FD` are listed as markers, but their expanded
25bab5d2 [deepseek-v4-flash] #sub‑opcodes are not included. That’s fine if `forms` is meant to be the authoritative source for
25bab5d2 [deepseek-v4-flash] #instruction lookup; if you later want to generate disassembler tables, you’ll need to add the
25bab5d2 [deepseek-v4-flash] #prefixed pages.
25bab5d3 [deepseek-v4-flash] #
25bab5d3 [deepseek-v4-flash] #m6800.json errata
25bab5d3 [deepseek-v4-flash] #
25bab5d4 [deepseek-v4-flash] #Your notes are correct:
25bab5d4 [deepseek-v4-flash] #
25bab5d4 [deepseek-v4-flash] #1. JSR currently uses `spec: 8`, which points to `{bytes:[2,3], cycles:[4,3]}` — that’s
25bab5d4 [deepseek-v4-flash] #JMP’s timing. It should be `spec: 9` → `{bytes:[2,3], cycles:[8,9]}`.
25bab5d5 [deepseek-v4-flash] #2. PSH currently uses `spec: 1`, which is a single‑opcode profile. PSH has two opcodes (`36
25bab5d5 [deepseek-v4-flash] #37`), so it should use `spec: 2` → `{bytes:[1,1], cycles:[4,4]}`.
25bab5d5 [deepseek-v4-flash] #3. After fixing PSH, profile 2 will be used by both PSH and PUL, which is consistent with the
25bab5d5 [deepseek-v4-flash] #two‑opcode grouping.
25bab5d6 [deepseek-v4-flash] #
25bab5d6 [deepseek-v4-flash] #The m6800 `specprofile` table itself matches the opcode counts in the `instruction` entries, so
25bab5d6 [deepseek-v4-flash] #just those two `spec` corrections should bring it in line.
25bab5d6 [deepseek-v4-flash] #
25bab5d7 [deepseek-v4-flash] #If you want, I can help expand the empty `instruction` entries in z80.json using the same `forms`
25bab5d7 [deepseek-v4-flash] #pattern, or check the m6800 entries for similar profile mismatches.
25bab5d7 [deepseek-v4-flash] #
