2640be6c [nitro@ryzen5] the trace should have scanning column for all columns 0..9?
2640bebc [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.098 330.3KB 4.50s
2640bebc [gemini-3.7-flash] #Yes, during a normal ROM keyboard scan interrupt, you should see writes to `E810` cycling through
2640bebd [gemini-3.7-flash] #values `0` through `9` (and then typically `0F` or `$00` when done).
2640bebd [gemini-3.7-flash] #
2640bebd [gemini-3.7-flash] #Here is the exact mechanism inside the Commodore PET Kernal ROM:
2640bebd [gemini-3.7-flash] #
2640bebe [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2640bebe [gemini-3.7-flash] #
2640bebe [gemini-3.7-flash] #How the PET Kernal Scans the Keyboard
2640bebe [gemini-3.7-flash] #
2640bebf [gemini-3.7-flash] #1. Outer Loop: The Kernal IRQ routine initializes a row/column counter (typically starting
2640bebf [gemini-3.7-flash] #at `0` or `9`).
2640bebf [gemini-3.7-flash] #2. Select Row: It writes the 4-bit number to Port A:
2640bebf [gemini-3.7-flash] #
2640bec0 [gemini-3.7-flash] #   STA $E810       ; Outputs row 0..9 to 74145 BCD decoder
2640bec0 [gemini-3.7-flash] #
2640bec0 [gemini-3.7-flash] #3. Read Columns: It immediately reads Port B:
2640bec0 [gemini-3.7-flash] #
2640bec1 [gemini-3.7-flash] #   LDA $E812       ; Reads the 8 column lines for the active row
2640bec1 [gemini-3.7-flash] #   CMP #$FF        ; $FF means no keys pressed on this row
2640bec1 [gemini-3.7-flash] #   BNE .key_found  ; If not $FF, a key is down on this row!
2640bec1 [gemini-3.7-flash] #
2640bec2 [gemini-3.7-flash] #4. Loop: It increments (or decrements) the counter and repeats until all 10 rows (0
2640bec2 [gemini-3.7-flash] #through 9) have been tested.
2640bec2 [gemini-3.7-flash] #5. Deselect: After the loop completes, it usually writes an invalid BCD digit (like `$0F`)
2640bec2 [gemini-3.7-flash] #to turn off all 74145 outputs.
2640bec3 [gemini-3.7-flash] #
2640bec3 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2640bec3 [gemini-3.7-flash] #
2640bec3 [gemini-3.7-flash] #What Your Trace Should Look Like Each VBLANK / IRQ
2640bec4 [gemini-3.7-flash] #
2640bec4 [gemini-3.7-flash] #On every vertical blank interrupt (~50/60 Hz), your trace log should output a burst resembling:
2640bec4 [gemini-3.7-flash] #
2640bec4 [gemini-3.7-flash] #
2640bec5 [gemini-3.7-flash] #[PET] scanning column 0
2640bec5 [gemini-3.7-flash] #[PET] scanning column 1
2640bec5 [gemini-3.7-flash] #[PET] scanning column 2
2640bec5 [gemini-3.7-flash] #...
2640bec6 [gemini-3.7-flash] #[PET] scanning column 9
2640bec6 [gemini-3.7-flash] #
2640bec6 [gemini-3.7-flash] #
2640bec7 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2640bec7 [gemini-3.7-flash] #
2640bec7 [gemini-3.7-flash] #Potential Reasons It Only Scans One Column or None
2640bec7 [gemini-3.7-flash] #
2640bec8 [gemini-3.7-flash] #• Port B Returning Non-`$FF` on Idle:
2640bec8 [gemini-3.7-flash] #  If `readPetMatrix()` returns `0x00` (or anything other than `0xFF`) when no keys are pressed, the
2640bec8 [gemini-3.7-flash] #Kernal believes every key on row 0 is pressed. Depending on the ROM version, it may either
2640bec8 [gemini-3.7-flash] #branch early to debounce/handle the key or lock up the scan.
2640bec9 [gemini-3.7-flash] #• Bit 7 of `$E813` (CRB) Not Set:
2640bec9 [gemini-3.7-flash] #  If bit 7 of `$E813` is not asserted when the IRQ fires, the Kernal interrupt handler treats the
2640bec9 [gemini-3.7-flash] #IRQ as a timer or cassette interrupt and skips the keyboard scanning loop entirely.
2640bec9 [gemini-3.7-flash] #• Interrupt Flag Cleared Prematurely:
2640beca [gemini-3.7-flash] #  If `E812` is read somewhere outside the IRQ routine, bit 7 of `E813` gets cleared before the
2640beca [gemini-3.7-flash] #Kernal IRQ handler has a chance to inspect it.
2640beca [gemini-3.7-flash] #
2640c312 [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.091 336.3KB 6.08s
2640c312 [gemini-3.7-flash] #The trace reveals the exact bug causing keyboard scanning to fail.
2640c312 [gemini-3.7-flash] #
2640c313 [gemini-3.7-flash] #Notice this pattern in your log:
2640c313 [gemini-3.7-flash] #
2640c313 [gemini-3.7-flash] #
2640c313 [gemini-3.7-flash] #[PET] scanning column 0
2640c314 [gemini-3.7-flash] #[PET] write PIA1_PA E810 C0
2640c314 [gemini-3.7-flash] #[PET] read PIA1_PA E810 C0
2640c314 [gemini-3.7-flash] #[PET] write PIA1_CRB E813 35
2640c315 [gemini-3.7-flash] #...
2640c315 [gemini-3.7-flash] #[PET] read PIA1_PA E810 C1      <-- Kernal increments row via INC $E810!
2640c315 [gemini-3.7-flash] #[PET] read PIA1_PB E812 FF
2640c315 [gemini-3.7-flash] #...
2640c315 [gemini-3.7-flash] #[PET] read PIA1_PA E810 C2      <-- INC $E810
2640c316 [gemini-3.7-flash] #[PET] read PIA1_PB E812 FF
2640c316 [gemini-3.7-flash] #...
2640c316 [gemini-3.7-flash] #[PET] read PIA1_PA E810 C9      <-- INC $E810 up to Row 9
2640c316 [gemini-3.7-flash] #
2640c317 [gemini-3.7-flash] #
2640c317 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2640c317 [gemini-3.7-flash] #
2640c317 [gemini-3.7-flash] #The Problem: How `INC $E810` Works on 6502
2640c318 [gemini-3.7-flash] #
2640c318 [gemini-3.7-flash] #The Commodore PET Kernal scans the keyboard rows using the `INC $E810` instruction inside a loop.
2640c318 [gemini-3.7-flash] #
2640c319 [gemini-3.7-flash] #1. A Read-Modify-Write cycle on the 6502:
2640c319 [gemini-3.7-flash] #   * Reads `$E810` via `readPET()` / `readAddressBus()`.
2640c319 [gemini-3.7-flash] #   * Increments the value internally in the ALU.
2640c319 [gemini-3.7-flash] #   * Writes the result back via `writePET()` / `writeAddress()`.
2640c31a [gemini-3.7-flash] #
2640c31a [gemini-3.7-flash] #2. What your `readPET(0xE810)` was doing:
2640c31a [gemini-3.7-flash] #
2640c31a [gemini-3.7-flash] #   case 0xe810: // PIA1_PA
2640c31b [gemini-3.7-flash] #       ...
2640c31b [gemini-3.7-flash] #       mem[0xE811] &= 0x3f;
2640c31b [gemini-3.7-flash] #       value |= 0xc0;
2640c31b [gemini-3.7-flash] #       break;
2640c31c [gemini-3.7-flash] #
2640c31c [gemini-3.7-flash] #   Because `readPET()` returns `value | 0xC0`, the Kernal reads `C0`, `C1`, `C2`, ..., `C9`.
2640c31c [gemini-3.7-flash] #
2640c31c [gemini-3.7-flash] #3. What your `writeAddress()` was doing:
2640c31d [gemini-3.7-flash] #   Inside `writeAddress()`:
2640c31d [gemini-3.7-flash] #
2640c31d [gemini-3.7-flash] #   if(isPET){
2640c31d [gemini-3.7-flash] #       if(block==0xe800){
2640c31d [gemini-3.7-flash] #           this.writePET(address,value);
2640c31d [gemini-3.7-flash] #           return;  // <--- RETURNING EARLY WITHOUT UPDATING mem[0xE810]!
2640c31d [gemini-3.7-flash] #       }
2640c31d [gemini-3.7-flash] #   }
2640c31e [gemini-3.7-flash] #   this.memory[address]=value;
2640c31e [gemini-3.7-flash] #
2640c31e [gemini-3.7-flash] #
2640c31e [gemini-3.7-flash] #Because `writeAddress` returned early without storing `value` into `this.memory[0xE810]`:
2640c31e [gemini-3.7-flash] #• When `writePET(0xE810, 0xC0)` ran initially, `mem[0xE810]` stayed `$00` (or old data).
2640c31f [gemini-3.7-flash] #• When `INC $E810` executed:
2640c31f [gemini-3.7-flash] #  1. `readPET(0xE810)` read `mem[0xE810]` (`00`), ORed `C0` → returned `$C0`.
2640c31f [gemini-3.7-flash] #  2. `INC` computed `C0 + 1 = C1`.
2640c31f [gemini-3.7-flash] #  3. `writeAddress()` called `writePET(0xE810, C1)`, but did not store `C1` into
2640c31f [gemini-3.7-flash] #`mem[0xE810]`.
2640c320 [gemini-3.7-flash] #  4. On the next iteration, `readPET(0xE810)` read `mem[0xE810]` again — which was still `$00`!
2640c320 [gemini-3.7-flash] #  5. The ROM loop was stuck scanning the same row repeatedly because `mem[0xE810]` was never
2640c320 [gemini-3.7-flash] #updated in memory.
2640c321 [gemini-3.7-flash] #
2640c321 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2640c321 [gemini-3.7-flash] #
2640c321 [gemini-3.7-flash] #The Fix
2640c322 [gemini-3.7-flash] #
2640c322 [gemini-3.7-flash] #Make sure `mem[address] = value;` is updated in `writePET()` so that subsequent reads of `E810`
2640c322 [gemini-3.7-flash] #during `INC E810` see the incremented row count:
2640c322 [gemini-3.7-flash] #
2640c322 [gemini-3.7-flash] #
2640c323 [gemini-3.7-flash] #writePET(address: number, value: number) {
2640c323 [gemini-3.7-flash] #	const mem = this.memory;
2640c323 [gemini-3.7-flash] #	const label = this.addresLabel(address);
2640c323 [gemini-3.7-flash] #	traceLog("[PET] write", label, hex(address), hex(value));
2640c324 [gemini-3.7-flash] #
2640c324 [gemini-3.7-flash] #	switch (address) {
2640c324 [gemini-3.7-flash] #		case 0xE810: {
2640c325 [gemini-3.7-flash] #			const cra = mem[0xE811];
2640c325 [gemini-3.7-flash] #			if ((cra & 4) === 0) {
2640c325 [gemini-3.7-flash] #				this.ddra = value;
2640c325 [gemini-3.7-flash] #				return;
2640c326 [gemini-3.7-flash] #			}
2640c326 [gemini-3.7-flash] #			scanKeyboard(value & 0x0F);
2640c326 [gemini-3.7-flash] #			traceLog("[PET] scanning column", value & 0x0F);
2640c326 [gemini-3.7-flash] #			break;
2640c327 [gemini-3.7-flash] #		}
2640c327 [gemini-3.7-flash] #		case 0xE811:
2640c327 [gemini-3.7-flash] #			value = (mem[0xE811] & 0xC0) | (value & 0x3F);
2640c327 [gemini-3.7-flash] #			break;
2640c328 [gemini-3.7-flash] #		case 0xE812: {
2640c328 [gemini-3.7-flash] #			const crb = mem[0xE813];
2640c328 [gemini-3.7-flash] #			if ((crb & 4) === 0) {
2640c329 [gemini-3.7-flash] #				this.ddrb = value;
2640c329 [gemini-3.7-flash] #				return;
2640c329 [gemini-3.7-flash] #			}
2640c329 [gemini-3.7-flash] #			break;
2640c32a [gemini-3.7-flash] #		}
2640c32a [gemini-3.7-flash] #		case 0xE813:
2640c32a [gemini-3.7-flash] #			value = (mem[0xE813] & 0xC0) | (value & 0x3F);
2640c32a [gemini-3.7-flash] #			break;
2640c32a [gemini-3.7-flash] #	}
2640c32b [gemini-3.7-flash] #
2640c32b [gemini-3.7-flash] #	mem[address] = value;
2640c32b [gemini-3.7-flash] #}
2640c32b [gemini-3.7-flash] #
2640c32c [gemini-3.7-flash] #
2640c32c [gemini-3.7-flash] #And in `readPET()`:
2640c32c [gemini-3.7-flash] #
2640c32c [gemini-3.7-flash] #
2640c32d [gemini-3.7-flash] #readPET(address: number) {
2640c32d [gemini-3.7-flash] #	const label = this.addresLabel(address);
2640c32d [gemini-3.7-flash] #	const mem = this.memory;
2640c32d [gemini-3.7-flash] #	const cycle = this.cycleCount;
2640c32e [gemini-3.7-flash] #	let value = mem[address];
2640c32e [gemini-3.7-flash] #
2640c32e [gemini-3.7-flash] #	switch (address) {
2640c32e [gemini-3.7-flash] #		case 0xE810: {
2640c32f [gemini-3.7-flash] #			const cra = mem[0xE811];
2640c32f [gemini-3.7-flash] #			if ((cra & 0x04) === 0) {
2640c32f [gemini-3.7-flash] #				traceLog("[PET] read ddra", hex(this.ddra));
2640c32f [gemini-3.7-flash] #				return this.ddra;
2640c330 [gemini-3.7-flash] #			}
2640c330 [gemini-3.7-flash] #			mem[0xE811] &= 0x3F;
2640c330 [gemini-3.7-flash] #			// Return current latched row with cassette/IEEE pullups on bits 6-7
2640c330 [gemini-3.7-flash] #			value = (mem[0xE810] & 0x0F) | 0xC0;
2640c331 [gemini-3.7-flash] #			break;
2640c331 [gemini-3.7-flash] #		}
2640c331 [gemini-3.7-flash] #		case 0xE812: {
2640c332 [gemini-3.7-flash] #			const crb = mem[0xE813];
2640c332 [gemini-3.7-flash] #			if ((crb & 0x04) === 0) {
2640c332 [gemini-3.7-flash] #				traceLog("[PET] read ddrb", hex(this.ddrb));
2640c332 [gemini-3.7-flash] #				return this.ddrb;
2640c333 [gemini-3.7-flash] #			}
2640c333 [gemini-3.7-flash] #			mem[0xE813] &= 0x3F;
2640c333 [gemini-3.7-flash] #			value = readPetMatrix();
2640c333 [gemini-3.7-flash] #			break;
2640c333 [gemini-3.7-flash] #		}
2640c333 [gemini-3.7-flash] #		case 0xE840: // VIA Port B video blanking
2640c333 [gemini-3.7-flash] #			value &= ~0x20;
2640c333 [gemini-3.7-flash] #			if (vidBlanking(cycle)) value |= 0x20;
2640c334 [gemini-3.7-flash] #			break;
2640c334 [gemini-3.7-flash] #	}
2640c334 [gemini-3.7-flash] #
2640c334 [gemini-3.7-flash] #	traceLog("[PET] read", label, hex(address), hex(value));
2640c335 [gemini-3.7-flash] #	return value;
2640c335 [gemini-3.7-flash] #}
2640c335 [gemini-3.7-flash] #
2640c335 [gemini-3.7-flash] #
