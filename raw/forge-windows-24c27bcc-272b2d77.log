26d306d3 [deepseek-v4-flash-vision] #🟠nitrologic Relay 2.0.1 deepseek-v4-flash-vision 🐋 🪠 0.7° $0.017 118.6KB 13.93s
26d306d3 [deepseek-v4-flash-vision] #There’s no standard query that tells you directly whether a terminal supports mode 2027.
26d306d3 [deepseek-v4-flash-vision] #The escape sequence itself is a DEC private mode, and terminals are free to ignore it. However, you
26d306d3 [deepseek-v4-flash-vision] #can infer support using cursor position reporting (CPR).
26d306d4 [deepseek-v4-flash-vision] #
26d306d4 [deepseek-v4-flash-vision] #How cursor position reporting works
26d306d4 [deepseek-v4-flash-vision] #
26d306d4 [deepseek-v4-flash-vision] #The terminal supports a DSR (Device Status Report) request:
26d306d5 [deepseek-v4-flash-vision] #
26d306d5 [deepseek-v4-flash-vision] #
26d306d5 [deepseek-v4-flash-vision] #ESC [ 6 n
26d306d5 [deepseek-v4-flash-vision] #
26d306d6 [deepseek-v4-flash-vision] #
26d306d6 [deepseek-v4-flash-vision] #When it receives this, the terminal responds with a CPR (Cursor Position Report) of the form:
26d306d6 [deepseek-v4-flash-vision] #
26d306d6 [deepseek-v4-flash-vision] #
26d306d7 [deepseek-v4-flash-vision] #ESC [ row ; column R
26d306d7 [deepseek-v4-flash-vision] #
26d306d7 [deepseek-v4-flash-vision] #
26d306d8 [deepseek-v4-flash-vision] #So if you send `\x1b[6n` and then read the response from stdin, you get the current cursor row and
26d306d8 [deepseek-v4-flash-vision] #column (1‑based). This is how many terminal UIs detect window size or verify terminal capabilities.
26d306d8 [deepseek-v4-flash-vision] #
26d306d8 [deepseek-v4-flash-vision] #Using CPR to test mode 2027 (theory)
26d306d9 [deepseek-v4-flash-vision] #
26d306d9 [deepseek-v4-flash-vision] #The idea is:
26d306d9 [deepseek-v4-flash-vision] #
26d306d9 [deepseek-v4-flash-vision] #1. Move cursor to a known column (use absolute positioning: `ESC [ row ; col H`).
26d306da [deepseek-v4-flash-vision] #2. Send a test grapheme cluster (e.g., `👨‍👩‍👧‍👦`).
26d306da [deepseek-v4-flash-vision] #3. Send `ESC [6n`.
26d306da [deepseek-v4-flash-vision] #4. Read the response and see how many columns the cursor advanced.
26d306db [deepseek-v4-flash-vision] #
26d306db [deepseek-v4-flash-vision] #- If the terminal supports mode 2027 and renders the cluster as one wide glyph, the
26d306db [deepseek-v4-flash-vision] #cursor advances by 2 columns.
26d306db [deepseek-v4-flash-vision] #- If the terminal ignores mode 2027 and renders it as multiple separate emoji, the
26d306dc [deepseek-v4-flash-vision] #cursor advances by more than 2 (e.g., 8).
26d306dc [deepseek-v4-flash-vision] #- If the terminal treats it as zero‑width or collapses it somehow, the result is unpredictable.
26d306dc [deepseek-v4-flash-vision] #
26d306dc [deepseek-v4-flash-vision] #This test is fragile because:
26d306dd [deepseek-v4-flash-vision] #
26d306dd [deepseek-v4-flash-vision] #- You need to read the async CPR response from stdin within a timeout.
26d306dd [deepseek-v4-flash-vision] #- The terminal may wrap the cursor at the right edge, so you must place the cursor far enough left.
26d306dd [deepseek-v4-flash-vision] #- Some terminals don’t support CPR at all (rare, but possible).
26d306de [deepseek-v4-flash-vision] #- The grapheme rendering can also depend on the font — even with mode 2027, a terminal could render
26d306de [deepseek-v4-flash-vision] #a ZWJ sequence as multiple glyphs if the font/locale says so.
26d306de [deepseek-v4-flash-vision] #
26d306de [deepseek-v4-flash-vision] #Is it worth doing?
26d306df [deepseek-v4-flash-vision] #
26d306df [deepseek-v4-flash-vision] #For a desktop manager prototype, probably not. It adds complexity, race conditions, and
26d306df [deepseek-v4-flash-vision] #edge cases. Mode 2027 is harmless if ignored, so the pragmatic path is:
26d306e0 [deepseek-v4-flash-vision] #
26d306e0 [deepseek-v4-flash-vision] #- Always send `ESC[?2027h` at boot.
26d306e0 [deepseek-v4-flash-vision] #- Always send `ESC[?2027l` at shutdown.
26d306e0 [deepseek-v4-flash-vision] #- Use `Intl.Segmenter` to split graphemes and estimate width with your heuristic.
26d306e1 [deepseek-v4-flash-vision] #- Accept that on some terminals the width might be wrong, and adjust if needed (e.g., add a config
26d306e1 [deepseek-v4-flash-vision] #flag: `EMOJI_SEQUENCE_WIDTH = 2` vs. `8`).
26d306e1 [deepseek-v4-flash-vision] #
26d306e1 [deepseek-v4-flash-vision] #If you later find a terminal that misbehaves, you can implement a one‑time detection routine that
26d306e2 [deepseek-v4-flash-vision] #runs at startup and adjusts the width constant accordingly. That would be a nice touch, but it’s
26d306e2 [deepseek-v4-flash-vision] #not necessary to get started.
26d306e2 [deepseek-v4-flash-vision] #
26d306e3 [deepseek-v4-flash-vision] #A minimal detection sketch (if you want it later)
26d306e3 [deepseek-v4-flash-vision] #
26d306e3 [deepseek-v4-flash-vision] #
26d306e3 [deepseek-v4-flash-vision] #async function detectGraphemeSupport(): Promise<number> {
26d306e4 [deepseek-v4-flash-vision] #	// Move to column 1, row 1
26d306e4 [deepseek-v4-flash-vision] #	Deno.stdout.writeSync(encoder.encode("\x1b[1;1H"));
26d306e4 [deepseek-v4-flash-vision] #	// Clear line just in case
26d306e4 [deepseek-v4-flash-vision] #	Deno.stdout.writeSync(encoder.encode("\x1b[2K"));
26d306e5 [deepseek-v4-flash-vision] #	// Send test cluster
26d306e5 [deepseek-v4-flash-vision] #	Deno.stdout.writeSync(encoder.encode("👨‍👩‍👧‍👦"));
26d306e5 [deepseek-v4-flash-vision] #	// Query cursor
26d306e5 [deepseek-v4-flash-vision] #	Deno.stdout.writeSync(encoder.encode("\x1b[6n"));
26d306e6 [deepseek-v4-flash-vision] #
26d306e6 [deepseek-v4-flash-vision] #	// Read response from stdin with timeout
26d306e6 [deepseek-v4-flash-vision] #	const response = await readWithTimeout(100);
26d306e6 [deepseek-v4-flash-vision] #	const match = response.match(/\x1b\[(\d+);(\d+)R/);
26d306e7 [deepseek-v4-flash-vision] #	if (!match) return 2; // default assumption
26d306e7 [deepseek-v4-flash-vision] #	const col = parseInt(match[2], 10);
26d306e7 [deepseek-v4-flash-vision] #	return col; // 1‑based column after the cluster, so width = col - 1
26d306e7 [deepseek-v4-flash-vision] #}
26d306e8 [deepseek-v4-flash-vision] #
26d306e8 [deepseek-v4-flash-vision] #
26d306e8 [deepseek-v4-flash-vision] #But again, that’s a project for later.
26d306e8 [deepseek-v4-flash-vision] #
26d306e9 [deepseek-v4-flash-vision] #• Bottom line:* Enable mode 2027, keep your width calculations, and don’t over‑engineer
26d306e9 [deepseek-v4-flash-vision] #detection right now. The terminal landscape is messy, and modern terminals (Windows Terminal,
26d306e9 [deepseek-v4-flash-vision] #iTerm2, kitty, etc.) generally do the right thing when you send the mode.
26d306e9 [deepseek-v4-flash-vision] #
