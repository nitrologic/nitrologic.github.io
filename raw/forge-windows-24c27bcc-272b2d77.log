24c55d85 [deepseek-v4-flash] #🟠nitrologic Relay 2.0.1 deepseek-v4-flash 🐋 🪠 0.7° $0.004 54.09KB 38.66s
24c55d85 [deepseek-v4-flash] #The decode logic is close, but there are a few issues that will prevent you from building a usable
24c55d85 [deepseek-v4-flash] #disk image.
24c55d85 [deepseek-v4-flash] #
24c55d86 [deepseek-v4-flash] #1. Address field offsets are wrong
24c55d86 [deepseek-v4-flash] #
24c55d86 [deepseek-v4-flash] #In a standard DOS 3.3 address field:
24c55d86 [deepseek-v4-flash] #
24c55d87 [deepseek-v4-flash] #
24c55d87 [deepseek-v4-flash] #D5 AA 96
24c55d87 [deepseek-v4-flash] #volume odd/even    (i+3, i+4)
24c55d87 [deepseek-v4-flash] #track odd/even     (i+5, i+6)
24c55d88 [deepseek-v4-flash] #sector odd/even    (i+7, i+8)
24c55d88 [deepseek-v4-flash] #checksum odd/even  (i+9, i+10)
24c55d88 [deepseek-v4-flash] #DE AA EB
24c55d88 [deepseek-v4-flash] #
24c55d89 [deepseek-v4-flash] #
24c55d89 [deepseek-v4-flash] #Your current code reads:
24c55d89 [deepseek-v4-flash] #
24c55d89 [deepseek-v4-flash] #
24c55d89 [deepseek-v4-flash] #track  = decodeAddressByte(bytes[(i+3)%n], bytes[(i+4)%n]);
24c55d8a [deepseek-v4-flash] #sector = decodeAddressByte(bytes[(i+5)%n], bytes[(i+6)%n]);
24c55d8a [deepseek-v4-flash] #crc    = decodeAddressByte(bytes[(i+7)%n], bytes[(i+8)%n]);
24c55d8a [deepseek-v4-flash] #
24c55d8a [deepseek-v4-flash] #
24c55d8b [deepseek-v4-flash] #That makes `track` = volume (usually $FE), `sector` = actual track, and `crc` = actual sector. Fix
24c55d8b [deepseek-v4-flash] #it:
24c55d8b [deepseek-v4-flash] #
24c55d8b [deepseek-v4-flash] #
24c55d8c [deepseek-v4-flash] #track  = decodeAddressByte(bytes[(i+5)%n], bytes[(i+6)%n]);
24c55d8c [deepseek-v4-flash] #sector = decodeAddressByte(bytes[(i+7)%n], bytes[(i+8)%n]);
24c55d8c [deepseek-v4-flash] #crc    = decodeAddressByte(bytes[(i+9)%n], bytes[(i+10)%n]);
24c55d8c [deepseek-v4-flash] #
24c55d8d [deepseek-v4-flash] #
24c55d8d [deepseek-v4-flash] #You can optionally verify the checksum: it should equal `volume ^ track ^ sector`.
24c55d8d [deepseek-v4-flash] #
24c55d8d [deepseek-v4-flash] #2. Sector count is now 32, not 16
24c55d8e [deepseek-v4-flash] #
24c55d8e [deepseek-v4-flash] #You push `i` for address prologues and `-i` for data prologues, so `sectors.length` counts both. If
24c55d8e [deepseek-v4-flash] #you want to verify 16 sectors per track, either count only positive entries:
24c55d8e [deepseek-v4-flash] #
24c55d8f [deepseek-v4-flash] #
24c55d8f [deepseek-v4-flash] #const addressCount = sectors.filter(v => v >= 0).length;
24c55d8f [deepseek-v4-flash] #console.log({ n: track.bytes.length, count: addressCount });
24c55d8f [deepseek-v4-flash] #
24c55d90 [deepseek-v4-flash] #
24c55d90 [deepseek-v4-flash] #or return a structured object.
24c55d90 [deepseek-v4-flash] #
24c55d90 [deepseek-v4-flash] #3. Decoded blocks are discarded
24c55d91 [deepseek-v4-flash] #
24c55d91 [deepseek-v4-flash] #`blocks` is local to `detectSectors` and never returned or associated with the track/sector. To
24c55d91 [deepseek-v4-flash] #build a disk in memory, you need to match each address prologue to the following data
24c55d91 [deepseek-v4-flash] #prologue, then store the decoded 256 bytes in a `disk[track][sector]` array.
24c55d92 [deepseek-v4-flash] #
24c55d92 [deepseek-v4-flash] #Here’s a more complete approach:
24c55d92 [deepseek-v4-flash] #
24c55d92 [deepseek-v4-flash] #
24c55d93 [deepseek-v4-flash] #interface DecodedSector {
24c55d93 [deepseek-v4-flash] #	track: number;
24c55d93 [deepseek-v4-flash] #	sector: number;
24c55d93 [deepseek-v4-flash] #	offset: number;
24c55d94 [deepseek-v4-flash] #	bytes: Uint8Array;
24c55d94 [deepseek-v4-flash] #}
24c55d94 [deepseek-v4-flash] #
24c55d94 [deepseek-v4-flash] #function decodeTrack(rawTrack: Uint8Array): DecodedSector[] {
24c55d95 [deepseek-v4-flash] #	const n = rawTrack.length;
24c55d95 [deepseek-v4-flash] #	const result: DecodedSector[] = [];
24c55d95 [deepseek-v4-flash] #
24c55d95 [deepseek-v4-flash] #	for (let i = 0; i < n; i++) {
24c55d96 [deepseek-v4-flash] #		// Address prologue
24c55d96 [deepseek-v4-flash] #		if (rawTrack[i] === 0xD5 && rawTrack[(i+1)%n] === 0xAA && rawTrack[(i+2)%n] === 0x96) {
24c55d96 [deepseek-v4-flash] #			const track = decodeAddressByte(rawTrack[(i+5)%n], rawTrack[(i+6)%n]);
24c55d96 [deepseek-v4-flash] #			const sector = decodeAddressByte(rawTrack[(i+7)%n], rawTrack[(i+8)%n]);
24c55d97 [deepseek-v4-flash] #
24c55d97 [deepseek-v4-flash] #			// Search for the data prologue after this address field
24c55d97 [deepseek-v4-flash] #			for (let j = i + 9; j < i + 600; j++) {
24c55d97 [deepseek-v4-flash] #				const k = j % n;
24c55d98 [deepseek-v4-flash] #				if (rawTrack[k] === 0xD5 && rawTrack[(k+1)%n] === 0xAA && rawTrack[(k+2)%n] === 0xAD) {
24c55d98 [deepseek-v4-flash] #					const dataStart = (k + 3) % n;
24c55d98 [deepseek-v4-flash] #
24c55d98 [deepseek-v4-flash] #					// Read 342 nibbles with wraparound
24c55d99 [deepseek-v4-flash] #					const nibbles = new Uint8Array(342);
24c55d99 [deepseek-v4-flash] #					for (let p = 0; p < 342; p++) {
24c55d99 [deepseek-v4-flash] #						nibbles[p] = rawTrack[(dataStart + p) % n];
24c55d99 [deepseek-v4-flash] #					}
24c55d9a [deepseek-v4-flash] #
24c55d9a [deepseek-v4-flash] #					const bytes = decodeDos33Sector(nibbles);
24c55d9a [deepseek-v4-flash] #					if (bytes) {
24c55d9a [deepseek-v4-flash] #						result.push({ track, sector, offset: k, bytes });
24c55d9b [deepseek-v4-flash] #					}
24c55d9b [deepseek-v4-flash] #					break;
24c55d9b [deepseek-v4-flash] #				}
24c55d9b [deepseek-v4-flash] #			}
24c55d9c [deepseek-v4-flash] #		}
24c55d9c [deepseek-v4-flash] #	}
24c55d9c [deepseek-v4-flash] #	return result;
24c55d9c [deepseek-v4-flash] #}
24c55d9d [deepseek-v4-flash] #
24c55d9d [deepseek-v4-flash] #
24c55d9d [deepseek-v4-flash] #Then you can build a full disk:
24c55d9d [deepseek-v4-flash] #
24c55d9e [deepseek-v4-flash] #
24c55d9e [deepseek-v4-flash] #const disk: Uint8Array[][] = Array.from({ length: 35 }, () => new Array(16));
24c55d9e [deepseek-v4-flash] #
24c55d9e [deepseek-v4-flash] #for (let t = 0; t < tracks.length; t++) {
24c55d9f [deepseek-v4-flash] #	const decoded = decodeTrack(tracks[t].bytes);
24c55d9f [deepseek-v4-flash] #	for (const d of decoded) {
24c55d9f [deepseek-v4-flash] #		if (d.track >= 0 && d.track < 35 && d.sector >= 0 && d.sector < 16) {
24c55d9f [deepseek-v4-flash] #			disk[d.track][d.sector] = d.bytes;
24c55da0 [deepseek-v4-flash] #		}
24c55da0 [deepseek-v4-flash] #	}
24c55da0 [deepseek-v4-flash] #}
