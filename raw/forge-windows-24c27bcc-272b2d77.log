25b9fda9 [deepseek-v4-flash] #🟠nitrologic Relay 2.0.1 deepseek-v4-flash 🐋 🪠 0.7° $0.000 3.066KB 8.23s
25b9fda9 [deepseek-v4-flash] #Addressing Modes Used by Z80 Branch Instructions
25b9fda9 [deepseek-v4-flash] #
25b9fdaa [deepseek-v4-flash] #The Z80's "branch" instructions — jumps, calls, returns, and restart — use four of the ten
25b9fdaa [deepseek-v4-flash] #addressing modes, depending on the specific opcode:
25b9fdaa [deepseek-v4-flash] #
25b9fdaa [deepseek-v4-flash] #1. Relative (used by `JR` and `DJNZ`)
25b9fdaa [deepseek-v4-flash] #- The operand is an 8-bit signed displacement added to the PC after the instruction.
25b9fdab [deepseek-v4-flash] #- Only for short jumps within −128 to +127 bytes.
25b9fdab [deepseek-v4-flash] #
25b9fdab [deepseek-v4-flash] #JR  label
25b9fdac [deepseek-v4-flash] #JR  NZ, label
25b9fdac [deepseek-v4-flash] #DJNZ loop       ; decrement B, jump if non-zero
25b9fdac [deepseek-v4-flash] #
25b9fdac [deepseek-v4-flash] #
25b9fdad [deepseek-v4-flash] #2. Extended / Immediate Extended (used by `JP` and `CALL`)
25b9fdad [deepseek-v4-flash] #- A full 16-bit absolute address follows the opcode.
25b9fdad [deepseek-v4-flash] #- This is the "direct" addressing mode for long jumps and subroutine calls.
25b9fdad [deepseek-v4-flash] #
25b9fdae [deepseek-v4-flash] #JP  nnnn        ; unconditional absolute jump
25b9fdae [deepseek-v4-flash] #JP  C, nnnn     ; conditional absolute jump
25b9fdae [deepseek-v4-flash] #CALL nnnn       ; call subroutine at address nnnn
25b9fdaf [deepseek-v4-flash] #CALL NZ, nnnn   ; conditional call
25b9fdaf [deepseek-v4-flash] #
25b9fdaf [deepseek-v4-flash] #
25b9fdaf [deepseek-v4-flash] #3. Register Indirect (used by `JP (HL)`, `JP (IX)`, `JP (IY)`)
25b9fdb0 [deepseek-v4-flash] #- The 16-bit address is taken from a register pair or index register.
25b9fdb0 [deepseek-v4-flash] #- Note: the parentheses indicate indirection: jump to the address stored in
25b9fdb0 [deepseek-v4-flash] #HL/IX/IY.
25b9fdb0 [deepseek-v4-flash] #
25b9fdb1 [deepseek-v4-flash] #JP  (HL)
25b9fdb1 [deepseek-v4-flash] #JP  (IX)
25b9fdb1 [deepseek-v4-flash] #JP  (IY)
25b9fdb1 [deepseek-v4-flash] #
25b9fdb2 [deepseek-v4-flash] #
25b9fdb2 [deepseek-v4-flash] #4. Modified Page Zero (used by `RST`)
25b9fdb2 [deepseek-v4-flash] #- A special call to a fixed address in the first 256 bytes (00h, 08h, … 38h).
25b9fdb3 [deepseek-v4-flash] #- The opcode itself encodes the destination, so no explicit operand is needed.
25b9fdb3 [deepseek-v4-flash] #
25b9fdb3 [deepseek-v4-flash] #RST 10h         ; call address 0010h
25b9fdb3 [deepseek-v4-flash] #
25b9fdb4 [deepseek-v4-flash] #
25b9fdb4 [deepseek-v4-flash] #5. Implied (used by `RET`, `RETI`, `RETN`)
25b9fdb4 [deepseek-v4-flash] #- No explicit operand; the return address is taken from the stack implicitly (SP).
25b9fdb4 [deepseek-v4-flash] #
25b9fdb5 [deepseek-v4-flash] #RET             ; return from subroutine
25b9fdb5 [deepseek-v4-flash] #RET NZ          ; conditional return
25b9fdb5 [deepseek-v4-flash] #RETI            ; return from interrupt
25b9fdb5 [deepseek-v4-flash] #RETN            ; return from non-maskable interrupt
25b9fdb5 [deepseek-v4-flash] #
25b9fdb6 [deepseek-v4-flash] #
25b9fdb6 [deepseek-v4-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
25b9fdb6 [deepseek-v4-flash] #
25b9fdb6 [deepseek-v4-flash] #• Summary table:*
25b9fdb7 [deepseek-v4-flash] #
25b9fdb7 [deepseek-v4-flash] #╭─────────────────────┬─────────────────────────────────╮
25b9fdb7 [deepseek-v4-flash] #│  Instruction group  │  Addressing mode(s)             │
25b9fdb8 [deepseek-v4-flash] #├─────────────────────┼─────────────────────────────────┤
25b9fdb8 [deepseek-v4-flash] #│  `JR`, `DJNZ`       │  Relative                       │
25b9fdb8 [deepseek-v4-flash] #│  `JP nn`, `CALL nn` │  Extended (immediate extended)  │
25b9fdb8 [deepseek-v4-flash] #│  `JP (HL/IX/IY)`    │  Register indirect              │
25b9fdb9 [deepseek-v4-flash] #│  `RST`              │  Modified page zero             │
25b9fdb9 [deepseek-v4-flash] #│  `RET` family       │  Implied (stack)                │
25b9fdba [deepseek-v4-flash] #╰─────────────────────┴─────────────────────────────────╯
25b9fdba [deepseek-v4-flash] #
25b9fdba [deepseek-v4-flash] #So if by "branched" you mean branching/control-flow instructions, they collectively use
25b9fdba [deepseek-v4-flash] #relative, extended, register indirect, modified page zero, and implied addressing modes.
25b9fdba [deepseek-v4-flash] #
