in entry point of machine.ts\r\n\r\nawait runTerminal(true);\r\n//runInput(true);\r\n\r\nconst trace=[];\r\n\r\nfunction dumpTrace2(){\r\n\tlet count=150;\r\n\twhile(trace.length&&(count--)){\r\n\t\tconst line=trace.pop();\r\n\t\tconsole.log(line);\r\n\t}\r\n}\r\n\r\nfunction dumpTrace(){\r\n\tfor(let i=0;i<trace.length;i++){\r\n\t\tconst line=trace[i];\r\n\t\tconsole.log(line);\r\n\t}\r\n}\r\n\r\nfunction runMachine(){\r\n\tstepping=true;\r\n//\twriteConsole(cursorHide+cursorClear+machineTitle+\"*\");\r\n\tif(!is1541){\r\n\t\twriteConsole(cursorHide+machineTitle+\"*\");\t//cursorHome+\r\n\t}\r\n}\r\n\r\nfunction haltMachine(){\r\n\tstepping=false;\r\n\tif(!is1541){\r\n\t\tconsole.log(cursorShow);\r\n\t}\r\n}\r\n\r\nfunction resetMachine(){\r\n\tgame.interrupt(Request.Reset,\"Cold Reset\")\r\n//\tgame.interrupt(Request.NMI,\"Warm Reset\")\r\n}\r\n\r\nfunction pasteMachine(paste:string){\r\n\tconst text=paste.toUpperCase();\r\n\tconst n=text.length;\r\n\tfor(let i=0;i<n;i++){\r\n\t\tconst keyCode=text.charCodeAt(i);\r\n\t\tgame.pushKey(keyCode);\r\n\t}\r\n}\r\n\r\nif(isApple){\r\n//\tawait readCassetteFile(\"apple/lemonade.zip\", game.tape);\r\n//\tawait readCassetteFile(\"apple/littlebrickout.zip\", game.tape);\r\n//\tawait readCassetteWav(\"test.wav\", game.tape);\r\n//\tawait readCassetteWav(\"littlebrickout.wav\", game.tape);\r\n//\tgame.burn(appleSabotage.binary);//call 7424\r\n//\tgame.burn(applePennyArcade.binary);\r\n//\tgame.writeAddress(175,32);\r\n//\tgame.writeAddress(176,19);\r\n//\tgame.burn(appleElite.binary);\r\n\tif(stepping)runMachine();\r\n}\r\n\r\n// 3000 lines later we end machine class\r\n\r\nconst game:Machine=new Machine();\r\ngame.burn(machineSpec.binary);\r\nconsole.log(machineSpec.title,machineSpec.version,machineSpec.copyright);\r\n\r\nconst system=machineSpec.system;\r\nif(system){\r\n\tconsole.log(system.title,system.copyright);\r\n}\r\n\r\nfunction onInput(bytes:Uint8Array){\r\n\tconst n=bytes.length;\r\n\tif(n==0) return;\r\n\tlet i=0;\r\n\tif(stepping){\r\n//\t\tif(n==2) stepping=false;\r\n\t\twhile(i<n){\r\n\t\t\tconst key=bytes[i++];\r\n\t\t\tswitch(key){\r\n\t\t\t\tcase 27:\r\n\t\t\t\t\tif(i==n){\r\n\t\t\t\t\t\tgame.pushKey(27);\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tlet o=bytes.indexOf(126,i);\r\n\t\t\t\t\t\tif(o==-1){\r\n\t\t\t\t\t\t\to=bytes.indexOf(77,i);\r\n\t\t\t\t\t\t\tif(o==-1){\r\n\t\t\t\t\t\t\t\to=bytes.indexOf(109,i);\r\n\t\t\t\t\t\t\t\tif(o==-1){\r\n\t\t\t\t\t\t\t\t\t// todo: 3 byte cursor keys like 29,91,66 pass here\r\n//\t\t\t\t\t\t\t\t\tconsole.log(\"terminator 126 nor 77 nor 109 found n:\",bytes.length,\"bytes:\",bytes);\r\n//\t\t\t\t\t\t\t\t\tconsole.log(\"[TERMERR]\",bytes);\r\n\t\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tswitch(bytes.subarray(i-1,o+1).join(\",\")){\r\n\t\t\t\t\t\t\tcase \"27,91,50,52,126\":\r\n\t\t\t\t\t\t\t\tconst pos=cursorPos(3,28);\r\n\t\t\t\t\t\t\t\tconsole.log(pos+\"F12 detected halting machine\");\r\n\t\t\t\t\t\t\t\thaltMachine();\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase \"27,91,50,52,59,53,126\":\r\n\t\t\t\t\t\t\t\tconsole.log(\"F12 detected resetting machine\");\r\n\t\t\t\t\t\t\t\tresetMachine();\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase \"27,91,50,49,126\":\r\n\t\t\t\t\t\t\t\tconsole.log(cursorClear);\r\n\t\t\t\t\t\t\t\tconsole.log(\"F10 detected clearing screen\");\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\ti=o+1;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 127:\r\n\t\t\t\t\tgame.pushKey(8);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 10:\r\n\t\t\t\t\tconsole.log(\"CHR 10 detected\");\r\n\t\t\t\t\thaltMachine();\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tgame.pushKey(key);\r\n\t\t\t}\r\n\t\t}\r\n\t}else{\r\n\t\tconst key=bytes[0];\r\n\t\tswitch(key){\r\n\t\t\tcase 27: //ESC\r\n\t\t\t\tif(n==1) {\r\n\t\t\t\t\tconsole.log(\"plain escape\");\r\n\t\t\t\t\trunning=false;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tswitch(bytes.join(\",\")){\r\n\t\t\t\t\t\tcase \"27,91,50,52,126\":\r\n\t\t\t\t\t\t\trunMachine();\r\n\t\t\t\t\t\t\tconsole.log(\"F12 detected running machine\");\r\n\t\t\t\t\t\t\tgame.dirty=true;\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 100: //D\r\n\t\t\tcase 68: //d\r\n\t\t\t\tif(isApple) game.dumpMemory(0x400,30,32);\r\n\t\t\t\tif(isC64) {\r\n\t\t\t\t\tgame.dumpMemory(0xd800,40,24);\r\n//\t\t\t\t\tdisplayC64(game.memory,0,0);\r\n\t\t\t\t\t//6,2,0xc00,0x800,40,24);\t\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t\tif(isTed){\r\n\t\t\t\t\tdisplayPlus4(game.memory,0,0);\r\n//\t\t\t\t\tgame.dumpMemory(0xc00,40,24);\r\n\t\t\t\t}\r\n\t\t\t\tif(isVIC) {\r\n//\t\t\t\t\tgame.dumpMemory(0x1e00,23,22);\r\n//\t\t\t\t\tgame.dumpMemory(0x1000,23,22);\r\n\t\t\t\t\tgame.dumpMemory(0x9400,23,22);\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 82: // R\r\n\t\t\t\tgame.softReset(0xe000);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 49: // 1\r\n\t\t\t\tgame.burn(appleSabotage.binary);//call 7424\r\n\t\t\t\tconsole.log(\"1 loaded sabotage, call 7424 to run\");\r\n//\t\t\t\trunMachine();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 114: //r\r\n//\t\t\t\trunMachine();\r\n//\t\t\t\tif(stepping) haltMachine(); else runMachine();\r\n//\t\t\t\tstepping=!stepping;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 115: //S\r\n\t\t\t\tstep=true;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 116: //T\r\n\t\t\t\tdumpTrace();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 67: //C\r\n\t\t\t\tgame.tape.clear();\r\n\t\t\t\tconsole.log(\"[TAPE] rewound\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase 99: //c\r\n\t\t\t\tgame.tape.diagnostics();\r\n\t\t\t\tgame.saveFile=true;\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tconsole.log(\"bytes:\",bytes.length,\"key:\",key);\r\n\t\t}\r\n\t}\r\n}\r\n\r\nlet appWidth=0;\r\nlet appHeight=0;\r\n\r\nfunction pollSize(){\r\n\tconst { columns, rows } = Deno.consoleSize();\r\n\tconst vidWidth=columns-6;\r\n\tconst vidHeight=rows-6;\r\n\tif(vidWidth!=appWidth||vidHeight!=appHeight){\r\n\t\tappWidth=vidWidth;\r\n\t\tappHeight=vidHeight;\r\n//\t\tconsole.log(cursorClear+machineTitle,[appWidth,appHeight]);\r\n\t}\r\n}\r\n\r\nasync function processInput(){\r\n\tconst keypad=await pollKeypad()\r\n\r\n\tconst oldBits=hitBits;\r\n\tconst bits=keypad.hitBits;\r\n//\tif((keys&16)&&!(oldBits&16)) hitSpace();\r\n//\tif((keys&32)&&!(oldBits&32)) hitBackspace();\r\n//\tif((bits&64)&&!(oldBits&64)) stopRunning();\r\n\tif(bits&~oldBits) hitCount++;\r\n\thitBits=bits;\r\n\tmouseX=keypad.mousePosition[0];\r\n\tmouseY=keypad.mousePosition[1];\r\n\taxisY=keypad.axisPump[0];\r\n\taxisX=keypad.axisPump[1];\r\n\tconst input=keypad.inputQueue;\r\n//\tconst input=await pollTerminal()\r\n\tif(input===null){\r\n\t\tconsole.log(\"null input\");\r\n\t\trunning=false;\r\n\t\treturn;\r\n\t}\r\n\tfor (const bytes of input) {\r\n\t\tonInput(bytes);\r\n\t}\r\n}\r\n\r\nconst loc=gameRom.location||gameRom.address;\r\nconst entry=parseInt(loc.Entry||loc.Reset,16);\r\nconst nmi=parseInt(loc.NMI,16);\r\nconst irq=parseInt(loc.IRQ,16);\r\nconst reset=parseInt(loc.Reset,16);\r\nconst vectors=gameRom.platform?.display?.type===\"calligraphic\";\r\ngame.setLabels(gameRom.labels);\r\n//console.log(\"reset\",{entry,nmi,reset,irq},loc)\r\ngame.reset(entry,irq,nmi,reset,vectors);\r\n\r\n//console.log(cusorPasteOn);\r\n// console.log(\"running...\",game.running);\r\n\r\nwhile(isRunning() && running && game.running){//&&game.cyclecount<0xa00){\r\n\r\n\tif(game.saveFile){\r\n\t\tconst fields={ INAM: \"AppleII Applesoft Code\", IART: \"nitrologic\", ISFT: \"nitrologic machine 0.9.9\" };\r\n\t\tawait game.tape.writeFile(\"test.wav\",fields);\r\n\t\tgame.saveFile=false;\r\n\t}\r\n\r\n\tif(stepping || step){\r\n\t\tcounter++;\r\n\t\tgame.tick();\r\n\t\tlet pc=game.pc\r\n\t\tif(breakPoints.includes(pc[0])){\r\n\t\t\tconsole.log(cursorClear+\"BREAKPOINT\");\r\n\t\t\tstepping=false;\r\n\t\t}\r\n\t\tlet org=game.pc[0];\r\n\t\tlet orgHex=hex(org,4);\r\n\t\tlet line=game.interpret6502();\r\n\t\tlet args=\"\";\r\n\t\tlet status=\"\";\r\n\t\tif(tracing||!stepping){\r\n\t\t\tstatus=game.getStatus();\r\n\t\t\tlet bytes=game.hexVector(1);\r\n\t\t\tlet cycle=hex(game.cycleCount|0,6);\r\n\t\t\tlet orgBytes=(orgHex+\":\"+bytes).padEnd(11);\t//15\t\t\t\t\r\n//\t\t\tlet label=game.labels.get(orgHex)||\"\";\r\n\t\t\tlet label=game.addresLabel(org,true);\r\n\t\t\tif(label?.length<8) label+=\"\\t\";\r\n//\t\tconsole.log(cycle+\"\\t\"+orgBytes+\"\\t\"+label+\"\\t\"+line+\"\\t\\t; \"+status);\r\n\t\t\targs=joinArgs(cycle,orgBytes,label,line+\"\\t\",status);\r\n//\t\t\targs=joinArgs(cycle,orgBytes,label,line);\r\n\t\t}\r\n\t\tif(stepping&&tracing){\r\n\t\t\twhile(trace.length>256) trace.shift();\r\n\t\t\ttrace.push(args);\r\n\t\t}\r\n\t\tif(!stepping){//(step){\r\n\t\t\tif(args) console.log(args);\r\n//\t\t\tif(status) console.log(\"\\t\\t\",status);\r\n\t\t\tstep=false;\r\n\t\t}\r\n\t\tgame.pollDVG();\r\n\t}else{\r\n\t\twriteConsole(\"\\r\");\r\n\t}\r\n\r\n\tif(stepping){\r\n//\t\tif((counter&0x1fff)==0){\r\n\t\tif((counter&0xfff)==0){\r\n\t\t\tpollSize();\r\n\t\t\tawait processInput();\r\n\t\t\tawait sleep(10);\r\n\t\t}\r\n\t}else{\r\n\t\tpollSize();\r\n\t\tawait processInput();\r\n\t\tawait sleep(100);\r\n\t}\r\n}\r\n\r\nconsole.log(\"machine is shutting down\",{clicks,cycles:game.cycleCount,stepping,running,game:game.running});\r\nstopTerminal();\r\nawait sleep(100);\r\n//console.log(cursorRestore);\r\n","name":"content"},{"role":"user","content":"Files shared. Feel free to comment if content is new or different.","name":"simonsta"},{"role":"assistant","content":"I've reviewed the TypeScript file. This is a comprehensive retro computer emulator supporting multiple 8-bit platforms (Apple II, C64, VIC-20, Plus/4, Atari) with a MOS 6502 CPU interpreter, display rendering, cassette I/O, and terminal UI.\n\n**Key observations:**\n\n1. **Architecture**: Well-structured emulator with separate concerns—CPU interpretation, memory management, I/O handling, and display rendering.\n\n2. **Strengths**:\n   - Complete 6502 opcode implementation with addressing modes\n   - Multi-platform support with platform-specific I/O\n   - Terminal rendering with ANSI color codes and Unicode blocks/braille\n   - Cassette tape recording/playback with WAV file support\n   - Vector graphics engine (Atari DVG)\n\n3. **Notable patterns**:\n   - Global state for input (hitBits, mouseX, mouseY, etc.)\n   - Display mode flags using bitwise operations\n   - Cycle-accurate timing with raster interrupt simulation\n   - Label mapping for disassembly\n\n4. **Potential considerations**:\n   - Large monolithic file (~2500 lines)—could benefit from modularization (separate CPU, display, I/O classes)\n   - Some TODO items and commented-out code blocks\n   - Mixed direct memory access and `readAddress`/`writeAddress` methods\n   - Global variables at module level could limit reusability\n\n5. **Recent changes appear stable**—no syntax issues detected.\n\nIs there a specific aspect you'd like to discuss or refactor?"},{"role":"user","content":"for cursor on c64 is there vic chip address used to flash it","name":"simonsta"},{"role":"assistant","content":"Looking at the C64 display code, I don't see explicit cursor flashing via VIC chip registers.\n\n**Current implementation** (displayPetScreen):\n```typescript\nfunction displayPetScreen(mem:Uint8Array,frameX:number,frameY:number,charMem:number,colorMem:number,wide:number,high:number){\n\tconst c=isVIC?mem[0x900f]&7:(isC64?mem[0xd020]:(isTed?(mem[0xff19]&15):15) );\n\tconst borderColor=isC64?c64Color(c*16):tedColor(c*16);\n\tconst bg0=isVIC?(mem[0x900f]>>4)&15:( isC64?mem[0xd021]:(isTed?(mem[0xff15]&15):5) );\n\t// ... renders screen but no cursor blink logic\n```\n\n**VIC-II addresses that *could* be used** (not currently leveraged):\n- **$D012** (raster line) - already read for timing, could use for blink sync\n- **$D011** (control register) - has display enable but not cursor-specific\n\n**For authentic C64 cursor blinking**, you'd typically:\n1. Use `frameCount` (already available) to toggle cursor visibility: `frameCount & 32` or similar\n2. Store cursor position in zero-page RAM (tradition: $D0/$D1 or custom location)\n3. Modify the character at that position during render if blink is active\n\nWould you like me to suggest a cursor implementation using the existing `frameCount` mechanism, or were you asking if hardware VIC addresses currently drive it?"},{"role":"user","content":"on real c64 how is cusor displayed, as an overlay?","name":"simonsta"},{"role":"assistant","content":"On real C64, the cursor is **not a VIC chip hardware feature**—it's entirely **software-managed**.\n\n**How it actually works:**\n\n1. **Character replacement**: The cursor is displayed by writing a specific character code to screen RAM at the cursor position\n   - Typically **$A0** (reverse video space) or **$7F** (underscore-like glyph)\n   - Or a custom character from the character ROM\n\n2. **Blinking via software**: \n   - The BASIC interpreter (or application) polls a timer and periodically writes/erases the cursor character\n   - Uses a counter in zero-page RAM (typically around $A2-$A4 area in Commodore BASIC)\n   - Every N frames, it XORs or toggles the character at cursor position\n\n3. **No VIC chip involvement**: The VIC-II doesn't track cursor state—it just renders whatever character code is in screen RAM at that location\n\n**In your emulator context:**\n\nYour current approach is closer to correct—you'd need to:\n- Store cursor position (row/column)\n- During `displayC64()` render, check if current char position matches cursor\n- If `frameCount & 32` (or similar blink rate), substitute/invert that character\n\nThe cursor isn't an overlay; it's a character replacement in the displayed text, just like typing normally overwrites screen RAM.\n\nWould you want to add cursor rendering to the display functions?"},{"role":"user","content":"i don think the correct timer is generating interrupt","name":"simonsta"},{"role":"assistant","content":"Looking at the interrupt generation code:\n\n```typescript\nif(isC64||isTed||isVIC){\n\tconst irqCount=(count/333)|0;\n\tconst bit=(irqCount&1)<<7;\n\tlet st=this.registers[register.ST];\n\tconst tick=(irqCount/12)|0;\n\tif(tick>this.irqCount){\n\t\tlet enabled=true;\n\t\tthis.irqCount=tick;\n\t\t// set high bit of VIQ IRQ\n\t\tif(isVIC) {\n\t\t\tthis.memory[0x912d]|=0xc0;//IFR|=T1|IRQ\n\t\t\tenabled=(this.memory[0x912E]&0x40)==0x40;\n\t\t}else{\n\t\t\tthis.memory[0xd019]|=0x80;\n\t\t}\n\t\tif(enabled&&((st&IFLAG)==0)){\n\t\t\tthis.interrupt(Request.IRQ,\"Timer A 50hz PAL CIA#1\");\n\t\t}\n\t}\n}\n```\n\n**Issues:**\n\n1. **Divider math**: `count/333` then `tick=(irqCount/12)|0`\n   - This creates a very slow interrupt (~40ms between ticks)\n   - PAL C64 expects **50Hz raster interrupts**, not this frequency\n\n2. **Actual C64 timing**:\n   - CPU clock: ~985kHz (PAL)\n   - Raster lines: 312 per frame @ 50Hz\n   - Cycles per line: ~63 cycles\n   - **Raster interrupt every ~63 cycles** (per line), not every `333/12=27.75` cycles\n\n3. **CIA vs VIC interrupt confusion**:\n   - Code mentions \"CIA#1\" but sets `$D019` (VIC interrupt register)\n   - Should probably use raster interrupt, not timer-based\n\n**Better approach:**\n\n```typescript\nconst cyclesPerRasterLine = 63; // PAL C64\nconst rasterLine = (count / cyclesPerRasterLine) | 0;\n\nif(isC64 && rasterLine !== this.lastRasterLine) {\n\tthis.lastRasterLine = rasterLine;\n\tthis.memory[0xd012] = rasterLine & 0xFF;\n\tthis.memory[0xd011] = (this.memory[0xd011] & 0x7F) | ((rasterLine >> 8) << 7);\n\t\n\tif(/* raster compare match */) {\n\t\tthis.memory[0xd019] |= 0x01; // IRQ flag\n\t\tif((this.memory[0xd01a] & 0x01) && ((st & IFLAG) == 0)) {\n\t\t\tthis.interrupt(Request.IRQ, \"Raster interrupt\");\n\t\t}\n\t}\n}\n```\n\nIs the current interrupt rate visibly wrong in your games, or is this a suspected issue?"},{"role":"user","content":"{\"path\":\"C:\\\\nitrologic\\\\arcade\\\\machine.ts\",\"length\":108307,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// machine.ts\r\n// (c) 2026 nitrologic\r\n// All Rights Reserved\r\n\r\nimport { unZip } from \"./unzip.ts\";\r\nimport { parseWavHeader, parseWavFile, writeWavFile } from \"./wavfileutil.ts\";\r\n\r\nimport mos6502 from \"./mos6502.json\" with { type: \"json\" };\r\nimport vic20 from \"./commodore/vic20.json\" with { type: \"json\" };\r\nimport vic1541 from \"./commodore/vic1541.json\" with { type: \"json\" };\r\nimport plus4 from \"./commodore/plus4.json\" with { type: \"json\" };\r\nimport c64 from \"./commodore/c64.json\" with { type: \"json\" };\r\nimport atari0 from \"./atari/atarilunarlanderrev4.json\" with { type: \"json\" };\r\nimport atari1 from \"./atari/ataricentipederev4.json\" with { type: \"json\" };\r\nimport atari2 from \"./atari/atariasteroidsrev4.json\" with { type: \"json\" };\r\nimport atari3 from \"./atari/ataribattlezonerev2.json\" with { type: \"json\" };\r\nimport apple2 from \"./apple/appleII.json\" with { type: \"json\" };\r\nimport apple2plus from \"./apple/appleIIplus.json\" with { type: \"json\" };\r\n\r\nimport appleSabotage from \"./apple/applesabotage.json\" with { type: \"json\" };\r\nimport applePennyArcade from \"./apple/applepennyarcade.json\" with { type: \"json\" };\r\nimport appleElite from \"./apple/appleelite.json\" with { type: \"json\" };\r\n\r\nconst machineROMs=[\r\n\tvic20,vic1541,c64,plus4,\r\n\tapple2plus,apple2,\r\n\tatari0,atari1,atari2,atari3\r\n];\r\n\r\nconst machineSpec=c64;//vic20;//apple2plus;//c64;//apple2;//plus4;//plus4;//c64;//apple2plus;//atari0;//apple2plus;//atari0;//apple2;//atari2;//await select(roms);\r\n\r\nconst appleGames=[appleElite,appleSabotage,applePennyArcade];\r\n\r\nimport { sleep, isRunning, stopRunning, runTerminal, pollKeypad, pollTerminal, stopTerminal } from \"./terminalarcade.ts\";\r\nimport console from \"node:console\";\r\n\r\nconst machineTitle=\"machine 1.5 (c) 2026 nitrologic\";\r\n\r\nlet running=true;\r\nlet stepping=false;\r\nlet tracing=false;\r\n\r\n/*\r\nconst unit8=new Machine();\r\nunit8.burn(vic1541.rom);\r\nconst id=parseInt(vic1541.address.ID,16);\r\nconst version=parseInt(vic1541.address.VERSION,16);\r\nconst idString=unit8.peekString(id);\r\nconst v65=unit8.memory[version]; // enforce value is A (65) \r\nconsole.log(vic1541.title,idString,(v65==65)?\"A\":\"???\");\r\nconst game=unit8;\r\nconst gameRom=vic1541;\r\n*/\r\n\r\nconst gameRom=machineSpec;\r\nconst platform=machineSpec.platform;\r\n\r\nlet is1541=false;\r\nlet isVIC=(platform==\"vic20\");\r\nlet isTed=(platform==\"plus4\");\r\nlet isApple=(platform==\"appleii\");\r\nlet isC64=(platform==\"c64\");\r\nlet isAtari=false;\r\n\r\n// global inputs from processInput() courtesy terminalarcade\r\n\r\nlet hitBits=0;\r\nlet hitCount=0;\r\n\r\nlet mouseX=0;\r\nlet mouseY=0;\r\n\r\nlet axisY=0;\r\nlet axisX=0;\r\n\r\nlet clicks=0;\r\n\r\nlet rasterLine=0;\r\n\r\nconst CyclesPerLine=60;\r\n\r\n\r\nconst cusorPasteOn=\"\\x1b[?2004h\";\r\nconst cusorPasteOff=\"\\x1b[?2004l\";\r\n\r\nconst cursorYellow=\"\\x1b[43m\";\r\nconst cursorGreen=\"\\x1b[42m\";\r\n\r\nconst cursorPlain=\"\\x1b[0m\";\r\nconst cursorBold=\"\\x1b[1m\";\r\nconst cursorSave=\"\\x1b[s\";\r\nconst cursorRestore=\"\\x1b[u\";\r\nconst cursorHome=\"\\x1b[H\";\r\nconst cursorErase=\"\\x1b[K\";\r\nconst cursorClear=\"\\x1b[2J\\x1b[1;1H\";\r\nconst cursorUp=\"\\x1b[A\";\r\nconst cursorDown=\"\\x1b[B\";\r\nconst cursorHide=\"\\x1b[?25l\";\r\nconst cursorShow=\"\\x1b[?25h\";\r\n\r\nfunction cursorPos(x:number,y:number):string{\r\n\treturn \"\\x1b[\"+(y||1)+\";\"+(x||1)+\"H\";\r\n}\r\n\r\nfunction cursorHor(x:number):string{\r\n\treturn \"\\x1b[\"+(x||1)+\"G\";\r\n}\r\n\r\nconst POKEY_RANDOM=0x100a;\r\n\r\nconsole.log(machineTitle);\r\n\r\n//console.log(cursorClear+machineTitle);\r\n//console.log(mos6502.name,mos6502.version,mos6502.copyright);\r\n\r\n// each char is two 16 color blocks high\r\n// ansi fg,bg to set colors for each 1x2 char\r\n\r\nconst appleBlock=new Array<string>(256);\r\n\r\nconst appleANSI = [\r\n\t16,  // 0 Black\r\n\t197, // 1 Deep Pink\r\n\t61,  // 2 Medium Slate Blue\r\n\t201, // 3 Magenta\r\n\t22,  // 4 Dark Green\t// was 28\r\n\t244, // 5 Gray\r\n\t39,  // 6 Deep Sky Blue\r\n\t147, // 7 Light Periwinkle\r\n\t94,  // 8 Dark Goldenrod\r\n\t208, // 9 Dark Orange\r\n\t250, // 10 Light Gray\r\n\t218, // 11 Light Pink\r\n\t46,  // 12 Lime\r\n\t190, // 13 Chartreuse\r\n\t123, // 14 Aquamarine\r\n\t231, // 15 White\r\n];\r\n\r\nconst tedANSI = [\r\n\t16,  // 0 Black\r\n\t255, // 1 White\r\n\t131, // 2 Red\r\n\t116, // 3 Cyan\r\n\t133, // 4 Purple\r\n\t71,  // 5 Green\r\n\t26,  // 6 Blue\r\n\t227, // 7 Yellow\r\n\t172, // 8 Orange\r\n\t94,  // 9 Brown\r\n\t174, // 10 Light Red\r\n\t240, // 11 Dark Gray\r\n\t246, // 12 Medium Gray\r\n\t120, // 13 Light Green\r\n\t111, // 14 Light Blue\r\n\t250, // 15 Light Gray\r\n];\r\n\r\nconst c64ANSI = [\r\n\t16,  // 0 Black\r\n\t231, // 1 White\r\n\t131, // 2 Red\r\n\t116, // 3 Cyan\r\n\t133, // 4 Purple\r\n\t71,  // 5 Green\r\n\t26,  // 6 Blue\r\n\t227, // 7 Yellow\r\n\t172, // 8 Orange\r\n\t94,  // 9 Brown\r\n\t174, // 10 Light Red\r\n\t238, // 11 Dark Gray\r\n\t244, // 12 Medium Gray\r\n\t120, // 13 Light Green\r\n\t111, // 14 Light Blue\r\n\t250, // 15 Light Gray\r\n];\r\nconst vic20ANSI = [\r\n\t16,  // 0  Black\r\n\t231, // 1  White\r\n\t131, // 2  Red\r\n\t116, // 3  Cyan\r\n\t133, // 4  Purple\r\n\t71,  // 5  Green\r\n\t26,  // 6  Blue\r\n\t186, // 7  Yellow          (slightly different from C64)\r\n\t172, // 8  Orange\r\n\t180, // 9  Light Orange\r\n\t174, // 10 Light Red / Pink\r\n\t159, // 11 Light Cyan\r\n\t177, // 12 Light Purple\r\n\t120, // 13 Light Green\r\n\t111, // 14 Light Blue\r\n\t229, // 15 Light Yellow\r\n];\r\n\r\nconst textColors=15+64;\r\n\r\nfunction initAppleBlocks(){\r\n\tfor(let i=0;i<256;i++){\r\n\t\tconst lo=appleANSI[i&15];\r\n\t\tconst hi=appleANSI[i>>4];\r\n\t\tconst block=\"\\x1b[38;5;\"+lo+\"m\\x1b[48;5;\"+hi+\"m▀\";\r\n\t\tappleBlock[i]=block;\r\n\t}\r\n}\r\n\r\nfunction appleColor(i:number):string{\r\n\tconst lo=appleANSI[i&15];\r\n\tconst hi=appleANSI[i>>4];\r\n\tconst code=\"\\x1b[38;5;\"+lo+\"m\\x1b[48;5;\"+hi+\"m\";\r\n\treturn code;\r\n}\r\n\r\nfunction c64Color(i:number):string{\r\n\tconst lo=c64ANSI[i&15];\r\n\tconst hi=c64ANSI[i>>4];\r\n\tconst code=\"\\x1b[38;5;\"+lo+\"m\\x1b[48;5;\"+hi+\"m\";\r\n\treturn code;\r\n}\r\nfunction vic20Color(i:number):string{\r\n\tconst lo=vic20ANSI[i&15];\r\n\tconst hi=vic20ANSI[i>>4];\r\n\tconst code=\"\\x1b[38;5;\"+lo+\"m\\x1b[48;5;\"+hi+\"m\";\r\n\treturn code;\r\n}\r\n\r\nfunction tedColor(i:number):string{\r\n\tconst lo=tedANSI[i&15];\r\n\tconst hi=tedANSI[i>>4];\r\n\tconst code=\"\\x1b[38;5;\"+lo+\"m\\x1b[48;5;\"+hi+\"m\";\r\n\treturn code;\r\n}\r\n\r\n// 280x192 hires mode279-c\r\nconst braille=[\r\n    \"⠀⠁⠂⠃⠄⠅⠆⠇⠈⠉⠊⠋⠌⠍⠎⠏⠐⠑⠒⠓⠔⠕⠖⠗⠘⠙⠚⠛⠜⠝⠞⠟⠠⠡⠢⠣⠤⠥⠦⠧⠨⠩⠪⠫⠬⠭⠮⠯⠰⠱⠲⠳⠴⠵⠶⠷⠸⠹⠺⠻⠼⠽⠾⠿\",\r\n    \"⡀⡁⡂⡃⡄⡅⡆⡇⡈⡉⡊⡋⡌⡍⡎⡏⡐⡑⡒⡓⡔⡕⡖⡗⡘⡙⡚⡛⡜⡝⡞⡟⡠⡡⡢⡣⡤⡥⡦⡧⡨⡩⡪⡫⡬⡭⡮⡯⡰⡱⡲⡳⡴⡵⡶⡷⡸⡹⡺⡻⡼⡽⡾⡿\",\r\n    \"⢀⢁⢂⢃⢄⢅⢆⢇⢈⢉⢊⢋⢌⢍⢎⢏⢐⢑⢒⢓⢔⢕⢖⢗⢘⢙⢚⢛⢜⢝⢞⢟⢠⢡⢢⢣⢤⢥⢦⢧⢨⢩⢪⢫⢬⢭⢮⢯⢰⢱⢲⢳⢴⢵⢶⢷⢸⢹⢺⢻⢼⢽⢾⢿\",\r\n    \"⣀⣁⣂⣃⣄⣅⣆⣇⣈⣉⣊⣋⣌⣍⣎⣏⣐⣑⣒⣓⣔⣕⣖⣗⣘⣙⣚⣛⣜⣝⣞⣟⣠⣡⣢⣣⣤⣥⣦⣧⣨⣩⣪⣫⣬⣭⣮⣯⣰⣱⣲⣳⣴⣵⣶⣷⣸⣹⣺⣻⣼⣽⣾⣿\"];\r\n\r\nfunction displayHires(mem:Uint8Array,frameCount:number,mode:number){\r\n\tconst base=(mode&Page2Mode)?0x4000:0x2000;\r\n\tfor(let y=0;y<192;y+=4){\r\n\t\tconst line=[appleColor(8)];\r\n\t\tconst offset=base + ((y&7)<<10) + 128*((y>>3)&7) + 40*(y>>6);\r\n\t\tfor(let x=0;x<40;x+=2){\r\n\t\t\tconst b00=mem[offset+x];\r\n\t\t\tconst b01=mem[offset+x+1];\r\n\t\t\tconst b10=mem[offset+x+1024];\r\n\t\t\tconst b11=mem[offset+x+1025];\r\n\t\t\tconst b20=mem[offset+x+2048];\r\n\t\t\tconst b21=mem[offset+x+2049];\r\n\t\t\tconst b30=mem[offset+x+3072];\r\n\t\t\tconst b31=mem[offset+x+3073];\r\n\t\t\tlet b0=(b01<<7)|(b00&0x7f);\r\n\t\t\tlet b1=(b11<<7)|(b10&0x7f);\r\n\t\t\tlet b2=(b21<<7)|(b20&0x7f);\r\n\t\t\tlet b3=(b31<<7)|(b30&0x7f);\r\n            for(let i=0;i<7;i++){\r\n                const b50=\r\n                    ((b0&1)<<0)|\r\n                    ((b1&1)<<1)|\r\n                    ((b2&1)<<2)|\r\n                    ((b0&2)<<2)|\r\n                    ((b1&2)<<3)|\r\n                    ((b2&2)<<4);\r\n                line.push(braille[b3&3][b50]);\r\n                b0>>=2;b1>>=2;b2>>=2;b3>>=2;\r\n\t\t\t}\r\n\t\t}\r\n\t\tconsole.log(line.join(\"\"));\r\n\t}\r\n\tconsole.log(cursorPlain+cursorHome);\r\n}\r\n\r\nconst GraphicsMode=1;\r\nconst MixedMode=2;\r\nconst HiresMode=4;\r\nconst Page2Mode=8;\r\n\r\n\r\nconst fullWidth =\r\n  \"　\" +                          // 32 space\r\n  \"！＂＃＄％＆＇（）＊＋，－．／\" + // 33-47\r\n  \"０１２３４５６７８９\" +         // 48-57\r\n  \"：；＜＝＞？＠\" +               // 58-64\r\n  \"ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ\" + // 65-90\r\n  \"［＼］＾＿｀\" +                 // 91-96\r\n  \"ａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ\" + // 97-122\r\n  \"｛｜｝～\";                     // 123-126\r\n\r\nconst petsciiUppercase =\r\n  \"@ABCDEFGHIJKLMNOPQRSTUVWXYZ[$]↑←\"+\r\n  \" !\\\"#$%&'()*+,-./0123456789:;<=>?-\"+\r\n  \"♠│━╮╰╯╱╲◢◣◥┼▕◢◤◥╳↑╱╲╲│━╮╰╯\" + // 65-90: Graphic glyphs mapped to Shifted A-Z\r\n  \"│━▔▕━◥▏▒▕▔▒▒▬▔▒▎▍▒▒▔▕░▒▓█\" + // 91-116: C64 symbols\r\n  \"▊▕▬▕▔▎▍▒▕▔▒▒▬▔▒\"; // 117-127: C64 symbols\r\n\r\n  const petsciiUppercaseWide =\r\n  \"＠\" + // 0: @\r\n  \"ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ\" + // 1-26: A-Z\r\n  \"［￡］↑←\" + // 27-31: [, £, ], ↑, ←\r\n  \"　\" + // 32: Space\r\n  \"！＂＃＄％＆＇（）＊＋，－．／\" + // 33-47\r\n  \"０１２３４５６７８９\" + // 48-57\r\n  \"：；＜＝＞？\" + // 58-63\r\n  \"━\" + // 64: Horizontal line\r\n  \"♠│━╮╰╯╱╲◢◣◥┼▕◢◤◥╳↑╱╲╲│━╮╰╯\" + // 65-90: Graphic glyphs mapped to Shifted A-Z\r\n  \"│━▔▕━◥▏▒▕▔▒▒▬▔▒▎▍▒▒▔▕░▒▓█\" + // 91-116: C64 symbols\r\n  \"▊▕▬▕▔▎▍▒▕▔▒▒▬▔▒\"; // 117-127: C64 symbols\r\n\r\n //// \"boxChars\":[\"╭╮╰╯─┬┴│┤├┼\",\"┌┐└┘─┬┴│┤├┼\",\"╔╗╚╝═╦╩║╣╠╬\",\"┏┓┗┛━┳┻┃┫┣╋\"],\r\n\r\nfunction displayAppleWide(memory:Uint8Array,frameCount:number,mode:number,frame:string){\r\n\tconst status=cursorPos(52,1)+JSON.stringify({hitBits,hitCount,mouseX,mouseY,axisX,axisY})+cursorErase+\"\\n\";\r\n\twriteConsole(cursorHome+status);//+cursorDown);\r\n\tif ((mode&GraphicsMode) && (mode&HiresMode)) return displayHires(memory,frameCount,mode);\r\n// memory[0x400] is first byte of display\r\n\tconst color=appleColor(textColors);\r\n\tconst splitY=[0,24,0,20][mode&(GraphicsMode|MixedMode)];\r\n\tconst base=(mode&Page2Mode)?0x800:0x400;\r\n\tconst line=new Array<string>(40);\r\n\tlet left=\"\";\r\n\tlet right=\"\";\r\n\tif(frame){\r\n\t\tconst top=\"╭\"+\"─\".repeat(80)+\"╮\";\r\n\t\tleft=\"│\";right=\"│\";\r\n\t\tconst pos=cursorPos(11,2);\r\n\t\twriteConsole(pos+color+top);\r\n\t}\r\n// graphics\r\n\tfor(let y=0;y<splitY;y++){\r\n\t\tconst offset=base+40*(y>>3)+128*(y&7);\r\n\t\tfor(let x=0;x<40;x++){\r\n\t\t\tconst byte=memory[offset+x];\r\n\t\t\tconst block=appleBlock[byte];\r\n\t\t\tline[x]=block+block;\r\n\t\t}\r\n\t\tconst pos=cursorPos(11,3+y);\r\n\t\twriteConsole(pos+left+line.join(\"\")+color+right);\r\n\t}\r\n//\tconsole.log(cursorRestore);\r\n//\tconsole.log(appleColor(8));//7 5\r\n// text\r\n\tfor(let y=splitY;y<24;y++){\r\n\t\tlet offset=0x400+40*(y>>3)+128*(y&7);\r\n\t\tfor(let x=0;x<40;x++){\r\n\t\t\tlet byte=memory[offset+x];\r\n\t\t\tlet invert:boolean=false;\r\n\t\t\tlet charCode=(byte&0x7f)||32;\r\n\t\t\tif((byte&0x80)==0){\r\n\t\t\t\tinvert=((byte&0x40)&&(frameCount&64))||(!(byte&0x40));\r\n\t\t\t\tcharCode=(byte&0x3f)||32;\r\n\t\t\t\tif(charCode<32) charCode+=64;\r\n\t\t\t}\r\n\t\t\tlet wchar=(charCode>=32)?fullWidth[charCode-32]:\"??\";\r\n//\t\t\tlet char=String.fromCharCode(charCode);\r\n\t\t\tif(invert) wchar = \"\\x1b[7m\" + wchar + \"\\x1b[27m\";\r\n\t\t\tline[x]=wchar;\r\n\t\t}\r\n\t\tconst pos=cursorPos(11,3+y);\r\n\t\twriteConsole(pos+left+color+line.join(\"\")+right);\r\n\t}\r\n\tif(frame){\r\n\t\tconst bottom=\"╰\"+\"─\".repeat(80)+\"╯\";\r\n\t\tconst pos=cursorPos(11,26);\r\n\t\twriteConsole(pos+bottom);\r\n\t}\r\n\twriteConsole(appleColor(15)+cursorHome);\r\n}\r\n\r\n// \"boxChars\":[\"╭╮╰╯─┬┴│┤├┼\",\"┌┐└┘─┬┴│┤├┼\",\"╔╗╚╝═╦╩║╣╠╬\",\"┏┓┗┛━┳┻┃┫┣╋\"],\r\n\r\n\r\nfunction displayApple1(memory:Uint8Array,frameCount:number,mode:number){\r\n\tconst status=cursorPos(52,1)+JSON.stringify({hitBits,hitCount,mouseX,mouseY,axisX,axisY})+cursorErase;\r\n\twriteConsole(cursorHome+status);//+cursorDown);\r\n\tif ((mode&GraphicsMode) && (mode&HiresMode)) return displayHires(memory,frameCount,mode);\r\n// memory[0x400] is first byte of display\r\n\tconst splitY=[0,24,0,20][mode&(GraphicsMode|MixedMode)];\r\n\tconst base=(mode&Page2Mode)?0x800:0x400;\r\n\tconst line=new Array<string>(40);\r\n\tif(frame)\r\n// graphics\r\n\tfor(let y=0;y<splitY;y++){\r\n\t\tconst offset=base+40*(y>>3)+128*(y&7);\r\n\t\tfor(let x=0;x<40;x++){\r\n\t\t\tconst byte=memory[offset+x];\r\n\t\t\tconst block=appleBlock[byte];\r\n\t\t\tline[x]=block;\r\n\t\t}\r\n\t\tconst pos=cursorPos(12,3+y);\r\n\t\twriteConsole(pos+line.join(\"\"));\r\n\t}\r\n//\tconsole.log(cursorRestore);\r\n//\tconsole.log(appleColor(8));//7 5\r\n// text\r\n\tfor(let y=splitY;y<24;y++){\r\n\t\tlet offset=0x400+40*(y>>3)+128*(y&7);\r\n\t\tfor(let x=0;x<40;x++){\r\n\t\t\tlet byte=memory[offset+x];\r\n\t\t\tlet invert:boolean=false;\r\n\t\t\tlet charCode=(byte&0x7f)||32;\r\n\t\t\tif((byte&0x80)==0){\r\n\t\t\t\tinvert=((byte&0x40)&&(frameCount&64))||(!(byte&0x40));\r\n\t\t\t\tcharCode=(byte&0x3f)||32;\r\n\t\t\t\tif(charCode<32) charCode+=64;\r\n\t\t\t}\r\n\t\t\tlet char=String.fromCharCode(charCode);\r\n\t\t\tif(invert) char = \"\\x1b[7m\" + char + \"\\x1b[27m\";\r\n\t\t\tline[x]=char;\r\n\t\t}\r\n\t\tconst pos=cursorPos(12,3+y);\r\n\t\twriteConsole(pos+appleColor(8+64)+line.join(\"\"));\r\n\t}\r\n\twriteConsole(appleColor(15)+cursorHome);\r\n}\r\n\r\nfunction logError(message:string){\r\n\tconsole.log(message);\r\n}\r\n\r\nfunction logStatus(message:string){\r\n\tconsole.log(message);\r\n}\r\n\r\nfunction refreshCRT(){\r\n\tconsole.log(cursorClear);\r\n\tconsole.log(\"frame time\");\r\n\tconsole.log(\"game time\");\r\n\tconsole.log(\"\");\r\n\tconst grid=game.buildMemcode(0x400,30,35);//HexMemory(0x400,32*30);\r\n\tconst mem=game.memory;\r\n\tfor(let i=0;i<16;i++){\r\n\t\tconst y=mem[0x7C0+i];\r\n\t\tconst x=mem[0x7F0+i]|0;\r\n\t\tconst row=(y>>3)|0;\r\n\t\tconst col=(x>>3)|0;\r\n\t\tgrid[row][col]=\"▌▞\";\r\n\t\tif(grid[row+1]){\r\n\t\t\tgrid[row+1][col]=\"▞▛\";\r\n\t\t}\r\n\t}\r\n\tdump(grid);\r\n}\r\n\r\ninitAppleBlocks();\r\n\r\nconst missingCodes=new Set<string>();\r\n\r\nconst MissingCode=\"🎁\"\r\nconst digits=[...\"０１２３４５６７８９\"];\r\nconst letters=[...\"ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ\"];\r\nconst punctuation=\"！＂＃＄％＆＇（）＊＋，－．／：；＜＝＞？＠［＼］＾＿｀｛｜｝～\";\r\n\r\nfunction memCode(code:number){\r\n\tcode&=63;\r\n\tif(code==0) return \"  \";\r\n\tif(code-1<letters.length) return letters[code-1]; // A..Z\r\n\tif(code>=0x20&&code<=0x29) return digits[code-0x20]; //0..9\r\n\tswitch (code) {\r\n\t\tcase 0x17: return \"||\";\r\n\t\tcase 0x1B: return \"\\u00A9\"; //(C)\r\n\t\tcase 0x1d: return \"🛰️\";\r\n\t\tcase 0x2d: return \"📠\";\r\n\t\tcase 0x3C: return \"░░\"; // Damaged (1/4)\r\n\t\tcase 0x3D: return \"▒▒\"; // Damaged (2/4)\r\n\t\tcase 0x3E: return \"▓▓\"; // Damaged (3/4)\r\n\t\tcase 0x3F: return \"🍄\"; // Fully intact mushroom\r\n\t}\r\n\tmissingCodes[hex(code,2)]=true;\r\n\treturn MissingCode;\r\n}\r\n\r\nenum register{X,Y,A,SP,ST};\r\n\r\nconst regname=[\"X\",\"Y\",\"A\",\"SP\",\"NV_BDIZC\"];\r\n\r\nconst CFLAG=1;\r\nconst ZFLAG=2;\r\nconst IFLAG=4;\r\nconst DFLAG=8;\r\nconst BFLAG=16;\r\nconst GFLAG=32;\r\nconst VFLAG=64;\r\nconst NFLAG=128;\r\n\r\nenum flag{C,Z,I,D,B,G,V,N};\r\nconst f=[\"C\",\"Z\",\"I\",\"D\",\"B\",\"_\",\"V\",\"N\"];\r\n\r\nlet step=false;\r\nlet counter=0;\r\n\r\nfunction hex(i:number,count:number=2){\r\n\treturn \"\"+i.toString(16).padStart(count,\"0\").toUpperCase();\r\n}\r\n\r\nfunction bits(i:number){\r\n\tlet bits=i.toString(2).padStart(8,\"0\");\r\n\tbits=bits.replaceAll(\"0\",\"▢\");\r\n\tbits=bits.replaceAll(\"1\",\"▤\");\r\n\treturn bits;\r\n}\r\n\r\nfunction boldBits(byte:number,old:number){\r\n\tconst boxes=[];\r\n\tconst xor=byte^old;\r\n\tfor(let bit=128;bit>0;bit>>=1){\r\n\t\