2519123a [claude-haiku-4-5] #			break;
2519123a [claude-haiku-4-5] #		// ... other TED registers
2519123b [claude-haiku-4-5] #	}
2519123b [claude-haiku-4-5] #
2519123b [claude-haiku-4-5] #	// Always write to RAM for $C000-$FFFF
