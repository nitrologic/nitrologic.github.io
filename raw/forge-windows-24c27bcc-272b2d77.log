24c4e40f [deepseek-v4-flash] #
24c4e40f [deepseek-v4-flash] #
24c4e410 [deepseek-v4-flash] #const dataStart = (i + 3) % n;
24c4e410 [deepseek-v4-flash] #const nibbles = new Uint8Array(342);
24c4e410 [deepseek-v4-flash] #for (let p = 0; p < 342; p++) {
24c4e410 [deepseek-v4-flash] #    nibbles[p] = track.bytes[(dataStart + p) % n];
24c4e411 [deepseek-v4-flash] #}
24c4e411 [deepseek-v4-flash] #
24c4e411 [deepseek-v4-flash] #
24c4e412 [deepseek-v4-flash] #5. The decode loop offset for `temp[k + 86]`
24c4e412 [deepseek-v4-flash] #
24c4e412 [deepseek-v4-flash] #
24c4e412 [deepseek-v4-flash] #const lowBits = (secondary >> (2 * (k % 3))) & 0x03;
24c4e413 [deepseek-v4-flash] #bytes[k] = (temp[k + 86] << 2) | lowBits;
24c4e413 [deepseek-v4-flash] #
24c4e413 [deepseek-v4-flash] #
24c4e413 [deepseek-v4-flash] #That's correct for standard 6-and-2: 86 bytes of "even" (high) data, 256 bytes of "odd" (low) data
24c4e414 [deepseek-v4-flash] #interleaved. Just double-check the indexing when `k + 86` exceeds 341 — it won't here because `k <
24c4e414 [deepseek-v4-flash] #256`, max `k+86 = 341`. Good.
