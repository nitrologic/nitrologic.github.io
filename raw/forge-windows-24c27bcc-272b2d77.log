262be6fc [gemini-3.7-flash] #At `$E840`, the PET is testing the Horizontal/Vertical Video Retrace (Blanking) Signal to
262be6fc [gemini-3.7-flash] #prevent "video snow" (screen flicker/sparkles).
262be6fd [gemini-3.7-flash] #
262be6fd [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262be6fd [gemini-3.7-flash] #
262be6fd [gemini-3.7-flash] #The Code Breakdown
262be6fe [gemini-3.7-flash] #
262be6fe [gemini-3.7-flash] #E7AD: LDA $E840       ; Read VIA_ORB (MOS 6522 Port B Data Register)
262be6fe [gemini-3.7-flash] #E7B0: AND #$20        ; Mask Bit 5 (%00100000)
262be6fe [gemini-3.7-flash] #E7B2: BNE $E7B4       ; Wait/check loop for retrace
262be6ff [gemini-3.7-flash] #E7B4: TYA             ; Restore character
262be6ff [gemini-3.7-flash] #E7B5: LDY $E2         ; Cursor column
262be6ff [gemini-3.7-flash] #E7B7: STA ($E0),Y     ; Write character directly to Screen RAM ($8000+)
262be6ff [gemini-3.7-flash] #
262be700 [gemini-3.7-flash] #
262be700 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262be700 [gemini-3.7-flash] #
262be700 [gemini-3.7-flash] #Hardware Reason (Why Commodore PETs do this)
262be701 [gemini-3.7-flash] #
262be701 [gemini-3.7-flash] #1. Shared Video RAM Bus:
262be701 [gemini-3.7-flash] #   * On early Commodore PET boards (original 2001 series and early upgrade boards), Video RAM
262be701 [gemini-3.7-flash] #(`8000–83E7`) did not have dual-port arbiters.
262be702 [gemini-3.7-flash] #   * If the 6502 CPU and the discrete video generator circuitry tried to access
262be702 [gemini-3.7-flash] #video RAM at the exact same clock cycle, bus contention occurred. This appeared on the CRT display
262be702 [gemini-3.7-flash] #as random white specks or flashes known as "snow."
262be702 [gemini-3.7-flash] #
262be703 [gemini-3.7-flash] #2. The Fix:
262be703 [gemini-3.7-flash] #   * Pin 5 of VIA Port B (`PB5`) was wired directly to the video controller's Video Blanking /
262be703 [gemini-3.7-flash] #Retrace signal.
262be703 [gemini-3.7-flash] #   * During active beam scanning, Bit 5 is in one state. During the retrace blanking
262be704 [gemini-3.7-flash] #interval (when the electron beam is shut off while resetting to draw the next scanline/frame),
262be704 [gemini-3.7-flash] #Bit 5 toggles.
262be704 [gemini-3.7-flash] #   * The Kernal checks this bit before executing `STA ($E0),Y` so CPU writes to screen RAM only
262be704 [gemini-3.7-flash] #occur when the video beam is blanked—eliminating video snow entirely.
262be705 [gemini-3.7-flash] #
