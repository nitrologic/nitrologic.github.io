26386d93 [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.045 166.4KB 4.65s
26386d94 [gemini-3.7-flash] #On the Commodore PET, address `$E810` connects to the MOS 6520 PIA 1 (Port A
26386d94 [gemini-3.7-flash] #data/direction register).
26386d94 [gemini-3.7-flash] #
26386d94 [gemini-3.7-flash] #What it returns depends directly on Bit 2 of the Control Register A (`$E811`) and the
26386d94 [gemini-3.7-flash] #hardware lines connected to Port A:
26386d95 [gemini-3.7-flash] #
26386d95 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26386d95 [gemini-3.7-flash] #
26386d95 [gemini-3.7-flash] #1. When Bit 2 of `$E811` = 0 (Data Direction Register Access)
26386d96 [gemini-3.7-flash] #• Returns: The contents of DDRA (Data Direction Register A).
26386d96 [gemini-3.7-flash] #• Behavior: Whatever value the CPU previously wrote to `E810` while `CRA bit 2 == 0`.
26386d96 [gemini-3.7-flash] #(During boot, the PET Kernal configures the lower 4 bits as outputs to drive the 74145 column
26386d96 [gemini-3.7-flash] #decoder, so DDRA is typically `3F` or `$0F`).
26386d97 [gemini-3.7-flash] #
26386d97 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26386d97 [gemini-3.7-flash] #
26386d97 [gemini-3.7-flash] #2. When Bit 2 of `$E811` = 1 (Port A I/O Register Access)
26386d97 [gemini-3.7-flash] #• Returns: The combined state of the Port A Output Register and the Physical
26386d97 [gemini-3.7-flash] #Input Pins (PRA).
26386d97 [gemini-3.7-flash] #• Reading Port A also clears the interrupt flags in `$E811` (Bits 6 & 7 reset to `0`).
26386d98 [gemini-3.7-flash] #
26386d98 [gemini-3.7-flash] #Physical Pin Mapping on the PET:
26386d98 [gemini-3.7-flash] #• Bits 0–3 (PA0–PA3): Configured as Outputs
26386d98 [gemini-3.7-flash] #  * Drive the 74145 BCD-to-Decimal Keyboard Column Decoder.
26386d98 [gemini-3.7-flash] #  * Reading these bits returns the last value written by software to `$E810` (the active
26386d99 [gemini-3.7-flash] #column nibble, e.g., `0x0` through `0x9`, or `0xF` when disabled).
26386d99 [gemini-3.7-flash] #• Bits 4–5 (PA4–PA5): Outputs / Diagnostics
26386d99 [gemini-3.7-flash] #  * Used for cassette motor control / IEEE-488 diagnostic lines.
26386d9a [gemini-3.7-flash] #  * Reading these bits returns the last software output state (or `1`s via pull-up resistors if
26386d9a [gemini-3.7-flash] #unconfigured).
26386d9a [gemini-3.7-flash] #• Bits 6–7 (PA6–PA7): Configured as Inputs
26386d9a [gemini-3.7-flash] #  * Connected to the IEEE-488 control lines (specifically `EOI` and `NDAC`/Cassette Sense
26386d9a [gemini-3.7-flash] #depending on board revisions).
26386d9b [gemini-3.7-flash] #  * With no IEEE devices attached, these float high due to internal pull-up resistors
26386d9b [gemini-3.7-flash] #(`1`).
26386d9b [gemini-3.7-flash] #
26386d9b [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26386d9c [gemini-3.7-flash] #
26386d9c [gemini-3.7-flash] #Summary Table for Emulation
