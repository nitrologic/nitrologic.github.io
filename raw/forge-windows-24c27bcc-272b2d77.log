2638805d [gemini-3.7-flash] #Here are the observations and differences in the updated `machine.ts`:
2638805d [gemini-3.7-flash] #
2638805e [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2638805e [gemini-3.7-flash] #
2638805e [gemini-3.7-flash] #1. `vidBlanking` Type Annotations
2638805e [gemini-3.7-flash] #• `vidBlanking(cycle: number): boolean` now includes explicit parameter and return types, fixing
2638805f [gemini-3.7-flash] #TypeScript type-checking warnings on arithmetic expressions.
2638805f [gemini-3.7-flash] #
2638805f [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2638805f [gemini-3.7-flash] #
26388060 [gemini-3.7-flash] #2. `writePET` Bypasses Memory Update on `$E810`
26388060 [gemini-3.7-flash] #• In `writePET`, when writing to `$E810` while `CRA & 0x04` is non-zero:
26388060 [gemini-3.7-flash] #  * `scanKeyboard(value & 15)` is invoked, followed immediately by `return;`.
26388060 [gemini-3.7-flash] #  * Because of the early return, `mem[address] = value;` is never reached.
26388060 [gemini-3.7-flash] #  * This prevents `mem[0xE810]` from storing the active column latch. If ROM routines read back
26388061 [gemini-3.7-flash] #`$E810` or check output state, they read stale data.
26388061 [gemini-3.7-flash] #
26388061 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26388061 [gemini-3.7-flash] #
26388062 [gemini-3.7-flash] #3. `$E810` Read Logic in `readPET`
26388062 [gemini-3.7-flash] #• In `readPET`, reading address `0xE810` clears the interrupt flags on `E811` (`mem[0xE811] &=
26388062 [gemini-3.7-flash] #0x3F;`) and returns `0xFF` unconditionally.
26388062 [gemini-3.7-flash] #• Depending on `mem[0xE811] & 0x04`:
26388063 [gemini-3.7-flash] #  * When Bit 2 is `0` (DDRA access): It should return the configured direction register
26388063 [gemini-3.7-flash] #byte.
26388063 [gemini-3.7-flash] #  * When Bit 2 is `1` (PRA access): It should return the latched output nibble in bits 0–3
26388063 [gemini-3.7-flash] #with the floating IEEE input lines (bits 6–7) pulled high (`(mem[0xE810] & 0x3F) | 0xC0`).
26388063 [gemini-3.7-flash] #
26388064 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26388064 [gemini-3.7-flash] #
26388064 [gemini-3.7-flash] #4. Keyboard Scanning on `$E812`
26388064 [gemini-3.7-flash] #• `readPET(0xE812)` calls `readPetMatrix()` and clears `$E813` flags (`mem[0xE813] &= 0x3F`), which
26388064 [gemini-3.7-flash] #correctly models PIA1 Port B read side effects.
26388065 [gemini-3.7-flash] #• If the simulator remains stuck scanning column 0, verify that `readPetMatrix()` in
26388065 [gemini-3.7-flash] #`./ffi/terminal.ts` returns `0xFF` when no keys are pressed. Any value other than `0xFF` causes the
26388065 [gemini-3.7-flash] #PET Kernal `SCNKEY` routine to detect a key press immediately and abort scanning columns 1 through
26388065 [gemini-3.7-flash] #9.
26388066 [gemini-3.7-flash] #
