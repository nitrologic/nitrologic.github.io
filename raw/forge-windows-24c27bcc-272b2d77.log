27025f85 [glm-5.3-flash] #In the Pico SDK, pin numbers are plain `uint` (unsigned int) — every function in `hardware/gpio.h`
27025f86 [glm-5.3-flash] #takes it that way:
27025f86 [glm-5.3-flash] #
27025f86 [glm-5.3-flash] #
27025f86 [glm-5.3-flash] #void gpio_init(uint gpio);
27025f86 [glm-5.3-flash] #void gpio_set_dir(uint gpio, bool out);
27025f86 [glm-5.3-flash] #void gpio_put(uint gpio, bool value);
27025f87 [glm-5.3-flash] #
27025f87 [glm-5.3-flash] #
27025f87 [glm-5.3-flash] #So the declaration would be:
27025f88 [glm-5.3-flash] #
27025f88 [glm-5.3-flash] #
27025f88 [glm-5.3-flash] #const uint gpio[]={0,1,2,3,4,5,6,7,14,15,16,17,18,19,20,21,22,26,27};
27025f88 [glm-5.3-flash] #const uint gpioCount=sizeof(gpio)/sizeof(gpio[0]);
27025f89 [glm-5.3-flash] #
27025f89 [glm-5.3-flash] #
27025f89 [glm-5.3-flash] #Two related types worth knowing:
27025f89 [glm-5.3-flash] #
27025f8a [glm-5.3-flash] #- `gpio_dir_t` — in SDK 2.x, `gpio_set_dir` takes this enum (`GPIO_IN`, `GPIO_OUT`, `GPIO_IN_OUT`)
27025f8a [glm-5.3-flash] #rather than a bool. In 1.x, `GPIO_IN`/`GPIO_OUT` were just `false`/`true`.
27025f8a [glm-5.3-flash] #- `gpio_function` — the enum used by `gpio_set_function` (`GPIO_FUNC_SPI`, `GPIO_FUNC_PWM`,
27025f8a [glm-5.3-flash] #`GPIO_FUNC_PIO0`, etc.).
27025f8b [glm-5.3-flash] #
27025f8b [glm-5.3-flash] #`int` works fine in practice since pin numbers are small positives, but `uint` matches the SDK
27025f8b [glm-5.3-flash] #signatures exactly and avoids sign-compare warnings in loops like `for(size_t
27025f8c [glm-5.3-flash] #i=0;i<gpio.size();i++)`. If you keep the vector, `std::vector<uint>` would be the matching form —
27025f8c [glm-5.3-flash] #though for a fixed pin list like this, the plain array is the more idiomatic SDK-style choice and
27025f8c [glm-5.3-flash] #costs no heap.
27025f8c [glm-5.3-flash] #
