27030e3c [glm-5.3-flash] #🟠nitrologic Relay 2.0.2 glm-5.3-flash Z 🪠 0.7° $0.001 36.84KB 10.87s
27030e3c [glm-5.3-flash] #`#ifdef` can't take operators — use `#if defined(...)` instead:
27030e3c [glm-5.3-flash] #
27030e3c [glm-5.3-flash] #
27030e3c [glm-5.3-flash] ##if defined(WAVESHARE_TOUCHLCD_35) || defined(WAVESHARE_LCD_114)
27030e3d [glm-5.3-flash] #	// either board
27030e3d [glm-5.3-flash] ##endif
27030e3d [glm-5.3-flash] #
27030e3d [glm-5.3-flash] #
27030e3e [glm-5.3-flash] #Variants worth knowing:
27030e3e [glm-5.3-flash] #
27030e3e [glm-5.3-flash] #
27030e3e [glm-5.3-flash] ##if defined(A) && defined(B)	// both
27030e3e [glm-5.3-flash] ##if defined(A) && !defined(B)	// A but not B
27030e3f [glm-5.3-flash] ##if !defined(A) && !defined(B)	// neither
27030e3f [glm-5.3-flash] #
27030e3f [glm-5.3-flash] #
27030e3f [glm-5.3-flash] #Note it's `defined(X)`, not `defined(X)` with parentheses around the whole thing, and the macros
27030e40 [glm-5.3-flash] #don't need to have a value — `#define WAVESHARE_LCD_114` alone is enough for `defined()` to be
27030e40 [glm-5.3-flash] #true.
27030e40 [glm-5.3-flash] #
27030e40 [glm-5.3-flash] #For your case, a pattern that works well with two boards sharing one driver:
27030e41 [glm-5.3-flash] #
27030e41 [glm-5.3-flash] #
27030e41 [glm-5.3-flash] ##if defined(WAVESHARE_TOUCHLCD_35)
27030e42 [glm-5.3-flash] #	#define LCD_WIDTH	320
27030e42 [glm-5.3-flash] #	#define LCD_HEIGHT	240
27030e42 [glm-5.3-flash] #	#define READ_TOUCH
27030e42 [glm-5.3-flash] ##elif defined(WAVESHARE_LCD_114)
27030e43 [glm-5.3-flash] #	#define LCD_WIDTH	240
27030e43 [glm-5.3-flash] #	#define LCD_HEIGHT	135
27030e43 [glm-5.3-flash] ##endif
27030e43 [glm-5.3-flash] #
27030e44 [glm-5.3-flash] #
27030e44 [glm-5.3-flash] #That way the rest of the code tests one macro at a time, and the board selection happens in one
27030e44 [glm-5.3-flash] #place — ideally in CMake (`target_compile_definitions(... WAVESHARE_LCD_114=1)`) rather than edited
27030e44 [glm-5.3-flash] #in the source, so switching boards is a build-config change.
27030e44 [glm-5.3-flash] #
