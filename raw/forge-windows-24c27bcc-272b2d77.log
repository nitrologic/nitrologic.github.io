262bbcef [gemini-3.7-flash] #
262bbcf0 [gemini-3.7-flash] #1. Line Feed Filter & Exit (`F23D–C9F8`)
262bbcf0 [gemini-3.7-flash] #
262bbcf0 [gemini-3.7-flash] #E3EA: KPRCHAR         ; Entry point for screen character printing
262bbcf0 [gemini-3.7-flash] #E3EB: STA $F6         ; Store incoming character ($0A - Line Feed)
262bbcf1 [gemini-3.7-flash] #E3F1: STA $0260       ; Reset screen quote/insert temporary tracking
262bbcf1 [gemini-3.7-flash] #E406: CMP #$20        ; Check if character is printable (< $20 is a control code)
262bbcf1 [gemini-3.7-flash] #E408: BCC $E412       ; It is a control character, branch to command dispatcher
262bbcf1 [gemini-3.7-flash] #; --- Control Code Evaluation Ladder ---
262bbcf2 [gemini-3.7-flash] #E419: CMP #$14        ; Delete? (No)
262bbcf2 [gemini-3.7-flash] #E440: CMP #$12        ; Reverse On? (No)
262bbcf2 [gemini-3.7-flash] #E447: CMP #$13        ; Home/Clear? (No)
262bbcf2 [gemini-3.7-flash] #E44E: CMP #$1D        ; Cursor Right? (No)
262bbcf3 [gemini-3.7-flash] #E464: CMP #$11        ; Cursor Down? (No)
262bbcf3 [gemini-3.7-flash] #E476: JMP $E38A       ; None matched (PET ignores raw LF $0A), jump to exit
262bbcf3 [gemini-3.7-flash] #E38A: ...             ; Pull Y, X, A from stack
262bbcf3 [gemini-3.7-flash] #E395: CLI             ; Re-enable interrupts
262bbcf4 [gemini-3.7-flash] #E396: RTS             ; Return from screen print handler
262bbcf4 [gemini-3.7-flash] #
262bbcf4 [gemini-3.7-flash] #• On the Commodore PET, character `$0D` (Carriage Return) handles both column reset and line
262bbcf4 [gemini-3.7-flash] #advancement.
262bbcf5 [gemini-3.7-flash] #• The bare Line Feed (`$0A`) is safely ignored by the screen editor dispatch table.
262bbcf5 [gemini-3.7-flash] #
262bbcf5 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262bbcf5 [gemini-3.7-flash] #
262bbcf6 [gemini-3.7-flash] #2. Calculating Free RAM for the Banner (`E15A–E164`)
262bbcf6 [gemini-3.7-flash] #
262bbcf6 [gemini-3.7-flash] #E15A: LDA $86         ; Low byte of Top of Memory ($00)
262bbcf6 [gemini-3.7-flash] #E15C: SEC             ; Set carry for subtraction
262bbcf7 [gemini-3.7-flash] #E15D: SBC $7A         ; Subtract Low byte of Start of BASIC text ($01)
262bbcf7 [gemini-3.7-flash] #E15F: TAX             ; Result low byte ($FF) -> X
262bbcf7 [gemini-3.7-flash] #E160: LDA $87         ; High byte of Top of Memory ($80)
262bbcf7 [gemini-3.7-flash] #E162: SBC $7B         ; Subtract High byte of Start of BASIC text ($04)
262bbcf8 [gemini-3.7-flash] #                      ; Result high byte ($7B) -> A
262bbcf8 [gemini-3.7-flash] #
262bbcf8 [gemini-3.7-flash] #• Memory Math:
262bbcf8 [gemini-3.7-flash] #  \$8000 - \$0401 = \$7BFF \text bytes = 31,743 \text bytes free
262bbcf9 [gemini-3.7-flash] #• High byte `7B` and Low byte `FF` are prepared in `A:X` for conversion.
262bbcf9 [gemini-3.7-flash] #
262bbcf9 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262bbcf9 [gemini-3.7-flash] #
262bbcfa [gemini-3.7-flash] #3. Integer-to-Floating-Point Conversion (`DC9F–DB1F`)
262bbcfa [gemini-3.7-flash] #
262bbcfa [gemini-3.7-flash] #E164: JSR $DC9F       ; Call GIVAYF (Convert 16-bit integer in A/X to Float in FAC)
262bbcfa [gemini-3.7-flash] #DC9F: STA $B1         ; Store integer high byte ($7B) into FAC Mantissa
262bbcfb [gemini-3.7-flash] #DCA1: STX $B2         ; Store integer low byte ($FF) into FAC Mantissa
262bbcfb [gemini-3.7-flash] #DCA3: LDX #$90        ; Set base exponent (16 bits, $90 = exponent 16 + 128 bias)
262bbcfb [gemini-3.7-flash] #DCA5: SEC             ; Set carry
262bbcfb [gemini-3.7-flash] #DCA6: JSR $DB1B       ; Jump to FAC normalization routine
262bbcfc [gemini-3.7-flash] #DB1B: LDA #$00        ;
262bbcfc [gemini-3.7-flash] #DB1D: STA $B4         ; Clear lower mantissa extension bytes
262bbcfc [gemini-3.7-flash] #DB1F: STA $B3         ;
262bbcfd [gemini-3.7-flash] #
262bbcfd [gemini-3.7-flash] #• BASIC takes the 16-bit integer `31743` and converts it into Microsoft 5-byte Floating Point
262bbcfd [gemini-3.7-flash] #format in the FAC (Floating Point Accumulator, `B0–B5`).
262bbcfd [gemini-3.7-flash] #• Once normalized, BASIC will call the float-to-ASCII routine (`FOUT`) to convert the number into
262bbcfe [gemini-3.7-flash] #text characters, which will then be printed alongside `" COMMODORE BASIC "` and
