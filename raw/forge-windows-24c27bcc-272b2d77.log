264e6e06 [gemini-3.7-flash] #
264e6e06 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264e6e06 [gemini-3.7-flash] #
264e6e06 [gemini-3.7-flash] #Stock Memory Map for `FD00–FD3F`
264e6e07 [gemini-3.7-flash] #
264e6e07 [gemini-3.7-flash] #• `FD00–FD0F`: MOS 6551 ACIA (RS-232 / Serial communication registers)
264e6e07 [gemini-3.7-flash] #• `FD10–FD1F`: MOS 6529B SPI (Single Port Interface for the 8-bit User Port)
264e6e07 [gemini-3.7-flash] #• `FD20–FD2F`: Unassigned / Open Bus
264e6e08 [gemini-3.7-flash] #  In the standard Plus/4 hardware, the PLA does not route `$FD20` to any internal motherboard chip.
264e6e08 [gemini-3.7-flash] #Reading from this address returns floating bus values (or ROM/RAM depending on memory
264e6e08 [gemini-3.7-flash] #configuration), and writing has no effect on stock internal hardware.
264e6e08 [gemini-3.7-flash] #
264e6e09 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264e6e09 [gemini-3.7-flash] #
264e6e09 [gemini-3.7-flash] #Common Nearby Registers Often Confused With `$FD20`
264e6e09 [gemini-3.7-flash] #
264e6e0a [gemini-3.7-flash] #If you are looking for a specific hardware function, it may be located at one of these related
264e6e0a [gemini-3.7-flash] #addresses:
264e6e0a [gemini-3.7-flash] #
264e6e0a [gemini-3.7-flash] #1. User Port Data Register (`$FD10`)
264e6e0b [gemini-3.7-flash] #   Controls the 8-bit bidirectional User Port via the MOS 6529B.
264e6e0b [gemini-3.7-flash] #
264e6e0b [gemini-3.7-flash] #2. Function ROM / "3+1" Bank Switching (`FDD0–FDDF`)
264e6e0b [gemini-3.7-flash] #   Reading or writing to this range selects internal/external ROM banks (used by the built-in
264e6e0c [gemini-3.7-flash] #software suite).
264e6e0c [gemini-3.7-flash] #
264e6e0c [gemini-3.7-flash] #3. TED Chip Registers (`FF00–FF1F`)
264e6e0c [gemini-3.7-flash] #   The primary audio, video, timer, and interrupt registers of the MOS 7360/8360 (TED).
264e6e0c [gemini-3.7-flash] #
264e6e0d [gemini-3.7-flash] #4. TED Register Mirrors (`FF20–FF3D`)
264e6e0d [gemini-3.7-flash] #   Addresses above `FF1F` mirror the main TED registers (e.g., `FF20` mirrors `$FF00`, the primary
264e6e0d [gemini-3.7-flash] #horizontal scroll / video mode control).
264e6e0d [gemini-3.7-flash] #
264e6e0e [gemini-3.7-flash] #5. ROM / RAM Mode Switching (`FF3E` and `FF3F`)
264e6e0e [gemini-3.7-flash] #   Writing to `FF3E` enables the ROMs; writing to `FF3F` switches entirely to RAM.
264e6e0e [gemini-3.7-flash] #
