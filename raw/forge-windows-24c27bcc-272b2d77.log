26385f01 [gemini-3.7-flash] #In `machine.ts`, there are a few specific points in the PET I/O handling around `E810`–`E813` and
26385f01 [gemini-3.7-flash] #the keyboard polling pipeline to check:
26385f01 [gemini-3.7-flash] #
26385f01 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26385f01 [gemini-3.7-flash] #
26385f02 [gemini-3.7-flash] #1. Idle Return Value of `readPetMatrix()`
26385f02 [gemini-3.7-flash] #In `readPET`:
26385f02 [gemini-3.7-flash] #
26385f02 [gemini-3.7-flash] #case 0xe812: // "E812": "PIA1_PB"
26385f03 [gemini-3.7-flash] #	traceLog("[PET] PIA1_PB polling keys clearing CB1|CB2");
26385f03 [gemini-3.7-flash] #	mem[0xE813] &= 0x3f;
26385f03 [gemini-3.7-flash] #	return readPetMatrix();
26385f03 [gemini-3.7-flash] #
26385f04 [gemini-3.7-flash] #• The Commodore PET Kernal ROM's `SCNKEY` routine evaluates Port B (`$E812`) using active-low
26385f04 [gemini-3.7-flash] #logic:
26385f04 [gemini-3.7-flash] #  * `0xFF`: No keys pressed on the selected column.
26385f05 [gemini-3.7-flash] #  * Any bit cleared (`0`): Key pressed on that row line.
26385f05 [gemini-3.7-flash] #• If `readPetMatrix()` from `./ffi/terminal.ts` returns `0x00` when no key is held, the ROM
26385f05 [gemini-3.7-flash] #interprets row lines as pressed during the first iteration (Column 0) and immediately terminates
26385f05 [gemini-3.7-flash] #the column scan loop.
26385f06 [gemini-3.7-flash] #
26385f06 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26385f06 [gemini-3.7-flash] #
26385f06 [gemini-3.7-flash] #2. Early Return in `writePET` at `$E810`
26385f07 [gemini-3.7-flash] #In `writePET`:
26385f07 [gemini-3.7-flash] #
26385f07 [gemini-3.7-flash] #case 0xE810:
26385f07 [gemini-3.7-flash] #	let cra = mem[0xe811];
26385f08 [gemini-3.7-flash] #	if (cra & 4) {
26385f08 [gemini-3.7-flash] #		scanKeyboard(value & 15);
26385f08 [gemini-3.7-flash] #		return;
26385f09 [gemini-3.7-flash] #	}
26385f09 [gemini-3.7-flash] #	break;
26385f09 [gemini-3.7-flash] #
26385f09 [gemini-3.7-flash] #• When `cra & 4` is true (directing writes to Port A Output Register / PRA rather than Data
26385f0a [gemini-3.7-flash] #Direction Register A), the function executes `scanKeyboard(...)` and exits early with `return;`.
26385f0a [gemini-3.7-flash] #• Because of the early return, `mem[address] = value;` at the bottom of `writePET` is bypassed. If
26385f0a [gemini-3.7-flash] #the Kernal later reads back `$E810`, it reads stale memory rather than the active column select /
26385f0a [gemini-3.7-flash] #diagnostic output lines.
26385f0a [gemini-3.7-flash] #
26385f0b [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26385f0b [gemini-3.7-flash] #
26385f0b [gemini-3.7-flash] #3. DDR Access Selection (CRA / CRB Bit 2)
26385f0b [gemini-3.7-flash] #In standard 6520 PIA operation:
26385f0c [gemini-3.7-flash] #• When Bit 2 of `CRA` (`E811`) is `0`, reads and writes to `E810` target the Data Direction
26385f0c [gemini-3.7-flash] #Register A (`DDRA`).
26385f0c [gemini-3.7-flash] #• When Bit 2 of `CRA` (`E811`) is `1`, reads and writes to `E810` target the Peripheral
26385f0d [gemini-3.7-flash] #Output/Input Register (`PRA`).
26385f0d [gemini-3.7-flash] #• In `readPET`, reading `$E810` currently returns `0xFF` unconditionally rather than returning
26385f0d [gemini-3.7-flash] #`DDRA` or `PRA` depending on `mem[0xE811] & 4`.
26385f0d [gemini-3.7-flash] #
26385f0e [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26385f0e [gemini-3.7-flash] #
26385f0e [gemini-3.7-flash] #4. Retrace Flag Handling (`$E813`)
26385f0e [gemini-3.7-flash] #In `tick()`:
26385f0f [gemini-3.7-flash] #• Setting Bit 7 of `$E813` during blanking correctly simulates the video sync pulse on the PIA1
26385f0f [gemini-3.7-flash] #`CB1` pin.
26385f0f [gemini-3.7-flash] #• In `readPET(0xE812)`, clearing bits 6 and 7 via `mem[0xE813] &= 0x3f` matches 6520 behavior upon
26385f0f [gemini-3.7-flash] #reading Port B.
