264f49e0 [gemini-3.7-flash] #
264f49e0 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264f49e1 [gemini-3.7-flash] #
264f49e1 [gemini-3.7-flash] #1. The Banking Register Range (`FDD0–FDDF`)
264f49e1 [gemini-3.7-flash] #
264f49e1 [gemini-3.7-flash] #In the Plus/4 architecture, writing to (or reading from) addresses in the range `FDD0–FDDF`
264f49e2 [gemini-3.7-flash] #triggers hardware latches inside the PLA that switch the ROM banks mapped to the
264f49e2 [gemini-3.7-flash] #`8000–BFFF` (and in some configurations `C000–FFFF`) regions.
264f49e2 [gemini-3.7-flash] #
264f49e2 [gemini-3.7-flash] #The 16 addresses in `FDD0–FDDF` are decoded by their lowest 4 bits (`A0–A3`):
264f49e3 [gemini-3.7-flash] #
264f49e3 [gemini-3.7-flash] #• Bits 0–1 (`A0–A1`): Select the Bank Number (`0` to `3`)
264f49e3 [gemini-3.7-flash] #• Bits 2–3 (`A2–A3`): Select the ROM Socket / Location:
264f49e3 [gemini-3.7-flash] #  * `00` = BASIC / KERNAL (Standard system ROMs)
264f49e4 [gemini-3.7-flash] #  * `01` = Internal Function ROM High/Low (The built-in "3+1" software: Word Processor,
264f49e4 [gemini-3.7-flash] #Spreadsheet, etc.)
264f49e4 [gemini-3.7-flash] #  * `10` = External Cartridge ROM (Low / High) (Expansion port)
264f49e5 [gemini-3.7-flash] #  * `11` = Extended Function ROM / Cartridge Bank 3
264f49e5 [gemini-3.7-flash] #
264f49e5 [gemini-3.7-flash] #The Addresses in Your Trace
264f49e5 [gemini-3.7-flash] #Your trace shows the table lookups at `$FC7B` mapping directly to the following addresses:
264f49e6 [gemini-3.7-flash] #
264f49e6 [gemini-3.7-flash] #╭──────────────────┬───────────────────────────┬──────────────────┬─────────────────────────────────────────────╮
264f49e6 [gemini-3.7-flash] #│  Index in `$96`  │  Offset Byte (`$FC7B,X`)  │  Target Address  │  Function Selected                          │
264f49e6 [gemini-3.7-flash] #├──────────────────┼───────────────────────────┼──────────────────┼─────────────────────────────────────────────┤
264f49e7 [gemini-3.7-flash] #│  :---:           │  :---:                    │  :---:           │  :---                                       │
264f49e7 [gemini-3.7-flash] #│  **3**           │  `$0F`                    │  **`$FDDF`**     │  Bank 3 (External / Expansion Cartridge 2)  │
264f49e7 [gemini-3.7-flash] #│  **2**           │  `$0A`                    │  **`$FDDA`**     │  Bank 2 (External / Expansion Cartridge 1)  │
264f49e7 [gemini-3.7-flash] #│  **1**           │  `$05`                    │  **`$FDD5`**     │  Bank 1 (Internal "3+1" Function ROM)       │
264f49e8 [gemini-3.7-flash] #│  **0**           │  `$00`                    │  **`$FDD0`**     │  Bank 0 (System BASIC / KERNAL)             │
264f49e8 [gemini-3.7-flash] #╰──────────────────┴───────────────────────────┴──────────────────┴─────────────────────────────────────────────╯
264f49e8 [gemini-3.7-flash] #
