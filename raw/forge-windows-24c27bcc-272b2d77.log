263f0ee8 [glm-5.3] #Apple II Plus Reset and Stack Setup
263f0ee8 [glm-5.3] #
263f0ee9 [glm-5.3] #You're correct — the soft-entry vectors don't set the stack. Here's how it works:
263f0ee9 [glm-5.3] #
263f0ee9 [glm-5.3] #Reset flow on the Apple II Plus
263f0ee9 [glm-5.3] #
263f0eea [glm-5.3] #
263f0eea [glm-5.3] #6502 RESET
263f0eea [glm-5.3] #  → reads $FFFC/$FFFD → $FF59 (Monitor ROM)
263f0eea [glm-5.3] #      → LDX #$FF / TXS          ← stack IS set here
263f0eea [glm-5.3] #      → checks $3F4 (power-up byte vs $A5 xor hi-byte of $3F2)
263f0eea [glm-5.3] #      → if match: JMP ($3F2)    ← soft reset vector (often $3D0 or $E000)
263f0eeb [glm-5.3] #      → if no match: cold start (RAM check, screen init, etc.)
263f0eeb [glm-5.3] #
263f0eeb [glm-5.3] #
263f0eec [glm-5.3] #What doesn't set the stack
263f0eec [glm-5.3] #
263f0eec [glm-5.3] #If you're entering at any of these, the stack is not initialised:
263f0eec [glm-5.3] #
263f0eed [glm-5.3] #- `3F2/3F3` — the soft reset vector itself (just an address)
263f0eed [glm-5.3] #- `$3D0` — DOS warm start
263f0eed [glm-5.3] #- `$E000` — Applesoft BASIC cold entry
263f0eed [glm-5.3] #- `00` / `01` — alternate Applesoft entries
263f0eed [glm-5.3] #
263f0eed [glm-5.3] #What to use instead
263f0eee [glm-5.3] #
263f0eee [glm-5.3] #╭───────────────────┬──────────────┬─────────────────────────────────────────╮
263f0eee [glm-5.3] #│  Entry point      │  Sets stack  │  Notes                                  │
263f0eee [glm-5.3] #├───────────────────┼──────────────┼─────────────────────────────────────────┤
263f0eef [glm-5.3] #│  **$FF59**        │  ✅           │  Monitor ROM reset — proper soft reset  │
263f0eef [glm-5.3] #│  **$FFFC/$FFFD**  │  ✅           │  Trigger actual 6502 RESET line         │
263f0eef [glm-5.3] #│  $FAA6            │  ✅           │  Monitor cold-ish entry (also sets SP)  │
263f0ef0 [glm-5.3] #╰───────────────────┴──────────────┴─────────────────────────────────────────╯
263f0ef0 [glm-5.3] #
263f0ef0 [glm-5.3] #Recommendation
263f0ef0 [glm-5.3] #
263f0ef0 [glm-5.3] #If you're emulating or calling a reset programmatically:
263f0ef0 [glm-5.3] #
263f0ef0 [glm-5.3] #
263f0ef1 [glm-5.3] #; Either trigger hardware reset via the vector at $FFFC
263f0ef1 [glm-5.3] #; or jump to the monitor entry:
263f0ef1 [glm-5.3] #
263f0ef1 [glm-5.3] #JMP $FF59        ; soft reset, sets SP=$FF
263f0ef1 [glm-5.3] #
263f0ef2 [glm-5.3] #
263f0ef2 [glm-5.3] #If you're using an emulator API, look for a `reset()` or `coldReset()` method that goes through the
263f0ef2 [glm-5.3] #`FFFC` vector rather than jumping to `3F2` directly.
263f0ef2 [glm-5.3] #
263f0ef2 [glm-5.3] #Does this match what you're seeing, or are you working with a specific emulator/library where the
263f0ef3 [glm-5.3] #behaviour differs?
263f0ef3 [glm-5.3] #
