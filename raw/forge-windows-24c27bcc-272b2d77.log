25b9f5f2 [deepseek-v4-flash] #🟠nitrologic Relay 2.0.1 deepseek-v4-flash 🐋 🪠 0.7° $0.000 575B 12.26s
25b9f5f3 [deepseek-v4-flash] #Z80 Addressing Modes
25b9f5f3 [deepseek-v4-flash] #
25b9f5f3 [deepseek-v4-flash] #The Zilog Z80 supports ten addressing modes, as documented in the official Z80 CPU User Manual.
25b9f5f3 [deepseek-v4-flash] #
25b9f5f3 [deepseek-v4-flash] #1. Immediate
25b9f5f3 [deepseek-v4-flash] #An 8-bit constant follows the opcode.
25b9f5f4 [deepseek-v4-flash] #
25b9f5f4 [deepseek-v4-flash] #
25b9f5f4 [deepseek-v4-flash] #LD A, n        ; load constant n into accumulator
25b9f5f4 [deepseek-v4-flash] #LD B, 3Ch
25b9f5f4 [deepseek-v4-flash] #
25b9f5f5 [deepseek-v4-flash] #
25b9f5f5 [deepseek-v4-flash] #2. Immediate Extended
25b9f5f5 [deepseek-v4-flash] #A 16-bit constant follows the opcode (low byte first).
25b9f5f5 [deepseek-v4-flash] #
25b9f5f6 [deepseek-v4-flash] #
25b9f5f6 [deepseek-v4-flash] #LD BC, nn      ; load 16-bit constant into BC
25b9f5f6 [deepseek-v4-flash] #LD HL, 1234h
25b9f5f7 [deepseek-v4-flash] #
25b9f5f7 [deepseek-v4-flash] #
25b9f5f7 [deepseek-v4-flash] #3. Modified Page Zero
25b9f5f7 [deepseek-v4-flash] #Used only by the `RST` instruction, which calls a fixed address in the first 256 bytes of memory
25b9f5f8 [deepseek-v4-flash] #(00h, 08h, 10h, … 38h).
25b9f5f8 [deepseek-v4-flash] #
25b9f5f8 [deepseek-v4-flash] #
25b9f5f8 [deepseek-v4-flash] #RST 10h        ; call address 0010h
25b9f5f9 [deepseek-v4-flash] #
25b9f5f9 [deepseek-v4-flash] #
25b9f5f9 [deepseek-v4-flash] #4. Relative
25b9f5f9 [deepseek-v4-flash] #An 8-bit signed displacement (addressed from the next instruction) is added to the PC. Used by
25b9f5fa [deepseek-v4-flash] #`JR`.
25b9f5fa [deepseek-v4-flash] #
25b9f5fa [deepseek-v4-flash] #
