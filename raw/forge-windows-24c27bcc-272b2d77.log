253c3b7b [claude-haiku-4-5] #opcode: "AND",
253c3b7b [claude-haiku-4-5] #spec: 15,
253c3b7b [claude-haiku-4-5] #codes: "29 25 35 2D 3D 39 21 31",
253c3b7b [claude-haiku-4-5] #code: { mode: 1, ref8: 16 }
253c3b7c [claude-haiku-4-5] #
253c3b7c [claude-haiku-4-5] #
