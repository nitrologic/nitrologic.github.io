264f51fd [gemini-3.7-flash] #Yes, but with one important distinction regarding Bank 0:
264f51fe [gemini-3.7-flash] #
264f51fe [gemini-3.7-flash] #1. Banks 1, 2, and 3 (Cartridges & 3+1 ROM)
264f51fe [gemini-3.7-flash] #You can safely treat these as open bus (or return unmapped/empty memory):
264f51fe [gemini-3.7-flash] #• If `8007–8009` does not return `"CBM"`, the KERNAL simply skips the bank and moves to the next.
264f51ff [gemini-3.7-flash] #• This accurately simulates a machine without the "3+1" software ROMs or external cartridges
264f51ff [gemini-3.7-flash] #installed.
264f51ff [gemini-3.7-flash] #
264f51ff [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264f5200 [gemini-3.7-flash] #
264f5200 [gemini-3.7-flash] #2. Bank 0 (BASIC ROM)
264f5200 [gemini-3.7-flash] #You must map the standard BASIC ROM to `8000–BFFF` for Bank 0:
264f5200 [gemini-3.7-flash] #• The BASIC V3.5 interpreter code resides in the `8000–BFFF` address space.
264f5201 [gemini-3.7-flash] #• Once the cartridge scan finishes at Bank 0 (`FDD0`), the KERNAL transitions to initializing
264f5201 [gemini-3.7-flash] #BASIC. If `8000–$BFFF` is open bus at that point, the CPU will execute invalid opcodes and crash.
264f5201 [gemini-3.7-flash] #• The standard BASIC ROM does not have the `"CBM"` signature at `8007–8009`, so the header check
264f5202 [gemini-3.7-flash] #will naturally fail and boot will proceed normally into the BASIC prompt.
264f5202 [gemini-3.7-flash] #
264f5202 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
264f5202 [gemini-3.7-flash] #
264f5203 [gemini-3.7-flash] #Minimal Implementation Summary
264f5203 [gemini-3.7-flash] #• Banks 1–3 (`FDD5`, `FDDA`, `$FDDF`): Map to empty/open bus (signature check fails).
264f5203 [gemini-3.7-flash] #• Bank 0 (`FDD0`): Map to the standard BASIC ROM image at `8000–$BFFF`.
264f5203 [gemini-3.7-flash] #
