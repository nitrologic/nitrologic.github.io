2702a8e6 [glm-5.3-flash] #	return (gpio_get_all() >> KEY0_PIN) & 0xF;
2702a8e7 [glm-5.3-flash] #}
2702a8e7 [glm-5.3-flash] #
2702a8e7 [glm-5.3-flash] #
2702a8e8 [glm-5.3-flash] #If the pins aren't contiguous, one read plus a gather is still atomic:
