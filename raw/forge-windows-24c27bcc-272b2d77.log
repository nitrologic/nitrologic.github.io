262b8286 [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.008 34.05KB 5.09s
262b8286 [gemini-3.7-flash] #Here is an annotated walkthrough of this stage of the boot sequence:
262b8286 [gemini-3.7-flash] #
262b8287 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b8287 [gemini-3.7-flash] #
262b8287 [gemini-3.7-flash] #1. Screen Editor Initialization (`E269–E604`)
262b8287 [gemini-3.7-flash] #This routine sets up the logical line pointers and screen geometry:
262b8288 [gemini-3.7-flash] #• `E269–E26D`: Sets the cursor row (`F5`) and column (`E2`) to `0` (top-left home position).
262b8288 [gemini-3.7-flash] #• `E5DB–E604`: Calculates the base address for row 0:
262b8288 [gemini-3.7-flash] #  * Reads the high-byte base address from `0229` (`80`) and stores the screen base pointer in Zero
262b8288 [gemini-3.7-flash] #Page (`E0/E1` \rightarrow `$8000`, the start of PET video RAM).
262b8289 [gemini-3.7-flash] #  * Sets the line length limit in `F2` to `27` (39 + 1 = 40 characters per line).
262b8289 [gemini-3.7-flash] #  * Verifies cursor bounds (`$E2` < 40) and returns.
262b8289 [gemini-3.7-flash] #
262b8289 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b828a [gemini-3.7-flash] #
262b828a [gemini-3.7-flash] #2. Diagnostic / Machine Sense Check (`FD3F–FD45`)
262b828a [gemini-3.7-flash] #
262b828a [gemini-3.7-flash] #FD3F: LDA $E810       ; Read PIA1_PA
262b828b [gemini-3.7-flash] #FD42: BPL $FD44       ; Diagnostic pin test (Bit 7)
262b828b [gemini-3.7-flash] #FD44: CLI             ; Enable IRQ processing
262b828b [gemini-3.7-flash] #FD45: JMP $E0D2       ; Jump to BASIC cold start
262b828b [gemini-3.7-flash] #
262b828c [gemini-3.7-flash] #• Bit 7 Sense (`FD3F`): Reads `PIA1_PA`. On real hardware, pin 7 connects to the diagnostic
262b828c [gemini-3.7-flash] #line on the user port / cassette. If grounded (`0`), the PET boots directly into diagnostic monitor
262b828c [gemini-3.7-flash] #ROM; since it returned `FF` (bit 7 = 1), it proceeds to normal initialization.
262b828d [gemini-3.7-flash] #• Enable Interrupts (`$FD44`): `CLI` unmasks IRQs, allowing the 60 Hz timer interrupts to
262b828d [gemini-3.7-flash] #begin firing.
262b828d [gemini-3.7-flash] #• Hand-off to BASIC (`FD45`): Jumps to `E0D2` to start the Microsoft BASIC cold
262b828d [gemini-3.7-flash] #initialization.
262b828e [gemini-3.7-flash] #
262b828e [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b828e [gemini-3.7-flash] #
262b828e [gemini-3.7-flash] #3. BASIC Cold Start & Zero-Page Initialization (`E0D2–E0ED`)
262b828f [gemini-3.7-flash] #
262b828f [gemini-3.7-flash] #E0D2: LDX #$FF
262b828f [gemini-3.7-flash] #E0D4: STX $89         ; Initialize BASIC status/control flag
262b828f [gemini-3.7-flash] #E0D6: TXS             ; Initialize Stack Pointer to $01FF
262b8290 [gemini-3.7-flash] #E0D7: LDA #$4C        ; Opcode for 'JMP'
262b8290 [gemini-3.7-flash] #E0D9: STA $A3         ; Set up USR() jump instruction
262b8290 [gemini-3.7-flash] #E0DB: STA $00         ; Set up Zero-Page jump vector ($00 = $4C)
262b8290 [gemini-3.7-flash] #E0DD: LDA #$30        ;
262b8291 [gemini-3.7-flash] #E0DF: LDY #$D1        ; Address $D130 (error handling / float entry)
262b8291 [gemini-3.7-flash] #E0E1: STA $01         ; Low byte -> $01
262b8291 [gemini-3.7-flash] #E0E3: STY $02         ; High byte -> $02 (Forms 'JMP $D130' at $0000)
262b8291 [gemini-3.7-flash] #
262b8292 [gemini-3.7-flash] #• Zero-Page USR/Dispatch Jumps: BASIC puts a 3-byte `JMP xxxx` instruction directly into
262b8292 [gemini-3.7-flash] #`0000–$0002` to accelerate frequent internal dispatch calls.
262b8292 [gemini-3.7-flash] #
262b8292 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b8293 [gemini-3.7-flash] #
262b8293 [gemini-3.7-flash] #4. Zero-Page Vector Copy Loop (`E0E5–E0ED`)
262b8293 [gemini-3.7-flash] #
262b8293 [gemini-3.7-flash] #E0E5: LDX #$1C        ; Set up 28-byte loop counter
262b8294 [gemini-3.7-flash] #E0E7: LDA $E0B4,X     ; Read ROM default vector table
262b8294 [gemini-3.7-flash] #E0EA: STA $C1,X       ; Copy into Zero Page ($C1–$DD)
262b8294 [gemini-3.7-flash] #E0EC: DEX             ;
262b8294 [gemini-3.7-flash] #E0ED: BNE $E0E7       ; Loop until entire table is copied
262b8295 [gemini-3.7-flash] #
262b8295 [gemini-3.7-flash] #• Copies the default BASIC zero-page vectors and constants (function entry points, memory limit
262b8295 [gemini-3.7-flash] #pointers, and floating-point constants) from ROM into Zero Page RAM.
262b8295 [gemini-3.7-flash] #
262b8296 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262b8296 [gemini-3.7-flash] #
262b8296 [gemini-3.7-flash] #Summary
262b8296 [gemini-3.7-flash] #The system has completed hardware verification and screen memory configuration, unmasked CPU
262b8297 [gemini-3.7-flash] #interrupts (`CLI`), and is now initializing Microsoft BASIC's workspace and zero-page jump tables.
262b8297 [gemini-3.7-flash] #Next, it will size system RAM and print the startup banner.
262b8297 [gemini-3.7-flash] #
