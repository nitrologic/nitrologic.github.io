25191233 [claude-haiku-4-5] #	// ...
25191233 [claude-haiku-4-5] #	mem[address] = value;  // ← Always writes to unified memory array
25191234 [claude-haiku-4-5] #}
25191234 [claude-haiku-4-5] #
25191234 [claude-haiku-4-5] #
25191235 [claude-haiku-4-5] #This works if your memory model keeps both ROM and RAM in the same `Uint8Array`. But if
25191235 [claude-haiku-4-5] #you're reading ROM on reads and need to write RAM on writes, you need explicit routing.
25191235 [claude-haiku-4-5] #
25191235 [claude-haiku-4-5] #Solution
