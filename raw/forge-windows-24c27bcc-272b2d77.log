26225343 [gemini-3.7-flash] #
26225343 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
26225343 [gemini-3.7-flash] #
26225343 [gemini-3.7-flash] #How the Hardware Reads It
26225344 [gemini-3.7-flash] #
26225344 [gemini-3.7-flash] #1. Row Selection: The kernel writes a 4-bit row index (0–9) to `$E812` (PIA 1, Port B,
26225344 [gemini-3.7-flash] #bits 0–3). This feeds a 74145 BCD-to-decimal decoder, which pulls the selected matrix row low.
26225344 [gemini-3.7-flash] #2. Column Sensing: The kernel reads `$E810` to see which keys in that row are
26225345 [gemini-3.7-flash] #pressed.
26225345 [gemini-3.7-flash] #3. Logic Levels:
26225345 [gemini-3.7-flash] #   * `1` (High): Key is not pressed (held high by pull-up resistors).
26225345 [gemini-3.7-flash] #   * `0` (Low): Key is pressed (pulled to ground through the selected row).
26225346 [gemini-3.7-flash] #
26225346 [gemini-3.7-flash] #If no keys are pressed on the keyboard, reading `E810` should return `FF`.
26225346 [gemini-3.7-flash] #
