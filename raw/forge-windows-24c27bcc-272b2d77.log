\tcase 0x81: // STA (Indirect, X)\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get8(pc + 1);\r\n\t\t\t\t\tconst pointer = (base + this.registers[register.X]) & 0xFF;\r\n\t\t\t\t\tconst addrLow = this.memory[pointer];\r\n\t\t\t\t\tconst addrHigh = this.memory[(pointer + 1) & 0xFF];\r\n\t\t\t\t\tconst address = (addrHigh << 8) | addrLow;\r\n\t\t\t\t\tthis.writeAddress(address, this.registers[register.A]);\r\n\t\t\t\t\tthis.step(2);\r\n\t\t\t\t\treturn \"STA\\t($\"+hex(base)+\",X)\";\r\n\t\t\t\t}\r\n// appleII brick out\r\n\t\t\tcase 0xEA:\t// NOP\r\n\t\t\t\t{\r\n\t\t\t\t\tthis.step(1);\r\n\t\t\t\t\treturn \"NOP\";\r\n\t\t\t\t}\r\n// appleII sabotage\r\n\t\t\tcase 0xBC: // LDY Absolute, X\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get16(pc + 1);\r\n\t\t\t\t\tconst target = this.targetAbsoluteX(base); // handles page boundary penalty\r\n\t\t\t\t\tconst value = this.readAddress(target);\r\n\t\t\t\t\tthis.registers[register.Y] = value;\r\n\t\t\t\t\tthis.setStatus(value);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"LDY\\t$\"+hex(base,4)+\",X\";\r\n\t\t\t\t}\r\n\t\t\tcase 0x31: // AND (Indirect), Y\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get8(pc + 1);\r\n\t\t\t\t\tconst value = this.readIndirectY(base);\r\n\t\t\t\t\tthis.registers[register.A] &= value;\r\n\t\t\t\t\tthis.setStatus(this.registers[register.A]);\r\n\t\t\t\t\tthis.step(2);\r\n\t\t\t\t\treturn \"AND\\t($\"+hex(base)+\"),Y\";\r\n\t\t\t\t}\r\n\t\t\tcase 0xEC: // CPX Absolute\r\n\t\t\t\t{\r\n\t\t\t\t\tconst address = this.get16(pc + 1);\r\n\t\t\t\t\tconst value = this.readAddress(address);\r\n\t\t\t\t\tconst x = this.registers[register.X];\r\n\t\t\t\t\tconst result = x - value;\r\n\t\t\t\t\tthis.setCarry(x >= value);\r\n\t\t\t\t\tthis.setStatus(result & 0xFF);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"CPX\\t$\"+hex(address,4);\r\n\t\t\t\t}\r\n\t\t\tcase 0xED: // SBC Absolute\r\n\t\t\t\t{\r\n\t\t\t\t\tconst address = this.get16(pc + 1);\r\n\t\t\t\t\tconst value = this.readAddress(address);\r\n\t\t\t\t\tthis.sbc(value);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"SBC\\t$\"+hex(address,4);\r\n\t\t\t\t}\r\n\t\t\tcase 0x6D: // ADC Absolute\r\n\t\t\t\t{\r\n\t\t\t\t\tconst address = this.get16(pc + 1);\r\n\t\t\t\t\tconst value = this.readAddress(address);\r\n\t\t\t\t\tthis.adc(value);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"ADC\\t$\"+hex(address,4);\r\n\t\t\t\t}\r\n\t\t\tcase 0xDE: // DEC Absolute, X\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get16(pc + 1);\r\n\t\t\t\t\tconst target = this.targetAbsoluteX(base);\r\n\t\t\t\t\tconst value = (this.readAddress(target) - 1) & 0xFF;\r\n\t\t\t\t\tthis.writeAddress(target, value);\r\n\t\t\t\t\tthis.setStatus(value);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"DEC\\t$\"+hex(base,4)+\",X\";\r\n\t\t\t\t}\r\n// elite\r\n\t\t\tcase 0x3D: // ORA Absolute, X\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get16(pc + 1);\r\n\t\t\t\t\tconst value = this.readAbsoluteX(base);\r\n\t\t\t\t\tthis.registers[register.A] |= value;\r\n\t\t\t\t\tthis.setStatus(this.registers[register.A]);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"ORA\\t$\"+hex(base,4)+\",X\";\r\n\t\t\t\t}\r\n\t\t\tcase 0x39: // AND Absolute, Y\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get16(pc + 1);\r\n\t\t\t\t\tconst value = this.readAbsoluteY(base);\r\n\t\t\t\t\tthis.registers[register.A] &= value;\r\n\t\t\t\t\tthis.setStatus(this.registers[register.A]);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"AND\\t$\"+hex(base,4)+\",Y\";\r\n\t\t\t\t}\r\n\t\t\tcase 0xAF: // LDA (Indirect), X\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base = this.get8(pc + 1);\r\n\t\t\t\t\tconst pointer = (base + this.registers[register.X]) & 0xFF;\r\n\t\t\t\t\tconst addrLow = this.memory[pointer];\r\n\t\t\t\t\tconst addrHigh = this.memory[(pointer + 1) & 0xFF];\r\n\t\t\t\t\tconst address = (addrHigh << 8) | addrLow;\r\n\t\t\t\t\tconst value = this.readAddress(address);\r\n\t\t\t\t\tthis.registers[register.A] = value;\r\n\t\t\t\t\tthis.setStatus(value);\r\n\t\t\t\t\tthis.step(2);\r\n\t\t\t\t\treturn \"LDA\\t($\"+hex(base)+\",X)\";\r\n\t\t\t\t}\r\n// C64:\r\n\t\t\tcase 0x78: // SEI\r\n\t\t\t\t{\r\n\t\t\t\t\tthis.registers[register.ST]|=IFLAG;\r\n\t\t\t\t\tthis.step(1);\r\n\t\t\t\t\treturn \"SEI\\t\";\r\n\t\t\t\t}\r\n// plus/4\r\n\t\t\tcase 0xcc: // CPY absolute\r\n\t\t\t\t{\r\n\t\t\t\t\tconst address = this.get16(pc + 1);\r\n\t\t\t\t\tconst value = this.readAddress(address);\r\n\t\t\t\t\tconst y = this.registers[register.Y];\r\n\t\t\t\t\tconst result = y - value;\r\n\t\t\t\t\tthis.setCarry(y >= value);\r\n\t\t\t\t\tthis.setStatus(result & 0xFF);\r\n\t\t\t\t\tthis.step(3);\r\n\t\t\t\t\treturn \"CPY\\t$\"+hex(address,4);\r\n\t\t\t\t}\r\n// integer brickout\r\n\t\t\tcase 0x15:// ORA Zero Page, X\r\n\t\t\t\t{\r\n\t\t\t\t\tlet base=this.get8(pc+1);\r\n\t\t\t\t\tlet target=(base + this.registers[register.X]) & 0xFF; // Wrap to Zero Page\r\n\t\t\t\t\tlet value=this.memory[target];\r\n\t\t\t\t\tthis.registers[register.A]|=value;\r\n\t\t\t\t\tthis.setStatus(this.registers[register.A]); // Update Z and N flags\r\n\t\t\t\t\tthis.step(2);\r\n\t\t\t\t\treturn \"ORA\\t\"+hex(base)+\",X\";\r\n\t\t\t\t}\r\n\t\t\tcase 0x35: // AND Zero Page, X\r\n\t\t\t\t{\r\n\t\t\t\t\tconst base=this.get8(pc+1);\r\n\t\t\t\t\tconst target=(base+this.registers[register.X])&0xFF; // Wrap to Zero Page\r\n\t\t\t\t\tconst value=this.memory[target];\r\n\t\t\t\t\tthis.registers[register.A]&=value;\r\n\t\t\t\t\tthis.setStatus(this.registers[register.A]); // Update Z and N flags\r\n\t\t\t\t\tthis.step(2);\r\n\t\t\t\t\treturn \"AND\\t\"+hex(base)+\",X\";\r\n\t\t\t\t}\r\n\t\t}\r\n\t\treturn this.fail(\"unsupported opcode \"+opcode+\" ($\"+hex(opcode)+\")\");\r\n\t}\r\n}\r\n\r\nconst encoder=new TextEncoder();\r\n\r\nfunction writeConsole(text:string){\r\n\tDeno.stdout.write(encoder.encode(text));\r\n}\r\nconst breakPoints:Array<number>=[];\t//0xC474 0xfd3b 0xff9f 0xe39d 0xfcfe 0xff6e 0x4049 0xf457 0xf181 0xd412 0xeed3 0xFCB3 0xFe93 0xFEA7 0x7D08 0x7b71 0x7ADB 0x3824 0x2577 0x28e4 0x3b65\r\n\r\n// main entry point of machine.ts\r\n\r\nawait runTerminal(true);\r\n//runInput(true);\r\n\r\nconst trace=[];\r\n\r\nfunction dumpTrace2(){\r\n\tlet count=150;\r\n\twhile(trace.length&&(count--)){\r\n\t\tconst line=trace.pop();\r\n\t\tconsole.log(line);\r\n\t}\r\n}\r\n\r\nfunction dumpTrace(){\r\n\tfor(let i=0;i<trace.length;i++){\r\n\t\tconst line=trace[i];\r\n\t\tconsole.log(line);\r\n\t}\r\n}\r\n\r\nfunction traceLog(...args:any[]){\r\n\tconst lines=[];\r\n\tfor(const arg of args){\r\n\t\tconst line=arg?.toString();\r\n\t\tlines.push(line);\r\n\t}\r\n\tconst text=lines.join(\" \");\r\n\tconsole.log(text+cursorUp);\r\n\ttrace.push(text);\r\n}\r\n\r\nfunction runMachine(){\r\n\tstepping=true;\r\n//\twriteConsole(cursorHide+cursorClear+machineTitle+\"*\");\r\n\tif(!is1541){\r\n\t\twriteConsole(cursorHide+machineTitle+\"*\");\t//cursorHome+\r\n\t}\r\n}\r\n\r\nfunction haltMachine(){\r\n\tstepping=false;\r\n\tif(!is1541){\r\n\t\tconsole.log(cursorShow);\r\n\t}\r\n}\r\n\r\nfunction resetMachine(){\r\n\tgame.interrupt(Request.Reset,\"Cold Reset\")\r\n//\tgame.interrupt(Request.NMI,\"Warm Reset\")\r\n}\r\n\r\nfunction pasteMachine(paste:string){\r\n\tconst text=paste.toUpperCase();\r\n\tconst n=text.length;\r\n\tfor(let i=0;i<n;i++){\r\n\t\tconst keyCode=text.charCodeAt(i);\r\n\t\tgame.pushKey(keyCode);\r\n\t}\r\n}\r\n\r\nif(isApple){\r\n//\tawait readCassetteFile(\"apple/lemonade.zip\", game.tape);\r\n//\tawait readCassetteFile(\"apple/littlebrickout.zip\", game.tape);\r\n//\tawait readCassetteWav(\"test.wav\", game.tape);\r\n//\tawait readCassetteWav(\"littlebrickout.wav\", game.tape);\r\n//\tgame.burn(appleSabotage.binary);//call 7424\r\n//\tgame.burn(applePennyArcade.binary);\r\n//\tgame.writeAddress(175,32);\r\n//\tgame.writeAddress(176,19);\r\n//\tgame.burn(appleElite.binary);\r\n\tif(stepping)runMachine();\r\n}\r\n\r\n// 3000 lines later we end machine class\r\n\r\nconst game:Machine=new Machine();\r\ngame.burn(machineSpec.binary);\r\nconsole.log(machineSpec.title,machineSpec.version,machineSpec.copyright);\r\n\r\nconst system=machineSpec.system;\r\nif(system){\r\n\tconsole.log(system.title,system.copyright);\r\n}\r\n\r\nfunction onInput(bytes:Uint8Array){\r\n\tconst n=bytes.length;\r\n\tif(n==0) return;\r\n\tlet i=0;\r\n\tif(stepping){\r\n//\t\tif(n==2) stepping=false;\r\n\t\twhile(i<n){\r\n\t\t\tconst key=bytes[i++];\r\n\t\t\tswitch(key){\r\n\t\t\t\tcase 27:\r\n\t\t\t\t\tif(i==n){\r\n\t\t\t\t\t\tgame.pushKey(27);\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tlet o=bytes.indexOf(126,i);\r\n\t\t\t\t\t\tif(o==-1){\r\n\t\t\t\t\t\t\to=bytes.indexOf(77,i);\r\n\t\t\t\t\t\t\tif(o==-1){\r\n\t\t\t\t\t\t\t\to=bytes.indexOf(109,i);\r\n\t\t\t\t\t\t\t\tif(o==-1){\r\n\t\t\t\t\t\t\t\t\t// todo: 3 byte cursor keys like 29,91,66 pass here\r\n//\t\t\t\t\t\t\t\t\tconsole.log(\"terminator 126 nor 77 nor 109 found n:\",bytes.length,\"bytes:\",bytes);\r\n//\t\t\t\t\t\t\t\t\tconsole.log(\"[TERMERR]\",bytes);\r\n\t\t\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tswitch(bytes.subarray(i-1,o+1).join(\",\")){\r\n\t\t\t\t\t\t\tcase \"27,91,50,52,126\":\r\n\t\t\t\t\t\t\t\tconst pos=cursorPos(3,28);\r\n\t\t\t\t\t\t\t\tconsole.log(pos+\"F12 detected halting machine\");\r\n\t\t\t\t\t\t\t\thaltMachine();\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase \"27,91,50,52,59,53,126\":\r\n\t\t\t\t\t\t\t\tconsole.log(\"F12 detected resetting machine\");\r\n\t\t\t\t\t\t\t\tresetMachine();\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase \"27,91,50,49,126\":\r\n\t\t\t\t\t\t\t\tconsole.log(cursorClear);\r\n\t\t\t\t\t\t\t\tconsole.log(\"F10 detected clearing screen\");\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\ti=o+1;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 127:\r\n\t\t\t\t\tgame.pushKey(8);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 10:\r\n\t\t\t\t\tconsole.log(\"CHR 10 detected\");\r\n\t\t\t\t\thaltMachine();\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tgame.pushKey(key);\r\n\t\t\t}\r\n\t\t}\r\n\t}else{\r\n\t\tconst key=bytes[0];\r\n\t\tswitch(key){\r\n\t\t\tcase 27: //ESC\r\n\t\t\t\tif(n==1) {\r\n\t\t\t\t\tconsole.log(\"plain escape\");\r\n\t\t\t\t\trunning=false;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tswitch(bytes.join(\",\")){\r\n\t\t\t\t\t\tcase \"27,91,50,52,126\":\r\n\t\t\t\t\t\t\trunMachine();\r\n\t\t\t\t\t\t\tconsole.log(\"F12 detected running machine\");\r\n\t\t\t\t\t\t\tgame.dirty=true;\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 100: //D\r\n\t\t\tcase 68: //d\r\n\t\t\t\tif(isApple) game.dumpMemory(0x400,30,32);\r\n\t\t\t\tif(isC64) {\r\n\t\t\t\t\tgame.dumpMemory(0xd800,40,24);\r\n//\t\t\t\t\tdisplayC64(game.memory,0,0);\r\n\t\t\t\t\t//6,2,0xc00,0x800,40,24);\t\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t\tif(isTed){\r\n\t\t\t\t\tgame.dumpMemory(0xc00,40,25);\r\n\t\t\t\t\tgame.dumpMemory(0x800,40,25);\r\n//\t\t\t\t\tdisplayPlus4(game.memory,0,0);\r\n//\t\t\t\t\tgame.dumpMemory(0xc00,40,24);\r\n\t\t\t\t}\r\n\t\t\t\tif(isVIC) {\r\n//\t\t\t\t\tgame.dumpMemory(0x1e00,23,22);\r\n//\t\t\t\t\tgame.dumpMemory(0x1000,23,22);\r\n\t\t\t\t\tgame.dumpMemory(0x9400,23,22);\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 82: // R\r\n\t\t\t\tgame.softReset(0xe000);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 49: // 1\r\n\t\t\t\tgame.burn(appleSabotage.binary);//call 7424\r\n\t\t\t\tconsole.log(\"1 loaded sabotage, call 7424 to run\");\r\n//\t\t\t\trunMachine();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 114: //r\r\n//\t\t\t\trunMachine();\r\n//\t\t\t\tif(stepping) haltMachine(); else runMachine();\r\n//\t\t\t\tstepping=!stepping;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 115: //S\r\n\t\t\t\tstep=true;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 116: //T\r\n\t\t\t\tdumpTrace();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 67: //C\r\n\t\t\t\tgame.tape.clear();\r\n\t\t\t\tconsole.log(\"[TAPE] rewound\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase 99: //c\r\n\t\t\t\tgame.tape.diagnostics();\r\n\t\t\t\tgame.saveFile=true;\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tconsole.log(\"bytes:\",bytes.length,\"key:\",key);\r\n\t\t}\r\n\t}\r\n}\r\n\r\nlet appWidth=0;\r\nlet appHeight=0;\r\n\r\nfunction pollSize(){\r\n\tconst { columns, rows } = Deno.consoleSize();\r\n\tconst vidWidth=columns-6;\r\n\tconst vidHeight=rows-6;\r\n\tif(vidWidth!=appWidth||vidHeight!=appHeight){\r\n\t\tappWidth=vidWidth;\r\n\t\tappHeight=vidHeight;\r\n//\t\tconsole.log(cursorClear+machineTitle,[appWidth,appHeight]);\r\n\t}\r\n}\r\n\r\nasync function processInput(){\r\n\tconst keypad=await pollKeypad()\r\n\r\n\tconst oldBits=hitBits;\r\n\tconst bits=keypad.hitBits;\r\n//\tif((keys&16)&&!(oldBits&16)) hitSpace();\r\n//\tif((keys&32)&&!(oldBits&32)) hitBackspace();\r\n//\tif((bits&64)&&!(oldBits&64)) stopRunning();\r\n\tif(bits&~oldBits) hitCount++;\r\n\thitBits=bits;\r\n\tmouseX=keypad.mousePosition[0];\r\n\tmouseY=keypad.mousePosition[1];\r\n\taxisY=keypad.axisPump[0];\r\n\taxisX=keypad.axisPump[1];\r\n\tconst input=keypad.inputQueue;\r\n//\tconst input=await pollTerminal()\r\n\tif(input===null){\r\n\t\tconsole.log(\"null input\");\r\n\t\trunning=false;\r\n\t\treturn;\r\n\t}\r\n\tfor (const bytes of input) {\r\n\t\tonInput(bytes);\r\n\t}\r\n}\r\n\r\nconst loc=gameRom.location||gameRom.address;\r\nconst entry=parseInt(loc.Entry||loc.Reset,16);\r\nconst nmi=parseInt(loc.NMI,16);\r\nconst irq=parseInt(loc.IRQ,16);\r\nconst reset=parseInt(loc.Reset,16);\r\nconst vectors=gameRom.platform?.display?.type===\"calligraphic\";\r\ngame.setLabels(gameRom.labels);\r\n//console.log(\"reset\",{entry,nmi,reset,irq},loc)\r\ngame.reset(entry,irq,nmi,reset,vectors);\r\n\r\n//console.log(cusorPasteOn);\r\n// console.log(\"running...\",game.running);\r\n\r\nwhile(isRunning() && running && game.running){//&&game.cyclecount<0xa00){\r\n\r\n\tif(game.saveFile){\r\n\t\tconst fields={ INAM: \"AppleII Applesoft Code\", IART: \"nitrologic\", ISFT: \"nitrologic machine 0.9.9\" };\r\n\t\tawait game.tape.writeFile(\"test.wav\",fields);\r\n\t\tgame.saveFile=false;\r\n\t}\r\n\r\n\tif(stepping || step){\r\n\t\tcounter++;\r\n\t\tgame.tick();\r\n\t\tlet pc=game.pc\r\n\t\tif(breakPoints.includes(pc[0])){\r\n\t\t\tconsole.log(cursorClear+\"BREAKPOINT\");\r\n\t\t\tstepping=false;\r\n\t\t}\r\n\t\tlet org=game.pc[0];\r\n\t\tlet orgHex=hex(org,4);\r\n\t\tlet line=game.interpret6502();\r\n\t\tlet args=\"\";\r\n\t\tlet status=\"\";\r\n\t\tif(tracing||!stepping){\r\n\t\t\tstatus=game.getStatus();\r\n\t\t\tlet bytes=game.hexVector(1);\r\n\t\t\tlet cycle=hex(game.cycleCount|0,6);\r\n\t\t\tlet orgBytes=(orgHex+\":\"+bytes).padEnd(11);\t//15\t\t\t\t\r\n//\t\t\tlet label=game.labels.get(orgHex)||\"\";\r\n\t\t\tlet label=game.addresLabel(org,true);\r\n\t\t\tif(label?.length<8) label+=\"\\t\";\r\n//\t\tconsole.log(cycle+\"\\t\"+orgBytes+\"\\t\"+label+\"\\t\"+line+\"\\t\\t; \"+status);\r\n\t\t\targs=joinArgs(cycle,orgBytes,label,line+\"\\t\",status);\r\n//\t\t\targs=joinArgs(cycle,orgBytes,label,line);\r\n\t\t}\r\n\t\tif(stepping&&tracing){\r\n\t\t\twhile(trace.length>256) trace.shift();\r\n\t\t\ttrace.push(args);\r\n\t\t}\r\n\t\tif(!stepping){//(step){\r\n\t\t\tif(args) console.log(args);\r\n//\t\t\tif(status) console.log(\"\\t\\t\",status);\r\n\t\t\tstep=false;\r\n\t\t}\r\n\t\tgame.pollDVG();\r\n\t}else{\r\n\t\twriteConsole(\"\\r\");\r\n\t}\r\n\r\n\tif(stepping){\r\n//\t\tif((counter&0x1fff)==0){\r\n\t\tif((counter&0xfff)==0){\r\n\t\t\tpollSize();\r\n\t\t\tawait processInput();\r\n\t\t\tawait sleep(10);\r\n\t\t}\r\n\t}else{\r\n\t\tpollSize();\r\n\t\tawait processInput();\r\n\t\tawait sleep(100);\r\n\t}\r\n}\r\n\r\nconsole.log(\"machine is shutting down\",{clicks,cycles:game.cycleCount,stepping,running,game:game.running});\r\nstopTerminal();\r\nawait sleep(100);\r\n//console.log(cursorRestore);\r\n","name":"content"},{"role":"user","content":"{\"path\":\"C:\\\\nitrologic\\\\arcade\\\\commodore\\\\vic20.json\",\"length\":41077,\"type\":\"text/json\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"{\r\n\t\"title\":\"VIC 20 - The Friendly Computer\",\r\n\t\"copyright\":\"(c)1981 Commodore Business Machines\",\r\n\t\"version\":