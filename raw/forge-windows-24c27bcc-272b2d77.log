264e7071 [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.012 7.201KB 9.66s
264e7071 [gemini-3.7-flash] #In your trace, `$FD20` is addressing the Toshiba T6721A Voice Synthesizer (Speech
264e7071 [gemini-3.7-flash] #Processor).
264e7072 [gemini-3.7-flash] #
264e7072 [gemini-3.7-flash] #Why this is in the Plus/4 ROM
264e7072 [gemini-3.7-flash] #
264e7072 [gemini-3.7-flash] #During development of the 264 series, Commodore developed several sibling models sharing a common
264e7073 [gemini-3.7-flash] #architecture and KERNAL codebase:
264e7073 [gemini-3.7-flash] #• C16 / C116 (Entry-level)
264e7073 [gemini-3.7-flash] #• Plus/4 (Standard productivity model)
264e7073 [gemini-3.7-flash] #• Commodore V364 (High-end prototype with built-in speech synthesis)
264e7074 [gemini-3.7-flash] #
264e7074 [gemini-3.7-flash] #The KERNAL code you are seeing at `$CFA6` is a remnant of the V364 speech initialization
264e7074 [gemini-3.7-flash] #routine:
264e7074 [gemini-3.7-flash] #
264e7075 [gemini-3.7-flash] #
264e7075 [gemini-3.7-flash] #CFA6: LDA #$09        ; Set control word for speech processor
264e7075 [gemini-3.7-flash] #CFA8: STA $FD20       ; Write to speech chip register
264e7075 [gemini-3.7-flash] #CFAB: ORA #$80        ; Set bit 7 (reset / strobe bit)
264e7076 [gemini-3.7-flash] #CFAD: STA $FD20       ; Strobe the speech chip register
264e7076 [gemini-3.7-flash] #CFB0: JMP $FC1E       ; Continue to Function ROM / cartridge scan ($FDD0)
264e7076 [gemini-3.7-flash] #
264e7077 [gemini-3.7-flash] #
264e7077 [gemini-3.7-flash] #Hardware Mapping Summary
264e7077 [gemini-3.7-flash] #
264e7077 [gemini-3.7-flash] #╭─────────────────────┬───────────────────────┬──────────────────────────────────────────────────────────────────────────────────────────╮
264e7078 [gemini-3.7-flash] #│  Address            │  Hardware / Function  │  Notes                                                                                   │
264e7078 [gemini-3.7-flash] #├─────────────────────┼───────────────────────┼──────────────────────────────────────────────────────────────────────────────────────────┤
264e7078 [gemini-3.7-flash] #│  :---               │  :---                 │  :---                                                                                    │
264e7078 [gemini-3.7-flash] #│  **`$FD00–$FD0F`**  │  MOS 6551 ACIA        │  RS-232 / User serial (Plus/4 only)                                                      │
264e7079 [gemini-3.7-flash] #│  **`$FD10–$FD1F`**  │  MOS 6529B SPI        │  8-bit User Port                                                                         │
264e7079 [gemini-3.7-flash] #│  **`$FD20–$FD2F`**  │  **Toshiba T6721A**   │  **Speech Processor** (Populated on V364; open bus / unconnected on stock Plus/4 & C16)  │
264e7079 [gemini-3.7-flash] #│  **`$FDD0–$FDDF`**  │  PLA Banking Strobe   │  "3+1" Function ROM / Cartridge select                                                   │
264e7079 [gemini-3.7-flash] #│  **`$FF00–$FF1F`**  │  MOS 7360 / 8360 TED  │  Video, Audio, Timers, DMA                                                               │
264e707a [gemini-3.7-flash] #╰─────────────────────┴───────────────────────┴──────────────────────────────────────────────────────────────────────────────────────────╯
