25ba32bb [deepseek-v4-flash] #├─────────────────────┼────────────────────────────────────┤
25ba32bb [deepseek-v4-flash] #│  immediate          │  `CE`                              │
25ba32bb [deepseek-v4-flash] #│  register (8‑bit)   │  `88`   (low 3 bits = 0)           │
