2638979e [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.225 725.3KB 16.54s
2638979e [gemini-3.7-flash] #The trace reveals the exact reason why your emulator is stuck scanning only column 0.
2638979e [gemini-3.7-flash] #
2638979e [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2638979f [gemini-3.7-flash] #
2638979f [gemini-3.7-flash] #The Root Cause: `INC $E810` on PIA1 Port A
2638979f [gemini-3.7-flash] #
2638979f [gemini-3.7-flash] #In the trace during the keyboard scan routine:
263897a0 [gemini-3.7-flash] #
263897a0 [gemini-3.7-flash] #
263897a0 [gemini-3.7-flash] #E6C0: STA $E810       ; Writes $F0 to select Column 0
263897a1 [gemini-3.7-flash] #...
263897a1 [gemini-3.7-flash] #E6F9: LDA $E812       ; Reads row inputs for current column
263897a1 [gemini-3.7-flash] #...
263897a1 [gemini-3.7-flash] #E70F: INC $E810       ; Increments column counter ($F0 -> $F1 for column 1)
263897a2 [gemini-3.7-flash] #E712: BNE $E6F7       ; Loop back to scan next column if not zero
263897a2 [gemini-3.7-flash] #
263897a2 [gemini-3.7-flash] #
263897a2 [gemini-3.7-flash] #The Kernal uses `INC E810` (a read-modify-write instruction) to step through columns `F0` through
263897a3 [gemini-3.7-flash] #`$F9`.
263897a3 [gemini-3.7-flash] #
263897a3 [gemini-3.7-flash] #In `Machine.readPET`:
263897a3 [gemini-3.7-flash] #
263897a4 [gemini-3.7-flash] #case 0xe810: // kb matrix
263897a4 [gemini-3.7-flash] #	mem[0xE811] &= 0x3f;
263897a4 [gemini-3.7-flash] #	return 0xff;
263897a5 [gemini-3.7-flash] #
263897a5 [gemini-3.7-flash] #
263897a5 [gemini-3.7-flash] #When `INC $E810` executes:
263897a5 [gemini-3.7-flash] #1. `readAddress(0xE810)` is called, which returns the hardcoded value `0xFF`.
263897a6 [gemini-3.7-flash] #2. The 6502 increments `0xFF` to `0x00`.
263897a6 [gemini-3.7-flash] #3. The Zero flag (Z) is set to `1`.
263897a6 [gemini-3.7-flash] #4. `E712: BNE` sees Z = 1 and fails to branch, terminating the loop immediately after
263897a6 [gemini-3.7-flash] #Column 0.
263897a7 [gemini-3.7-flash] #
263897a7 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
263897a7 [gemini-3.7-flash] #
263897a7 [gemini-3.7-flash] #What `$E297` Is Doing
263897a8 [gemini-3.7-flash] #
263897a8 [gemini-3.7-flash] #The loop at the bottom of your trace:
263897a8 [gemini-3.7-flash] #
263897a9 [gemini-3.7-flash] #E297: LDA $020D       ; Read number of characters in keyboard buffer (NDX)
263897a9 [gemini-3.7-flash] #E29A: STA $0224       ; Enable cursor blinking when buffer is empty
263897a9 [gemini-3.7-flash] #E29D: BEQ $E297       ; Loop waiting for keypress
263897a9 [gemini-3.7-flash] #
263897a9 [gemini-3.7-flash] #This is the PET Kernal's idle cursor-blink / `GETIN` loop waiting for characters in the keyboard
263897aa [gemini-3.7-flash] #buffer. Because `INC $E810` wrapped to zero and terminated column scanning, keys typed on other
263897aa [gemini-3.7-flash] #columns were never detected.
263897aa [gemini-3.7-flash] #
263897aa [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
