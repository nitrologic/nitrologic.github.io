25b9f5fc [deepseek-v4-flash] #A full 16-bit absolute address follows the opcode.
25b9f5fc [deepseek-v4-flash] #
25b9f5fc [deepseek-v4-flash] #
25b9f5fd [deepseek-v4-flash] #LD A, (nnnn)   ; load A from address nnnn
25b9f5fd [deepseek-v4-flash] #JP nnnn
25b9f5fd [deepseek-v4-flash] #
25b9f5fd [deepseek-v4-flash] #
25b9f5fe [deepseek-v4-flash] #6. Indexed
25b9f5fe [deepseek-v4-flash] #Uses the IX or IY register plus an 8-bit signed displacement.
25b9f5fe [deepseek-v4-flash] #
