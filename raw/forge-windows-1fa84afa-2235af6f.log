213f4a24 [grok-build-0.1] #
213f4a25 [grok-build-0.1] #
213f4a25 [grok-build-0.1] #@echo off
213f4a25 [grok-build-0.1] #setlocal enabledelayedexpansion
213f4a25 [grok-build-0.1] #
213f4a26 [grok-build-0.1] #:: Create a variable containing a newline
213f4a26 [grok-build-0.1] #set "NL=^
213f4a26 [grok-build-0.1] #
213f4a26 [grok-build-0.1] #"
213f4a27 [grok-build-0.1] #:: ↑ There must be a blank line after the caret
213f4a27 [grok-build-0.1] #
