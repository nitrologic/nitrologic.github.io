21a0329d [kimi-k2.7-code] #		crc >>= 1;
21a0329d [kimi-k2.7-code] #		if (lsb)
21a0329e [kimi-k2.7-code] #		{
21a0329e [kimi-k2.7-code] #			crc ^= 0xEDB88320u;
21a0329e [kimi-k2.7-code] #		}
21a0329e [kimi-k2.7-code] #	}
21a0329f [kimi-k2.7-code] #	return crc;
21a0329f [kimi-k2.7-code] #}
21a0329f [kimi-k2.7-code] #
21a032a0 [kimi-k2.7-code] #uint32_t crc32_buffer(const uint8_t* data, size_t length)
21a032a0 [kimi-k2.7-code] #{
21a032a0 [kimi-k2.7-code] #	uint32_t crc = 0xFFFFFFFFu;
21a032a0 [kimi-k2.7-code] #	for (size_t i = 0; i < length; ++i)
