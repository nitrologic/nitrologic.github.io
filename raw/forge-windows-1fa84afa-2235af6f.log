200f0193 [deepseek-v4] #Yes, using JSON‑RPC to carry SNTP‑style timestamp exchange is perfectly fine for your use case. The
200f0193 [deepseek-v4] #overhead is modest on a 115200 baud serial link (a JSON frame might be ~100 bytes, which takes
200f0193 [deepseek-v4] #about 1 ms to transmit – negligible compared to the Pico’s clock drift).
200f0194 [deepseek-v4] #
200f0194 [deepseek-v4] #Just embed the SNTP fields (originate, receive, transmit timestamps) as JSON numbers or strings in
200f0194 [deepseek-v4] #the parameters. The host sends:
200f0194 [deepseek-v4] #
200f0195 [deepseek-v4] #
200f0195 [deepseek-v4] #{"jsonrpc":"2.0","method":"sntp","params":{"originate":<hostTime>},"id":1}
200f0195 [deepseek-v4] #
200f0195 [deepseek-v4] #
200f0196 [deepseek-v4] #The Pico replies with:
200f0196 [deepseek-v4] #
200f0196 [deepseek-v4] #
200f0196 [deepseek-v4] #{"jsonrpc":"2.0","result":{"receive":<picoReceiveTime>,"transmit":<picoTransmitTime>},"id":1}
200f0197 [deepseek-v4] #
200f0197 [deepseek-v4] #
200f0197 [deepseek-v4] #The host then computes round‑trip delay and offset to adjust its own clock or to log the Pico’s
200f0197 [deepseek-v4] #time accuracy.
200f0198 [deepseek-v4] #
200f0198 [deepseek-v4] #This keeps your RPC system uniform – no separate binary protocol needed. If later you need
200f0198 [deepseek-v4] #sub‑millisecond precision you could switch to a binary packet, but for a firmware clock sync over
200f0198 [deepseek-v4] #serial this is more than adequate.
200f0199 [deepseek-v4] #
