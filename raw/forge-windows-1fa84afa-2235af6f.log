2173f22c [glm-5.2] #There's a scoping bug in this function. The `let name = p.name;` inside the `if` block creates a
2173f22c [glm-5.2] #new block-scoped variable that shadows the outer `name`. The outer `name` is never updated,
2173f22d [glm-5.2] #so `setPersona(name)` always receives the raw `words[1]` value (the numeric string) rather than the
2173f22d [glm-5.2] #resolved persona name.
2173f22d [glm-5.2] #
2173f22d [glm-5.2] #Here's the corrected version:
2173f22e [glm-5.2] #
2173f22e [glm-5.2] #
2173f22e [glm-5.2] #async function personaCommand(words) {
2173f22e [glm-5.2] #	if (words.length == 1) {
2173f22e [glm-5.2] #		listPersona();
2173f22e [glm-5.2] #		listCommand = "persona";
2173f22f [glm-5.2] #	} else {
2173f22f [glm-5.2] #		let name = words[1];
2173f22f [glm-5.2] #		if (isFinite(name)) {
2173f22f [glm-5.2] #			let index = name | 0;
2173f22f [glm-5.2] #			let p = relayPersona.persona[index];
2173f230 [glm-5.2] #			name = p.name;  // reassign outer variable, don't redeclare
2173f230 [glm-5.2] #		}
2173f230 [glm-5.2] #		await setPersona(name);
2173f230 [glm-5.2] #	}
2173f230 [glm-5.2] #}
2173f231 [glm-5.2] #
2173f231 [glm-5.2] #
2173f231 [glm-5.2] #• The fix:* `name = p.name;` instead of `let name = p.name;` — this reassigns the existing
2173f232 [glm-5.2] #outer-scope variable rather than declaring a new one.
2173f232 [glm-5.2] #
2173f232 [glm-5.2] #You may also want to add a bounds check on `index` before indexing into
2173f232 [glm-5.2] #`relayPersona.persona[index]` to avoid an undefined access if the user passes an out-of-range
2173f232 [glm-5.2] #number.
2173f233 [glm-5.2] #
