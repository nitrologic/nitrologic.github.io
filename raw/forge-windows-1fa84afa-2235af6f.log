20b42e5e [kimi-k2.7-code] # ꔀ nitrologic Relay 1.8.8 ⛲  kimi-k2.7-code 🜁 🪠 🧊 $0.004 527B 25.83s
20b42e5e [kimi-k2.7-code] #You can do this with a resistor divider plus an AC-coupling capacitor. GPIO pins output 0–3.3 V DC,
20b42e5e [kimi-k2.7-code] #so you attenuate first, then block the DC offset to get a ±350 mV AC signal.
20b42e5f [kimi-k2.7-code] #
20b42e5f [kimi-k2.7-code] #• Voltage divider*
20b42e5f [kimi-k2.7-code] #
20b42e5f [kimi-k2.7-code] #Target: 700 mV p-p from 3.3 V p-p
20b42e60 [kimi-k2.7-code] #
20b42e60 [kimi-k2.7-code] #\[
20b42e60 [kimi-k2.7-code] #\frac{V_{out}}{V_{in}} = \frac{0.7}{3.3} \approx 0.212
20b42e60 [kimi-k2.7-code] #\]
20b42e61 [kimi-k2.7-code] #
20b42e61 [kimi-k2.7-code] #Use:
20b42e61 [kimi-k2.7-code] #
20b42e61 [kimi-k2.7-code] #- R1 = 10 kΩ
20b42e62 [kimi-k2.7-code] #- R2 = 2.7 kΩ
20b42e62 [kimi-k2.7-code] #
20b42e62 [kimi-k2.7-code] #\[
20b42e62 [kimi-k2.7-code] #V_{out} = 3.3 \times \frac{2.7k}{10k + 2.7k} \approx 0.70 \text{ V p-p}
20b42e63 [kimi-k2.7-code] #\]
20b42e63 [kimi-k2.7-code] #
20b42e63 [kimi-k2.7-code] #• AC coupling*
20b42e63 [kimi-k2.7-code] #
20b42e64 [kimi-k2.7-code] #Add a capacitor in series after the divider to remove the DC offset:
20b42e64 [kimi-k2.7-code] #
20b42e64 [kimi-k2.7-code] #- C = 1 µF to 10 µF for audio/low-frequency work
20b42e64 [kimi-k2.7-code] #- 100 nF works fine for kHz-range signals
20b42e65 [kimi-k2.7-code] #
20b42e65 [kimi-k2.7-code] #The output will swing ±350 mV around 0 V.
20b42e65 [kimi-k2.7-code] #
20b42e65 [kimi-k2.7-code] #• Circuit*
20b42e66 [kimi-k2.7-code] #
20b42e66 [kimi-k2.7-code] #
20b42e66 [kimi-k2.7-code] #GPIO ----[10k]----+----[2.7k]---- GND
20b42e66 [kimi-k2.7-code] #                  |
20b42e67 [kimi-k2.7-code] #                  +----[C]---- Vout (AC, 700mV p-p)
20b42e67 [kimi-k2.7-code] #
20b42e67 [kimi-k2.7-code] #
20b42e67 [kimi-k2.7-code] #• If you want a sine or arbitrary waveform*
20b42e68 [kimi-k2.7-code] #
20b42e68 [kimi-k2.7-code] #Use a PWM output with a low-pass filter before the divider. A simple RC filter works:
20b42e68 [kimi-k2.7-code] #
20b42e68 [kimi-k2.7-code] #- R = 1 kΩ to 10 kΩ
20b42e69 [kimi-k2.7-code] #- C = 1 nF to 100 nF depending on frequency
20b42e69 [kimi-k2.7-code] #
20b42e69 [kimi-k2.7-code] #Then feed that filtered 0–3.3 V signal into the same divider/coupling cap.
20b42e69 [kimi-k2.7-code] #
20b42e6a [kimi-k2.7-code] #• Load note*
20b42e6a [kimi-k2.7-code] #
20b42e6a [kimi-k2.7-code] #The output impedance of this divider is roughly R1 || R2 ≈ 2.1 kΩ. If the next stage has low input
20b42e6a [kimi-k2.7-code] #impedance, buffer it with an op-amp follower.
20b42e6b [kimi-k2.7-code] #
20b42e6b [kimi-k2.7-code] #What waveform and frequency are you aiming for? Sine, square, or arbitrary? That changes the filter
20b42e6b [kimi-k2.7-code] #and capacitor values.
20b42e6b [kimi-k2.7-code] #
