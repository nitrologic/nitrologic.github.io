2011524f [nitro@ryzen5] any conventions for getters and setters with json rpc?
201152cd [deepseek-v4] # ꔀ nitrologic Relay 1.8.8 ⛲  deepseek-v4 🐋 🪠 0.7° $0.048 827.1KB 7.45s
201152ce [deepseek-v4] #There is no formal standard for getter/setter naming in JSON‑RPC, but common conventions
201152ce [deepseek-v4] #have emerged:
201152ce [deepseek-v4] #
201152ce [deepseek-v4] #
201152cf [deepseek-v4] #╭──────────────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────╮
201152cf [deepseek-v4] #│  Pattern                 │  Example                                                                                       │
201152cf [deepseek-v4] #├──────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────┤
201152d0 [deepseek-v4] #│  **Verb‑noun**           │  `getClock`, `setClock`, `getTemperature`, `setGain`                                           │
201152d0 [deepseek-v4] #│  **Noun‑verb**           │  `clock.get`, `clock.set`, `temperature.get`, `gain.set`                                       │
201152d0 [deepseek-v4] #│  **Combined state**      │  `clock` with an optional `value` parameter – omitting it acts as a getter, providing it as a  │
201152d0 [deepseek-v4] #│                          │  setter. Return the current state. This is RPC‑style idempotent if you treat it as a read/write │
201152d1 [deepseek-v4] #│                          │  property.                                                                                     │
201152d1 [deepseek-v4] #│  **CRUD‑like**           │  `readClock`, `writeClock` (less common for RPC, more for REST)                                │
201152d1 [deepseek-v4] #╰──────────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────╯
201152d1 [deepseek-v4] #
201152d2 [deepseek-v4] #
201152d2 [deepseek-v4] #The verb‑noun (`setClock`) is the most widely used in JSON‑RPC APIs because each method name is
201152d2 [deepseek-v4] #self‑explaining and maps directly to a procedure call. The combined state pattern is elegant when
201152d2 [deepseek-v4] #you want a single method for both reading and writing (e.g., `clock` with an optional
201152d3 [deepseek-v4] #`params.timestamp`).
201152d3 [deepseek-v4] #
201152d3 [deepseek-v4] #Pick one and be consistent across your entire API. For your Pico, `setClock` and `getClock` (or the
201152d3 [deepseek-v4] #combined `clock`) are fine choices.
201152d4 [deepseek-v4] #
