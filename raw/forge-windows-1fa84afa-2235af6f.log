215c0a50 [grok-build-0.1] #Corrected version (no delayed expansion):
215c0a50 [grok-build-0.1] #
215c0a50 [grok-build-0.1] #
215c0a50 [grok-build-0.1] #@echo off
215c0a50 [grok-build-0.1] #setlocal
215c0a51 [grok-build-0.1] #
215c0a51 [grok-build-0.1] #rem Save the current directory in a variable
215c0a51 [grok-build-0.1] #set "current_dir=%CD%"
215c0a51 [grok-build-0.1] #
215c0a52 [grok-build-0.1] #rem Change to another directory
215c0a52 [grok-build-0.1] #pushd "C:\Path\To\Target\Directory"
215c0a52 [grok-build-0.1] #
215c0a52 [grok-build-0.1] #rem Run your command using the saved path as an argument
215c0a53 [grok-build-0.1] #mycommand.exe "%current_dir%"
215c0a53 [grok-build-0.1] #
215c0a53 [grok-build-0.1] #rem Return to the original directory
215c0a53 [grok-build-0.1] #popd
215c0a53 [grok-build-0.1] #
215c0a54 [grok-build-0.1] #endlocal
215c0a54 [grok-build-0.1] #
215c0a54 [grok-build-0.1] #
215c0a54 [grok-build-0.1] #Why the change?
215c0a54 [grok-build-0.1] #
215c0a55 [grok-build-0.1] #- `setlocal` without `enabledelayedexpansion` is enough here.
215c0a55 [grok-build-0.1] #- Using `%current_dir%` is the normal and safer way when you don't need delayed expansion.
215c0a55 [grok-build-0.1] #- `!current_dir!` only works if you enable delayed expansion, which adds complexity and can behave
215c0a55 [grok-build-0.1] #unexpectedly with certain characters in paths.
215c0a55 [grok-build-0.1] #
215c0a56 [grok-build-0.1] #When you would use `!` instead:
215c0a56 [grok-build-0.1] #
215c0a56 [grok-build-0.1] #You only need delayed expansion if the variable is being read inside a `for` loop or a
215c0a56 [grok-build-0.1] #parenthesized block. For this simple pattern (save dir → pushd → run command), `%var%` is cleaner.
215c0a56 [grok-build-0.1] #
215c0a57 [grok-build-0.1] #Would you like a version that also handles paths with spaces or special characters more robustly?
