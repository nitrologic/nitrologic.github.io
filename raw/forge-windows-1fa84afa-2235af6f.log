215d79be [grok-build-0.1] #
215d79be [grok-build-0.1] #
215d79be [grok-build-0.1] #Inside the `extern "C"` block you want only declarations (prototypes + types), not
215d79bf [grok-build-0.1] #definitions.
215d79bf [grok-build-0.1] #
215d79bf [grok-build-0.1] #Next steps I suggest
