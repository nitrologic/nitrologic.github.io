20b351b7 [kimi-k2.7-code] #Here is the standard DE-15 VGA connector pinout (15-pin D-sub, HD-15):
20b351b7 [kimi-k2.7-code] #
20b351b7 [kimi-k2.7-code] #Pin layout (looking at the mating face of the connector)
20b351b8 [kimi-k2.7-code] #
20b351b8 [kimi-k2.7-code] #
20b351b8 [kimi-k2.7-code] #  1   2   3   4   5
20b351b8 [kimi-k2.7-code] #   6   7   8   9  10
20b351b8 [kimi-k2.7-code] #    11  12  13  14  15
20b351b9 [kimi-k2.7-code] #
20b351b9 [kimi-k2.7-code] #
