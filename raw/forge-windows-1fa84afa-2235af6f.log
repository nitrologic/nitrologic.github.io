21343e02 [grok-build-0.1] #Quick inventory of what arrived
21343e03 [grok-build-0.1] #
21343e03 [grok-build-0.1] #• Retro computing / hardware*
21343e03 [grok-build-0.1] #- 6502.json (clean opcode/flags/profile layout)
21343e03 [grok-build-0.1] #- VIC-20.json (very detailed — memory map, registers, vectors, timing, etc.)
21343e03 [grok-build-0.1] #- commodore.json + commodore64.json (big historical + product data)
21343e04 [grok-build-0.1] #- 7400.json + 7400.md (TTL parts + visual diagrams)
21343e04 [grok-build-0.1] #- archimedes.json
21343e04 [grok-build-0.1] #- machinespec.json (the big kitchen-sink one)
21343e04 [grok-build-0.1] #
