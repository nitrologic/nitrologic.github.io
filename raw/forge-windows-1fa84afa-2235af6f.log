215b5166 [grok-build-0.1] #echo All arguments: %*
215b5166 [grok-build-0.1] #
215b5166 [grok-build-0.1] #
215b5167 [grok-build-0.1] #Example usage:
215b5167 [grok-build-0.1] #
215b5167 [grok-build-0.1] #Run this:
