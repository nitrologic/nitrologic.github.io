200e5eef [deepseek-v4] #To use JSON‑RPC over serial instead of raw strings, you can implement a line‑based framing: each
200e5eef [deepseek-v4] #JSON‑RPC request and response is a single line (terminated by `\n`). The host tool (`echocoms`)
200e5eef [deepseek-v4] #sends requests and reads complete response lines, then parses them.
200e5eef [deepseek-v4] #
200e5ef0 [deepseek-v4] #Design outline
200e5ef0 [deepseek-v4] #
200e5ef0 [deepseek-v4] #• Framing*
200e5ef0 [deepseek-v4] #- Send: JSON object compacted (no whitespace), followed by `\n`.
200e5ef1 [deepseek-v4] #- Receive: read characters until `\n` (or timeout). Parse as JSON.
200e5ef1 [deepseek-v4] #
200e5ef1 [deepseek-v4] #• Host‑side functions* (add to `tools.h` / `enumports.cpp`)
200e5ef1 [deepseek-v4] #
200e5ef2 [deepseek-v4] #
200e5ef2 [deepseek-v4] #╭────────────────────────────────────────────────┬─────────────────────────────────────────────────────────────────────╮
200e5ef2 [deepseek-v4] #│  Function                                      │  Purpose                                                             │
200e5ef2 [deepseek-v4] #├────────────────────────────────────────────────┼─────────────────────────────────────────────────────────────────────┤
