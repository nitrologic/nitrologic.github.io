215e5651 [grok-build-0.1] # ꔀ Relay 1.9.3 grok-build-0.1 𝕏 🪣  0.7° $0.073 237.7KB 6.15s
215e5651 [grok-build-0.1] #• Answer:*
215e5651 [grok-build-0.1] #
215e5651 [grok-build-0.1] #On Windows, when using the low-level `open()` / `read()` functions (not `fopen`), you need:
215e5651 [grok-build-0.1] #
215e5651 [grok-build-0.1] #
215e5652 [grok-build-0.1] #O_RDONLY | O_BINARY
215e5652 [grok-build-0.1] #
215e5652 [grok-build-0.1] #
215e5652 [grok-build-0.1] #Recommended change
215e5653 [grok-build-0.1] #
215e5653 [grok-build-0.1] #In your current code, `RDONLY` is defined as `0` in `dipdefs.h`. That works on Unix but is wrong
215e5653 [grok-build-0.1] #for Windows.
215e5654 [grok-build-0.1] #
215e5654 [grok-build-0.1] #Replace this definition:
215e5654 [grok-build-0.1] #
215e5654 [grok-build-0.1] #
215e5655 [grok-build-0.1] ##define RDONLY 0
215e5655 [grok-build-0.1] #
215e5655 [grok-build-0.1] #
215e5655 [grok-build-0.1] #With this (in the Windows path):
215e5656 [grok-build-0.1] #
215e5656 [grok-build-0.1] #
215e5656 [grok-build-0.1] ##define RDONLY (O_RDONLY | O_BINARY)
215e5656 [grok-build-0.1] #
215e5657 [grok-build-0.1] #
215e5657 [grok-build-0.1] #Full context / where to put it
215e5657 [grok-build-0.1] #
215e5658 [grok-build-0.1] #In `dipdefs.h`, you can do it like this:
215e5658 [grok-build-0.1] #
215e5658 [grok-build-0.1] #
215e5658 [grok-build-0.1] ##ifdef UNIX
215e5659 [grok-build-0.1] ##define RDONLY 0
215e5659 [grok-build-0.1] ##else
215e5659 [grok-build-0.1] ##include <fcntl.h>
215e5659 [grok-build-0.1] ##include <io.h>
215e565a [grok-build-0.1] ##define RDONLY (O_RDONLY | O_BINARY)
215e565a [grok-build-0.1] ##endif
215e565a [grok-build-0.1] #
215e565a [grok-build-0.1] #
215e565b [grok-build-0.1] #Then the existing call should work:
215e565b [grok-build-0.1] #
215e565b [grok-build-0.1] #
215e565b [grok-build-0.1] #gamechn = open(gamfile, RDONLY);
215e565c [grok-build-0.1] #
215e565c [grok-build-0.1] #
215e565c [grok-build-0.1] #Important notes
215e565c [grok-build-0.1] #
215e565d [grok-build-0.1] #- `O_BINARY` is required. Without it, Windows does newline translation (`\r\n` ↔ `\n`), which will
215e565d [grok-build-0.1] #corrupt the game file (especially the image data section).
215e565d [grok-build-0.1] #- Make sure you include `<fcntl.h>` (and `<io.h>` for MSVC/MinGW) before using these flags.
215e565d [grok-build-0.1] #- The same issue can affect `savechn` if you ever create save files (you may want `O_WRONLY |
215e565e [grok-build-0.1] #O_CREAT | O_BINARY` for saves).
215e565e [grok-build-0.1] #
215e565e [grok-build-0.1] #Would you like me to show the minimal patch for both `RDONLY` and the save file open as well?
215e565e [grok-build-0.1] #
