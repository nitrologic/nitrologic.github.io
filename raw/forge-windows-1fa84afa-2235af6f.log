218a35cd [glm-5.2] #
218a35cd [glm-5.2] #3. Flag Decoders
218a35cd [glm-5.2] #Flags are bitmasks, so a map doesn't work as well. A small function that appends characters based
218a35ce [glm-5.2] #on the bits is cleaner.
218a35ce [glm-5.2] #
218a35ce [glm-5.2] #For Program Headers (`p_flags`):
218a35ce [glm-5.2] #
218a35cf [glm-5.2] #std::string pflags_string(uint32_t flags) {
