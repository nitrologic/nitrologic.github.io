21875a32 [glm-5.2] #The `MsgWaitForMultipleObjects` usage with 10ms is correct, but there are two things to be aware of
21875a32 [glm-5.2] #in a console app:
21875a32 [glm-5.2] #
21875a32 [glm-5.2] #• 1. The `[MSG]` line will likely never print.* Console applications don't receive Win32
21875a33 [glm-5.2] #keyboard messages through the message queue. Console input goes through the console input buffer
21875a33 [glm-5.2] #(`ReadConsoleInput` / `stdin`), which is a completely separate subsystem. `PeekMessage` will find
21875a33 [glm-5.2] #nothing to pump.
21875a33 [glm-5.2] #
21875a33 [glm-5.2] #• 2. `GetKeyboardState` will return stale or empty data* for the same reason — it reads
21875a34 [glm-5.2] #from the thread's message queue keyboard state, which never gets updated in a console app.
21875a34 [glm-5.2] #
21875a34 [glm-5.2] #The reliable path for a console application is `GetAsyncKeyState` which polls the hardware
21875a34 [glm-5.2] #directly:
21875a34 [glm-5.2] #
21875a35 [glm-5.2] #
21875a35 [glm-5.2] #bool anyKeyDown(){
21875a35 [glm-5.2] #	for(int i = 0; i < 256; i++){
21875a35 [glm-5.2] #		if(GetAsyncKeyState(i) & 0x8000) return true;
21875a35 [glm-5.2] #	}
21875a35 [glm-5.2] #	return false;
21875a36 [glm-5.2] #}
21875a36 [glm-5.2] #
21875a36 [glm-5.2] #
21875a36 [glm-5.2] #With that you can drop `pollMessages()` entirely and simplify the loop — no message pump, no
21875a36 [glm-5.2] #`GetConsoleWindow`, just the 10ms sleep you already have:
21875a37 [glm-5.2] #
21875a37 [glm-5.2] #
21875a37 [glm-5.2] #while(true){
21875a37 [glm-5.2] #	lineValue = rpcFifo.readLine();
21875a37 [glm-5.2] #	if(lineValue.has_value()){
21875a38 [glm-5.2] #		std::cout << "[RPC] line:" << (lineValue.value()) << std::endl;
21875a38 [glm-5.2] #	}else{
21875a38 [glm-5.2] #		std::this_thread::sleep_for(std::chrono::milliseconds(10));
21875a38 [glm-5.2] #	}
21875a38 [glm-5.2] #	if(anyKeyDown()){
21875a38 [glm-5.2] #		std::cout << "[RPC] anykey" << std::endl;
21875a38 [glm-5.2] #	}
21875a38 [glm-5.2] #	if(GetAsyncKeyState(VK_ESCAPE) & 0x8000) break;
21875a38 [glm-5.2] #}
21875a39 [glm-5.2] #
21875a39 [glm-5.2] #
21875a39 [glm-5.2] #The message pump approach (`GetKeyboardState` + `PeekMessage`) is the right tool for GUI
21875a39 [glm-5.2] #applications with a `WndProc`, but for console apps `GetAsyncKeyState` is the way to go.
