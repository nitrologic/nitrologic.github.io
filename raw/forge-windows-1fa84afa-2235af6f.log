215b4d56 [grok-build-0.1] #To use command-line arguments in a Windows batch file (.bat), reference them with `%1` for the
215b4d57 [grok-build-0.1] #first argument, `%2` for the second, and so on (up to `%9`). Use `shift` if you need more than 9.
215b4d57 [grok-build-0.1] #Always validate inputs to avoid errors.
215b4d57 [grok-build-0.1] #
215b4d57 [grok-build-0.1] #Here's a basic example:
215b4d58 [grok-build-0.1] #
215b4d58 [grok-build-0.1] #
215b4d58 [grok-build-0.1] #@echo off
215b4d58 [grok-build-0.1] #if "%1"=="" (
215b4d59 [grok-build-0.1] #	echo Usage: simonsta.bat [name] [age]
215b4d59 [grok-build-0.1] #	exit /b 1
215b4d59 [grok-build-0.1] #)
215b4d59 [grok-build-0.1] #
215b4d5a [grok-build-0.1] #echo Name: %1
215b4d5a [grok-build-0.1] #echo Age: %2
215b4d5a [grok-build-0.1] #
215b4d5a [grok-build-0.1] #rem Example: Use a named variable for reuse
215b4d5b [grok-build-0.1] #set name=%1
215b4d5b [grok-build-0.1] #echo Hello, %name%!
215b4d5b [grok-build-0.1] #
215b4d5b [grok-build-0.1] #
215b4d5c [grok-build-0.1] #Save as `simonsta.bat` and run it like this:
