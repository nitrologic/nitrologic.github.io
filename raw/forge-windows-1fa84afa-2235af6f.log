215b5169 [grok-build-0.1] #All arguments: hello world 42 test
215b5169 [grok-build-0.1] #
215b5169 [grok-build-0.1] #
215b516a [grok-build-0.1] #Other common uses of `%*`:
215b516a [grok-build-0.1] #
215b516a [grok-build-0.1] #- Pass all arguments to another program:
215b516a [grok-build-0.1] #
215b516b [grok-build-0.1] #  another.bat %*
215b516b [grok-build-0.1] #
215b516b [grok-build-0.1] #
