218a35c7 [glm-5.2] #	{0x6474e551, "GNU_EH_FRAME"},
218a35c7 [glm-5.2] #	{0x70000001, "ARM_EXIDX"}
218a35c8 [glm-5.2] #};
218a35c8 [glm-5.2] #
218a35c8 [glm-5.2] #
218a35c8 [glm-5.2] #2. Section Header Types (`sh_type`)
218a35c9 [glm-5.2] #
218a35c9 [glm-5.2] #const std::map<uint32_t, std::string> shtypes = {
218a35c9 [glm-5.2] #	{0, "NULL"},
