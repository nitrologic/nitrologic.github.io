219da009 [glm-5.2] # ꔀ Relay 1.9.4 glm-5.2 Z 🪠 0.7° $0.010 13.53KB 17.42s
219da00a [glm-5.2] #Thank you for sharing the files. I've reviewed all three and have a few observations:
219da00a [glm-5.2] #
219da00a [glm-5.2] #Signature mismatch for `dumpMem`
219da00a [glm-5.2] #
219da00a [glm-5.2] #In `elf32.h` the declaration is:
219da00a [glm-5.2] #
219da00b [glm-5.2] #
219da00b [glm-5.2] #void dumpMem(const uint8_t* base, size_t size);
219da00b [glm-5.2] #
219da00b [glm-5.2] #
219da00b [glm-5.2] #But in `elfutil.cpp` the forward declaration and call site use a different signature:
219da00c [glm-5.2] #
219da00c [glm-5.2] #
219da00c [glm-5.2] #void dumpMem(const uint8_t* values, int base32, size_t size);
219da00c [glm-5.2] #
219da00c [glm-5.2] #
219da00d [glm-5.2] #This would cause a linker error or undefined behaviour depending on how `dumpMem` is actually
219da00d [glm-5.2] #defined elsewhere. Worth reconciling.
219da00d [glm-5.2] #
219da00d [glm-5.2] #The `sizeof(elf32)` offset convention
219da00e [glm-5.2] #
219da00e [glm-5.2] #The approach of reading the ELF header separately into `hdr` and storing only the remainder in
219da00e [glm-5.2] #`content` means every file offset needs `- sizeof(elf32)`. This works but is fragile — if
219da00e [glm-5.2] #`sh_offset` or `p_offset` ever points into the header region (e.g. a `SHT_NULL` section at offset
219da00f [glm-5.2] #0), the subtraction underflows to a very large value. A null check or a `static_cast` to a signed
219da00f [glm-5.2] #type before subtracting would be safer.
219da00f [glm-5.2] #
219da00f [glm-5.2] #`ptypes.find()` without bounds check
219da010 [glm-5.2] #
219da010 [glm-5.2] #In the program header loop:
219da010 [glm-5.2] #
219da010 [glm-5.2] #
219da010 [glm-5.2] #auto ptype=ptypes.find(ph[i].p_type)->second;
219da011 [glm-5.2] #
219da011 [glm-5.2] #
219da011 [glm-5.2] #If `p_type` isn't in the map, `find` returns `end()` and dereferencing it is undefined behaviour.
219da012 [glm-5.2] #The section header loop has the same pattern with `shtypes.find()`. A guard or a fallback to
219da012 [glm-5.2] #`"UNKNOWN"` (as done in `emachine_string`) would be more robust.
219da012 [glm-5.2] #
219da012 [glm-5.2] #`get_entry_symbol` and `print_symbols`
219da013 [glm-5.2] #
219da013 [glm-5.2] #Both cast `content.data() + offset` directly to `elf32_sym*`. On architectures with strict
219da013 [glm-5.2] #alignment requirements this could fault. Using `memcpy` into a local `elf32_sym` would be portable,
219da013 [glm-5.2] #though on ARM/x86 it's typically fine in practice.
219da013 [glm-5.2] #
219da013 [glm-5.2] #Otherwise
219da014 [glm-5.2] #
219da014 [glm-5.2] #The structure definitions in `elf32.h` look correct for ELF32. The lookup tables cover the common
219da014 [glm-5.2] #types. The relay transcript confirms it successfully parsed an ARM bare-metal executable, which is
219da014 [glm-5.2] #a good validation. The commented-out `print_symbols` call in `main` suggests that feature is still
219da014 [glm-5.2] #being tested — let me know if you'd like help debugging or extending it.
219da015 [glm-5.2] #
