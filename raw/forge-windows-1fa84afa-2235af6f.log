22226e66 [deepseek-v4-flash] # ꔀ Relay 1.9.4 deepseek-v4-flash 🐋 🪠 0.7° $0.013 146.0KB 4.51s
22226e67 [deepseek-v4-flash] #The escape sequence `\x1b[K` you wrote is not for homing the cursor – it's for erasing
22226e67 [deepseek-v4-flash] #from the cursor position to the end of the line (Clear Line, suffix `K`).
22226e67 [deepseek-v4-flash] #
22226e67 [deepseek-v4-flash] #To move the cursor to the home position (top‑left corner, row 1, column 1), you need:
22226e68 [deepseek-v4-flash] #
22226e68 [deepseek-v4-flash] #
22226e68 [deepseek-v4-flash] #\x1b[H
22226e68 [deepseek-v4-flash] #
22226e69 [deepseek-v4-flash] #
22226e69 [deepseek-v4-flash] #or equivalently:
22226e69 [deepseek-v4-flash] #
22226e69 [deepseek-v4-flash] #
22226e6a [deepseek-v4-flash] #\x1b[1;1H
22226e6a [deepseek-v4-flash] #
22226e6a [deepseek-v4-flash] #
22226e6a [deepseek-v4-flash] #- `\x1b` is the ESC character.
22226e6b [deepseek-v4-flash] #- `[H` is the Cursor Position command (also called CUP) with no arguments, which defaults to row 1,
22226e6b [deepseek-v4-flash] #column 1.
22226e6b [deepseek-v4-flash] #
22226e6b [deepseek-v4-flash] #If you want to store it in a variable:
22226e6c [deepseek-v4-flash] #
22226e6c [deepseek-v4-flash] #
22226e6c [deepseek-v4-flash] #const cursorHome = "\x1b[H";
22226e6c [deepseek-v4-flash] #
22226e6d [deepseek-v4-flash] #
22226e6d [deepseek-v4-flash] #If you also want to clear the entire screen and home the cursor, use `\x1b[2J\x1b[H` (clear entire
22226e6d [deepseek-v4-flash] #screen, then home).
22226e6d [deepseek-v4-flash] #
22226e6e [deepseek-v4-flash] #So, in your code, replace:
22226e6e [deepseek-v4-flash] #
22226e6e [deepseek-v4-flash] #
22226e6e [deepseek-v4-flash] #let cursorHome = "\x1b[K";   // wrong – this erases line
22226e6f [deepseek-v4-flash] #
22226e6f [deepseek-v4-flash] #
22226e6f [deepseek-v4-flash] #with:
22226e6f [deepseek-v4-flash] #
22226e70 [deepseek-v4-flash] #
22226e70 [deepseek-v4-flash] #let cursorHome = "\x1b[H";   // moves cursor to top-left
22226e70 [deepseek-v4-flash] #
22226e71 [deepseek-v4-flash] #
