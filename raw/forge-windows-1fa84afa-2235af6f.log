215c6658 [grok-build-0.1] # ꔀ Relay 1.9.2 grok-build-0.1 𝕏 🪣  0.7° $0.001 496B 12.87s
215c6659 [grok-build-0.1] #• In .bat files (Windows batch scripting), this is handled with `SETLOCAL
215c6659 [grok-build-0.1] #ENABLEDELAYEDEXPANSION`.*
215c6659 [grok-build-0.1] #
215c6659 [grok-build-0.1] #Why it exists
215c6659 [grok-build-0.1] #By default, batch files expand variables (`%var%`) at parse time (when the line is read),
215c6659 [grok-build-0.1] #not when the line actually runs. This means inside loops, `if` blocks, or after a variable is
215c6659 [grok-build-0.1] #changed, the value stays frozen at the original parse-time value.
215c665a [grok-build-0.1] #
215c665a [grok-build-0.1] #To make variables evaluate in execution order (i.e. when the line is actually reached), you
215c665a [grok-build-0.1] #turn on delayed expansion:
215c665a [grok-build-0.1] #
215c665a [grok-build-0.1] #
215c665b [grok-build-0.1] #SETLOCAL ENABLEDELAYEDEXPANSION
215c665b [grok-build-0.1] #
215c665b [grok-build-0.1] #SET count=0
215c665b [grok-build-0.1] #
215c665b [grok-build-0.1] #FOR %%A IN (1 2 3) DO (
215c665c [grok-build-0.1] #    SET /A count+=1
215c665c [grok-build-0.1] #    ECHO !count!          REM <- note the ! ! instead of % %
215c665c [grok-build-0.1] #)
215c665d [grok-build-0.1] #
215c665d [grok-build-0.1] #ENDLOCAL
215c665d [grok-build-0.1] #
215c665d [grok-build-0.1] #
215c665d [grok-build-0.1] #Key points
215c665e [grok-build-0.1] #- Use `!variable!` (exclamation marks) for delayed variables.
215c665e [grok-build-0.1] #- Use `%variable%` for normal (parse-time) expansion.
215c665e [grok-build-0.1] #- `SETLOCAL ENABLEDELAYEDEXPANSION` must be inside the script (or called from a parent).
215c665e [grok-build-0.1] #- Always pair it with `ENDLOCAL` when you want to restore the previous state.
215c665e [grok-build-0.1] #
215c665f [grok-build-0.1] #If this isn't what you meant by "set to evaluate in order", give me a bit more context (e.g. a code
215c665f [grok-build-0.1] #snippet or the exact behaviour you're seeing) and I'll refine it.
215c665f [grok-build-0.1] #
