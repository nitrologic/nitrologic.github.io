215f01be [glm-5.2] #For the `md_delay()` function, you can use the Win32 `Sleep()` API. You'll need to include
215f01bf [glm-5.2] #`<windows.h>` and replace the busy-wait loop.
215f01bf [glm-5.2] #
215f01bf [glm-5.2] #Minimal change to `md_delay()`
215f01bf [glm-5.2] #
215f01c0 [glm-5.2] #
215f01c0 [glm-5.2] ##ifdef _WIN32
215f01c0 [glm-5.2] ##include <windows.h>
215f01c0 [glm-5.2] ##endif
215f01c1 [glm-5.2] #
215f01c1 [glm-5.2] #void md_delay(int ticks)
215f01c1 [glm-5.2] #{
215f01c2 [glm-5.2] #	/* one tick = 1/60 second ≈ 16.67 ms */
215f01c2 [glm-5.2] #	DWORD millis = (DWORD)ticks * 1000 / 60;
215f01c2 [glm-5.2] #	Sleep(millis);
215f01c2 [glm-5.2] #}
215f01c3 [glm-5.2] #
215f01c3 [glm-5.2] #
215f01c3 [glm-5.2] #If you also want a generic millisecond sleep elsewhere
215f01c3 [glm-5.2] #
215f01c4 [glm-5.2] #
215f01c4 [glm-5.2] #static void md_sleep_ms(DWORD millis)
215f01c4 [glm-5.2] #{
215f01c4 [glm-5.2] #	Sleep(millis);
215f01c5 [glm-5.2] #}
215f01c5 [glm-5.2] #
215f01c5 [glm-5.2] #
215f01c5 [glm-5.2] #Notes
215f01c6 [glm-5.2] #
215f01c6 [glm-5.2] #- `Sleep(0)` yields the timeslice but returns immediately — fine for a zero-tick delay.
215f01c6 [glm-5.2] #- `Sleep()` is not precise to the millisecond on Windows (typical granularity is ~15ms), but it's
215f01c7 [glm-5.2] #far better than the current `while (j--)` spin loop.
215f01c7 [glm-5.2] #- If you need sub-15ms precision you'd need `timeBeginPeriod(1)` from `winmm.lib`, but for DIP game
215f01c7 [glm-5.2] #timing this is unnecessary.
215f01c7 [glm-5.2] #
215f01c8 [glm-5.2] #Want me to fold this into a full updated `md_delay` / `md_user_delay` section for `dip.c`?
215f01c8 [glm-5.2] #
