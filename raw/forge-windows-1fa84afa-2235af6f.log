20b351b9 [kimi-k2.7-code] #
20b351ba [kimi-k2.7-code] #╭─────────┬─────────────────┬────────────────────────────────────────────╮
20b351ba [kimi-k2.7-code] #│  Pin    │  Signal         │  Description                               │
20b351ba [kimi-k2.7-code] #├─────────┼─────────────────┼────────────────────────────────────────────┤
20b351ba [kimi-k2.7-code] #│  1      │  **RED**        │  Red video                                 │
20b351bb [kimi-k2.7-code] #│  2      │  **GREEN**      │  Green video                               │
20b351bb [kimi-k2.7-code] #│  3      │  **BLUE**       │  Blue video                                │
20b351bb [kimi-k2.7-code] #│  4      │  **ID2 / RES**  │  Monitor ID bit 2 (often unused/reserved)  │
20b351bb [kimi-k2.7-code] #│  5      │  **GND**        │  Ground (H-sync return)                    │
20b351bc [kimi-k2.7-code] #│  6      │  **RED RTN**    │  Red return/ground                         │
20b351bc [kimi-k2.7-code] #│  7      │  **GREEN RTN**  │  Green return/ground                       │
20b351bc [kimi-k2.7-code] #│  8      │  **BLUE RTN**   │  Blue return/ground                        │
20b351bc [kimi-k2.7-code] #│  9      │  **+5 V**       │  +5 V DC (fused, DDC supply)               │
20b351bd [kimi-k2.7-code] #│  10     │  **GND**        │  Ground (sync return)                      │
20b351bd [kimi-k2.7-code] #│  11     │  **ID0 / RES**  │  Monitor ID bit 0 (often unused/reserved)  │
20b351bd [kimi-k2.7-code] #│  12     │  **SDA**        │  DDC/EDID I²C data                         │
20b351bd [kimi-k2.7-code] #│  13     │  **H-SYNC**     │  Horizontal sync                           │
20b351be [kimi-k2.7-code] #│  14     │  **V-SYNC**     │  Vertical sync                             │
20b351be [kimi-k2.7-code] #│  15     │  **SCL**        │  DDC/EDID I²C clock                        │
20b351be [kimi-k2.7-code] #│  Shell  │  **Shield**     │  Chassis/shield ground                     │
20b351be [kimi-k2.7-code] #╰─────────┴─────────────────┴────────────────────────────────────────────╯
20b351bf [kimi-k2.7-code] #
20b351bf [kimi-k2.7-code] #Key notes
20b351bf [kimi-k2.7-code] #- RGB lines are 75 Ω impedance coaxial signals.
