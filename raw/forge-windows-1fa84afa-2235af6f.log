215f0423 [glm-5.2] # ꔀ Relay 1.9.3 glm-5.2 Z 🪣  0.7° $0.195 468.0KB 13.75s
215f0423 [glm-5.2] #A `LEAN_AND_MEAN` flag is a clean way to strip out debugging, verbose output, and non-essential
215f0423 [glm-5.2] #features at compile time. Here's how to wire it into the project:
215f0424 [glm-5.2] #
215f0424 [glm-5.2] #At the top of `dip.c`
215f0424 [glm-5.2] #
215f0424 [glm-5.2] #
215f0424 [glm-5.2] ##ifdef LEAN_AND_MEAN
215f0425 [glm-5.2] #	#undef _DEBUG
215f0425 [glm-5.2] #	#define _DEBUG 0
215f0425 [glm-5.2] #	#define ETRAP 0
215f0425 [glm-5.2] ##endif
215f0425 [glm-5.2] #
215f0426 [glm-5.2] #
215f0426 [glm-5.2] #In `dipdefs.h` (or at top of `dip.c`)
215f0426 [glm-5.2] #
215f0426 [glm-5.2] #
215f0427 [glm-5.2] ##ifndef LEAN_AND_MEAN
215f0427 [glm-5.2] #	#define ETRAP 1
215f0427 [glm-5.2] ##else
215f0427 [glm-5.2] #	#ifndef ETRAP
215f0428 [glm-5.2] #		#define ETRAP 0
215f0428 [glm-5.2] #	#endif
215f0428 [glm-5.2] ##endif
215f0429 [glm-5.2] #
215f0429 [glm-5.2] #
215f0429 [glm-5.2] #In `CMakeLists.txt`
215f0429 [glm-5.2] #
215f042a [glm-5.2] #
215f042a [glm-5.2] #option(LEAN_AND_MEAN "Strip debug and error trapping for a minimal build" OFF)
215f042a [glm-5.2] #
215f042a [glm-5.2] #if(LEAN_AND_MEAN)
215f042b [glm-5.2] #	add_compile_definitions(LEAN_AND_MEAN)
215f042b [glm-5.2] #endif()
215f042b [glm-5.2] #
215f042b [glm-5.2] #
215f042c [glm-5.2] #What it disables
215f042c [glm-5.2] #
215f042c [glm-5.2] #╭──────────────────────────────────────────────────────┬─────────────────┬────────────────────────────────────────────────────╮
215f042d [glm-5.2] #│  Feature                                             │  Controlled by  │  Effect                                            │
215f042d [glm-5.2] #├──────────────────────────────────────────────────────┼─────────────────┼────────────────────────────────────────────────────┤
215f042d [glm-5.2] #│  Debugger (`debugger()`, `dinfo()`, `dump()`, etc.)  │  `_DEBUG`       │  Removes ~400 lines of debugger code               │
215f042d [glm-5.2] #│  Error trapping checks                               │  `ETRAP`        │  Skips bounds checks in `showrow`, `md_drawblock`  │
215f042d [glm-5.2] #│  Verbose printf in `verify()`, `fatal()`             │  `_DEBUG`       │  Quieter fatal errors                              │
215f042e [glm-5.2] #╰──────────────────────────────────────────────────────┴─────────────────┴────────────────────────────────────────────────────╯
215f042e [glm-5.2] #
215f042e [glm-5.2] #Build usage
215f042e [glm-5.2] #
215f042e [glm-5.2] #
215f042e [glm-5.2] #cmake -G "Ninja" .. -DLEAN_AND_MEAN=ON
215f042f [glm-5.2] #
215f042f [glm-5.2] #
215f042f [glm-5.2] #Or just add it to your compile flags:
215f042f [glm-5.2] #
215f0430 [glm-5.2] #
215f0430 [glm-5.2] #cmake --build . -- -j 1
215f0430 [glm-5.2] #
215f0430 [glm-5.2] #
215f0431 [glm-5.2] #with `add_compile_options(-DLEAN_AND_MEAN)` in CMakeLists.txt.
215f0431 [glm-5.2] #
215f0431 [glm-5.2] #What stays
215f0431 [glm-5.2] #
