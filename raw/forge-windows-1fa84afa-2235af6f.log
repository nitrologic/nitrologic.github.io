21872370 [glm-5.2] #Yes — `GetKeyboardState()` fills a 256-byte array with the state of every virtual key in one call.
21872370 [glm-5.2] #Each byte corresponds to a key code (0–255), and the high bit (`0x80`) means that key is currently
21872370 [glm-5.2] #down.
21872370 [glm-5.2] #
21872370 [glm-5.2] #
21872371 [glm-5.2] #bool isAnyKeyDown(){
21872371 [glm-5.2] #	BYTE keys[256];
21872371 [glm-5.2] #	if(!GetKeyboardState(keys)) return false;
21872371 [glm-5.2] #	for(int i = 0; i < 256; i++){
21872372 [glm-5.2] #		if(keys[i] & 0x80) return true;
21872372 [glm-5.2] #	}
21872372 [glm-5.2] #	return false;
21872372 [glm-5.2] #}
21872373 [glm-5.2] #
21872373 [glm-5.2] #
21872373 [glm-5.2] #To check a specific key from the array:
21872373 [glm-5.2] #
21872374 [glm-5.2] #
21872374 [glm-5.2] #bool isEscapeDown(){
21872374 [glm-5.2] #	BYTE keys[256];
21872374 [glm-5.2] #	if(!GetKeyboardState(keys)) return false;
21872375 [glm-5.2] #	return (keys[VK_ESCAPE] & 0x80) != 0;
21872375 [glm-5.2] #}
21872375 [glm-5.2] #
21872376 [glm-5.2] #
21872376 [glm-5.2] #One caveat: `GetKeyboardState` reflects the keyboard state as seen by the calling thread's message
21872376 [glm-5.2] #queue, so it works best when your process has a console window with focus. `GetAsyncKeyState` polls
21872376 [glm-5.2] #the hardware directly and works regardless of focus, so for a simple "press escape to quit" in a
21872376 [glm-5.2] #console app, your current `GetAsyncKeyState` approach is actually the more reliable choice.
21872377 [glm-5.2] #`GetKeyboardState` is the better pick when you want to read multiple keys simultaneously (e.g.
21872377 [glm-5.2] #checking for key combinations or reading a full chord).
21872377 [glm-5.2] #
21874814 [glm-5.2] # ꔀ Relay 1.9.4 glm-5.2 Z 🪣  0.7° $0.167 369.0KB 21.30s
21874814 [glm-5.2] #A couple of issues with the new additions:
21874814 [glm-5.2] #
21874814 [glm-5.2] #• 1. `pollMessages()` will hang your loop.* `MsgWaitForMultipleObjects` with `INFINITE`
21874814 [glm-5.2] #blocks forever until a message arrives. Your main loop will stall there whenever the FIFO has no
21874814 [glm-5.2] #data.
21874815 [glm-5.2] #
21874815 [glm-5.2] #• 2. `MsgWaitForMultipleObjects` only signals that messages exist — it doesn't pump them.*
21874815 [glm-5.2] #You still need `PeekMessage`/`TranslateMessage`/`DispatchMessage` to actually process them and
21874815 [glm-5.2] #update the keyboard state that `GetKeyboardState` reads.
21874816 [glm-5.2] #
21874816 [glm-5.2] #Here is a corrected `pollMessages()` that uses a zero timeout (non-blocking) and actually pumps the
21874816 [glm-5.2] #queue:
21874816 [glm-5.2] #
21874816 [glm-5.2] #
21874817 [glm-5.2] #void pollMessages(){
21874817 [glm-5.2] #	MSG msg;
21874817 [glm-5.2] #	while(PeekMessage(&msg, NULL, 0, 0, PM_REMOVE)){
21874817 [glm-5.2] #		TranslateMessage(&msg);
21874817 [glm-5.2] #		DispatchMessage(&msg);
21874817 [glm-5.2] #	}
21874818 [glm-5.2] #}
21874818 [glm-5.2] #
21874818 [glm-5.2] #
21874818 [glm-5.2] #That said, in a console application `GetKeyboardState` may still return stale or empty data because
21874818 [glm-5.2] #the console window's input is managed by the console subsystem, not your thread's message queue. If
21874819 [glm-5.2] #you find `anyKeyDown()` always returns false, `GetAsyncKeyState` (which you are already using for
21874819 [glm-5.2] #escape) is the reliable option — you could scan all 256 keys with it instead:
21874819 [glm-5.2] #
21874819 [glm-5.2] #
21874819 [glm-5.2] #bool anyKeyDown(){
2187481a [glm-5.2] #	for(int i = 0; i < 256; i++){
2187481a [glm-5.2] #		if(GetAsyncKeyState(i) & 0x8000) return true;
2187481a [glm-5.2] #	}
2187481a [glm-5.2] #	return false;
2187481a [glm-5.2] #}
2187481b [glm-5.2] #
2187481b [glm-5.2] #
2187481b [glm-5.2] #This polls hardware directly, no message pump required, and you can drop `pollMessages()` entirely.
2187481b [glm-5.2] #
