214a75b8 [grok-build-0.1] # ꔀ Relay 1.9.1 grok-build-0.1 𝕏 🪣  0.7° $0.071 226.5KB 9.98s
214a75b8 [grok-build-0.1] #• No default argument would make sense here.*
214a75b8 [grok-build-0.1] #
214a75b9 [grok-build-0.1] #Why
214a75b9 [grok-build-0.1] #
214a75b9 [grok-build-0.1] #`getvar()` is a function that must be told which variable to read. It takes a
214a75b9 [grok-build-0.1] #`ZIPBYT` (the variable number):
214a75b9 [grok-build-0.1] #
214a75ba [grok-build-0.1] #- `0` = top of Z-stack
214a75ba [grok-build-0.1] #- `1–15` = local variables
214a75ba [grok-build-0.1] #- `16+` = globals
214a75ba [grok-build-0.1] #
214a75bb [grok-build-0.1] #There is no logical "default" value that would be safe or meaningful. Every call site already
214a75bb [grok-build-0.1] #passes an explicit argument (e.g. `getvar(argblk[1])`).
214a75bb [grok-build-0.1] #
214a75bb [grok-build-0.1] #What the old line was actually doing
214a75bc [grok-build-0.1] #
214a75bc [grok-build-0.1] #This line:
214a75bc [grok-build-0.1] #
