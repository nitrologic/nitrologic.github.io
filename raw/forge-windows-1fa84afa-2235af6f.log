213f4a21 [grok-build-0.1] #
213f4a21 [grok-build-0.1] #
213f4a21 [grok-build-0.1] #2. Blank line using `echo.`
213f4a22 [grok-build-0.1] #
213f4a22 [grok-build-0.1] #
213f4a22 [grok-build-0.1] #@echo off
213f4a22 [grok-build-0.1] #echo Hello
213f4a23 [grok-build-0.1] #echo.
213f4a23 [grok-build-0.1] #echo World
213f4a23 [grok-build-0.1] #
213f4a24 [grok-build-0.1] #
213f4a24 [grok-build-0.1] #3. Embedding a newline in a variable (most useful trick)
213f4a24 [grok-build-0.1] #
