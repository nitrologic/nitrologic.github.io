215e313e [grok-build-0.1] #Why it's a bad idea
215e313f [grok-build-0.1] #
215e313f [grok-build-0.1] #╭───────────────────────────────────┬─────────────────────────────────┬────────────────────────────╮
215e313f [grok-build-0.1] #│  `open()` (current code)          │  `fopen()`                      │  Problem                   │
215e3140 [grok-build-0.1] #├───────────────────────────────────┼─────────────────────────────────┼────────────────────────────┤
215e3140 [grok-build-0.1] #│  Returns `int` (file descriptor)  │  Returns `FILE*`                │  Type mismatch everywhere  │
215e3140 [grok-build-0.1] #│  `read(fd, buf, n)`               │  `fread(buf, 1, n, fp)`         │  Different API             │
215e3140 [grok-build-0.1] #│  `write(fd, buf, n)`              │  `fwrite(...)`                  │  Different API             │
215e3141 [grok-build-0.1] #│  `lseek(fd, off, whence)`         │  `fseek(fp, off, whence)`       │  Different API             │
215e3141 [grok-build-0.1] #│  `creat()`                        │  `fopen(..., "wb")`             │  Different                 │
215e3141 [grok-build-0.1] #│  `close(fd)`                      │  `fclose(fp)`                   │  Different                 │
215e3141 [grok-build-0.1] #╰───────────────────────────────────┴─────────────────────────────────┴────────────────────────────╯
215e3142 [grok-build-0.1] #
