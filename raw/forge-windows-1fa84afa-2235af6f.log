2136179c [grok-build-0.1] #if (roha.config.starshare && (stars.length === 0)) isShared = false;
2136179c [grok-build-0.1] #
2136179d [grok-build-0.1] #if (modified || !isShared) {
2136179d [grok-build-0.1] #    let ok = await shareBlob(path, size, tag);
2136179d [grok-build-0.1] #    ...
2136179d [grok-build-0.1] #    if (!rohaSharePaths.includes(path)) {
