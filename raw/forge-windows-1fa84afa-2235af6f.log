22329561 [gemini-3.1-flash-lite] #		console.log(`Hello, ${this.name}!`);
22329561 [gemini-3.1-flash-lite] #	}
22329561 [gemini-3.1-flash-lite] #}
22329561 [gemini-3.1-flash-lite] #
22329562 [gemini-3.1-flash-lite] #
22329562 [gemini-3.1-flash-lite] #2. The Main File (`main.ts`)
22329562 [gemini-3.1-flash-lite] #Import the class using the relative path to the file. Note that in Deno, you must include the file
22329562 [gemini-3.1-flash-lite] #extension (e.g., `.ts`).
22329562 [gemini-3.1-flash-lite] #
22329563 [gemini-3.1-flash-lite] #
22329563 [gemini-3.1-flash-lite] #import { User } from "./User.ts";
22329563 [gemini-3.1-flash-lite] #
