213f3058 [grok-build-0.1] #• Review of `transmitcoms.cpp` (0.1)*
213f3058 [grok-build-0.1] #
213f3058 [grok-build-0.1] #Current issues / observations:
213f3058 [grok-build-0.1] #
213f3058 [grok-build-0.1] #1. Resource leak
213f3058 [grok-build-0.1] #   `closeComPort(h)` is commented out. You should close the handle after writing.
213f3059 [grok-build-0.1] #
213f3059 [grok-build-0.1] #2. Duplicate line
213f3059 [grok-build-0.1] #
213f3059 [grok-build-0.1] #   // byteData boot = toBytes("\nBOOT\n");
213f3059 [grok-build-0.1] #   byteData boot = toBytes("\nBOOT\n");
213f305a [grok-build-0.1] #
213f305a [grok-build-0.1] #   The commented line can be removed.
213f305a [grok-build-0.1] #
213f305a [grok-build-0.1] #3. No write result checking
213f305b [grok-build-0.1] #   `writeComPort(h, boot)` has no return value check. It would be useful to know if the write
213f305b [grok-build-0.1] #actually succeeded.
213f305b [grok-build-0.1] #
213f305b [grok-build-0.1] #4. Verbose noise
213f305b [grok-build-0.1] #   Printing "ignoring" for every non-matching port can become very noisy when there are many COM
213f305c [grok-build-0.1] #ports.
213f305c [grok-build-0.1] #
213f305c [grok-build-0.1] #5. Hardcoded magic values
213f305c [grok-build-0.1] #   The VID prefix and the boot command are embedded directly in `main`. This makes the tool less
213f305d [grok-build-0.1] #reusable.
213f305d [grok-build-0.1] #
213f305d [grok-build-0.1] #6. Minor style
213f305e [grok-build-0.1] #   `toBytes` is fine, but the logic in `main` is doing too many things at once (filtering + opening
213f305e [grok-build-0.1] #+ writing).
213f305e [grok-build-0.1] #
213f305e [grok-build-0.1] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
213f305e [grok-build-0.1] #
