22ccf95c [grok-build-0.1] #Better options for your emoji string
22ccf95c [grok-build-0.1] #
22ccf95c [grok-build-0.1] #Your string contains emojis (which are made of surrogate pairs). `charAt(0)`, `[0]`, and `at(0)`
22ccf95d [grok-build-0.1] #will return broken characters (just the first half of the emoji).
22ccf95d [grok-build-0.1] #
