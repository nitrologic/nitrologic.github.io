241b79cd [deepseek-v4-flash] #- INPUT – Read a value from the keyboard.
241b79cd [deepseek-v4-flash] #
241b79cd [deepseek-v4-flash] ### Variable Assignment
241b79cd [deepseek-v4-flash] #- LET – Assign a value to a variable.
241b79cd [deepseek-v4-flash] #
241b79cd [deepseek-v4-flash] ### Program Flow
241b79cd [deepseek-v4-flash] #- IF … THEN – Conditional execution.
241b79cd [deepseek-v4-flash] #- FOR … NEXT – Create a counting loop.
241b79cd [deepseek-v4-flash] #- GOSUB … RETURN – Branch to a subroutine and return.
241b79cd [deepseek-v4-flash] #- GOTO – Unconditional jump to a line number.
241b79cd [deepseek-v4-flash] #- END – Terminate program execution.
241b79cd [deepseek-v4-flash] #- STOP – Halt execution (similar to END, but often used for debugging).
241b79cd [deepseek-v4-flash] #
