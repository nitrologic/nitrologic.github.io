241b4073 [deepseek-v4-flash] #🟠nitrologic Relay 1.9.9 deepseek-v4-flash 🐋 🪠 0.7° $0.000 2.193KB 7.66s
241b4073 [deepseek-v4-flash] #Certainly. Here are the 17 Integer BASIC commands grouped by their primary function:
241b4073 [deepseek-v4-flash] #
241b4073 [deepseek-v4-flash] #1. Program Flow Control
241b4073 [deepseek-v4-flash] #- END – Terminate program execution.
241b4073 [deepseek-v4-flash] #- FOR … NEXT – Create a counting loop.
241b4073 [deepseek-v4-flash] #- GOSUB … RETURN – Branch to a subroutine and return.
241b4073 [deepseek-v4-flash] #- GOTO – Unconditional jump to a line number.
241b4073 [deepseek-v4-flash] #- IF … THEN – Conditional execution.
241b4073 [deepseek-v4-flash] #- STOP – Halt execution (similar to END, but often used for debugging).
241b4073 [deepseek-v4-flash] #
241b4073 [deepseek-v4-flash] #2. Input / Output
241b4073 [deepseek-v4-flash] #- INPUT – Read a value from the keyboard.
241b4073 [deepseek-v4-flash] #- PRINT – Output text or values to the screen.
241b4073 [deepseek-v4-flash] #- LIST – Display the program listing.
241b4074 [deepseek-v4-flash] #- LOAD – Load a program from cassette tape.
241b4074 [deepseek-v4-flash] #- SAVE – Save a program to cassette tape.
241b4074 [deepseek-v4-flash] #
241b4074 [deepseek-v4-flash] #3. Variable Assignment
241b4074 [deepseek-v4-flash] #- LET – Assign a value to a variable (the word `LET` was optional in Integer BASIC, but it
241b4074 [deepseek-v4-flash] #is a valid command).
241b4074 [deepseek-v4-flash] #
241b4074 [deepseek-v4-flash] #4. Program Management
241b4074 [deepseek-v4-flash] #- NEW – Erase the current program and clear variables.
241b4074 [deepseek-v4-flash] #- RUN – Start execution of the current program.
241b4074 [deepseek-v4-flash] #
241b4074 [deepseek-v4-flash] #5. Comments / Documentation
241b4074 [deepseek-v4-flash] #- REM – Insert a remark (ignored during execution).
241b4074 [deepseek-v4-flash] #
241b4074 [deepseek-v4-flash] #Breakdown by mode
241b4074 [deepseek-v4-flash] #Note that LIST, NEW, RUN, LOAD, and SAVE are
241b4074 [deepseek-v4-flash] #immediate-mode commands (typed without a line number). The others can be used both in
241b4074 [deepseek-v4-flash] #immediate mode and inside a program (with line numbers).
241b4074 [deepseek-v4-flash] #
