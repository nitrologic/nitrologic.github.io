23748fe4 [deepseek-v4-flash] #
2374a066 [simon@midnightblue.local] on apple 2 what keycode for backspace?
2374a0e2 [deepseek-v4-flash] #🟠nitrologic Relay 1.9.5 deepseek-v4-flash 🐋 🪠 0.7° $0.000 1.609KB 7.33s
2374a0e2 [deepseek-v4-flash] #On the Apple II, the backspace key (often labeled with a left arrow ←) generates the ASCII
2374a0e2 [deepseek-v4-flash] #code 8 (decimal), which is the control-H character (BS – backspace). In Applesoft BASIC,
2374a0e2 [deepseek-v4-flash] #you can detect it with something like:
2374a0e2 [deepseek-v4-flash] #
2374a0e2 [deepseek-v4-flash] #
2374a0e2 [deepseek-v4-flash] #10 K = PEEK (-16384) : REM read keyboard strobe
2374a0e2 [deepseek-v4-flash] #20 IF K = 140 THEN PRINT "BACKSPACE" : REM 140 = 8 + 128 (high bit set)
2374a0e2 [deepseek-v4-flash] #
2374a0e2 [deepseek-v4-flash] #
2374a0e2 [deepseek-v4-flash] #or simply check for `K = 8` after clearing the high bit.
2374a0e2 [deepseek-v4-flash] #
2374a0e2 [deepseek-v4-flash] #If you are using assembly or machine language, the keyboard input at C000 will return 88 (136
2374a0e2 [deepseek-v4-flash] #decimal) for backspace (value 8 with bit 7 set), and you clear bit 7 to get the actual ASCII code
2374a0e2 [deepseek-v4-flash] #8.
2374a0e2 [deepseek-v4-flash] #
2374a9ad [simon@midnightblue.local] in my emulator backspace is moving cursor back correctly
2374aa18 [simon@midnightblue.local] but chars remain to the right
2374ac36 [deepseek-v4-flash] #🟠nitrologic Relay 1.9.5 deepseek-v4-flash 🐋 🪠 0.7° $0.004 75.38KB 31.87s
2374ac36 [deepseek-v4-flash] #The issue is that your emulator's keyboard input is not reaching the Apple II ROM.
2374ac36 [deepseek-v4-flash] #When you press backspace, your host terminal moves the cursor, but the emulated Apple II
2374ac36 [deepseek-v4-flash] #never sees the key.
2374ac36 [deepseek-v4-flash] #Characters remain because the ROM hasn't been asked to erase them.
2374ac36 [deepseek-v4-flash] #
2374ac36 [deepseek-v4-flash] #You need to:
2374ac36 [deepseek-v4-flash] #
2374ac36 [deepseek-v4-flash] #1. Forward keystrokes from `pollInput()` to the Apple II’s keyboard latch (`$C000`).
2374ac36 [deepseek-v4-flash] #2. Handle `$C010` to clear the keyboard strobe.
2374ac36 [deepseek-v4-flash] #3. Use the correct Apple II keyboard protocol – set bit 7 (ready flag) alongside the ASCII
2374ac36 [deepseek-v4-flash] #code.
2374ac36 [deepseek-v4-flash] #
2374ac36 [deepseek-v4-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2374ac36 [deepseek-v4-flash] #
2374ac36 [deepseek-v4-flash] #1. Current problem in `main` loop
2374ac36 [deepseek-v4-flash] #
2374ac36 [deepseek-v4-flash] #Your main loop receives bytes but never writes them to `game.memory` or `game.input`:
2374ac36 [deepseek-v4-flash] #
2374ac36 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #for(let bytes of input){
2374ac37 [deepseek-v4-flash] #    // ... only logs, does NOT set keyboard latch
2374ac37 [deepseek-v4-flash] #    switch(key){
2374ac37 [deepseek-v4-flash] #        case 27: running=false; break;
2374ac37 [deepseek-v4-flash] #        case 100: // 'D' – dump screen
2374ac37 [deepseek-v4-flash] #        // ... no case for regular typing
2374ac37 [deepseek-v4-flash] #        default: console.log("bytes:",bytes.length,"key:",key);
2374ac37 [deepseek-v4-flash] #    }
2374ac37 [deepseek-v4-flash] #}
2374ac37 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #2. Fix: inject keypress into Apple II
2374ac37 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #Replace that inner loop with something that writes the key ASCII (with bit 7 set) into `$C000`:
2374ac37 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #for(let bytes of input){
2374ac37 [deepseek-v4-flash] #    const key = bytes[0];
2374ac37 [deepseek-v4-flash] #    if (key === 27) { running = false; break; }
2374ac37 [deepseek-v4-flash] #
2374ac37 [deepseek-v4-flash] #    // Send the key to the Apple II keyboard latch
2374ac37 [deepseek-v4-flash] #    // Bit 7 = 1 indicates a key is waiting; bits 0-6 = ASCII (upper case)
2374ac37 [deepseek-v4-flash] #    const appleKey = (key >= 0x61 && key <= 0x7A) ? (key & 0xDF) : key; // force upper case
2374ac37 [deepseek-v4-flash] #    game.memory[0xC000] = 0x80 | (appleKey & 0x7F);
2374ac37 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #    // For debugging, you can also print the key
2374ac38 [deepseek-v4-flash] #    console.log("key sent:", String.fromCharCode(appleKey));
2374ac38 [deepseek-v4-flash] #}
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #• Important*: The Apple II ROM expects only 7-bit ASCII with bit 7 set; it clears the
2374ac38 [deepseek-v4-flash] #strobe when `$C010` is read.
2374ac38 [deepseek-v4-flash] #Your current `readAddress` for `C0xx` uses `input[address&3]`, so reads of `C010` also come from
2374ac38 [deepseek-v4-flash] #the same array. That must be changed.
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #3. Update `readAddress` for Apple II I/O
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #In your `Machine.readAddress`, replace the `block==0xc00` handler with Apple‑II‑specific logic:
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #
2374ac38 [deepseek-v4-flash] #readAddress(address: number){
2374ac38 [deepseek-v4-flash] #    if ((address & 0xFF00) === 0x0C00) {
2374ac38 [deepseek-v4-flash] #        // Apple II I/O page
2374ac38 [deepseek-v4-flash] #        switch(address) {
2374ac38 [deepseek-v4-flash] #            case 0xC000: // Keyboard data
2374ac38 [deepseek-v4-flash] #                return this.memory[0xC000]; // includes bit 7
2374ac38 [deepseek-v4-flash] #            case 0xC010: // Clear keyboard strobe
2374ac39 [deepseek-v4-flash] #                this.memory[0xC000] &= 0x7F; // clear bit 7
2374ac39 [deepseek-v4-flash] #                return 0; // or whatever the original value was
2374ac39 [deepseek-v4-flash] #            // ... other soft switches (C030, C050–C057, C061–C070) can be added later
2374ac39 [deepseek-v4-flash] #            default:
2374ac39 [deepseek-v4-flash] #                // For unhandled addresses, return 0 to avoid hangs
2374ac39 [deepseek-v4-flash] #                return 0;
2374ac39 [deepseek-v4-flash] #        }
2374ac39 [deepseek-v4-flash] #    }
2374ac39 [deepseek-v4-flash] #    // rest of your readAddress (Atari POKEY, etc.)
2374ac39 [deepseek-v4-flash] #}
2374ac39 [deepseek-v4-flash] #
2374ac39 [deepseek-v4-flash] #
2374ac39 [deepseek-v4-flash] #• Why this matters*: Without a proper `$C010` handler, the ROM’s keyboard input routine
2374ac39 [deepseek-v4-flash] #will never clear the strobe, and it will keep reading the same key forever (infinite loop).
2374ac39 [deepseek-v4-flash] #Once `$C010` clears bit 7, the next `pollInput` will set a new key.
2374ac39 [deepseek-v4-flash] #
2374ac39 [deepseek-v4-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2374ac39 [deepseek-v4-flash] #
2374ac39 [deepseek-v4-flash] #4. Remove the old `input` array hack
2374ac39 [deepseek-v4-flash] #
2374ac39 [deepseek-v4-flash] #Your current `reset()` sets `this.input[0]=0x20|0x40;` – that’s not needed for Apple II.
2374ac39 [deepseek-v4-flash] #You can keep the input array for Atari games, but you must dispatch based on which ROM is
2374ac39 [deepseek-v4-flash] #active (Apple II vs Atari). For now, simply use `this.memory[0xC000]` directly.
2374ac39 [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #5. Test backspace
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #With the above changes, when you press the backspace key (ASCII 8), the Apple II ROM will:
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #1. See `C0C0` (actually C000 with bit 7 set) → detect key.
2374ac3a [deepseek-v4-flash] #2. Echo it as a backspace control character.
2374ac3a [deepseek-v4-flash] #3. Execute its own backspace handler (move cursor left, print space, move left again).
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #Your screen output will then show the character being erased by the ROM, not by your terminal.
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #Summary
2374ac3a [deepseek-v4-flash] #
2374ac3a [deepseek-v4-flash] #╭───────────────────────────────────────────┬───────────────────────────────────────────────────────────────────────┬──────────────────────────────────────────────────────────────╮
2374ac3a [deepseek-v4-flash] #│  Problem                                  │  Cause                                                                │  Fix                                                         │
