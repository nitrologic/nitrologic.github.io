241b7536 [deepseek-v4-flash] #
241b7536 [deepseek-v4-flash] ## Integer BASIC
241b7536 [deepseek-v4-flash] #
241b7536 [deepseek-v4-flash] ### Input / Output
241b7536 [deepseek-v4-flash] #- PRINT – Output text or values to the screen.
241b7536 [deepseek-v4-flash] #- INPUT – Read a value from the keyboard.
241b7536 [deepseek-v4-flash] #
241b7536 [deepseek-v4-flash] ### Variable Assignment
241b7536 [deepseek-v4-flash] #- LET – Assign a value to a variable.
241b7537 [deepseek-v4-flash] #
241b7537 [deepseek-v4-flash] ### Program Flow
241b7537 [deepseek-v4-flash] #- IF … THEN – Conditional execution.
241b7537 [deepseek-v4-flash] #- FOR … NEXT – Create a counting loop.
241b7537 [deepseek-v4-flash] #- GOSUB … RETURN – Branch to a subroutine and return.
241b7537 [deepseek-v4-flash] #- GOTO – Unconditional jump to a line number.
241b7537 [deepseek-v4-flash] #- END – Terminate program execution.
241b7537 [deepseek-v4-flash] #- STOP – Halt execution (similar to END, but often used for debugging).
241b7537 [deepseek-v4-flash] #
241b7537 [deepseek-v4-flash] ### Documentation
241b7537 [deepseek-v4-flash] #- REM – Insert a remark (ignored during execution).
241b7537 [deepseek-v4-flash] #
241b7537 [deepseek-v4-flash] ### Immediate Mode (System Commands)
241b7537 [deepseek-v4-flash] #- RUN – Start execution of the current program.
241b7537 [deepseek-v4-flash] #- LIST – Display the program listing.
241b7537 [deepseek-v4-flash] #- NEW – Erase the current program and clear variables.
241b7537 [deepseek-v4-flash] #- LOAD – Load a program from cassette tape.
241b7537 [deepseek-v4-flash] #- SAVE – Save a program to cassette tape.
241b7537 [deepseek-v4-flash] #
241b7537 [deepseek-v4-flash] ### Graphics
241b7537 [deepseek-v4-flash] #*None (Integer BASIC has no graphics commands; see Applesoft BASIC for HGR, HPLOT, etc.)*
241b7537 [deepseek-v4-flash] #
241b7537 [deepseek-v4-flash] #
241b7538 [deepseek-v4-flash] #If your intent was to produce a learning sequence rather than a complete reference, you
241b7538 [deepseek-v4-flash] #might prefer to teach `PRINT` and `INPUT` first, then `LET`, then simple flow control, then `REM`,
