2306bfd1 [simon@midnightblue.local] 			case 0x65: // ADC Zero Page				{					const addr=this.get8(pc + 1);					const value=this.memory[addr];					const st=this.registers[register.ST];					const carry=(st&1);					const decimal=(st&8)==8;					const a:number=this.registers[register.A];					const sum=a+value+carry;					const overflow=((~(a^value)&(a^sum))&0x80)!==0;					let result=sum;										if(decimal){						const lowNibble=(a & 0x0f) + (value & 0x0f) + carry;						if(lowNibble > 9){							result+=0x06;						}						if(result>0x99){							result+=0x60;						}					}					this.setCarry(result>0xff);					this.setOverflow(overflow);					this.registers[register.A]=result&0xff;					this.setStatus(this.registers[register.A]);					this.step(2);					return "ADC\t" + hex(addr);
