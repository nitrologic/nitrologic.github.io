245c3e5f [kimi-k3] #🟠nitrologic Relay 2.0.1 kimi-k3 🜁 🪠 🧊 $0.022 512B 47.64s
245c3e60 [kimi-k3] #The ANSI sequence for absolute cursor positioning is:
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #ESC[{row};{col}H
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #`ESC` is byte `0x1B`, written as `\x1b`, `\033`, or `\e` depending on the language. Rows and
245c3e60 [kimi-k3] #columns are 1-based, so `ESC[1;1H` is the top-left corner. The `f` terminator works the
245c3e60 [kimi-k3] #same as `H`.
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #Relative movement and related sequences:
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #╭─────────────────────┬────────────────────────────────────────────╮
245c3e60 [kimi-k3] #│  Sequence           │  Effect                                    │
245c3e60 [kimi-k3] #├─────────────────────┼────────────────────────────────────────────┤
245c3e60 [kimi-k3] #│  `ESC[{n}A`         │  up n rows                                 │
245c3e60 [kimi-k3] #│  `ESC[{n}B`         │  down n rows                               │
245c3e60 [kimi-k3] #│  `ESC[{n}C`         │  right n columns                           │
245c3e60 [kimi-k3] #│  `ESC[{n}D`         │  left n columns                            │
245c3e60 [kimi-k3] #│  `ESC[{n}G`         │  move to column n, same row                │
245c3e60 [kimi-k3] #│  `ESC[s` / `ESC[u`  │  save / restore cursor position            │
245c3e60 [kimi-k3] #│  `ESC[2J`           │  clear screen (often paired with `ESC[H`)  │
245c3e60 [kimi-k3] #╰─────────────────────┴────────────────────────────────────────────╯
245c3e60 [kimi-k3] #
245c3e60 [kimi-k3] #Examples:
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #print("\x1b[5;10HHello", end="")  # row 5, column 10
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #printf '\e[5;10HHello'
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #
245c3e61 [kimi-k3] #One caveat on Windows: modern terminals (Windows 10+) support these, but virtual terminal
245c3e61 [kimi-k3] #processing may need enabling. In Python, calling `os.system("")` once at startup does it, or use
245c3e61 [kimi-k3] #the `colorama` package which handles it automatically.
245c3e61 [kimi-k3] #
