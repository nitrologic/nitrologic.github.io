241e9b99 [kimi-k3] #│  `$C053`  │  mixed → `displayMode = MIXED`                      │
241e9b99 [kimi-k3] #│  `$C056`  │  lores select (vs `$C057` hires)                    │
241e9b99 [kimi-k3] #╰───────────┴─────────────────────────────────────────────────────╯
