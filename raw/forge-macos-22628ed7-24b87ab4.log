241e30b7 [kimi-k3] #Good question — the standard spelling is nibble (with an i). "Nyble" or "nybble"
241e30b7 [kimi-k3] #with a y shows up occasionally in older hacker writing (Jargon File-era playfulness, same
241e30b7 [kimi-k3] #instinct that gave us "byte" instead of "bite"), but the mainstream spelling across datasheets,
241e30b7 [kimi-k3] #textbooks, and modern code is nibble. So: `hiNibble`/`loNibble` if you're naming variables.
241e30b7 [kimi-k3] #
241e30b8 [kimi-k3] #For the lookup table, the pieces you need:
241e30b8 [kimi-k3] #
241e30b8 [kimi-k3] #• The 16 Apple II lores colours*, as ANSI truecolour approximations. The canonical RGB
241e30b8 [kimi-k3] #values (widely used by AppleWin and others):
241e30b8 [kimi-k3] #
241e30b8 [kimi-k3] #
241e30b8 [kimi-k3] #const appleColors = [
241e30b8 [kimi-k3] #	[0, 0, 0],       // 0  black
241e30b8 [kimi-k3] #	[227, 30, 96],   // 1  magenta
241e30b8 [kimi-k3] #	[96, 78, 189],   // 2  dark blue
241e30b8 [kimi-k3] #	[255, 68, 253],  // 3  purple
241e30b8 [kimi-k3] #	[0, 163, 96],    // 4  dark green
241e30b8 [kimi-k3] #	[156, 156, 156], // 5  grey
241e30b8 [kimi-k3] #	[20, 207, 253],  // 6  medium blue
241e30b8 [kimi-k3] #	[208, 195, 255], // 7  light blue
241e30b8 [kimi-k3] #	[96, 114, 3],    // 8  brown
241e30b8 [kimi-k3] #	[255, 106, 60],  // 9  orange
241e30b8 [kimi-k3] #	[156, 156, 156], // 10 grey
241e30b8 [kimi-k3] #	[255, 160, 208], // 11 pink
241e30b8 [kimi-k3] #	[20, 245, 60],   // 12 green
241e30b8 [kimi-k3] #	[208, 221, 141], // 13 yellow
241e30b8 [kimi-k3] #	[114, 255, 208], // 14 aqua
241e30b8 [kimi-k3] #	[255, 255, 255], // 15 white
241e30b8 [kimi-k3] #];
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #• The block construction. Each byte is two vertically stacked blocks: low nibble on
241e30b9 [kimi-k3] #top (y even), high nibble on bottom* (y odd). One `▀` character carries both:
241e30b9 [kimi-k3] #foreground = top, background = bottom.
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #function initAppleBlocks() {
241e30b9 [kimi-k3] #	for (let i = 0; i < 256; i++) {
241e30b9 [kimi-k3] #		const top = i & 15;      // low nibble = upper block
241e30b9 [kimi-k3] #		const bottom = i >> 4;   // high nibble = lower block
241e30b9 [kimi-k3] #		const [tr, tg, tb] = appleColors[top];
241e30b9 [kimi-k3] #		const [br, bg, bb] = appleColors[bottom];
241e30b9 [kimi-k3] #		appleBlock[i] = `\x1b[38;2;${tr};${tg};${tb}m\x1b[48;2;${br};${bg};${bb}m▀`;
241e30b9 [kimi-k3] #	}
241e30b9 [kimi-k3] #}
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #The trailing `cursorRestore` in `displayAppleGraphics` then resets attributes once per frame rather
241e30b9 [kimi-k3] #than per cell, keeping the escape noise down.
241e30b9 [kimi-k3] #
241e30b9 [kimi-k3] #• One design note:* truecolour escape sequences are long (~40 chars per cell × 40 columns ×
241e30b9 [kimi-k3] #24 rows ≈ 38 KB per frame). If the terminal flickers, the fallback is the 216-colour cube of ANSI
241e30b9 [kimi-k3] #256-colour mode (`\x1b[38;5;Nm`), which is much shorter and close enough for these 16 saturated
241e30ba [kimi-k3] #colours.
241e30ba [kimi-k3] #
241e30ba [kimi-k3] #Also worth remembering: since the two nibbles of a byte frequently match (solid rows of colour,
241e30ba [kimi-k3] #e.g. `COLOR=1; HLIN 0,39 AT 20` writes bytes like `0x11`), a large fraction of your cells will be
241e30ba [kimi-k3] #fg == bg, where `█` with only a foreground escape would be shorter — but that's an optimisation for
241e30ba [kimi-k3] #later. Correctness first.
241e30ba [kimi-k3] #
