241b79cd [deepseek-v4-flash] #- REM – Insert a remark (ignored during execution).
241b79cd [deepseek-v4-flash] #
241b79cd [deepseek-v4-flash] ### Graphics (Low‑Resolution)
241b79cd [deepseek-v4-flash] #- GR – Enter low‑resolution graphics mode.
241b79cd [deepseek-v4-flash] #- TEXT – Return to text mode.
241b79cd [deepseek-v4-flash] #- COLOR – Set the drawing colour (0–15).
241b79cd [deepseek-v4-flash] #- PLOT – Plot a single block at (x, y).
241b79cd [deepseek-v4-flash] #- HLIN – Draw a horizontal line.
241b79cd [deepseek-v4-flash] #- VLIN – Draw a vertical line.
241b79cd [deepseek-v4-flash] #- SCRN – Read the colour of a block (function).
241b79ce [deepseek-v4-flash] #
241b79ce [deepseek-v4-flash] ### Immediate Mode (System Commands)
241b79ce [deepseek-v4-flash] #- RUN – Start execution.
241b79ce [deepseek-v4-flash] #- LIST – Display program listing.
241b79ce [deepseek-v4-flash] #- NEW – Erase program and variables.
