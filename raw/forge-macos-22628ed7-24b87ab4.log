22e05d07 [grok-build-0.1] #🟠nitrologic Relay 1.9.5 grok-build-0.1 𝕏 🪠 0.7° $0.012 39.12KB 13.61s
22e05d07 [grok-build-0.1] #Here's my review of the current `machine.ts`:
22e05d07 [grok-build-0.1] #
22e05d07 [grok-build-0.1] #Overall Impression
22e05d07 [grok-build-0.1] #This is a surprisingly functional hand-written 6502 interpreter. The fact that you're already
22e05d08 [grok-build-0.1] #getting readable disassembly output with labels and memory visualization while running Centipede
22e05d08 [grok-build-0.1] #code is impressive. The structure is still readable even with the giant switch.
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #However, it's starting to show the classic problems of a large opcode switch: duplication,
22e05d08 [grok-build-0.1] #inconsistent flag handling, and some subtle bugs.
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #Issues Found
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #• 1. Duplicate case (`0xE4`)*
22e05d08 [grok-build-0.1] #You have `CPX Zero Page` implemented twice. The second one at the bottom will never be reached.
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #• 2. Redundant / conflicting Carry handling*
22e05d08 [grok-build-0.1] #In several places (especially `ASL A`), you're calling `setCarry()` and then immediately doing
22e05d08 [grok-build-0.1] #direct bit manipulation again:
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #let carry = (val >> 7) & 1;
22e05d08 [grok-build-0.1] #this.setCarry(carry);
22e05d08 [grok-build-0.1] #// ...
22e05d08 [grok-build-0.1] #if (carry) this.registers[register.ST] |= 0x01;
22e05d08 [grok-build-0.1] #else this.registers[register.ST] &= ~0x01;
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #This is fragile. `setCarry()` should be the single source of truth.
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #• 3. `setStatus()` behavior*
22e05d08 [grok-build-0.1] #Your `setStatus()` only touches Z and N. This is mostly fine, but you're calling it in places where
22e05d08 [grok-build-0.1] #you shouldn't overwrite other flags (like after ADC/SBC where you already set V and C manually).
22e05d08 [grok-build-0.1] #Currently it works because you set C/V before calling `setStatus()`, but it's easy to
22e05d08 [grok-build-0.1] #break.
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #• 4. JSR stack write is slightly off*
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #this.memory[0x0100 + sp] = high;
22e05d08 [grok-build-0.1] #this.registers[register.SP]--;
22e05d08 [grok-build-0.1] #this.memory[0x0100 + sp - 1] = low;  // using old sp value
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #This works, but it's confusing. Cleaner version:
22e05d08 [grok-build-0.1] #
22e05d08 [grok-build-0.1] #let sp = this.registers[register.SP];
