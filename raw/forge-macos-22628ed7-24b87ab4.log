241e9b99 [kimi-k3] #
241e9b99 [kimi-k3] #╭───────────┬─────────────────────────────────────────────────────╮
241e9b99 [kimi-k3] #│  Access   │  Effect                                             │
241e9b99 [kimi-k3] #├───────────┼─────────────────────────────────────────────────────┤
