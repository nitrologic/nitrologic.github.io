f932e4e [kimi-k2-0905] #
f932e4e [kimi-k2-0905] #Adding the explicit sysroot/clang/lld lines above just makes the build 100 % reproducible and
f932e4e [kimi-k2-0905] #guarantees the binary will run on your Pi 5’s Debian-12 userspace.
f932e4e [kimi-k2-0905] #
