10a0cb56 [gemini-3-pro] #
10a0cb56 [gemini-3-pro] #• Inputs (Reading 5V bus):*
10a0cb56 [gemini-3-pro] #Use Voltage Divider: IEC_PIN (5V) → 2.2kΩ → GPIO → 3.3kΩ → GND.
10a0cb56 [gemini-3-pro] #Logic: High (3.3V) = Bus Passive/1, Low (0V) = Bus Active/0.
10a0cb56 [gemini-3-pro] #
10a0cb56 [gemini-3-pro] #• Outputs (Writing to bus):*
10a0cb56 [gemini-3-pro] #Use 2N7000 FET.
10a0cb56 [gemini-3-pro] #Gate: GPIO (via 100Ω). Source: GND. Drain: IEC_PIN.
10a0cb56 [gemini-3-pro] #Logic: GPIO High = FET On = Bus Low (Active). GPIO Low = FET Off = Bus High (Passive).
