f9333bc [kimi-k2-0905] #On Amazon Linux 2/2023 the package manager is `dnf` (or `yum` wrapper), so:
f9333bc [kimi-k2-0905] #
f9333bc [kimi-k2-0905] #
f9333bc [kimi-k2-0905] #sudo dnf install -y clang lld gcc-aarch64-linux-gnu gcc-c++-aarch64-linux-gnu
f9333bc [kimi-k2-0905] #
