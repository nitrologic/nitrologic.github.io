f932038 [nitro@ryzen5] gn gen out.gn/x64.release --args='    is_component_build = false   # static libs    is_debug = false    v8_use_external_startup_data = false    v8_enable_i18n_support = false    treat_warnings_as_errors = false'autoninja -C out.gn/x64.release
f932144 [kimi-k2-0905] #The build you just ran produced x86-64 objects; nothing in that command line knows about
f932144 [kimi-k2-0905] #ARM.
f932144 [kimi-k2-0905] #To target a Pi 5 (AArch64) you need a second cross-compile build:
f932144 [kimi-k2-0905] #
f932144 [kimi-k2-0905] #1. Install the AArch64 toolchain ( Debian package `gcc-aarch64-linux-gnu` or download the
f932144 [kimi-k2-0905] #Clang/LLVM you prefer ).
f932144 [kimi-k2-0905] #2. Create an ARM64 out directory with the target CPU and host toolchain specified,
f932144 [kimi-k2-0905] #e.g.
f932144 [kimi-k2-0905] #
f932144 [kimi-k2-0905] #
f932144 [kimi-k2-0905] #gn gen out.gn/arm64.release --args='
f932144 [kimi-k2-0905] #    target_cpu = "arm64"
f932144 [kimi-k2-0905] #    is_component_build = false
f932144 [kimi-k2-0905] #    is_debug = false
f932144 [kimi-k2-0905] #    v8_use_external_startup_data = false
f932144 [kimi-k2-0905] #    v8_enable_i18n_support = false
f932144 [kimi-k2-0905] #    treat_warnings_as_errors = false
f932144 [kimi-k2-0905] #    is_clang = true                          # or false if you use GCC
f932144 [kimi-k2-0905] #    clang_base_path = "/usr"
f932144 [kimi-k2-0905] #    sysroot = "/path/to/aarch64-linux-gnu/sysroot"   # optional but recommended'
f932144 [kimi-k2-0905] #
f932144 [kimi-k2-0905] #
f932144 [kimi-k2-0905] #3. Build
f932145 [kimi-k2-0905] #
f932145 [kimi-k2-0905] #autoninja -C out.gn/arm64.release
f932145 [kimi-k2-0905] #
f932145 [kimi-k2-0905] #
f932145 [kimi-k2-0905] #The resulting static libraries and `d8` binary in `out.gn/arm64.release` are now AArch64 and can be
f932145 [kimi-k2-0905] #copied to the Pi 5.
f932145 [kimi-k2-0905] #
