107a2784 [nitro@ryzen5] LUMA2 - capture 2bit monochrome video such as C64 luma pin Pico 4 input pins CSYNC G0 G1 G2Fed by 2 x LM319 featuring 4 fast voltage comparatorsCSYNC based on fixed threshold, 2 gray and 1 white detector adjustable with trimmers.Simon to add Pico PIO code in which 4 GPIO digital inputs format output of 320 wide 240 high 50 hz 2 bit monochrome stream.
107a2c08 [kimi-k2-0905] #Here is a minimal PIO program that packs the four GPIO lines (CSYNC, G0, G1, G2) into one 2-bit
107a2c08 [kimi-k2-0905] #pixel every 8 µs (≈ 12.5 MHz) and streams the result to the CPU.
107a2c08 [kimi-k2-0905] #It is written for RP2040 SDK 2.x and assumes the four signals are on consecutive GPIOs starting at
107a2c08 [kimi-k2-0905] #BASE_PIN (change the define to suit your wiring).
107a2c08 [kimi-k2-0905] #
107a2c08 [kimi-k2-0905] #pico_luma.pio
107a2c08 [kimi-k2-0905] #
107a2c08 [kimi-k2-0905] #; 2-bit LUMA capture – 320 px / line, 240 lines / 50 Hz
107a2c08 [kimi-k2-0905] #; one state machine samples 4 pins every 8 µs and packs two pixels per 32-bit word
107a2c08 [kimi-k2-0905] #; word format:  [pixel1:2][pixel0:2] … packed little-endian
107a2c08 [kimi-k2-0905] #
107a2c08 [kimi-k2-0905] #.program luma_capture
107a2c08 [kimi-k2-0905] #.side_set 1 opt
107a2c08 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #public start:
107a2c09 [kimi-k2-0905] #    set x, 15            side 0      ; 16 pixels = 8 words per loop
107a2c09 [kimi-k2-0905] #pixel_loop:
107a2c09 [kimi-k2-0905] #    in pins, 4           side 0      ; sample CSYNC,G2,G1,G0 into ISR
107a2c09 [kimi-k2-0905] #    in null, 28                      ; pad to 32 bits (we only care about low 4)
107a2c09 [kimi-k2-0905] #    jmp x--, pixel_loop side 0
107a2c09 [kimi-k2-0905] #    push                 side 0      ; 32-bit word now in RX FIFO
107a2c09 [kimi-k2-0905] #    set x, 15            side 0
107a2c09 [kimi-k2-0905] #    jmp start            side 0
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #% c-sdk {
107a2c09 [kimi-k2-0905] #static inline void luma_capture_program_init(PIO pio, uint sm, uint offset, uint base_pin) {
107a2c09 [kimi-k2-0905] #    pio_sm_config c = luma_capture_program_get_default_config(offset);
107a2c09 [kimi-k2-0905] #    sm_config_set_in_pins(&c, base_pin);       // 4 consecutive pins
107a2c09 [kimi-k2-0905] #    sm_config_set_in_shift(&c, false, true, 32); // shift left, autopush every 32 bits
107a2c09 [kimi-k2-0905] #    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX); // one big RX FIFO
107a2c09 [kimi-k2-0905] #    pio_sm_init(pio, sm, offset, &c);
107a2c09 [kimi-k2-0905] #    pio_sm_set_enabled(pio, sm, true);
107a2c09 [kimi-k2-0905] #}
107a2c09 [kimi-k2-0905] #%}
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #luma_capture.h
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] ##pragma once
107a2c09 [kimi-k2-0905] ##include "hardware/pio.h"
107a2c09 [kimi-k2-0905] ##include "pico_luma.pio.h"   // generated header
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #void luma_capture_program_init(PIO pio, uint sm, uint offset, uint base_pin);
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] #main.c (excerpt – shows how to start the SM and pull pixels)
107a2c09 [kimi-k2-0905] #
107a2c09 [kimi-k2-0905] ##include "pico/stdlib.h"
107a2c09 [kimi-k2-0905] ##include "hardware/dma.h"
107a2c09 [kimi-k2-0905] ##include "luma_capture.h"
107a2c09 [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] ##define BASE_PIN  2          // CSYNC on GPIO2, G0=3, G1=4, G2=5
107a2c0a [kimi-k2-0905] ##define PIXELS_PER_LINE 320
107a2c0a [kimi-k2-0905] ##define LINES_PER_FRAME 240
107a2c0a [kimi-k2-0905] ##define PIXELS_PER_FRAME (PIXELS_PER_LINE * LINES_PER_FRAME)
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #static uint32_t capture_buf[PIXELS_PER_FRAME / 2]; // two pixels per 32-bit word
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #int main() {
107a2c0a [kimi-k2-0905] #    stdio_init_all();
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #    PIO pio = pio0;
107a2c0a [kimi-k2-0905] #    uint sm = 0;
107a2c0a [kimi-k2-0905] #    uint offset = pio_add_program(pio, &luma_capture_program);
107a2c0a [kimi-k2-0905] #    luma_capture_program_init(pio, sm, offset, BASE_PIN);
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #    // DMA channel to suck the FIFO dry continuously
107a2c0a [kimi-k2-0905] #    int dma_chan = dma_claim_unused_channel(true);
107a2c0a [kimi-k2-0905] #    dma_channel_config c = dma_channel_get_default_config(dma_chan);
107a2c0a [kimi-k2-0905] #    channel_config_set_transfer_data_size(&c, DMA_SIZE_32);
107a2c0a [kimi-k2-0905] #    channel_config_set_read_increment(&c, false);
107a2c0a [kimi-k2-0905] #    channel_config_set_write_increment(&c, true);
107a2c0a [kimi-k2-0905] #    channel_config_set_dreq(&c, pio_get_dreq(pio, sm, false));
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #    dma_channel_configure(
107a2c0a [kimi-k2-0905] #        dma_chan,
107a2c0a [kimi-k2-0905] #        &c,
107a2c0a [kimi-k2-0905] #        capture_buf,               // write address
107a2c0a [kimi-k2-0905] #        &pio->rxf[sm],             // read address (FIFO)
107a2c0a [kimi-k2-0905] #        PIXELS_PER_FRAME / 2,      // 32-bit transfers
107a2c0a [kimi-k2-0905] #        true                       // start immediately
107a2c0a [kimi-k2-0905] #    );
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #    while (true) {
107a2c0a [kimi-k2-0905] #        dma_channel_wait_for_finish_blocking(dma_chan);
107a2c0a [kimi-k2-0905] #        dma_channel_set_write_addr(dma_chan, capture_buf, true); // re-start
107a2c0a [kimi-k2-0905] #        // process capture_buf here (e.g. send over USB, store to SD, etc.)
107a2c0a [kimi-k2-0905] #    }
107a2c0a [kimi-k2-0905] #}
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #CMakeLists.txt (add these lines to your project)
107a2c0a [kimi-k2-0905] #
107a2c0a [kimi-k2-0905] #pico_generate_pio_header(luma_capture ${CMAKE_CURRENT_LIST_DIR}/pico_luma.pio)
107a2c0b [kimi-k2-0905] #target_sources(my_target PRIVATE
107a2c0b [kimi-k2-0905] #    main.c
107a2c0b [kimi-k2-0905] #    pico_luma.pio
107a2c0b [kimi-k2-0905] #)
107a2c0b [kimi-k2-0905] #
107a2c0b [kimi-k2-0905] #
107a2c0b [kimi-k2-0905] #Notes
107a2c0b [kimi-k2-0905] #- Sampling rate is set by the PIO clock divider (default = 1 → 125 MHz).
107a2c0b [kimi-k2-0905] #  To hit exactly 12.5 MHz pixel clock (8 µs per pixel) set divider to 10:
107a2c0b [kimi-k2-0905] #  `smconfigset_clkdiv(&c, 10);`
107a2c0b [kimi-k2-0905] #- Each 32-bit word contains two 2-bit pixels:
107a2c0b [kimi-k2-0905] #  `pixel0 = word & 3`, `pixel1 = (word >> 2) & 3`.
107a2c0b [kimi-k2-0905] #- CSYNC bit is captured but not used by the PIO; the ARM core can inspect it to detect line/field
107a2c0b [kimi-k2-0905] #sync if required.
