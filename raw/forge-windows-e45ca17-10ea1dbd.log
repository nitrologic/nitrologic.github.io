10d4b822 [gemini-3-pro] #Project LUMA2
10d4b822 [gemini-3-pro] #
10d4b822 [gemini-3-pro] #Purpose - capture 2bit monochrome video such as C64 luma pin
10d4b822 [gemini-3-pro] #Pico 4 input pins CSYNC G0 G1 G2 Fed by 2 x LM319 featuring 4 fast voltage comparators.
10d4b822 [gemini-3-pro] #CSYNC based on fixed threshold, 2 gray and 1 white detector adjustable with trimmers.
10d4b822 [gemini-3-pro] #Pico PIO code required to take 4 GPIO digital inputs.
10d4b822 [gemini-3-pro] #RP2040 then formats output frames of 320 wide 200 high 50 hz 2 bit monochrome.
10d4b822 [gemini-3-pro] #
10d4b822 [gemini-3-pro] #bom
10d4b822 [gemini-3-pro] #
10d4b822 [gemini-3-pro] #- 3x LM319 (6 channels = 1 sync + 5 grey) ($4.50)
10d4b822 [gemini-3-pro] #- 5x 10K Piher horizontal trimpot ($1.65)
