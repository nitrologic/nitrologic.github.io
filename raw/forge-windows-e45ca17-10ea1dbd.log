ebaddea [kimi-k2-0905] #Below is the shortest reliable path: stay on port 587, use your own SMTP relay (Gmail, Mailgun,
ebaddea [kimi-k2-0905] #SES, etc.) so Amazon’s port-25 throttle and missing PTR record don’t bite you.
ebaddea [kimi-k2-0905] #
ebaddea [kimi-k2-0905] #1. Prep the instance
ebaddea [kimi-k2-0905] #
ebaddea [kimi-k2-0905] #   sudo yum update -y
ebaddea [kimi-k2-0905] #   sudo yum install -y postfix cyrus-sasl-plain
ebaddea [kimi-k2-0905] #
ebaddea [kimi-k2-0905] #
ebaddea [kimi-k2-0905] #2. Open the port (if you restricted egress)
ebaddea [kimi-k2-0905] #   Security-group outbound: add 0.0.0.0/0 TCP 587 (or 465 if you prefer SMTPS).
ebaddea [kimi-k2-0905] #
ebaddea [kimi-k2-0905] #3. Create the relay password file
ebaddea [kimi-k2-0905] #
ebaddea [kimi-k2-0905] #   sudo bash -c 'cat > /etc/postfix/sasl_passwd' <<'EOF'
ebaddea [kimi-k2-0905] #   [smtp.gmail.com]:587    you@gmail.com:APP_PASSWORD
ebaddea [kimi-k2-0905] #   EOF
ebaddea [kimi-k2-0905] #   sudo postmap /etc/postfix/sasl_passwd
ebaddea [kimi-k2-0905] #   sudo chmod 600 /etc/postfix/sasl_passwd*
ebaddea [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #4. Point Postfix to the relay
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #   sudo postconf -e \
ebaddeb [kimi-k2-0905] #     "relayhost = [smtp.gmail.com]:587" \
ebaddeb [kimi-k2-0905] #     "smtp_sasl_auth_enable = yes" \
ebaddeb [kimi-k2-0905] #     "smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd" \
ebaddeb [kimi-k2-0905] #     "smtp_sasl_security_options = noanonymous" \
ebaddeb [kimi-k2-0905] #     "smtp_tls_security_level = encrypt"
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #5. Start and enable
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #   sudo systemctl enable --now postfix
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #6. Test
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #   echo 'relay test' | mail -s 'From EC2' someaddr@example.com
ebaddeb [kimi-k2-0905] #   sudo tail -f /var/log/maillog
ebaddeb [kimi-k2-0905] #
ebaddeb [kimi-k2-0905] #
