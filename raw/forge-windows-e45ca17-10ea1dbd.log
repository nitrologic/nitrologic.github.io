109f291f [gemini-3-pro] #    sm_config_set_in_pins(&c, GPIO_Q7_BASE);
109f291f [gemini-3-pro] #
109f291f [gemini-3-pro] #    // Map SET pin (SH/LD) to GP16
109f291f [gemini-3-pro] #    sm_config_set_set_pins(&c, GPIO_SHLD, 1);
109f291f [gemini-3-pro] #
