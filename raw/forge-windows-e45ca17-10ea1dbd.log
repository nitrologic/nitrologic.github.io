10bdb668 [claude-opus-4-5] #- 4× analog in (U10 AUX 0-3)
10bdb668 [claude-opus-4-5] #- 2× GPIO (GP9, GP22)
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #• 12-pin header (2×6):*
10bdb668 [claude-opus-4-5] #
