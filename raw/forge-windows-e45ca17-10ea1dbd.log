109f2920 [gemini-3-pro] #    pio_sm_set_enabled(pio, sm, true);
109f2920 [gemini-3-pro] #}
109f2920 [gemini-3-pro] #
109f2920 [gemini-3-pro] #
109f2920 [gemini-3-pro] #Revised BOM/Netlist Recommendation
109f2920 [gemini-3-pro] #
109f2920 [gemini-3-pro] #1.  Resolve GP10: Use GP10 for `/IRQ` (Output). Do not connect DOT to GP10.
109f2920 [gemini-3-pro] #2.  Resolve GP22: Keep GP22 for `/OE` (Transceiver Enable). Move `R/W` monitoring to the
109f2920 [gemini-3-pro] #shift register (Shift Reg 4.13 is already monitoring `/R/W`, so you might not need a dedicated edge
109f2920 [gemini-3-pro] #pin if your PIO loop is tight enough).
