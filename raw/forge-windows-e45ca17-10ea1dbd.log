e7b4434 [kimi-k2-0905] #        return;
e7b4434 [kimi-k2-0905] #    }
e7b4434 [kimi-k2-0905] #    std::string id = root.stringMember("id");
e7b4434 [kimi-k2-0905] #    ...
e7b4434 [kimi-k2-0905] #}
