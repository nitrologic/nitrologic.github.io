fa446d0 [kimi-k2-0905] #
fa446d0 [kimi-k2-0905] #Engine               Flash   RAM   32-bit bare-metal   Notes
fa446d0 [kimi-k2-0905] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
fa446d0 [kimi-k2-0905] #QuickJS              ~200 k  64 k  yes                  Full ES2020, no JIT, MIT
fa446d0 [kimi-k2-0905] #Duktape              ~150 k  56 k  yes                  ES5.1, refcount, MIT
fa446d0 [kimi-k2-0905] #MuJS                 ~100 k  32 k  yes                  ES5.1, C89, ISC
fa446d0 [kimi-k2-0905] #JerryScript          ~100 k  32 k  yes                  ES5.1, CMake, Apache-2
