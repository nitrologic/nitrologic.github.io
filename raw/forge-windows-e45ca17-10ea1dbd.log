f8fb7b4 [nitro@ryzen5] what is needed for building chromium on m5 large
f8fbc7e [kimi-k2-0905] #m5.large (2 vCPU, 8 GB) is tight but doable; give it 8–16 GB swap and expect 6–8 h builds.
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #Essentials
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #sudo dnf install -y git python3 perl gcc-c++ glibc-devel bison flex pkgconf-pkg-config \
f8fbc7e [kimi-k2-0905] #     alsa-lib-devel atk-devel bzip2-devel cairo-devel cups-devel dbus-devel \
f8fbc7e [kimi-k2-0905] #     expat-devel fontconfig-devel freetype-devel gdk-pixbuf2-devel glib2-devel \
f8fbc7e [kimi-k2-0905] #     gtk3-devel harfbuzz-devel java-17-openjdk-devel libatomic libcap-devel \
f8fbc7e [kimi-k2-0905] #     libdrm-devel libffi-devel libgcrypt-devel libjpeg-turbo-devel libpng-devel \
f8fbc7e [kimi-k2-0905] #     libsecret-devel libvpx-devel libxkbcommon-x11-devel libxshmfence-devel \
f8fbc7e [kimi-k2-0905] #     mesa-libEGL-devel mesa-libgbm-devel nss-devel pango-devel pciutils-devel \
f8fbc7e [kimi-k2-0905] #     pulseaudio-libs-devel systemd-devel util-linux-devel valgrind-devel \
f8fbc7e [kimi-k2-0905] #     wget which xz zlib-devel
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #Optional but recommended
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #sudo dnf install -y ccache lld-devel llvm-devel ninja-build
f8fbc7e [kimi-k2-0905] #
f8fbc7e [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #Bootstrap depot_tools (once)
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git $HOME/depot_tools
f8fbc7f [kimi-k2-0905] #echo 'export PATH="$HOME/depot_tools:$PATH"' >> ~/.bashrc
f8fbc7f [kimi-k2-0905] #source ~/.bashrc
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #Create 16 GB swap (disk is cheap)
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #sudo fallocate -l 16G /swapfile
f8fbc7f [kimi-k2-0905] #sudo chmod 600 /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile
f8fbc7f [kimi-k2-0905] #echo '/swapfile none swap sw 0 0' | sudo tee -a /etc/fstab
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #
f8fbc7f [kimi-k2-0905] #Fetch & build
f8fbc7f [kimi-k2-0905] #
