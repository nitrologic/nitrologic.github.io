1097e1a8 [claude-opus-4-5] #Use an open-drain/open-collector configuration with the RP2040 GPIO.
1097e1a8 [claude-opus-4-5] #
1097e1a8 [claude-opus-4-5] #Set the pin as output low to pull down, or set as input (high-Z) to release. The 5V side needs its
1097e1a8 [claude-opus-4-5] #own pull-up resistor to 5V.
1097e1a8 [claude-opus-4-5] #
1097e1a8 [claude-opus-4-5] #
1097e1a8 [claude-opus-4-5] #// Pull low
1097e1a8 [claude-opus-4-5] #gpio_set_dir(PIN, GPIO_OUT);
1097e1a8 [claude-opus-4-5] #gpio_put(PIN, 0);
1097e1a8 [claude-opus-4-5] #
1097e1a8 [claude-opus-4-5] #// Release (let 5V pull-up take over)
1097e1a8 [claude-opus-4-5] #gpio_set_dir(PIN, GPIO_IN);
1097e1a8 [claude-opus-4-5] #
1097e1a8 [claude-opus-4-5] #
