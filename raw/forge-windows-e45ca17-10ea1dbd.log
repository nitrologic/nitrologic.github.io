f932949 [nitro@ryzen5] so steps to set up cross compiler
f932a62 [kimi-k2-0905] #Quick, minimal setup on a Debian/Ubuntu host (x86-64) to cross-compile V8 for Pi 5:
f932a62 [kimi-k2-0905] #
f932a62 [kimi-k2-0905] #1. Install toolchain + sysroot
f932a62 [kimi-k2-0905] #
f932a62 [kimi-k2-0905] #sudo apt update
f932a62 [kimi-k2-0905] #sudo apt install -y clang llvm lld \
f932a62 [kimi-k2-0905] #     gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
f932a62 [kimi-k2-0905] #     debootstrap qemu-user-static
f932a62 [kimi-k2-0905] #
f932a62 [kimi-k2-0905] #
f932a62 [kimi-k2-0905] #2. Make a Debian-12 ARM64 sysroot (one-time)
f932a62 [kimi-k2-0905] #
f932a62 [kimi-k2-0905] #sudo mkdir -p /opt/pi5-sysroot
f932a62 [kimi-k2-0905] #sudo debootstrap --arch=arm64 bookworm /opt/pi5-sysroot \
f932a62 [kimi-k2-0905] #     http://deb.debian.org/debian
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #3. Tell GN to use it
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #gn gen out.gn/arm64.release --args='
f932a63 [kimi-k2-0905] #    target_cpu="arm64"
f932a63 [kimi-k2-0905] #    is_clang=true
f932a63 [kimi-k2-0905] #    clang_base_path="/usr"
f932a63 [kimi-k2-0905] #    use_lld=true
f932a63 [kimi-k2-0905] #    sysroot="/opt/pi5-sysroot"
f932a63 [kimi-k2-0905] #    is_component_build=false
f932a63 [kimi-k2-0905] #    is_debug=false
f932a63 [kimi-k2-0905] #    v8_use_external_startup_data=false
f932a63 [kimi-k2-0905] #    v8_enable_i18n_support=false
f932a63 [kimi-k2-0905] #    treat_warnings_as_errors=false'
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #4. Build
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #autoninja -C out.gn/arm64.release
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #
f932a63 [kimi-k2-0905] #5. Deploy
f932a63 [kimi-k2-0905] #Copy anything from `out.gn/arm64.release` (static `d8`, `libv8_monolith.a`, etc.) straight to the
f932a63 [kimi-k2-0905] #Pi 5; no further dependencies.
f932a63 [kimi-k2-0905] #
