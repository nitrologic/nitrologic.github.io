e928cb8 [kimi-k2-0905] #You pad to display width, not byte length.
e928cb8 [kimi-k2-0905] #
e928cb8 [kimi-k2-0905] #1. Measure each cell with a Unicode-width function
e928cb8 [kimi-k2-0905] #   (e.g. `wcswidth`, `unicode-width` crate, `Intl.Segmenter` in JS).
e928cb8 [kimi-k2-0905] #2. Sum the widths per column.
e928cb8 [kimi-k2-0905] #3. Add spaces until `(currentwidth + pad) == targetwidth`.
e928cb8 [kimi-k2-0905] #
e928cb8 [kimi-k2-0905] #Example helper (Rust flavour, but the idea is the same everywhere):
e928cb8 [kimi-k2-0905] #
e928cb8 [kimi-k2-0905] #
e928cb8 [kimi-k2-0905] #use unicode_width::UnicodeWidthStr;
e928cb8 [kimi-k2-0905] #
e928cb8 [kimi-k2-0905] #fn pad_to(s: &str, target: usize) -> String {
e928cb8 [kimi-k2-0905] #    let w = UnicodeWidthStr::width(s);
e928cb8 [kimi-k2-0905] #    if w < target {
e928cb8 [kimi-k2-0905] #        format!("{}{}", s, " ".repeat(target - w))
e928cb8 [kimi-k2-0905] #    } else {
e928cb8 [kimi-k2-0905] #        s.into()
e928cb8 [kimi-k2-0905] #    }
e928cb8 [kimi-k2-0905] #}
e928cb8 [kimi-k2-0905] #
e928cb8 [kimi-k2-0905] #
e928cb9 [kimi-k2-0905] #Use that value when you build the row string; the monospaced font then keeps everything aligned.
e928cb9 [kimi-k2-0905] #
