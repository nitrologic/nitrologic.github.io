10d04af5 [kimi-k2-0905] #For authenticity you could add the 7-pin DIN (panel-mount 45324-type) that the 1701 used for:
10d04af5 [kimi-k2-0905] #
10d04af5 [kimi-k2-0905] #╭───────┬───────────────────╮
10d04af5 [kimi-k2-0905] #│  Pin  │  1701 signal      │
10d04af5 [kimi-k2-0905] #├───────┼───────────────────┤
10d04af5 [kimi-k2-0905] #│  1    │  LUMINANCE        │
10d04af5 [kimi-k2-0905] #│  2    │  GND              │
10d04af5 [kimi-k2-0905] #│  3    │  AUDIO IN         │
10d04af5 [kimi-k2-0905] #│  4    │  CHROMA           │
10d04af5 [kimi-k2-0905] #│  5    │  AUDIO OUT        │
10d04af5 [kimi-k2-0905] #│  6    │  n.c.             │
10d04af5 [kimi-k2-0905] #│  7    │  +5 V (from C64)  │
10d04af5 [kimi-k2-0905] #╰───────┴───────────────────╯
10d04af5 [kimi-k2-0905] #
10d04af5 [kimi-k2-0905] #Mini-DIN keeps the vintage look while still giving you the modern RCA jacks underneath for everyday
10d04af5 [kimi-k2-0905] #cables.
10d04af5 [kimi-k2-0905] #Layout idea (rear, left→right):
10d04af5 [kimi-k2-0905] #
10d04af5 [kimi-k2-0905] #
10d04af5 [kimi-k2-0905] #[USB-C]  [3.5 mm mono audio]  [RCA luma]  [RCA chroma]  [7-pin mini-DIN]
10d04af5 [kimi-k2-0905] #
10d04af5 [kimi-k2-0905] #
10d04af5 [kimi-k2-0905] #Route the same signals to both RCA and DIN so the user can pick either.
10d04af5 [kimi-k2-0905] #
