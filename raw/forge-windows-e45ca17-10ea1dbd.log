f8fc3d5 [nitro@ryzen5] i want to build c++ programs that link with v8 for scripting duties
f8fd0bc [kimi-k2-0905] #For “I just want V8 as a scripting engine” you don’t need the full Chromium tree—build only the
f8fd0bc [kimi-k2-0905] #standalone static/dynamic libraries that the V8 project already publishes.
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #1. Install the same depot_tools and swap you already have.
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #2. Fetch the minimal V8 tree (no Chromium):
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #mkdir ~/v8 && cd ~/v8
f8fd0bc [kimi-k2-0905] #fetch v8              # ~2 GB instead of 30 GB
f8fd0bc [kimi-k2-0905] #cd v8
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #3. Install the helper packages that V8’s build needs:
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #./build/install-build-deps.sh   # accepts all prompts
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #
f8fd0bc [kimi-k2-0905] #4. Pick a release configuration and generate Ninja files:
f8fd0bc [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #gn gen out.gn/x64.release --args='
f8fd0bd [kimi-k2-0905] #    is_component_build = false   # static libs
f8fd0bd [kimi-k2-0905] #    is_debug = false
f8fd0bd [kimi-k2-0905] #    v8_use_external_startup_data = false
f8fd0bd [kimi-k2-0905] #    v8_enable_i18n_support = false
f8fd0bd [kimi-k2-0905] #    treat_warnings_as_errors = false'
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #(Flip `iscomponentbuild = true` if you prefer shared libraries.)
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #5. Build the libraries you actually link against:
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #autoninja -C out.gn/x64.release v8_monolith
f8fd0bd [kimi-k2-0905] ## produces:
f8fd0bd [kimi-k2-0905] ##   out.gn/x64.release/obj/libv8_monolith.a   (static everything)
f8fd0bd [kimi-k2-0905] ##   out.gn/x64/release/icudtl.dat             (if you kept i18n)
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #6. Write a minimal host program (hello.cpp):
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] #
f8fd0bd [kimi-k2-0905] ##include <v8.h>
f8fd0bd [kimi-k2-0905] ##include <libplatform/libplatform.h>
f8fd0bd [kimi-k2-0905] ##include <iostream>
f8fd0be [kimi-k2-0905] #
f8fd0be [kimi-k2-0905] #int main() {
f8fd0be [kimi-k2-0905] #    v8::V8::InitializeICUDefaultLocation("");
f8fd0be [kimi-k2-0905] #    v8::V8::InitializeExternalStartupData("");
f8fd0be [kimi-k2-0905] #    std::unique_ptr<v8::Platform> platform = v8::platform::NewDefaultPlatform();
f8fd0be [kimi-k2-0905] #    v8::V8::InitializePlatform(platform.get());
f8fd0be [kimi-k2-0905] #    v8::V8::Initialize();
f8fd0be [kimi-k2-0905] #
f8fd0be [kimi-k2-0905] #    v8::Isolate::CreateParams params;
f8fd0be [kimi-k2-0905] #    params.array_buffer_allocator =
f8fd0be [kimi-k2-0905] #        v8::ArrayBuffer::Allocator::NewDefaultAllocator();
