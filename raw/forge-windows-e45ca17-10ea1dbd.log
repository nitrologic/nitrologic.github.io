10e3a7a4 [kimi-k2-0905] #
10e3a7a4 [kimi-k2-0905] #{
10e3a7a4 [kimi-k2-0905] #  "tasks": {
10e3a7a4 [kimi-k2-0905] #    "decompress": "zstd -d data.blend.zst -o data.blend"
