10a8f0c9 [gemini-3-pro] #    *   Reg 5 (D8-D15) Pin 9 (Q7) → GP8
10a8f0c9 [gemini-3-pro] #    *   Reg 6 (Control) Pin 9 (Q7) → GP9
10a8f0c9 [gemini-3-pro] #
10a8f0c9 [gemini-3-pro] #74HC595 Shift Registers (Outputs)
10a8f0c9 [gemini-3-pro] #
10a8f0ca [gemini-3-pro] #• Common Control:
10a8f0ca [gemini-3-pro] #    *   Pin 11 (SRCLK) → GP10
10a8f0ca [gemini-3-pro] #    *   Pin 12 (RCLK) → GP11
10a8f0ca [gemini-3-pro] #    *   Pin 13 (/OE) → GP12
10a8f0ca [gemini-3-pro] #• Data Inputs (Parallel Writing):
