10a26df3 [kimi-k2-0905] #├───────────┼──────────────┼─────────────────┤
10a26df3 [kimi-k2-0905] #│  Black    │  7.5         │  19             │
10a26df3 [kimi-k2-0905] #│  White    │  92          │  234            │
10a26df3 [kimi-k2-0905] #│  Red      │  35          │  89             │
10a26df3 [kimi-k2-0905] #│  Cyan     │  65          │  165            │
10a26df3 [kimi-k2-0905] #│  Purple   │  40          │  102            │
10a26df3 [kimi-k2-0905] #│  Green    │  45          │  114            │
10a26df3 [kimi-k2-0905] #│  Blue     │  30          │  76             │
10a26df3 [kimi-k2-0905] #│  Yellow   │  75          │  191            │
10a26df3 [kimi-k2-0905] #│  Orange   │  50          │  127            │
10a26df3 [kimi-k2-0905] #│  Brown    │  32          │  81             │
10a26df3 [kimi-k2-0905] #│  Lt red   │  55          │  140            │
10a26df4 [kimi-k2-0905] #│  Dk grey  │  25          │  64             │
10a26df4 [kimi-k2-0905] #│  Md grey  │  50          │  127            │
10a26df4 [kimi-k2-0905] #│  Lt green │ 60           │  152            │
10a26df4 [kimi-k2-0905] #│  Lt blue  │  42          │  107            │
10a26df4 [kimi-k2-0905] #│  Lt grey  │  70          │  178            │
10a26df4 [kimi-k2-0905] #╰───────────┴──────────────┴─────────────────╯
