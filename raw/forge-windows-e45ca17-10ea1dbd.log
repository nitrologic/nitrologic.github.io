fa45abe [kimi-k2-0905] #
fa45abe [kimi-k2-0905] #Engine               Flash    RAM    ES level    License    JIT back-ends        Status / notes
fa45abe [kimi-k2-0905] #-------------------  -------  -----  ----------  ---------  -------------------  --------------------------------------------
fa45abe [kimi-k2-0905] #Hermes               ~1 MB    3 MB   ES6         MIT        ARM64, x86-64        Facebook, Android-only JIT today
fa45abf [kimi-k2-0905] #mJS-JIT (experimental) 400 k  64 k   ES5         GPL-2      ARM64, x86-64        Fork of mJS, not upstream
fa45abf [kimi-k2-0905] #LuaJIT (JS glue)     ~600 k   256 k  ES5-ish     MIT        ARM64, x86-32/64     Need JS→Lua transpiler; JIT is for Lua
fa45abf [kimi-k2-0905] #ChakraCore           4–5 MB   4 MB   ES6         MIT        ARM64, x86-64        JIT enabled, but >Pico resources
fa45abf [kimi-k2-0905] #JSC (WebKit)         3–4 MB   3 MB   ES2022      LGPL/BSD   ARM64, x86-64        Full desktop engine, not MCU-suitable
fa45abf [kimi-k2-0905] #V8                   6 MB+    6 MB+  ES2023      BSD        ARM64, x86-64        Requires MMU, 64-bit, >Pico resources
fa45abf [kimi-k2-0905] #
fa45abf [kimi-k2-0905] #
