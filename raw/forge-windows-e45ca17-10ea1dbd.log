e7e2b93 [kimi-k2-0905] #DOS (MS-DOS / FreeDOS) has no “soft mount” or chroot-like feature.
e7e2b93 [kimi-k2-0905] #The closest you can get is SUBST, but it’s useless for security:
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #SUBST Z: C:\SAFE\WEB
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #- `Z:\AUTOEXEC.BAT` is still reachable as `C:\SAFE\WEB\AUTOEXEC.BAT`
e7e2b93 [kimi-k2-0905] #- Any program can ignore the drive letter and open the real path
e7e2b93 [kimi-k2-0905] #- `..` is honoured inside the substitution, so `Z:\..\WINDOWS` → `C:\WINDOWS`
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #→ SUBST gives zero protection against `..\` traversal.
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
e7e2b93 [kimi-k2-0905] #What you can do on DOS (if you really must):
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #1. Strip `..` in your own code before you open anything.
e7e2b93 [kimi-k2-0905] #2. Keep the document root on a separate FAT12 floppy image and mount it read-only
e7e2b93 [kimi-k2-0905] #with `IMGDRIVE` or similar TSR; then physically write-protect the floppy.
e7e2b93 [kimi-k2-0905] #3. Run the server inside DOSBox with:
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #   mount c /safe/web -readonly
e7e2b93 [kimi-k2-0905] #   mount d /system -free
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #   DOSBox honours the mount boundary, so `C:\..\SYSTEM` fails.
e7e2b93 [kimi-k2-0905] #   (This is the closest DOS gets to a chroot.)
e7e2b93 [kimi-k2-0905] #
e7e2b93 [kimi-k2-0905] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
e7e2b93 [kimi-k2-0905] #Bottom line:
e7e2b93 [kimi-k2-0905] #Real DOS has no kernel-level path jail.
e7e2b93 [kimi-k2-0905] #Use a sandbox emulator (DOSBox, DOSEMU) or roll your own path sanitiser.
e7e2b93 [kimi-k2-0905] #
