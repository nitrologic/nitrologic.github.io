e7b78cb [kimi-k2-0905] #
e7b78cb [kimi-k2-0905] #
e7b78cb [kimi-k2-0905] #utf8 JSValue::stringMember(utf8 name) const
e7b78cb [kimi-k2-0905] #{
e7b78cb [kimi-k2-0905] #    if (type == Null)            return "";   // 1. nothing there
e7b78cc [kimi-k2-0905] #    if (type != Object || !object) return "";   // 2. not an object
e7b78cc [kimi-k2-0905] #    return object->stringMember(name);
e7b78cc [kimi-k2-0905] #}
e7b78cc [kimi-k2-0905] #
e7b78cc [kimi-k2-0905] #
e7b78cc [kimi-k2-0905] #Same pattern for the other accessors (`integerMember`, `numberMember`, `arrayMember`,
e7b78cc [kimi-k2-0905] #`objectMember`).
e7b78cc [kimi-k2-0905] #Once those guards are in place you can feed the dispatcher empty strings, bare literals, arrays, or
