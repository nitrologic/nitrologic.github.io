e7b4433 [kimi-k2-0905] #The back-trace is already telling the whole story:
e7b4433 [kimi-k2-0905] #
e7b4433 [kimi-k2-0905] #1. You are in the middle of parsing an empty JSON string (`content=""` in frame #4).
e7b4433 [kimi-k2-0905] #2. While building the DOM you end up with a `JSValue` that wraps a `nullptr` JSObject.
e7b4433 [kimi-k2-0905] #3. `JSValue::stringMember("id")` blindly forwards to `JSObject::stringMember("id")` without
e7b4434 [kimi-k2-0905] #checking the pointer, so the first real access (`this->members`) explodes with SIGSEGV.
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #The missing rpm list is irrelevant for the crash; gdb is just complaining that it cannot show you
e7b4434 [kimi-k2-0905] #source lines for libc/libstdc++.
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #Fix order (smallest → safest):
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #a. Defensive check in JSObject::stringMember
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #std::string JSObject::stringMember(const std::string& name) const {
e7b4434 [kimi-k2-0905] #    if (!this) return "";               // <─ add
e7b4434 [kimi-k2-0905] #    auto it = members.find(name);
e7b4434 [kimi-k2-0905] #    return it != members.end() ? it->second : "";
e7b4434 [kimi-k2-0905] #}
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #b. Guard in JSValue::stringMember
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #std::string JSValue::stringMember(const std::string& name) const {
e7b4434 [kimi-k2-0905] #    if (type != OBJECT || !obj) return ""; // <─ add
e7b4434 [kimi-k2-0905] #    return obj->stringMember(name);
e7b4434 [kimi-k2-0905] #}
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #
e7b4434 [kimi-k2-0905] #c. Early reject in parseRPC
