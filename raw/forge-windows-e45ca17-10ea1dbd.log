107affde [gemini-3-pro] #• Input Stage:*
107affde [gemini-3-pro] #
107affde [gemini-3-pro] #[RCA Jack]
107affde [gemini-3-pro] #   |
107affde [gemini-3-pro] #   +-- [75Ω Resistor] -- GND
