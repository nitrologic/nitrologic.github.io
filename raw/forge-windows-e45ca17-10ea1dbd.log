105fff54 [nitro@ryzen5] options for deno nginx stack to authenticate user once across zones
1060026a [kimi-k2-0905] #Deno itself has no built-in single-sign-on (SSO) primitives; you have to bolt it on.
1060026a [kimi-k2-0905] #With NGINX in front you can do the “authenticate once” part at the edge and let every Deno zone
1060026a [kimi-k2-0905] #trust the same header that NGINX injects.
1060026a [kimi-k2-0905] #
1060026a [kimi-k2-0905] #1. Pick one auth method
1060026a [kimi-k2-0905] #   - OpenID-Connect (Keycloak, Authelia, Auth0, Ory Hydra …)
1060026a [kimi-k2-0905] #   - SAML (simpleSAMLphp, Shibboleth)
1060026a [kimi-k2-0905] #   - Basic auth + htpasswd (quick demo only)
1060026a [kimi-k2-0905] #
1060026a [kimi-k2-0905] #2. Put an auth daemon in front of NGINX
1060026a [kimi-k2-0905] #   lua-resty-openidc (Lua) or nginx-auth-jwt (Go) are the lightest; they validate the cookie / JWT
1060026a [kimi-k2-0905] #and set `X-User: alice`.
1060026a [kimi-k2-0905] #
1060026a [kimi-k2-0905] #3. NGINX snippet (works in `http` or `server` block):
1060026a [kimi-k2-0905] #
1060026a [kimi-k2-0905] #
1060026a [kimi-k2-0905] ## ——— shared resolver for OIDC ———
1060026a [kimi-k2-0905] #resolver 8.8.8.8 8.8.4.4 valid=10s;
1060026a [kimi-k2-0905] #
1060026a [kimi-k2-0905] ## ——— external auth endpoint ———
1060026a [kimi-k2-0905] #location = /oauth2/auth {
1060026a [kimi-k2-0905] #	internal;
1060026a [kimi-k2-0905] #	proxy_pass              http://auth_daemon:4180;   # oauth2-proxy, Authelia, …
1060026a [kimi-k2-0905] #	proxy_pass_request_body off;
1060026b [kimi-k2-0905] #	proxy_set_header        Content-Length "";
1060026b [kimi-k2-0905] #	proxy_set_header        X-Original-URI $request_uri;
1060026b [kimi-k2-0905] #	proxy_set_header        X-Original-Method $request_method;
1060026b [kimi-k2-0905] #}
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] ## ——— protected zone A ———
1060026b [kimi-k2-0905] #server {
1060026b [kimi-k2-0905] #	listen 80;
1060026b [kimi-k2-0905] #	server_name a.demo.local;
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #	location / {
1060026b [kimi-k2-0905] #		auth_request        /oauth2/auth;          # 1. check cookie
1060026b [kimi-k2-0905] #		auth_request_set    $auth_user $upstream_http_x_user;
1060026b [kimi-k2-0905] #		proxy_set_header    X-User  $auth_user;    # 2. inject header
1060026b [kimi-k2-0905] #		proxy_pass          http://deno_zone_a:8080;
1060026b [kimi-k2-0905] #	}
1060026b [kimi-k2-0905] #}
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] ## ——— protected zone B ———
1060026b [kimi-k2-0905] #server {
1060026b [kimi-k2-0905] #	listen 80;
1060026b [kimi-k2-0905] #	server_name b.demo.local;
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #	location / {
1060026b [kimi-k2-0905] #		auth_request        /oauth2/auth;          # same endpoint
1060026b [kimi-k2-0905] #		auth_request_set    $auth_user $upstream_http_x_user;
1060026b [kimi-k2-0905] #		proxy_set_header    X-User  $auth_user;
1060026b [kimi-k2-0905] #		proxy_pass          http://deno_zone_b:8081;
1060026b [kimi-k2-0905] #	}
1060026b [kimi-k2-0905] #}
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #4. Deno side – reusable helper (`auth.ts`):
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #import { serve } from "https://deno.land/std@0.208.0/http/server.ts";
1060026b [kimi-k2-0905] #
1060026b [kimi-k2-0905] #export function mustAuth(req: Request): string {
1060026b [kimi-k2-0905] #	const user = req.headers.get("x-user");
1060026b [kimi-k2-0905] #	if (!user) throw new Error("Unauthorized");
1060026b [kimi-k2-0905] #	return user;
1060026b [kimi-k2-0905] #}
1060026b [kimi-k2-0905] #
1060026c [kimi-k2-0905] #export function handler(user: string): Response {
1060026c [kimi-k2-0905] #	return new Response(`hello ${user} from Deno\n`);
1060026c [kimi-k2-0905] #}
1060026c [kimi-k2-0905] #
1060026c [kimi-k2-0905] #if (import.meta.main) {
1060026c [kimi-k2-0905] #	serve((req) => {
1060026c [kimi-k2-0905] #		try {
1060026c [kimi-k2-0905] #			const user = mustAuth(req);
1060026c [kimi-k2-0905] #			return handler(user);
1060026c [kimi-k2-0905] #		} catch {
1060026c [kimi-k2-0905] #			return new Response("Unauthorized", { status: 401 });
1060026c [kimi-k2-0905] #		}
1060026c [kimi-k2-0905] #	});
1060026c [kimi-k2-0905] #}
1060026c [kimi-k2-0905] #
1060026c [kimi-k2-0905] #
1060026c [kimi-k2-0905] #5. Cookie domain
1060026c [kimi-k2-0905] #Set the cookie domain to `.demo.local` so it is sent to `a.demo.local`, `b.demo.local`, etc.
1060026c [kimi-k2-0905] #Most OIDC proxies do this with `--cookie-domain=.demo.local`.
1060026c [kimi-k2-0905] #
1060026c [kimi-k2-0905] #6. HTTPS
1060026c [kimi-k2-0905] #Terminate TLS at NGINX (certbot/Let’s Encrypt) so the cookie is `Secure`.
1060026c [kimi-k2-0905] #
1060026c [kimi-k2-0905] #Result: user logs in once on any zone; NGINX re-uses the same session for every Deno backend.
1060026c [kimi-k2-0905] #
