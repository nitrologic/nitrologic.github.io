10bdb668 [claude-opus-4-5] #11 AUX_A1    12 AUX_A2/A3
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #Or prioritise the bidirectional GPIO:
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #1  GND       2  3V3
10bdb668 [claude-opus-4-5] #3  GP9       4  GP22
10bdb668 [claude-opus-4-5] #5  AUX_A0    6  AUX_A1
10bdb668 [claude-opus-4-5] #7  AUX_A2    8  AUX_A3
10bdb668 [claude-opus-4-5] #9  AUX_D0    10 AUX_D1
10bdb668 [claude-opus-4-5] #11 AUX_D2    12 AUX_D3/D4
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #
10bdb668 [claude-opus-4-5] #GP9/GP22 are full GPIO - can be input, output, PWM, or bit-banged protocols. More useful at the top
