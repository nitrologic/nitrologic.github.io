109f291f [gemini-3-pro] #    pio_gpio_init(pio, GPIO_CLK);
109f291f [gemini-3-pro] #    pio_gpio_init(pio, GPIO_SHLD);
109f291f [gemini-3-pro] #    for(int i=0; i<4; i++) pio_gpio_init(pio, GPIO_Q7_BASE + i);
109f291f [gemini-3-pro] #
109f291f [gemini-3-pro] #    // Directions
109f291f [gemini-3-pro] #    pio_sm_set_consecutive_pindirs(pio, sm, GPIO_CLK, 1, true);  // Output
109f291f [gemini-3-pro] #    pio_sm_set_consecutive_pindirs(pio, sm, GPIO_SHLD, 1, true); // Output
