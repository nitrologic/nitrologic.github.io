f93a32d [kimi-k2-0905] #Minimum surface you need to re-create so existing Node net code “just runs”:
f93a32d [kimi-k2-0905] #
f93a32d [kimi-k2-0905] #Global constructors
f93a32d [kimi-k2-0905] #`net.Socket([options])`
f93a32d [kimi-k2-0905] #`net.Server([options][, connectionListener])`
f93a32d [kimi-k2-0905] #`net.createConnection(port[, host][, cb])`  alias `net.connect(...)`
f93a32d [kimi-k2-0905] #`net.createServer([opts][, listener])`
f93a32d [kimi-k2-0905] #
f93a32d [kimi-k2-0905] #Socket instance (extends <EventEmitter>)
f93a32d [kimi-k2-0905] #Events: `'connect'`, `'data'`, `'end'`, `'close'`, `'error'`, `'timeout'`, `'drain'`
f93a32d [kimi-k2-0905] #Properties: `readable`, `writable`, `destroyed`, `localAddress`, `localPort`, `remoteAddress`,
f93a32d [kimi-k2-0905] #`remotePort`, `pending`
f93a32d [kimi-k2-0905] #Methods:
f93a32d [kimi-k2-0905] #- `write(chunk[, encoding][, cb]) → bool`
f93a32d [kimi-k2-0905] #- `end([chunk][, encoding][, cb])`
f93a32d [kimi-k2-0905] #- `destroy([error])`
f93a32d [kimi-k2-0905] #- `pause()`, `resume()`
f93a32d [kimi-k2-0905] #- `setEncoding(enc)`, `setTimeout(ms[, cb])`, `setNoDelay([bool])`, `setKeepAlive([bool][, ms])`
f93a32d [kimi-k2-0905] #
f93a32d [kimi-k2-0905] #Server instance
f93a32d [kimi-k2-0905] #Events: `'connection'`, `'listening'`, `'close'`, `'error'`
f93a32d [kimi-k2-0905] #Methods:
f93a32d [kimi-k2-0905] #- `listen(port[, host][, backlog][, cb])`
f93a32d [kimi-k2-0905] #- `close([cb])`
f93a32d [kimi-k2-0905] #- `address() → {address,family,port}`
f93a32d [kimi-k2-0905] #
f93a32d [kimi-k2-0905] #Buffer integration
f93a32e [kimi-k2-0905] #All I/O delivered as `Buffer` objects (Uint8Array with `node::Buffer` prototype).
f93a32e [kimi-k2-0905] #Static helpers: `Buffer.from(string[, enc])`, `buf.toString([enc])`, `Buffer.alloc`,
f93a32e [kimi-k2-0905] #`Buffer.concat`.
f93a32e [kimi-k2-0905] #
f93a32e [kimi-k2-0905] #Utility constants
f93a32e [kimi-k2-0905] #`net.isIP(input) → 0|4|6`
f93a32e [kimi-k2-0905] #`net.isIPv4`, `net.isIPv6`
f93a32e [kimi-k2-0905] #
f93a32e [kimi-k2-0905] #If your native layer exposes exactly the signatures above (same argument order, same default
f93a32e [kimi-k2-0905] #values, same EventEmitter semantics, same Buffer contract) most npm packages that only do
f93a32e [kimi-k2-0905] #`require('net')` will work unchanged.
f93a32e [kimi-k2-0905] #
