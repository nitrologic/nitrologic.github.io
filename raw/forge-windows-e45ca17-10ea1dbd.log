100f93eb [kimi-k2-0905] #
100f93eb [kimi-k2-0905] #
100f93eb [kimi-k2-0905] #sudo sh -c 'echo 0 > /sys/bus/usb/devices/1-1/authorized
100f93eb [kimi-k2-0905] #            sleep 1
100f93eb [kimi-k2-0905] #            echo 1 > /sys/bus/usb/devices/1-1/authorized'
