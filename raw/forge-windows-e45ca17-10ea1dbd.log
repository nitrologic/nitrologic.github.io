10a9f49c [gemini-3-pro] #There are a few critical conflicts in the netlist text versus the GPIO allocation table,
10a9f49c [gemini-3-pro] #specifically regarding the Output Latches (74LS374) and the FET control pins.
10a9f49c [gemini-3-pro] #
10a9f49c [gemini-3-pro] #Here is the 74LS374 pinout and the corrections required to make the logic work.
10a9f49c [gemini-3-pro] #
10a9f49c [gemini-3-pro] #74LS374 Pinout (20-Pin DIP)
10a9f49c [gemini-3-pro] #This is an 8-bit D-Type Flip-Flop (Parallel In / Parallel Out), not a serial shift
10a9f49c [gemini-3-pro] #register.
10a9f49c [gemini-3-pro] #
10a9f49c [gemini-3-pro] #╭──────────┬───────────┬──────────────────────────────┬──────────┬───────────┬─────────────────────────────╮
10a9f49c [gemini-3-pro] #│  Pin     │  Name     │  Description                 │  Pin     │  Name     │  Description                │
10a9f49c [gemini-3-pro] #├──────────┼───────────┼──────────────────────────────┼──────────┼───────────┼─────────────────────────────┤
10a9f49c [gemini-3-pro] #│  :---    │  :---     │  :---                        │  :---    │  :---     │  :---                       │
10a9f49c [gemini-3-pro] #│  **1**   │  **/OE**  │  Output Enable (Active Low)  │  **20**  │  **VCC**  │  +5V / 3.3V                 │
10a9f49c [gemini-3-pro] #│  **2**   │  **Q0**   │  Output 0                    │  **19**  │  **Q7**   │  Output 7                   │
10a9f49d [gemini-3-pro] #│  **3**   │  **D0**   │  Input 0                     │  **18**  │  **D7**   │  Input 7                    │
10a9f49d [gemini-3-pro] #│  **4**   │  **D1**   │  Input 1                     │  **17**  │  **D6**   │  Input 6                    │
10a9f49d [gemini-3-pro] #│  **5**   │  **Q1**   │  Output 1                    │  **16**  │  **Q6**   │  Output 6                   │
10a9f49d [gemini-3-pro] #│  **6**   │  **Q2**   │  Output 2                    │  **15**  │  **Q5**   │  Output 5                   │
10a9f49d [gemini-3-pro] #│  **7**   │  **D2**   │  Input 2                     │  **14**  │  **D5**   │  Input 5                    │
10a9f49d [gemini-3-pro] #│  **8**   │  **D3**   │  Input 3                     │  **13**  │  **D4**   │  Input 4                    │
10a9f49d [gemini-3-pro] #│  **9**   │  **Q3**   │  Output 3                    │  **12**  │  **Q4**   │  Output 4                   │
10a9f49d [gemini-3-pro] #│  **10**  │  **GND**  │  Ground                      │  **11**  │  **CP**   │  Clock Pulse (Rising Edge)  │
