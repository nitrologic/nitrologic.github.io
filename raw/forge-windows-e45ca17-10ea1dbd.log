f932e4d [kimi-k2-0905] #You can get away with nothing more than
f932e4d [kimi-k2-0905] #
f932e4d [kimi-k2-0905] #
f932e4d [kimi-k2-0905] #gn gen out.gn/arm64.release --args='target_cpu="arm64" is_component_build=false is_debug=false v8_use_external_startup_data=false v8_enable_i18n_support=false'
f932e4d [kimi-k2-0905] #
f932e4d [kimi-k2-0905] #
f932e4e [kimi-k2-0905] #and let GN pick the built-in `aarch64-linux-gnu` toolchain that the depot_tools fetch.
