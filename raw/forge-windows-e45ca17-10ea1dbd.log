10a8f0c9 [gemini-3-pro] #│  GP25  │  LED               │  Output     │  Onboard                                      │
10a8f0c9 [gemini-3-pro] #╰────────┴────────────────────┴─────────────┴───────────────────────────────────────────────╯
10a8f0c9 [gemini-3-pro] #
10a8f0c9 [gemini-3-pro] #74HC165 Shift Registers (Inputs)
10a8f0c9 [gemini-3-pro] #
10a8f0c9 [gemini-3-pro] #• Common Control:
10a8f0c9 [gemini-3-pro] #    *   Pin 1 (SH/LD) → GP3
10a8f0c9 [gemini-3-pro] #    *   Pin 2 (CLK) → GP2
10a8f0c9 [gemini-3-pro] #• Data Outputs (Parallel Reading):
