10d16b22 [gemini-3-pro] #Here is a review of the Luma2 SKUs and a design for the "Control Deck" daughterboard
10d16b22 [gemini-3-pro] #(Ribbon + 5 Pots + LEDs).
10d16b22 [gemini-3-pro] #
10d16b22 [gemini-3-pro] #SKU Verdict: The 2" is "Cuter"
10d16b22 [gemini-3-pro] #For a Mini Commodore 1701 replica:
10d16b22 [gemini-3-pro] #• Waveshare 2" (Pico-LCD-2): Best choice. The physical bezel/buttons match the aesthetic of
10d16b22 [gemini-3-pro] #a monitor control panel.
10d16b22 [gemini-3-pro] #• Waveshare 2.8" (ResTouch): Rejected. It uses GP16-GP22 for the LCD/Touch
10d16b22 [gemini-3-pro] #interface, which strictly conflicts with your high-speed comparator inputs (G0-G4). You would have
10d16b22 [gemini-3-pro] #no pins left for video capture.
10d16b22 [gemini-3-pro] #
10d16b22 [gemini-3-pro] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
10d16b22 [gemini-3-pro] #
10d16b22 [gemini-3-pro] #New Sub-Assembly: Luma2 Control Deck
10d16b22 [gemini-3-pro] #A separate front-panel PCB connected via ribbon cable.
10d16b22 [gemini-3-pro] #
10d16b22 [gemini-3-pro] #• Features:*
10d16b22 [gemini-3-pro] #1.  5x Piher Trimpots: Adjust thresholds for Sync, G0, G1, G2, G3/4.
10d16b22 [gemini-3-pro] #2.  5x LEDs: Visual feedback.
10d16b22 [gemini-3-pro] #       Mode A (Power/Status):* Static glow (retro aesthetic).
10d16b22 [gemini-3-pro] #       Mode B (Calibration - Recommended):* LEDs driven by the Comparator Outputs. They
10d16b22 [gemini-3-pro] #flicker when that specific grey level is detected. Makes tuning the trimpots intuitive without an
10d16b22 [gemini-3-pro] #oscilloscope.
10d16b22 [gemini-3-pro] #3.  Connection: 14-pin IDC Ribbon Cable.
10d16b22 [gemini-3-pro] #
10d16b22 [gemini-3-pro] #Control Deck BOM
10d16b22 [gemini-3-pro] #• 1x PCB (Front Panel strip)
10d16b22 [gemini-3-pro] #• 5x 10k Piher Horizontal Trimpots
10d16b22 [gemini-3-pro] #• 5x 3mm LEDs (Green for Luma, Red for Sync)
10d16b22 [gemini-3-pro] #• 5x 330Ω Resistors (LED current limiting)
10d16b22 [gemini-3-pro] #• 1x 14-pin IDC Male Header (Right Angle)
10d16b22 [gemini-3-pro] #• 1x 14-pin IDC Ribbon Cable assembly
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #Ribbon Pinout (Main Board ↔ Control Deck)
10d16b23 [gemini-3-pro] #• Pin 1: 5V (Pot Top)
10d16b23 [gemini-3-pro] #• Pin 2: GND (Pot Bottom & LED Cathodes)
10d16b23 [gemini-3-pro] #• Pin 3: Wiper 1 (Sync Threshold) → To Comparator (-)
10d16b23 [gemini-3-pro] #• Pin 4: Wiper 2 (G0 Threshold) → To Comparator (-)
10d16b23 [gemini-3-pro] #• Pin 5: Wiper 3 (G1 Threshold) → To Comparator (-)
10d16b23 [gemini-3-pro] #• Pin 6: Wiper 4 (G2 Threshold) → To Comparator (-)
10d16b23 [gemini-3-pro] #• Pin 7: Wiper 5 (G3/4 Threshold) → To Comparator (-)
10d16b23 [gemini-3-pro] #• Pin 8: LED 1 Drive (Sync) ← From Comparator Output (Buffered) or GPIO
10d16b23 [gemini-3-pro] #• Pin 9: LED 2 Drive (G0)
10d16b23 [gemini-3-pro] #• Pin 10: LED 3 Drive (G1)
10d16b23 [gemini-3-pro] #• Pin 11: LED 4 Drive (G2)
10d16b23 [gemini-3-pro] #• Pin 12: LED 5 Drive (G3/4)
10d16b23 [gemini-3-pro] #• Pin 13/14: GND/Shielding
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #Updated GPIO Allocation (Pico-LCD-2 Compatible)
10d16b23 [gemini-3-pro] #• To accommodate the Waveshare 2" LCD, we must move the capture pins away from the LCD SPI and
10d16b23 [gemini-3-pro] #Button pins.*
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #• Constraints:*
10d16b23 [gemini-3-pro] #• LCD uses: GP8, 9, 10, 11, 12, 13
10d16b23 [gemini-3-pro] #• LCD Buttons use: GP2, 3, 15, 17 (Can be ignored/desoldered if needed, but let's try to keep them)
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #• New Luma2 Map:*
10d16b23 [gemini-3-pro] #• Capture Bus (Continuous block preferred for PIO): GP18, 19, 20, 21, 22 are Safe.
10d16b23 [gemini-3-pro] #• Sync: Move from GP14 to GP26 (ADC0 as Digital In) or keep at GP14.
10d16b23 [gemini-3-pro] #• Chroma: GP16 conflicts with LCD Button Right. Move to GP27 or GP28.
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #
10d16b23 [gemini-3-pro] #module.exports = {
10d16b23 [gemini-3-pro] #	name: "Project LUMA2",
10d16b23 [gemini-3-pro] #	sku: "Waveshare 2-inch IPS (Pico-LCD-2)",
10d16b23 [gemini-3-pro] #	gpio: {
10d16b23 [gemini-3-pro] #		// LCD Interface (Fixed by Waveshare hardware)
10d16b23 [gemini-3-pro] #		8: { name: "LCD_DC", direction: "output" },
10d16b23 [gemini-3-pro] #		9: { name: "LCD_CS", direction: "output" },
10d16b23 [gemini-3-pro] #		10: { name: "LCD_CLK", direction: "output" },
10d16b23 [gemini-3-pro] #		11: { name: "LCD_MOSI", direction: "output" },
10d16b23 [gemini-3-pro] #		12: { name: "LCD_RST", direction: "output" },
10d16b24 [gemini-3-pro] #		13: { name: "LCD_BL", direction: "output" },
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #		// LCD Buttons (Optional, can use for menu)
10d16b24 [gemini-3-pro] #		2: { name: "KEY_A", direction: "input" },
10d16b24 [gemini-3-pro] #		3: { name: "KEY_B", direction: "input" },
10d16b24 [gemini-3-pro] #		15: { name: "KEY_X", direction: "input" },
10d16b24 [gemini-3-pro] #		17: { name: "KEY_Y", direction: "input" },
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #		// Video Capture (LM319 Outputs)
10d16b24 [gemini-3-pro] #		// Moved to avoid LCD conflict.
10d16b24 [gemini-3-pro] #		// Note: GP14 is safe. GP16 was conflict.
10d16b24 [gemini-3-pro] #		14: { name: "CSYNC_IN", direction: "input", description: "LM319 Sync Out" },
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #		// 5-bit Luma Bus (Contiguous for PIO efficiency)
10d16b24 [gemini-3-pro] #		18: { name: "LUMA_G0", direction: "input" },
10d16b24 [gemini-3-pro] #		19: { name: "LUMA_G1", direction: "input" },
10d16b24 [gemini-3-pro] #		20: { name: "LUMA_G2", direction: "input" },
10d16b24 [gemini-3-pro] #		21: { name: "LUMA_G3", direction: "input" },
10d16b24 [gemini-3-pro] #		22: { name: "LUMA_G4", direction: "input" },
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #		// Mods
10d16b24 [gemini-3-pro] #		26: { name: "AUDIO_IN", direction: "input", function: "ADC0" },
10d16b24 [gemini-3-pro] #		27: { name: "CHROMA_IN", direction: "input", description: "Chroma Comparator Out" },
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #		// Debug
10d16b24 [gemini-3-pro] #		0: { name: "UART_TX", direction: "output" },
10d16b24 [gemini-3-pro] #		1: { name: "UART_RX", direction: "input" }
10d16b24 [gemini-3-pro] #	}
10d16b24 [gemini-3-pro] #};
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #Revised BOM Additions
10d16b24 [gemini-3-pro] #Add these to your order for the Control Deck:
10d16b24 [gemini-3-pro] #
10d16b24 [gemini-3-pro] #• 5x 330Ω Resistors (LED Limiters)
10d16b24 [gemini-3-pro] #• 5x 3mm LEDs (Diffused Red/Green)
10d16b24 [gemini-3-pro] #• 2x 14-pin IDC Box Headers (One for Mainboard, One for Control Deck)
10d16b24 [gemini-3-pro] #• 1x 14-way Ribbon Cable (10cm length)
