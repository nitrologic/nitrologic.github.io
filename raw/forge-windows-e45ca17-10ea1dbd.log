context, String::NewFromUtf8Literal(iso, "write"),                    Function::New(context, StderrWrite).ToLocalChecked());        process->Set(context, String::NewFromUtf8Literal(iso, "stdin"),  stdin);        process->Set(context, String::NewFromUtf8Literal(iso, "stdout"), stdout);        process->Set(context, String::NewFromUtf8Literal(iso, "stderr"), stderr);        context->Global()->Set(context, String::NewFromUtf8Literal(iso, "process"), process);}int main(){		std::unique_ptr<v8::Platform> platform = v8::platform::NewDefaultPlatform();		v8::V8::InitializePlatform(platform.get());		v8::V8::Initialize();		v8::Isolate::CreateParams params;		params.array_buffer_allocator = v8::ArrayBuffer::Allocator::NewDefaultAllocator();		v8::Isolate* isolate = v8::Isolate::New(params);		{			v8::Isolate::Scope isolate_scope(isolate);			v8::HandleScope handle_scope(isolate);			std::cout << "V8 " << v8::V8::GetVersion() << " ready." << std::endl;		}		isolate->Dispose();		delete params.array_buffer_allocator;		v8::V8::Dispose();		v8::V8::ShutdownPlatform();		return 0;}
