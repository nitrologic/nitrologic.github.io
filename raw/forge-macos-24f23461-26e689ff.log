262ccc3e [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.004 2.844KB 4.30s
262ccc3e [gemini-3.7-flash] #The keyboard row is selected using Bits 0–3 of `$E812` (PIA 1, Port B).
262ccc3e [gemini-3.7-flash] #
262ccc3e [gemini-3.7-flash] #How the Ports Are Assigned:
262ccc3e [gemini-3.7-flash] #
262ccc3e [gemini-3.7-flash] #• `$E812` (PIA 1 Port B): Matrix Row Output
262ccc3e [gemini-3.7-flash] #  * Bits 0–3 (`PB0`–`PB3`): Provide the 4-bit binary/BCD value (0 to 9) fed into the 74145
262ccc3e [gemini-3.7-flash] #decoder to pull down one of the 10 matrix rows.
262ccc3e [gemini-3.7-flash] #  * Bits 4–7: Reserved for other hardware functions (e.g., cassette motor controls and
262ccc3e [gemini-3.7-flash] #screen blanking/retrace signals, depending on the board revision).
262ccc3e [gemini-3.7-flash] #
262ccc3e [gemini-3.7-flash] #• `$E810` (PIA 1 Port A): Matrix Column Input
262ccc3e [gemini-3.7-flash] #  * Bits 0–7 (`PA0`–`PA7`): Read the 8 column lines returning from the keyboard matrix. A
262ccc3f [gemini-3.7-flash] #bit reads as `0` (low) when the key at the intersection of the active row and that column is
262ccc3f [gemini-3.7-flash] #pressed.
262ccc3f [gemini-3.7-flash] #
