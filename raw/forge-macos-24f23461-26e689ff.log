262e9c34 [gemini-3.7-flash] #🟠nitrologic Relay 2.0.1 gemini-3.7-flash 🌟 🪠 0.7° $0.008 27.90KB 4.21s
262e9c34 [gemini-3.7-flash] #In standard Commodore PET hardware, the 6520 PIA 1 is mapped to the 16-bit address
262e9c34 [gemini-3.7-flash] #`E810`, not the zero-page/8-bit address `00E8`.
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #There are two primary reasons why row selection fails during the keyboard scan routine (`SCNKEY`):
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #1. Address Decoding (16-bit vs 8-bit)
262e9c34 [gemini-3.7-flash] #The PET Kernal accesses the keyboard controller via 16-bit absolute addresses:
262e9c34 [gemini-3.7-flash] #• Row Select (Output): Address `$E810` (PIA 1 Port A / `PRA`)
262e9c34 [gemini-3.7-flash] #• Column Read (Input): Address `$E812` (PIA 1 Port B / `PRB`)
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #If your emulator checks memory addresses using only a single byte (e.g., `address === 0xE8`), it
262e9c34 [gemini-3.7-flash] #will intercept wrong writes or miss the full 16-bit address `$E810`.
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #2. PIA Data Direction Register (DDR) vs. Output Register Selection
262e9c34 [gemini-3.7-flash] #The 6520 PIA shares the same memory address for both the Data Direction Register (`DDRA`)
262e9c34 [gemini-3.7-flash] #and the Peripheral Output Register (`PRA`).
262e9c34 [gemini-3.7-flash] #
262e9c34 [gemini-3.7-flash] #Which internal register gets updated depends on Bit 2 of the Control Register A
262e9c34 [gemini-3.7-flash] #(`CRA`) at address `$E811`:
262e9c34 [gemini-3.7-flash] #• `CRA` Bit 2 = `0`: Writing to `$E810` modifies the Data Direction Register (`DDRA`).
262e9c34 [gemini-3.7-flash] #• `CRA` Bit 2 = `1`: Writing to `$E810` modifies Port A outputs (`PRA`), which drives the
262e9c35 [gemini-3.7-flash] #keyboard row decoder.
262e9c35 [gemini-3.7-flash] #
262e9c35 [gemini-3.7-flash] #During system boot, the PET Kernal sets `CRA` bit 2 to `1`. If your emulator does not track this
262e9c35 [gemini-3.7-flash] #control bit, writes intended for the keyboard decoder might be misrouted.
262e9c35 [gemini-3.7-flash] #
262e9c35 [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
