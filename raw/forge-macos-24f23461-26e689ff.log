256bef02 [roha] {"model":"grok-imagine-image-quality","messages":[{"role":"system","content":"As a guest assistant language model please be mindful of others, courteous and professional. Only post code on request and do not patronise. Use tabs when indenting source files. Prefer named reusable functions over inlining code with arrow and map style suggestions."},{"role":"system","content":"models under test include grok-imagine-image-quality"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/audiotest.ts\",\"length\":600,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// audiotest.ts\r\n// (c)2026 nitrologic\r\n// all rights reserved\r\n\r\nconst ffiPath = Deno.build.os === \"darwin\"  ? \"./macosaudio.ts\" : \"./win32audio.ts\";\r\nconst { createTone, playAudio, initAudioOut, closeAudio } =await import(ffiPath);\r\n\r\nexport const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));\r\n\r\nconst hasAudio=initAudioOut(0);\r\n\r\nconsole.log(\"audio test 0.0.2\",hasAudio);\r\n\r\nlet tone=createTone();\r\n\r\nplayAudio(0,tone);\r\nplayAudio(0,tone);\r\nplayAudio(0,tone);\r\nplayAudio(0,tone);\r\nplayAudio(0,tone);\r\nplayAudio(0,tone);\r\n\r\nawait sleep(5000);\r\ncloseAudio();\r\n\r\nconsole.log(\"bye\");\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/keyboards.ts\",\"length\":492,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// keyboards.ts\r\n\r\nconst ffiPath = Deno.build.os === \"darwin\"  ? \"./macosffi.ts\" : \"./win32ffi.ts\";\r\nconst { scanVICKeyboard, readVIC20Keyboard, readC64Keyboard } =await import(ffiPath);\r\n\r\n//import { scanKeyboard, readVIC20Matrix, readC64Matrix} from \"./ffi/keyboards.ts\";\r\n\r\nexport function scanKeyboard(row:number){\r\n    scanVICKeyboard(row);\r\n}\r\n\r\nexport function readVIC20Matrix(){\r\n    return readVIC20Keyboard();\r\n}\r\n\r\nexport function readC64Matrix(){\r\n    return readC64Keyboard();\r\n}","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/macosaudio.ts\",\"length\":5564,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// macosaudio.ts\r\n//\r\n// export function createTone(seconds:number=0.2,amplitude=200,frequency=166):Int16Array;\r\n// export function initAudioOut(outputId:number=0):boolean;\r\n// export function playAudio(channel:number,tone:Int16Array);\r\n// export function closeAudio();\r\n\r\nconst audioToolbox=Deno.dlopen(\r\n\t\"/System/Library/Frameworks/AudioToolbox.framework/AudioToolbox\",\r\n\t{\r\n\t\tAudioQueueNewOutput:{\r\n\t\t\tparameters:[\"pointer\",\"pointer\",\"pointer\",\"pointer\",\"pointer\",\"u32\",\"buffer\"],\r\n\t\t\tresult:\"i32\"\r\n\t\t},\r\n\t\tAudioQueueAllocateBuffer:{\r\n\t\t\tparameters:[\"pointer\",\"u32\",\"buffer\"],\r\n\t\t\tresult:\"i32\"\r\n\t\t},\r\n\t\tAudioQueueEnqueueBuffer:{\r\n\t\t\tparameters:[\"pointer\",\"pointer\",\"u32\",\"pointer\"],\r\n\t\t\tresult:\"i32\"\r\n\t\t},\r\n\t\tAudioQueueStart:{\r\n\t\t\tparameters:[\"pointer\",\"pointer\"],\r\n\t\t\tresult:\"i32\"\r\n\t\t},\r\n\t\tAudioQueueStop:{\r\n\t\t\tparameters:[\"pointer\",\"u32\"],\r\n\t\t\tresult:\"i32\"\r\n\t\t},\r\n\t\tAudioQueueDispose:{\r\n\t\t\tparameters:[\"pointer\",\"u32\"],\r\n\t\t\tresult:\"i32\"\r\n\t\t},\r\n\t}\r\n);\r\n\r\nconst libSystem=Deno.dlopen(\"/usr/lib/libSystem.B.dylib\",{\r\n\tmemcpy:{\r\n\t\tparameters:[\"pointer\",\"pointer\",\"usize\"],\r\n\t\tresult:\"pointer\"\r\n\t}\r\n});\r\n\r\nlet audioQueues:Record<number,BigUint64Array>={};\r\nlet audioBuffers:Array<Deno.PointerValue> = [];\r\n\r\n\r\nexport function createTone(\r\n\tseconds:number=0.2,\r\n\tamplitude=200,\r\n\tfrequency=166\r\n):Int16Array {\r\n\r\n\tconst samples=48000*seconds;\r\n\tconst data=new Int16Array(samples*2);\r\n\r\n\tfor(let i=0;i<samples;i++){\r\n\t\tconst value=Math.sin(i*2*Math.PI*frequency/48000)*amplitude;\r\n\r\n\t\tdata[i*2]=value;\r\n\t\tdata[i*2+1]=value;\r\n\t}\r\n\r\n\treturn data;\r\n}\r\n\r\n\r\nfunction createAudioStreamDescription():Uint8Array {\r\n\r\n\t// AudioStreamBasicDescription\r\n\t//\r\n\t// Float64  mSampleRate\r\n\t// UInt32   mFormatID\r\n\t// UInt32   mFormatFlags\r\n\t// UInt32   mBytesPerPacket\r\n\t// UInt32   mFramesPerPacket\r\n\t// UInt32   mBytesPerFrame\r\n\t// UInt32   mChannelsPerFrame\r\n\t// UInt32   mBitsPerChannel\r\n\t// UInt32   mReserved\r\n\r\n\tconst buffer=new ArrayBuffer(40);\r\n\tconst view=new DataView(buffer);\r\n\r\n\tview.setFloat64(0,48000,true);\r\n\r\n\t// 'lpcm'\r\n\tview.setUint32(8,0x6c70636d,false);\r\n\r\n\t// signed integer + packed\r\n\tview.setUint32(12,0x04|0x08,true);\r\n\r\n\t// stereo 16-bit\r\n\tview.setUint32(16,4*1,true);\t// bytes per packet\r\n\tview.setUint32(20,1,true);\t\t// frames per packet\r\n\tview.setUint32(24,4,true);\t\t// bytes per frame\r\n\tview.setUint32(28,2,true);\t\t// channels\r\n\tview.setUint32(32,16,true);\t\t// bits\r\n\r\n\treturn new Uint8Array(buffer);\r\n}\r\n\r\n\r\nexport function initAudioOut(outputId:number=0):boolean {\r\n\r\n\t// Audio Queue doesn't use device IDs in the same way as waveOut.\r\n\t// outputId is retained so the public API matches Windows.\r\n\r\n\tif(audioQueues[outputId]) return true;\r\n\r\n\tconst format=createAudioStreamDescription();\r\n\tconst formatPointer=Deno.UnsafePointer.of(format);\r\n\r\n\tconst queueBuffer=new BigUint64Array(1);\r\n\r\n\tconst result=audioToolbox.symbols.AudioQueueNewOutput(\r\n\t\tformatPointer,\r\n\t\tnull,\t// no callback\r\n\t\tnull,\r\n\t\tnull,\r\n\t\tnull,\r\n\t\t0,\r\n\t\tqueueBuffer\r\n\t);\r\n\r\n\tif(result!==0){\r\n\t\tconsole.log(\"AudioQueueNewOutput failed:\",result);\r\n\t\treturn false;\r\n\t}\r\n\r\n\tconst queue=Deno.UnsafePointer.create(queueBuffer[0]);\r\n\r\n\taudioQueues[outputId]=queueBuffer;\r\n\r\n\tconst startResult=audioToolbox.symbols.AudioQueueStart(\r\n\t\tqueue,\r\n\t\tnull\r\n\t);\r\n\r\n\tif(startResult!==0){\r\n\t\tconsole.log(\"AudioQueueStart failed:\",startResult);\r\n\t\treturn false;\r\n\t}\r\n\r\n\treturn true;\r\n}\r\n\r\n\r\nexport function playAudio(channel:number,tone:Int16Array){\r\n\r\n\tconst queueBuffer=audioQueues[channel];\r\n\tif(!queueBuffer) return;\r\n\r\n\tconst queue=Deno.UnsafePointer.create(queueBuffer[0]);\r\n\r\n\tconst bufferSize=tone.byteLength;\r\n\r\n\t// AudioQueueBufferRef*\r\n\tconst bufferPointerBuffer=new BigUint64Array(1);\r\n\r\n\tconst result=audioToolbox.symbols.AudioQueueAllocateBuffer(\r\n\t\tqueue,\r\n\t\tbufferSize,\r\n\t\tbufferPointerBuffer\r\n\t);\r\n\r\n\tif(result!==0){\r\n\t\tconsole.log(\"AudioQueueAllocateBuffer failed:\",result);\r\n\t\treturn;\r\n\t}\r\n\r\n\tconst audioBuffer=Deno.UnsafePointer.create(bufferPointerBuffer[0]);\r\n\r\n\t// AudioQueueBuffer layout on 64-bit macOS:\r\n\t//\r\n\t//  0  UInt32   mAudioDataBytesCapacity\r\n\t//  4  padding\r\n\t//  8  pointer  mAudioData\r\n\t// 16  UInt32   mAudioDataByteSize\r\n\t//\r\n\tconst view=new Deno.UnsafePointerView(audioBuffer);\r\n\r\n\tconst audioData=view.getPointer(8);\r\n\r\n\tif(!audioData){\r\n\t\tconsole.log(\"AudioQueueBuffer has no audio data\");\r\n\t\treturn;\r\n\t}\r\n\r\n\t// Copy Int16Array into AudioQueue's native buffer.\r\n\tlibSystem.symbols.memcpy(\r\n\t\taudioData,\r\n\t\tDeno.UnsafePointer.of(tone),\r\n\t\tBigInt(tone.byteLength)\r\n\t);\r\n\r\n\t// Set mAudioDataByteSize.\r\n\t//\r\n\t// We cannot directly write through UnsafePointerView, so use memcpy\r\n\t// into the native AudioQueueBuffer structure.\r\n\tconst size=new Uint32Array([tone.byteLength]);\r\n\r\n\tconst sizePointer=Deno.UnsafePointer.create(\r\n\t\tDeno.UnsafePointer.value(audioBuffer)+16n\r\n\t);\r\n\r\n\tlibSystem.symbols.memcpy(\r\n\t\tsizePointer,\r\n\t\tDeno.UnsafePointer.of(size),\r\n\t\t4n\r\n\t);\r\n\r\n\tconst enqueueResult=audioToolbox.symbols.AudioQueueEnqueueBuffer(\r\n\t\tqueue,\r\n\t\taudioBuffer,\r\n\t\t0,\r\n\t\tnull\r\n\t);\r\n\r\n\tif(enqueueResult!==0){\r\n\t\tconsole.log(\"AudioQueueEnqueueBuffer failed:\",enqueueResult);\r\n\t\treturn;\r\n\t}\r\n\r\n\t// Keep the buffer pointer alive until closeAudio().\r\n\taudioBuffers.push(audioBuffer);\r\n}\r\n\r\n\r\nexport function closeAudio(){\r\n\r\n\tfor(const queueBuffer of Object.values(audioQueues)){\r\n\r\n\t\tconst queue=Deno.UnsafePointer.create(queueBuffer[0]);\r\n\r\n\t\taudioToolbox.symbols.AudioQueueStop(\r\n\t\t\tqueue,\r\n\t\t\t1\r\n\t\t);\r\n\r\n\t\taudioToolbox.symbols.AudioQueueDispose(\r\n\t\t\tqueue,\r\n\t\t\t1\r\n\t\t);\r\n\t}\r\n\r\n\taudioQueues={};\r\n\taudioBuffers=[];\r\n\r\n\taudioToolbox.close();\r\n\tlibSystem.close();\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/macosffi.ts\",\"length\":4161,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// macosffi.ts\n\nconst KVK_ANSI={\n  \"A\": 0x00,\n  \"S\": 0x01,\n  \"D\": 0x02,\n  \"F\": 0x03,\n  \"H\": 0x04,\n  \"G\": 0x05,\n  \"Z\": 0x06,\n  \"X\": 0x07,\n  \"C\": 0x08,\n  \"V\": 0x09,\n  \"B\": 0x0B,\n  \"Q\": 0x0C,\n  \"W\": 0x0D,\n  \"E\": 0x0E,\n  \"R\": 0x0F,\n  \"Y\": 0x10,\n  \"T\": 0x11,\n  \"1\": 0x12,\n  \"2\": 0x13,\n  \"3\": 0x14,\n  \"4\": 0x15,\n  \"6\": 0x16,\n  \"5\": 0x17,  \n  \"Equal\": 0x18,\n  \"9\": 0x19,\n  \"7\": 0x1A,\n  \"Minus\": 0x1B,\n  \"8\": 0x1C,\n  \"0\": 0x1D,\n  \"RightBracket\": 0x1E,\n  \"O\": 0x1F,\n  \"U\": 0x20,\n  \"LeftBracket\": 0x21,\n  \"I\": 0x22,\n  \"P\": 0x23,\n  \"L\": 0x25,\n  \"J\": 0x26,\n  \"Quote\": 0x27,\n  \"K\": 0x28,\n  \"Semicolon\": 0x29,\n  \"Backslash\": 0x2A,\n  \"Comma\": 0x2B,\n  \"Slash\": 0x2C,\n  \"N\": 0x2D,\n  \"M\": 0x2E,\n  \"Period\": 0x2F,\n  \"Grave\": 0x32,\n  \"KeypadDecimal\": 0x41,\n  \"KeypadMultiply\": 0x43,\n  \"KeypadPlus\": 0x45,\n  \"KeypadClear\": 0x47,\n  \"KeypadDivide\": 0x4B,\n  \"KeypadEnter\": 0x4C,\n  \"KeypadMinus\": 0x4E,\n  \"KeypadEquals\": 0x51,\n  \"Keypad0\": 0x52,\n  \"Keypad1\": 0x53,\n  \"Keypad2\": 0x54,\n  \"Keypad3\": 0x55,\n  \"Keypad4\": 0x56,\n  \"Keypad5\": 0x57,\n  \"Keypad6\": 0x58,\n  \"Keypad7\": 0x59,\n  \"Keypad8\": 0x5B,\n  \"Keypad9\": 0x5C\n}\n\nconst bits=[0x13];\n/*\n  KVK_ANSI[\"1\"],\n  KVK_ANSI[\"3\"],\n  KVK_ANSI[\"5\"],\n  KVK_ANSI[\"7\"],\n  KVK_ANSI[\"9\"]\n]\n*/\nconst kCGEventSourceStateCombinedSessionState = 0;\n\nconst kVK_LeftArrow  = 0x7b;\nconst kVK_RightArrow = 0x7c;\nconst kVK_UpArrow    = 0x7e;\nconst kVK_DownArrow  = 0x7d;\nconst kVK_Space      = 0x31;\nconst kVK_Escape     = 0x35;\nconst kVK_LShift     = 0x38;\nconst kVK_RShift     = 0x3c;\nconst kVK_Delete      = 0x33;\n\nconst appServices = Deno.dlopen(\n  \"/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices\",\n  {\n    CGEventSourceKeyState: {parameters: [\"i32\", \"u16\"],result: \"i32\",},\n  },\n);\n\nexport function pollKeyCodes(): number {\n  const up    = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_UpArrow)    !== 0;\n  const down  = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_DownArrow)  !== 0;\n  const left  = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_LeftArrow)  !== 0;\n  const right = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_RightArrow) !== 0;\n  const space = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_Space)      !== 0;\n  const esc   = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_Escape)     !== 0;\n  const back   = appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_Delete) !== 0;\n  const shift   = \n  appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_LShift)    !== 0\n  ||\n  appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState, kVK_RShift)    !== 0;\n\n  return (up    ? 1  : 0) |\n         (down  ? 2  : 0) |\n         (left  ? 4  : 0) |\n         (right ? 8  : 0) |\n         (space ? 16 : 0) |\n         (back ? 32 : 0) |\n         (esc ?64 : 0) |\n         (shift ? 128 : 0) \n}\n\n/*\n\tVK_UP,VK_DOWN,VK_LEFT,VK_RIGHT,VK_SPACE,VK_BACK,VK_ESCAPE,VK_SHIFT\n*/\n\nexport function pollMouse() {\n  return { x: 0, y: 0, buttons: 0 };\n}\n\nexport function initMidiIn() {\n  return false;\n}\n\nexport function pollMidi() {\n  return [];\n}\n\nexport function closeMidi() {\n\n}\n\nexport function initAudioOut() {\n  return false;\n}\n\nexport function enumerateSystem(){\n  const inCount=0;//winmm.symbols.midiInGetNumDevs();\n  const outCount=0;//winmm.symbols.midiOutGetNumDevs();\n  return {inCount,outCount};\n}\n\nexport function closeDevices(){\n}\n\nlet vicScan=0;\n\nexport function scanVICKeyboard(scanBits:number){\n  vicScan=scanBits;\n}\n\nexport function readVIC20Keyboard():number{\n  return 255;\n}\nexport function readC64Keyboard():number{\n  return 255;\n}\n\nexport function pollVIC20Keyboard(matrix:Uint8Array){\n  let m=[0,0,0,0];\n  for(let i=0;i<bits.length;i++){\n    const bit=bits[i];\n    if(appServices.symbols.CGEventSourceKeyState(kCGEventSourceStateCombinedSessionState,bit)!==0) {\n      m[i>>3]|=(1<<(i&7));\n    }\n  }\n  matrix[0]=m[0];\n  matrix[1]=m[1];\n  matrix[2]=m[2];\n  matrix[3]=m[3];\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/notes.txt\",\"length\":189,\"type\":\"text/plain\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"simon@MidnightBlue arcade % deno run audio\nTask audio deno run --allow-ffi --allow-read --allow-write --allow-net ffi/audiotest.ts\nAudioQueueNewOutput failed: -50\naudio test 0.0.2 false\nbye","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/relay.md\",\"length\":0,\"type\":\"text/markdown\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/terminal.ts\",\"length\":6448,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// ffi terminal.ts\n// nitrologic arcade terminal \n// (c) 2026 nitrologic\n\nconst ffiPath = Deno.build.os === \"darwin\"  ? \"./macosffi.ts\" : \"./win32ffi.ts\";\nconst { pollKeyCodes, testTone, enumerateSystem, initAudioOut, initMidiIn, pollMidi, closeDevices } =await import(ffiPath);\n\nexport interface KeypadState {\n\tkeyBits:number,\n\thitBits:number;\n\taxisPump:number[],\n\tmousePosition:number[],\n\tinputQueue:Uint8Array[],\n\tmidiEvents:Uint8Array[]\n}\n\nexport function openMidiIn(channel){\n\treturn initMidiIn(channel);\n}\n\n// export function list\n\n// writeConsole \n// replaceText \n// setCursor\n// sleep \n// pollKeypad\n// runTerminal pollTerminal stopTerminal \n\n// isRunning stopRunning\n\nconst UpBit=1;const DownBit=2;const LeftBit=4;const RightBit=8;\nconst HomeBit=16;const EndBit=32;const DeleteBit=64;const InsertBit=128;\nconst PageUpBit=256;const PageDownBit=512;const EscapeBit=1024;\n\n// mouse bits << 16\n\nconst MouseLeftBit=1;\nconst MouseRightBit=2;\nconst MouseMotionBit=4;\n\n// pumps\n\nconst UPDOWN=0;\nconst LEFTRIGHT=1;\n\nconst axisPump:number[]=[0,0];\nconst mousePosition:number[]=[0,0];\n\nfunction fadePumps():number[]{\n\tconst previous = [...axisPump];\n\tfor(let index=0;index<axisPump.length;index++){\n\t\tlet integral:number=(0.96*axisPump[index])|0;\n//\t\tlet fade=(integral>>6);\n//\t\tintegral=(fade)?integral-fade:0;\n\t\taxisPump[index]=integral;\n\t}\n\treturn previous;\n}\n\nfunction updatePumps(keys:number){\n\tif(keys&1) axisPump[UPDOWN]-=100;\n\tif(keys&2) axisPump[UPDOWN]+=100;\n\tif(keys&4) axisPump[LEFTRIGHT]-=72;\n\tif(keys&8) axisPump[LEFTRIGHT]+=72;\n\tfadePumps();\n}\n\n// writeConsole text\n\nconst encoder=new TextEncoder();\n\nexport function writeConsole(text:string){\n\tDeno.stdout.write(encoder.encode(text));\n}\n\n// replaceText text, search, replace, clockwise\n\nexport function replaceText(text: string, search: string, replace: string, leftToRight:boolean=true) : string {\n\tif (leftToRight) return text.replaceAll(search, replace);\n\tconst reversed = Array.from(text).reverse().join(\"\");\n\tconst revSearch = Array.from(search).reverse().join(\"\");\n\tconst revReplace = Array.from(replace).reverse().join(\"\");\n\tconst res = reversed.replaceAll(revSearch, revReplace);\n\treturn Array.from(res).reverse().join(\"\");\n}\n\n// setCursor x,y\n\nconst resetConsole=\"\\x1b[0m\";\nconst enableCursor=\"\\x1b[?25h\";\nconst disableCursor=\"\\x1b[?25l\";\nlet blinkFrame=0;\n\nexport function showCursor(col: number,row: number): string {\n\tlet code=`\\x1b[${row};${col}H`;\n\tconst blink=((blinkFrame++)&16)==0;\n\tcode+=blink?enableCursor:disableCursor;\n\treturn code;\n}\n\nexport function hideCursor(): string {\n\treturn disableCursor;\n}\n\n// sleep ms\n\nexport const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));\n\n// keypad\n\nconst keyboardBuffer = new Uint8Array(2048);\nlet keyboardQueue:Uint8Array[]=[];\n\nconst QToQuit=false;\nlet running=false;\nlet stopped=false;\n\nexport function isRunning(){\n\treturn running;\n}\n\nexport function stopRunning(){\n\trunning=false;\n}\n\nlet inputTask=null;\nlet systemSpec=null;\nlet hasMidi=false;\n\nexport async function bootTerminal(withMouse:boolean){\n\tif(!running){\n\t\trunning=true;\n\t\tDeno.stdin.setRaw(true);\n\t\tinputTask=runInputTask(withMouse);\n\t\tawait sleep(20)\n\t}\n//\treturn {inCount,outCount};\n\tsystemSpec=await enumerateSystem();\n\thasMidi=systemSpec.inCount>0||systemSpec.outCount>0\n\treturn {hasMidi,hasAudio:false,system:systemSpec}\n}\n\nexport function haltTerminal() {\n\tif(!stopped){\n\t\tDeno.stdin.setRaw(false);\n// reset colors and enable cursor\n//\t\tDeno.stdout.writeSync(encoder.encode(\"\\x1b[?1003l\\x1b[?1006l\\x1b[?25h\"));\t\n\t\tconsole.log(resetConsole+enableCursor);\n\t\tconsole.log(\"[TERMINAL] stopTerminal\");\n\t\tDeno.stdin.close();\n\t\tstopped=true;\n\t\tcloseDevices();\n\t}\n}\n\nasync function runInputTask(enableMouse:boolean=false) {\n\tif(enableMouse){\n\t\tDeno.stdout.writeSync(encoder.encode(\"\\x1b[?1003h\\x1b[?1006h\\x1b[?25l\"));\t\n//\t\tconsole.log(\"mouseOn\");\n\t}\n\twhile (running) {\n\t\ttry{\n\t\t\tconst bytes = await Deno.stdin.read(keyboardBuffer); \n\t\t\tif (bytes && QToQuit && keyboardBuffer[0] === 113) { // 113 = 'q'\n\t\t\t\trunning = false;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tif(bytes){\n\t\t\t\tconst payload=keyboardBuffer.slice(0,bytes);\n\t\t\t\tkeyboardQueue.push(payload);\n\t\t\t}\n\t\t}catch(e){ // operation canceled code EINTR\n\t\t\tif(e.code!=\"EINTR\"&&e.name!=\"BadResource\"){ \n\t\t\t\tconsole.log(\"[INPUT] unexpected exception\",{e});\n\t\t\t}\n\t\t\trunning=false;\n\t\t}\n\t}\n\tif(enableMouse){\n\t\tDeno.stdout.writeSync(encoder.encode(\"\\x1b[?1003l\\x1b[?1006l\\x1b[?25h\"));\t\n//\t\tconsole.log(\"mouseOff\");\n\t}\n}\n\nexport function pollTerminal():Uint8Array[]{\n\tconst queue=keyboardQueue;\n\tkeyboardQueue=[];\t\n\treturn queue;\n}\n\n// export interface KeypadState {hitBits:number;axisPump:number[],mousePosition:number[],inputQueue:Uint8Array[]}\n\nfunction hex(i:number,count:number=2){\n\treturn \"\"+i.toString(16).padStart(count,\"0\").toUpperCase();\n}\n\nconst decoder = new TextDecoder();\nlet keyPad=0;\nlet mouseButtons=0;\n\nexport function pollKeypad():KeypadState{\n\tconst midiEvents=hasMidi?pollMidi():[];\n\tlet inputQueue:Uint8Array[]=pollTerminal();\n\tfor(let index=0;index<inputQueue.length;index++){\n\t\tlet keys=inputQueue[index];\n\t\tconst rawKey=keys[0];\n\t\tswitch(rawKey){\n\t\t\tcase 27:\n\t\t\t\tif(keys.length>1){\n\t\t\t\t\tconst sequence=decoder.decode(keys.subarray(1));\n\t\t\t\t\tif(sequence.startsWith(\"[<\")){\n\t\t\t\t\t\t//35;53;11M\")\n\t\t\t\t\t\tconst m3=sequence.substring(2).split(\";\");\n\t\t\t\t\t\tconst b=parseInt(m3[0]);\n\t\t\t\t\t\tmousePosition[0]=parseInt(m3[1]);\n\t\t\t\t\t\tmousePosition[1]=parseInt(m3[2]);\n\t\t\t\t\t\tswitch(b){\n\t\t\t\t\t\t\tcase 0:mouseButtons^=1;break;\n\t\t\t\t\t\t\tcase 32:mouseButtons^=2;break;\n\t\t\t\t\t\t\tcase 35:mouseButtons|=4;break;//console.log(\"[M]\",{b,x,y});\n\t\t\t\t\t\t}\n\t\t\t\t\t\tcontinue;\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t\tswitch(sequence){\n\t\t\t\t\t\tcase \"[A\":keyPad|=UpBit;break;\n\t\t\t\t\t\tcase \"[B\":keyPad|=DownBit;break;\n\t\t\t\t\t\tcase \"[C\":keyPad|=RightBit;break;\n\t\t\t\t\t\tcase \"[D\":keyPad|=LeftBit;break;\n\t\t\t\t\t\tcase \"[2~\":keyPad|=InsertBit;break;\n\t\t\t\t\t\tcase \"[3~\":keyPad|=DeleteBit;break;\n\t\t\t\t\t\tcase \"[5~\":keyPad|=PageUpBit;break;\n\t\t\t\t\t\tcase \"[6~\":keyPad|=PageDownBit;break;\n\t\t\t\t\t\tcase \"[H\":keyPad|=EndBit;break;\n\t\t\t\t\t\tcase \"[F\":keyPad|=HomeBit;break;\n\t\t\t\t\t\tdefault:{\n//\t\t\t\t\t\t\tconsole.log(\"[ESC]\",sequence);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n//\t\t\t\t\tconsole.log(\"[ESC]\",{keyPad,sequence});\n\t\t\t\t}else{\n//\t\t\t\t\tconsole.log(\"Escape!\");\n\t\t\t\t\tkeyPad|=EscapeBit;\n//\t\t\t\t\tstopTerminal();\n\t\t\t\t}\n\t\t\t\t// onEscape\n\t\t\t\tbreak;\n\t\t}\n\t}    \n\tupdatePumps(keyPad);\n\tconst hitBits=(mouseButtons<<16)|(keyPad);\n\tconst keyBits=hitBits;\n\tkeyPad=0;\n\treturn {keyBits,hitBits,axisPump,mousePosition,inputQueue,midiEvents};\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/win32audio.ts\",\"length\":3335,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// win32audio.ts\r\n\r\n// export function createTone(seconds:number=0.2,amplitude=200,frequency=166):Int16Array;\r\n// export function initAudioOut(outputId:number=0):boolean\r\n// export function playAudio(channel:number,tone:Int16Array)\r\n// export function closeAudio();\r\n\r\n// tone\r\n\r\nexport function createTone(seconds:number=0.2,amplitude=200,frequency=166):Int16Array {\r\n\tconst samples=48000*seconds;\r\n\tconst data=new Int16Array(samples*2);\r\n\tfor(let i=0;i<samples;i++){\r\n\t\tconst value=Math.sin(i*2*Math.PI*frequency/48000)*amplitude;\r\n\t\tdata[i*2]=value;\r\n\t\tdata[i*2+1]=value;\r\n\t}\r\n\treturn data;\r\n}\r\n\r\n// play\r\n\r\nfunction createWaveHeader(data:Int16Array):Uint8Array {\r\n\tconst buffer=new ArrayBuffer(48);\r\n\tconst view=new DataView(buffer);\r\n\tview.setBigUint64(0,BigInt(Deno.UnsafePointer.value(Deno.UnsafePointer.of(data))),true);\r\n\tview.setUint32(8,data.byteLength,true);\r\n\treturn new Uint8Array(buffer);\r\n}\r\n\r\nexport function playAudio(channel:number,tone:Int16Array){\r\n\tconst handle=waveOutputs[channel];\r\n\tif(!handle) return null;\r\n\tconst waveOut=Deno.UnsafePointer.create(handle[0]);   \r\n\tconst header=createWaveHeader(tone);\r\n\tconst pointer=Deno.UnsafePointer.of(header);\r\n\twinmm.symbols.waveOutPrepareHeader(waveOut,pointer,48);\r\n\twinmm.symbols.waveOutWrite(waveOut,pointer,48);\r\n}\r\n\r\nconst winmm = Deno.dlopen(\"winmm.dll\", {\r\n\twaveOutGetNumDevs: { parameters: [], result: \"u32\" },\r\n//    waveOutOpen: { parameters: [\"buffer\", \"u32\", \"pointer\", \"pointer\", \"u32\", \"u32\"], result: \"u32\", callback: true },\r\n\twaveOutOpen: { parameters: [\"buffer\", \"u32\", \"pointer\", \"u64\", \"u64\", \"u32\"], result: \"u32\" },\r\n\twaveOutPrepareHeader: { parameters: [\"pointer\", \"pointer\", \"u32\"], result: \"u32\" },\r\n\twaveOutUnprepareHeader: { parameters: [\"pointer\", \"pointer\", \"u32\"], result: \"u32\" },\r\n\twaveOutWrite: { parameters: [\"pointer\", \"pointer\", \"u32\"], result: \"u32\" },\r\n\twaveOutPause: { parameters: [\"pointer\"], result: \"u32\" },\r\n\twaveOutRestart: { parameters: [\"pointer\"], result: \"u32\" },\r\n\twaveOutReset: { parameters: [\"pointer\"], result: \"u32\" },\r\n\twaveOutClose: { parameters: [\"pointer\"], result: \"u32\" },\r\n});\r\n\r\nconst audioBuffers:Array<BigUint64Array>=[];\r\nlet waveOutputs:Record<number,BigUint64Array>={};\r\n\r\nfunction createWaveFormat(sampleRate:number,channels:number,bits:number):Uint8Array {\r\n\tconst buffer=new ArrayBuffer(18);\r\n\tconst view=new DataView(buffer);\r\n\tview.setUint16(0,1,true);\r\n\tview.setUint16(2,channels,true);\r\n\tview.setUint32(4,sampleRate,true);\r\n\tview.setUint32(8,sampleRate*channels*(bits>>3),true);\r\n\tview.setUint16(12,channels*(bits>>3),true);\r\n\tview.setUint16(14,bits,true);\r\n\tview.setUint16(16,0,true);\r\n\treturn new Uint8Array(buffer);\r\n}\r\n\r\nexport function initAudioOut(outputId:number=0):boolean {\r\n\tconst count=winmm.symbols.waveOutGetNumDevs()|0;\r\n\tif(outputId>=count) return false;\r\n\tconst handleBuffer=new BigUint64Array(1);\r\n\tconst format=createWaveFormat(48000,2,16);\r\n\tconst formatPointer=Deno.UnsafePointer.of(format);\r\n\tconst result=winmm.symbols.waveOutOpen(handleBuffer,outputId,formatPointer,0,0,0);\r\n\tif(result) return false;\r\n\twaveOutputs[outputId]=handleBuffer;\r\n\treturn true;\r\n}\r\n\r\nexport function closeAudio(){\r\n\tfor(const handleBuffer:BigUint64Array of Object.values(waveOutputs)){\r\n\t\tconst waveOut=Deno.UnsafePointer.create(handleBuffer[0]);\r\n\t\twinmm.symbols.waveOutClose(waveOut);\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/arcade/ffi/win32ffi.ts\",\"length\":6721,\"type\":\"text/x-typescript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// win32ffi.ts\r\n\r\nconst winmm = Deno.dlopen(\"winmm.dll\", {\r\n\tmidiInGetNumDevs: { parameters: [], result: \"u32\" },\r\n\tmidiInOpen: { parameters: [\"buffer\", \"u32\", \"pointer\", \"pointer\", \"u32\"], result: \"u32\", callback: true },\r\n\tmidiInStart: { parameters: [\"pointer\"], result: \"u32\" },\r\n\tmidiInStop: { parameters: [\"pointer\"], result: \"u32\" },\r\n\tmidiInClose: { parameters: [\"pointer\"], result: \"u32\" },\r\n\tmidiOutGetNumDevs: { parameters: [], result: \"u32\" },\r\n\tmidiOutOpen: { parameters: [\"buffer\", \"u32\", \"u32\", \"u32\", \"u32\"], result: \"u32\" },\r\n\tmidiOutShortMsg: { parameters: [\"pointer\", \"u32\"], result: \"u32\" },\r\n\tmidiOutClose: { parameters: [\"pointer\"], result: \"u32\" },\r\n});\r\n\r\n// closeDevices\r\n\r\nexport function enumerateSystem(){\r\n\tconst inCount=winmm.symbols.midiInGetNumDevs();\r\n\tconst outCount=winmm.symbols.midiOutGetNumDevs();\r\n\treturn {inCount,outCount};\r\n}\r\n\r\n// keyboard\r\n\r\n// link windows user32.dll GetAsyncKeyState GetCursorPos\r\n\r\nconst user32 = Deno.dlopen(\"user32.dll\", {\r\n\tGetAsyncKeyState: {parameters: [\"i32\"],result: \"i16\"},\r\n\tGetCursorPos: {parameters: [\"buffer\"],result: \"i32\"},\r\n\tGetKeyboardState: { parameters: [\"buffer\"], result: \"i32\" }\r\n});\r\n\r\nconst VK_LBUTTON = 1;\r\nconst VK_RBUTTON = 2;\r\nconst VK_MBUTTON = 4;\r\n\r\nconst VK_LEFT = 0x25;\r\nconst VK_UP = 0x26;\r\nconst VK_RIGHT = 0x27;\r\nconst VK_DOWN = 0x28;\r\nconst VK_SPACE = 32;\r\nconst VK_BACK = 8;\r\nconst VK_ESCAPE = 27;\r\nconst VK_DELETE = 0x2E;\r\n\r\nconst VK_SHIFT = 0x10;\r\nconst VK_LSHIFT = 0xA0;\r\nconst VK_RSHIFT = 0xA1;\r\nconst VK_HOME = 0x24;\r\nconst VK_RETURN = 0x0D;\r\n \r\n// comma key is missing in action , 0xBC \r\n// who is C0\r\nconst vic20KeyCodes: number[] = [\r\n\t0x31, 0x33, 0x35, 0x37, 0x39, 0x4c, 0x23, 0x08,//13579L END BS\r\n\t0xC0, 0x57, 0x52, 0x59, 0x49, 0x50, 0xDD, 0x0D,\r\n\t0xc4, 0x41, 0x44, 0x47, 0x4a, 0x4C, 0xBA, 0x22,\r\n\t0xBA, 0xa0, 0x58, 0x56, 0x4e, 0xBC, 0xBF, 0x28,\r\n\t0x20, 0x5A, 0x43, 0x42, 0x4D, 0xBE, 0xA1, 0xBA,\r\n\t0xa2, 0x53, 0x46, 0x48, 0x4B, 0x5c, 0xBB, 0x40,\r\n\t0x51, 0x45, 0x54, 0x55, 0x4F, 0xDB, 0xDC, 0xB9,\r\n\t0x32, 0x34, 0x36, 0x38, 0x30, 0xBD, 0x24, 0x2a\r\n];\r\n\r\nlet vicScan=0;\r\n\r\nexport function scanVICKeyboard(scanBits:number){\r\n\tvicScan=scanBits;\r\n}\r\n\r\nexport function readVIC20Keyboard(){\r\n\tlet bits=0xff;\r\n\tfor(let i=0;i<8;i++){\r\n\t\tif((vicScan&(1<<i))==0){\r\n\t\t\tfor(let j=0;j<8;j++){\r\n\t\t\t\tconst vkey=vic20KeyCodes[i*8+j];\r\n\t\t\t\tif(user32.symbols.GetAsyncKeyState(vkey)&0x8000) {\r\n\t\t\t\t\tbits&=~(1<<j);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn bits;\r\n}\r\n\r\nconst c64KeyCodes: number[] = [\r\n\t0x08, 0x0D, 0x27, 0x76, 0x70, 0x72, 0x74, 0x28,\r\n\t0x33, 0x57, 0x41, 0x34, 0x5A, 0x53, 0x45, 0xA0,\r\n\t0x35, 0x52, 0x44, 0x36, 0x43, 0x46, 0x54, 0x58,\r\n\t0x37, 0x59, 0x47, 0x38, 0x42, 0x48, 0x55, 0x56,\r\n\t0x39, 0x49, 0x4A, 0x30, 0x4D, 0x4B, 0x4F, 0x4E,\r\n\t0xBB, 0x50, 0x4C, 0xDE, 0xBE, 0xBA, 0xBD, 0xBC,\r\n\t0x30, 0x38, 0x1B, 0xA1, 0x24, 0xBB, 0x36, 0xBF,\r\n\t0x31, 0xDF, 0x11, 0x32, 0x20, 0x5B, 0x51, 0x03\r\n];\r\n\r\nexport function readC64Keyboard(){\r\n\tlet bits=0xff;\r\n\tfor(let i=0;i<8;i++){\r\n\t\tif((vicScan&(1<<i))==0){\r\n\t\t\tfor(let j=0;j<8;j++){\r\n\t\t\t\tconst vkey=c64KeyCodes[i*8+j];\r\n\t\t\t\tif(user32.symbols.GetAsyncKeyState(vkey)&0x8000) {\r\n\t\t\t\t\tbits&=~(1<<j);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn bits;\r\n}\r\n\r\nconst keyboardBuffer = new Uint8Array(256);\r\n\r\nconst keyCodes=[\r\n\tVK_UP,VK_DOWN,VK_LEFT,VK_RIGHT,VK_SPACE,VK_BACK,VK_ESCAPE,VK_SHIFT,VK_DELETE\r\n]\r\n\r\nexport function pollKeyCodes():number{\r\n\tlet bits=0;\r\n\tfor(let i=0;i<keyCodes.length;i++){\r\n\t\tif(user32.symbols.GetAsyncKeyState(keyCodes[i])&0x8000) bits|=1<<i;\r\n\t}\r\n\treturn bits;\r\n}\r\n\r\n// mouse buttons: 1 = Left, 2 = Right, 4 = Middle\r\n\r\nexport interface MouseStatus {x: number;y: number; buttons: number;}\r\n\r\nconst mouseBuffer = new Int32Array(2);\r\n\r\nexport function pollMouse(): MouseStatus {\r\n\tuser32.symbols.GetCursorPos(mouseBuffer);\r\n\tconst left=user32.symbols.GetAsyncKeyState(VK_LBUTTON) & 0x8000;\r\n\tconst right=user32.symbols.GetAsyncKeyState(VK_RBUTTON) & 0x8000;\r\n\tconst middle=user32.symbols.GetAsyncKeyState(VK_MBUTTON) & 0x8000;\r\n\tconst buttons=(left?1:0)|(right?2:0)|(middle?4:0);\r\n\treturn {x:mouseBuffer[0],y:mouseBuffer[1],buttons};\r\n}\r\n\r\nexport interface MidiMessage { status: number; data1: number; data2: number; millis: number }\r\n\r\nconst CALLBACK_FUNCTION = 0x00030000; // Flag telling Windows we are passing a function pointer\r\nconst MIM_DATA = 0x3C3;              // Window message for received short MIDI data\r\n\r\nlet midiOut: Deno.PointerValue = null;\r\nlet midiIn: Deno.PointerValue = null;\r\nlet midiMessageQueue: MidiMessage[] = [];\r\n\r\nconst midiCallback = Deno.UnsafeCallback.threadSafe(\r\n\t{\r\n\t\tparameters: [\"pointer\", \"u32\", \"pointer\", \"u32\", \"u32\"],\r\n\t\tresult: \"void\",\r\n\t},\r\n\t(_hMidiIn, msg, _dwInstance, _dwParam1, _dwParam2) => {\r\n\t\tconst i32=_dwParam1|0;\r\n\t\tconst millis=_dwParam2|0;\r\n\t\tconst payload={ msg, status:i32&0xff,data1:(i32>>8)&0xff,data2:(i32>>16)&0xff,millis };\r\n\t\tmidiMessageQueue.push(payload);\r\n//\t\tconsole.log({payload});\r\n\t}\r\n);\r\n\r\nconst buffers:Array<BigUint64Array>=[];\r\nlet midiInputs:Record<number,Deno.UnsafePointer|null>={};\r\nlet midiOutputs:Record<number,Deno.UnsafePointer|null>={};\r\n\r\nexport function initMidiIn(inputId:number=0): boolean {\r\n\tconst inCount=winmm.symbols.midiInGetNumDevs()|0;\r\n\tif(inputId>=inCount) return false;\r\n\tconst handleBuffer = new BigUint64Array(1);\r\n\tconst result=winmm.symbols.midiInOpen(handleBuffer,inputId,midiCallback.pointer,null,CALLBACK_FUNCTION);\r\n\tif (result) return false;\r\n\tbuffers.push(handleBuffer);\r\n\tmidiIn=Deno.UnsafePointer.create(handleBuffer[0]);\r\n\tmidiInputs[inputId]=midiIn;\r\n\treturn winmm.symbols.midiInStart(midiIn) === 0;\r\n}\r\n\r\nexport function initMidiOut(outputId:number=0): boolean {\r\n\tconst outCount=winmm.symbols.midiOutGetNumDevs()|0;\r\n\tif(outputId>=outCount) return false;\r\n\tconst handleBuffer = new BigUint64Array(1);\r\n\tconst result = winmm.symbols.midiOutOpen(handleBuffer,outputId,0,0,0);\r\n\tif (result) return false;\r\n\tmidiOut=Deno.UnsafePointer.create(handleBuffer[0]);\r\n\tmidiOutputs[outputId]=midiOut;\r\n\treturn true;\r\n}\r\n\r\nexport function closeDevices() {\r\n\tfor(const midiOut in Object.values(midiOut