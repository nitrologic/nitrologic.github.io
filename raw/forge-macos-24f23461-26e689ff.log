262e7f6f [gemini-3.7-flash] #In Commodore PET Kernal (BASIC 2/3 and BASIC 4):
262e7f6f [gemini-3.7-flash] #
262e7f6f [gemini-3.7-flash] #The default value of `$028A` (decimal `650`, labeled `RPTFLG`) is:
262e7f6f [gemini-3.7-flash] #
262e7f6f [gemini-3.7-flash] #`$00` (`0`) — Normal / Default Repeat
262e7f6f [gemini-3.7-flash] #
262e7f6f [gemini-3.7-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
262e7f6f [gemini-3.7-flash] #
262e7f6f [gemini-3.7-flash] #Value Breakdown (`$028A` / `650`):
262e7f6f [gemini-3.7-flash] #
262e7f70 [gemini-3.7-flash] #• `$00` (`0`) — Default: Repeat is enabled only for specific control/movement keys:
262e7f70 [gemini-3.7-flash] #  * Cursor Keys (Up, Down, Left, Right)
