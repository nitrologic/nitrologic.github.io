) << std::endl;\n\t\t\tstd::cout << snd_ctl_card_info_get_driver(cardInfo) << std::endl;\n\t\t\tstd::cout << snd_ctl_card_info_get_id(cardInfo) << std::endl;\n#endif\n\t\t\tint flags=0;\n\n\t\t\t// query pcm support\n\t\t\tint pcmdev=-1;\n\t\t\twhile(true){\n\t\t\t\tint getNext=snd_ctl_pcm_next_device(handle,&pcmdev);\n\t\t\t\tif(getNext || pcmdev<0){\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\n\t\t\t\tsnd_pcm_info_set_device(pcmInfo, pcmdev);\n\t\t\t\tsnd_pcm_info_set_subdevice(pcmInfo, 0);\n\n\t\t\t\tsnd_pcm_info_set_stream(pcmInfo, SND_PCM_STREAM_PLAYBACK);\n\t\t\t\tint pcmPlay=snd_ctl_pcm_info(handle, pcmInfo);\n\t\t\t\tif(pcmPlay){\n\t\t\t\t\tstd::cout << \"snd_ctl_pcm_info playback fail \" << pcmPlay << std::endl;\n\t\t\t\t}else{\n\t\t\t\t\tint n=snd_pcm_info_get_subdevices_count(pcmInfo);\n//\t\t\t\t\tstd::cout << \"PCM IN #\" << n << \" dev:\"<< pcmdev << std::endl;\n\t\t\t\t\tflags|=1;\n\t\t\t\t}\n\n\t\t\t\tsnd_pcm_info_set_stream(pcmInfo, SND_PCM_STREAM_CAPTURE);\n\t\t\t\tint pcmRecord=snd_ctl_pcm_info(handle, pcmInfo);\n\t\t\t\tif(pcmRecord){\n//\t\t\t\t\tstd::cout << \"snd_ctl_pcm_info record fail \"<<pcmRecord<<std::endl;\n\t\t\t\t}else{\n\t\t\t\t\tint n=snd_pcm_info_get_subdevices_count(pcmInfo);\n//\t\t\t\t\tstd::cout << \"PCM OUT #\"<<n<<\" dev:\"<<pcmdev<<std::endl;\n\t\t\t\t\tflags|=2;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// query midi support\n\t\t\tint mididev=-1;\n\t\t\twhile(true){\n\t\t\t\tint getNext=snd_ctl_rawmidi_next_device(handle,&mididev);\n\t\t\t\tif(getNext || mididev<0){\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tsnd_rawmidi_info_set_device(midiInfo, mididev);\n\t\t\t\tsnd_rawmidi_info_set_subdevice(midiInfo, 0);\n\n\t\t\t\tsnd_rawmidi_info_set_stream(midiInfo, SND_RAWMIDI_STREAM_OUTPUT);\n\t\t\t\tint midiOut=snd_ctl_rawmidi_info(handle, midiInfo);\n\t\t\t\tif(midiOut){\n\t\t\t\t\tstd::cout << \"snd_ctl_rawmidi_info midi output fail \"<<midiOut<<std::endl;\t\t\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\tflags|=4;\n\t\t\t\t}\n\n\t\t\t\tsnd_rawmidi_info_set_stream(midiInfo, SND_RAWMIDI_STREAM_INPUT);\n\t\t\t\tint midiIn=snd_ctl_rawmidi_info(handle, midiInfo);\n\t\t\t\tif(midiIn){\n\t\t\t\t\tstd::cout << \"snd_ctl_rawmidi_info midi input fail \"<<midiIn<<std::endl;\t\t\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\tflags|=8;\n\t\t\t\t}\n\n\t\t\t}\n\n\t\t\tstd::cout << \"[ALSA] \" << cardName << \" \" << flags  << \" \" << name << \" - \" << longname << std::endl;\n\t\t\talsaDevices.emplace_back(cardName,name,longname,flags);\n//\t\tsnd_pcm_hw_params_any(handle, params);\n\t\t\tsnd_ctl_close(handle);\n\t\t}\n\t\treturn 0;\n\t}\n\n\tint recordPCM(std::string name,std::string &result){\n\t\tsnd_pcm_t *handle;\n\t\tsnd_pcm_hw_params_t *params;\n\t\tint pcmError=snd_pcm_open(&handle,name.c_str(),SND_PCM_STREAM_CAPTURE,0);\n\t\tif(pcmError){\n\t\t\tstd::cout << \"snd_pcm_open error \" << pcmError << \", \" << snd_strerror(pcmError) << std::endl;\n\t\t\treturn 1;\n\t\t}\n\t\tsnd_pcm_hw_params_alloca(&params);\n\t\tint error=0;\n\t\terror=snd_pcm_hw_params_any(handle, params);\n\t\tif(error) std::cout << \"snd_pcm_hw_params_any failure : \" << error << std::endl;\n\t\terror=snd_pcm_hw_params_set_access(handle,params,SND_PCM_ACCESS_RW_INTERLEAVED);\n\t\tif(error) std::cout << \"snd_pcm_hw_params_set_access failure : \" << error << std::endl;\n\t\terror=snd_pcm_hw_params_set_format(handle,params,SND_PCM_FORMAT_S16_BE);\t//LE\n\t\tif(error) std::cout << \"snd_pcm_hw_params_set_format failure : \" << error << std::endl;\n\t\terror=snd_pcm_hw_params_set_channels(handle,params,2);\n\t\tif(error) std::cout << \"snd_pcm_hw_params_set_channels failure : \" << error << std::endl;\n\t\terror=snd_pcm_hw_params_set_rate(handle,params,44100,SND_PCM_STREAM_CAPTURE);\n\t\tif(error) std::cout << \"snd_pcm_hw_params_set_rate failure : \" << error << std::endl;\n\n\t\tint hwParams=snd_pcm_hw_params(handle,params);\n\t\tif(hwParams){\n\t\t\tstd::cout << \"snd_pcm_hw_params failure : \" << hwParams << std::endl;\n\t\t}\n\t\tsnd_pcm_uframes_t frames;\n\t\tsnd_pcm_hw_params_get_period_size(params,&frames,NULL);\n\t\tstd::cout << \"testPCMIn \" << name << \" frame:\" << frames << std::endl;\n\t\tAudioBuffer buffer(frames,2);\n\t\tfor (int i = 0; i < 1000; i++) {\n\t\t\tint readCount=snd_pcm_readi(handle,buffer.pcmBuffer,frames);\n\t\t\tdouble power=buffer.area();\n\t\t\tif(readCount<0){\n\t\t\t\tstd::cout << \"!@!\" << std::endl;\n\t\t\t}\n//\t\t\tstd::cout << readCount << \":\" << power << std::endl;\n\t\t}\n\t\tstd::cout << \"recordPCM complete\" << std::endl; \n\t\tint pcmClose=snd_pcm_close(handle);\n\t\tif(pcmClose){\n\t\t\tstd::cout << \"snd_pcm_close returned \" << pcmClose << std::endl;\n\t\t}\n\t\treturn 0;\n\t}\n\n\tint testPCMIn(std::string name,std::string &result){\n\t\tsnd_pcm_t *handle;\n\t\tsnd_pcm_hw_params_t *params;\n\t\tint pcmError=snd_pcm_open(&handle,name.c_str(),SND_PCM_STREAM_CAPTURE,0);\n\t\tif(pcmError){\n\t\t\tstd::cout << \"snd_pcm_open error \" << pcmError << \", \" << snd_strerror(pcmError) << std::endl;\n\t\t\treturn 1;\n\t\t}\n\t\tsnd_pcm_hw_params_alloca(&params);\n\t\tsnd_pcm_hw_params_any(handle, params);\n\t\tsnd_pcm_hw_params_set_access(handle,params,SND_PCM_ACCESS_RW_INTERLEAVED);\n\t\tsnd_pcm_hw_params_set_format(handle,params,SND_PCM_FORMAT_S16_LE);\n\t\tsnd_pcm_hw_params_set_channels(handle,params,2);\n\t\tsnd_pcm_hw_params_set_rate(handle,params,48000,SND_PCM_STREAM_CAPTURE);\n\t\tint hwParams=snd_pcm_hw_params(handle,params);\n\t\tif(hwParams){\n\t\t\tstd::cout << \"snd_pcm_hw_params failure : \" << hwParams << std::endl;\n\t\t}\n\t\tsnd_pcm_uframes_t frames;\n\t\tsnd_pcm_hw_params_get_period_size(params,&frames,NULL);\n\t\tstd::cout << \"testPCMIn \" << name << \" frame:\" << frames << std::endl;\n\t\tAudioBuffer buffer(frames,2);\n\t\tfor (int i = 0; i < 1000; i++) {\n\t\t\tint readCount=snd_pcm_readi(handle,buffer.pcmBuffer,frames);\n\t\t\tdouble power=buffer.area();\n\t\t\tstd::cout << readCount << \":\" << power << std::endl;\n\t\t}\n\t\tint pcmClose=snd_pcm_close(handle);\n\t\tif(pcmClose){\n\t\t\tstd::cout << \"snd_pcm_close returned \" << pcmClose << std::endl;\n\t\t}\n\t\treturn 0;\n\t}\n\n\tint testPCMOut(std::string name,std::string &result){\n\t\tstd::cout << \"testAudioOut snd_pcm_open \" << name << std::endl;\n\n\t\tsnd_pcm_t *handle;\n\t\tsnd_pcm_hw_params_t *params;\n\n\t\tint pcmError=snd_pcm_open(&handle,name.c_str(),SND_PCM_STREAM_PLAYBACK,0);\n\n\t\tif(pcmError){\n\t\t\tstd::cout << \"snd_pcm_open error \" << pcmError << \", \" << snd_strerror(pcmError) << std::endl;\n\t\t\treturn 1;\n\t\t}\n\n\t//\tconst char *name=snd_pcm_name(handle);\n\n\t\tsnd_pcm_hw_params_alloca(&params);\n\t\tsnd_pcm_hw_params_any(handle, params);\n\n\t\tsnd_pcm_hw_params_set_access(handle,params,SND_PCM_ACCESS_RW_INTERLEAVED);\n\t\tsnd_pcm_hw_params_set_format(handle,params,SND_PCM_FORMAT_S16_LE);\n\t\tsnd_pcm_hw_params_set_channels(handle,params,2);\n\t\tsnd_pcm_hw_params_set_rate(handle,params,48000,SND_PCM_STREAM_PLAYBACK);\n\t\tint hwParams=snd_pcm_hw_params(handle,params);\n\t\tif(hwParams){\n\t\t\tstd::cout << \"snd_pcm_hw_params failure : \"<<hwParams<<std::endl;\n\t\t\treturn 2;\n\t\t}\n\n\t\tsnd_pcm_uframes_t frames;\n\t\tsnd_pcm_hw_params_get_period_size(params,&frames,NULL);\n\t\tstd::cout << \"period size:\"<<frames<<std::endl;\n\n\t\tSynthStream source(frames,2);\n\t\tfor(int i=0;i<350;i++){\n\t\t\tsource.mixPCM(handle);\n\t\t}\n\t\tsnd_pcm_drain(handle);\n\n\t\tint pcmClose=snd_pcm_close(handle);\n\t\tif(pcmClose){\n\t\t\tstd::cout << \"snd_pcm_close returned \" << pcmClose << std::endl;\n\t\t}\n\t\t\n\t\treturn 0;\n\t}\n\n\n// https://chromium.googlesource.com/chromium/src/+/32352ad08ee673a4d43e8593ce988b224f6482d3/media/midi/midi_manager_alsa.cc\n\n\tint captureMidiIn(snd_seq_t *seq){\n\t\tsnd_seq_addr_t sender={64,0};\n\t\tsnd_seq_addr_t dest={128,0};\n\t\tsnd_seq_port_subscribe_t *subs;\n\t\t\n//\t\tsnd_seq_port_subscribe_malloc(&subs);\n\t\tsnd_seq_port_subscribe_alloca(&subs);\n\t\tsnd_seq_port_subscribe_set_sender(subs, &sender);\n\t\tsnd_seq_port_subscribe_set_dest(subs, &dest);\n\t\tsnd_seq_port_subscribe_set_queue(subs, 1);\n\t\tsnd_seq_port_subscribe_set_time_update(subs, 1);\n\t\tsnd_seq_port_subscribe_set_time_real(subs, 1);\n\t\tint result=snd_seq_subscribe_port(seq, subs);\n\n\t\tif(result<0){\n\t\t\tstd::cout << \"captureMidiIn snd_seq_subscribe_port error \" << result << \" \" << snd_strerror(result) << std::endl;\n\t\t}\n\t\treturn result;\n\t}\n\n\tint testMidiIn(std::string name,std::string &result){\n\t\tstd::cout << \"testMidiIn snd_seq_open \" << name << std::endl;\n\t\tsnd_seq_t *handle;\n\t\tint seqError=snd_seq_open(&handle,name.c_str(),SND_SEQ_OPEN_INPUT,0);\n\t\tif(seqError){\n\t\t\tstd::cout << \"snd_seq_open error \" << seqError << \", \" << snd_strerror(seqError) << std::endl;\n\t\t\treturn 1;\n\t\t}\n\t\tsnd_seq_set_client_name(handle, \"ALSA Sequencer Test\");\n\t\tint inCaps=SND_SEQ_PORT_CAP_WRITE | SND_SEQ_PORT_CAP_NO_EXPORT;\n\t\tint inType=SND_SEQ_PORT_TYPE_MIDI_GENERIC | SND_SEQ_PORT_TYPE_APPLICATION;\n\t\tint inPort=snd_seq_create_simple_port(handle,NULL,inCaps,inType);\n//\t\tint in=snd_seq_create_simple_port(handle,\"listen:in\",SND_SEQ_PORT_CAP_WRITE|SND_SEQ_PORT_CAP_SUBS_WRITE,SND_SEQ_PORT_TYPE_APPLICATION);\n//\t\tint in=snd_seq_create_simple_port(handle,\"listen:in\",SND_SEQ_PORT_CAP_WRITE|SND_SEQ_PORT_CAP_SUBS_WRITE,SND_SEQ_PORT_TYPE_MIDI_GENERIC);\n\t\tcaptureMidiIn(handle);\n\t\twhile(1){\n\t\t    snd_seq_event_t *ev = NULL;\n   \t\t \tsnd_seq_event_input(handle, &ev);\n\t\t}\n\t\tsnd_seq_close(handle);\n\t\treturn 0;\n\t}\n};\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/dsptool/native/archive/fft.h\",\"length\":1549,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\r\n\r\n#include \"nitrohost.h\"\r\n#include <complex>\r\n\r\ntypedef std::vector<int> IntVector;\r\ntypedef std::vector<float> NumberVector;\r\ntypedef std::complex<float> Complex;\r\ntypedef std::vector<Complex> ComplexVector;\r\n\r\nstruct FourierTransform{\r\n\r\n\tstatic int reverseBits(int value,int bits){\r\n\t\tint result=0;\r\n\t\twhile(bits--){\r\n\t\t\tresult<<=1;\r\n\t\t\tresult|=value&1;\r\n\t\t\tvalue>>=1;\r\n\t\t}\r\n\t\treturn result;\r\n\t}\r\n\r\n\tIntVector reverseLut;\r\n\tComplexVector rotationLut;\r\n\r\n\tFourierTransform(int bits){\r\n\t\tsize_t n = 1<<bits;\r\n\t\treverseLut.resize(n);\r\n\t\trotationLut.resize(n);\r\n\t\tfor(size_t i=0;i<n;i++){\r\n\t\t\treverseLut[i]=reverseBits(i,bits);\r\n\t\t\tdouble r=M_PI*2*i/n;\r\n\t\t\trotationLut[i]=Complex(cos(r),sin(r));\r\n\t\t}\r\n\t}\r\n\r\n\tvoid magnitude(NumberVector &points){\r\n\t\tsize_t n=points.size();\r\n\t\tComplexVector input(n);\r\n\t\tfor(size_t i=0;i<n;i++){\r\n\t\t\tinput[i]=Complex(points[reverseLut[i]],0);\r\n\t\t}\r\n\t\tfor(size_t i=2;i<=n;i*=2){\r\n\t\t\tsize_t i2=i/2;\r\n\t\t\tsize_t wstep=n/i;\r\n\t\t\tfor(size_t j=0;j<n;j+=i){\r\n\t\t\t\tfor(size_t k=0;k<i2;k++){\r\n\t\t\t\t\tComplex even=input[j+k];\r\n\t\t\t\t\tComplex twiddle=input[j+k+i2] * rotationLut[wstep * k];\r\n\t\t\t\t\tinput[j+k]=even+twiddle;\r\n\t\t\t\t\tinput[j+k+i2]=even-twiddle;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(size_t i=0;i<n;i++){\r\n\t\t\tpoints[i]=abs(input[i]);\r\n\t\t}\r\n\t}\r\n};\r\n\r\n\r\n\r\nvoid testFFT(int bits){\r\n\tFourierTransform fft(bits);\r\n\tsize_t size=1<<bits;\r\n\tNumberVector points(size);\t\r\n\tfor(size_t i=0;i<size;i++){\r\n\t\tpoints[i]=(i&32)?1:-1;\r\n\t}\r\n\tfft.magnitude(points);\r\n\tfor(size_t i=0;i<size;i++){\r\n\t\tstd::cout << points[i] << std::endl;\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/dsptool/native/archive/iop_defintions.h\",\"length\":9631,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// MARINE STEREO. COPYRIGHT (C) 2019 FUSION NZ LTD. ALL RIGHTS RESERVED.\n\n#ifndef __IOP_DEFS_H__\n#define __IOP_DEFS_H__\n\n\n// IOP message IDs\n#define IOP_CMND_DATA                   10\n#define IOP_RGN_DATA                    36\n#define IOP_UNIT_ID_DATA                38\n#define IOP_RGN_CMPLT                   45\n#define IOP_RGN_STRT_RX                 75\n#define IOP_RGN_PRODUCT_INFO_SUMMARY    164\n#define IOP_ANT_TEST                    260\n#define IOP_BT_TX_CARRIER_FREQ          354\n#define IOP_BT_SET_DISCOVERY_MODE       363\n#define IOP_NET_UPDATE_BEGIN            576\n#define IOP_NET_UPDATE_DONE             577\n#define IOP_RGN_FLUSH_WRITE_CACHE       955\n#define IOP_WIFI_RXTEST_START           1638\n#define IOP_WIFI_RXTEST_DATA            1639\n#define IOP_WIFI_TEST_SET_CHNL          1640\n#define IOP_WIFI_TEST_SET_MOD           1641\n#define IOP_WIFI_TEST_SET_PWR           1642\n#define IOP_WIFI_TESTMODE_CHNG          1643\n#define IOP_WIFI_TESTMODE_DATA          1644\n#define IOP_WIFI_STATUS                 1645\n#define IOP_WIFI_SET_MAC_ADDR           1672\n#define IOP_WIFI_ADDR_DATA              1673\n#define IOP_WIFI_SET_IP_ADDR            1674\n#define IOP_WIFI_CONNECTION_INFO        1675\n#define IOP_IPOD_AUTH_RSLT              1921\n#define IOP_GPIO_CMD                    3079\n#define IOP_GPIO_DATA                   3080\n#define IOP_WIFI_EXT_SET_COUNTRY_CODE   5357\n#define IOP_WIFI_EXT_CREATE_AP          5359\n#define IOP_WIFI_EXT_GET_CNCTN_CNT      5360\n#define IOP_USED_UNIT_FLAG_DATA         6284\n#define IOP_SET_USED_UNIT_FLAG          6820\n\n#define IOP_FUSION_TEST_REQUEST         6022\n#define IOP_FUSION_TEST_REPLY           6023\n\n// Connection Control Service IOP message IDs for CDM (and eth update)\n#define IOP_NET_CCS_HEARTBEAT           910  /* Periodically transmitted heartbeat   */\n#define IOP_NET_CCS_SET_SYS_MODE        911  /* Set the system mode                  */\n#define IOP_NET_CCS_PROD_INFO_RQST      913  /* Product information request          */\n#define IOP_NET_CCS_PROD_INFO_DATA      914  /* Product information data             */\n#define IOP_NET_CCS_SET_ALIAS_NAME      915  /* Set the alias name                   */\n#define IOP_NET_CCS_BLD_DESC_DATA       916  /* Build Description Data               */\n#define IOP_NET_CCS_UNIT_ID_RQST        918  /* Unit ID request                      */\n#define IOP_NET_CCS_UNIT_ID_DATA        919  /* Unit ID data                         */\n#define IOP_NET_CCS_SET_PWR_LVL         922  /* Set the power level (replaces IOP_NET_CCS_SET_SLEEP_LVL) */\n#define IOP_NET_CCS_PROD_DATA           923  /* Product Data                         */\n#define IOP_NET_CCS_END                 924\n\n// Default CDM IOP message IDs\n//NOTE: these may need to be supported outside the object\n#define IOP_NET_ADDR_BYTE               570      /* Set the network address to a fixed value (no negotiation) */\n#define IOP_PRODUCT_RQST                249\n#define IOP_PRODUCT_RQST_EXTEND         254\n#define IOP_PRODUCT_DATA                255\n#define IOP_ACK_BYTE                    6\n#define IOP_RQST_DATA                   28\n#define IOP_SYC_MODE_DATA               47\n\n// IOP_CMND_DATA 'sub message IDs'\n#define IOP_DOWN_LOAD_ID                14\n#define IOP_BT_ADDR_DATA                351\n#define IOP_BT_GET_BDADDR               430\n#define IOP_BT_SET_TEST_MODE            433\n#define IOP_WIFI_START_TESTMODE         761\n#define IOP_WIFI_RXTEST_CALC            762\n#define IOP_WIFI_TXTEST_START           763\n#define IOP_WIFI_TXTEST_STOP            764\n#define IOP_WIFI_TEST_GET_STATUS        765\n#define IOP_WIFI_RXTEST_STOP            766\n#define IOP_WIFI_STOP_TESTMODE          767\n#define IOP_WIFI_GET_MAC_ADDR           783\n#define IOP_IPOD_AUTH_TEST              904\n#define IOP_START_REMANUFACTURE         1482\n#define IOP_REQ_USED_UNIT_FLAG          1697\n\n// Default CDM IOP_CMND_DATA 'sub message IDs'\n//NOTE: these may need to be supported outside the object\n#define IOP_CLR_NONVOL_UNPROTECTED_ONLY 39   /* clear unprotected nonvol                 */\n#define IOP_REQ_PRODUCT_INVENTORY       151  /* Request Product Inventory                */\n#define IOP_REQ_PRODUCT_INFO            163  /* Request GRM_product_info_type            */\n#define IOP_REQ_PRODUCT_INFO_SUMMARY    164  /* Request GRM_product_info_summary_type    */\n//#define IOP_DOWN_LOAD_ID                14   /* down load unit identification            */\n#define IOP_REBOOT                      174  /* Reboots the unit                         */\n#define IOP_POWER_OFF                   8    /* turn off the power                       */\n#define IOP_REQ_SYC_MODE                118  /* Request SYC Mode                         */\n\n#define FUSION_TEST_RESULT_SUCCESS              1\n#define FUSION_TEST_RESULT_FAIL                 2\n#define FUSION_TEST_RESULT_ALREADY_IN_TEST_MODE 3\n#define FUSION_TEST_RESULT_NOT_IN_TEST_MODE     4\n#define FUSION_TEST_RESULT_UNKNOWN_TEST         5\n#define FUSION_TEST_RESULT_INCORRECT_SOURCE     6\n\n#define IPOD_AUTH_TEST_RESULT_SUCCESS           1\n#define IPOD_AUTH_TEST_RESULT_FAIL              2\n#define IPOD_AUTH_TEST_RESULT_COMMAND_SEND_FAIL 3\n\n#define FUSION_CMD_TEST_MODE                    1\n#define FUSION_CMD_TEST_MUTE                    2\n#define FUSION_CMD_TEST_SET_SOURCE              3\n#define FUSION_CMD_TEST_KEY_EVENT               4\n#define FUSION_CMD_TEST_SET_AM_FREQUENCY        5\n#define FUSION_CMD_TEST_SET_FM_FREQUENCY        6\n#define FUSION_CMD_TEST_BATTERY_RAW_ADC_EVENT   7\n#define FUSION_CMD_TEST_GET_BT_MAC              8\n#define FUSION_CMD_TEST_SET_ESN                 9\n#define FUSION_CMD_TEST_GET_ESN                 10      // 0x0A\n#define FUSION_CMD_TEST_IGNORE_BATTERY_VOLTAGE_CHECK  11// 0x0B\n#define FUSION_CMD_TEST_LOW_POWER               12      // 0x0C - Not Supported for Piranha\n#define FUSION_CMD_TEST_GET_STATUS              13      // 0x0D\n#define FUSION_CMD_TEST_SET_MAC_ADDRESS         14      // 0x0E\n#define FUSION_CMD_TEST_SET_IP_ADDRESS          15      // 0x0F\n#define FUSION_CMD_TEST_FACTORY_RESET           16      // 0x10\n#define FUSION_CMD_TEST_MUTE_ALL                17      // 0x11\n#define FUSION_CMD_TEST_N2K_POWER               18      // 0x12\n#define FUSION_CMD_TEST_PSU_FREQUENCY           19      // 0x13 - Not Supported for Piranha\n#define FUSION_CMD_TEST_AMP_FREQUENCY           20      // 0x14 - Not Supported for Piranha\n#define FUSION_CMD_TEST_GET_MAC_ADDRESS         21      // 0x15\n#define FUSION_CMD_TEST_GET_IP_ADDRESS          22      // 0x16\n#define FUSION_CMD_TEST_SET_BEEPER              23      // 0x17 - Not Supported for Piranha\n#define FUSION_CMD_TEST_SET_BACKLIGHT           24      // 0x18 - Not Supported for Piranha\n#define FUSION_CMD_TEST_SET_LCD_CONTRAST        25      // 0x19 - Not Supported for Piranha\n#define FUSION_CMD_TEST_GET_MAINBOARD_ID        26      // 0x1A\n#define FUSION_CMD_TEST_GET_FRONTBOARD_ID       27      // 0x1B\n#define FUSION_CMD_TEST_SET_ZONE_VOLUMES        28      // 0x1C\n#define FUSION_CMD_TEST_GET_DIM_INPUT           30      // 0x1E\n#define FUSION_CMD_TEST_GET_TELEMUTE_INPUT      31      // 0x1F\n#define FUSION_CMD_TEST_GET_BT_VERSION          32      // 0x20\n#define FUSION_CMD_TEST_GET_DVD_VERSION         33      // 0x21\n#define FUSION_CMD_TEST_SET_BT_RETRIES          34      // 0x22\n#define FUSION_CMD_TEST_CLEAR_BT_PAIR_LIST      35      // 0x23\n#define FUSION_CMD_TEST_SCREEN_TEST             36      // 0x24 - Not Supported for Piranha (remove)\n#define FUSION_CMD_TEST_SET_BT_DISCOVERABLE     37      // 0x25\n#define FUSION_CMD_TEST_EEPROM_TEST             39      // 0x27\n#define FUSION_CMD_TEST_USB_OVERCURRENT         57      // 0x39\n#define FUSION_CMD_TEST_TUNER_REGION            65      // 0x41\n#define FUSION_CMD_TEST_AMP_TEMPERATURE         68      // 0x44\n#define FUSION_CMD_TEST_GET_VIDEO_DETECT_INPUT  69      // 0x45\n#define FUSION_CMD_TEST_DOCK_POWER              70      // 0x46\n#define FUSION_CMD_TEST_GET_ACCY_OFF_DELAY      71      // 0x47\n#define FUSION_CMD_TEST_SET_ACCY_OFF_DELAY      72      // 0x48\n#define FUSION_CMD_TEST_BT_RX_TEST_MODE         73      // 0x49\n#define FUSION_CMD_TEST_GET_DEFAULT_REGION      75      // 0x4B\n#define FUSION_CMD_TEST_SET_DEFAULT_REGION      76      // 0x4C\n#define FUSION_CMD_TEST_BOARD_TEMPERATURE       77      // 0x4D\n#define FUSION_CMD_TEST_BT_TX_TEST_MODE         78      // 0x4E\n#define FUSION_CMD_TEST_EXTERNAL_AMP_CONTROL    79      // 0x4F\n#define FUSION_CMD_TEST_INTERANL_AMP_CONTROL    82      // 0x52\n#define FUSION_CMD_TEST_GET_AMPBOARD_ID         83      // 0x53\n#define FUSION_CMD_TEST_TOUCH_BUTTON_VERSION    84      // 0x54\n#define FUSION_CMD_TEST_TOUCH_PANEL_TEST        85      // 0x55\n#define FUSION_CMD_TEST_SET_SOURCE_GAIN         86      // 0x56\n#define FUSION_CMD_TEST_AUDIO_TEST_TONE         90      // 0x5A\n#define FUSION_CMD_TEST_DISABLE_WIFI            96      // 0x60\n#define FUSION_CMD_TEST_PROCESSING_BYPASS       97      // 0x61\n#define FUSION_CMD_TEST_SET_SUB_LEVEL           98      // 0x62\n#define FUSION_CMD_TEST_TOUCH_PANEL_TEST_PASS   99      // 0x63\n#define FUSION_CMD_TEST_SET_WATCHDOG            100     // 0x64\n#define FUSION_CMD_TEST_SET_SUB_CUTOFF_FREQ     101     // 0x65\n#define FUSION_CMD_TEST_CAN_LOOPBACK            102     // 0x66\n#define FUSION_CMD_TEST_GET_HW_BREAK_NUM        103     // 0x67\n#define FUSION_CMD_TEST_DSP_VOLTAGE_READ        104     // 0x68\n#define FUSION_CMD_TEST_ADC_RAW_GET             105     // 0x69\n#define FUSION_CMD_TEST_ACCY_DELAY_RESET        106     // 0x6A\n#define FUSION_CMD_TEST_LED_CONTROL             107     // 0x6B\n#define FUSION_CMD_TEST_BT_PCM_LOOPBACK_MODE    108     // 0x6C\n\n#endif\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/dsptool/native/archive/ffti.h\",\"length\":2609,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n#include <vector>\n#include <complex>\n#include <iostream>\n#include <cstdint>\n\nstruct ComplexInt{\n\tint x;    //real.15\n\tint y;    //imaginary.15\n\n\tComplexInt(){\n\t\tx=y=0;\n\t}\n\n\tComplexInt(const ComplexInt &a){\n\t\tx=a.x;\n\t\ty=a.y;\n\t}\n\n\tComplexInt(int a,int b){\n\t\tx=a;\n\t\ty=b;\n\t}\n\n\tint magnitude(){\n\t\tint64_t xxyy=(int64_t)x*x+(int64_t)y*y;\n\t\tint64_t a = xxyy * 5;\n\t\tint64_t b = 5;\n\t\twhile( a >= b ){\n\t\t\ta = a - b;\n\t\t\tb = b + 10;\n\t\t}\n\t\treturn (int)b / 10;\n\t}\n\n\tstatic ComplexInt multiply(const ComplexInt &a,const ComplexInt &b){\n\t\tint64_t real=((int64_t)a.x*b.x-(int64_t)a.y*b.y)>>15;\n\t\tint64_t imag=((int64_t)a.x*b.y+(int64_t)a.y*b.x)>>15;\n\t\treturn ComplexInt((int)real,(int)imag);\n\t}\n};\n\ntypedef std::vector<int> IntVector;\ntypedef std::vector<short> ShortVector;\ntypedef std::vector<ComplexInt> ComplexIntVector;\ntypedef std::complex<float> Complex;\n\nstruct FourierTransformInt{\n\n\tIntVector reverseLut;\n\tComplexIntVector rotationLut;\n\n\tstatic int reverseBits(int value,int bits){\n\t\tint result=0;\n\t\tfor(int i=0;i<bits;i++){\n\t\t\tresult<<=1;\n\t\t\tresult|=value&1;\n\t\t\tvalue>>=1;\n\t\t}\n\t\treturn result;\n\t}\n\n\tFourierTransformInt(int bits){\n\t\tsize_t size=1 << bits;\n\t\treverseLut.resize(size);\n\t\trotationLut.resize(size);\t\n\t\tfor(size_t i=0;i<size;i++){\n\t\t\tComplex w = std::exp(Complex(0, i*2*M_PI/size));\n\t\t\trotationLut[i] = ComplexInt((int)(0x8000*w.real()),(int)(0x8000*w.imag()));\n\t\t\treverseLut[i]=reverseBits(i,bits);\n\t\t}\n\t}\n\n\tvoid magnitude(ShortVector points,IntVector &result){\n\t\tsize_t n=points.size();\n\t\tComplexIntVector input(n);\n\n\t\tfor(size_t i=0;i<n;i++){\n\t\t\tinput[i]=ComplexInt(points[reverseLut[i]],0);\n\t\t}\n\t\t\n\t\tfor(size_t i=2;i<=n;i*=2){\n\t\t\tsize_t i2=i/2;\n\t\t\tsize_t wstep=n/i;\n\t\t\tfor(size_t j=0;j<n;j+=i){\n\t\t\t\tfor(size_t k=0;k<i2;k++){\n\t\t\t\t\tComplexInt even=input[j+k];\n\t\t\t\t\tComplexInt twiddle=ComplexInt::multiply(input[j+k+i2],rotationLut[wstep * k]);\n\t\t\t\t\tinput[j+k]=ComplexInt(even.x+twiddle.x,even.y+twiddle.y);\n\t\t\t\t\tinput[j+k+i2]=ComplexInt(even.x-twiddle.x,even.y-twiddle.y);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t\n\t\tfor(size_t i=0;i<n;i++){\n\t\t\tresult[i]=input[i].magnitude();\n\t\t}\n\t}\n\n};\n\nvoid testFFTInt(int bits){\n\n\tFourierTransformInt fft(bits);\n\n\tsize_t size=1<<bits;\n\n\tShortVector points(size);\n\tIntVector spectrum(size);\n\n\tfor(size_t i=0;i<size;i++){\n//        float a=sinf(i*2*M_PI/(n>>3));\n//        points[i]=0x7fff*a;\n\t\tpoints[i]=(i&32)?0x7fff:0x8001;\n\t}\n\n\tfft.magnitude(points,spectrum);\n\n\tdouble one=1.0/0x8000;\n\n\tfor(size_t i=0;i<size;i++){\n\t\tstd::cout << (one*spectrum[i]) << std::endl;\n\t}\n}\n\nvoid testComplex14(){\n\tComplexInt c(0x7fff,0x7fff);\n\tint m=c.magnitude();\n\tstd::cout << m << std::endl;\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/dsptool/native/archive/fft-i.h\",\"length\":2314,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\r\n\r\n#include \"nitrohost.h\"\r\n#include <cmath>\r\n\r\nuint32_t isqrt( uint32_t y ){\r\n\tuint32_t a = 5 * y;\r\n\tuint32_t b = 5;\r\n\twhile( a >= b ){\r\n\t\ta = a - b;\r\n\t\tb = b + 10;\r\n\t}\r\n\treturn b / 10;\r\n}\r\n\r\n// fixed point fourier transform for pico speaker test\r\n\r\nstruct ComplexShort{\r\n    int16_t x,y;\r\n\r\n    ComplexShort(float a,float b){\r\n        x=32767*a;\r\n        y=32767*b;\r\n    }\r\n\r\n    ComplexShort(short a,short b){\r\n        x=a;\r\n        y=b;\r\n    }\r\n\r\n    // exp(a*b)\r\n\r\n    ComplexShort(ComplexShort a,float b)\r\n    {\r\n\r\n    }\r\n\r\n    static ComplexShort multiply(){\r\n\r\n    }\r\n\r\n    short magnitude(){\r\n        int xxyy=(((int)x*x)>>16)+(((int)y*y)>>16);\r\n        return isqrt(xxyy);\r\n    }\r\n};\r\n\r\ntypedef std::vector<int> IntVector;\r\ntypedef std::vector<int16_t> ShortVector;\r\ntypedef std::vector<ComplexShort> ComplexShortVector;\r\n\r\nstruct ShortFourierTransform{\r\n\r\n\tIntVector radInvLut;\r\n\tComplexShortVector wLut;\r\n\tComplexShortVector nwLut;\r\n\r\n\tShortFourierTransform(size_t size){\r\n\t\tradInvLut.resize(size);\r\n\t\twLut.resize(size);\r\n\t\tnwLut.resize(size);\r\n\t\tfloat w = 2 * M_PI / size;\r\n\t\tComplexShort iw(0, w);\r\n\t\tComplexShort niw(0, -w);\r\n\t\tfor(size_t i=0;i<size;i++){\r\n\t\t\tradInvLut[i]=i;\r\n\t\t\twLut[i] = std::exp(iw * (float)i);\r\n\t\t\tnwLut[i] = std::exp(niw * (float)i);\r\n\t\t}\r\n\t\tradixInvert(radInvLut);\r\n\t}\r\n\r\n\tvoid radixInvert(IntVector &points){\r\n\t\tint n = points.size();\r\n\t\tif (n == 1) return;\r\n\t\tint n2 = n / 2;\r\n\t\tIntVector even(n2);\r\n\t\tIntVector odd(n2);\r\n\t\tfor (int i = 0; i < n2; i++) {\r\n\t\t\teven[i] = points[i * 2];\r\n\t\t\todd[i] = points[i * 2 + 1];\r\n\t\t}\r\n\t\tradixInvert(even);\r\n\t\tradixInvert(odd);\r\n\t\tfor (int i = 0; i < n2; i++){\r\n\t\t\tpoints[i] = even[i];\r\n\t\t\tpoints[i + n2] = odd[i];\r\n\t\t}\r\n\t}\r\n\r\n\tvoid magnitude(ShortVector &points){\r\n\t\tsize_t n=points.size();\r\n\t\tComplexShortVector temp(n);\r\n\r\n\t\tfor(size_t i=0;i<n;i++){\r\n\t\t\ttemp[i]=ComplexShort(points[radInvLut[i]],0);\r\n\t\t}     \r\n\t\t\r\n\t\tfor(size_t i=2;i<=n;i*=2){\r\n\t\t\tsize_t i2=i/2;\r\n\t\t\tsize_t wstep=n/i;\r\n\t\t\tfor(size_t j=0;j<n;j+=i){\r\n\t\t\t\tfor(size_t k=0;k<i2;k++){\r\n\t\t\t\t\tComplexShort even=temp[j+k];\r\n\t\t\t\t\tComplexShort twiddle=Complex16.multiply(temp[j+k+i2], (wLut[wstep * k]));\r\n\t\t\t\t\ttemp[j+k]=even+twiddle;\r\n\t\t\t\t\ttemp[j+k+i2]=even-twiddle;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\tfor(size_t i=0;i<n;i++){\r\n\t\t\tpoints[i]=temp[i].magnitude();\r\n\t\t}\r\n\t}\r\n};\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/Users/simon/nitrologic/dsptool/native/archive/6800.html\",\"length\":99182,\"type\":\"text/html\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"\r\n<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n\t<meta charset=\"utf-8\" />\r\n\r\n\t<meta property='og:url' content='http://www.8bit-era.cz/6800.html'/>\r\n\t<meta property='og:type' content='website'/>\r\n\t<meta property='og:title' content='6800 instruction set'/>\r\n\t<meta property='og:site_name' content='8bit-era.cz'/>\r\n\t<meta property='og:description' content='MC6800 decoding table, full instruction set with description. Addition to my web based MC6800 assembler.'/>\r\n\r\n\t<title>6800 instruction set</title>\r\n<style type=\"text/css\" media=\"all\">\r\n\t#page { font-family: sans-serif; font-size: 12pt; width: 70em; margin: 0 auto;}\r\n\t#page>* { width: 100%;}\r\n\r\n\ta { color: black; text-decoration: none; }\r\n\ta[href] { text-decoration: underline; -moz-text-decoration-color: silver; -webkit-text-decoration-color: silver; text-decoration-color: silver; }\r\n\ta[href]:hover {  -moz-text-decoration-color: black; -webkit-text-decoration-color: black; text-decoration-color: black; }\r\n\r\n\tul { list-style: none; margin: 0;}\r\n\tp, ul li { padding-left: 4em; position: relative; margin: 2px 0; }\r\n\tp b, ul li b { display: inline-block; width: 4em; position: relative; left: -4em; margin-right: -4em; }\r\n\th1 { font-size: 220%; text-align: center;}\r\n\th1 a {text-decoration: underline; font-style: italic;}\r\n\th2 { font-size: 180%; }\r\n\th3 { font-size: 150%; page-break-before: always; }\r\n\th4 { margin: 5pt 0;}\r\n\r\n\t#alpha-list { border-collapse: collapse; border-spacing: 0; }\r\n\t#alpha-list a { display: block; text-align: center; cursor: pointer; }\r\n\r\n\t#decoding-table { border-collapse: collapse; border-spacing: 0;}\r\n\t#decoding-table td { border: 1pt solid silver; text-align: center; padding: 3pt 0; font-size: 80%; }\r\n\t#decoding-table td:first-line { font-size: 130%; }\r\n\t#decoding-table td:empty { background: #eee; }\r\n\t#decoding-table tr:first-child td, #decoding-table td:first-child { background: #666; color: white; }\r\n\t\r\n\r\n\t#maxitable { border-collapse: collapse; border-spacing: 0; margin-top: 20pt; page-break-before: always; }\r\n\t#maxitabl