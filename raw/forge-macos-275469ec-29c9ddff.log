 \n\t\tif(n==0) {\n\t\t\tstd::cout << \"readProcess timeout\" << std::endl;\n\t\t\treturn \"\";\n\t\t}\n\t\treturn utf8(buffer,n);\n\t}\n\n\tvoid runRead(){\n\n\t}\n\n\n\n//\t\tstereo->logLine(\"tick \"+session+\" #\"+clientId);\n//\t\tstd::cout << \"t\";\n//\t\tsleep(1);\n\n\n\tint cpuok=testCPU();\n\tstd::cout << \"CPU test : \" << cpuok << std::endl;\n\n\nenum AddressingMode {\n    IMMEDIATE,\n    DIRECT,\n    EXTENDED,\n    INDEXED,\n    INHERENT,\t//IMPLICIT IMPLIED\n    RELATIVE,\n    UNKNOWN\n};\n\nenum Instruction {\n    NOP,\n    TAP,\n    TPA,\n    INX,\n    DEX,\n    CLV,\n    SEV,\n    CLC,\n    SEC,\n    CLI,\n    SEI,\n    LDA,\n    LDB,\n    BRA,\n    BCC,\n    UNKNOWN_INSTRUCTION\n};\n\nstruct InstructionInfo {\n    Instruction instruction;\n    AddressingMode mode;\n};\n\nstruct V6808{\n\tint a,b,x,y,u,s,pc;\n\tint cc;\n};\n\n// Lookup table for instructions and addressing modes of the 6809 CPU\n\nInstructionInfo m6809Lookup[] = {\n\t{NOP, INHERENT},\n\t{TAP, INHERENT},\n\t{TPA, INHERENT},\n\t{INX, INHERENT},\n\t{DEX, INHERENT},\n\t{CLV, INHERENT},\n\t{SEV, INHERENT},\n\t{CLC, INHERENT},\n\t{SEC, INHERENT},\n\t{CLI, INHERENT},\n\t{SEI, INHERENT},\n\t{LDA, IMMEDIATE},\n\t{LDB, IMMEDIATE},\n\t{BRA, RELATIVE},\n\t{BCC, RELATIVE}\n};\n\nconst char* instructionToString(Instruction instruction) {\n    switch (instruction) {\n        case NOP: return \"NOP\";\n        case TAP: return \"TAP\";\n        case TPA: return \"TPA\";\n        case INX: return \"INX\";\n        case DEX: return \"DEX\";\n        case CLV: return \"CLV\";\n        case SEV: return \"SEV\";\n        case CLC: return \"CLC\";\n        case SEC: return \"SEC\";\n        case CLI: return \"CLI\";\n        case SEI: return \"SEI\";\n        case LDA: return \"LDA\";\n        case LDB: return \"LDB\";\n        case BRA: return \"BRA\";\n        case BCC: return \"BCC\";\n        default: return \"Unknown Instruction\";\n    }\n}\n\nconst char* addressingModeToString(AddressingMode mode) {\n    switch (mode) {\n        case IMMEDIATE: return \"Immediate\";\n        case DIRECT: return \"Direct\";\n        case EXTENDED: return \"Extended\";\n        case INDEXED: return \"Indexed\";\n        case INHERENT: return \"Inherent\";\n        case RELATIVE: return \"Relative\";\n        default: return \"Unknown\";\n    }\n}\n\n\n//#include \"steam.h\"\n//\tint steamtest=testSteam();\n//\tstd::cout << \"steamtest \" << steamtest << std::endl;\n\n\nadd_definitions( -DHAS_STEAM )\n\n\nint hostProcess(){\n\tpid_t pid;\n\tconst char *args[] = {\"test\",\"args\",0};\n\tchar *env = {0};\n\t// actions,attributes\n\t//posix_spawnattr_init\n\tint status = posix_spawn(&pid,path,NULL,NULL,args,env);\n\treturn 0;\n}\n\n\nint testProcess(){\n\tconst char *args=\"1 2 3\";\n\tJSValue *params=parseCommandLine(args);\n\tutf8 result;\n\tint error = stereo->sysConnect(params,result);\n\tstd::cout << \"testProcess \" << result << std::endl;\n\tutf8 session=\"none\";\n/*\n\tfor(int i=0;i<10;i++){\n\t\tstereo->poll(session);\n\t\tstd::cout << \"poll \" << result << std::endl;\n\t\tusleep(1e5);\n\t}\n*/\n\treturn error;\n}\n\n\n\t}else if(method==\"sys.runapp\"){\n\t\terror=stereo->runApp(params,result);\n\t}else if(method==\"sys.killapp\"){\n\t\terror=stereo->killApp(params,result);\n\n\n/*\n\t\t\tstring cmd = \".\\\\binary\\\\acid500.exe\";\n\t\t\tstring args = \"\";\n\t\t\tstring dir = \".\\\\media\\\\Acid32\\\\\";\n\t\t\tProcessConnection proc = new ProcessConnection(cmd, args, dir, hostName, id);\n\t\t\tint count = ++ConnectionCount;\n\t\t\tstring name = hostName + \":\" + count;\n\t\t\tstring key = \"Handle.\" + Sha2HashBytes(name, HandleSalt);\n\t\t\tnamedConnections.Add(key, proc);\n\t\t\tproc.Connect(sink);\n\t\t\treturn JsonString(key);\n\t\n*/\n\n/*\n\tint runApp(JSValue *params,utf8 &result){\n\t\tchar *app=(char*)\"fmounter\";\n\t\tchar *argv[]={app,0};\n\t\tchar *envp[]={0};\n\t\tint forkPid=fork();\n\t\tif(forkPid==0){\n\t\t\tint error=execve(path,argv,envp);\n\t