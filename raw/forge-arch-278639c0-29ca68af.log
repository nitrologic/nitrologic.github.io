28dd6f10 [claude-sonnet-5] #Glad that fixed it! Since you've shared the full `wirejs` codebase now, here's what stands out —
28dd6f10 [claude-sonnet-5] #including confirmation of where the original bug lived, plus a couple of things worth fixing
28dd6f10 [claude-sonnet-5] #proactively.
28dd6f10 [claude-sonnet-5] #
28dd6f10 [claude-sonnet-5] #Confirmed: Where the Tainted Canvas Error Actually Fires
28dd6f10 [claude-sonnet-5] #
28dd6f10 [claude-sonnet-5] #In `wire_core.js`, `ShareTexture()` is the exact call site:
28dd6f10 [claude-sonnet-5] #
28dd6f10 [claude-sonnet-5] #
28dd6f10 [claude-sonnet-5] #function ShareTexture(gl,image){
28dd6f11 [claude-sonnet-5] #	if(image.src in SharedTextures){
28dd6f11 [claude-sonnet-5] #		const tc=SharedTextures[image.src];
28dd6f11 [claude-sonnet-5] #		tc.count++;
28dd6f11 [claude-sonnet-5] #		return tc;
28dd6f11 [claude-sonnet-5] #	}
28dd6f11 [claude-sonnet-5] #	const texture = gl.createTexture();
28dd6f11 [claude-sonnet-5] #	gl.bindTexture(gl.TEXTURE_2D, texture);
28dd6f11 [claude-sonnet-5] #	gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);
28dd6f11 [claude-sonnet-5] #	...
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #This is fed by `Shape.loadTexture()`, called from `addTileShape`/`addStaticShape` in
28dd6f11 [claude-sonnet-5] #`wire_graphics.js`, using `tile.scratch` — the 2D canvas built in `TopoTile.createScratch()`
28dd6f11 [claude-sonnet-5] #(`wire_topo.js`). So the full chain is:
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #HtmlImage (cross-origin jpg) → drawImage onto tile.scratch → scratch used as WebGL texture → texImage2D throws
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #Good to have this pinned down precisely for next time.
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #⚠️ One Gap That's Still Open (Currently Dormant)
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #
28dd6f11 [claude-sonnet-5] #class HtmlImage{
28dd6f11 [claude-sonnet-5] #	constructor(tile,layer,partial){
28dd6f11 [claude-sonnet-5] #		...
28dd6f11 [claude-sonnet-5] #		const image=new Image();
28dd6f11 [claude-sonnet-5] #		image.onload=this.imageLoad.bind(this);
28dd6f12 [claude-sonnet-5] #		image.onerror=this.imageError.bind(this);
28dd6f12 [claude-sonnet-5] #		this.image=image;
28dd6f12 [claude-sonnet-5] #	}
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #This still has no `crossOrigin` set — and it's the loader used for `aerialgrid` JPEGs
28dd6f12 [claude-sonnet-5] #(`loadTileImage` in `wire_topo.js`). Right now this isn't biting you because:
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #let AppRuntime={
28dd6f12 [claude-sonnet-5] #	UseAerial:false,
28dd6f12 [claude-sonnet-5] #	UseLINZ:true
28dd6f12 [claude-sonnet-5] #};
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #Aerial imagery is switched off. But the moment someone flips `UseAerial:true`, this exact
28dd6f12 [claude-sonnet-5] #tainted-canvas error will likely come straight back — since this `Image` never opts into CORS mode.
28dd6f12 [claude-sonnet-5] #Worth adding `image.crossOrigin="anonymous";` here now while it's fresh, rather than rediscovering
28dd6f12 [claude-sonnet-5] #it later.
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #Curiosity: `TextureLoader`'s Non-Standard crossOrigin Value
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #
28dd6f12 [claude-sonnet-5] #class TextureLoader{
28dd6f12 [claude-sonnet-5] #	constructor(path,handler){
28dd6f12 [claude-sonnet-5] #		...
28dd6f12 [claude-sonnet-5] #		const image=new Image();
28dd6f12 [claude-sonnet-5] #		image.crossOrigin="dsptool";
28dd6f12 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #`"dsptool"` isn't a valid `crossOrigin` value (valid values are `"anonymous"` or
28dd6f13 [claude-sonnet-5] #`"use-credentials"`). It happens to work only because the HTML spec's invalid-value-default
28dd6f13 [claude-sonnet-5] #for this attribute falls back to `"Anonymous"` — so this is functioning by accident rather than by
28dd6f13 [claude-sonnet-5] #design. Recommend just writing `"anonymous"` explicitly so it's not confusing to the next reader
28dd6f13 [claude-sonnet-5] #(or future you).
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #Two Actual Bugs Spotted While Reading
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #• 1. `wire_immersion.js` — undefined `vr` reference:*
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #function failVR(){
28dd6f13 [claude-sonnet-5] #	console.log("failVR:"+vr.length);
28dd6f13 [claude-sonnet-5] #}
28dd6f13 [claude-sonnet-5] #...
28dd6f13 [claude-sonnet-5] #function enableXRDevice(){
28dd6f13 [claude-sonnet-5] #	console.log("enableXRDevice:"+vr.length);
28dd6f13 [claude-sonnet-5] #}
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #Neither function has a `vr` in scope — both would throw `ReferenceError` if actually invoked. Looks
28dd6f13 [claude-sonnet-5] #like leftover from copy-pasting `enableVR(vr)`.
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #• 2. `wire_util.js` — undefined `border` in `Bits.cropTopo`:*
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #cropTopo(heightmap,height){
28dd6f13 [claude-sonnet-5] #	...
28dd6f13 [claude-sonnet-5] #	for(var bx=-border;bx<=border;bx++){
28dd6f13 [claude-sonnet-5] #
28dd6f13 [claude-sonnet-5] #`border` is never a parameter or local here (compare with `digTopo`, which does take `border` as a
28dd6f14 [claude-sonnet-5] #param). This would throw if `cropTopo` is ever called — currently it's only referenced once,
28dd6f14 [claude-sonnet-5] #commented out in `TopoTile.cropOutline`, so it's dormant but broken if reactivated.
28dd6f14 [claude-sonnet-5] #
