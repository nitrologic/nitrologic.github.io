28b34afc [gemini-3.8-flash] #🟠nitrologic Relay 2.0.3 gemini-3.8-flash 🌟 🪣 0.7° $0.005 1.177KB 4.40s
28b34afc [gemini-3.8-flash] #To prepare `/dev/sda` for general storage on Arch Linux, the standard approach is to write a fresh
28b34afc [gemini-3.8-flash] #GPT partition table, create a partition spanning the full 2.7 TiB, and format it with a native
28b34afc [gemini-3.8-flash] #Linux filesystem such as `ext4` or `btrfs`.
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #Before starting, ensure there is no data on `/dev/sda` that you need to retain, as this will erase
28b34afd [gemini-3.8-flash] #existing partition data.
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #1. Wipe and Partition the Disk
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #You can use `fdisk` to initialize a GPT partition table and create one large partition:
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #sudo fdisk /dev/sda
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #Within the `fdisk` prompt:
28b34afd [gemini-3.8-flash] #1. Type `g` to create a new empty GPT partition table.
28b34afd [gemini-3.8-flash] #2. Type `n` to add a new partition (you can accept the default partition number, first sector, and
28b34afd [gemini-3.8-flash] #last sector to use the entire disk).
28b34afd [gemini-3.8-flash] #3. Type `w` to write the table to disk and exit.
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #Alternatively, this can be done in a single non-interactive command using `parted`:
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #sudo parted /dev/sda --script mklabel gpt mkpart primary 0% 100%
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #This creates `/dev/sda1`.
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b34afd [gemini-3.8-flash] #
28b34afd [gemini-3.8-flash] #2. Create the Filesystem
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #Depending on your preference:
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #• For standard `ext4`:
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #  sudo mkfs.ext4 -L storage /dev/sda1
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #• For `btrfs` (supports snapshots and subvolumes):
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #  sudo mkfs.btrfs -L storage /dev/sda1
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #3. Mount and Set Ownership
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #Create a mount point (for instance, `/mnt/storage`):
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #sudo mkdir -p /mnt/storage
28b34afe [gemini-3.8-flash] #sudo mount /dev/sda1 /mnt/storage
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #To give your user account (`skid`) write access to the mount root:
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #
28b34afe [gemini-3.8-flash] #sudo chown -R skid:skid /mnt/storage
28b34afe [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #4. Automatic Mounting via `/etc/fstab` (Optional)
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #To mount the drive automatically on boot, retrieve its UUID:
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #lsblk -f /dev/sda1
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #Then append an entry to `/etc/fstab` using the UUID. For example, for an `ext4` system:
28b34aff [gemini-3.8-flash] #
28b34aff [gemini-3.8-flash] #
