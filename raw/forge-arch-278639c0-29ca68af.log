29860686 [deepseek-flash] #`outlines` is the array of `drawing.outlines[start+i]` vertex arrays. Plain structured clone, no
29860686 [deepseek-flash] #transfer list. `depth`/`border` sent from main so the knobs stay in `wire_grid.js`.
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #Worker state and gate
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #`refresh()` currently fires on `topoCount==heightmaps.length` alone. It needs a second gate,
29860686 [deepseek-flash] #because the outlines arrive on a different fetch.
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #let topoCount;
29860686 [deepseek-flash] #let digReady=false;
29860686 [deepseek-flash] #let digDepth=4;
