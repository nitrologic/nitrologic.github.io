27867aba [gemini-3.8-flash] #You can install `bmdtools` from the AUR using `yay`:
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #yay -S bmdtools-git
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #• (Note: If `bmdtools-git` does not resolve, check for `bmdtools`.)*
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #How to use `bmdcapture`
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #The primary utility provided is `bmdcapture`. Unlike generic capture cards, Blackmagic hardware
27867aba [gemini-3.8-flash] #requires the capture format (resolution and framerate mode) to match the incoming signal precisely.
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #1. Query available cards and supported modes
27867aba [gemini-3.8-flash] #Run `bmdcapture` with the `-h` flag to inspect available mode integers and identify your device:
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #bmdcapture -h
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #Look through the printed list for the mode corresponding to your input signal (for example,
27867aba [gemini-3.8-flash] #`1080p59.94`, `1080p60`, or `720p60`). Each mode corresponds to a number (such as `-m 12`).
27867aba [gemini-3.8-flash] #
27867aba [gemini-3.8-flash] #2. Pipe into standard FFmpeg
27867aba [gemini-3.8-flash] #Once you know your device index (usually `-C 0`) and the video mode number, you can stream raw
27867abb [gemini-3.8-flash] #video to standard output and pipe it straight into `ffmpeg`.
27867abb [gemini-3.8-flash] #
27867abb [gemini-3.8-flash] #For example, to capture raw video/audio and encode it to an MP4 file:
27867abb [gemini-3.8-flash] #
27867abb [gemini-3.8-flash] #
27867abb [gemini-3.8-flash] #bmdcapture -C 0 -m <mode_number> -A 2 -V 3 -F nut -f /dev/stdout | ffmpeg -i - -c:v libx264 -preset fast -c:a aac output.mp4
27867abb [gemini-3.8-flash] #
27867abb [gemini-3.8-flash] #
27867abb [gemini-3.8-flash] #• `-C 0`: Selects the first Blackmagic device (Intensity Pro 4K).
27867abb [gemini-3.8-flash] #• `-m <mode_number>`: The video format detected from `-h`.
27867abb [gemini-3.8-flash] #• `-A 2`: Audio input selection (e.g., embedded HDMI audio or analog RCA).
27867abb [gemini-3.8-flash] #• `-V 3`: Video input format (e.g., HDMI or Component).
27867abb [gemini-3.8-flash] #• `-F nut -f /dev/stdout`: Encapsulates the uncompressed stream in a lightweight container suitable
27867abb [gemini-3.8-flash] #for piping to standard output.
27867abb [gemini-3.8-flash] #• `ffmpeg -i -`: Instructs FFmpeg to read the piped stream from standard input.
27867abb [gemini-3.8-flash] #
