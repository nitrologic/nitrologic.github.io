299cc108 [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.021 1.422MB 22.23s
299cc108 [deepseek-flash] #Order doesn't matter to the worker. The gate is `topoCount==heightmaps.length && digReady`, so the
299cc108 [deepseek-flash] #outlines can arrive before or after the topo, and `createTopo` fires when the last of the two
299cc108 [deepseek-flash] #lands. Sending early is safe — the worker just holds the outlines.
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #What matters on the main thread is completeness: send once, when you have the whole outline
299cc108 [deepseek-flash] #set for the tile.
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #The condition
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #if(this.digSent) return;
299cc108 [deepseek-flash] #if(this.drawingCount!=this.drawings.length) return;
299cc108 [deepseek-flash] #this.digSent=true;
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #`drawingCount` is incremented at request time in `fetchDrawing`, `drawings.length` at response time
299cc108 [deepseek-flash] #in `onDrawingResponse`. So `drawingCount == drawings.length` is true only once every requested
299cc108 [deepseek-flash] #drawing has responded — including the error path, which also calls `onDrawingResponse`.
299cc108 [deepseek-flash] #
299cc108 [deepseek-flash] #Two call sites, both needed
299cc108 [deepseek-flash] #
299cc109 [deepseek-flash] #- End of `onDrawingResponse` — the normal path.
299cc109 [deepseek-flash] #- End of `fetchTopoTile`, after the instance is created — the zero-drawings path. Covers
299cc109 [deepseek-flash] #`level>=3`, `UseLINZ=false`, and tiles with no `roa` layer in range. Without this, `digReady` never
299cc109 [deepseek-flash] #becomes true and the worker stalls forever: no bump, no flora, no tile.
299cc109 [deepseek-flash] #
299cc109 [deepseek-flash] #The two are mutually exclusive given the completeness check. At the end of `fetchTopoTile`, if
299cc109 [deepseek-flash] #drawings were requested then `drawingCount>0` and `drawings.length==0`, so it skips;
299cc109 [deepseek-flash] #`onDrawingResponse` sends later. If none were requested, `0==0` and it sends an empty list;
299cc109 [deepseek-flash] #`onDrawingResponse` never fires.
299cc109 [deepseek-flash] #
299cc109 [deepseek-flash] #The instance
299cc109 [deepseek-flash] #
299cc109 [deepseek-flash] #`this.instance` is guaranteed to exist by the time either site runs. `fetchTopoTile` creates it
299cc109 [deepseek-flash] #synchronously at the end of its source loop, and `fetchDrawing`'s `.then` callbacks are queued
299cc109 [deepseek-flash] #behind that synchronous body. So no check needed — but if you'd rather be defensive,
299cc109 [deepseek-flash] #`if(this.instance)` costs nothing.
299cc109 [deepseek-flash] #
299cc109 [deepseek-flash] #The guard
