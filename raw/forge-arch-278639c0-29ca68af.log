ReplyObject(reply);\r\n\t\treturn error;\r\n\t}\r\n\r\n\tint runBlob(utf8 commandb,utf8 slob,utf8 &result){\r\n\t\tstd::lock_guard<std::mutex> lock(contextMutex);\r\n\t\tint error=0;\r\n\t\tvoid *reply = redisCommand(context, commandb.c_str(), slob.c_str(), slob.length());\r\n\t\tif(reply){\r\n\t\t\terror=replyJsonString((redisReply *)reply,result);\r\n\t\t\tstd::cout << \"Stereo Redis reply:\" << result << std::endl;\t\t\t\r\n\t\t}else{\r\n\t\t\tutf8 error=quotedString(context->errstr);\r\n\t\t\tstd::cout << \"redis runBlob failure:\" << error << std::endl;\r\n\t\t\tresult=error;\r\n\t\t\terror=context->err;\r\n\t\t}\r\n\t\tfreeReplyObject(reply);\r\n\t\treturn error;\r\n\t}\r\n\r\n\tStrings parseCommand(utf8 commandLine){\r\n\t\tStrings strings;\r\n\t\tbool inQuotes=false;\r\n\t\tchar lastChar=0;\r\n\t\tutf8 word;\r\n\t\tfor(char c:commandLine){\r\n\t\t\tswitch(c){\r\n\t\t\t\tcase '\"':\r\n\t\t\t\t\tif(lastChar=='\\\\'){\r\n\t\t\t\t\t\tword.push_back(c);\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tif(inQuotes){\r\n//\t\t\t\t\t\t\t\tword+=\"\\\"\";\r\n\t\t\t\t\t\t\tinQuotes=false;\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tinQuotes=true;\r\n\t\t\t\t\t\t\tif(word.length()){\r\n\t\t\t\t\t\t\t\tstrings.push_back(word);\r\n\t\t\t\t\t\t\t}\r\n//\t\t\t\t\t\t\t\tword=\"\\\"\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase ' ':\r\n\t\t\t\t\tif(inQuotes){\r\n\t\t\t\t\t\tword.push_back(c);\r\n\t\t\t\t\t}else{ \r\n\t\t\t\t\t\tif(word.length()){\r\n\t\t\t\t\t\t\tstrings.push_back(word);\r\n\t\t\t\t\t\t\tword=\"\";\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tword.push_back(c);\r\n\t\t\t}\r\n\t\t\tlastChar=c;\r\n\t\t}\r\n\t\tif(word.length()){\r\n\t\t\tstrings.push_back(word);\r\n\t\t}\r\n\t\treturn strings;\r\n\t}\r\n\r\n\t// fix me\r\n\r\n\tint runStrings(utf8 commandLine,Strings &result){\r\n\t\tstd::lock_guard<std::mutex> lock(contextMutex);\r\n\t\tStrings strings=parseCommand(commandLine);\r\n\t\tint error=0;\t\t\r\n\t\tstd::vector<const char *> args;\r\n\t\tstd::vector<size_t> lens;\r\n\t\tfor(utf8 &s:strings){\r\n\t\t\targs.push_back(s.c_str());\r\n\t\t\tlens.push_back(s.length());\r\n\t\t}\r\n\t\tvoid *reply=redisCommandArgv(context,args.size(),args.data(),lens.data());\r\n\t\tif(reply){\r\n\t\t\terror=replyStrings((redisReply *)reply,result);\r\n\t\t\tstd::cout << \"redis runStrings result:\" << result.size() << std::endl;\t\t\t\r\n\t\t\tfreeReplyObject(reply);\r\n\t\t}else{\r\n\t\t\tutf8 error=quotedString(context->errstr);\r\n\t\t\tstd::cout << \"redis runStrings failure:\" << error << std::endl;\r\n//\t\t\tresult=error;\r\n\t\t\terror=context->err;\r\n\t\t}\r\n\t\treturn error;\r\n\t}\r\n\r\n\r\n\tint run(utf8 commandLine,utf8 &result,bool quoted){\r\n\t\tstd::lock_guard<std::mutex> lock(contextMutex);\r\n\t\tint error=0;\r\n\t\tvoid *reply;\r\n\t\tsize_t quote=commandLine.find('\"');\r\n\t\tif(quote!=std::string::npos){\r\n\t\t\tStrings strings=parseCommand(commandLine);\r\n\t\t\tstd::vector<const char *> args;\r\n\t\t\tstd::vector<size_t> lens;\r\n\t\t\tfor(utf8 &s:strings){\r\n\t\t\t\targs.push_back(s.c_str());\r\n\t\t\t\tlens.push_back(s.length());\r\n\t\t\t}\r\n\t\t\treply=redisCommandArgv(context,args.size(),args.data(),lens.data());\r\n\t\t}else{\r\n\t\t\treply=redisCommand(context,commandLine.c_str());\r\n\t\t}\r\n\t\tif(reply){\r\n\t\t\terror=quoted?replyJsonString((redisReply *)reply,result):replyPlainString((redisReply *)reply,result);\r\n//\t\t\tstd::cout << \"redis run reply:\" << result << std::endl;\t\t\t\r\n\t\t\tif(result!=\"+OK\"){\r\n// todo fix\t\t\t\tstd::cout << result;\r\n\t\t\t}\r\n\t\t\tfreeReplyObject(reply);\r\n\t\t}else{\r\n\t\t\tutf8 error=quotedString(context->errstr);\r\n\t\t\tstd::cout << \"redis run1 failure:\" << error << std::endl;\r\n\t\t\tstd::cout << commandLine << std::endl;\r\n\t\t\tresult=error;\r\n\t\t\terror=context->err;\r\n\t\t}\r\n\t\treturn error;\r\n\t}\r\n\r\n\tint run(Strings strings,utf8 &result,bool quoted){\r\n\t\tstd::lock_guard<std::mutex> lock(contextMutex);\r\n\t\tint error=0;\r\n\t\tvoid *reply;\r\n\t\tstd::vector<const char *> args;\r\n\t\tstd::vector<size_t> lens;\r\n\t\tfor(utf8 &s:strings){\r\n\t\t\targs.push_back(s.c_str());\r\n\t\t\tlens.push_back(s.length());\r\n\t\t}\r\n\t\treply=redisCommandArgv(context,args.size(),args.data(),lens.data());\r\n\t\tif(reply){\r\n\t\t\terror=quoted?replyJsonString((redisReply *)reply,result):replyPlainString((redisReply *)reply,result);\r\n//\t\t\tstd::cout << \"redis run reply:\" << result << std::endl;\t\t\r\n//\t\t\tif(result!=\"+OK\") std::cout << result;\t\r\n\t\t\tfreeReplyObject(reply);\r\n\t\t}else{\r\n\t\t\tutf8 error=quotedString(context->errstr);\r\n\t\t\tstd::cout << \"redis run2 failure:\" << error << std::endl;\r\n\t\t\tresult=error;\r\n\t\t\terror=context->err;\r\n\t\t}\r\n\t\treturn error;\r\n\t}\r\n\r\n\tint graph(utf8 command,NitroNode &result){\r\n\t\tint error=0;\r\n\t\tvoid *reply=redisCommand(context,command.c_str());\r\n\t\tif(reply){\r\n\t\t\terror=replyGraph((redisReply *)reply,result);\r\n\t\t\tstd::cout << \"Stereo Redis reply:\" << result.toString() << std::endl;\t\t\t\r\n\t\t}else{\r\n\t\t\tutf8 error=quotedString(context->errstr);\r\n\t\t\tstd::cout << \"redis graph failure:\" << error << std::endl;\r\n\t\t\tresult.name=error;\r\n\t\t\terror=context->err;\r\n\t\t}\r\n\t\tfreeReplyObject(reply);\r\n\t\treturn error;\r\n\t}\r\n\r\n};\r\n\r\nstruct Sink:RedisContext{\r\n\tutf8 streamName;\r\n\tutf8 command;\r\n\tutf8 from;\r\n\r\n\tSink(utf8 host,utf8 stream){\r\n\t\tcontext = redisConnect(host.c_str(),8082);\r\n\t\tutf8 result=\"\";\r\n\t\tstreamName=stream;\r\n\t\tfrom=\"$\";\r\n\t\tcommand=\"XREAD BLOCK 0 STREAMS \"+streamName+\" 0\";\r\n\t}\r\n\r\n\tvoid stringrun(bool quoted){\r\n\t\tutf8 result;\r\n\t\twhile(true){\r\n\t\t\tint error=RedisContext::run(command,result,quoted);\r\n\t\t\tif(error){\r\n\t\t\t\tstd::cout << \"Sink:run FAIL \" << command << \" => \" << result << std::endl;\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\tstd::cout << \"Sink:run OK \" << command << \" => \" << result << std::endl;\r\n\t\t\tfrom=result;\r\n\t\t\tcommand=\"XREAD BLOCK 0 STREAMS \"+streamName+\" \"+from;\r\n\t\t}\r\n\t}\r\n\r\n\tvoid onStream(utf8 from,const NitroNode &graph){\r\n\t\tstd::cout << \"onStream:\" << graph.toString() << std::endl;\r\n\t}\r\n\r\n\tvoid run(){\r\n\t\tNitroNode result;\r\n\t\twhile(true){\r\n\t\t\tint error=RedisContext::graph(command,result);\t\t\t\r\n\t\t\tutf8 s=result.toString();\r\n\t\t\tif(error){\r\n\t\t\t\tstd::cout << \"Sink:run FAIL \" << command << \" => \" << s << std::endl;\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\tstd::cout << \"Sink:run OK \" << command << \" => \" << s << std::endl;\r\n\r\n\t\t\tutf8 quotedStreamName=quoted(streamName);\r\n\t\t\tfor(const NitroNode &root:result.kids){\r\n\t\t\t\tint index=0;\r\n\t\t\t\tbool inStream=false;\r\n\t\t\t\tfor(const NitroNode &stream:root.kids){\r\n\t\t\t\t\tif(inStream){\r\n\t\t\t\t\t\tfor(const NitroNode &packet:stream.kids){\r\n\t\t\t\t\t\t\tint j=0;\r\n\t\t\t\t\t\t\tfor(const NitroNode &log:packet.kids){\r\n\t\t\t\t\t\t\t\tif(j>0){\r\n\t\t\t\t\t\t\t\t\tonStream(from,log);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\tif(j==0){\r\n\t\t\t\t\t\t\t\t\tfrom=unquote(log.name);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\tj++;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(index==0 && stream.name==quotedStreamName){\r\n\t\t\t\t\t\tinStream=true;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tindex++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcommand=\"XREAD BLOCK 0 STREAMS \"+streamName+\" \"+from;\r\n\t\t}\r\n\t}\r\n\r\n};\r\n\r\nstruct Scribe:RedisContext{\r\n//\tevent_base *base;\r\n\tredisAsyncContext *async;\r\n\tutf8 command;\r\n\r\n\tstatic void onMessage(redisAsyncContext *c, void *reply, void *privdata) {\r\n\t\tredisReply *r = (redisReply*)reply;\r\n\t\tif (reply == NULL) return;\r\n\r\n\t\tif (r->type == REDIS_REPLY_ARRAY) {\r\n\t\t\tfor (int j = 0; j < r->elements; j++) {\r\n\t\t\t\tprintf(\"%u) %s\\n\", j, r->element[j]->str);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// todo: matching destructor\r\n\r\n\tScribe(utf8 host,utf8 channel){\r\n//\t\tbase = event_base_new();\r\n\t\tasync=redisAsyncConnect(host.c_str(),8082);\r\n\t\tcontext=&async->c;\r\n\t\tcommand=\"subscribe \"+channel;\r\n\t}\r\n\r\n\tvoid run(){\r\n//\t    redisLibeventAttach(async, base);\r\n\t    redisAsyncCommand(async, onMessage, this, command.c_str());\r\n//\t    event_base_dispatch(base);\r\n\t}\r\n};\r\n\r\nstruct Redis:RedisContext{\r\n\tutf8 host;\r\n\tstd::vector<Scribe> scribes;\r\n\tint sessionCount=0;\r\n\r\n\tRedis(){\r\n\t}\r\n\r\n\tint runRedis(utf8 command,utf8 &result,bool quoted){\r\n#ifdef LOG_REDIS\r\n\t\tstd::cout << command << std::endl;\r\n#endif\t\t\r\n\t\tint error=RedisContext::run(command,result,quoted);\r\n\t\treturn error;\r\n\t}\r\n\r\n\tint runRedis(Strings strings,utf8 &result,bool quoted){\r\n//\t\tstd::cout << joinStrings(strings,\" \") << std::endl;\r\n\t\tint error=RedisContext::run(strings,result,quoted);\r\n\t\treturn error;\r\n\t}\r\n\r\n\tint connectValkey(utf8 address){\r\n\t\thost=address;\r\n\t\tcontext = redisConnect(address.c_str(),6379);\r\n\t\tif(context==NULL) return -1;\r\n\t\tstd::cout << \"connectValkey context\" << context << std::endl;\r\n\t\tutf8 result=\"\";\r\n// TODO: tidy me\r\n\t\tint error=0;\r\n#ifdef VALKEY\r\n\t\terror=run(\"AUTH valkey2026\",result,true);\r\n#endif\r\n\t\tif(error==0){\r\n\t\t\terror=run(\"INCR SESSIONCOUNT\",result,false);\r\n\t\t\tif(error==0){\r\n\t\t\t\tsessionCount=std::stoi(result);\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn error;\r\n\t}\r\n\r\n\tstatic void *redisScribe(void *args){\r\n\t\tScribe *scribe=(Scribe*)args;\r\n\t\tscribe->run();\r\n\t\treturn NULL;\r\n\t}\r\n\r\n\tstatic void *redisSink(void *args){\r\n\t\tSink *sink=(Sink*)args;\r\n\t\tsink->run();\r\n\t\treturn NULL;\r\n\t}\r\n\r\n\tint subscribe(utf8 channel,utf8 &result){\r\n\t\tresult=\"\\\"OK\\\"\";\r\n\t\tpthread_t scribeThread=0;\r\n\t\tconst pthread_attr_t *threadAttributes=NULL;\r\n\t\tvoid *args=new Scribe(host,channel);\r\n\t\tint pthreadError=pthread_create(&scribeThread,threadAttributes,redisScribe,args);\r\n\t\tif(pthreadError){\r\n\t\t\tstd::cout << \"Redis subscribe pthread_create failed\" << std::endl;\r\n\t\t\treturn 1;\r\n\t\t}\r\n\t\treturn 0;\t\t\r\n\t}\r\n\r\n\tint sink(utf8 command,utf8 &result){\r\n\t\tresult=\"\\\"OK\\\"\";\r\n\t\tpthread_t sinkThread=0;\r\n\t\tconst pthread_attr_t *threadAttributes=NULL;\r\n\t\tvoid *args=new Sink(host,command);\r\n\t\tint pthreadError=pthread_create(&sinkThread,threadAttributes,redisSink,args);\r\n\t\tif(pthreadError){\r\n\t\t\tstd::cout << \"Redis sink pthread_create failed\" << std::endl;\r\n\t\t\treturn 1;\r\n\t\t}\r\n\t\treturn 0;\t\t\r\n\t}\r\n\r\n};\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/select.h\",\"length\":585,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":" #include <stdio.h>\n#include <stdlib.h>\n#include <sys/select.h>\n\nint main(void){\n\tfd_set rfds;\n\tstruct timeval tv;\n\tint retval;\n\n\t/* Watch stdin (fd 0) to see when it has input. */\n\n\tFD_ZERO(&rfds);\n\tFD_SET(0, &rfds);\n\n\t/* Wait up to five seconds. */\n\n\ttv.tv_sec = 5;\n\ttv.tv_usec = 0;\n\n\tretval = select(1, &rfds, NULL, NULL, &tv);\n\t/* Don't rely on the value of tv now! */\n\n\tif (retval == -1)\n\t\tperror(\"select()\");\n\telse if (retval)\n\t\tprintf(\"Data is available now.\\n\");\n\t\t/* FD_ISSET(0, &rfds) will be true. */\n\telse\n\t\tprintf(\"No data within five seconds.\\n\");\n\n\texit(EXIT_SUCCESS);\n}","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/synth.h\",\"length\":3743,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n#include \"nitrohost.h\"\n#include <set>\n#include <cmath>\n\n#ifdef USE_ALSA_AUDIO\n#include <alsa/asoundlib.h>\n#endif\n\ntypedef float V; //voltage\ntypedef float F; //frequency\ntypedef float T; //time\n\nstruct Oscillator{\n\tT delta=0.0;\n\tvirtual V sample(F hz){\n\t\treturn 0.0;\n\t}\n};\n\nstruct Square:Oscillator{\n\tV sample(F hz){\n\t\tdelta+=hz/AudioFrequency;\n\t\treturn -1+2*(int(delta)&1);\n\t}\n};\n\nstruct Sine:Oscillator{\n\tV sample(F hz){\n\t\tdelta+=hz/AudioFrequency;\n\t\treturn sinf(2*M_PI*delta);\n\t}\n};\n\nstruct Saw:Oscillator{\n\tV sample(F hz){\n\t\tdelta+=hz/AudioFrequency;\n\t\treturn fmod(delta+1,2.0)-1;\n\t}\n};\n\nstruct Triangle:Oscillator{\n\tV sample(F hz){\n\t\tdelta+=hz/AudioFrequency;\n\t\treturn fabs(fmod(delta,2.0))-1;\n\t}\n};\n\nstruct Noise:Oscillator{\n\tV a=0.5;\n\tV sample(F hz){\n\t\tT d=delta;\n\t\tdelta+=hz/AudioFrequency;\n\t\tif(int(d)!=int(delta)){\n\t\t\ta=float(rand())/RAND_MAX;\n\t\t}\n\t\treturn 1-2*a;\n\t}\n};\n\nstruct Envelope{\n\tvirtual V On(){return 1.0;}\n\tvirtual V Off(){return 0.0;}\n};\n\nstruct ADSR:Envelope{\n\tT attack;\n\tT decay;\n\tV sustain;\n\tT release;\n\n\tbool noteOn=false;\n\tT t=0.0;\n\tV value=0.0;\n\n\tADSR(T attack,T decay,V sustain,T release):attack(attack),decay(decay),sustain(sustain),release(release){\t\t\n\t}\n\n\tV On(){\n\t\tif(!noteOn){\n\t\t\tt=0.0;\n\t\t\tnoteOn=true;\n\t\t}\n\t\tt+=1.0/AudioFrequency;\n\t\tV v=sustain;\n\t\tif (t<attack){\n\t\t\tv=t/attack;\n\t\t}else if(t-attack<decay){\n\t\t\tv=1.0-(1-sustain)*((t-attack)/decay);\n\t\t}\n\t\tvalue=v;\n\t\treturn v;\n\t}\n\n\tV Off(){\n\t\tif(noteOn){\n\t\t\tt=0.0;\n\t\t\tnoteOn=false;\n\t\t}\n\t\tt+=1.0/AudioFrequency;\n\t\treturn (t<release)?value*(1.0-t/release):0.0;\n\t}\n};\n\nstruct Voice{\n\tOscillator *osc;\n\tEnvelope *env;\n\tF hz=0.0;\n\tV pan=0.0;\n\tV amp=0.4;\n\tbool on=false;\n\n\tVoice(Oscillator *osc,Envelope *env):osc(osc),env(env){\t\t\n\t}\n\n\tvoid playNote(int note){\n\t\thz=440.0*powf(2.0,(note-67.0)/12);\n\t\ton=true;\n\t}\n\n\tvoid stopNode(){\n\t\ton=false;\n\t}\n\n\tvoid stereoMix(float *buffer,int samples){\n\t\tV left=1.0;\n\t\tV right=1.0;\n\t\tif(pan<0) right+=pan;\n\t\tif(pan>0) left-=pan;\n\t\tfor(int i=0;i<samples;i++){\n\t\t\tV v=osc->sample(hz)*amp;\n\t\t\tV e=on?env->On():env->Off();\n\t\t\tif(e==0.0) {\n\t\t\t\tosc->delta=0.0;\n\t\t\t}else{\n\t\t\t\tbuffer[i*2+0]+=e*left*v;\n\t\t\t\tbuffer[i*2+1]+=e*right*v;\n\t\t\t}\n\t\t}\n\t}\n\n};\n\nstruct AudioBuffer{\n\tint frames;\n\tint channels;\n\tint16_t *pcmBuffer;\n\n\tAudioBuffer(int frames,int channels):frames(frames),channels(channels){\n\t\tint count=frames*channels*2;\n\t\tpcmBuffer=new int16_t[count];\n\t}\n\n\t~AudioBuffer(){\n\t\tdelete[] pcmBuffer;\n\t}\n\n\tdouble area(){\n\t\tdouble total;\n\t\tfor(int i=1;i<frames;i++){\n\t\t\tint ldiff=(int)pcmBuffer[i*2+0]-pcmBuffer[(i-1)*2+0];\n\t\t\tint rdiff=(int)pcmBuffer[i*2+1]-pcmBuffer[(i-1)*2+1];\n\t\t\ttotal+=ldiff*ldiff+rdiff*rdiff;\n\t\t}\n\t\treturn total;\n\t}\n};\n\nstruct SynthStream:AudioBuffer{\n\tV *mixBuffer;\n\tstd::set<Voice*> voices;\n\n\tSynthStream(int frames,int channels):AudioBuffer(frames,channels){\n\t\tint count=frames*channels;\n\t\tmixBuffer=new float[count];\n\t\tplayNote(60);\n\t\tplayNote(64);\n\t\tplayNote(67);\n\t}\n\n\t~SynthStream(){\n\t\tdelete []mixBuffer;\n\t}\n\n\tvoid playNote(int note){\n\t\tVoice *voice=new Voice(new Square(),new ADSR(0.06,0.01,0.92,0.2));//0.001,1.5,0.8,0.5));\n\t\tvoice->playNote(note);\n\t\tvoices.insert(voice);\n\t}\n\tint mixDown(){\n\t\tint count=frames*channels;\n\t\tmemset(mixBuffer,0,count*4);\n\t\tfor(Voice*voice:voices){\n\t\t\tvoice->stereoMix(mixBuffer,frames);\n\t\t}\n\t\tfor(int i=0;i<count;i++){\n\t\t\t// todo: limit float before conversion\n\t\t\tfloat f=mixBuffer[i];\n\t\t\tf=f<-1.0?-1.0:f>1.0?1.0:f;\n\t\t\tpcmBuffer[i]=int16_t(f*32767);\n\t\t}\n\t\treturn count;\n\t}\n\n#ifdef USE_ALSA_AUDIO\n\tint mixPCM(snd_pcm_t *pcm){\n\t\tmixDown();\n\t\tint wrote=snd_pcm_writei(pcm,pcmBuffer,frames);\n//\t\tstd::cout << \"snd_pcm_writei\" << wrote << std::endl;\n// todo: write remainder on next call\n\t\treturn wrote;\n\t}\n#else\n\tint mixPCM(snd_pcm_t *pcm){\n\t\treturn -1;\n\t}\n#endif\t\n};\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/sysinfo.h\",\"length\":3558,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n#include \"nitrohost.h\"\n#include <ifaddrs.h>\n#include <netdb.h>\n#include <fstream>\n\n#include <stdlib.h>\n\n#ifdef __APPLE__\n#include <sys/sysctl.h>\n#endif\n\nconst int MAX_SYS_CTL_NAME = 1024;\n\nint jsonifySysLogs(utf8 &result){\n\tstd::stringstream ss;\n\tss << \"{\";\n\tresult=ss.str();\n\treturn 0;\n}\n\n// macos has no _SC_AVPHYS_PAGES\n\nint jsonifySysMemory(utf8 &result){\n\tlong pageSize = sysconf(_SC_PAGE_SIZE);\n\tlong physicalPages = sysconf(_SC_PHYS_PAGES);\n\tsize_t memavail=get_available();\n\tlong availPages=memavail/pageSize;\n\tstd::stringstream ss;\n\tss << \"{\";\n\tss << \"\\\"PageSize\\\":\\\"\" << pageSize << \"\\\",\";\n\tss << \"\\\"Physical\\\":\\\"\" << physicalPages << \"\\\",\";\n\tss << \"\\\"Available\\\":\\\"\" << availPages << \"\\\"}\";\n\tresult=ss.str();\n\treturn 0;\n}\n\nint jsonifyInterfaces(utf8 &result){\n\tstd::map<utf8,Strings> interfaces;\n\tifaddrs *ifaddr;\n\tif (getifaddrs(&ifaddr) == -1) {\n\t\treturn 1;\n\t}\n\tfor (ifaddrs *ifa = ifaddr; ifa != NULL; ifa = ifa->ifa_next) {\n\t\tif(ifa->ifa_addr){\n\t\t\tint family = ifa->ifa_addr->sa_family;\n\t\t\tutf8 name(ifa->ifa_name);\n\t\t\tchar host[NI_MAXHOST];\n\t\t\tif (family == AF_INET)\n\t\t\t{\n\t\t\t\tgetnameinfo(ifa->ifa_addr, sizeof(struct sockaddr_in),host,NI_MAXHOST,NULL,0,NI_NUMERICHOST);\n\t\t\t}\n\t\t\telse if(family == AF_INET6)\n\t\t\t{\n\t\t\t\tgetnameinfo(ifa->ifa_addr, sizeof(struct sockaddr_in6),host,NI_MAXHOST,NULL,0,NI_NUMERICHOST);\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tif(interfaces.count(name)==0) interfaces[name]={};\n\t\t\tinterfaces[name].push_back(quoted(utf8(host)));\n\t\t} \n\t}\n\tfreeifaddrs(ifaddr);\n\tStrings flat;\n\tfor(const auto &pair:interfaces){\n\t\tutf8 nic=\"\\\"\"+pair.first+\"\\\":[\"+joinStrings(pair.second,\",\")+\"]\";\n\t\tflat.push_back(nic);\n\t}\n\tresult=\"{\"+joinStrings(flat,\",\")+\"}\";\n\treturn 0;\n}\n\n#include <sys/utsname.h>\n\nstruct SysInfo{\n\tstruct utsname uts;\n\tutf8 hostname;\n\tutf8 serialnumber;\n\tlong corecount;\n\n\tstatic utf8 readSerialNumber(){\n\t\tutf8 sn=\"0000-0000-00000\";\n\t\tstd::ifstream stream;\n\t\tstream.open(\"/sys/firmware/devicetree/base/serial-number\");\n\t\tif(stream.good()){\n\t\t\tstd::getline(stream,sn);\n\t\t}else{\n\t\t\tstream.open(\"/sys/class/net/eth0/address\");\n\t\t\tif(stream.good()){\n\t\t\t\tstd::getline(stream,sn);\n\t\t\t}\n\t\t}\n\t\treturn sn;\n\t}\n\n\n\tSysInfo(){\n\t\tchar chars[512];\n\t\tint error=gethostname(chars,512);\n\t\tif(error==0){\n\t\t\thostname=utf8(chars);\n\t\t}\n\t\terror=uname(&uts);\n\t\tserialnumber=readSerialNumber();\n\t\tcorecount=sysconf(_SC_NPROCESSORS_ONLN);\n\n\t}\n\n\n#ifdef __APPLE__\n\n\tutf8 sysctlstring(const char *key){\n\t\tchar buffer[MAX_SYS_CTL_NAME];\n\t\tsize_t bufferlen = MAX_SYS_CTL_NAME;\n\t\tsysctlbyname(key,&buffer,&bufferlen,NULL,0);\n\t\treturn utf8(buffer);\n\t}\n\n\tutf8 domain(){\n\t\treturn utf8(\"todo\");\n\t}\n\n\tutf8 machine(){\t//Apple M1 Pro\n\t\treturn sysctlstring(\"machdep.cpu.brand_string\");\n\t}\n#else\n\tutf8 domain(){\n\t\treturn utf8(uts.domainname);\n\t}\n\n\tutf8 machine(){\t//x86_64\n\t\treturn utf8(uts.machine);\n\t}\n#endif\n\n\tint jsonifyInfo(utf8 session,utf8 token,utf8 &result){\n\t\tchar *user=getenv(\"USER\");\n\t\tstd::stringstream ss;\n\t\tss<<\"{\";\n\t\tss<<\"\\\"Name\\\":\\\"\"<<uts.nodename<<\"\\\",\";\n//\t\tss<<\"\\\"Domain\\\":\\\"\"<<uts.domainname<<\"\\\",\";\n\t\tss<<\"\\\"Machine\\\":\\\"\"<<uts.machine<<\"[\"<<corecount<<\"]\\\",\";\n\t\tss<<\"\\\"System\\\":\\\"\"<<uts.sysname<<\"\\\",\";\n\t//\tss<<\"\\\"version\\\":\\\"\"<<uts.version<<\"\\\",\";\n\t\tss<<\"\\\"Release\\\":\\\"\"<<uts.release<<\"\\\",\";\n\t\tss<<\"\\\"User\\\":\\\"\"<<user<<\"\\\",\";\n\t\tss<<\"\\\"Session\\\":\\\"\"<<session<<\"\\\",\";\n\t\tss<<\"\\\"Token\\\":\\\"\"<<token<<\"\\\"\";\n\t\tss<<\"}\";\n\t\tresult=ss.str();\n\t\treturn 0;\n\t}\n\n};\n\nint jsonifySysInfo(utf8 sessionName,utf8 sessionToken,utf8 &result){\n\tSysInfo sysinfo;\n\tint error=sysinfo.jsonifyInfo(sessionName,sessionToken,result);\n\treturn error;\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/udev.h\",\"length\":6973,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n#include \"nitrohost.h\"\n\n#include <set>\n#include <libudev.h>\n#include <linux/serial.h>\n#include <linux/fb.h>\n#include <linux/input.h>\n#include <linux/joystick.h>\n\n#define KB_STUFF\n\nstruct channel{\n\tint inputs;\n\tint outputs;\n\tstd::string name;\n\tint bits[32];\n\tchannel(){\n\t}\n\tchannel(const char *n,int ins,int outs){\t\t\n\t\tname=std::string(n);\n\t\tinputs=ins;\n\t\toutputs=outs;\n\t\treset();\n\t}\n\tvoid reset(){\n\t\tstd::fill(bits,bits+32,0);\n\t}\n\tstd::string jsonify(){\n\t\tstd::stringstream ss;\n\t\tss<<\"{\\\"name\\\":\\\"\"<<name<<\"\\\",\\\"ins\\\":\"<<inputs<<\",\\\"outs\\\":\"<<outputs<<\"}\";\n\t\treturn ss.str();\n\t}\n};\n\ntypedef std::map<std::string,channel> namedChannels;\n\nstd::string emptyString;\n\nstd::string stdString(const char *text){\n\treturn text?std::string(text):emptyString;\n}\n\nstruct deviceInfo{\n\tint inputs,outputs;\n\tstd::string sysPath;\n\tstd::string devPath;\n\tstd::string sysName,devNode,driver;\n\tAttributes values;\n\tAttributes attributes;\n\tnamedChannels channels;\n\n\tvoid dump(){\n\t\tstd::cout << jsonify() << std::endl;\n\t}\n\n\tstd::string jsonify(){\n\t\tStrings v,a,c;\n\t\tfor(const auto &pair:values){\n\t\t\tv.push_back(nameValue(pair.first,pair.second));\n\t\t}\n\t\tfor(const auto &pair:attributes){\n\t\t\ta.push_back(nameValue(pair.first,pair.second));\n\t\t}\n\t\tfor(auto pair:channels){\n\t\t\tc.push_back(quoted(pair.first)+\":\"+pair.second.jsonify());\n\t\t}\n\t\tstd::stringstream ss;\n\t\tss<<\"{\\\"values\\\":{\";\n\t\tss<<joinStrings(v,\",\");\n\t\tss<<\"},\\\"attributes\\\":{\";\n\t\tss<<joinStrings(a,\",\");\n\t\tss<<\"},\\\"channels\\\":{\";\n\t\tss<<joinStrings(c,\",\");\n\t\tss<<\"}}\";\n\t\treturn ss.str();\n\t}\n\n\tdeviceInfo(const char *fpath):sysPath(fpath){\n\t}\n\n\tbool valueEquals(std::string name, std::string value){\n\t\tauto item=values.find(name);\n\t\treturn item!=values.end() && item->second==value;\n\t}\n\n\tvoid addChannel(const char *name,int inputs,int outputs){\n\t\tchannels.emplace(name,channel(name,inputs,outputs));\n\t}\n\n\tint scan(struct udev_device *in){\n\t\tconst char *indent=\"\\t\";\n\t\tstruct udev_list_entry *entry;\n\t\tentry=udev_device_get_properties_list_entry(in);\n\t\twhile(entry){\n\t\t\tconst char *name=udev_list_entry_get_name(entry);\n\t\t\tconst char *value=udev_list_entry_get_value(entry);\n\t\t\tvalues[name]=stdString(value);\n//\t\t\tstd::cout << indent << name << '=' << value << std::endl;\n\t\t\tentry=udev_list_entry_get_next(entry);\n\t\t}\n\t\tentry=udev_device_get_sysattr_list_entry(in);\n//\t\tentry=udev_device_get_devlinks_list_entry(in);\n\t\twhile(entry){\n\t\t\tconst char *name=udev_list_entry_get_name(entry);\n\t\t\tconst char *value=udev_list_entry_get_value(entry);\n\t\t\tattributes[name]=stdString(value);\n\t\t\tentry=udev_list_entry_get_next(entry);\n\t\t}\n\t\tdevPath=values[\"DEVNAME\"];\n\t\tsysName=stdString(udev_device_get_sysname(in));\n\t\tdevNode=stdString(udev_device_get_devnode(in));\n\t\tdriver=stdString(udev_device_get_driver(in));\n\t\treturn 0;\n\t}\n};\n\nstatic void udevList(struct udev_list_entry *entry ){\n\twhile(entry){\n\t\tconst char *indent=\"\\t\";\n\t\tconst char *name=udev_list_entry_get_name(entry);\n\t\tconst char *value=udev_list_entry_get_value(entry);\n\t\tstd::cout << indent << name << '=' << value << std::endl;\n\t\tentry=udev_list_entry_get_next(entry);\n\t}\n}\n\n\ntypedef std::set<deviceInfo*> deviceList;\n\nstruct Devices{\n\tdeviceList usbList;\n\tdeviceList inputList;\n\tdeviceList outputList;\n\n\tDevices(){\n\t}\n\n\tint jsonifyDevices(Strings attributeMask,std::string& result){\n\t\tint error=enumInputs(\"input\");\n\t\tErrorResult(error,\"jsonifyDevices enumerating Input s\")\n\t\tStrings inputs;\n\t\tfor(auto in:inputList){\n\t\t\tinputs.push_back(in->jsonify());\n\t\t}\n\t\tstd::stringstream ss;\n\t\tss<<\"[\"<<joinStrings(inputs,\",\")<<\"]\";\n\t\tresult=ss.str();\n\t\tstd::cout << \"jsonifyDevices: \" << result << std::endl;\n\t\treturn 0;\n\t}\n\n\tstatic deviceList udevCat(struct udev *udev,const char *subsystem,const char *devtype=0){\n\t\tdeviceList cat;\n\t\tstruct udev_enumerate *enumerate = udev_enumerate_new(udev);\n\t\tif(subsystem){\n\t\t\tudev_enumerate_add_match_subsystem(enumerate, subsystem);\n\t\t}\n\t\tif(devtype){\n\t\t\tudev_enumerate_add_match_property(enumerate, \"DEVTYPE\", devtype);\n\t\t}\n\t\tudev_enumerate_scan_devices(enumerate);\n\t\tstruct udev_list_entry *devices = udev_enumerate_get_list_entry(enumerate);\n\t\tstruct udev_list_entry *entry;\n\t\tudev_list_entry_foreach(entry, devices){\n\t\t\tconst char *path = udev_list_entry_get_name(entry);\n\t\t\tstruct udev_device *in = udev_device_new_from_syspath(udev, path);\n\t\t\tif(in){\n//\t\t\t\tstd::cout << path << std::endl;\n\t\t\t\tdeviceInfo *info=new deviceInfo(path);\n\t\t\t\tinfo->scan(in);\n\t\t\t\tudev_device_unref(in);\n\t\t\t\tcat.insert(info);\n\t\t\t}\n\t\t}\n\t\tudev_enumerate_unref(enumerate);\n\t\treturn cat;\n\t}\n\n//\tStrings inputTypes={\"input\"};\n\tint enumUSB(){\n\t\tudev *udev = udev_new();\n\t\tusbList=udevCat(udev,\"usb\",\"usb_device\");\n\t\tfor(auto in:usbList){\n\t\t\tif (in->values.count(\"ID_USB_INTERFACES\")){\n\t\t\t\tstd::string interfaces=in->values[\"ID_USB_INTERFACES\"];\n\t\t\t\tstd::cout << interfaces << std::endl;\n\t\t\t}\n\t\t\tif (in->values.count(\"ID_MODEL\")){\n\t\t\t\tstd::string model=in->values[\"ID_MODEL\"];\n\t\t\t\tstd::cout << model << std::endl;\n\t\t\t}\n/*\t\t\t\n\t\t\tint fd=open(in->devPath.c_str(),O_RDONLY);\n\t\t\tif(fd<0){\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tstd::cout << \"open is \" << in->devPath << std::endl;\n\t\t\tclose(fd);\n*/\t\t\n\t\t}\n\t\tudev_unref(udev);\n\t\treturn 0;\n\t}\n\n//\t\"ID_INPUT_KEYBOARD\", ID_INPUT_KEY, ID_INPUT_MOUSE, ID_INPUT_TOUCHPAD, ID_INPUT_TOUCHSCREEN, ID_INPUT_TABLET, ID_INPUT_JOYSTICK, ID_INPUT_ACCELEROMETER\n\n\tint enumInputs(const char *subsystem){\n\t\tdeviceInfo *kb=NULL;\n\t\tdeviceInfo *mouse=NULL;\n\t\tstd::stringstream ss;\n\t\tudev *udev = udev_new();\n\t\tinputList=udevCat(udev,subsystem);\n\t\tfor(auto in:inputList){\n\t\t\tint fd=open(in->devPath.c_str(),O_RDONLY);\n\t\t\tif(fd<0){\n\t\t\t\tcontinue;\n\t\t\t}\n//\t\t\tstd::cout << \"open is \" << in->devPath << std::endl;\n\t\t\tunsigned char axes=0;\n\t\t\tunsigned char buttons=0;\n\t\t\tint ares=ioctl (fd, JSIOCGAXES, &axes);\n\t\t\tint bres=ioctl (fd, JSIOCGBUTTONS, &buttons);\n\t\t\tif(ares==0 || bres==0){\n\t\t\t\tif (axes) in->addChannel(\"axes\",(int)axes,0);\n\t\t\t\tif (buttons) in->addChannel(\"buttons\",(int)buttons,0);\n\t\t\t}\n#ifdef KB_STUFF\n\t\t\tinput_id gid;\n\t\t\tint gres=ioctl(fd,EVIOCGID,&gid);\n\t\t\tif(gres==0){\n\t\t\t\tif(in->valueEquals(\"ID_INPUT\",\"1\")){\n//\t\t\t\t\tif(in->valueEquals(\"ID_INPUT_KEY\",\"1\")){\n\t\t\t\t\tif(in->valueEquals(\"ID_INPUT_KEYBOARD\",\"1\")){\n\t\t\t\t\t\tkb=kb?kb:in;\n\t\t\t\t\t\tstd::cout << \"KB\" << std::endl;\n//\t\t\t\t\t\t\tin->attributes()\n//\t\t\t\t\t\t\tss << \"INPUT KB:\" << gid.bustype << \",\" << gid.product << \" v\" << gid.version << std::endl;\n//\t\t\t\t\t\t\tin->dump(ss);\n\t\t\t\t\t}\n\t\t\t\t\tif(in->valueEquals(\"ID_INPUT_MOUSE\",\"1\")){\n\t\t\t\t\t\tmouse=mouse?mouse:in;\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\tstd::cout << \"MOUSE\" << std::endl;\n\t\t\t\t\t}\n\t\t\t\t\tif(in->valueEquals(\"ID_MODEL\",\"Raspberry_Pi_Internal_Keyboard\")){\n\t\t\t\t\t\tcontinue; //bork bork\n\t\t\t\t\t}\n\t\t\t\t\tin->dump();\t\t\t\t\t\n\t\t\t\t}else{\n\t\t\t\t\tstd::cout << \"INPUT CGID:\" << gid.bustype << \",\" << gid.product << \" v\" << gid.version << std::endl;\n\t\t\t\t}\n\t\t\t}\n#endif\n\t\t\tchar buffer[256];\n\t\t\tint res=ioctl(fd,EVIOCGNAME(256),buffer);\n\t\t\tif(res==0){\n\t\t\t\tin->values[\"CGNAME\"]=buffer;\n//\t\t\t\tss << \"\\tCGNAME=\" << buffer << std::endl;\n\t\t\t}\n\n\t\t\tclose(fd);\n\t\t}\n\t\tudev_unref(udev);\n\n\t\treturn 0;\n\t}\n};\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/video.h\",\"length\":15784,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n/*\n *  V4L2 video capture example\n *\n *  This program can be used and distributed without restrictions.\n *\n *\t  This program is provided with the V4L2 API\n * see http://linuxtv.org/docs.php for more information\n */\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <assert.h>\n\n#include <getopt.h>\t\t /* getopt_long() */\n\n#include <fcntl.h>\t\t  /* low-level i/o */\n#include <unistd.h>\n#include <errno.h>\n#include <sys/stat.h>\n#include <sys/types.h>\n#include <sys/time.h>\n#include <sys/mman.h>\n#include <sys/ioctl.h>\n\n#include <linux/videodev2.h>\n\nvoid *frame_data;\nint frame_size=0;\nint frame_type=0;\nint frame_number=0;\n\n#define CLEAR(x) memset(&(x), 0, sizeof(x))\n\n#ifndef V4L2_PIX_FMT_H264\n#define V4L2_PIX_FMT_H264\t v4l2_fourcc('H', '2', '6', '4') /* H264 with start codes */\n#endif\n\n#ifndef V4L2_PIX_FMT_YU12\n#define V4L2_PIX_FMT_YU12\t v4l2_fourcc('Y', 'U', '1', '2') /* YUV2 with start codes */\n#endif\n\n#ifndef V4L2_PIX_FMT_GREY\n#define V4L2_PIX_FMT_GREY\t v4l2_fourcc('Y', '8', '0', '0') /* G8 with start codes */\n#endif\n\n#ifndef V4L2_PIX_FMT_RGB4\n#define V4L2_PIX_FMT_RGB4\t v4l2_fourcc('B', 'G', 'R', '4') /* RGB4 with start codes */\n#endif\n\n#ifndef V4L2_PIX_FMT_RGB3\n#define V4L2_PIX_FMT_RGB3\t v4l2_fourcc('R', 'G', 'B', '3') /* RGB4 with start codes */\n#endif\n\nenum io_method {\n\tIO_METHOD_READ,\n\tIO_METHOD_MMAP,\n\tIO_METHOD_USERPTR,\n};\n\nstruct buffer {\n\tvoid   *start;\n\tsize_t  length;\n};\n\nstatic const char *dev_name;\nstatic enum io_method io = IO_METHOD_MMAP;\nstatic int fd = -1;\nstruct buffer *buffers;\nstatic unsigned int n_buffers=1;\nstatic int out_buf;\nstatic int force_format=1;\n\nvoid errno_exit(const char *s)\n{\n\tfprintf(stderr, \"%s error %d, %s\\n\", s, errno, strerror(errno));\n\texit(EXIT_FAILURE);\n}\n\nint xioctl(int fh, int request, void *arg)\n{\n\tint r;\n\tdo {\n\t\tr = ioctl(fh, request, arg);\n\t} while (-1 == r && EINTR == errno);\n\treturn r;\n}\n\n// todo: callback to monkey2 device\n\nvoid process(v4l2_buffer &buf)\n{\n\tassert(buf.index < n_buffers);\n\tframe_data=(void*)buffers[buf.index].start;\n\tframe_size=buf.bytesused;\n\tframe_type=buf.type;\n}\n\nstatic bool cleanMe=false;\n\nstruct v4l2_buffer buf;\n\nint read_frame(void)\n{\n\tunsigned int i;\n\n\tswitch (io) {\n\tcase IO_METHOD_READ:\n\t\tif (-1 == read(fd, buffers[0].start, buffers[0].length)) {\n\t\t\tswitch (errno) {\n\t\t\tcase EAGAIN:\n\t\t\t\treturn 0;\n\n\t\t\tcase EIO:\n\t\t\t\t/* Could ignore EIO, see spec. */\n\n\t\t\t\t/* fall through */\n\n\t\t\tdefault:\n\t\t\t\terrno_exit(\"read\");\n\t\t\t}\n\t\t}\n// not tested\n//\t\tprocess(buffers[0]);\n\t\tbreak;\n\n\tcase IO_METHOD_MMAP:\n\t\tCLEAR(buf);\n\n\t\tbuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tbuf.memory = V4L2_MEMORY_MMAP;\n\n\t\tif (-1 == xioctl(fd, VIDIOC_DQBUF, &buf)) {\n\t\t\tswitch (errno) {\n\t\t\tcase EAGAIN:\n\t\t\t\treturn 0;\n\t\t\tcase EIO:\n\t\t\t\treturn 0;\n\t\t\tdefault:\n\t\t\t\terrno_exit(\"VIDIOC_DQBUF\");\n\t\t\t}\n\t\t}\n\n// tested with pi\n\t\tprocess(buf);\n\n\t\tif (-1 == xioctl(fd, VIDIOC_QBUF, &buf)){\n\t\t\terrno_exit(\"VIDIOC_QBUF\");\n\t\t}\n\t\tbreak;\n/*\n\tcase IO_METHOD_USERPTR:\n\t\tCLEAR(buf);\n\n\t\tbuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tbuf.memory = V4L2_MEMORY_USERPTR;\n\n\t\tif (-1 == xioctl(fd, VIDIOC_DQBUF, &buf)) {\n\t\t\tswitch (errno) {\n\t\t\tcase EAGAIN:\n\t\t\t\treturn 0;\n\n\t\t\tcase EIO:\n//\t\t\t\tCould ignore EIO, see spec. fall through \n\t\t\t\treturn 0;\n\n\t\t\tdefault:\n\t\t\t\terrno_exit(\"VIDIOC_DQBUF\");\n\t\t\t}\n\t\t}\n\n\t\tfor (i = 0; i < n_buffers; ++i)\n\t\t\tif (buf.m.userptr == (unsigned long)buffers[i].start\n\t\t\t\t&& buf.length == buffers[i].length)\n\t\t\t\tbreak;\n\n\t\tassert(i < n_buffers);\n//\t\tprocess_image((void *)buf.m.userptr, buf.bytesused);\n\n\t\tif (-1 == xioctl(fd, VIDIOC_QBUF, &buf))\n\t\t\terrno_exit(\"VIDIOC_QBUF\");\n\t\tbreak;\n*/\n\t}\n\n\treturn 1;\n}\n\nvoid finishFrame(void){\n\tchar *c=(char*)frame_data;\n\tfor(int i=0;i<20;i++){\n\t\tprintf(\"%02X \",c[i]);\n\t}\n\tprintf(\"\\n\");\n\n\treturn;\n}\n\nint readFrame(void)\n{\n\tfor (;;) {\n\t\tfd_set fds;\n\t\tstruct timeval tv;\n\t\tint r;\n\t\tFD_ZERO(&fds);\n\t\tFD_SET(fd, &fds);\n// Timeout\n\t\ttv.tv_sec = 2;\n\t\ttv.tv_usec = 0;\n\t\tr = select(fd + 1, &fds, NULL, NULL, &tv);\n\n\t\tif (-1 == r) {\n\t\t\tif (EINTR == errno) continue;\n\t\t\treturn -1;\n\t\t}\n\n\t\tif (0 == r) {\n\t\t\tfprintf(stderr, \"select timeout\\n\");\n\t\t\treturn -2;\n\t\t}\n\n\t\tif (read_frame()) return 0;\n// EAGAIN - continue select loop.\n\t}\n}\n\nvoid stop_capturing(void)\n{\n\tenum v4l2_buf_type type;\n\n\tswitch (io) {\n\tcase IO_METHOD_READ:\n\t\t/* Nothing to do. */\n\t\tbreak;\n\n\tcase IO_METHOD_MMAP:\n\tcase IO_METHOD_USERPTR:\n\t\ttype = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tif (-1 == xioctl(fd, VIDIOC_STREAMOFF, &type))\n\t\t\terrno_exit(\"VIDIOC_STREAMOFF\");\n\t\tbreak;\n\t}\n}\n\nvoid start_capturing(void)\n{\n\tunsigned int i;\n\tenum v4l2_buf_type type;\n\n\tswitch (io) {\n\tcase IO_METHOD_READ:\n\t\t/* Nothing to do. */\n\t\tbreak;\n\n\tcase IO_METHOD_MMAP:\n\t\tfor (i = 0; i < n_buffers; ++i) {\n\t\t\tstruct v4l2_buffer buf;\n\n\t\t\tCLEAR(buf);\n\t\t\tbuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\t\tbuf.memory = V4L2_MEMORY_MMAP;\n\t\t\tbuf.index = i;\n\n\t\t\tif (-1 == xioctl(fd, VIDIOC_QBUF, &buf))\n\t\t\t\terrno_exit(\"VIDIOC_QBUF\");\n\t\t}\n\t\ttype = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tif (-1 == xioctl(fd, VIDIOC_STREAMON, &type))\n\t\t\terrno_exit(\"VIDIOC_STREAMON\");\n\t\tbreak;\n\n\tcase IO_METHOD_USERPTR:\n\t\tfor (i = 0; i < n_buffers; ++i) {\n\t\t\tstruct v4l2_buffer buf;\n\n\t\t\tCLEAR(buf);\n\t\t\tbuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\t\tbuf.memory = V4L2_MEMORY_USERPTR;\n\t\t\tbuf.index = i;\n\t\t\tbuf.m.userptr = (unsigned long)buffers[i].start;\n\t\t\tbuf.length = buffers[i].length;\n\n\t\t\tif (-1 == xioctl(fd, VIDIOC_QBUF, &buf))\n\t\t\t\terrno_exit(\"VIDIOC_QBUF\");\n\t\t}\n\t\ttype = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tif (-1 == xioctl(fd, VIDIOC_STREAMON, &type))\n\t\t\terrno_exit(\"VIDIOC_STREAMON\");\n\t\tbreak;\n\t}\n}\n\nvoid uninit_device(void)\n{\n\tunsigned int i;\n\n\tswitch (io) {\n\tcase IO_METHOD_READ:\n\t\tfree(buffers[0].start);\n\t\tbreak;\n\n\tcase IO_METHOD_MMAP:\n\t\tfor (i = 0; i < n_buffers; ++i)\n\t\t\tif (-1 == munmap(buffers[i].start, buffers[i].length))\n\t\t\t\terrno_exit(\"munmap\");\n\t\tbreak;\n\n\tcase IO_METHOD_USERPTR:\n\t\tfor (i = 0; i < n_buffers; ++i)\n\t\t\tfree(buffers[i].start);\n\t\tbreak;\n\t}\n\n\tfree(buffers);\n}\n\nvoid init_read(unsigned int buffer_size)\n{\n\tbuffers = (buffer*)calloc(1, sizeof(*buffers));\n\n\tif (!buffers) {\n\t\tfprintf(stderr, \"Out of memory\\n\");\n\t\texit(EXIT_FAILURE);\n\t}\n\n\tbuffers[0].length = buffer_size;\n\tbuffers[0].start = malloc(buffer_size);\n\n\tif (!buffers[0].start) {\n\t\tfprintf(stderr, \"Out of memory\\n\");\n\t\texit(EXIT_FAILURE);\n\t}\n}\n\nvoid init_mmap(void)\n{\n\tstruct v4l2_requestbuffers req;\n\n\tCLEAR(req);\n\n\treq.count = 4;\n\treq.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\treq.memory = V4L2_MEMORY_MMAP;\n\n\tif (-1 == xioctl(fd, VIDIOC_REQBUFS, &req)) {\n\t\tif (EINVAL == errno) {\n\t\t\tfprintf(stderr, \"%s does not support \"\n\t\t\t\t \"memory mapping\\n\", dev_name);\n\t\t\texit(EXIT_FAILURE);\n\t\t} else {\n\t\t\terrno_exit(\"VIDIOC_REQBUFS\");\n\t\t}\n\t}\n\n\tif (req.count < 2) {\n\t\tfprintf(stderr, \"Insufficient buffer memory on %s\\n\",\n\t\t\t dev_name);\n\t\texit(EXIT_FAILURE);\n\t}\n\n\tbuffers = (buffer*)calloc(req.count, sizeof(*buffers));\n\n\tif (!buffers) {\n\t\tfprintf(stderr, \"Out of memory\\n\");\n\t\texit(EXIT_FAILURE);\n\t}\n\n\tfor (n_buffers = 0; n_buffers < req.count; ++n_buffers) {\n\t\tstruct v4l2_buffer buf;\n\n\t\tCLEAR(buf);\n\n\t\tbuf.type\t= V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tbuf.memory\t  = V4L2_MEMORY_MMAP;\n\t\tbuf.index\t   = n_buffers;\n\n\t\tif (-1 == xioctl(fd, VIDIOC_QUERYBUF, &buf))\n\t\t\terrno_exit(\"VIDIOC_QUERYBUF\");\n\n\t\tbuffers[n_buffers].length = buf.length;\n\t\tbuffers[n_buffers].start =\n\t\t\tmmap(NULL /* start anywhere */,\n\t\t\t\t  buf.length,\n\t\t\t\t  PROT_READ | PROT_WRITE /* required */,\n\t\t\t\t  MAP_SHARED /* recommended */,\n\t\t\t\t  fd, buf.m.offset);\n\n\t\tif (MAP_FAILED == buffers[n_buffers].start)\n\t\t\terrno_exit(\"mmap\");\n\t}\n}\n\nvoid init_userp(unsigned int buffer_size)\n{\n\tstruct v4l2_requestbuffers req;\n\n\tCLEAR(req);\n\n\treq.count  = 4;\n\treq.type   = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\treq.memory = V4L2_MEMORY_USERPTR;\n\n\tif (-1 == xioctl(fd, VIDIOC_REQBUFS, &req)) {\n\t\tif (EINVAL == errno) {\n\t\t\tfprintf(stderr, \"%s does not support \"\n\t\t\t\t \"user pointer i/o\\n\", dev_name);\n\t\t\texit(EXIT_FAILURE);\n\t\t} else {\n\t\t\terrno_exit(\"VIDIOC_REQBUFS\");\n\t\t}\n\t}\n\n\tbuffers = (buffer*)calloc(4, sizeof(*buffers));\n\n\tif (!buffers) {\n\t\tfprintf(stderr, \"Out of memory\\n\");\n\t\texit(EXIT_FAILURE);\n\t}\n\n\tfor (n_buffers = 0; n_buffers < 4; ++n_buffers) {\n\t\tbuffers[n_buffers].length = buffer_size;\n\t\tbuffers[n_buffers].start = malloc(buffer_size);\n\n\t\tif (!buffers[n_buffers].start) {\n\t\t\tfprintf(stderr, \"Out of memory\\n\");\n\t\t\texit(EXIT_FAILURE);\n\t\t}\n\t}\n}\n\nvoid init_device(void)\n{\n\tstruct v4l2_capability cap;\n\tstruct v4l2_format fmt;\n\tunsigned int min;\n\n\tif (-1 == xioctl(fd, VIDIOC_QUERYCAP, &cap)) {\n\t\tif (EINVAL == errno) {\n\t\t\tfprintf(stderr, \"%s is no V4L2 device\\n\",\n\t\t\t\t dev_name);\n\t\t\texit(EXIT_FAILURE);\n\t\t} else {\n\t\t\terrno_exit(\"VIDIOC_QUERYCAP\");\n\t\t}\n\t}\n\n\tprintf(\"%s %s %s %x\\n\",cap.driver,cap.card,cap.bus_info,cap.capabilities);\n\n\tif (!(cap.capabilities & V4L2_CAP_VIDEO_CAPTURE)) {\n\t\tfprintf(stderr, \"%s is no video capture device\\n\",\n\t\t\t dev_name);\n\t\texit(EXIT_FAILURE);\n\t}\n\n\tswitch (io) {\n\tcase IO_METHOD_READ:\n\t\tif (!(cap.capabilities & V4L2_CAP_READWRITE)) {\n\t\t\tfprintf(stderr, \"%s does not support read i/o\\n\",\n\t\t\t\t dev_name);\n\t\t\texit(EXIT_FAILURE);\n\t\t}\n\t\tbreak;\n\n\tcase IO_METHOD_MMAP:\n\tcase IO_METHOD_USERPTR:\n\t\tif (!(cap.capabilities & V4L2_CAP_STREAMING)) {\n\t\t\tfprintf(stderr, \"%s does not support streaming i/o\\n\",\n\t\t\t\t dev_name);\n\t\t\texit(EXIT_FAILURE);\n\t\t}\n\t\tbreak;\n\t}\n\n\n\t/* Select video input, video standard and tune here. */\n\n\tCLEAR(fmt);\n\n\tfmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\tif (force_format) {\n\t\tfmt.fmt.pix.width=640;\n\t\tfmt.fmt.pix.height=480;\n\t\tfmt.fmt.pix.pixelformat=V4L2_PIX_FMT_RGB3;\n\t\tfmt.fmt.pix.field=V4L2_FIELD_ANY;\n/*\t\t\n\tfprintf(stderr, \"Set H264\\r\\n\");\n\t\tfmt.fmt.pix.width\t   = 640; //replace\n\t\tfmt.fmt.pix.height\t  = 480; //replace\n\t\tfmt.fmt.pix.pixelformat = V4L2_PIX_FMT_H264; //replace\n\t\tfmt.fmt.pix.field\t   = V4L2_FIELD_ANY;\n*/\n\n\t\tif (-1 == xioctl(fd, VIDIOC_S_FMT, &fmt))\n\t\t\terrno_exit(\"VIDIOC_S_FMT\");\n\n\t\t/* Note VIDIOC_S_FMT may change width and height. */\n\n\t} else {\n\t\t/* Preserve original settings as set by v4l2-ctl for example */\n\t\tif (-1 == xioctl(fd, VIDIOC_G_FMT, &fmt))\n\t\t\terrno_exit(\"VIDIOC_G_FMT\");\n\t}\n\n\t/* Buggy driver paranoia. */\n\tmin = fmt.fmt.pix.width * 2;\n\tif (fmt.fmt.pix.bytesperline < min)\n\t\tfmt.fmt.pix.bytesperline = min;\n\tmin = fmt.fmt.pix.bytesperline * fmt.fmt.pix.height;\n\tif (fmt.fmt.pix.sizeimage < min)\n\t\tfmt.fmt.pix.sizeimage = min;\n\n\tswitch (io) {\n\tcase IO_METHOD_READ:\n\t\tinit_read(fmt.fmt.pix.sizeimage);\n\t\tbreak;\n\n\tcase IO_METHOD_MMAP:\n\t\tinit_mmap();\n\t\tbreak;\n\n\tcase IO_METHOD_USERPTR:\n\t\tinit_userp(fmt.fmt.pix.sizeimage);\n\t\tbreak;\n\t}\n\n\tstruct v4l2_crop crop;\n\tv4l2_cropcap cropcap={0};\n\tcropcap.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\n\tif (0 == xioctl(fd, VIDIOC_CROPCAP, &cropcap)) {\n\n\t\tcrop.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\t\tcrop.c = cropcap.defrect; /* reset to default */\n\n\t\tv4l2_rect &r=cropcap.defrect;\n\t\tprintf(\"crop %d,%d %d x %d\\n\",r.left,r.top,r.width,r.height);\n\n\t\tif (-1 == xioctl(fd, VIDIOC_S_CROP, &crop)) {\n\t\t\tswitch (errno) {\n\t\t\tcase EINVAL:\n\t\t\t\t/* Cropping not supported. */\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\t/* Errors ignored. */\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t} else {\n//\t\tprintf(\"VIDIOC_CROPCAP failed\\n\");\n\t}\n\n}\n\nint close_device(void)\n{\n\tif (-1 == close(fd)) return -1;\n\tfd = -1;\n\treturn 0;\n}\n\nint open_device(void)\n{\n\tdev_name = \"/dev/video0\";\n\n\tstruct stat st;\n\n\tif (-1 == stat(dev_name, &st)) {\n\t\tfprintf(stderr, \"Cannot identify '%s': %d, %s\\n\",\n\t\t\t dev_name, errno, strerror(errno));\n\t\treturn(-1);\n\t}\n\n\tif (!S_ISCHR(st.st_mode)) {\n\t\tfprintf(stderr, \"%s is no device\\n\", dev_name);\n\t\treturn(-2);\n\t}\n\n\tfd = open(dev_name, O_RDWR /* required */ | O_NONBLOCK, 0);\n\n\tif (-1 == fd) {\n\t\tfprintf(stderr, \"Cannot open '%s': %d, %s\\n\",\n\t\t\t dev_name, errno, strerror(errno));\n\t\treturn(-3);\n\t}\n\n\n\tv4l2_fmtdesc desc={0};\n\tv4l2_frmsizeenum fdesc={0};\n \tv4l2_frmivalenum freqs={0};\n\n\tdesc.type=V4L2_BUF_TYPE_VIDEO_CAPTURE;\n\tfor(int i=0;i<256;i++){\n\t\tdesc.index=i;\n\t\tif (-1 == xioctl(fd, VIDIOC_ENUM_FMT, &desc)) break;\n\t\tchar *fcc=(char *)&desc.pixelformat;\n\t\tprintf(\"format[%d] %s %c%c%c%c \",i,desc.description,fcc[0],fcc[1],fcc[2],fcc[3]);\n\t\tfdesc.pixel_format=desc.pixelformat;\n\t\tfor(int j=0;j<256;j++){\n\t\t\tfdesc.index=j;\n\t\t\tint w=0;\n\t\t\tint h=0;\n\t\t\tif (-1 == xioctl(fd, VIDIOC_ENUM_FRAMESIZES, &fdesc)) break;\n\t\t\tswitch(fdesc.type){\n\t\t\t\tcase V4L2_FRMSIZE_TYPE_DISCRETE:\n\t\t\t\t\tw=fdesc.discrete.width;\n\t\t\t\t\th=fdesc.discrete.height;\n\t\t\t\t\tprintf(\" [%d]%dx%d\",j,w,h);\n\t\t\t\t\tbreak;\n\t\t\t\tcase V4L2_FRMSIZE_TYPE_STEPWISE:\n\t\t\t\t\tw=fdesc.stepwise.min_width;\n\t\t\t\t\th=fdesc.stepwise.min_height;\n\t\t\t\t\tprintf(\" [%d]%dx%d..%dx%d\",j,w,h,fdesc.stepwise.max_width,fdesc.stepwise.max_height);\n\t\t\t\t\tbreak;\n\t\t\t}\n\t\t\tfor(int k=0;k<256;k++){\n\t\t\t\tfreqs.index=k;\n\t\t\t\tfreqs.pixel_format=desc.pixelformat;\n\t\t\t\tfreqs.width=w;\n\t\t\t\tfreqs.height=h;\n\t\t\t\tif (-1 == xioctl(fd, VIDIOC_ENUM_FRAMEINTERVALS, &freqs)) break;\n\t\t\t\tswitch(freqs.type){\n\t\t\t\t\tcase V4L2_FRMIVAL_TYPE_DISCRETE:\n\t\t\t\t\t\tprintf(\" %d:%d\",freqs.discrete.numerator,freqs.discrete.denominator);\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase V4L2_FRMIVAL_TYPE_CONTINUOUS:\n\t\t\t\t\tcase V4L2_FRMIVAL_TYPE_STEPWISE:\n\t\t\t\t\t\tv4l2_fract &min=freqs.stepwise.min;\n\t\t\t\t\t\tv4l2_fract &max=freqs.stepwise.max;\n\t\t\t\t\t\tprintf(\" %d.%d - %d.%d\",min.numerator,min.denominator,max.numerator,max.denominator);\n\t\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\tprintf(\"\\n\");\n\t\t\tif (fdesc.type!=V4L2_FRMSIZE_TYPE_DISCRETE) break;\n\t\t}\n\t}\n\n\tv4l2_audio audio={0};\n\tfor(int i=0;i<256;i++){\n\t\taudio.index=i;\n\t\tif (-1 == xioctl(fd, VIDIOC_ENUMAUDIO, &audio)) break;\n\t\tprintf(\"%d %s\\n\",i,audio.name);\n\t}\n\n\tv4l2_input in={0};\n\tfor(int i=0;i<256;i++){\n\t\tin.index=i;\n\t\tif (-1 == xioctl(fd, VIDIOC_ENUMINPUT, &in)) break;\n\t\tprintf(\"%d %s\\n\",i,in.name);\n\t}\n\n\n\tv4l2_output out={0};\n\tfor(int i=0;i<256;i++){\n\t\tout.index=i;\n\t\tif (-1 == xioctl(fd, VIDIOC_ENUMOUTPUT, &out)) break;\n\t\tprintf(\"%d %s\\n\",i,out.name);\n\t}\n\n\treturn 0;\n}\n\n#ifdef old\n\nvoid usage(FILE *fp, int argc, char **argv)\n{\n\tfprintf(fp,\n\t\t \"Usage: %s [options]\\n\\n\"\n\t\t \"Version 1.3\\n\"\n\t\t \"Options:\\n\"\n\t\t \"-d | --device name   Video device name [%s]\\n\"\n\t\t \"-h | --help\t  Print this message\\n\"\n\t\t \"-m | --mmap\t  Use memory mapped buffers [default]\\n\"\n\t\t \"-r | --read\t  Use read() calls\\n\"\n\t\t \"-u | --userp\t Use application allocated buffers\\n\"\n\t\t \"-o | --output\tOutputs stream to stdout\\n\"\n\t\t \"-f | --format\tForce format to 640x480 YUYV\\n\"\n\t\t \"-c | --count\t Number of frames to grab [%i]\\n\"\n\t\t \"\",\n\t\t argv[0], dev_name, frame_count);\n}\n\nstatic const char short_options[] = \"d:hmruofc:\";\n\nstatic const struct option\nlong_options[] = {\n\t{ \"device\", required_argument, NULL, 'd' },\n\t{ \"help\",   no_argument,\t   NULL, 'h' },\n\t{ \"mmap\",   no_argument,\t   NULL, 'm' },\n\t{ \"read\",   no_argument,\t   NULL, 'r' },\n\t{ \"userp\",  no_argument,\t   NULL, 'u' },\n\t{ \"output\", no_argument,\t   NULL, 'o' },\n\t{ \"format\", no_argument,\t   NULL, 'f' },\n\t{ \"count\",  required_argument, NULL, 'c' },\n\t{ 0, 0, 0, 0 }\n};\n\nint capture_main(int argc, char **argv)\n{\n\tdev_name = \"/dev/video0\";\n\n\tfor (;;) {\n\t\tint idx;\n\t\tint c;\n\n\t\tc = getopt_long(argc, argv,\n\t\t\t\tshort_options, long_options, &idx);\n\n\t\tif (-1 == c)\n\t\t\tbreak;\n\n\t\tswitch (c) {\n\t\tcase 0: /* getopt_long() flag */\n\t\t\tbreak;\n\n\t\tcase 'd':\n\t\t\tdev_name = optarg;\n\t\t\tbreak;\n\n\t\tcase 'h':\n\t\t\tusage(stdout, argc, argv);\n\t\t\texit(EXIT_SUCCESS);\n\n\t\tcase 'm':\n\t\t\tio = IO_METHOD_MMAP;\n\t\t\tbreak;\n\n\t\tcase 'r':\n\t\t\tio = IO_METHOD_READ;\n\t\t\tbreak;\n\n\t\tcase 'u':\n\t\t\tio = IO_METHOD_USERPTR;\n\t\t\tbreak;\n\n\t\tcase 'o':\n\t\t\tout_buf++;\n\t\t\tbreak;\n\n\t\tcase 'f':\n\t\t\tforce_format++;\n\t\t\tbreak;\n\n\t\tcase 'c':\n\t\t\terrno = 0;\n\t\t\tframe_count = strtol(optarg, NULL, 0);\n\t\t\tif (errno)\n\t\t\t\terrno_exit(optarg);\n\t\t\tbreak;\n\n\t\tdefault:\n\t\t\tusage(stderr, argc, argv);\n\t\t\texit(EXIT_FAILURE);\n\t\t}\n\t}\n\n\topen_device();\n\tinit_device();\n\tstart_capturing();\n\tmainloop();\n\tstop_capturing();\n\tuninit_device();\n\tclose_device();\n\tfprintf(stderr, \"\\n\");\n\treturn 0;\n}\n\n#endif // old\n\nint testVideo(){\n\tinit_device();\n\topen_device();\n\tstart_capturing();\n\tread_frame();\n\tstop_capturing();\n\tclose_device();\n\treturn 0;\n}","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/wav.h\",\"length\":10411,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n#include \"nitrohost.h\"\n\n//#include <iomanip>\n#include <cmath>\n\n//36\nstruct WavHeader{\n\tchar chunkID[4];\n\tuint32_t chunkSize;\n\tchar format[4];\n\tchar subchunkID[4];\n\tuint32_t subchunkSize;\n\tuint16_t audioFormat;\n\tuint16_t numChannels;\n\tuint32_t sampleRate;\n\tuint32_t byteRate;\n\tuint16_t blockAlign;\n\tuint16_t bitsPerSample;\n};\n\n//8\nstruct WavData{\n\tchar dataID[4];\n\tuint32_t size;\n};\n\nint writeMono24Wav(const char *path,int sampleRate,int samples,void *wav24){\n\tWavHeader header={'R','I','F','F',0,'W','A','V','E','f','m','t',' '};\n\tWavData data={'d','a','t','a'};\n\tint dataBytes=3*samples;\n\theader.chunkSize=36+dataBytes;\n\theader.subchunkSize=16;\n\theader.audioFormat=1;//PCM\n\theader.numChannels=1;\n\theader.sampleRate=sampleRate;\n\theader.byteRate=sampleRate*3;\n\theader.blockAlign=3;\n\theader.bitsPerSample=24;\n\tdata.size=dataBytes;\n\tint fd=open(path, O_CREAT | O_WRONLY | O_TRUNC, 0666);\n\tFDErrorCheck(fd,1,\"writeMono24Wav Failed to create file \" << path);\n\twrite(fd,&header,sizeof(header));\n\twrite(fd,&data,sizeof(data));\n\twrite(fd,wav24,dataBytes);\n\tint res=close(fd);\n\treturn (res==-1)?2:0;\n}\n\nint writeMono32Wav(const char *path,int sampleRate,int samples,float *wav32){\n\tWavHeader header={'R','I','F','F',0,'W','A','V','E','f','m','t',' '};\n\tWavData data={'d','a','t','a'};\n\tint dataBytes=4*samples;\n\theader.chunkSize=36+dataBytes;\n\theader.subchunkSize=16;\n\theader.audioFormat=3;//WAVE_FORMAT_IEEE_FLOAT\n\theader.numChannels=1;\n\theader.sampleRate=sampleRate;\n\theader.byteRate=sampleRate*4;\n\theader.blockAlign=4;\n\theader.bitsPerSample=32;\n\tdata.size=dataBytes;\n\tint fd=open(path, O_CREAT | O_WRONLY | O_TRUNC, 0666);\n\tFDErrorCheck(fd,1,\"writeMono32Wav Failed to create file \" << path);\n\twrite(fd,&header,sizeof(header));\n\twrite(fd,&data,sizeof(data));\n\twrite(fd,wav32,dataBytes);\n\tint res=close(fd);\n\treturn (res==-1)?2:0;\n}\n\n// 1 channel 96 khz 24 bits per sample\n\nint writeSinWav32(const char *path,float hz,float seconds){\n\tfloat sampleRate=96000;\n\tfloat samplesPerCycle=sampleRate/hz;\n\tfloat cyclesPerSample=hz/sampleRate;\n\tint cycles=(int)((seconds*sampleRate)/samplesPerCycle);\n\tint samples=(int)(samplesPerCycle*cycles);\n\tfloat *wav32=new float[samples];\n\tfor(int i=0;i<samples;i++){\n\t\tfloat a=sin(cyclesPerSample*i*M_PI*2);\n\t\twav32[i]=0.5*a;\n\t}\t\n\tint writeError=writeMono32Wav(path,sampleRate,samples,wav32);\n\tdelete[]wav32;\n\tstd::cout<<\"writeSinWav(\"<<path<<\",\"<<sampleRate<<\",\"<<samples<<\")\"<<std::endl;\n\treturn writeError;\n}\n\nint writeSinWav24(const char *path,float hz,float seconds){\n\tfloat sampleRate=96000;\n\tfloat samplesPerCycle=sampleRate/hz;\n\tfloat cyclesPerSample=hz/sampleRate;\n\tint cycles=(int)((seconds*sampleRate)/samplesPerCycle);\n\tint samples=(int)(samplesPerCycle*cycles);\n\tuint8_t *wav24=new uint8_t[samples*3];\n\tfor(int i=0;i<samples;i++){\n\t\tfloat a=sin(cyclesPerSample*i*M_PI*2);\n\t\tint aa=0x7fffff*a;\n\t\twav24[i*3+0]=aa>>0;\n\t\twav24[i*3+1]=aa>>8;\n\t\twav24[i*3+2]=aa>>16;\n\t}\t\n\tint writeError=writeMono24Wav(path,sampleRate,samples,wav24);\n\tdelete[]wav24;\n\tstd::cout<<\"writeSinWav(\"<<path<<\",\"<<sampleRate<<\",\"<<samples<<\")\"<<std::endl;\n\treturn writeError;\n}\n\nint writeWav16(const char *path,int sampleRate,int samples,int16_t *wav){\n\tWavHeader header={'R','I','F','F',0,'W','A','V','E','f','m','t',' '};\n\tWavData data={'d','a','t','a'};\n\tint dataBytes=2*samples;\n\theader.chunkSize=36+dataBytes;\n\theader.subchunkSize=16;\n\theader.audioFormat=1;//PCM\n\theader.numChannels=1;\n\theader.sampleRate=sampleRate;\n\theader.byteRate=sampleRate*2;\n\theader.blockAlign=2;\n\theader.bitsPerSample=16;\n\tdata.size=dataBytes;\n\tint fd=open(path, O_CREAT | O_WRONLY | O_TRUNC, 0666);\n\tFDErrorCheck(fd,1,\"testSinWav Failed to create file \" << path);\n\twrite(fd,&header,sizeof(header));\n\twrite(fd,&data,sizeof(data));\n\twrite(fd,wav,dataBytes);\n\tint res=close(fd);\n\treturn (res==-1)?2:0;\n}\n\n// 1 channel 48 khz 16 bitspersample\n\nint writeSinWav16(const char *path,float hz,float seconds){\n\tfloat sampleRate=48000;\n\tfloat samplesPerCycle=sampleRate/hz;\n\tfloat cyclesPerSample=hz/sampleRate;\n\tint cycles=(int)((seconds*sampleRate)/samplesPerCycle);\n\tint samples=(int)(samplesPerCycle*cycles);\n\tint16_t *wav=new int16_t[samples];\n\tfor(int i=0;i<samples;i++){\n\t\tfloat a=sin(cyclesPerSample*i*M_PI*2);\n\t\twav[i]=(int16_t)(32767*a);\n\t}\t\n\tint writeError=writeWav16(path,sampleRate,samples,wav);\n\tdelete[]wav;\n\tstd::cout<<\"writeSinWav(\"<<path<<\",\"<<sampleRate<<\",\"<<samples<<\")\"<<std::endl;\n\treturn writeError;\n}\n\n\ntypedef std::vector<std::vector<float>> Samples;\n\nstruct Waveform{\n\tint frequency;\n\tint channels;\n\tSamples samples;\n\n\tWaveform(int hertz,int channelCount, Samples data){\n\t\tfrequency=hertz;\n\t\tchannels=channelCount;\n\t\tsamples=data;\n\t}\n};\n\nint readWav(const char *path, Waveform **result){\n\tint fd=open(path,O_RDONLY);\n\tFDErrorCheck(fd,1,\"readWav open failure\");\n\n\tWavHeader header;\n\tssize_t n=read(fd,&header,sizeof(WavHeader));\n\tif(n!=sizeof(WavHeader)){\n\t\tstd::cout << \"readWav read failure\" << std::endl;\n\t\tclose(fd);\n\t\treturn 2;\n\t}\n//\tstd::cout << \"readWav n:\" << n << std::endl;\n\n\tif(memcmp(\"RIFF\",header.chunkID,4)!=0){\n\t\tstd::cout << \"readWav bad chunkID\" << std::endl;\n\t\tclose(fd);\n\t\treturn 3;\n\t}\n\n//\tstd::cout << \"readWav chunkSize:\" << header.chunkSize << std::endl;\n\tif(memcmp(\"WAVE\",header.format,4)!=0){\n\t\tstd::cout << \"readWav bad format\" << std::endl;\n\t\tclose(fd);\n\t\treturn 4;\n\t}\n\n\tif(memcmp(\"fmt \",header.subchunkID,4)!=0){\n\t\tstd::cout << \"readWav bad subchunkID\" << std::endl;\n\t\tclose(fd);\n\t\treturn 5;\n\t}\n#ifdef LOGREADWAV\n\tstd::cout << \"readWav subchunkSize:\" << header.subchunkSize << std::endl;\n\tstd::cout << \"readWav audioFormat:\" << header.audioFormat << std::endl;\n\tstd::cout << \"readWav numChannels:\" << header.numChannels << std::endl;\n\tstd::cout << \"readWav sampleRate:\" << header.sampleRate << std::endl;\n\tstd::cout << \"readWav byteRate:\" << header.byteRate << std::endl;\n\tstd::cout << \"readWav blockAlign:\" << header.blockAlign << std::endl;\n\tstd::cout << \"readWav bitsPerSample:\" << header.bitsPerSample << std::endl;\n#endif\n\tint skip=header.subchunkSize-16;\n\tif(skip>0){\n\t\tlseek(fd,skip,SEEK_CUR);\n\t}\n\n\tWavData data;\n\tssize_t d=read(fd,&data,sizeof(WavData));\n\tif(d!=sizeof(WavData)){\n\t\tstd::cout << \"readWav read failure\" << std::endl;\n\t\tclose(fd);\n\t\treturn 6;\n\t}\n\n\tif(memcmp(\"data\",data.dataID,4)!=0){\n\t\tstd::cout << \"readWav bad dataID\" << std::endl;\n\t\tclose(fd);\n\t\treturn 7;\n\t}\n\n\tint bytes=data.size;\n//\tstd::cout << \"readWav dataSize:\" << data.size << std::endl;\n\n\tuint8_t *raw=new uint8_t[bytes];\n\tssize_t s=read(fd,raw,bytes);\n\tclose(fd);\n\n\tif(s!=bytes){\n\t\tstd::cout << \"readWav read failure\" << std::endl;\n\t\treturn 8;\n\t}\n\n//\tstd::cout << \"readWav sample loaded bytes:\" << bytes << std::endl;\n\n\tint rate=header.sampleRate;\n\tint channels=header.numChannels;\n\tint bits=header.bitsPerSample;\n\tint align=header.blockAlign;\n\tint sampleCount=bytes/align;\n\t\n\tSamples sampleData(channels);\n\tfor(int i=0;i<channels;i++){\n\t\tsampleData[i]=std::vector<float>(sampleCount);\n\t}\n\tint offset=0;\n\tint d32=0;\n\tfloat oneth=1.0/0x80000000;\n\n\tfor(int i=0;i<sampleCount;i++){\n\t\tfor(int j=0;j<channels;j++){\n\t\t\tswitch(bits){\n\t\t\t\tcase 16:\n\t\t\t\t\td32=(raw[offset]<<16)+(raw[offset+1]<<24);\n\t\t\t\t\toffset+=2;\n\t\t\t\t\tbreak;\n\t\t\t\tcase 24:\n\t\t\t\t\td32=(raw[offset]<<8)+(raw[offset+1]<<16)+(raw[offset+2]<<24);\n\t\t\t\t\toffset+=3;\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\tstd::cout << \"readWav unsupported bitspersample:\" << bits << std::endl;\n\t\t\t\t\treturn 9;\n\t\t\t}\n\t\t\tsampleData[j][i]=d32*oneth;\n\t\t}\n\t}\n\n\tdelete[] raw;\n\t*result=new Waveform( rate, channels, sampleData);\n\treturn 0;\n}\n\nint writeLinearSweep24(const char *path,float hz0,float hz1,float seconds){\n\tint sampleRate=96000;\n\tstd::vector<float> sweep;\n\n\tdouble a=0.0;\n\tdouble hz=hz0;\n\tdouble hzhz=(hz1-hz0)/(seconds*sampleRate);\n\tfor(int i=0;i<seconds*sampleRate;i++){\n\t\tsweep.push_back(sin(a));\n\t\ta+=M_PI*2*hz/sampleRate;\n\t\thz+=hzhz;\n\t}\n\n\tsize_t samples=sweep.size();\n\tuint8_t *wav24=new uint8_t[samples*3];\n\tfor(int i=0;i<samples;i++){\n\t\tfloat a=sweep[i];\n\t\tint aa=0x7fffff*a;\n\t\twav24[i*3+0]=aa>>0;\n\t\twav24[i*3+1]=aa>>8;\n\t\twav24[i*3+2]=aa>>16;\n\t}\t\n\tint writeError=writeMono24Wav(path,sampleRate,samples,wav24);\n\tdelete[]wav24;\n\n\tstd::cout<<\"writeSweep24(\"<<path<<\",\"<<sampleRate<<\",\"<<samples<<\")\"<<std::endl;\n\treturn writeError;\n}\n\n\nint writeSweep24(const char *path,float hz0,float hz1,float seconds){\n\tint sampleRate=96000;\n\tstd::vector<float> sweep;\n\n\tdouble a=0.0;\n\tdouble logHz0=log(hz0);\n\tdouble logHz1=log(hz1);\n\tdouble logHzDelta=(logHz1-logHz0)/(seconds*sampleRate);\n\n\tdouble logHz=logHz0;\n\tfor(int i=0;i<seconds*sampleRate;i++){\n\t\tsweep.push_back(sin(a));\n\t\tdouble hz=exp(logHz);\n\t\ta+=M_PI*2*hz/sampleRate;\n\t\tlogHz+=logHzDelta;\n\t}\n\n\tsize_t samples=sweep.size();\n\tuint8_t *wav24=new uint8_t[samples*3];\n\tfor(int i=0;i<samples;i++){\n\t\tfloat a=sweep[i];\n\t\tint aa=0x7fffff*a;\n\t\twav24[i*3+0]=aa>>0;\n\t\twav24[i*3+1]=aa>>8;\n\t\twav24[i*3+2]=aa>>16;\n\t}\t\n\tint writeError=writeMono24Wav(path,sampleRate,samples,wav24);\n\tdelete[]wav24;\n\n\tstd::cout<<\"writeSweep24(\"<<path<<\",\"<<sampleRate<<\",\"<<samples<<\")\"<<std::endl;\n\treturn writeError;\n}\n\n\nint writeSiren24(const char *path,float hz0,float hz1,float seconds){\n\tint sampleRate=96000;\n\tstd::vector<float> sweep;\n\n\tdouble a=0.0;\n\tdouble logHz0=log(log(hz0));\n\tdouble logHz1=log(log(hz1));\n\tdouble logHzDelta=(logHz1-logHz0)/(seconds*sampleRate);\n\n\tdouble logHz=logHz0;\n\tfor(int i=0;i<seconds*sampleRate;i++){\n\t\tsweep.push_back(sin(a));\n\t\tdouble hz=exp(exp(logHz));\n\t\ta+=M_PI*2*hz/sampleRate;\n\t\tlogHz+=logHzDelta;\n\t}\n\n\tsize_t samples=sweep.size();\n\tuint8_t *wav24=new uint8_t[samples*3];\n\tfor(int i=0;i<samples;i++){\n\t\tfloat a=sweep[i];\n\t\tint aa=0x7fffff*a;\n\t\twav24[i*3+0]=aa>>0;\n\t\twav24[i*3+1]=aa>>8;\n\t\twav24[i*3+2]=aa>>16;\n\t}\t\n\tint writeError=writeMono24Wav(path,sampleRate,samples,wav24);\n\tdelete[]wav24;\n\n\tstd::cout<<\"writeSweep24(\"<<path<<\",\"<<sampleRate<<\",\"<<samples<<\")\"<<std::endl;\n\treturn writeError;\n}\n\n\nint standardWavs(){\n//\twriteSweep24(\"sweep100to2000hz.wav\",100,2000,3.0);\n//\twriteSweep24(\"sweep50to5000hz.wav\",50,5000,5.0);\n//\twriteSiren24(\"siren50to5000hz.wav\",20,6000,2.5);\n\n\twriteSiren24(\"siren5khzto10khz.wav\",5000,10000,1.0);\n\n//\twriteSinWav24(\"A4.wav\",440,3.0);\n/*\t\n//\twriteSinWav(\"sin10hz.wav\",10,3.0);\n\twriteSinWav(\"sin50hz.wav\",50,2.0);\n\twriteSinWav(\"sin100hz.wav\",1e2,2.0);\n\twriteSinWav(\"sin1khz.wav\",1e3,2.0);\n\twriteSinWav(\"sin10khz.wav\",1e4,2.0);\n\twriteSinWav(\"sin100khz.wav\",1e5,2.0);\n\twriteSinWav(\"sin1mhz.wav\",1e6,2.0);\n*/\t\n//\twriteSinWav(\"sin2mhz.wav\",2e6,2.0);\n\treturn 0;\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/xml.h\",\"length\":5924,\"type\":\"text/x-chdr\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#pragma once\n\n#include \"nitrohost.h\"\n\n#include <vector>\n#include <map>\n#include <ostream>\n#include <iterator>\n#include <algorithm>\n\n#include <libxml/xmlreader.h>\n#include <libxml/parser.h>\n#include <libxml/tree.h>\n#include <libxml/encoding.h>\n#include <libxml/xmlwriter.h>\n\n#define ISO8859_ENCODING \"ISO-8859-1\"\n#define UTF (const xmlChar*)\n\nint writeXML(const char *path){\n\n\txmlTextWriterPtr writer=xmlNewTextWriterFilename(path,0);\n\tif(writer==NULL){\n\t\tstd::cout << \"writeXML failure\" << std::endl;\n\t\treturn 1;\n\t}\n\n\tint startDoc=xmlTextWriterStartDocument(writer,NULL,ISO8859_ENCODING,NULL);\n\tif(startDoc<0){\n\t\tstd::cout << \"writeXML xmlTextWriterStartDocument failure\" << std::endl;\n\t\treturn 2;\n\t}\n\n\tint startElement=xmlTextWriterStartElement(writer,UTF \"Example\");\n\tif(startElement<0){\n\t\tstd::cout << \"writeXML xmlTextWriterStartElement failure\" << std::endl;\n\t\treturn 3;\n\t}\n\n\tint writeComment=xmlTextWriterWriteComment(writer,UTF \"Comment\");\n\tif(writeComment<0){\n\t\tstd::cout << \"writeXML xmlTextWriterWriteComment failure\" << std::endl;\n\t\treturn 4;\n\t}\n\n\tint startElement2=xmlTextWriterStartElement(writer,UTF \"Start\");\n\tif(startElement2<0){\n\t\tstd::cout << \"writeXML xmlTextWriterStartElement failure\" << std::endl;\n\t\treturn 4;\n\t}\n\n\tint writeAttribute=xmlTextWriterWriteAttribute(writer,UTF \"Attribute\",UTF \"Value\");\n\tif(writeAttribute<0){\n\t\tstd::cout << \"writeXML xmlTextWriterAttribute failure\" << std::endl;\n\t}\n\n\txmlTextWriterEndElement(writer);\n\txmlTextWriterEndElement(writer);\n\n\txmlTextWriterEndDocument(writer);\n\n\txmlCleanupParser();\n\txmlMemoryDump();\n\treturn 0;\n}\n\nvoid dumpNode(xmlNodePtr root, int depth, std::string indent){\n\tfor(xmlNodePtr node=root;node;node=node->next){\n\t\tif(node->type==XML_ELEMENT_NODE){\n\t\t\tstd::cout << indent << node->name << std::endl;\n\t\t}\n\t\tif(depth>0){\n\t\t\tdumpNode(node->children,depth-1,indent+\" \");\n\t\t}\n\t}\n}\n\nint dumpXML(const char *path){\n\txmlDocPtr doc=xmlReadFile(path,NULL,0);\n\n\tif(doc==NULL){\n\t\tstd::cout << \"readXML failure\" << std::endl;\n\t\treturn 1;\n\t}\n\n\txmlNodePtr root = xmlDocGetRootElement(doc);\n\n\tdumpNode(root,4,\":\");\n\n\txmlFreeDoc(doc);\n\txmlCleanupParser();\n\txmlMemoryDump();\n\treturn 0;\n}\n\nstruct Element{\n\tutf8 name;\n\tstd::vector<Element> kids;\t\n\tstd::vector<utf8> names;\n\tAttributes attributes;\n\tstd::vector<utf8> content;\n\n\tElement(){}\n\tElement(const Element &e):name(e.name),kids(e.kids),names(e.names),attributes(e.attributes),content(e.content){}\n\tElement(utf8 name,Attributes &attributes):name(name),attributes(attributes){}\n\n\tutf8 value(utf8 name){\n\t\tauto it=std::find(names.begin(),names.end(),name);\n\t\tauto index=std::distance(names.begin(),it);\n\t\treturn (index<kids.size())?joinStrings(kids[index].content,\"\"):\"\";\n\t}\n\n\tlong valuei(utf8 name){\n\t\tchar *e;\n\t\treturn std::strtol(value(name).c_str(),&e,10);\n\t}\n\n\tutf8 attribute(utf8 name){\n\t\tif(attributes.count(name)>0){\n\t\t\treturn attributes.at(name);\n\t\t}\n\t\treturn \"\";\n\t}\n\n\tlong attributei(utf8 name){\n\t\tutf8 a=attribute(name);\n\t\tchar *e;\n\t\treturn std::strtol(a.c_str(),&e,10);\n\t}\n\n\tutf8 toString() const{\n\t\tstd::stringstream ss;\n\t\tss << name;\n\t\tss << \" content:\" << joinStrings(content,\" \");\n\t\tss << \" names:\" << joinStrings(names,\" \");\n\t\tss << \" attributes:\";\n\t\tfor(auto a:attributes){\n\t\t\tss << a.first << \"=\" << a.second << \";\";\n\t\t}\n//\t\tss << \" \" << joinStrings(attributes,\",\");\n\t\treturn ss.str();\n\t}\n\n\tvoid dump(utf8 indent){\n\t\tstd::cout << indent << toString() << std::endl;\n\t\tindent+=name+\"/\";\n\t\tfor(auto it=kids.begin();it!=kids.end();it++){\n\t\t\tit->dump(indent);\n\t\t}\n\t}\n\n\tElement* find(utf8 path){\n\t\tstd::stringstream ss(path);\n\t\tutf8 s;\n\t\tElement *result=this;\n\t\twhile (std::getline(ss, s, '/')) {\n\t\t\tif(s.length()==0){\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tstd::vector<Element>::iterator end=result->kids.end();\n\t\t\tstd::vector<Element>::iterator match=end;\n\t\t\tfor(auto it=result->kids.begin();it!=end;it++){\n\t\t\t\tif(it->name==s){\n\t\t\t\t\tmatch=it;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif(match==end){\n\t\t\t\treturn NULL;\n\t\t\t}\n\t\t\tresult=&(*match);\n//\t\t\tstd::cout << s << std::endl;\n\t\t}\n\t\treturn result;\n\t}\n\n\tstd::vector<Element*> findAll(utf8 path){\n\t\tstd::vector<Element*> elements;\n\t\tstd::stringstream ss(path);\n\t\tutf8 s;\n\t\tElement *result=this;\n\t\twhile (std::getline(ss, s, '/')) {\n\t\t\tif(s.length()==0){\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tstd::vector<Element>::iterator end=result->kids.end();\n\t\t\tstd::vector<Element>::iterator match=end;\n\t\t\tfor(auto it=result->kids.begin();it!=end;it++){\n\t\t\t\tif(it->name==s){\n\t\t\t\t\telements.push_back(&(*it));\n\t\t\t\t}\n\t\t\t}\n//\t\t\tstd::cout << s << std::endl;\n\t\t}\n\t\treturn elements;\n\t}\n\n};\n\nvoid readElement(xmlNodePtr xmlNode,Element &root){\n\tfor(xmlNodePtr node=xmlNode;node;node=node->next){\n\t\tutf8 name((char*)node->name);\n\t\tAttributes attributes;\n\t\tfor(auto attribute=node->properties;attribute;attribute=attribute->next){\n\t\t\tutf8 aname((char*)attribute->name);\n\t\t\tstd::vector<utf8> content;\n\t\t\tfor(xmlNodePtr kid=attribute->children;kid;kid=kid->next){\n\t\t\t\tcontent.emplace_back((char*)kid->content);\n\t\t\t}\t\t\n\t\t\tutf8 avalue=joinStrings(content,\"\");\n//\t\t\tattributes.emplace_back(aname,avalue);\n\t\t\tattributes.emplace(aname,avalue);\n\t\t}\n\t\tswitch(node->type){\n\t\t\tcase XML_ELEMENT_NODE:\n//\t\t\t\tstd::cout << \"Element:\" << name << std::endl;\t\t\t\t\n\t\t\t\troot.kids.emplace_back(name,attributes);\n\t\t\t\troot.names.emplace_back(name);\n\t\t\t\treadElement(node->children,root.kids.back());\n\t\t\t\tbreak;\n\t\t\tcase XML_TEXT_NODE:\n\t\t\t\troot.content.emplace_back((char*)node->content);\n//\t\t\t\tstd::cout << (char*)node->content;\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tstd::cout << \"ignoring type \" << node->type << \" \" << node->name << std::endl;\n\t\t}\n\t}\n}\n\nint readXML(const char *path){\n\txmlDocPtr doc=xmlReadFile(path,NULL,XML_PARSE_NOBLANKS);\n\n\tif(doc==NULL){\n\t\tstd::cout << \"readXML failure\" << std::endl;\n\t\treturn 1;\n\t}\n\txmlNodePtr root = xmlDocGetRootElement(doc);\n\n\tAttributes none={};\n\tElement tree(\"\",none);\n\treadElement(root,tree);\n\n\ttree.dump(\"*\");\n\n//\tdumpNode(root,2,\":\");\n\n\txmlFreeDoc(doc);\n\txmlCleanupParser();\n\txmlMemoryDump();\n\treturn 0;\n}\n\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/displaytest.cpp\",\"length\":3207,\"type\":\"text/x-c++src\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"#include \"drmdisplay.h\"\n#include \"eglgraphics.h\"\n#include \"alsaaudio.h\"\n#include \"udev.h\"\n//#include \"host.h\"\n#include \"sysinfo.h\"\n#include \"cec.h\"\n#include \"video.h\"\n\n// std::string StaticPath=\"..\";\n\nint flipTest(DRMDisplay &display);\nint displayTest();\n\nenum TestDisplays{\n\tTestDisplaysSetMode=100,\n\tTestDisplaysBegin=200,\n\tTestDisplaysConfigure=300,\n\tTestDisplaysInit=400,\n\tTestDisplaysEnd=500\n};\n\nint enumAudio(){\n\tALSAAudio audio;\n\tALSADevice *pcmOut=0;//&audio.alsaDevices[2];\n\tALSADevice *midiIn=0;//&audio.alsaDevices[1];\n\n\tfor(ALSADevice &dev:audio.alsaDevices){\n\t\tint flags=dev.query();\n\t\tstd::cout << dev.flags << \",\" << flags << std::endl;\n\t\tif(!pcmOut && flags&1){\n\t\t\tpcmOut=&dev;\n\t\t}\n\t\tif(!midiIn && flags&8){\n\t\t\tmidiIn=&dev;\n\t\t}\n\t}\n\tstd::string result;\n\treturn 0;\n}\n\n\nint main(){\n//\treturn test3D();\n//\treturn testCEC();\n//\treturn testVideo();\n\n\tSysInfo sysInfo;\n\n\tAttributes registry={\n\t\t{\"hostname\",sysInfo.hostname},\n\t\t{\"version\",\"0.0.6\"},\n\t\t{\"machine\",sysInfo.machine()},\n\t\t{\"domain\",sysInfo.domain()},\n\t\t{\"user\",getenv(\"USER\")},\n\t\t{\"serialnumber\",sysInfo.serialnumber}\n\t};\n\n//\tint hosting=hostIPv6(Broadcom,registry);\n\n\tDevices devices;\n\n//\tdevices.enumInputs(\"input\");\n//\tdevices.enumUSB();\n\n\tALSAAudio audio;\n\taudio.about();\n\tint err=audio.enumCards();\n\n\tstd::string result;\n//\taudio.testPCMIn(\"hw:3\",result);\n//\taudio.testPCMOut(\"hw:CARD=vc4hdmi0,DEV=0\",result);\n\taudio.testPCMOut(\"default\",result);\n//\taudio.testPCMOut(\"hw:0,3\",result);\n//\taudio.testMidiIn(\"default\",result);\n\n\treturn displayTest();\n}\n\nint displayTest(){\n\tDRMDisplay display;\n\n\tint notok=0;\t\n\tnotok=display.openCard(\"/dev/dri/card1\");\n\tif(notok){\n\t\tnotok=display.openCard(\"/dev/dri/card0\");\n\t}\n\tif(notok){\n\t\treturn notok;\n\t}\n\n\tstd::string result=\"{}\";\n\tint infoerror=display.deviceInfo(result);\n\tif(infoerror){\n\t\treturn infoerror;\n\t}\n//\tstd::cout << result << std::endl;\n\n\tint mode=0;//display.countModes()-1;\n\tint setmode=display.setMode(mode);\n\tif(setmode){\n\t\treturn TestDisplaysConfigure+setmode;\n\t}\n\tstd::cout << \"mode set\" << std::endl;\n\n\tint begin=display.beginGraphics();\n\tif(begin){\n\t\treturn TestDisplaysBegin+begin;\n\t}\n\tstd::cout << \"Display graphics begun\" << std::endl;\n\n\tint configure=display.configure();\n\tif(configure){\n\t\treturn TestDisplaysConfigure+configure;\n\t}\n\tstd::cout << \"display configured\" << std::endl;\n\n\tflipTest(display);\n\n\tint endGraphics=display.endGraphics();\n\tif(endGraphics){\n\t\treturn TestDisplaysConfigure+configure;\n\t}\n\tstd::cout << \"display graphics ended\" << std::endl;\n\n\tint destroy=display.destroy();\n\tif(destroy){\n\t\treturn destroy;\n\t}\n\tstd::cout << \"display destroyed\" << std::endl;\n\n\treturn 0;\n}\n\nint flipTest(DRMDisplay &display){\n\tEGLGraphics graphics;\n\n\tint testCount=120;\n\tif(testCount){\n\n\t\tint init=graphics.init(StaticPath);\n\t\tif(init){\n\t\t\treturn TestDisplaysInit+init;\n\t\t}\n\n\t\tstd::cout << \"Graphics Initialised:\"<< display.width << \"x\" <<display.height << std::endl;\n\t\tfor(int i=0;i<testCount;i++){\n\t\t\tgraphics.clear(0.15f, 0.15f, (float)i/testCount, 1.0f);\n\t\t\tint flipfail=display.flip();\n\t\t\tif(flipfail){\n\t\t\t\tstd::cout << \"flipTest error:\" << flipfail << std::endl;\n\t\t\t\treturn flipfail;\n\t\t\t}\n\t\t\tstd::cout << \".\";\n//\t\t\tsleep(1);\n\t\t}\n\n\t\tdisplay.flop();\n\t}\n\treturn 0;\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/fit3.cpp\",\"length\":3809,\"type\":\"text/x-c++src\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrohost fit3 server\n// (c) 2025 Simon Armstrong\n// All Rights Reserved\n\n#include \"headless.h\"\n#include \"redis.h\"\n#include \"sysinfo.h\"\n#include \"http.h\"\n#include \"clocks.h\"\n#include \"wav.h\"\n\n//#include <sys/param.h> \n\n#ifdef USE_ALSA_AUDIO\n\n#include \"alsaaudio.h\"\n\nstd::mutex taskMutex;\n\nstd::list<HttpConnection*> HttpTasks={};\n\nint enumALSA(){\n\tALSAAudio audio;\n\taudio.about();\n\tint err=audio.enumCards();\n\treturn err;\n}\n\n\nint audioTest(){\n\tALSAAudio audio;\n\taudio.about();\n\tint err=audio.enumCards();\n\n\tstd::string result;\n//\taudio.testPCMIn(\"hw:3\",result);\n//\taudio.testPCMOut(\"hw:CARD=vc4hdmi0,DEV=0\",result);\n\taudio.testPCMOut(\"default\",result);\n//\taudio.testPCMOut(\"hw:0,3\",result);\n//\taudio.testMidiIn(\"default\",result);\n\treturn 0;\n}\n#endif\n\nint snapshotFB(utf8 &content){\n\treturn -1;\n}\n\nJSValue *parseCommandLine(utf8 args){\n\tJSArray *a=new JSArray();\n\tStrings split=splitString(args,' ');\n\tfor(utf8 arg:split){\n\t\tJSValue *v=new JSValue(arg,false);\n\t\ta->values.push_back(v);\n\t}\n\treturn new JSValue(a);\n}\n\nJSArray *parseArgs(Strings args){\n\tJSArray *a=new JSArray();\n\tfor(utf8 arg:args){\n\t\tJSValue *v=new JSValue(arg,false);\n\t\ta->values.push_back(v);\n\t}\n\treturn a;\n}\n\nvoid *cliTask(void *args){\n\twhile(true){\n\t\tstd::cout << \">\" << std::flush;\n\t\tfor (std::string line; std::getline(std::cin, line);) {\n\t\t\tstd::cout << line << std::endl;\n\t\t\tStrings lines=splitString(line,'\\n');\n\t\t\tutf8 id=\"0\";\n\t\t\tfor(utf8 line:lines){\n//\t\t\t\tstd::cout << \"+\" << line << std::endl;\n\t\t\t\tStrings split=splitString(line,' ');\n\t\t\t\tutf8 method=split[0];\n\t\t\t\tif(method==\"exit\"){\n\t\t\t\t\texit(EXIT_SUCCESS);\n//\t\t\t\t\traise(SIGINT);\n//\t\t\t\t\tkill(-1,SIGINT);  // a bit overkill\n// \t\t\t\t\tkill(0,SIGINT);  // works weel from fork\n\t\t\t\t\treturn NULL;\n\t\t\t\t}\n\t\t\t\tsplit.erase(split.begin());\n\t\t\t\tJSValue *args=new JSValue(joinStrings(split,\" \"),true);\n//\t\t\t\tJSArray *array=parseArgs(split);\n//\t\t\t\tJSValue *args=new JSValue(array);\n\t\t\t\tutf8 reply=InvokeRPC(id, method, args);\n\t\t\t\tstd::cout << method << \">>\" << reply << std::endl;\n\t\t\t}\n\t\t\tstd::cout << \">\" << std::flush;\n\t\t}\n\t}\n}\n\nint hostStdIn(){\n\tpthread_t thread=0;\n\tconst pthread_attr_t *threadAttributes=NULL;\n\tint cliError=pthread_create(&thread,threadAttributes,cliTask,NULL);\n\tif(cliError){\n\t\tstd::cout << \"hostStdIn run pthread_create failed\" << std::endl;\n\t\treturn 1;\n\t}\n\treturn 0;\n}\n\nint forkStdIn(){\n\tint forkPid=fork();\n\tif(forkPid==0){\n\t\tcliTask(NULL);\n\t}\n\treturn 0;\n}\n\nvoid signalHandler( int signum ) {\n\tif(HttpSocket4){\n\t\tshutdown(HttpSocket4,SHUT_RD);\n\t\tclose(HttpSocket4);\n\t\tHttpSocket4=0;\n\t}\n\tif(HttpSocket6){\n\t\tshutdown(HttpSocket6,SHUT_RD);\n\t\tclose(HttpSocket6);\n\t\tHttpSocket6=0;\n\t}\n\tstd::cout << \"Interrupt signal (\" << signum << \") received.\" << std::endl;\n\n\tstd::cout << \"Closings Tasks\" << std::endl;\n\n\tcloseHttpTasks();\n\tstd::this_thread::sleep_for(std::chrono::seconds(1));   \n// raise with default signal handler\n//\tsignal(signum, SIG_DFL);\n//\traise(signum);\n\texit(signum);  \n}\n\n\nint main(){\n//\treturn standardWavs();\n\tsignal(SIGINT, signalHandler);\n\tsignal(SIGHUP, signalHandler);\n\telapsedNanos();\n#ifdef EXTRAS\n\tchar cwdBuffer[PATH_MAX];\n\tgetcwd(cwdBuffer,PATH_MAX);\n\n\tstd::string result;\n\tint error=listPorts(result);\n#endif\n\n\tSysInfo sysInfo;\n\n\tstd::cout << \"nitrologic microbit dsp fit3 0.4.3\" << std::endl;\n\tstd::cout << \"©2026 Simon Armstrong\" << std::endl;\n\tstd::cout << \"sysInfo.serialnumber:\" << sysInfo.serialnumber << std::endl;\n\n\tAttributes registry={\n\t\t{\"hostname\",sysInfo.hostname},\n\t\t{\"version\",\"0.0.6\"},\n\t\t{\"machine\",sysInfo.machine()},\n\t\t{\"domain\",sysInfo.domain()},\n\t\t{\"user\",getenv(\"USER\")},\n\t\t{\"serialnumber\",sysInfo.serialnumber}\n\t};\n\n\tstereo=new Stereo(registry);\n\n#ifdef USE_ALSA_AUDIO\n//\tenumALSA();\n#endif\n\n//\thostStdIn();\n\n//\thostProcess();\n\n\thostIPv6(stereo->platform,registry);\n//\thostIPv4(stereo->platform,registry);\n\n\treturn 0;\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/nativetool.cpp\",\"length\":1176,\"type\":\"text/x-c++src\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrohost native tool\r\n// (c) 2024 Simon Armstrong\r\n// All Rights Reserved\r\n\r\n#include \"nitrohost.h\"\r\n\r\n//#include \"_vcpu.h\"\r\n\r\n#include <unordered_map>\r\n\r\n#include <windows.h>\r\n\r\nint Quit(Strings args){\r\n\texit(0);\r\n\treturn 0;\r\n}\r\n\r\nint SendKey(Strings args){\r\n\tif(args.size()<3) return -1;\r\n\tHWND hwnd = (HWND)std::stoll(args[1]);\r\n\tint code = std::stoi(args[2]);\r\n\tLRESULT ok1=SendMessage(hwnd,WM_KEYDOWN,code,0);\r\n\tLRESULT ok2=SendMessage(hwnd,WM_KEYUP,code,0);\r\n\treturn 0;\r\n}\r\n\r\ntypedef int(*command)(Strings); \r\ntypedef std::unordered_map<utf8,command> CommandMap;\r\n\r\nCommandMap commands={\r\n\t{\"Quit\",Quit},\r\n\t{\"SendKey\",SendKey}\r\n};\r\n\r\n// SendKey hwnd, keycode\r\n\r\nint main(){\r\n\tstd::cout << \"native 0.0.2\" << std::endl;\r\n\r\n\tbool running=true;\r\n\twhile(running){\r\n\t\tutf8 line;\r\n\t\tstd::getline(std::cin, line);\r\n\t\tStrings args=splitString(line,' ');\r\n\t\tif(args.size()>0){\r\n\t\t\tutf8 cmd = args[0];\r\n\t\t\tauto it = commands.find(cmd);\r\n\t\t\tif(it!=commands.end()){\r\n\t\t\t\tint result=(it->second)(args);\r\n\t\t\t\tstd::cout << \"result : \" << result << std::endl;\r\n\t\t\t}\r\n\t\t}\r\n#ifdef log_args\t\t\r\n\t\tfor(utf8 s : args){\r\n\t\t\tstd::cout << s << std::endl;\r\n\t\t}\r\n#endif\t\t\r\n\t}\r\n\treturn 0;\r\n\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/native/opensocket.cpp\",\"length\":19085,\"type\":\"text/x-c++src\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// opensocket.cpp\n// (c) 2024 Simon Armstrong - All rights reserved\n\n// courtesy github.com/nitrologic/nitro/nitro/nitrosockets.cpp\n// courtesy bin/plainview/platform.h\n\n//#define HAS_UDT\n\n#include <stdio.h>\n#include <iostream>\n#include <string.h>\n\n#ifdef WIN32\n#define WIN32_LEAN_AND_MEAN \n#include <windows.h>\n#include <profileapi.h>\n#else\n#define POSIX \n#include <sys/time.h>\n#endif\n\n#include \"opensocket.h\"\n\nuint64_t cpuTime() {\n\tuint64_t micros;\n#ifdef WIN32\n\tLARGE_INTEGER frequency;\n\tLARGE_INTEGER count;\n\tQueryPerformanceFrequency(&frequency);\n\tQueryPerformanceCounter(&count);\n\tmicros = (count.QuadPart * (uint64_t)1e6) / frequency.QuadPart;\n#else\n\ttimeval tv;\n\tgettimeofday(&tv, nullptr);\n\tmicros = tv.tv_sec * 1000000ULL + tv.tv_usec;\n#endif\n\treturn micros;\n}\n\nfloat peekf(void *p);\n\nvoid processOSC(char *packet, int length){\n\tint p = 0;\n\tconst char *address;\n\tconst char *format;\n\n\twhile (p<length) {\n\t\tint code = packet[p];\n\t\tswitch (code){\n\n\t\tcase 47:{   // /address\n\t\t\taddress = packet + p;\n\t\t\tprintf(\"address %s\\n\", address);\n\t\t\tsize_t n = strlen(address);\n\t\t\tint n4 = (n + 1 + 3)&-4;\n\t\t\tp += n4;\n\t\t\tbreak;\n\t\t}\n\n\t\tcase 44:{\t// ,format\n\t\t\tconst char *format = packet + p;\n\t\t\tprintf(\"format %s\\n\", format);\n\t\t\tsize_t n = strlen(format);\n\t\t\tint n4 = (n + 1 + 3)&-4;\n\t\t\tp += n4;\n\t\t\tfor (const char *f = format + 1; *f; f++){\n\t\t\t\tchar typetag = *f;\n\t\t\t\tswitch (typetag){\n\t\t\t\t\t//\t\t\t\t\t\tcase 'i':\n\t\t\t\t\t//\t\t\t\t\t\t\tbreak;\n\t\t\t\tcase 'f':{\n\t\t\t\t\tfloat f = peekf(packet + p);\n\t\t\t\t\tprintf(\"F:%f\\n\", f);\n\t\t\t\t\tp += 4;\n\t\t\t\t\tbreak; }\n\t\t\t\t\t//\t\t\t\t\t\tcase 's':\n\t\t\t\t\t//\t\t\t\t\t\tcase 'b':\n\t\t\t\t\t//\t\t\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\tprintf(\"Unhandled OSC typetag %d %s\\n\", typetag, packet + p);\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tbreak;\n\t\t}\n\n\t\tdefault:\n\t\t\tprintf(\"Unhandled OSC code %d %s\\n\", code, packet + p);\n\t\t\treturn;\n\t\t\tbreak;\n\t\t}\n\t}\n\n}\n\n\n// posix is below\n\n#ifdef _WIN32\n\n#define WIN32_LEAN_AND_MEAN\n\n#include <windows.h>\n#include <winsock2.h>\n#include <ws2tcpip.h>\n\n#ifdef HAS_UDT\n\n#include <udt.h>\n\n#endif\n\n\n#include <objbase.h>\n\nvoid initSystem() {\n\tCoInitialize(NULL);\n}\n\nbool haveWinsock = false;\n\nvoid tidyUp() {\n\tWSACleanup();\n}\n\nSocket::Socket(int64_t descriptor) {\n\tfd = descriptor;\n}\n\nSocket::~Socket() {\n\tif (fd) {\n\t\tclose();\n\t}\n}\n\nfloat peekf(void *p){\n\tconst unsigned int i = ntohl(*((unsigned int *)p));\n\treturn *((float *)(&i));\n}\n\nWSADATA wsaData;\n\nbool initWinsock(){\n\tif (haveWinsock) return true;\n\tint result = WSAStartup(MAKEWORD(2,2), &wsaData);\n\tif (result) {\n\t\tprintf(\"WSAStartup failed with error: %d\\n\", result);\n\t\treturn false;\n\t}\t\n\thaveWinsock=true;\n\treturn true;\n}\n\nint Socket::testOSCIn(){\n\tinitWinsock();\n\n\tSOCKET s;\n\tsockaddr_in a;\n\tsockaddr_in b;\n\tint blen = sizeof(b);\n\n\tchar buffer[549];\n\n\tu_short hostPort = 7001;\n\n\ts= socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);\n\tif (s == INVALID_SOCKET){\n\t\tprintf(\"socket fail\\n\");\n\t\treturn -5;\n\t}\n\ta.sin_family = AF_INET;\n\ta.sin_port = htons(hostPort);\n\ta.sin_addr.s_addr = htonl(INADDR_ANY);\n\n\tif (bind(s, (SOCKADDR*)&a, sizeof(a))!=0) {\n\t\tprintf(\"%s\\n\", strerror(errno));\n\t\treturn -3;\n\t}\n\n\twhile (true){\n\t\tsize_t count = recvfrom(s, buffer, sizeof(buffer), 0, (SOCKADDR*)&b, &blen);\n\t\tif (count == -1) {\n\t\t\tprintf(\"%s\\n\", strerror(errno));\n\t\t}\n\t\telse if (count == sizeof(buffer)) {\n\t\t\tprintf(\"datagram too large for buffer: truncated\\n\");\n\t\t}\n\t\telse {\n\t\t\tprocessOSC(buffer, count);\n\t\t}\n\t}\n\tclosesocket(s);\n\n}\n\nint Socket::testOSCOut(){\n\n\tinitWinsock();\n\n//\tconst char *host = \"255.255.255.255\";\n\n\tconst char *host = \"192.168.1.255\";\n\t//\tconst char *host=\"192.168.1.114\";\n\tconst char *port = \"7000\";\n\n\t//\tchar content[32];\n\n\tchar content[] = { \"/1/rotary1\\0\\0,f\\0\\0\\0\\0\\0\\0\" };\n\n\taddrinfo hints = { 0 };\n\thints.ai_family = AF_UNSPEC;\n\thints.ai_socktype = SOCK_DGRAM;\n\thints.ai_protocol = 0;\n\thints.ai_flags = AI_ADDRCONFIG;\n\n\taddrinfo* res = 0;\n\tint err = getaddrinfo(host, port, &hints, &res);\n\tif (err != 0) {\n\t\tprintf(\"failed to resolve remote socket address (err=%d)\\n\", err);\n\t\treturn -1;\n\t}\n\n\tint fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);\n\tif (fd == -1) {\n\t\tprintf(\"%s\\n\", strerror(errno));\n\t\treturn -2;\n\t}\n\n\tchar broadcast[] = { 1, 1, 1, 1 };\n//\tint broadcast = 1;\n\tif (setsockopt(fd, SOL_SOCKET, SO_BROADCAST, broadcast, sizeof(broadcast)) == -1) {\n\t\tprintf(\"%s\\n\", strerror(errno));\n\t\treturn -3;\n\t}\n\n\n\tif (sendto(fd, content, sizeof(content), 0, res->ai_addr, res->ai_addrlen) == -1) {\n\t\tprintf(\"%s\\n\", strerror(errno));\n\t\treturn -3;\n\t}\n\n\treturn 0;\n}\n\nSocket* Socket::connect(const char *host,int port){\t\n\tif(!initWinsock()){\n\t\treturn 0;\n\t}\n\n\taddrinfo hints = { 0 };\n\thints.ai_family = AF_UNSPEC;\n    hints.ai_socktype = SOCK_STREAM;\n    hints.ai_protocol = IPPROTO_TCP;\n\n\taddrinfo *address;\n\n\tchar portname[6];\n\tchar * p=_itoa(port&65535, portname, 10);\n\n\tint result = getaddrinfo(host, portname, &hints, &address);\n\tif ( result) {\n\t\tprintf(\"getaddrinfo failed with error: %d\\n\", result);\n\t\treturn 0;\n\t}\n\n\tSOCKET s = INVALID_SOCKET;\n\n\tfor(addrinfo *ptr=address; ptr != NULL ;ptr=ptr->ai_next) {\n\t\ts = socket(ptr->ai_family, ptr->ai_socktype, ptr->ai_protocol);\t\t\n\t\tif (s == INVALID_SOCKET) {\n\t\t\tprintf(\"socket failed error: %ld\\n\", WSAGetLastError());\n\t\t\tcontinue;\n\t\t}\t\n\t\tresult = ::connect( s, ptr->ai_addr, (int)ptr->ai_addrlen);\n\t\tif (result == SOCKET_ERROR) {\n\t\t\tclosesocket(s);\n\t\t\ts = INVALID_SOCKET;\n\t\t\tcontinue;\n\t\t}\n\t\tbreak;\n\t}\n\t\n\tfreeaddrinfo(address);\n\t\n\tif (s == INVALID_SOCKET) {\n\t\tstd::cout << \"Socket connect fail\" << std::endl;\n\t\treturn 0;\n\t}\n\t\n\tstd::cout << \"Socket connect fd = \" << (int)s << std::endl;\n\n\treturn new Socket(s);\n}\n\nint Socket::accept() {\n\n\tSOCKET listen = fd;\n\n\tSOCKET s = INVALID_SOCKET;\n\n\ts = ::accept(listen, NULL, NULL);\n\n\tif (s == INVALID_SOCKET) {\n\t\tstd::cout << \"Socket accept fail \" << WSAGetLastError() << std::endl;\n\t\tclosesocket(s);\n\t\treturn 1;\n\t}\n\n\treturn 0;\n}\n\nvoid Socket::listen(int port, int flags, void *user){\t\n\n\tif (!initWinsock()){\n\t\treturn;\n\t}\n\n\tSOCKET s = INVALID_SOCKET;\n\n\tint result = WSAStartup(MAKEWORD(2, 2), &wsaData);\n\tif (result != NO_ERROR) {\n\t\twprintf(L\"WSAStartup() failed with error: %d\\n\", result);\n\t\treturn;\n\t}\n\n\ts = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);\n\tif (s == INVALID_SOCKET) {\n\t\twprintf(L\"socket function failed with error: %ld\\n\", WSAGetLastError());\n\t\treturn;\n\t}\n\n\tsockaddr_in service;\n\tservice.sin_family = AF_INET;\n\tservice.sin_addr.s_addr = inet_addr(\"127.0.0.1\");\n\tservice.sin_port = htons(port);\n\n\tresult = bind(s, (SOCKADDR *)& service, sizeof(service));\n\tif (result == SOCKET_ERROR) {\n\t\twprintf(L\"bind function failed with error %d\\n\", WSAGetLastError());\n\t\tresult = closesocket(s);\n\t\tif (result == SOCKET_ERROR)\n\t\t\twprintf(L\"closesocket function failed with error %d\\n\", WSAGetLastError());\n\t\treturn;\n\t}\n\n\t// https://learn.microsoft.com/en-us/windows/win32/api/winsock2/nf-winsock2-listen\n\n\tif (::listen(s, SOMAXCONN) == SOCKET_ERROR){\n\t\twprintf(L\"listen function failed with error: %d\\n\", WSAGetLastError());\n\t\treturn;\n\t}\n\n\tstd::cout << \"listening on port \" << (int)port << std::endl;\n\n\tfd = s;\n\n#ifdef sockets_stay_closed\n\tresult = closesocket(s);\n\tif (result == SOCKET_ERROR) {\n\t\twprintf(L\"closesocket function failed with error %d\\n\", WSAGetLastError());\n\t\treturn;\n\t}\n#endif\n}\n\n\nSocket* Socket::open(int port, int flags) {\n//\treturn nullptr;\n\n\tif (!initWinsock()) {\n\t\treturn nullptr;\n\t}\n\n\tSOCKET s = INVALID_SOCKET;\n\n\tint result = WSAStartup(MAKEWORD(2, 2), &wsaData);\n\tif (result != NO_ERROR) {\n\t\twprintf(L\"WSAStartup() failed with error: %d\\n\", result);\n\t\treturn nullptr;\n\t}\n\n\ts = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);\n\tif (s == INVALID_SOCKET) {\n\t\twprintf(L\"socket function failed with error: %ld\\n\", WSAGetLastError());\n\t\treturn nullptr;\n\t}\n\n\tsockaddr_in service;\n\tservice.sin_family = AF_INET;\n\tservice.sin_addr.s_addr = inet_addr(\"127.0.0.1\");\n\tservice.sin_port = htons(port);\n\n\tresult = bind(s, (SOCKADDR*)&service, sizeof(service));\n\tif (result == SOCKET_ERROR) {\n\t\twprintf(L\"bind function failed with error %d\\n\", WSAGetLastError());\n\t\tresult = closesocket(s);\n\t\tif (result == SOCKET_ERROR)\n\t\t\twprintf(L\"closesocket function failed with error %d\\n\", WSAGetLastError());\n\t\treturn  nullptr;\n\t}\n\n\treturn new Socket(s);\n}\n\nint Socket::serve(Connection* service) {\n\n\tSOCKET s = fd;\n\n\tstd::cout << \"serving\" << std::endl;\n\n\tint listening = ::listen(s, SOMAXCONN);\n\n\tif ( listening == SOCKET_ERROR) {\n\t\twprintf(L\"listen function failed with error: %d\\n\", WSAGetLastError());\n\t\treturn 0;\n\t}\n\n\tsockaddr_in from = { 0 };\n\tsocklen_t len = sizeof(sockaddr_in);\n\tSOCKET s2 = ::accept(s, (sockaddr*) & from, &len);\n\n\tSocket* link = new Socket(s2);\n\tif (service) {\n\t\tstd::string address(inet_ntoa(from.sin_addr));\n\t\tservice->onConnect(link, address);\n\t}\n\n\treturn 0;\n}\n\nint Socket::receive(char *buffer,int count){\n\tint result = ::recv(fd, buffer, count, 0);\n\tstd::cout << \"::recv \" << result << std::endl;\n\treturn result;\n}\n\nint Socket::send(const char *buffer,int count){\t\n\n\tint result = ::send(fd,buffer,count,0);\n\n\tif (result == SOCKET_ERROR) {\n\t\tprintf(\"send failed with error: %d\\n\", WSAGetLastError());\n\t\tclose();\n\t\treturn -1;\n\t}\n\n\tprintf(\"Bytes Sent: %ld\\n\", result);\n\treturn result;\n}\n\n\t\nvoid Socket::close(){\n\tclosesocket(fd);\n\tfd = 0;\n}\n\n#else\n\n#include <sys/types.h>\n#include <sys/socket.h>\n//#include <sys/unistd.h>\n#include <unistd.h>\n#include <netinet/in.h>\n#include <netdb.h>\n#include <errno.h>\n#include <sys/ioctl.h>\n#include <sys/uio.h>\n\nvoid initSystem(){\n\t\n}\n\n// on nonzero result input prints string version of errno\n\nbool posixError(int result){\n\tif(result==0) return false;\n\tresult=errno;\n\tconst char *err=strerror(errno);\n\tprintf(\"Socket::posix_error(%d) %s\\n\",errno,err);\n\treturn true;\n}\n\nfloat peekf(void *p){\n\t// convert from big-endian (network btye order)\n\tconst uint32_t i = ntohl(*((uint32_t *) p));\n\treturn *((float *) (&i));\n}\n\n\n// thanks to http://www.microhowto.info/howto/listen_for_and_receive_udp_datagrams_in_c.html\n\nint Socket::testOSCIn(){\n\tconst char *host=0;\n\tconst char *port=\"7000\";\n\n\taddrinfo hints={0};\n\thints.ai_family=AF_UNSPEC;\n\thints.ai_socktype=SOCK_DGRAM;\n\thints.ai_protocol=0;\n\thints.ai_flags=AI_PASSIVE|AI_ADDRCONFIG;\n\n\taddrinfo* res=0;\n\tint err=getaddrinfo(host,port,&hints,&res);\n\tif (err!=0) {\n\t\tprintf(\"failed to resolve local socket address (err=%d)\\n\",err);\n\t\treturn -1;\n\t}\n\n\n\tint fd=socket(res->ai_family,res->ai_socktype,res->ai_protocol);\n\tif (fd==-1) {\n\t\tprintf(\"%s\\n\",strerror(errno));\n\t\treturn -2;\n\t}\n\t\n\tif (bind(fd,res->ai_addr,res->ai_addrlen)==-1) {\n\t\tprintf(\"%s\\n\",strerror(errno));\n\t\treturn -3;\n\t}\n\t\n\tfreeaddrinfo(res);\n\n\tchar buffer[549];\n\t\n\tstruct sockaddr_storage src_addr;\n\tsocklen_t src_addr_len=sizeof(src_addr);\n\n\twhile(true){\n\t\tssize_t count=recvfrom(fd,buffer,sizeof(buffer),0,(struct sockaddr*)&src_addr,&src_addr_len);\n\t\tif (count==-1) {\n\t\t\tprintf(\"%s\\n\",strerror(errno));\n\t\t} else if (count==sizeof(buffer)) {\n\t\t\tprintf(\"datagram too large for buffer: truncated\\n\");\n\t\t} else {\n\t\t\tprocessOSC(buffer,count);\n\t\t}\n\t}\n\n}\n\nint Socket::testOSCOut(){\n\n\tconst char *host=\"192.168.1.255\";\n//\tconst char *host=\"192.168.1.114\";\n\tconst char *port=\"7000\";\n\t\n//\tchar content[32];\n\t\n\tchar content[]={\"/1/rotary1\\0\\0,f\\0\\0\\0\\0\\0\\0\"};\n\t\n\taddrinfo hints={0};\n\thints.ai_family=AF_UNSPEC;\n\thints.ai_socktype=SOCK_DGRAM;\n\thints.ai_protocol=0;\n\thints.ai_flags=AI_ADDRCONFIG;\n\t\n\taddrinfo* res=0;\n\tint err=getaddrinfo(host,port,&hints,&res);\n\tif (err!=0) {\n\t\tprintf(\"failed to resolve remote socket address (err=%d)\\n\",err);\n\t\treturn -1;\n\t}\n\t\n\tint fd=socket(res->ai_family,res->ai_socktype,res->ai_protocol);\n\tif (fd==-1) {\n\t\tprintf(\"%s\\n\",strerror(errno));\n\t\treturn -2;\n\t}\n\t\n\t\n\tint broadcast=1;\n\tif (setsockopt(fd,SOL_SOCKET,SO_BROADCAST, &broadcast,sizeof(broadcast))==-1) {\n\t\tprintf(\"%s\\n\",strerror(errno));\n\t\treturn -3;\n\t}\n\t\n\t\n\tif (sendto(fd,content,sizeof(content),0, res->ai_addr,res->ai_addrlen)==-1) {\n\t\tprintf(\"%s\\n\",strerror(errno));\n\t\treturn -3;\n\t}\n\n\treturn 0;\n}\n\n\nSocket* Socket::connect(const char *host,int port){\n\n\tint result;\n\n\tint domain=AF_INET;\n\tint type=SOCK_STREAM;\n\tint protocol=0;\n\n\tint fd = socket(domain, type, protocol);\t\n\tprintf(\"Socket::socket fd=%d\\n\",fd);\n\n\thostent *server = gethostbyname(host);\n\tif (server == NULL) {\n\t\tprintf(\"Socket::ERROR, no such host\\n\");\n\t\treturn 0;\n\t}\n\t\n\tunsigned char *ip32=(unsigned char *)server->h_addr;\t\n\tprintf(\"gethostbyname %d.%d.%d.%d len=%d\\n\",\n\t\tip32[0],ip32[1],ip32[2],ip32[3], \n\t\tserver->h_length);\n\tfflush(stdout);\n\n\tsockaddr_in address={0};\n\taddress.sin_family=AF_INET;\n\taddress.sin_port=htons(port);\n\tmemcpy( &address.sin_addr.s_addr, ip32, server->h_length);\n\nprintf(\"connecting..\\n\");\n\tfflush(stdout);\n\n\tresult=::connect(fd,(sockaddr *)&address,sizeof(sockaddr_in));\n\nprintf(\"connected result=%d\\n\",result);\n\tfflush(stdout);\n\n\tif (posixError(result)) return 0;\n\n\tprintf(\"Socket::socket connected\\n\");\t\t\n\treturn new Socket(fd);\n}\n\nSocket *Socket::open(int port, int flags){\n\tint domain=AF_INET;\n\tint type=SOCK_STREAM;\n\tint protocol=0;\n\tint fd = socket(domain, type, protocol);\t\n\tprintf(\"Socket::socket fd=%d\\n\",fd);\n\tif(fd<0){\n\t\treturn 0;\n\t}\n\tint reuse=1;\n\tint setoptResult=setsockopt(fd,SOL_SOCKET,SO_REUSEADDR,&reuse,sizeof(reuse));\n\tsockaddr_in address={0};\n\taddress.sin_family = AF_INET;\n\taddress.sin_addr.s_addr = htonl(INADDR_ANY);\n\taddress.sin_port = htons(port);\n\t// todo: make safe array access\n\tint result = bind(fd,(sockaddr *)&address,sizeof(sockaddr_in));\n\tif (posixError(result)) return 0;\n\treturn new Socket(fd);\n}\n\n#include <arpa/inet.h>\n\nint Socket::accept() {\n\tstd::cout << \"accept not supported - please use serve connection api\" << std::endl;\n\treturn 0;\n}\n\n\nvoid Socket::listen(int port, int flags, void* user){\n\tstd::cout << \"listen not supported - please use serve connection api\" << std::endl;\n}\n\n// listen and serve new connections from service\n\nint Socket::serve(Connection *service)\n{\n\tint backlog=32;\n\tint result=::listen(fd,backlog);\n\tif (posixError(result)) return 0;\n\t\n\tbool listening=true;\n\n\twhile(listening){\n\n\t\tprintf(\"Socket::listening...\\n\");\n\n\t\tsockaddr_in from={0};\n\t\tsocklen_t len=sizeof(sockaddr_in);\n\t\n\t\tint fd2;\n\t\tfd2 = ::accept(fd,(sockaddr *) &from,&len);\n\n\t\tif(fd2<0){\n\t\t\tprintf(\"Socket::accept fd2=%d\\n\",fd2);\n\t\t\tlistening=false;\n\t\t\tcontinue;\n\t\t}\n\n\t\tSocket *link=new Socket(fd2);\n\t\tif(service){\n\t\t\tstd::string address(inet_ntoa(from.sin_addr));\n\t\t\tservice->onConnect(link,address);\n\t\t}\n\t}\n\treturn 0;\n}\n\nSocket::Socket(int64_t descriptor){\n\tfd=descriptor;\n// make non blocking\n//\tint iMode=1;\n//\tioctl(fd, FIONBIO, &iMode);\t\t\n}\n\nSocket::~Socket(){\n\tif(fd){\n\t\tclose();\n\t}\n}\n\nint Socket::receive(char *buffer,int count){\n\tssize_t result = ::recv(fd, buffer, count, 0);\t//MSG_DONTWAIT\n\tstd::cout << \"::recv \" << result << std::endl;\n\treturn (int)result;\n}\n\nint Socket::send(const char *buffer,int count){\n\tsize_t result = ::send(fd, buffer, count, 0);\t\n\treturn (int)result;\n}\n\t\nvoid Socket::close(){\n\t::close(fd);\n\tfd=0;\n}\n\n#endif\n\n\n\n#ifdef WIN32\n\n\n\n#include <winhttp.h>\n\n#include <codecvt>\n#include <locale>\n#include <utility>\n#include <fstream>\n#include <iomanip>\n\n\n// utility wrapper to adapt locale-bound facets for wstring/wbuffer convert\ntemplate<class Facet>\nstruct deletable_facet : Facet\n{\n\ttemplate<class ...Args>\n\tdeletable_facet(Args&& ...args) : Facet(std::forward<Args>(args)...) {}\n\t~deletable_facet() {}\n};\n\nstd::wstring_convert<deletable_facet<std::codecvt<wchar_t, char, std::mbstate_t>>, wchar_t> conv16;\n\nstd::wstring WideFromUtf8(const char *data) {\n\tstd::wstring result;\n\tstd::wstring wstr = conv16.from_bytes(data);\n\treturn wstr;\n}\n\nconst int BufferSize = 8192 * 1024;\nchar pszOutBuffer[8192 * 1024];\n\nvoid pingHost(const char* _userAgent, const char* _hostName, int hostPort) {\n\n\tDWORD flags = WINHTTP_FLAG_ESCAPE_PERCENT;\n\tDWORD dwSize = 0;\n\tDWORD dwDownloaded = 0;\n\tBOOL  bResults = FALSE;\n\tHINTERNET  hSession = NULL,\n\t\thConnect = NULL,\n\t\thRequest = NULL;\n\n\tconst std::wstring userAgent = WideFromUtf8(_userAgent);\n\tconst std::wstring hostName = WideFromUtf8(_hostName);\n//\tconst wchar_t* hostName\n\n\n\t// Use WinHttpOpen to obtain a session handle.\n//\thSession = WinHttpOpen(L\"WinHTTP pingHost/1.0\",WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,WINHTTP_NO_PROXY_NAME,WINHTTP_NO_PROXY_BYPASS, 0);\n\n\thSession = WinHttpOpen(userAgent.c_str(), WINHTTP_ACCESS_TYPE_NO_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);\n\n\t// Specify an HTTP server.\n\tif (hSession)\n\t\thConnect = WinHttpConnect(hSession, hostName.c_str(), hostPort, 0);\n\n\tconst wchar_t* accept[] = { L\"application/json\",0 };//\tWINHTTP_DEFAULT_ACCEPT_TYPES;\n\t// Create an HTTP request handle.\n\tif (hConnect)\n\t\thRequest = WinHttpOpenRequest(hConnect, L\"GET\", NULL, NULL, WINHTTP_NO_REFERER, accept, flags);\n\n\t// Send a request.\n\tif (hRequest)\n\t\tbResults = WinHttpSendRequest(hRequest,\n\t\t\tWINHTTP_NO_ADDITIONAL_HEADERS, 0,\n\t\t\tWINHTTP_NO_REQUEST_DATA, 0,\n\t\t\t0, 0);\n\n\n\t// End the request.\n\tif (bResults)\n\t\tbResults = WinHttpReceiveResponse(hRequest, NULL);\n\n\t// Keep checking for data until there is nothing left.\n\n\tif (bResults)\n\t{\n\t\tdo\n\t\t{\n\t\t\tdwSize = 0;\n\t\t\tBOOL ok = WinHttpQueryDataAvailable(hRequest, &dwSize);\n\t\t\tif (ok) {\n\t\t\t\tDWORD size = dwSize < BufferSize ? dwSize : BufferSize - 1;\n\t\t\t\tok = WinHttpReadData(hRequest, (LPVOID)pszOutBuffer, size, &dwDownloaded);\n\t\t\t\tif (ok) {\n\t\t\t\t\tpszOutBuffer[size] = 0;\n\t\t\t\t\tstd::cout << pszOutBuffer << std::endl;\n\t\t\t\t}\n\t\t\t\telse {\n\t\t\t\t\tstd::cout << \"WinHttpReadData error \" << GetLastError() << std::endl;\n\t\t\t\t}\n\t\t\t}\n\t\t\telse {\n\t\t\t\tstd::cout << \"WinHttpQueryDataAvailable error \" << GetLastError() << std::endl;\n\t\t\t}\n\t\t} while (dwSize > 0);\n\t}\n\t// Report any errors.\n\tif (!bResults)\n\t\tstd::cout << \"WinHttpReceiveResponse error \" << GetLastError() << std::endl;\n\n\t// Close any open handles.\n\tif (hRequest) WinHttpCloseHandle(hRequest);\n\tif (hConnect) WinHttpCloseHandle(hConnect);\n\tif (hSession) WinHttpCloseHandle(hSession);\n}\n\n#else\n\n#ifndef HAVE_CURL\n\nvoid pingHost(const char* userAgent, const char* hostName, int hostPort) {\n}\n\n#else\n\n#include <curl/curl.h>\n\nvoid pingHost(const char* userAgent, const char* hostName, int hostPort) {\n\n  CURL *curl;\n  CURLcode res;\n \n  curl = curl_easy_init();\n  if(curl) {\n    curl_easy_setopt(curl, CURLOPT_URL, hostName);\n    /* example.com is redirected, so we tell libcurl to follow redirection */\n    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);\n \n    /* Perform the request, res will get the return code */\n    res = curl_easy_perform(curl);\n    /* Check for errors */\n    if(res != CURLE_OK)\n      fprintf(stderr, \"curl_easy_perform() failed: %s\\n\",\n              curl_easy_strerror(res));\n \n    /* always cleanup */\n    curl_easy_cleanup(curl);\n  }\n}\n#endif\n\n#endif\n\nstruct SocketConnection :Device {\n\n\tSocket* _socket;\n\tstd::string _address;\n\n\tSocketConnection(std::string address, Socket* socket) {\n\t\t_socket = socket;\n\t\t_address = address;\n\t\tOpenDevice(\"http:\");\n\t}\n\n\tvirtual void CloseDevice() {\n\n\t}\n\tvirtual void onRead(Bytes payload) {\n\n\t}\n\tvirtual size_t readBytes(void* buffer, size_t length) {\n\t\tint result = _socket->receive((char*)buffer, length);\n\t\treturn (size_t)result;\n\t}\n\tvirtual size_t writeBytes(const void* buffer, size_t length) {\n\t\treturn 0;\n\t}\n\n};\n\nDevice* openSocket(std::string from, Socket* s) {\n\treturn new SocketConnection(from, s);\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/robots.txt\",\"length\":25,\"type\":\"text/plain\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"User-agent: *\r\nAllow: /\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dsptool.md\",\"length\":8719,\"type\":\"text/markdown\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"# MicroBit DSP\n\nDiagnostics lab software stack (c) 2026 nitrologic.\n\n# Table of Contents\n\n- [Tool Overview](#dsp-tool)\n- [Event System](#event-system)\n- [Global Values](#global-values)\n- [Global Functions](#global-functions)\n- [DSP Components](#dsp-components)\n  - [1. sensor](#1-sensor)\n  - [2. log](#2-log)\n  - [3. meter](#3-meter)\n  - [4. keys](#4-keys)\n  - [5. synth](#5-synth)\n  - [6. system](#6-system)\n  - [7. display](#7-display)\n  - [8. floor](#8-floor)\n  - [9. gamepad](#9-gamepad)\n  - [10. acid32](#10-acid32)\n  - [11. files](#11-files)\n  - [12. pico](#12-pico)\n  - [13. lights](#13-lights)\n  - [14. serial](#14-serial)\n  - [15. navigator](#15-navigator)\n\n# DSP Tool\n\nA work in progress stack of diagnostics lab instruments, connections and controls.\n\n# event system\n\nLocalEventHandler - for client-side worker-to-main communication\nRemoteEventHandler - for server-client events via RPC\nsessionHandler - for bidirectional session events\n\n\n## Global Values\n\n- WatchDog: Array for performance monitoring timestamps.\n- pageStatus, pageBody, pageTools: DOM elements for status, body, and tools.\n- rpcCount: Counter for RPC requests.\n- SysSession, SysTick: Session ID and tick counter for polling.\n- Permissions: Array of required browser permissions (e.g., camera, microphone).\n- AppVersion, AppBanner, AppAbout: Version info and messages.\n- LocalEventQueue, LocalEventHandlers: Queues and handlers for client-side events.\n- RemoteEventHandlers, messageHandlers: Handlers for server-client and session events.\n- nightDayStyles: Theme options (day/night).\n\n## Global Functions\n\n- sendRPC(uri, method, params, handler, data): Sends JSON-RPC requests to the server.\n- onRPCLoad(e): Handles RPC responses, parses JSON, and calls handlers.\n- log(line): Appends messages to the log textarea.\n- shorten(number): Formats large numbers (e.g., 1000 → 1K).\n- onSysInfo(sysInfo): Processes system info from server, updates UI.\n- sessionHandler(type, handler): Registers handlers for session events.\n- LocalEventHandler(src, handler): Registers handlers for local events.\n- RemoteEventHandler(src, handler): Registers handlers for remote events.\n- refreshSession(): Refreshes system info and starts polling.\n- EnablePolling(enable): Toggles session polling on/off.\n- onTick(tick): Processes server ticks and events.\n- initLog(), initUnits(): Initialize logging and all units.\n\n## DSP Components\n\n1. sensor\n• Summary:* Handles device sensors (e.g., accelerometer, gyroscope) and geolocation.\nDetects permissions and streams sensor data for real-time tracking.\n\n• Globals:* Sensors, RawUpdatePeriod, SecureSensors, DetectSensor, RunSensor,\nPostSensorEvent.\n\n• Sturdiness:* Solid integration with Web APIs; permissions handling is reliable, but\nsensor availability varies by device—tested on modern browsers.\n\n2. log\n• Summary:* Central logging interface with tools for clearing, refreshing, and toggling\nonline status. Displays system and user messages.\n\n• Globals:* logDiv, logTools, logClear, logRefresh, logOnline, logFactoryReset, logText,\nlogVars, logVals, logVarBar, clearLog, logVar, logVal.\n\n• Sturdiness:* Robust event logging; handles high volumes well, with filtering for\nperformance. Well-tested in event-heavy scenarios.\n\n3. meter\n• Summary:* Audio metering and FFT analysis. Connects to microphones, visualizes\nwaveforms/spectra, and supports recording.\n\n• Globals:* meterDiv, meterTools, meterSource, meterConstraints, meterMeter, meterOn,\nstereoNode, stereoContext, meterAnimationId, stereoTime, meterDisplay, analyseClear,\nanalyseSnapshot, onMeterSource.\n\n• Sturdiness:* Strong Web Audio API integration; FFT processing is efficient, but real-time\nperformance depends on hardware—stable under normal use.\n\n4. keys\n• Summary:* Virtual keyboard for MIDI input. Maps keys to notes, supports polyphony, and\nintegrates with synth.\n\n• Globals:* keysPanel, keysApp, keysFrameCount, keysBoxed, keysTransmit, keysMidiHandler,\nkeysSynthHandler, onKeysPanel, onKeysTool, redrawKeys, MidiKeys, MidiNotes, MidiCodes.\n\n• Sturdiness:* Reliable MIDI handling; touch and keyboard events are well-managed, but\ntouch accuracy varies on devices—extensively tested.\n\n5. synth\n• Summary:* VSynth synthesizer with controls for voices, arpeggiation, tempo, and effects.\nSupports MIDI and audio worklets.\n\n• Globals:* soundContext, soundTransmit, soundClick, soundRecording, soundPlaying,\nsoundClipCount, soundClips, synthLocal, synthLocalArray, effectState, holdState, onSoundSynth,\nsendSoundProcessors, beep, onSoundBend.\n\n• Sturdiness:* Core audio engine is stable; worklet integration is robust, but latency can\nvary—thoroughly debugged for real-time performance.\n\n6. system\n• Summary:* System info, commands, and utilities (e.g., reboot, say text). Interfaces with\nhost OS via RPC.\n\n• Globals:* sysDiv, sysUpgrade, sysInfos, sysTools, sysSpeak, sysScan, sysScanTop,\nsysPorts, sysIns, sysOuts, sysPCAP, onSysInfo, sendRPC, onRPCLoad, refreshSession, pollSession,\npumpSession.\n\n• Sturdiness:* Dependable RPC communication; system calls are secure, but host-specific\nfeatures may vary—tested across platforms.\n\n7. display\n• Summary:* Canvas-based graphics display for shapes, text, and interactive controls (e.g.,\ngamepad emulation).\n\n• Globals:* displayDiv, displayTools, displayCanvas, displayDevices, displayFrameCount,\ndisplayApp, drawFloor, onDisplayPanel, onDisplayTool, redrawDisplay.\n\n• Sturdiness:* WebGL/Canvas rendering is efficient; event handling is solid, but\nperformance scales with complexity—well-optimized.\n\n8. floor\n• Summary:* Interactive floor/grid for touch-based controls, likely for spatial input.\n\n• Globals:* floorDiv, floorTools, floorApp, floorPanel, floorBoxed, onFloorPanel,\nonFloorTool, redrawFloor, drawFloor.\n\n• Sturdiness:* Basic touch interaction works; simple design makes it reliable, though less\ntested—stable for basic use.\n\n9. gamepad\n• Summary:* Gamepad/controller detection and input mapping. Polls devices and sends HID\nevents.\n\n• Globals:* gamepadDiv, gamepadTools, gamepadTable, gamepadDevices, gamepadRows, GamePads,\nRawUpdateDelay, PostHIDEvent, PollControllers, UpdateControllers, onGamepadConnect,\nonGamepadDisconnect.\n\n• Sturdiness:* Strong WebHID integration; handles multiple controllers well, but browser\nsupport is emerging—reliable in supported environments.\n\n10. acid32\n• Summary:* Terminal emulator for serial communication (e.g., with Acid32 devices).\nSends/receives text over UART.\n\n• Globals:* acid32Div, acid32Tools, acidDeviceHandles, acidDevices, terminalKeys,\nterminalDevices, terminalTextAreas, writeText, clearText, sendAcid32, receiveAcid32.\n\n• Sturdiness:* UART handling is functional; session-based communication is robust, but\ndevice-specific—tested for basic I/O.\n\n11. files\n• Summary:* File management interface. Supports drag-and-drop for MIDI files and basic\noperations.\n\n• Globals:* filesDiv, fileTools, fileHome, receiveFile, onDropFile.\n\n• Sturdiness:* Simple file handling; drag-and-drop works, but limited features—adequate for\ncore use.\n\n12. pico\n• Summary:* Interface for Raspberry Pi Pico devices. Discovers and communicates via serial.\n\n• Globals:* picoDiv, picoTools, picoDeviceList, picoPorts, picoPaths, picoTable,\npicoDevices, picoRows, discoverPicos, connectPico, disconnectPico, receivePico.\n\n• Sturdiness:* Serial communication is reliable; discovery and I/O are solid, but\nPico-specific—tested with known devices.\n\n13. lights\n• Summary:* UART-based light control (e.g., RGB LED strips). Sends commands to connected\ndevices.\n\n• Globals:* uartDiv, uartTools, uartPorts, uartConnections, uartMessage, SerialPorts,\nConnectedPorts, openUART, sendUART, receiveUART, closeUART.\n\n• Sturdiness:* Command transmission works; protocol is simple and effective, but\nhardware-dependent—functional in setups.\n\n14. serial\n• Summary:* General serial port management. Lists, opens, and communicates with USB/serial\ndevices.\n\n• Globals:* uartDiv, uartTools, uartPorts, uartConnections, uartMessage, SerialPorts,\nConnectedPorts, openUART, sendUART, receiveUART, closeUART, refreshPorts, onPorts.\n\n• Sturdiness:* Web Serial API integration is strong; port handling is reliable, but\nrequires user permissions—well-implemented.\n\n15. navigator\n• Summary:* Media device enumeration (cameras, mics). Streams audio/video and handles\npermissions.\n\n• Globals:* navigatorDiv, MediaStreams, SerialPorts, audioSource, audioNode, scriptNode,\nworkletNode, microphone, streamMedia, monitorAudio, enumerateMediaDevices, onEnumerateMedia.\n\n• Sturdiness:* GetUserMedia API is dependable; device discovery is robust, but permissions\ncan fail—thoroughly tested.\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspdesktop.html\",\"length\":3222,\"type\":\"text/html\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n\n<meta charset=\"UTF-8\">\n<meta name=\"google\" content=\"notranslate\" />\n<meta name=\"application-name\" content=\"DSP Device\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=yes\">\n<meta name=\"theme-color\" content=\"#FF0000\">\n\n<link rel=\"stylesheet\" href=\"dsptool.css\" />\n<link rel=\"stylesheet\" href=\"wirepage.css\" />\n\n<script src=\"nitrojs/nitro-wire.js\"></script>\n<script src=\"nitrojs/spec-vsynth.js\"></script>\n<script src=\"nitrojs/nitro-vsynth.js\"></script>\n\n<script src=\"nitrojs/nitrogui.js\"></script>\n<script src=\"nitrojs/nitrolsystem.js\"></script>\n<script src=\"nitrojs/nitrovectorfont.js\"></script>\n<script src=\"nitrojs/nitroshape.js\"></script>\n<script src=\"nitrojs/nitromarkup.js\"></script>\n<script src=\"nitrojs/nitrostorage.js\"></script>\n\n<script src=\"dspjs/dspsensors.js\"></script>\n<script src=\"dspjs/dspcontrollers.js\"></script>\n<script src=\"dspjs/dsppico.js\"></script>\n<script src=\"dspjs/dspvideo.js\"></script>\n<script src=\"dspjs/dspgraph.js\"></script>\n<script src=\"dspjs/dspkernel.js\"></script>\n<script src=\"dspjs/dspwav.js\"></script>\n\n<script src=\"dspjs/dspscope.js\"></script>\n<script src=\"dspjs/dsptool.js\"></script>\n\n<script src=\"dspjs/dspwiki.js\"></script>\n<script src=\"dspjs/dspextern.js\"></script>\n<script src=\"dspjs/dspnavigator.js\"></script>\n<script src=\"dspjs/dspmeter.js\"></script>\n<script src=\"dspjs/dspacid32.js\"></script>\n<script src=\"dspjs/dspsystem.js\"></script>\n<script src=\"dspjs/dspapp.js\"></script>\n<script src=\"dspjs/dspmidi.js\"></script>\n<script src=\"dspjs/dspmidifile.js\"></script>\n<script src=\"dspjs/dspmatrix.js\"></script>\n<script src=\"dspjs/dspscribe.js\"></script>\n<script src=\"dspjs/dspdisplay.js\"></script>\n<script src=\"dspjs/dspkeys.js\"></script>\n<script src=\"dspjs/dspfloor.js\"></script>\n<script src=\"dspjs/dspnodes.js\"></script>\n\n<script src=\"wirejs/wire_util.js\"></script>\n<script src=\"wirejs/wire_grid.js\"></script>\n<script src=\"wirejs/wire_core.js\"></script>\n<script src=\"wirejs/wire_display.js\"></script>\n<script src=\"wirejs/wire_drawsurface.js\"></script>\n<script src=\"wirejs/wire_field.js\"></script>\n<script src=\"wirejs/wire_geometry.js\"></script>\n<script src=\"wirejs/wire_graphics.js\"></script>\n<script src=\"wirejs/wire_immersion.js\"></script>\n<script src=\"wirejs/wire_model.js\"></script>\n<script src=\"wirejs/wire_surface.js\"></script>\n<script src=\"wirejs/wire_system.js\"></script>\n<script src=\"wirejs/wire_topo.js\"></script>\n<title>🦉DSP Desktop</title>\n</head>\n<body palette:night>\n<div banner id=\"banner\">\n<div statusbar id=\"status\"></div>\n<a href=\"https://github.com/nitrologic\" target=\"_blank\" rel=\"noopener\">\n<img avatar alt=\"nitrologic\" width=\"88px\" src=\"https://avatars.githubusercontent.com/u/3953439\"/></a>\n<div>\n<a href=\"dspdevice.html\">🎙️Device</a>\n<a href=\"dspstudio.html\">🎧Studio</a>\n<a href=\"https://github.com/nitrologic/relay\">⛲Relay</a>\n<a href=\"dspmap.html\">🗺️Map</a>\n<a href=\"dsptool.html\">🏝️Sandbox</a>\n<a href=\"dsplab.html\">🛰️Lab</a>\n</div>\n<span hidden tools id=\"tools\"></span>\n</div>\n<div section id=\"meter\"></div>\n<div section id=\"video\"></div>\n<div section id=\"log\"></div>\n<div section id=\"system\"></div>\n<div section id=\"scope\"></div>\n</body>\n</html>\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/sitemap.xml\",\"length\":459,\"type\":\"application/xml\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"","name":"image"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dsp.css\",\"length\":11594,\"type\":\"text/css\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"/*\r\n//\tdsp.css (c) nitrologic 2026 all rights reserved\r\n*/\r\n\r\n@media print {div {break-inside: avoid;}}\r\n\r\nbody{\r\n\t--renderBackground:#222;\r\n\tfont-family: charter, sans-serif;\r\n}\r\n\r\nspan.title{\r\n\tfont-family: Calibri, sans-serif;\r\n\tfont-size:2.5em;\r\n\tuser-select:text;\r\n}\r\n\r\ndiv[constructionbar]{\r\n\tbackground-color:#426;\r\n\tfont-weight: 500;\r\n\tfont-size:large;\r\n\tmargin:28px;\r\n\tborder:20px;\r\n\tborder-style:groove;\r\n\tborder-color:orangered;\r\n}\r\n\r\nimg[mirror]{\r\n\ttransform: scale(-0.91,0.8);\r\n}\r\nimg[avatar]{\r\n\tborder-radius: 50%;\r\n}\r\n\r\nspan.dspbutton{\r\n\tdisplay:inline-block;\r\n\tvertical-align:top;\r\n}\r\n\r\nbutton{\r\n\tmargin:8px;\r\n\tpadding:8px;\r\n\tborder-style:ridge;\r\n\tborder-radius: 6px;\t\r\n\tbackground-color:var(--inputBackground);\r\n\tcolor:var(--inputColor);\r\n\tuser-select: none;\r\n\tfont-weight:500;\r\n}\r\nbutton[inline]{\r\n\tmargin:1px;\r\n\tpadding:2px;\r\n}\r\nbutton:active{\r\n\tbackground:var(--activeBackground);\r\n}\r\n.button:focus {\r\n\tbackground-color: #3e8e41;\r\n}\r\nbutton[on]{\r\n\tbackground-color:var(--inputOn);\t\r\n\tfont-weight: bold;\r\n}\r\n\r\nbutton.favourite{\r\n\tpadding: 0px;\r\n\tmargin: 4px;\r\n\tborder: none;\r\n\tbackground: none;\t\r\n\tcolor:white;\r\n}\r\n\r\nbutton.favourite:before{\r\n\tcontent:\"☆\";\r\n}\r\n\r\nbutton.favourite[favourite]:before{\r\n\tcontent:\"🟊\";\r\n}\r\n\r\n\r\ninput{\r\n\tfont-family:inherit;\r\n}\r\nbody[palette=night] {\r\n\tcolor:#aaa; \r\n    background-color: #222;\r\n\t--contentBackground:#222;\r\n\t--panelBackground:#555;\r\n\t--panelGrid:#777;\r\n\t--groupBackground:#333;\r\n\t--inputColor:#ddd;\r\n\t--inputBackground:#444;\r\n\t--inputOn:#4a4;\r\n\t--activeBackground:#aa6;\r\n\t--readonlyColor:#eee;\r\n\t--readonlyBackground:#343;\r\n\t--borderColor:#585;\r\n\t--editorColor:#aac;\r\n\t--editorBackground:#225;\r\n\t--selectColor:#5aa;\r\n\t--selectBackground:#022;\r\n\t--alink:#888;\r\n\t--avisited:#999;\r\n\t--ahover:#aaa;\r\n\t--aactive:#bbb;\r\n\t--namedfieldBackground:#347;\r\n}\r\n\r\nbody[palette=day] {\r\n\tcolor:#686; \r\n    background-color: #ffe;\r\n\t--contentBackground:#eee;\r\n\t--panelBackground:#bbb;\r\n\t--panelGrid:#ddd;\r\n\t--groupBackground:#ddd;\r\n\t--inputColor:#222;\r\n\t--inputBackground:#bba;\r\n\t--inputOn:#8e8;\r\n\t--activeBackground:#88e;\r\n\t--readonlyColor:#833;\r\n\t--readonlyBackground:#eee;\r\n\t--borderColor:#220;\r\n\t--editorColor:#225;\r\n\t--editorBackground:#aad;\r\n\t--selectColor:#220;\r\n\t--selectBackground:#cdd;\r\n\t--alink:#888;\r\n\t--avisited:#777;\r\n\t--ahover:#666;\r\n\t--aactive:#555;\r\n\t--namedfieldBackground:#def;\r\n}\r\n\r\ndiv[statusbar]{\r\n\tdisplay: inline-block;\r\n\tmin-width: 200px;\r\n\tfont-weight: 500;\r\n}\r\n\r\na:link {color:var(--alink);}\r\na:visited {color:var(--avisited);}\r\na:hover {color:var(--ahover);}\r\na:active {color:var(--aactive);}\r\n\r\ndiv.wiregrid{\r\n\tbackground:var(--bg);\r\n\twhite-space: nowrap;\r\n\toverflow:hidden;\r\n\tposition:relative;\r\n\twidth:100%;\r\n\theight:100%;\r\n}\r\n\r\ndiv.wire{\r\n\theight:240px;\r\n}\r\n\r\ndiv.dspdisplay{\r\n\tbackground-color:#222;\r\n\toverflow-y:auto;\r\n\toverflow-x:hidden;\r\n\twidth:100%;\r\n}\r\ndiv.dspsplit{\r\n\twidth:12px;\r\n\theight:120px;\r\n\tdisplay:inline-block;\r\n\tcursor:col-resize;\r\n}\r\ncanvas.thindsppanel{\r\n\twidth:240px;\r\n\theight:150px;\r\n\tbackground-color:#ddc;\r\n}\r\ncanvas.dsppanel{\r\n\twidth:120px;\r\n\theight:100px;\r\n\tbackground-color:#dda;\r\n}\r\n\r\ncanvas.dspsteps{\r\n\tborder:8px;\r\n\tbackground-color:#8a8;\r\n\twidth:100%;\r\n\theight:420px;\r\n}\r\n\r\ncanvas.dspfloor{\r\n\tborder:8px;\r\n\tbackground-color:#8a8;\r\n\twidth:100%;\r\n\theight:420px;\r\n}\r\n\r\ncanvas.dspkeys{\r\n\tborder:8px;\r\n\tbackground-color:#dda;\r\n\twidth:100%;\r\n\theight:120px;\r\n}\r\ncanvas.dspcanvas{\r\n\tbackground-color: #191124;\r\n\twidth:100%;\r\n\theight:520px;\r\n}\r\ncanvas.audio{\r\n\twidth:100%;\r\n\theight:14vh;\r\n}\r\ncanvas.scope{\r\n\twidth:100%;\r\n\theight:20vh;\r\n}\r\n\r\nembed.dspembed{\r\n\twidth:100%;\r\n\theight:600px;\r\n}\r\n\r\ntextarea.wasmterminal{\r\n    width: 34em;\r\n    height: 20em;\r\n\tbackground-color:var(--editorBackground);\r\n\tcolor:var(--editorColor);\r\n\tline-height:1.24;\r\n\tfont-size:medium;\r\n}\r\n\r\ntextarea.systemterminal{\r\n\tbackground-color:var(--editorBackground);\r\n\tcolor:var(--editorColor);\r\n\tline-height:1.24;\r\n\tfont-size:medium;\r\n}\r\ndiv.dspsystem{\r\n\tbackground-colo