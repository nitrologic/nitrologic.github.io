=SpecLabels(spec.algorithms);\r\nconst ProgNames=SpecLabels(spec.progressions)\r\n\r\n// reorder for dial \r\nconst PowerValues={\"Unity (x)\":1,\"Cube (x^3)\":3,\"Quin (x^5)\":5,\"Safe Root (√x)\":0.5,\"Cube Root (∛x)\":1.0/3};\r\n\r\nfunction editPatch(){\r\n\tlet key=soundPatchEdit.value;\r\n\tlet patch=GetStorageItem(key);\r\n\r\n\tsoundName.value=patch.name;\r\n\r\n\tsoundVoice.value=\"+\"+patch.voice.oscillator;\r\n\tsoundPower.value=\"+\"+patch.voice.power.toFixed(4);\r\n\tsoundMode.value=\"+\"+patch.voice.mode;\r\n\t\r\n\tsoundAlgorithm.value=\"+\"+patch.arp.algo;\r\n\tsoundProgression.value=\"+\"+patch.arp.prog;\r\n\r\n\tsoundDivisor.value=\"+\"+patch.beat.div;\r\n\tsoundDuty.value=\"+\"+indexOfDuty(patch.beat.duty);\r\n\tsoundRepeat.value=\"+\"+patch.beat.reps;\r\n\r\n\tif(patch.matrix) soundMatrix.load(patch.matrix);\r\n\r\n\tonSoundVoice();\r\n\tonSoundArp();\r\n\tonSoundBeat();\r\n}\r\n\r\n\r\n// handlers are verb noun\r\nfunction savePatch(){\r\n\tlet key=soundPatchEdit.value;\r\n\r\n\tvar bpm=2*(soundTempo.value|0);\r\n\tvar name=soundName.value;\r\n\r\n\tvar oscillator=soundVoice.value|0;\r\n\tvar power=Number(soundPower.value);\r\n\tvar mode=(soundMode.value|0);\r\n\r\n\tvar algo=(soundAlgorithm.value|0);\r\n\tvar prog=(soundProgression.value|0);\r\n\r\n\tvar div=soundDivisor.value|0;\r\n\tvar duty=DutyCycle[soundDuty.value|0];\r\n\tvar reps=soundRepeat.value|0;\r\n\r\n\tlet matrix=soundMatrix.snapshot();\r\n\r\n\tlet patch={\r\n\t\tname,\r\n\t\tvoice:{oscillator,power,envelope:1,mode},\r\n\t\tarp:{algo,prog},\r\n\t\tbeat:{div,duty,reps},\r\n\t\ttempo:{bpm},\r\n\t\tmatrix\r\n\t}\r\n\r\n\tSetStorageItem(key,patch);\r\n\tsavedState.set(key,patch);\r\n\r\n\tlog(\"savePatch key:\"+key+\" patch:\"+JSON.stringify(patch));\r\n}\r\n\r\nfunction setSoundTempo(bpm){\r\n\tif(soundRemoteClock.checked){\r\n\t\tlet value=(bpm/2)|0;\r\n\t\tsoundTempo.value=value;\r\n\t\tonSoundTempo();\r\n\t}\r\n}\r\n\r\n// TODO: move div duty reps to patch voice\r\n\r\nfunction onSoundTempo(){\r\n\tvar bpm=2*(soundTempo.value|0);\r\n\tsendAllSoundProcessors([{command:\"tempo\",bpm}]);\r\n\tSoundBPM=bpm;\r\n\tlogVar(\"bpm\",bpm);\r\n}\r\n\r\nfunction onSoundPatch(){\r\n\tvar key=soundPatch.value;\r\n\tlog(\"onSoundPatch key:\"+key);\r\n\tvar slot=soundChannel.value|0;\r\n\tlet synth=synthLocalArray[slot];\r\n\tif(synth){\r\n\t\tsynth.setPatch(key);\r\n\t\tuploadPatch(key);\r\n\t}\r\n}\r\n\r\nfunction uploadPatch(key){\r\n\tlet patch=GetStorageItem(key);\r\n\tlet voice=patch.voice;\r\n\tsendPatchedSoundProcessors(key,[{command:\"voice\",oscillator:voice.oscillator,power:voice.power,envelope:1,mode:voice.mode}]);\r\n\tlet arp=patch.arp;\r\n\tsendPatchedSoundProcessors(key,[{command:\"arp\",algo:arp.algo,prog:arp.prog}]);\r\n\tlet beat=patch.beat;\r\n\tsendPatchedSoundProcessors(key,[{command:\"beat\",div:beat.div,duty:beat.duty,reps:beat.reps}]);\r\n\tlet filters=patch.filter;\r\n\tlet count=0;\r\n\tfor(let filter of filters ){\r\n\t\tlet index=count++;\r\n\t\tsendPatchedSoundProcessors(key,[{command:\"filter\",index,type:filter.type,cutoff:filter.cutoff,Q:filter.resonance}]);\r\n\t}\r\n\tlet lfos=patch.lfo;\r\n\tcount=0;\r\n\tfor(let lfo of lfos){\r\n\t\tlet index=count++;\r\n\t\tsendPatchedSoundProcessors(key,[{command:\"lfo\",index,wave:lfo.wave,power:lfo.power,sync:lfo.sync,frequency:lfo.frequency,gain:lfo.gain}]);\r\n\t}\r\n\tlet signal=patch.signal;\r\n\tcount=0;\r\n\tfor(let key of signal){\r\n\t\tlet id = \"amp\"+(count++);\r\n\t\tlet amp=signal[key];\r\n\t\tsendPatchedSoundProcessors(key,[{command:\"amp\",id,lfo:amp.lfo,target:amp.target,index:amp.index,factor:amp.factor}]);\r\n\t}\r\n\r\n}\r\n\r\n// live unsaved edits tweaks from dom inputs\r\n\r\nfunction onSoundVoice(){\r\n\tvar patch=soundPatchEdit.value;\r\n\tvar oscillator=soundVoice.value|0;\r\n\tvar power=Number(soundPower.value);\r\n\tvar mode=(soundMode.value|0);\r\n\tsendPatchedSoundProcessors(patch,[{command:\"voice\",oscillator,power,envelope:1,mode}]);\r\n\tsoundVoice.setAttribute(\"modified\",\"\");\r\n}\r\n\r\nfunction onSoundArp(){\r\n\tvar patch=soundPatchEdit.value;\r\n\tvar algo=(soundAlgorithm.value|0);\r\n\tvar prog=(soundProgression.value|0);\r\n\tsendPatchedSoundProcessors(patch,[{command:\"arp\",algo,prog}]);\r\n}\r\n\r\nfunction onSoundTweak(e){\r\n\tvar patch=soundPatchEdit.value;\r\n\tvar range=e.target;\r\n\tvar control=range.id;//\"Position.Pan\"\r\n\tlet param=soundParams[control];\r\n\tlet value=SpecValue(param,range.value);\r\n\tsendPatchedSoundProcessors(patch,[{command:\"effect\",control,value}]);\r\n}\r\n\r\nfunction onSoundBeat(){\r\n\tvar patch=soundPatchEdit.value;\r\n\tvar div=soundDivisor.value|0;\r\n\tvar duty=DutyCycle[soundDuty.value|0];\r\n\tvar reps=soundRepeat.value|0;\r\n\tsendPatchedSoundProcessors(patch,[{command:\"beat\",div,duty,reps}]);\r\n}\r\n\r\nvar pitchControl=0;\r\nvar modControl=0;\r\n\r\nfunction onSoundBend(){\r\n\tlet bend=ActiveValue(\"gas\")-ActiveValue(\"brake\");\r\n\tif(bend==0&&pitchControl==0) return;\r\n\tif(bend==0){\r\n\t\tpitchControl=0;\r\n\t}else{\r\n\t\tpitchControl=bend/100;\r\n\t\tif(pitchControl>1.0) pitchControl=1.0;\r\n\t\tif(pitchControl<-1.0) pitchControl=-1.0;\r\n\t}\r\n\tlogVar(\"bend\",pitchControl);\t\t\r\n\tlet value=8192+8000*pitchControl;\r\n\tsendSoundProcessors([{command:\"controlchange\",control:224,value}]);\r\n}\r\n\r\n// patch names get saved\r\n// program change is vicious patch librarian\r\n// synth per program for multitimbral layers\r\n\r\nfunction onSoundChannel(){\r\n\tlet channel=soundChannel.value|0;\r\n\tSetSynthChannel(channel);\r\n\tlet synth=synthLocalArray[channel];\r\n\tif(synth){\r\n\t\tsoundPatch.value=synth.patch;\r\n\t}\r\n}\r\n\r\nfunction writeKey(){\r\n\r\n}\r\n\r\n// mod wheel = vicious amplitude\r\n\r\nfunction onSoundMod(){\r\n\tvar mod=soundMod.value|0;\r\n\tvar trim=soundTrim.value|0;\r\n//\tlogVar(\"modify\",mod);\r\n\tlet value=(((127*mod)-trim)/100.0)|0;\r\n\tsendSoundProcessors([{command:\"controlchange\",control:1,value}]);\r\n\tmodControl=mod;\r\n}\r\n\r\nfunction onSoundTransmit(){\r\n\tvar range=event.target;\r\n\tvar value=range.checked;\r\n\tsoundTransmit=value;\r\n}\r\n\r\nfunction onSoundClick(){\r\n\tvar range=event.target;\r\n\tvar value=range.checked;\r\n\tsoundClick=value;\r\n}\r\n\r\n// TODO control_44\r\nfunction onSoundRecord(){\r\n\tvar range=event.target;\r\n\tvar value=range.checked;\r\n\tsoundRecording=value;\r\n\tif(soundRecording){\r\n\t\tClipRecording();\r\n\t\tsendAllSoundProcessors([{command:\"controlchange\",control:44,value}]);\r\n\t}else{\r\n\t\tlet clip=ClipRecording();\r\n\t\tif(clip.length>0){\r\n\t\t\taddClip(clip);\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction onSoundPlay(){\r\n\tlet id=soundClip.value;\r\n\tlet clip=soundClips[id];\r\n//\tLogClip(clip);\r\n\tPlayClip(clip);\r\n}\r\n\r\n\r\nfunction onSoundGain(){\r\n\tvar volume=soundVolume.value;\r\n\tif(soundContext&&gain){\r\n\t\tvar exp=volume/60.0;\r\n\t\tgain.gain.value=exp*exp;\r\n\t}\r\n}\r\nfunction onLocalGain(){\r\n\tif(soundContext&&layerGains){\r\n\t\tlet n=layerGains.length;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tlet volume=soundFaders[0].value;\r\n\t\t\tlet gain2=layerGains[i];\r\n\t\t\tvar exp=volume/60.0;\r\n\t\t\tgain2.gain.value=exp*exp;\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\nfunction helpSound(){\r\n\tlog(SoundHelpText);\r\n}\r\nfunction panicSound(){\r\n\tlog(\"panicSound\");\r\n\tsendAllSoundProcessors([{command:\"panic\"}]);\r\n\tstopAllSequencers();\r\n\tsoundPanic.setAttribute(\"on\",\"\")\r\n}\r\n\r\nfunction holdSound(){\r\n\ttoggleHold();\r\n\tsendSoundProcessors([{command:\"controlchange\",control:49,value:holdState}]);\r\n}\r\n\r\nfunction effectSound(){\r\n\ttoggleEffect();\r\n\tsendSoundProcessors([{command:\"controlchange\",control:50,value:effectState}]);\r\n}\r\n\r\nfunction muteSound(){\r\n\tlog(\"muteSound\");\r\n\tif(oscillator){\r\n\t\toscillator.stop();\r\n\t}\r\n\tif(soundContext){\r\n\t\tsoundContext.close();\r\n\t\tsoundContext=null;\r\n\t}\r\n}\r\n\r\nfunction onSaveSound(){\r\n\tlet id=soundClip.value;\r\n\tlet clip=soundClips[id];\r\n\tif(clip) LogClip(clip);\r\n}\r\n\r\n// gas and brake move plus and minus pitch wheel\r\n\r\nvar soundRemoteClock;\r\nvar soundStart;\t//,soundStream\r\nvar soundDiv;\r\nvar soundBar; // new minibar class\r\nvar soundTools;\r\nvar soundMix;\r\nvar soundTime;\r\nvar soundClip; // list of recordings\r\nvar soundPanelSplits=[];\r\nvar soundPanelFrame;\r\nvar soundPerform;\r\nvar soundEdit;\r\nvar soundPatchEdit;\r\nvar soundClipEdit;\r\nvar soundClipEvents;\r\nvar soundClipName;\r\n\r\n// per system\r\n\r\nvar soundVolume,soundVolumeLocal,soundVoice,soundPower;\r\n\r\nvar soundFaders; // one shared master at this time\t// gain per layer for local synth vicious\r\n\r\n// per track\r\n\r\nvar soundTempo\r\n\r\n// per controller\r\n\r\nvar soundMod;\r\nvar soundTrim;\r\n\r\n// per channel\r\n\r\nvar soundChannel;\r\nvar soundDivisor,soundDuty,soundRepeat;\r\nvar soundFilters;\r\nvar soundLFOs;\r\nvar soundAmps;\r\nvar soundName;\r\nvar soundPatch;\r\nvar soundSplitKeys;\r\nvar soundMode,soundAlgorithm,soundProgression;\r\nvar soundHold,soundEffect;\r\nvar soundGas,soundBrake;\r\nvar soundPanic;\r\n\r\n//var soundPitch;\r\n//var soundOutputCount=0;\r\n\r\nfunction toggleEffect(){\r\n\teffectState=127-effectState;\r\n\tif(effectState){\r\n\t\tsoundEffect.setAttribute(\"on\",\"\");\r\n\t}else{\r\n\t\tsoundEffect.removeAttribute(\"on\");\r\n\t}\r\n}\r\n\r\nfunction toggleHold(){\r\n\tholdState=127-holdState;\r\n\tif(holdState==0){\r\n\t\tsoundHold.removeAttribute(\"on\");\r\n\t}else{\r\n\t\tsoundHold.setAttribute(\"on\",\"\");\r\n\t}\r\n}\r\n\r\nconst SoundTitle=\"Synth⚠Vicious\";\r\nconst TimeTitle=\"Time\";\r\nconst MixTitle=\"Mix\";\r\nconst PerformTitle=\"Perform\";\r\nconst PatchTitle=\"Patch Editor\";\r\nconst EffectsTitle=\"Effects\";\r\nconst MatrixTitle=\"Signal Matrix\";\r\nconst ClipTitle=\"Clip Editor\";\r\n\r\nfunction clickSound(e){\r\n//\tif(e.is(\"input.select\")) return;\r\n//\tsoundPanelSplits[0].focus();\r\n}\r\n\r\nvar ActiveSlider={};\r\n\r\nfunction IsActive(id){\r\n\treturn (id in ActiveSlider) && ActiveSlider[id];\r\n}\r\n\r\nfunction ActiveValue(id){\r\n\tlet range=ActiveSlider[id];//force active\r\n\tif(range) return range.value|0;\r\n\treturn 0;\r\n}\r\n\r\nfunction focusSlider(e){\r\n\tlet src=e.srcElement;\r\n\tconsole.log(\"focus \"+src.id);\r\n\tActiveSlider[src.id]=src;\r\n}\r\n\r\nfunction blurSlider(e){\r\n\tlet src=e.srcElement;\r\n\tconsole.log(\"blur \"+src.id);\r\n//\tdelete ActiveSlider[src.id];\r\n}\r\n\r\nfunction addFocusSlider(slider){\r\n\tslider.addEventListener(\"input\",focusSlider);\r\n\tslider.addEventListener(\"focus\",focusSlider);\r\n\tslider.addEventListener(\"blur\",blurSlider);\r\n\tslider.addEventListener(\"change\",blurSlider);\r\n\tActiveSlider[slider.id]=slider;\r\n}\r\n\r\n// adds to soundClip and SoundClipEdit\r\n\r\nfunction addClip(clip){\r\n\tlet id=\"+\"+soundClipCount++;\r\n\tlet stats=ClipStats(clip);\r\n\tlet title=\"Recording \"+soundClipCount+\" \"+stats;\r\n\tlet o=addOption(soundClip,id,title,{},true);\r\n\tsoundClips[id]=clip;\r\n\tlog(\"addclip title:\"+title);\r\n\teditClip({id,title,events:clip});\r\n}\r\n\r\nfunction onSoundSynth(e){\r\n\tlet state=e.state;\r\n\tif(state.effecting!=effectState){\r\n\t\ttoggleEffect();\r\n\t}\r\n\tsoundPanic.removeAttribute(\"on\")\r\n//\tlog(\"onSoundSynth\");\r\n}\r\n\r\nfunction initMediaSession(){\r\n\tif ('mediaSession' in navigator) {\r\n\t\tnavigator.mediaSession.metadata = new MediaMetadata({\r\n\t\t\ttitle: \"Song Title\",\r\n\t\t\tartist: \"Artist Name\",\r\n\t\t\talbum: \"Album Name\",\r\n\t\t\tartwork: [{ src: \"pixels/choppa.jpg\", sizes: \"512x512\", type: \"image/jpg\" }]\r\n\t\t});\r\n\r\n\t\tnavigator.mediaSession.setActionHandler(\"play\", () => {\r\n\t\t\taudio.play();\r\n\t\t});\r\n\r\n\t\tnavigator.mediaSession.setActionHandler(\"pause\", () => {\r\n\t\t\taudio.pause();\r\n\t\t});\r\n\t}\r\n}\r\n\r\nfunction editClip(clip){\t// { id , title , events }\r\n\tlet table=soundClipEvents;\r\n\ttable.innerHTML=\"\";\r\n\tfor(let e of clip.events){\r\n//\t\tlet line=JSON.stringify(e);\r\n\t\tlet names=[e.data,e.time];\r\n\t\taddRow(table,names);\r\n\t}\r\n}\r\n\r\nfunction initSynth(){\r\n\r\n\tsoundMatrix=new Matrix();\r\n\r\n\tsoundDiv=document.getElementById(\"synth\");\r\n\tif(!soundDiv) return false;\r\n\r\n\tsoundBar=addMinibar(soundDiv);\r\n\r\n\taddTitle(soundDiv,SoundTitle);\r\n\tsoundTools=addToolbar(soundDiv,onSoundTool);\r\n\r\n\taddTitle(soundDiv,MixTitle);\r\n\tsoundMix=addToolbar(soundDiv,onSoundTool)\r\n\r\n\taddTitle(soundDiv,TimeTitle);\r\n\tsoundTime=addToolbar(soundDiv,onSoundTool)\r\n\r\n\taddTitle(soundDiv,PerformTitle);\r\n\tsoundPerform=addToolbar(soundDiv,onSoundTool);\r\n\r\n\taddTitle(soundDiv,PatchTitle)\r\n\tsoundEdit=addToolbar(soundDiv,onSoundTool);\r\n\r\n\taddTitle(soundDiv,ClipTitle)\r\n\tsoundClipEdit=addToolbar(soundDiv,onSoundClip);\r\n\tsoundClipEvents=addTable(soundClipEdit,[\"time\",\"event\",\"select\"]);\r\n\tsoundClipName=addTextInput(soundClipEdit,\"clipname\")\r\n\r\n\tsoundPanelFrame=addDiv(\"dspscreen\",soundTools);\r\n\t// 🔄\r\n\tsoundStart=addTool(soundBar,\"⏻\",\"sound.unmute\",unmuteSound);\r\n\r\n\t// Time\r\n\r\n\tsoundRemoteClock=addToggle(soundTime,\"Remote Clock\");\r\n\r\n\r\n\tsoundTempo=addMidiSlider(soundTime,\"tempo\",80.0,onSoundTempo,17);\r\n\tsoundGas=addMidiSlider(soundTime,\"gas<ModWheel+>\",0.0,onSoundBend,20);\r\n\tsoundBrake=addMidiSlider(soundTime,\"brake<ModWheel->\",0.0,onSoundBend,21);\r\n\r\n\taddFocusSlider(soundGas);\r\n\taddFocusSlider(soundBrake);\r\n\r\n\t//\taddToggle(soundTools,\"Transmit\",onSoundTransmit);\r\n\taddMidiToggle(soundTools,\"Record\",onSoundRecord,44);\r\n\taddMidiToggle(soundTools,\"Click\",onSoundClick);\r\n\r\n\tsoundClip=addSelect(soundTools,\"clip\");\r\n\taddMidiTool(soundTools,\"Play\",\"clip.play\",onSoundPlay,45);\r\n\t\r\n\taddTool(soundTools,\"Save\",\"sound.save\",onSaveSound);\r\n\r\n\taddTool(soundTools,\"Mute\",\"sound.mute\",muteSound);\r\n\taddTool(soundTools,\"About<\"+SoundHelpText+\">\",\"sound.help\",helpSound);\r\n\tsoundPanic=addTool(soundTools,\"Panic<⏚ (Esc)>\",\"sound.panic\",panicSound);\t\r\n\r\n\tsoundPanelSplits=[\r\n\t\taddPanel(soundPanelFrame,onSoundPanel),\r\n\t\taddSplit(soundPanelFrame,onSoundSplit),\r\n\t\taddPanel(soundPanelFrame,onSoundPanel),\r\n\t\taddSplit(soundPanelFrame,onSoundSplit),\r\n\t\taddPanel(soundPanelFrame,onSoundPanel),\r\n\t\taddSplit(soundPanelFrame,onSoundSplit),\r\n\t\taddPanel(soundPanelFrame,onSoundPanel),\r\n\t\taddSplit(soundPanelFrame,onSoundSplit),\r\n\t\taddPanel(soundPanelFrame,onSoundPanel),\r\n\t\taddSplit(soundPanelFrame,onSoundSplit),\r\n\t\taddPanel(soundPanelFrame,onSoundPanel)\r\n\t];\r\n\r\n\tanimateSoundPanel();\r\n\r\n\t// performance\r\n\r\n\tsoundHold=addTool(soundPerform,\"Hold<Arp Latch (`)>\",\"sound.hold\",holdSound);\r\n\t// 👆⏲\r\n\r\n\tsoundEffect=addTool(soundPerform,\"Effect Switch <Backspace>\",\"sound.effect\",effectSound);\r\n\r\n\r\n\tsoundMod=addMidiSlider(soundPerform,\"modify\",0.0,onSoundMod,1);\r\n\tsoundTrim=addMidiSlider(soundPerform,\"trim\",0.0,onSoundMod,1);\r\n\r\n\tsoundChannel=addSelect(soundPerform,\"channel\",onSoundChannel);\r\n\tfor(let ch=0;ch<LayerCount;ch++){\r\n\t\tlet id=\"+\"+ch;\r\n\t\tlet name=\"local \"+(ch+1);\r\n\t\taddOption(soundChannel,id,name);\r\n\t}\r\n\r\n\tsoundSplitKeys=addToggle(soundPerform,\"split\",onSoundSplitKeys)\r\n\r\n\tsoundPatch=addSelect(soundPerform,\"channel.patch\",onSoundPatch);\r\n\tlistPatch(soundPatch);\r\n\r\n\t// edit\r\n\r\n\t// independet patch editor selector\r\n\r\n\tsoundPatchEdit=addSelect(soundEdit,\"index\",editPatch);\r\n\tlistPatch(soundPatchEdit);\r\n\r\n\tsoundVoice=addSelect(soundEdit,\"waveform\",onSoundVoice);\r\n\tlet waveCount=0;\r\n\tfor(var key in WaveNames){\r\n\t\tlet id=\"+\"+waveCount++;\r\n\t\tlet voice=WaveNames[key];\r\n\t\tlet o=addOption(soundVoice,id,voice);\r\n\t\tif(voice==\"Triangle\") o.setAttribute(\"selected\",\"\")\r\n\t}\r\n\r\n\tsoundPower=addSelect(soundEdit,\"power\",onSoundVoice);\r\n\tfor(var key in PowerValues){\r\n\t\tlet value=PowerValues[key];\r\n\t\tlet id=\"+\"+value.toFixed(4);\r\n\t\tlet o=addOption(soundPower,id,key);\r\n\t}\r\n\r\n\tsoundMode=addSelect(soundEdit,\"mode\",onSoundVoice);\r\n\tlet modeCount=0;\r\n\tfor(var key in ModeNames){\r\n\t\tlet id=\"+\"+modeCount++;\r\n\t\tlet mode=ModeNames[key];\r\n\t\tlet o=addOption(soundMode,id,mode);\r\n\t\tif(mode==\"Poly\") o.setAttribute(\"selected\",\"\");\r\n\t}\r\n\r\n\tsoundAlgorithm=addSelect(soundEdit,\"algorithm\",onSoundArp);\r\n\tlet algoCount=0;\r\n\tfor(var key in AlgoNames){\r\n\t\tlet id=\"+\"+algoCount++;\r\n\t\tlet algo=AlgoNames[key];\r\n\t\tlet o=addOption(soundAlgorithm,id,algo);\r\n\t\tif(algo==\"Still\") \r\n\t\t\to.setAttribute(\"selected\",\"\");\r\n\t}\r\n\r\n\tsoundProgression=addSelect(soundEdit,\"progression\",onSoundArp);\r\n\tlet progCount=0;\r\n\tfor(var key in ProgNames){\r\n\t\tlet id=\"+\"+progCount++;\r\n\t\tlet prog=ProgNames[key];\r\n\t\taddOption(soundProgression,id,prog);\r\n\t}\r\n\r\n\tsoundDivisor=addSelect(soundEdit,\"divisor\",onSoundBeat);\r\n\tlet divCount=0;\r\n\tfor(var key in DivisorNames){\r\n\t\tlet id=\"+\"+(divCount++);\r\n\t\tlet div=DivisorNames[key];\r\n\t\tlet o=addOption(soundDivisor,id,div);\r\n\t\tif(div==\"⅓\") o.setAttribute(\"selected\",\"\");\r\n\t}\r\n\tsoundDuty=addSelect(soundEdit,\"duty\",onSoundBeat);\r\n\tlet dutyCount=0;\r\n\tfor(var key in DutyNames){\r\n\t\tlet id=\"+\"+dutyCount++;\r\n\t\tlet duty=DutyNames[key];\r\n\t\taddOption(soundDuty,id,duty);\r\n\t}\r\n\tsoundRepeat=addSelect(soundEdit,\"reps\",onSoundBeat);\r\n\tlet repCount=0;\r\n\tfor(var key in RepeatNames){\r\n\t\tlet id=\"+\"+repCount++;\r\n\t\tlet reps=RepeatNames[key];\r\n\t\taddOption(soundRepeat,id,reps);\r\n\t}\r\n\r\n\taddTitle(soundEdit,EffectsTitle);\r\n\r\n\tlet namedParams={};\r\n\tfor(let effect of spec.effects.types){\r\n\t\tlet params=effect.params;\r\n\t\tfor(let key in params){\r\n\t\t\tlet param=params[key];\r\n\t\t\tlet value=SpecDefault(param);\r\n\t\t\tlet name=effect.label+\"_\"+param.label;\r\n\t\t\taddSlider(soundEdit,name,value,onSoundTweak)\r\n\t\t\tnamedParams[name]=param;\r\n\t\t}\r\n\t}\r\n\tsoundParams=namedParams;\r\n\r\n\taddTitle(soundEdit,MatrixTitle);\r\n\r\n\tlet matrix=soundMatrix;\r\n\taddButton(soundEdit,\"Filter\",matrix.addFilter.bind(matrix,null));\r\n\taddButton(soundEdit,\"LFO\",matrix.addLFO.bind(matrix,null));\r\n\taddButton(soundEdit,\"Amp\",matrix.addAmp.bind(matrix,null));\r\n\r\n\tsoundFilters=addTable(soundEdit,[\"filter\",\"type\"]);\r\n\tsoundLFOs=addTable(soundEdit,[\"lfo\",\"type\"])\r\n\tsoundAmps=addTable(soundEdit,[\"signal\",\"lfo\",\"target\",\"level\"])\r\n\r\n\tsoundName=addTextInput(soundEdit,\"soundname\")\r\n\taddButton(soundEdit,\"Save\",savePatch);\r\n\r\n\tlet n=LayerCount;\r\n\tsoundFaders=addMidiSliderBank(soundMix,\"local\",12.0,onLocalGain,2,1);\r\n\tsoundVolume=addMidiSlider(soundMix,\"remote 1\",12.0,onSoundGain,18);\r\n\r\n\tLocalEventHandler(\"synth\",onSoundSynth);\r\n\r\n\tsoundStart.setAttribute(\"autofocus\",\"\");\r\n\r\n\t// todo: initSynth focus option\r\n\r\n\t//\tsoundStart.focus();\r\n\r\n\tlet active=document.activeElement;\r\n\tconsole.log(\"active = \"+active.id);\r\n\r\n\tLoadSoundState();\r\n\r\n\teditPatch();\r\n\r\n// TODO: media controls in navigator\t\r\n//\tinitMediaSession();\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspmatrix.js\",\"length\":7882,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspmatrix.js\n// (C)2025 nitrologic\n// All rights reserved\n\nvar soundMatrix;\n\nconst SoundControlNames = [\"position_pan\", \"distortion_overdrive\", \"distortion_gain\", \"reverb_wet\", \"reverb.Dry\", \"Reverb_falloff\"];\n\nconst LFOTargetNames=[\"Tremolo\",\"Vibrato\",\"Filter Cutoff\",\"Filter Resonance\",\"LFO Rate\",\"LFO Fade\",\"AMP Gain\",\"Amp Phase\",\"Control\"]\n\nfunction sampleInputs(stack){\n    // result is input value and label element\n    let result=[];\n\tfor(let item of stack){\n\t\tlet items={};\n\t\tfor(let key in item){\n\t\t\tlet input=item[key];\n\t\t\tlet value=(input.type==='checkbox'||input.type==='radio')?input.checked:input.value;\n\t\t\tlet id=input.id;\n\t\t\tlet label=input.parentElement.parentElement;\n\t\t\titems[id]={value,label};\n\t\t}\n\t\tresult.push(items);\n\t}\n\treturn result;\n}\n\nfunction controlOptions(options){\n\tlet count=0;\n\tfor(let name of SoundControlNames){\n\t\tlet value=\"+\"+count++;\n\t\taddOption(options,value,name);\n\t}\n}\n\nfunction indexOptions(options,name,count){\n\tfor(let i=0;i<count;i++){\n\t\tlet value=\"+\"+i;\n\t\taddOption(options,value,name+(i+1));\n\t}\n}\n\nfunction refreshOptions(options,target){\n\tlet index=options.selectedIndex;\n\toptions.innerHTML=\"\";\n\tswitch(target){\n\t\tcase 0:\n\t\t\tindexOptions(options,\"tremolo\",1);\n\t\t\tbreak;\n\t\tcase 1:\n\t\t\tindexOptions(options,\"vibrato\",1);\n\t\t\tbreak;\n\t\tcase 2:\n\t\tcase 3:\n\t\t\tindexOptions(options,\"filter\",4);\n\t\t\tbreak;\n\t\tcase 4:\n\t\tcase 5:\n\t\t\tindexOptions(options,\"lfo\",4);\n\t\t\tbreak;\n\t\tcase 6:\n\t\tcase 7:\n\t\t\tindexOptions(options,\"amp\",8);\n\t\t\tbreak;\n\t\tcase 8:\n\t\t\tcontrolOptions(options);\n\t\t\tbreak;\t\t\t\n\t}\n\tif (index==-1) index=0;\n\toptions.selectedIndex=index;\n}\n\nclass Matrix{\n\n\ttargetSelects=[];\n\tlfoSelects=[];\n\n\tfilters=[];//enable,filterType,cutoff,q\n\tlfos=[];//type:lfoType,power:lfoPower,sync,freq,gain\n\tamps=[];//lfo:ampLfo,target:ampTarget,index:ampIndex,factor\n\n\tload(matrix){\n\t\tfor(let filter of matrix.filter){\n\t\t\tthis.addFilter(filter);\n\t\t}\n\t\tfor(let lfo of matrix.lfo){\n\t\t\tthis.addLFO(lfo);\n\t\t}\n\t\tfor(let amp of matrix.amp){\n\t\t\tthis.addAmp(amp);\n\t\t}\n\t}\n\n\tsnapshot(){\n\t\tlet filter=sampleInputs(this.filters);\n\t\tlet lfo=sampleInputs(this.lfos);\n\t\tlet amp=sampleInputs(this.amps);\n\t\treturn{filter,lfo,amp}\n\t}\n\t\n\tonFilter(){\n\t\tvar key=soundPatchEdit.value;\n\t\tlet filters=sampleInputs(this.filters);\n\t\tconst params=spec.filters.params;\n\t\tlet messages=[];\n\t\tlet count=0;\n\t\tfor(let filter of filters){\n\t\t\tlet index=count++;\n\t\t\tlet enabled=filter.enable.value;\n\t\t\tlet type=filter.type.value|0;\n\t\t\tlet cutoff=SpecValue(params.cutoff,filter.cutoff.value);\n\t\t\tlet Q=SpecValue(params.Q,filter.resonance.value);\n\t\t\tfilter.cutoff.label.setAttribute(\"data-value\",cutoff|0);\n\t\t\tfilter.resonance.label.setAttribute(\"data-value\",Q.toFixed(4));\n\t\t\tmessages.push({command:\"filter\",index,enabled,type,cutoff,Q});\n\t\t}\n\t\tif(messages.length){\n\t\t\tsendPatchedSoundProcessors(key,messages);\n//\t\t\tlog(\"onFilter send messages:\"+JSON.stringify(messages));\n\t\t}\n\t}\n\n\tonLFO(){\n\t\tvar key=soundPatchEdit.value;\n\t\tlet lfos=sampleInputs(this.lfos);\n\t\tconst params=spec.lfos.params;\n\t\tlet messages=[];\n\t\tlet count=0;\n\t\tfor(let lfo of lfos){\n\t\t\tlet index=count++;\n\t\t\tlet wave=lfo.wave.value|0;\t\t\n\t\t\tlet power=Number(lfo.power.value);\n\t\t\tlet frequency=SpecValue(params.frequency,lfo.frequency.value);\n\t\t\tlet gain=SpecValue(params.gain,lfo.gain.value);\n\t\t\tlet sync=lfo.sync.value;\n\t\t\tlfo.frequency.label.setAttribute(\"data-value\",frequency.toFixed(2));\n\t\t\tlfo.gain.label.setAttribute(\"data-value\",gain.toFixed(2));\n\t\t\tmessages.push({command:\"lfo\",index,wave,power,sync,frequency,gain});\n\t\t}\n\t\tif(messages.length){\n\t\t\tsendPatchedSoundProcessors(key,messages);\n//\t\t\tlog(\"onLFO send messages:\"+JSON.stringify(messages));\n\t\t}\n\t}\n\n\tonAmp() {\n\t\tvar key = soundPatchEdit.value;\n\t\tlet amps = sampleInputs(this.amps);\n\t\tconst params = spec.amps.params;\n\t\tlet messages = [];\n\t\tlet count = 0;\n\t\tfor (let amp of amps) {\n\t\t\tlet id = \"amp\"+(count++);\n\t\t\tlet lfo = amp.lfo.value | 0;\n\t\t\tlet target = amp.target.value | 0;\n\t\t\tlet index = amp.index.value | 0;\n\t\t\tlet factor = SpecValue(params.factor, amp.factor.value);\n\t\t\tamp.factor.label.setAttribute(\"data-value\",factor.toFixed(2));\t\t\t\n\t\t\tmessages.push({ command: \"amp\", id, lfo, target, index, factor });\n\t\t}\n\t\tif (messages.length) {\n\t\t\tsendPatchedSoundProcessors(key, messages);\n//\t\t\tlog(\"onAmp send messages:\" + JSON.stringify(messages));\n\t\t\tthis.refreshSelects();\n\t\t}\n\t}\t\n\n\taddFilter(filter){\t\n\t\tvar index=this.filters.length;\n\t\tvar id=\"t1.\"+index;\n\t\tvar row=addRow(soundFilters,[id,\"\"]);\n\t\tvar attrib={filter:index};\n\t\tvar controls=row.childNodes.item(2);\n\t\tlet onFilter=this.onFilter.bind(this);\n\t\tvar enable=addToggle(controls,\"enable\",onFilter);\n\t\tenable.checked=(filter&&filter.enable.value);\t\t\n\t\tlet type=addSelect(controls,\"type\",onFilter);\n\t\tlet filterNames=SpecLabels(spec.filters.types);\n\t\tfor(let i=0;i<filterNames.length;i++){\n\t\t\taddOption(type,\"+\"+i,filterNames[i]);\n\t\t}\n\t\tif(filter) type.selectedIndex=filter.type.value|0;\n\t\tlet params=spec.filters.params;\n\t\tlet hz=filter?filter.cutoff.value:SpecDefault(params.cutoff);\n\t\tlet cutoff=addSlider(controls,\"cutoff\",hz,onFilter);\n\t\tlet q=filter?filter.resonance.value:SpecDefault(params.Q);\n\t\tlet Q=addSlider(controls,\"resonance\",q,onFilter);\n\n\t\tthis.filters.push({enable,type,cutoff,Q})\n\t\tthis.refreshSelects();\n\t}\n\n\taddLFO(lfo){\n\t\tvar index=this.lfos.length;\n\t\tvar id=\"t2.\"+index;\n\t\tvar row=addRow(soundLFOs,[id,\"\"]);\n\t\tvar controls=row.childNodes.item(2);\n\t\tlet onLFO=this.onLFO.bind(this);\n\t\tlet lfoType=addSelect(controls,\"wave\",onLFO);\n\t\tlet lfoNames=SpecLabels(spec.lfos.types)\n\t\tfor(let i=0;i<lfoNames.length;i++){\n\t\t\taddOption(lfoType,\"+\"+i,lfoNames[i]);\n\t\t}\n\t\tlfoType.selectedIndex=lfo?lfo.wave.value:1\n\t\tlet lfoPower=addSelect(controls,\"power\",onLFO);\n\t\tfor(var key in PowerValues){\n\t\t\tlet value=PowerValues[key];\n\t\t\tlet id=\"+\"+value.toFixed(4);\n\t\t\taddOption(lfoPower,id,key);\n\t\t}\t\n\t\tlet sync=addToggle(controls,\"sync\",onLFO);\n\t\tsync.checked=lfo&&lfo.sync.value;\n\t\tlet defaultFreq=lfo?lfo.frequency.value:SpecDefault(spec.lfos.params.frequency);\n\t\tlet freq=addSlider(controls,\"frequency\",defaultFreq,onLFO);\n\t\tlet defaultGain=lfo?lfo.gain.value:SpecDefault(spec.lfos.params.gain);\n\t\tlet gain=addSlider(controls,\"gain\",defaultGain,onLFO);\n\t\tthis.lfos.push({wave:lfoType,power:lfoPower,sync,freq,gain});\n\t\tthis.refreshSelects();\n\t}\n\n\taddAmp(amp){\n\t\tvar index=this.amps.length;\n\t\tvar id=\"t3.\"+index;\n//\t\tlog(\"addAmp \"+id);\n\t\tvar row=addRow(soundAmps,[id,\"\",\"\",\"\"]);\n\t\tvar r1=row.childNodes.item(2);\n\t\tvar r2=row.childNodes.item(3);\n\t\tvar r3=row.childNodes.item(4);\n\t\tlet onAmp=this.onAmp.bind(this);\n\t\tlet ampLfo=addSelect(r1,\"lfo\",onAmp);\n\t\tthis.addLFOSelect(ampLfo,onAmp);\n\t\tlet ampTarget=addSelect(r2,\"target\",onAmp);\n\t\tlet ampIndex=addSelect(r2,\"index\",onAmp);\n\t\tthis.addTargetSelect(ampTarget,ampIndex);\n\t\tlet defaultFactor=amp?amp.factor.value:SpecDefault(spec.amps.params.factor);\n\t\tlet factor=addSlider(r3,\"factor\",defaultFactor,onAmp);\n\t\tthis.amps.push({lfo:ampLfo,target:ampTarget,index:ampIndex,factor})\n\t\tthis.refreshSelects();\n\n\t\tif(amp){\n\t\t\tampLfo.selectedIndex=amp.lfo.value;\n\t\t\tampTarget.selectedIndex=amp.target.value;\n\t\t\tampIndex.selectedIndex=amp.index.value;\n\t\t}\n\t}\n\n\trefreshSelects(){\n\t\tfor(let each of this.targetSelects){\n\t\t\tlet select=each.select;\n\t\t\tlet index=select.selectedIndex||0;\n\t\t\tselect.innerHTML=\"\";\n\t\t\tlet targetCount=0;\n\t\t\tfor(let name of LFOTargetNames){\n\t\t\t\tlet value=\"+\"+(targetCount++);\n\t\t\t\taddOption(select,value,name);\n\t\t\t}\n\t\t\tif(index==-1) index=0;\n\t\t\tselect.selectedIndex=index;\n\t\t\trefreshOptions(each.index,index);\n\t\t}\n\t\tfor(let select of this.lfoSelects){\n\t\t\tlet index=select.selectedIndex||0;\n\t\t\tselect.innerHTML=\"\";\n\t\t\tlet n=this.lfos.length;\n\t\t\tfor(let i=0;i<n;i++){\n\t\t\t\tlet value=\"+\"+i;\n\t\t\t\taddOption(select,value,\"LFO \"+value);\n\t\t\t}\n\t\t\tif(index==-1) index=0;\n\t\t\tselect.selectedIndex=index;\n\t\t}\n\t}\n\n\taddTargetSelect(select,index){\n\t\tthis.targetSelects.push({select,index});\n\t}\n\n\taddLFOSelect(e){\n\t\tthis.lfoSelects.push(e);\n\t}\n\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspfloor.js\",\"length\":2766,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspfloor\n// (C)2025 nitrologic\n// ALL RIGHTS RESERVED\n\n\"use strict\"\n\nvar floorFrameCount=0;\n\n// requires dspapp.js\n\nfunction drawFloor(context,w,h){\n\tlet boxes=[];\n\tcontext.clearRect(0,0,w,h);\n\tcontext.fillStyle=\"black\";\t\n\tcontext.fillRect(10,10,10,10);\n\tcontext.fillRect(w-20,10,10,10);\n\tcontext.fillRect(10,h-20,10,10);\n\tcontext.fillRect(w-20,h-20,10,10);\n\treturn boxes.reverse();\n}\n\nvar floorApp;\n//var floorPanel;\nvar floorBoxed; // [{rect,note}..]\n\n// finger paint\n\nclass FloorApp extends Applet{\n\tconstructor(name){\n\t\tsuper(name);\n\t}\n\n\tdown(p){\n\n\t}\n\tup(p){\n\n\t}\n\n\tsetBoxes(boxes){\n\t\tthis.boxes=boxes;\n\t}\n\n\taddPanel(){\n\t\tlet panel=addFloorPanel(floorApp.div,\"vfloor\",onFloorPanel);\n\t\tthis.floorPanel=panel;\n\t\tthis.redraw();\n\t}\n\n\tredraw(){\n\t\tlet canvas=this.floorPanel;\n\n\t\tresizeCanvas(canvas);\n\t\tconst r = window.devicePixelRatio || 1;\n\t\tconst w = r*(canvas.clientWidth|0);\n\t\tconst h = r*(canvas.clientHeight|0);\n\n\t\tlet context=canvas.getContext(\"2d\",{antialias:true});\n\t\t\n\t\tlet boxes=drawFloor(context,w,h);\n\t\tthis.setBoxes(boxes);\t\n\n\t\t// this.refresh() // clear dirty\n\t}\n\n}\n\nfunction addFloorApp(group,name){\n\tlet app=new FloorApp(name);\n\tlet div=addToolbar(group);\n\tdiv.setAttribute(\"tabindex\",1);\n\tapp.bindEvents(div);\n\tapp.div=div;\n\treturn app;\n}\n\nvar floorDiv;\nvar floorTools;\n\nfunction addFloorPanel(group,name,handler){\n\tvar embed = document.createElement(\"canvas\");\n\tembed.id=name;\n\tembed.className=\"dspfloor\";\n//\tembed.setAttribute(\"tabindex\",3);\n\tgroup.appendChild(embed);\n// simon come here\t\n//\tembed.focus();\n\tembed.onkeydown=handler;\n\tembed.onkeyup=handler;\n\treturn embed;\n}\n\nfunction onFloorPanel(e){\n\tlog(\"onFloorPanel\");\n\treturn onFloorTool(e);\n} \n\nfunction onFloorTool(e){\n\tlet ts=(e.timeStamp*10)|0;\n\tlet verb=e.type;\t//keydown keyup\n\tif (e.repeat) return;\n\tlet keycode=e.keyCode;\n\tlet key=e.key;\n\tlet id=e.srcElement.id;\n\tlet lowerkey=key.toLowerCase();\n/* \n// multi player we get it..    \n\tlet tx=true;\n\tif(tx&&data.length){\n\t\tlet message={src,name,data,time:ts};\n\t\tlet transmit=keysTransmit;\n\t\tif(transmit){\n\t\t\tLocalEventQueueMessage(message);\n\t\t}else{\n\t\t\tLocalEventHandleMessage(message);\n\t\t}\n\t}\n*/        \n}\n\n\nfunction redrawFloor(){\n\tif(floorApp.dirty){\n//\t\tresizeCanvas(floorPanel);\n//\t\tlet big=1.8;\n//\t\tlet offsetX=keysApp.offsetX;\n\t\tlet boxes=floorApp.redraw();\t\n//\t\tdrawFloor(keysPanel,big,36,offsetX);\n\t\tfloorApp.setBoxes(boxes);\n//\t\tfloorApp.redraw();\t// dirty=false\n\t\tfloorFrameCount++;\n\t}\n\twindow.requestAnimationFrame(redrawFloor);\n}\n\n\nfunction initFloor(){\n\tfloorDiv=document.getElementById(\"floor\");\n\tif(!floorDiv) return false;\n\taddTitle(floorDiv,\"Floor\");\n\tfloorTools=addToolbar(floorDiv,onFloorTool);\n//\tenumerateKeys();\n\tfloorApp=addFloorApp(floorTools,\"Primary Floor\");\n\tfloorApp.addPanel();\n\tredrawFloor();\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspgraph.js\",\"length\":3272,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspgraph\n// (C)2025 Simon Armstrong\n// ALL RIGHTS RESERVED\n\n// depends on dspmidi.js MidiControls\n// see scripts/graph.js for version under test\n\nclass Paper {\n\tconstructor() {\n\t\tthis.lineWidth = 2.8;\n\t}\n\t\n\ttext(line,x,y){\n\t\tthis.context.fillText(line,x,y);\n\t}\n\n\trect(x,y,w,h){\n\t\tthis.context.fillRect(x,y,w,h);\n\t}\n\n\tbox(x,y,w,h,r) {\n\t\tthis.context.beginPath();\n\t\tthis.context.roundRect(x,y,w,h,r);\n\t\tthis.context.stroke();\n\t}\n\n\tbegin(context,w,h) {\n\t\tthis.context = context;\n\t\tthis.width = w;\n\t\tthis.height = h;\n\t\tcontext.font=\"18px arial\";\n\t\tcontext.strokeStyle = \"linen\";\n\t\tcontext.lineWidth = this.lineWidth;\n\t}\n\n\tend() {\n\t\tthis.context = null;\n\t}\n\n\tpush(x,y,sx,sy,a) {\n\t\tconst cx = Math.cos(a),cy = Math.sin(a);\n\t\tthis.context.save();\n\t\tthis.context.transform(sx*cx,sx*cy,sy*-cy,sy*cx,x,y);\n\t}\n\n\tpop() {\n\t\tthis.context.restore();\n\t}\n\n\tthin() {\n\t\tthis.lineWidth = 0.8;\n\t\tthis.context.lineWidth = this.lineWidth;\n\t}\n\n\tthick() {\n\t\tthis.lineWidth = 3.2;\n\t\tthis.context.lineWidth = this.lineWidth;\n\t}\n}\n\nvar nodeCount=0;\nvar nodeMap={};\n\nclass Node {\n\tconstructor() {\n\t\tthis.id=\"node\"+(nodeCount++);\n\t\tnodeMap[this.id]=this;\n\t\tthis.dirty = true;\n\t\tthis.name = \"blank\";\n\t\tthis.kids = [];\n\t\tthis.ins = [];\n\t\tthis.outs = [];\n\t}\n\trefresh() {\t\t\n\t}\n\tdraw(paper) {\n\t\tpaper.box(4,4,8,8,3);\n\t}\n\taddNode(kid) {\n\t\tthis.kids.push(kid);\n\t}\n}\n\n// control_key=((port*16+channel)*128+cc\n\nvar ControlListeners=new Map;\n\nclass Control extends Node{\n\tconstructor(name,cc){\n\t\tsuper();\n\t\tthis.name=name;\n\t\tthis.cc=cc;\n\t\tlet key=cc;\n\t\tif(ControlListeners.has(key)){\n\t\t\tlet list=ControlListeners.get(key);\n\t\t\tlist.push(this);\n\t\t}\n\t\telse{\n\t\t\tControlListeners.set(key,[this]);\n\t\t}\n\t}\n\tsetValue(value){\n\t\tthis.value=value;\n\t\tthis.dirty=true;\n\t\tfor(let out of this.outs){\n\t\t\tout.dirty=true;\n\t\t}\n\t}\n\tdraw(paper){\n\t\tlet v=this.value;\n\t\tpaper.text(this.name+\":\"+v,0,0);\n\t\tsuper.draw(paper);\n\t}\n}\n\nclass Count extends Node{\n\tconstructor(name) {\n\t\tsuper();\n\t\tthis.name=name;\n\t\tthis.count=0;\n\t}    \n\tdraw(paper){\n\t\tlet n=this.count++;\n\t\tpaper.text(\"n:\"+n,0,0);\n\t\tsuper.draw(paper);\n\t}\n\n}\nclass Logger extends Node {\n\tconstructor() {\n\t\tsuper();\n\t\tthis.name = \"logger\";\n\t\tthis.count=0;\n\t}    \n\trefresh() {\n\t\tconsole.log(\"refresh\");\n\t\tthis.dirty = true;\n\t}\n\tdraw(paper){\n\t\tif((this.count&1023)==0){\n\t\t\tconsole.log(\"draw\");\n\t\t}\n\t\tthis.count++;\n\t\tthis.dirty=false;\n\t\tsuper.draw(paper);\n\t}\n}\n\nclass Graph extends Node {\n\tconstructor(name) {\n\t\tsuper();\n\t\tthis.rects={};\n\t\tthis.name=name;\n\t\tthis.paper=new Paper();\n\t\tthis.addNode(new Logger());\n\t\tthis.addNode(new Count(\"frames\"));\n\t\tfor(let c of MidiControls){\n\t\t\tlet name=c.name;\n\t\t\tlet cc=c.cc;\n\t\t\tthis.addNode(new Control(name,cc));\n\t\t}\n\t}\n\n\taddNode(node){\n\t\tsuper.addNode(node);\n\t\tlet n=nodeCount;\n\t\tlet x=50+(n>>4)*60;\n\t\tlet y=20+(n&15)*60;\n\t\tthis.rects[node.id]={x,y,w:32,h:32};\n\t}\n\n\tsolve() {\n\t\tfor (let kid of this.kids) {\n\t\t\tkid.refresh();\n\t\t}\n\t}\n\n\tdrawGraph(context,w,h,boxes) {\n\t\tlet paper=this.paper;\n\t\tpaper.begin(context,w,h);\n\t\tfor (let kid of this.kids) {\n\t\t\tlet id=kid.id;\n\t\t\tlet rect=this.rects[id];\n\t\t\tlet note=id;\n\n\t\t\tboxes.push({rect,note});\n\n\t\t\tpaper.rect(rect.x,rect.y-4,rect.w,2);\n\t\t\tpaper.rect(rect.x,rect.y+rect.h+4,rect.w,2);\n\t\t\tpaper.push(rect.x,rect.y,1,1,0);\n\n\t\t\tkid.draw(paper);\n\t\t\tpaper.pop();\n\t\t}\n\t\tpaper.end();\n\t}\n}\n\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspnodes.js\",\"length\":5967,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspjs dspnodess\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n\"use strict\"\r\n\r\nconst UartFieldNames=[\"Port\",\"Description\",\"Control\",\"Reads\",\"Writes\",\"Action\"];\r\nconst ColorFieldNames=[\"CWRGB\",\"Swatch\",\"Name\"];\r\n\r\nclass UartDevice{\r\n\tconstructor(key,port){\r\n\t\tthis.key=key;\r\n\t\tthis.port=port;\r\n\t\tthis.totalReads=0;\r\n\t\tthis.totalWrites=0;\t\t\r\n\t\t//this.handle=null;\r\n\t}\r\n\r\n\trx(packet){\r\n\t\tvar data=packet.content.data;\r\n\t\tthis.totalReads+=data.length;\r\n\t\tlog(\"[uart] \"+data);\t\t\r\n\t}\r\n\r\n\tonSend(){\r\n//\t\tlog(\"UartDevice:onSend\");\r\n\t}\r\n\r\n\ttx(text){\r\n\t\tthis.totalWrites+=text.length;\r\n\t\tvar key=this.key;\r\n\t\tvar handle=this.handle;\r\n\t\tsendRPC(\"/api\",\"sys.write\",[handle,text],this.onSend.bind(this));\r\n\t}\r\n\r\n\tonClose(result){\r\n\t\tlog(\"UartDevice:onClose \"+result);\t\t\r\n\t}\r\n\r\n\tonOpen(handle){\r\n\t\tthis.handle=handle\r\n\t\tlog(\"UartDevice:onOpen \"+handle);\t\t\r\n\t}\r\n\r\n\tconnect(){\r\n\t\tvar name=this.port.name;\r\n\t\tsendRPC(\"/api\",\"sys.open\",name,this.onOpen.bind(this));\r\n\t}\r\n\t\r\n\tdisconnect(){\r\n\t\tvar handle=this.handle;\r\n\t\tif(handle){\r\n\t\t\tsendRPC(\"/api\",\"sys.close\",handle,this.onClose.bind(this));\r\n\t\t\tthis.handle=null;\r\n\t\t}\r\n\t}\r\n}\r\n\r\nvar uartDiv,uartTools,uartDeviceList;\r\nvar lightDiv;\r\nvar uartSendText;\r\nvar uartPorts;\r\nvar uartNames;\r\nvar uartTable;\r\nvar uartDevices={};\r\nvar uartRows={};\r\nvar uartLight;\r\n\r\nclass UartLight{\r\n\tconstructor(div){\r\n\t\tthis.addRGBCWSliders(div);\r\n\t\taddTool(div,\"Reset\",\"light.reset\",this.reset.bind(this));\r\n\t\taddTool(div,\"Add\",\"light.add\",this.addColor.bind(this));\r\n\t\tthis.colorTable=addTable(div,ColorFieldNames);\r\n\t\tthis.clear();\r\n\t}\r\n\r\n\ttx(color){\r\n\t\tfor(var id in uartDevices){\r\n\t\t\tuartDevices[id].tx(color);\r\n\t\t}\r\n\t}\r\n\r\n\taddColor(){\t\t\r\n\t\tvar table=this.colorTable;\r\n\t\tlet values=[\"1\",\"2\"];\r\n\t\tvar row=addRow(table,values);\r\n\t}\r\n\r\n\taddRGBCWSliders(div){\r\n\t\tvar modColor=this.modColor.bind(this)\r\n\t\tthis.rslider=addSlider(div,\"r\",0,modColor);\r\n\t\tthis.gslider=addSlider(div,\"g\",0,modColor);\r\n\t\tthis.bslider=addSlider(div,\"b\",0,modColor);\r\n\t\tthis.wslider=addSlider(div,\"c\",0,modColor);\r\n\t\tthis.cslider=addSlider(div,\"w\",0,modColor);\r\n\t}\r\n\r\n\treset(){\r\n\t\tthis.clear();\r\n\t\tthis.tx(\"q\");\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.r=0;\r\n\t\tthis.g=0;\r\n\t\tthis.b=0;\r\n\t\tthis.w=0;\r\n\t\tthis.c=0;\r\n\t\tthis.rslider.value=0;\r\n\t\tthis.gslider.value=0;\r\n\t\tthis.bslider.value=0;\r\n\t\tthis.wslider.value=0;\r\n\t\tthis.cslider.value=0;\r\n\t}\r\n\r\n\tmodColor(){\r\n\t\tlet r=(this.rslider.value/10)|0;\r\n\t\tlet g=(this.gslider.value/10)|0;\r\n\t\tlet b=(this.bslider.value/10)|0;\r\n\t\tlet w=(this.wslider.value/10)|0;\r\n\t\tlet c=(this.cslider.value/10)|0;\r\n\r\n\t\tvar color=\"\";\r\n\t\tif(r>this.r) color+=\"R\".repeat(r-this.r);\r\n\t\tif(r<this.r) color+=\"r\".repeat(this.r-r);\r\n\t\tif(g>this.g) color+=\"G\".repeat(g-this.g);\r\n\t\tif(g<this.g) color+=\"g\".repeat(this.g-g);\r\n\t\tif(b>this.b) color+=\"B\".repeat(b-this.b);\r\n\t\tif(b<this.b) color+=\"b\".repeat(this.b-b);\r\n\t\tif(w>this.w) color+=\"W\".repeat(w-this.w);\r\n\t\tif(w<this.w) color+=\"w\".repeat(this.w-w);\r\n\t\tif(c>this.c) color+=\"C\".repeat(c-this.c);\r\n\t\tif(c<this.c) color+=\"c\".repeat(this.c-c);\r\n\r\n\t\tthis.r=r;\r\n\t\tthis.g=g;\r\n\t\tthis.b=b;\r\n\t\tthis.w=w;\r\n\t\tthis.c=c;\r\n\t\tthis.tx(color);\t\t\r\n\t}\r\n}\r\n\r\nfunction onRemoveUart(){\r\n\tlog(\"onRemoveUart\");\r\n}\r\n\r\nfunction removeUart(){\r\n\tvar id=event.target.getAttribute(\"uart\");\r\n\tvar uart=uartDevices[id];\r\n\tvar name=uart.port.name;\r\n\tsendRPC(\"/api\",\"sys.remove\",name,onRemoveUart);\r\n\tdelete uartDevices[id];\r\n\tvar row=uartRows[id];\r\n\trow.remove();\r\n\tdelete uartRows[id];\r\n}\r\n\r\nfunction onConnections(connections){\r\n\tlog(\"connections:\"+connections)\r\n} \r\n\r\n\r\nfunction onUartPorts(ports){ \r\n\tlog(\"ports:\"+ports);\r\n\tuartPorts={};\r\n\tuartNames={};\r\n\tfor(var port of ports){\r\n//\t\tlog(\"onUartPorts \"+JSON.stringify(port));\r\n\t\tif(port.description==\"USB Serial Port\"){\r\n\t\t\tuartPorts[port.id]=port;\r\n\t\t\tuartNames[port.name]=port.id\r\n\t\t}\r\n\t}\r\n\tuartDeviceList.innerHTML=\"\";\r\n\tfor(var key in uartPorts){\r\n\t\tvar port=uartPorts[key];\r\n\t\taddOption(uartDeviceList,key,port.name+\"-\"+port.description);\r\n\t}\r\n}\r\n\r\nfunction sendUart(e){\r\n\tvar text=uartSendText.value;\r\n\tfor(var id in uartDevices){\r\n\t\tuartDevices[id].tx(text);\r\n\t}\r\n//\tuartSendText.value=\"\";\r\n}\r\n\r\nfunction configureUart(packet){\r\n\tlog(\"ioUart:\"+JSON.stringify(packet));\r\n}\r\n\r\n// uart.rx endpoint\r\n\r\nfunction receiveUart(packet){\r\n//\tlog(\"receiveUart:\"+JSON.stringify(packet));\r\n\tvar port=packet.content.port;\r\n\tvar data=packet.content.data;\r\n\tvar id=uartNames[port];\r\n\tvar uart=uartDevices[id];\r\n\tif(uart){\r\n\t\tuart.rx(packet);\r\n\t}\r\n}\r\n\r\nfunction discoverUarts(){\r\n\tsendRPC(\"/api\",\"sys.ports\",\"\",onUartPorts);\r\n\tsendRPC(\"/api\",\"sys.connections\",\"\",onConnections);\r\n}\r\n\r\nfunction connectUart(){\r\n\tvar id=event.target.getAttribute(\"uart\");\r\n\tvar uart=uartDevices[id];\r\n\tuart.connect();\r\n}\r\n\r\nfunction disconnectUart(){\r\n\tvar id=event.target.getAttribute(\"uart\");\r\n\tvar uart=uartDevices[id];\r\n\tuart.disconnect();\r\n}\r\n\r\nfunction addUart(){\r\n\tvar id=uartDeviceList.value;\r\n\tvar port=uartPorts[id];\r\n\tvar name=port.name;\r\n\tvar row=addRow(uartTable,[port.name,\"\",\"\",\"\",\"\",\"\"]);\r\n\trow.setAttribute(\"uart\",port);\r\n\tvar attrib={uart:id};\r\n\tvar controls=row.childNodes.item(3);\r\n\taddButton(controls,\"Connect\",connectUart,attrib);\r\n\taddButton(controls,\"Disconnect\",disconnectUart,attrib);\r\n\tvar actions=row.childNodes.item(6);\r\n\taddButton(actions,\"Remove\",removeUart,attrib);\r\n\tuartDevices[id]=new UartDevice(id,port);\r\n\tuartRows[id]=row;\r\n}\r\n\r\nfunction initNodes(){\r\n\tuartDiv=document.getElementById(\"nodes\");\r\n\tif(!uartDiv) return;\r\n\taddTitle(uartDiv,\"UART Nodes\");\r\n\tuartTools=addToolbar(uartDiv);\r\n\taddButton(uartTools,\"Discover\",discoverUarts);\r\n\tuartDeviceList=addSelect(uartTools,\"devices\");\r\n\taddButton(uartTools,\"Add\",addUart);\r\n\r\n\tuartSendText=addTextInput(uartTools,\"Send\",sendUart);\r\n\tuartTable=addTable(uartTools,UartFieldNames);\r\n\r\n\tlightDiv=addToolbar(uartDiv);\r\n\r\n\tuartLight=new UartLight(lightDiv);\r\n\r\n\tdiscoverUarts();\t\r\n//\tsessionHandler(\"uart.message\",onUart);\r\n//\tmay already be open umm, eeek...\r\n\tsessionHandler(\"uart.rx\",receiveUart);\r\n\tsessionHandler(\"uart.io\",configureUart);\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspmidifile.js\",\"length\":8748,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspmidifile.js \n// (c)2025 Simon Armstrong\n// All rights reserved\n\n// SMPTE timing incoming\n\nconst MIDI_LOG_CONTROL_CHANGE = false;\nconst MIDI_LOG_SYSEX = true;\n\n// standard midi meta 0xff commands\n\nconst MIDI_TRACK_TEXT = 0x01;\nconst MIDI_TRACK_COPYRIGHT = 0x02;\nconst MIDI_TRACK_NAME = 0x03;\nconst MIDI_TRACK_INSTRUMENT = 0x04;\nconst MIDI_TRACK_LYRIC = 0x05;\nconst MIDI_TRACK_MARK = 0x06;\nconst MIDI_TRACK_CUE = 0x07;\nconst MIDI_TRACK_PROGRAM = 0x08;\nconst MIDI_TRACK_DEVICE = 0x09;\nconst MIDI_CHANNEL = 0x20;\nconst MIDI_PORT = 0x21;\nconst MIDI_END_OF_TRACK = 0x2F;\nconst MIDI_TEMPO = 0x51;\nconst MIDI_SMPTE = 0x54;\nconst MIDI_TIME_SIGNATURE = 0x58;\nconst MIDI_KEY_SIGNATURE = 0x59;\n\n// standard midi events\n\nconst MIDI_NOTE_OFF = 0x80;\nconst MIDI_NOTE_ON = 0x90;\nconst MIDI_AFTER_TOUCH = 0xA0;\nconst MIDI_CONTROL_CHANGE = 0xB0;\nconst MIDI_PROGRAM_CHANGE = 0xC0;\nconst MIDI_PRESSURE = 0xD0;\nconst MIDI_PITCH_BEND = 0xE0;\nconst MIDI_SYSEX = 0xF0;\n\nfunction parseMIDITrack(ppqn,trackData,id,titles,text) {\n\tlet events = [];\n\tlet count = 0; // midiEvent count excludes meta controls\n\tlet tick = 0;\n\tlet time = 0;\n\tlet index = 0;\n\tlet channel = 0;\n\n//\tlet ppqn = 960; // typical 4/4 time setting\n\tlet tempo = 500000;  // 120bpm\n\tlet bpm = 120;\n\n\tvar runningStatus;\n\t\n\twhile (index < trackData.length) {\n\t\t// variable length time in ticks\n\t\tlet ticks = 0;\n\t\twhile(true){\n\t\t\tlet byte = trackData[index++];\n\t\t\tticks = (ticks << 7) | (byte & 0x7F);\n\t\t\tif (!(byte & 0x80)) break;\n\t\t}\n\t\ttick+=ticks;\n\n\t\tlet millis=ticksToMillis(ticks,ppqn,bpm);\n\t\ttime+=millis;\n\n\t\t// single midi channel event \n\t\tlet byte = trackData[index++];\t\n\t\tif (byte === 0xFF) {\n\t\t\tlet metaEventType = trackData[index++];\n//\t\t\tlet metaEventLength = trackData[index++];\n\n\n\t\t\tlet metaEventLength = 0;\n\t\t\twhile(true){\n\t\t\t\tlet byte = trackData[index++];\n\t\t\t\tmetaEventLength = (metaEventLength << 7) | (byte & 0x7F);\n\t\t\t\tif (!(byte & 0x80)) break;\n\t\t\t}\n\t\t\t\t\n\t\t\tlet _data = trackData.slice(index, index + metaEventLength);\n\t\t\tindex += metaEventLength;\n\t\t\tlet meta={};\n\t\t\tswitch (metaEventType) {\n\t\t\t\tcase 0x7f:\n\t\t\t\t\tmlog(\".midi 0x7f ya ya\");\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TRACK_COPYRIGHT:\n\t\t\t\t\tmeta.copyright=String.fromCharCode(..._data);\n\t\t\t\t\tlog(\".midi copyright : \"+meta.copyright);\t\t\t\t\t\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TRACK_TEXT:\n\t\t\t\tcase MIDI_TRACK_LYRIC:\n\t\t\t\t\tlet line=String.fromCharCode(..._data);\n\t\t\t\t\ttext.push(line);\n\t\t\t\t\tmlog(\".midi text : \"+line);\n\t\t\t\t\tmeta.text=line;\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TRACK_NAME:\n\t\t\t\t\tlet title=String.fromCharCode(..._data);\n\t\t\t\t\ttitles.push(title);\n\t\t\t\t\tmlog(\".midi title : \"+title);\n\t\t\t\t\tmeta.title=title;\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TRACK_MARK:\n\t\t\t\t\tmeta.marker=String.fromCharCode(..._data);\n\t\t\t\t\tmlog(\".midi mark : \"+meta.marker);\t\t\t\t\t\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TRACK_INSTRUMENT:\n\t\t\t\t\tmeta.instrument=String.fromCharCode(..._data);\n\t\t\t\t\tmlog(\".midi instrument : \"+meta.instrument);\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_CHANNEL:\n\t\t\t\t\tchannel=_data[0];\n\t\t\t\t\tmeta.channel=channel;\n\t\t\t\t\tlog(\".midi channel : \"+channel);\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_PORT:\n\t\t\t\t\tmeta.port=_data[0];\n\t\t\t\t\tmlog(\".midi port : \"+meta.port);\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TEMPO:\n\t\t\t\t\ttempo = (_data[0] << 16) | (_data[1] << 8) | _data[2];\n\t\t\t\t\tmeta.tempo = tempo;\n\t\t\t\t\tbpm=(60e6/tempo);\n\t\t\t\t\tmlog(\".midi tempo : \"+tempo+\" bpm : \"+bpm);\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_TIME_SIGNATURE:\n\t\t\t\t\tmeta.time={numerator:_data[0],denominator:_data[1],metronome:_data[2],pqn:_data[3]};\n\t\t\t\t\tmlog(\".midi time : \"+JSON.stringify(meta.time));\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_KEY_SIGNATURE:\n\t\t\t\t\tmeta.key={sharpflats:_data[0],majorminor:_data[1]};\n\t\t\t\t\tmlog(\".midi key : \"+_data[0]+\" , \"+_data[1])\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_END_OF_TRACK:\n\t\t\t\t\tmeta.stop=true;\n\t\t\t\t\tmlog(\".midi end of track\");\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_SMPTE:\n\t\t\t\t\tmeta.smpte_frameRate = _data[0]; // frame rate, e.g., 24, 25, 29, 30\n\t\t\t\t\tmeta.smpte_ticksPerFrame = _data[1]; // ticks per frame\n\t\t\t\t\tmeta.smpte_timeCodeInfo = _data[2]; // SMPTE timecode\n\t\t\t\t\tlog(\".midi smpte  framerate : \"+meta.smpte_frameRate+\" ticksperframe : \"+meta.smpte_ticksPerFrame+\" timecode : \"+meta.smpte_timeCodeInfo);\n\t\t\t\t\tbreak;\t\n\t\t\t\tdefault:\n\t\t\t\t\tlog(\".midi missing case metaEventType : 0x\"+metaEventType.toString(16));\n\t\t\t\t\treturn null;\n\t\t\t\t\tbreak;\n\t\t\t}\n\t\t\tlet name=\"meta\";\n\t\t\tlet type=\"meta:0x\"+metaEventType.toString(16);\n\t\t\tevents.push({ name, type, data: _data,  tick, time, meta });\n\t\t}\n\t\telse\n\t\t{\n// runningStatus\n\t\t\tif (byte<0x80){\n\t\t\t\tbyte = runningStatus;\n\t\t\t\tindex--;\n\n\t\t\t}\n\t\t\tlet result = null;\n\t\t\tlet channel = byte & 0x0F;\n\t\t\tlet eventType = byte & 0xF0;\n\n\t\t\tswitch (eventType) {\n\t\t\t\tcase MIDI_AFTER_TOUCH:\n\t\t\t\t\tlet note = trackData[index++];\n\t\t\t\t\tlet press = trackData[index++];\n\t\t\t\t\tresult = { name:\"after touch\",note,pressure:press,channel,tick,time};\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_PRESSURE:\n\t\t\t\t\tlet pressure = trackData[index++];\n\t\t\t\t\tresult = { name:\"pressure\",pressure,channel,tick,time};\n\t\t\t\t\tbreak;    \n\t\t\t\tcase MIDI_NOTE_ON:\n\t\t\t\t\tlet noteNumber = trackData[index++];\n\t\t\t\t\tlet noteVelocity = trackData[index++];\n\t\t\t\t\tresult = { name: \"note on\", note: noteNumber, velocity: noteVelocity,channel,tick,time };\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_NOTE_OFF:\n\t\t\t\t\tlet noteOffNumber = trackData[index++];\n\t\t\t\t\tlet noteOffVelocity = trackData[index++];\n\t\t\t\t\tresult = { name: \"note off\", note: noteOffNumber, velocity: noteOffVelocity,channel,tick,time };\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_CONTROL_CHANGE:\n\t\t\t\t\tlet controlNumber = trackData[index++];\n\t\t\t\t\tlet controlValue = trackData[index++];\n\t\t\t\t\tresult = { name: \"control change\", control: controlNumber, value: controlValue,channel,tick,time };\n\t\t\t\t\tif(MIDI_LOG_CONTROL_CHANGE){\t\n\t\t\t\t\t\tlet name=MIDI_CONTROL_NAMES[controlNumber]||\"Control\"+controlNumber;\n\t\t\t\t\t\tlog(\"control change : \"+name+\" value : \"+controlValue);\n\t\t\t\t\t}\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_PROGRAM_CHANGE:\n\t\t\t\t\tlet programNumber = trackData[index++];\n\t\t\t\t\tresult = { name: \"program change\", program: programNumber,channel,tick,time };\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_PITCH_BEND:\n\t\t\t\t\tlet pitchBendLSB = trackData[index++];\n\t\t\t\t\tlet pitchBendMSB = trackData[index++];\n\t\t\t\t\tlet pitchBendValue = (pitchBendMSB << 7) | pitchBendLSB;\n\t\t\t\t\tresult = { name: \"pitch bend\", value: pitchBendValue,channel,tick,time };\n\t\t\t\t\tbreak;\n\t\t\t\tcase MIDI_SYSEX:\n\t\t\t\t\tlet sysex=[];\n\t\t\t\t\twhile(index<trackData.length){\n\t\t\t\t\t\tlet byte=trackData[index++];\n\t\t\t\t\t\tif(byte==0xf7){\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t}\n\t\t\t\t\t\tsysex.push(byte);//.toString(16));\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t\tif(MIDI_LOG_SYSEX){\n\t\t\t\t\t\tmlog(\"midi: sysex : \"+JSON.stringify(sysex));\n\t\t\t\t\t}\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\tlog(\"midi: missing eventType case  byte : 0x\"+byte.toString(16));\n//\t\t\t\t\treturn null;\n\t\t\t\t\tbreak;\n\t\t\t}\n//\t\t\tlog(\"result \"+JSON.stringify(result));\n\t\t\tif(result){\n\t\t\t\tevents.push(result);\n\t\t\t\tcount++;\n\t\t\t}\n\t\t\trunningStatus=byte;\n\t\t}\n\t}\n\t// last tick played should hopefully be meta.stop\n\treturn {id,channel,count,events,tick,index,ppqn};\n}\n\nfunction ticksToMillis(ticks, ppqn, bpm) {\n    const ticksPerMilli = bpm * ppqn / 60000;\n\tif(ticksPerMilli==0) return 0;\n    return ticks / ticksPerMilli;\n}\n\nfunction sliceTrackBytes(raw, offset) {\n\t// MTrk\n\tconst isTrack = (raw[offset]==0x4d && raw[offset+1]==0x54 && raw[offset+2]==0x72 && raw[offset+3]==0x6b);\n\tif (!isTrack) {\n\t\tthrow new Error('Invalid track chunk.');\n\t}\n\tconst trackLength = (raw[offset+4]<<24) | (raw[offset+5]<<16) | (raw[offset+6]<<8) | raw[offset+7];\n\tconst trackData = raw.slice(offset+8,offset+8+trackLength);\n\treturn trackData;\n}\n\t\nfunction parseMIDI(name,raw){\n\t// MThd\n\tconst isMidi=(raw[0]==0x4d&&raw[1]==0x54&&raw[2]==0x68&&raw[3]==0x64);\n\tif(isMidi){\n\t\tconst headerLength = (raw[4] << 24) | (raw[5] << 16) | (raw[6] << 8) | raw[7];\n\t\tconst midiFormat = (raw[8] << 8) | raw[9];\n\t\tconst trackCount = (raw[10] << 8) | raw[11];\n\t\tconst ppqn=(raw[12] << 8) | raw[13];\n\t\tconst smpte=!!(ppqn&0x8000);\n\t\tif(smpte){\n//\t\tThe upper byte (signed) specifies the SMPTE format (-24, -25, -29, or -30 frames per second).\n//\t\tThe lower byte specifies ticks per frame (how many MIDI clock pulses per frame).\t\t\n\t\t\tlog(\"SMPTE timing not supported raw[12]:\"+raw[12]+\" raw[13]:\"+raw[13]);\n\t\t\tthrow new Error('SMPTE not yet supported');\n\t\t}\n\t\tconst tracks=[];\n\t\tconst titles=[];\n\t\tconst events=[];\n\t\tconst text=[];\n\t\tlet count=0;\n\t\tlet offset=14;\n\t\tfor (let i = 0; i < trackCount; i++) {\n\t\t\tconst raw2 = sliceTrackBytes(raw, offset);\n\t\t\toffset += raw2.length+8;\n\t\t\tlet id=\"track \"+(i+1);\n\t\t\tlet track=parseMIDITrack(ppqn||480,raw2,id,titles,text);\n\t\t\tif(!track) return null;\n\t\t\tcount+=track.events.length;\n\t\t\ttracks.push(track);\n\t\t}\n\t\tlog(\"parseMidi name : \"+name+\" midiFormat : \"+midiFormat+\" trackCount : \"+trackCount+\" tracks : \"+tracks.length+\" count : \"+count);\n\t\treturn { name, midiFormat, trackCount, tracks };\n\t}\n\treturn null;\n}\n\nfunction mlog(line){\n//\tconsole.log(line);\n}","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspkeys.js\",\"length\":10218,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspkeys (C)2025 nitrologic ALL RIGHTS RESERVED\n\n\"use strict\"\n\n// right lead top\n// left bass bottom \n\nvar keysPanel;\nvar keysApp;\nvar keysFrameCount=0;\n\nvar keysBoxed; // [{rect,note}..]\n//var keysWidth;\n\nclass KeysApp extends Applet{\n\tconstructor(name){\n\t\tsuper(name);\n\t\tthis.offsetX=-600;\n\t}\n\tsetBoxes(boxes){\n\t\tthis.boxes=boxes;\n\t\tthis.pixelRatio=window.devicePixelRatio||1;\n\t}\n\t// interface\n\tdrag(dx,dy){\n\t\tlet x=this.offsetX+dx;\n\t\tif(x<-1600) x=-1600;\n\t\tif(x>0) x=0;\n\t\tthis.offsetX=x;\n\t\tthis.dirty=true;\n\t}\n\tnoteUnder(px,py){\n\t\tlet x=px*this.pixelRatio;\n\t\tlet y=py*this.pixelRatio;\n\t\tfor(let box of this.boxes){\n\t\t\tlet r=box.rect;\n\t\t\tif(x>=r[0]&&y>=r[1]&&x<(r[0]+r[2])&&y<(r[1]+r[3])){\n\t\t\t\treturn box.note;\n\t\t\t}\n\t\t}\n\t\treturn null;\n\t}\n\t// replace sliced events with a recent event pointer aka top()\n\tdown(p){\n//\t\tlog(\"keys down \"+JSON.stringify(p));\n\t\tthis.mousedown=true;\n\t\tlet note=this.noteUnder(p.x,p.y);\n\t\tif(note){\n\t\t\tlet velocity=p.v?p.v:100;\n\t\t\tthis.downNote(note,velocity);\n\t\t}\n//\t\tmessage.push({command:\"noteon\", note, velocity})\n\t\treturn note;\n\t}\n\tup(p){\n//\t\tlog(\"keys up \"+JSON.stringify(p));\n\t\tthis.mousedown=true;\n\t\tlet note=this.noteUnder(p.x,p.y);\n\t\tif(note)this.upNote(note);\n\t}\n\t\t\n\t// interface\n\tdownNote(note,velocity){\n\t\tlet data=[144,note,velocity];\n\t\tlet src=\"midi\";\n\t\tlet name=\"keysapp\";\n\t\tlet ts=performance.now()*10;\n\t\tlet message={src,name,data,time:ts};\n\t\tLocalEventHandleMessage(message);\t\t\n\t}\n\t// interface\n\tupNote(note){\n//\t\tlog(\"keys upnote \"+note);\n\t\tlet velocity=100;\n\t\tlet data=[128,note,velocity];\n\t\tlet src=\"midi\";\n\t\tlet name=\"keysapp\";\n\t\tlet ts=performance.now()*10;\n\t\tlet message={src,name,data,time:ts};\t\t\n\t\tLocalEventHandleMessage(message);\t\t\n\t}\n}\n\n// Primary Keys - \nfunction addKeysApp(group,name){\n\tlet app=new KeysApp(name);\n\tlet div=addToolbar(group);\n\tdiv.setAttribute(\"tabindex\",1);\n\tapp.bindEvents(div);\n\tapp.div=div;\n\treturn app;\n}\n\nvar keysDiv;\nvar keysTools;\n\nvar keysTransmit=false;\n\n\n//keysIns,keysOuts,keysSends;\nvar keysDevices={};\n\nvar keysControlDirty=[];\nvar keysControlMap={};\nvar keysProgramMap={};\nvar keysButtonMap={};\nvar keysChangeMap={};\nvar keysNextMap={};\nvar keysPrevMap={};\nvar keysDataEntryMap={};\nvar keysDelays={};\n\n\nfunction cleanKeysControls(){\n\tvar dirty=keysControlDirty;\n\tkeysControlDirty=[];\n\tfor(var element of dirty)\n\t{\n\t\tvar event = new Event('input', {bubbles: true,});\n\t\telement.dispatchEvent(event);\n\t}\n}\n\nfunction addKeysSelect(group,name,prevControl,nextControl,dataControl){\n\tvar input=addSelect(group,name);\n\tif(nextControl) keysNextMap[nextControl]=input;\n\tif(prevControl) keysPrevMap[prevControl]=input;\n\tif(dataControl) keysDataEntryMap[dataControl]=input;\n\treturn input;\n}\n/*\nfunction addKeysTool(group,name,command,handler,control){\n\tvar tool=addTool(group,name,command,handler);\n\tif(control){\n\t\tkeysButtonMap[control]=tool;\n\t}\n\treturn tool;\n}\n\nfunction addKeysToggle(group,name,handler,control){\n\tvar toggle=addToggle(group,name,handler);\n\tif(control){\n\t\tkeysChangeMap[control]=toggle;\n\t}\n\treturn toggle;\n}\n\nfunction addKeysSlider(group,name,value,handler,control){\n\tvar range=addSlider(group,name,value,handler);\n\tif(control){\n\t\tkeysControlMap[control]=range;\n\t}\n\tif(value){\n\t\tkeysControlDirty.push(range);\n\t}\n\treturn range;\n}\n\n*/\n\nfunction onKeysMidiMessage(e){ \n\tvar bytes=e.data;\n\tvar ts=(e.timeStamp*10)|0;\n\tvar cmd=bytes[0];\n\tswitch(cmd){\n\t\tcase 240:\n//\t\t\tonSysex(bytes);\n\t\t\tbreak;\n\t\tcase 144:\n\t\tcase 128:\n\t\t\t// note events currently not mappable\n\t\t\tbreak;\n\t\tcase 192://program change no mappable\n\t\t\tlet program=bytes[1];\n\t\t\tvar input=keysProgramMap[program];\n\t\t\tif(input){\n\t\t\t\tinput.dispatchEvent(new Event(\"change\"));\t\t\t\t\t\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tbreak;\n\t\tcase 224://pitch change\n\t\t\tbreak;\n\t\tcase 176:\n\t\t\tvar control=bytes[1];\n\t\t\tvar input=keysControlMap[control];\n\t\t\tif(input){\n\t\t\t\tvar value=bytes[2];\n\t\t\t\tinput.value=value;\n\t\t\t\tinput.dispatchEvent(new Event(\"change\"));\t\t\t\t\t\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tvar button=keysButtonMap[control];\n\t\t\tif(button){\n\t\t\t\tvar value=bytes[2];\n\t\t\t\tif(value==127){\n\t\t\t\t\tbutton.dispatchEvent(new Event(\"click\"));\t\t\t\t\t\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tvar change=keysChangeMap[control];\n\t\t\tif(change){\n\t\t\t\tvar value=bytes[2];\n\t\t\t\tif(value==127){\n\t\t\t\t\tchange.checked=!change.checked;\n\t\t\t\t\tchange.dispatchEvent(new Event(\"change\"));\t\t\t\t\t\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tvar inc=keysNextMap[control];\n\t\t\tvar dec=keysPrevMap[control];\n\t\t\tif(inc || dec){\t\t\t\t\n\t\t\t\tvar value=bytes[2];\n\t\t\t\tif(value==127){\n\t\t\t\t\tif(inc){\n\t\t\t\t\t\tvar index=inc.selectedIndex;\n\t\t\t\t\t\tinc.selectedIndex=(index+1)%inc.length;\n\t\t\t\t\t\tinc.dispatchEvent(new Event(\"change\"));\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t\tif(dec){\n\t\t\t\t\t\tvar index=dec.selectedIndex;\n\t\t\t\t\t\tdec.selectedIndex=((index-1)+dec.length)%dec.length;\n\t\t\t\t\t\tdec.dispatchEvent(new Event(\"change\"));\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\t}\n//\t\t\tlog(\"onKeysMessage Control Change:\"+bytes.toString()+\" @\"+ts+\".\"+e.type);\n\t\t\tbreak;\n\t\tdefault:\n\t\t\tlog(\"onKeysMessage unhandled cmd : \" + cmd + \" bytes : \"+bytes.toString()+\" @\"+ts+\".\"+e.type);\n\t}\n\tvar edata=Object.values(e.data);\n\tvar message={src:\"keys\",name:this.name,data:edata,time:ts};\n\n\tlet transmit=soundTransmit;\n\tif(transmit){\n\t\tLocalEventQueueMessage(message);\n\t}else{\n\t\tLocalEventHandleMessage(message);\n\t}\n}\n\nfunction addKeyPanel(group,name,handler){\n\tvar embed = document.createElement(\"canvas\");\n\tembed.id=name;\n\tembed.className=\"dspkeys\";\n\n\tembed.setAttribute(\"tabindex\",3);\n\n\tgroup.appendChild(embed);\n// simon come here\t\n//\tembed.focus();\n\tembed.onkeydown=handler;\n\tembed.onkeyup=handler;\n\treturn embed;\n}\n\nconst MidiKeys=\"awsedftgyhujkolp;'\";\nconst MidiNotes={\n\t\";\":76,\"'\":77,\"]\":78,\n\t\":\":76,\"\\\"\":77,\"}\":78,\n\t\"Enter\":79\n};//E..G\n\nconst MidiCodes={\n\t\"z\":[176,97,127],//down12\n\t\"x\":[176,96,127],//up12\n\t\"escape\":[176,123,127],//panic\n};\n\nconst whiteOffset=[0,2,4,5,7,9,11];\nconst blackOffset=[1,3,0,6,8,10,0];\n\n\nfunction drawWheels(context,h,big,boxes){\n\n\tconst r = window.devicePixelRatio || 1;\n\tlet keyw=25*big*r;\n\tlet keyh=50*big*r;\n\tlet y=h-keyh;\n\n\tfor(let i=0;i<2;i++){\n\t\tlet x=i*40;\n\t\tlet h=keyh-10;\n\t\tlet note=1024+i;\n\t\tlet yy=y+50-6;\n\n\t\tcontext.fillStyle=\"silver\";\n\t\tcontext.fillRect(x,y,32,h);\n\n\t\tcontext.fillStyle=\"black\";\n\t\tcontext.fillRect(x,yy,32,12);\n\t\tcontext.fillStyle=\"white\";\n\t\tcontext.fillRect(x,yy+4,32,4);\n\n\t\tboxes.push({rect:[x,y,32,h],note});\n\n\t}\n}\n\n// TODO: key hit boxes not cliped inside rect - missing box context\n\nfunction drawKeys(context,big,offsetX,h,n,boxes){\n\tconst c=60-12-12;\n\n\tconst r = window.devicePixelRatio || 1;\n\tlet keyw=25*big*r;\n\tlet keyh=50*big*r;\n\n//\tlet n=36-7;//w/keyw;\n\tlet y=h-keyh;\n\t// white notes\n\tcontext.fillStyle=\"white\";\n\tfor(let i=0;i<n;i++){\n\t\tlet oc=(i/7)|0;\n\t\tlet wh=(i%7)|0;\n\t\tlet note=c+whiteOffset[wh]+oc*12;\n\t\tlet x=offsetX+i*keyw;\n\t\tcontext.fillRect(x+1,y,keyw-2,keyh);\n\t\tboxes.push({rect:[x,y,keyw,keyh],note});\n\t}\n\t// black notes\n\tcontext.fillStyle=\"black\";\n\tfor(let i=0;i<n-1;i++){\n\t\tlet oc=(i/7)|0;\n\t\tlet x=offsetX+(i+0.5)*keyw;\n\t\tlet i8=i%7;\n\t\tif([0,1,3,4,5].includes(i8)){\n\t\t\tcontext.fillRect(x+1,y,keyw-2,keyh/2);\n\t\t\tlet note=c+blackOffset[i8]+oc*12;\n\t\t\tboxes.push({rect:[x,y,keyw,keyh/2],note});\n\t\t}\n\t}\n}\n\nfunction drawKeysWheels(canvas,big,n,offsetX){\n\tlet boxes=[];\n\tconst w=canvas.width;\n\tconst h=canvas.height;\n\tlet context=canvas.getContext(\"2d\",{antialias:false});\n//\tconsole.log(\"drawkeys w:\"+w+\" h:\"+h);\n\tcontext.clearRect(0,0,w,h);\n\tcontext.save();\n\tcontext.beginPath();\n\tcontext.rect(80,0,w-88,h);\n\tcontext.clip();\n\toffsetX+=80;\n\n\tdrawKeys(context,big,offsetX,h,n,boxes);\n\t\n\tcontext.restore();\n\n\tdrawWheels(context,h,big,boxes);\n\n\treturn boxes.reverse();\n}\n\n\nfunction onKeysPanel(e){\n//\tlog(\"onKeysPanel\");\n\treturn onKeysTool(e);\n} \n\nfunction onKeysTool(e){\n\tlet ts=(e.timeStamp*10)|0;\n\tlet verb=e.type;\t//keydown keyup\n\tif (e.repeat) return;\n\tlet keycode=e.keyCode;\n\tlet key=e.key;\n\tlet id=e.srcElement.id;\n\tlet lowerkey=key.toLowerCase();\n\tlet index=MidiKeys.indexOf(lowerkey);\n\t// simon come here\n\tlet note=(index>-1)?60+index:MidiNotes[key];\n\tlet num=midiNums.indexOf(key);\n\tlet func=midiFuncs.indexOf(key)/2;\n\tlet code=(lowerkey in MidiCodes)?MidiCodes[lowerkey]:null;\n\tlet velocity=70;\n\tlet src=\"midi\";\n\tlet name=\"keygon\";\n\tlet data=[];\n\tswitch(verb){\n\t\tcase \"keydown\":\n\t\t\tif(num>-1){\n\t\t\t\t// program change 1..0\n\t\t\t\tdata=[192,num];\n\t\t\t}else if(func>0.5){\n\t\t\t\tconsole.log(\"onKeysTool keydown func key:\"+func);\n\n\t\t\t}else if(code){\n\t\t\t\tdata=code;\n\t\t\t}else if(note) {\n//\t\t\tdata=new Uint8Array([144,note,velocity]);\n\t\t\t\tdata=[144,note,velocity];\n\t\t\t}else{\n\t\t\t\tif(key==\"Shift\"){\n\t\t\t\t\t// sustain pedal on either shift\n\t\t\t\t\tdata=[176,64,127];\n\t\t\t\t}else if(key==\"`\"){\n\t\t\t\t\ttoggleHold();\n\t\t\t\t\t// hold pedal on apostrophe\n\t\t\t\t\tdata=[176,49,holdState];\n\t\t\t\t}else if(key==\" \"||key==\"Tab\"){\n\n\t\t\t\t}else{\n\t\t\t\t\tconsole.log(\"onKeysTool keydown unmapped key:\"+key);\n\t\t\t\t}\n\t\t\t}\n\t\t\tbreak;\n\t\tcase \"keyup\":\n//\t\t\tdata=new Uint8Array([128,note,velocity]);\n\t\t\tif(note) data=[128,note,velocity];\n\t\t\telse{\n\t\t\t\tif(key==\"Shift\"){\n\t\t\t\t\t// sustain pedal on either shift\n\t\t\t\t\tdata=[176,64,0];\n\t\t\t\t}else{\n//\t\t\t\t\tconsole.log(\"onSoundTool keyup unmapped key:\"+key);\n\t\t\t\t}\n\t\t\t}\n\t\t\tbreak;\n\t\tdefault:\n\t\t\tconsole.log(\"onKeysTool unhandled verb:\"+verb);\n\t\t\tbreak;\n\t}\n\tlet tx=true;\n\tif(tx&&data.length){\n\t\tlet message={src,name,data,time:ts};\n\t\tlet transmit=keysTransmit;\n\t\tif(transmit){\n\t\t\tLocalEventQueueMessage(message);\n\t\t}else{\n\t\t\tLocalEventHandleMessage(message);\n\t\t}\n\t}\n}\n\nlet keyStates={};\n\nfunction keysMidiHandler(e){\n}\nfunction keysSynthHandler(e){\t\n\tkeyStates[e.name]=e.state;\n}\n\n// move to keys app redraw\n// broken after window resize\n\nfunction redrawKeys(){\n\tif(keysApp.dirty){\n\t\tlet canvas=keysPanel;\n\t\tresizeCanvas(canvas);\n\n\t\tlet big=1.8;\n\t\tlet offsetX=keysApp.offsetX;\n\t\tlet boxes=drawKeysWheels(canvas,big,36,offsetX);\n\n\t\tkeysApp.setBoxes(boxes);\n\t\tkeysApp.refresh();\n\n\t\tkeysFrameCount++;\n\t}\n\twindow.requestAnimationFrame(redrawKeys);\n}\n\nfunction initKeys(){\n\tkeysDiv=document.getElementById(\"keys\");\n\tif(!keysDiv) return false;\n\taddTitle(keysDiv,\"Keys\");\n\tkeysTools=addToolbar(keysDiv,onKeysTool);\n//\tenumerateKeys();\n\tkeysApp=addKeysApp(keysTools,\"Primary Keys\");\n\tkeysPanel=addKeyPanel(keysApp.div,\"vkeys\",onKeysPanel);\n\tLocalEventHandler(\"midi\",keysMidiHandler);\n\tLocalEventHandler(\"synth\",keysSynthHandler);\n\tkeysApp.drag(0,0);\n\tkeysApp.dirty=true;\n\tredrawKeys();\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspwiki.js\",\"length\":8266,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspwiki\n// (C)2024 nitrologic\n// ALL RIGHTS RESERVED\n\n// depends nitromarkup.js\n\nvar wiki\nvar wikiDiv,wikiTools,wikiHome,wikiRefresh,wikiAddress,wikiEdit,wikiDebug,wikiPreview,wikiSave,wikiEmoji;\n\nconst WikiAnchors=false;\n\nclass Wiki{\n\tconstructor(div,debugDiv){\n\t\tthis.div=div;\n\t\tthis.debugger=debugDiv;\n\n\t\tvar editor=document.createElement(\"div\");\n\t\teditor.className=\"editor\";\n\t\tdiv.appendChild(editor);\n\n\t\tvar box=document.createElement(\"div\");\n\t\tbox.className=\"frame\";\n\t\tdiv.appendChild(box);\n\n\t\tvar content=document.createElement(\"div\");\n\t\tcontent.className=\"content\";\n\t\tbox.appendChild(content);\n\n\t\tvar textarea=document.createElement(\"textarea\");\n\t\ttextarea.className=\"editor\";\n\t\ttextarea.onkeydown=this.keydown.bind(this);\n\t\teditor.appendChild(textarea);\n\n\t\tvar emoji=document.createElement(\"div\");\n\t\temoji.className=\"emoji\";\n\t\teditor.appendChild(emoji);\n\n\t\tthis.content=content;\n\t\tthis.editor=editor;\n\t\tthis.textarea=textarea;\n\t\tthis.emoji=emoji;\n\n//\t\tgetJSON(\"nitrojs/json/emoji.json\",this.refresh.bind(this));\n\n\t\tthis.history=[];\n\t}\n\n\trun(){\n\t\tconsole.log(\"wiki.run\");\n\t\tvar code=[];\n\t\tfor(var line in this.content){\n\t\t\tif(line.length>0){\n\t\t\t\tvar firstchar=line[0];\n\t\t\t\tif(firstchar>='0'&&firstchar<='9'){\n\t\t\t\t\tcode.push(line);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tconsole.log(\"code length \"+code.length);\n\t}\n\t\n\tsave(){\n\t\tvar key=this.key;\n\t\tvar content=escapeRedisString(this.textarea.value);\n\t\tvar command=\"SET wiki.\"+key+\" \"+content;\n\t\tsendRPC(\"/api\",\"redis.run\",command,onWikiWrite);\n\t\tthis.preview();\n\t\tthis.endEdit();\n\t}\n\n//\t\tvar group=\"🖕💩\";\n//\t\tfor(var charCode of group){\n\n\trefresh(emojis){\n\t\tvar emoji=this.emoji;\n\t\temoji.innerHTML=\"\";\n\t\tfor(var emo of emojis){\n\t\t\tvar span=document.createElement(\"span\");\n\t\t\tspan.className=\"emoji\";\n\t\t\tspan.id=emo.char;\n\t\t\tspan.onclick=this.emote.bind(this);\n\t\t\tvar text=document.createTextNode(emo.char);\n\t\t\tspan.appendChild(text);\n\t\t\temoji.appendChild(span);\n\t\t}\n\t}\n\n\temote(e){\n\t\tvar value=e.target.id;\n\t\tvalue=\"\"\n\t\tthis.insert(value);\n\t\tthis.textarea.focus();\n\t}\n\n\tedit(){\n\t\tif(this.editor.hasAttribute(\"visible\")){\n\t\t\tthis.editor.removeAttribute(\"visible\");\n\t\t}else{\n\t\t\tthis.editor.setAttribute(\"visible\",\"\");\n\t\t}\n\t}\n\n\tendEdit(){\n\t\tthis.editor.removeAttribute(\"visible\");\n\t}\n\n\temoje(){\n\t\tif(this.emoji.hasAttribute(\"visible\")){\n\t\t\tthis.emoji.removeAttribute(\"visible\");\n\t\t}else{\n\t\t\tthis.emoji.setAttribute(\"visible\",\"\");\n\t\t}\n\t}\n\n\tinsert(text){\n\t\tvar t=this.textarea;\n\t\tt.setRangeText(text, t.selectionStart, t.selectionEnd, \"end\");\t\t\t\t\n\t}\n\n\tkeydown(e){\n\t\tif (e.ctrlKey && e.key === 's') {\n\t\t\te.preventDefault();\n\t\t\treturn false;\n\t\t}\n\t\tswitch(e.keyCode){\n\t\t\tcase 9:\n\t\t\t\tthis.insert(\"\\t\");\n\t\t\t\treturn false;\n\t\t\tcase 13:\n\t\t\tcase 38:\n\t\t\tcase 40:\n\t\t\t\tthis.preview();\n\t\t\t\tbreak;\n\t\t}\n\t\treturn true;\n\t}\n\t\n\tdebug(){\t\t\n\t\tif(this.debugger.hasAttribute(\"visible\")){\n\t\t\tthis.debugger.removeAttribute(\"visible\");\n\t\t}else{\n\t\t\tthis.debugger.setAttribute(\"visible\",\"\");\n\t\t}\n\t}\n\n\tgo(key){\n\t\tthis.key=key;\n\t\tvar command=\"GET wiki.\"+key;\n\t\tsendRPC(\"/api\",\"redis.run\",command,onWikiGet);\n\t}\n\n\tback(){\n\t\tvar previous=history.pop();\n\t\tif(previous){\n\t\t\tgo(previous)\n\t\t}\n\t}\n\n\t// TODO: use nitromarkup \n\n\twritePage(md){\n\t\tvar lines=(typeof md==='string') ?md.split(\"\\n\"):[\"\"];\n\t\tvar html=\"\";\n\t\tvar incode=false;\n\t\tvar fenced=false;\n\t\tvar lang=\"\";\n\t\tvar intable=false;\n\t\tvar header=null;\n\t\tvar pre=[];\n\t\tvar latex={};\n\t\tfor(var line of lines){\n\t\t\tvar fence=line.startsWith(\"```\")\n\t\t\tif (fenced){\n\t\t\t\tif(fence){\n\t\t\t\t\tswitch(lang){\n\t\t\t\t\t\tcase \"latex\":\n\t\t\t\t\t\t\tvar tex=pre.join(\" \\\\\\\\\\n\");\n\t\t\t\t\t\t\tvar markup = katex.renderToString(tex, {throwOnError: false, displayMode:true});\n\t\t\t\t\t\t\thtml+=markup;\n\t\t\t\t\t\t\tbreak;\t\n\t\t\t\t\t\tcase \"csv\":\n\t\t\t\t\t\t\thtml+=csvHTML(pre);\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tcase \"html\":\n\t\t\t\t\t\t\thtml+=pre.join(\"\\n\");\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tdefault:\n\t\t\t\t\t\t\tvar raw=escapeHTML(pre.join(\"\\n\"));\n\t\t\t\t\t\t\thtml+=\"<pre>\"+raw+\"</pre>\";\n\t\t\t\t\t}\n\t\t\t\t\tpre=[];\n\t\t\t\t\tfenced=false;\n\t\t\t\t}else{\n\t\t\t\t\tpre.push(line);\n\t\t\t\t}\n\t\t\t\tcontinue;\n\t\t\t}else{\n\t\t\t\tif(fence){\n\t\t\t\t\tlang=line.substring(3);\n\t\t\t\t\tfenced=true;\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t}\n\t\t\tvar dented=line.startsWith('\\t') || line.startsWith(\"    \");\n\t\t\tif(dented){\n\t\t\t\tif(!incode){\t\t\t\t\t\n\t\t\t\t\thtml+=\"<pre>\\n\";\n\t\t\t\t\tincode=true;\n\t\t\t\t}\n\t\t\t\thtml+=line+\"\\n\";\n\t\t\t}else{\n\t\t\t\tif(incode){\n\t\t\t\t\thtml+=\"</pre>\\n\";\n\t\t\t\t\tincode=false;\n\t\t\t\t}\n\t\t\t\tvar cells=line.split('|');\n\t\t\t\tif(cells.length>1){\n\t\t\t\t\tif(!intable){\n\t\t\t\t\t\thtml+=\"<table>\";\n\t\t\t\t\t\tintable=true;\n\t\t\t\t\t\theader=cells;\n\t\t\t\t\t\tcontinue;\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t\tif(header){\n\t\t\t\t\t\tvar dashes=cells[0].includes('---');\n\t\t\t\t\t\tif(dashes){\n\t\t\t\t\t\t\thtml+=\"<thead>\";\n\t\t\t\t\t\t\thtml+=markdownHeaders(header,dashes);\n\t\t\t\t\t\t\thtml+=\"</thead><tbody>\";\n\t\t\t\t\t\t\theader=null;\n\t\t\t\t\t\t\tcontinue;\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\thtml+=\"<tbody>\";\n\t\t\t\t\t\t\thtml+=markdownCells(header);\n\t\t\t\t\t\t}\n\t\t\t\t\t\theader=null;\n\t\t\t\t\t}\n\t\t\t\t\thtml+=markdownCells(cells);\n\t\t\t\t}else{\n\t\t\t\t\tif(header){\n\t\t\t\t\t\thtml+=markdownCells(header);\n\t\t\t\t\t\theader=null;\n\t\t\t\t\t}\n\t\t\t\t\tif(intable){\n\t\t\t\t\t\thtml+=\"</tbody></table>\"\n\t\t\t\t\t\tintable=false;\n\t\t\t\t\t}\n\t\t\t\t\thtml+=markdownLine(line);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t// todo check intable incode and fenced\n\t\tthis.content.innerHTML=html;\n\t\tthis.textarea.value=md;\n\t}\n\n\tpreview(){\n\t\tthis.writePage(this.textarea.value);\n\t}\n\n\tonPage(key,request){\n\t\tconsole.log(\"Wiki onPage \"+key)\t\t\n\t\tvar md=request.response;\n\t\tthis.writePage(md);\n\t}\n\n\trequestPage(uri,key){\n\t\tvar request=new XMLHttpRequest();\n\t\trequest.addEventListener(\"load\",this.onPage.bind(this,key,request));\n\t\trequest.open(\"GET\", uri);\n\t\trequest.setRequestHeader(\"Content-Type\",\"text/plain\");\n\t\trequest.setRequestHeader(\"Accept\",\"text/plain\");\n\t\ttry {\n\t\t\trequest.send();\n\t\t} catch (exception) {\n\t\t\tconsole.log(\"Wiki fetchPage exception: request.send() threw \" + exception);\n\t\t}\n\t}\n}\n\n// wiki div stack\n\nfunction initWiki(){\n\tvar div=document.getElementById(\"wiki\");\n\tif(!div) return;\n\twikiDiv=div;\n\taddTitle(wikiDiv,\"WIKI\");\n\twikiTools=addToolbar(wikiDiv);\n\twikiHome=addButton(wikiTools,\"Home\",homeWiki);\n\twikiRefresh=addButton(wikiTools,\"Refresh\",refreshWiki);\n\twikiAddress=addTextInput(wikiTools,\"Address\",onWikiAddress);\n\twikiEdit=addButton(wikiTools,\"Edit\",onWikiEdit);\n\twikiDebug=addButton(wikiTools,\"Debug\",onWikiDebug);\n\twikiPreview=addButton(wikiTools,\"Preview\",onWikiPreview);\n\twikiSave=addButton(wikiTools,\"Save\",onWikiSave);\n//\twikiEmoji=addButton(wikiTools,\"Emoji\",onWikiEmoji);\n\twikiRun=addButton(wikiTools,\"Run\",onWikiRun);\n/*\nredisDiv=addDiv(\"debugger\",wikiDiv);\nredisTools=addToolbar(redisDiv);\nredisClear=addButton(redisTools,\"Clear\",clearRedis);\nredisSubscribe=addButton(redisTools,\"Subscribe\",subscribeRedis);\nredisSink=addButton(redisTools,\"Sink\",sinkRedis);\nredisCommand=addInput(\"text\",redisTools,\"Command\");\nredisCommand.onchange=runRedis;\nredisText=addLog(redisDiv);\n*/\n\twiki=new Wiki(wikiDiv,null); //redisDiv\n\n\thomeWiki();\n\n\treturn wikiDiv;\n}\n\n\nfunction onJSONLoad(e){\n\tvar target=e.currentTarget;\n\ttry{\n\t\tvar response=JSON.parse(target.response);\n\t\ttarget.handler(response);\n\t}catch(exception){\n\t\tlog(\"onJSONLoad exception \"+exception.toString());\n\t\tlog(target.response);\n\t}\n}\n\nfunction getJSON(uri,handler){\n\tvar request=new XMLHttpRequest();\n\trequest.addEventListener(\"load\", onJSONLoad);\n\trequest.handler=handler;\n\trequest.open(\"GET\", uri);\n\trequest.setRequestHeader(\"Content-Type\",\"application/json\");\n\trequest.setRequestHeader(\"Accept\",\"application/json\");\n\ttry {\n\t\trequest.send();\n\t} catch (exception) {\n\t\tconsole.log(\"EXCEPTION: request.send() \" + exception);\n\t}\t\n}\n\nfunction onWikiWrite(reply){\n}\n\nfunction homeWiki(e){\n\tif(WikiAnchors){\n\t\tif(history.pushState) \n\t\t{\n\t\t\thistory.pushState(null, null, '#home');\n\t\t}\n\t\telse\n\t\t{\n\t\t\tlocation.hash='#home';\n\t\t}\n\t}\n\tgoWiki(\"banner\");\n}\n\nfunction onWikiClick(e){\n\tvar href=e.target.getAttribute(\"href\");\n\treturn false;\n}\n\nfunction refreshWiki(e){\n\tvar key=wiki.key;\n\tgoWiki(key);\n}\n\nfunction onWikiAddress(e){\n\tvar key=e.target.value;\n\tgoWiki(key);\n}\n\nfunction onWikiEdit(e){\n\twiki.edit();\n}\nfunction onWikiDebug(e){\n\twiki.debug();\n}\n\nfunction onWikiPreview(e){\n\twiki.preview();\n}\n\nfunction onWikiSave(e){\n\twiki.save();\n}\nfunction onWikiRun(e){\n\twiki.run();\n}\n\nfunction onWikiEmoji(e){\n\twiki.emoje();\n}\n\nfunction onWikiGet(redismd){\n//\tvar md=unescapeRedisString(redismd);\n\twiki.writePage(redismd);\n}\n\nfunction goWiki(key){\n\tkey=key.trim();\n\twikiAddress.value=key;\n\twiki.go(key);\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspscribe.js\",\"length\":11003,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspscribe.js\n// (C)2025 nitrologic\n// All rights reserved\n\nconst pi2=Math.PI*2;\n//const pi4=Math.PI/4;\n\nvar scribeCount=0;\nvar scribeCanvas;\nvar scribeFrameCount=0;\nvar scribeDevices=[];\n\nclass Scribe{\n\n\tdrawDrone(x,y){\n\t\tlet t=performance.now()/5000;\n\t\tlet a=t;\n\n\t\tlet sx=0.8+0.2*Math.sin(t*15);\n\t\tlet sy=0.8+0.2*Math.sin(t*25);\n\n\t\tthis.push(x,y,sx,sy,a);\n\n\t\tthis.box(-26,-26,24,24,8);\n\t\tthis.box(2,-26,24,24,8);\n\t\tthis.box(-26,2,24,24,8);\n\t\tthis.box(2,2,24,24,8);\n\n\t\tthis.pop();\n\n\t\tthis.text(\"drone\",x,y+24,2);\n\t}\n\n\tdrawPed(){\n\t\tconst context=this.context;\n\t\tconst x=0;\n\t\tconst y=0;\n\t\tlet t=performance.now()/250;\n\t\tlet tx=32*Math.sin(t);\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x-tx,y-10,14,8,2);\n\t\tcontext.roundRect(x+tx,y+2,14,8,2);\n\t\tcontext.stroke();\n\t}\n\n\t// head with arms\n\n\tdrawBot(x,y){\n\t\tconst context=this.context;\n\t\tcontext.strokeStyle=\"white\";\n\t\tcontext.lineWidth=1.2;\n\t\tcontext.beginPath();\n//\t\tcontext.lineTo(x+20,y+20);\n\t\tcontext.arc(x,y,20,0,pi2);\n\t\tcontext.arc(x,y,5,0,pi2);\n\t\tcontext.stroke();\n\t\t// left arm\n\t\tcontext.beginPath();\n\t\tcontext.arc(x,y-25,5,0,pi2);\n\t\tcontext.arc(x+15,y-25-5,5,0,pi2);\n\t\tcontext.arc(x+30,y-25-5,5,0,pi2);\n\t\tcontext.stroke();\n\t\t// right arm\n\t\tcontext.beginPath();\n\t\tcontext.arc(x,y+25,5,0,pi2);\n\t\tcontext.arc(x+15,y+25+5,5,0,pi2);\n\t\tcontext.arc(x+30,y+25+5,5,0,pi2);\n\t\tcontext.stroke();\n//\t\tthis.text(\"bot\",x,y+80,2);\n\t}\n/*\n\tdrawSit(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\t\t// swing feet below\n\t\tlet t=performance.now()/250;\n\t\tlet tx=6*Math.sin(t);\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x+tx+15,y-10,14,8,2);\n\t\tcontext.roundRect(x+tx+15,y+2,14,8,2);\n\t\tcontext.stroke();\n\t}\n\n\tdrawPed(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\t\t// swing feet below\n\t\tlet t=performance.now()/250;\n\t\tlet tx=32*Math.sin(t);\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x-tx,y-10,14,8,2);\n\t\tcontext.roundRect(x+tx,y+2,14,8,2);\n\t\tcontext.stroke();\n\t}\n\n\tdrawTruck(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\t\t// feet riding\n\t\tlet tx=20;\n\t\tcontext.roundRect(x+tx,y-10,14,8,2);\n\t\tcontext.roundRect(x+tx,y+2,14,8,2);\n\t\t// truck\n\t\tcontext.roundRect(x-88,y-50,176,100,15);\n\t\tcontext.roundRect(x+30,y-20,5,40,15);\n\t\tcontext.stroke();\n//\t\tcontext.beginPath();\n//\t\tcontext.roundRect(x-80,y-70,50,30,15);\n//\t\tcontext.roundRect(x-80,y+40,50,30,15);\n//\t\tcontext.stroke();\n\n\t\tlet t=performance.now()/355;\n\t\tlet alpha=Math.sin(t)/4;\n\n\t\tdrawWheel(context,x-60,y-50,0);\n\t\tdrawWheel(context,x-60,y+50,0);\n\t\tdrawWheel(context,x+60,y-50,alpha);\n\t\tdrawWheel(context,x+60,y+50,alpha);\n\t}\n\tdrawBoat(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x-96,y-40,198,80,15);\n\t\tcontext.roundRect(x+30,y-20,5,40,15);\n\t\tcontext.stroke();\n\t\tlet t=performance.now()/355;\n\t\tlet alpha=Math.sin(t)/4;\n\n\t\tdrawOutboard(context,x-100,y-30,alpha);\n\t\tdrawOutboard(context,x-100,y,alpha);\n\t\tdrawOutboard(context,x-100,y+30,alpha);\n\t}\n\n\tdrawKayak(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\t\t// feet\n\t\tlet tx=50;\n\t\tcontext.roundRect(x+tx,y-10,14,8,2);\n\t\tcontext.roundRect(x+tx,y+2,14,8,2);\n\t\t// hull\n\t\tcontext.roundRect(x-80,y-20,160,40,15);\n\t\tcontext.stroke();\n\t\t// oar\n\t\tcontext.beginPath();\n\t\tcontext.save();\n\t\tlet t=performance.now()/222;\n\t\tlet alpha=Math.sin(t);\n\t\tlet rx=Math.cos(alpha/6);\n\t\tlet ry=Math.sin(alpha/6);\n\t\tlet ox=20*Math.cos(alpha);\n\t\tcontext.setTransform(rx,ry,-ry,rx,x+18+ox,y);\n\t\tcontext.roundRect(-2.5,-80,5,160,15);\n\t\tcontext.stroke();\n\t\tcontext.restore();\n\n\t}\n\tdrawSnowboard(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\n\t\t// feet riding\n\t\tlet tx=12;\n\t\tcontext.roundRect(x+tx,y-16,14,8,2);\n\t\tcontext.roundRect(x+tx,y+8,14,8,2);\n//\t\tcontext.beginPath();\n\t\tcontext.roundRect(x-16,y-60,40,120,15);\n\t\tcontext.stroke();\n\t}\n\n\tdrawBike(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tconst w=canvas.width;\n\t\tconst h=canvas.height;\n\t\tthis.drawShip(canvas,x,y);\n\t\t// feet riding\n\t\tlet tx=20;\n\t\tcontext.roundRect(x+tx,y-20,14,8,2);\n\t\tcontext.roundRect(x+tx,y+12,14,8,2);\n\t\t// bike\n\t\tcontext.roundRect(x-64,y-10,40,20,5);\n\t\tcontext.stroke();\n//\t\tcontext.roundRect(x+32,y-5,40,10,5);\n//\t\tcontext.roundRect(x+50,y-20,4,40,5);\n\t\tcontext.beginPath();\n\t\tcontext.save();\n\t\tlet t=performance.now()/155;\n\t\tlet alpha=Math.sin(t)/8;\n\t\tlet rx=Math.cos(alpha);\n\t\tlet ry=Math.sin(alpha);\n\t\tcontext.setTransform(rx,ry,-ry,rx,x+54,y);\n\t\tcontext.roundRect(-24,-5,46,10,5);\n\t\tcontext.roundRect(-8,-20,4,40,5);\n\t\tcontext.stroke();\n\t\tcontext.restore();\n\t}\n\n\n\tdrawSpider(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tcontext.strokeStyle=\"white\";\n//\t\tcontext.lineWidth=0.4;\n\n\t\tcontext.beginPath();\n//\t\tcontext.lineTo(x+20,y+20);\n\n\t\tcontext.arc(x-4,y,14,0,pi2);\n\n\t\tcontext.arc(x+16,y,8,0,pi2);\n\t\tcontext.arc(x+16,y,3,0,pi2);\n\t\tcontext.stroke();\n\n\t\tcontext.beginPath();\n\n\t\tfor(let i=0;i<4;i++){\n\t\t\tlet ii=(i-1.5)*3;\n\t\t\tfor(let j=0;j<2;j++){\n\t\t\t\tlet side=1-j*2;\n\t\t\t\tfor(let k=0;k<3;k++){\n\t\t\t\t\tcontext.roundRect(x-24+i*10+ii*k,y-2+side*(16+k*4),4,4,2);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tcontext.stroke();\n\t\t\n\t}\n\n\tdrawDog(canvas,x,y){\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\t\tcontext.strokeStyle=\"white\";\n\t\tcontext.lineWidth=1.2;\n\n\t\tcontext.beginPath();\n//\t\tcontext.lineTo(x+20,y+20);\n\t\tcontext.arc(x+50,y,14,0,pi2);\n\t\tcontext.arc(x+50,y,5,0,pi2);\n\t\tcontext.stroke();\n\n\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x-20,y-15,58,30,12);\n\t\tcontext.roundRect(x-34,y-7,12,12,6);\n\t\tcontext.roundRect(x-50,y-6,10,10,4);\n\t\tcontext.stroke();\n\n\t\tlet t=performance.now()/150;\n\t\tlet tx=8*Math.sin(t);\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x-tx+24,y-20,14,8,2);\n\t\tcontext.roundRect(x+tx+24,y+12,14,8,2);\n\t\tcontext.roundRect(x+tx-24,y-20,14,8,2);\n\t\tcontext.roundRect(x-tx-24,y+12,14,8,2);\n\n\t\tcontext.stroke();\n\t}\n*/\n\n\ttext(text,x,y,z){\n\t\tlet context=this.context;\n\t\tconst font=IncittiVectorFont;\n\t\tfor(let ch of text){\n\t\t\tlet g=font[ch];\n\t\t\tif(g){\n\t\t\t\tlet n=g[0];\n\t\t\t\tfor(let i=0;i<n;i++){\n\t\t\t\t\tlet x0=g[i*4+1];\n\t\t\t\t\tlet y0=g[i*4+2];\n\t\t\t\t\tlet x1=g[i*4+3];\n\t\t\t\t\tlet y1=g[i*4+4];\n\t\t\t\t\tcontext.beginPath();\n\t\t\t\t\tcontext.moveTo(x+x0*z, y+y0*z);\n\t\t\t\t\tcontext.lineTo(x+x1*z, y+y1*z);\n\t\t\t\t\tcontext.stroke();\n\t\t\t\t}\n\t\t\t\tx+=z*6;\n\t\t\t}\n\t\t}\n\t}\n\n\tbox(x,y,w,h,r){\n\t\tlet context=this.context;\n\t\tcontext.beginPath();\n\t\tcontext.roundRect(x,y,w,h,r);\n\t\tcontext.stroke();\t\n\t}\n\n\trect(x,y,w,h){\n\t\tlet context=this.context;\n\t\tcontext.beginPath();\n\t\tcontext.rect(x-w/2,y-h/2,w,h);\n\t\tcontext.stroke();\t\n\t}\n\n\trib(x,y,w,h,amp){\n\t\tlet context=this.context;\n\t\tlet oy=amp*Math.cos(x/12);\n\t\tcontext.rect(x-w/2,oy+y-h/2,w,h);\n\t}\n\n\tdrawFish(x,y){\n\t\tlet context=this.context;\n\t\tcontext.beginPath();\n\t\tcontext.arc(x+8,y,8,0,pi2);\n\t\tlet t=performance.now()/800;\n\t\tlet amp=4*Math.sin(t);\n\t\tthis.rib(x-2,y,10,20,amp);\n\t\tfor(let i=0;i<4;i++){\n\t\t\tthis.rib(x-12-i*8,y,3,24-i*5,amp);\n\t\t}\n\t\tthis.rib(x-48,y,4,8,amp);\n\t\tcontext.stroke();\n\t}\n\n\tdrawBench(x,y){\n\t\tfor(let i=0;i<5;i++){\n\t\t\tthis.box(x-(i-1)*8,y-120,4,240);\n\t\t}\n\t}\n\n\tdrawPhone(x,y){\n\t\tthis.box(x-6,y-12,12,24,3);\n\t\tthis.text(\"phone\",x,y+24,2);\n\t}\n\n\tdrawPole(x,y){\n\t\tthis.box(x-1,y-82,2,102,3);\n\t\tthis.box(x+5,y,8,8,4);\n\t\tthis.text(\"pole\",x,y+24,2);\n\t}\n\n\tdrawRope(x,y){\n\t\tthis.box(x-10,y-10,20,20,8);\n\t\tthis.box(x-5,y-10,20,20,8);\n\t\tthis.text(\"rope\",x,y+24,2);\n\t}\n\n\tdrawDrones(x,y,n){\n\t\tfor(let i=0;i<n;i++){\n\t\t\tthis.drawDrone(x,y);\n\t\t\ty-=4;\n\t\t}\t\n\t}\n\n\tpush(x,y,sx,sy,a){\n\t\tlet context=this.context;\n\t\tlet cx=Math.cos(a);\n\t\tlet cy=Math.sin(a);\n\t\tcontext.save();\n\t\tcontext.transform(sx*cx,sx*cy,sy*-cy,sy*cx,x,y);\n\t}\n\n\tpop(){\n\t\tthis.context.restore();\n\t}\n\n\tthin(){\n\t\tthis.lineWidth=0.8;\n\t\tthis.context.lineWidth=this.lineWidth;\n\t}\n\n\tthick(){\n\t\tthis.lineWidth=3.2;\n\t\tthis.context.lineWidth=this.lineWidth;\n\t}\n\n\tcheckSize() {\n\t\tconst can = this.can;\n\t\tconst r = window.devicePixelRatio || 1;\n\t\tconst w = can.clientWidth|0;\n\t\tconst h = can.clientHeight|0;\n\t\tif (this.width != w || this.height != h || this.ratio != r) {\n\t\t\tthis.resizeDisplay(w, h, r);\n\t\t}\n\t}\n\n\tresizeDisplay(pixelwidth, pixelheight, pixelratio) {\n\t\tconst can = this.can;\n\t\tlet w = pixelwidth * pixelratio;\n\t\tlet h = pixelheight * pixelratio;\n\t\tcan.width=w;\n\t\tcan.height = h;\n\t\tthis.aspect = pixelwidth / pixelheight;\n\t\tthis.mousedown = false;\n\t\tthis.width = pixelwidth * pixelratio;\n\t\tthis.height = pixelheight * pixelratio;\n\t\tthis.ratio=pixelratio;\n\t\tthis.dirty = true;\n\t}\n\n\tbegin(canvas){\n\t\tthis.can=canvas;\n\n\t\tthis.checkSize();\n\n\t\tlet context=canvas.getContext(\"2d\",{antialias:false});\n\n\t\tlet w=this.width;\n\t\tlet h=this.height;\n\n\t\tthis.context=context;\n\n\t\tcontext.clearRect(0,0,w,h);\n\t\tcontext.fillStyle=\"white\";\n\t\tlet b=6;let c=2;\n\t\tcontext.fillRect(c,c,b-c,b-c);\n\t\tcontext.fillRect(w-b,c,b-c,b-c);\n\t\tcontext.fillRect(c,h-b,b-c,b-c);\n\t\tcontext.fillRect(w-b,h-b,b-c,b-c);\n\n\t\tcontext.strokeStyle=\"white\";\n\t}\n\n\tend(){\n\t\tthis.context=null;\n\t}\n}\n\n\nclass ScribeScene{\n\n\tconstructor(){\n\t\tthis.scribe=new Scribe();\n\t}\n\n\tdrawShapes(canvas){\n\n\t\tlet dy=240;\n/*\n\t\tthis.drawSpider(canvas,400,dy*2);\n\n\t\tthis.drawDog(canvas,600,dy*2);\n\n\t\tthis.drawPed(canvas,600,dy)\n\t\tthis.drawBike(canvas,800,dy)\n\t\tthis.drawSit(canvas,400,dy)\n\t\tthis.drawKayak(canvas,1000,dy)\n\t\tthis.drawTruck(canvas,1200,dy);\n\t\tthis.drawBoat(canvas,1700,dy);\n\n\t\tthis.drawSnowboard(canvas,1400,dy)\n\n\t\tthis.drawBall(canvas,100,366)\n*/\n\t\tlet ddy=dy-140;\n\n\t\tlet scrib=this.scribe;\n\n\t\tscrib.begin(canvas);\n\n\t\tscrib.drawBench(400,dy);\n\n\t\tscrib.thin();\n\t\tscrib.drawPhone(440,ddy);\n\t\tscrib.drawPole(540,ddy);\n\t\tscrib.drawRope(640,ddy);\n\n\t\tscrib.drawFish(740,ddy);\n\n//\t\tscrib.push()\n\n\t\tconst t=performance.now()/10;\n\t\tscrib.push(200+t&1023,500,1.0,1.0,0);\n\t\tscrib.drawBot(0,0);\n\t\tscrib.drawPed();\n\t\tscrib.pop();\n\n\n//\t\tscrib.drawDrones(840,dy+188,5);\n\t\tscrib.drawDrone(440,dy+140);\n\t\tscrib.end();\n\n\t\t// like boxes but in groups\n//\t\tlet hots=this.drawMenu(canvas,[\"Stars\",\"Grid\",\"susuwatari\",\"About\"],50,50);\n\n//\t\tthis.drawSoot(canvas,{});\n\t}\n\n\n}\n\nfunction pollScribeDisplay(){\n\tlet scene=new ScribeScene();\n\n\tscene.drawShapes(scribeCanvas);\n\n\twindow.requestAnimationFrame(pollScribeDisplay);\n\tscribeFrameCount++;\n}\n\nfunction initScribe(){\n\tscribeDiv=document.getElementById(\"scribe\");\n\tif(!scribeDiv) return false;\n\tscribeBar=addMinibar(scribeDiv);\n\n//\tdisplayFullscreen=addTool(scribeBar,\"⛶\",\"display.fullscreen\",fullscreenDisplay);\n\n\taddTitle(scribeDiv,\"Run Robot Run\");\n\tscribeTools=addToolbar(scribeDiv);\n\n\tvar div=addDisplay(scribeTools);\n\n\tvar can=addCanvas(div);\n\tvar id=\"scribe.canvas#\"+(scribeCount++);\n\tcan.id=id;\n\tscribeCanvas=can;\n\n\tpollScribeDisplay();\n\n\treturn true;\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspapp.js\",\"length\":10562,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspapp \n// (C)2025 nitrologic ALL RIGHTS RESERVED\n\n\"use strict\"\n\n// stack labels from items in spec array\nfunction SpecLabels(o){\n\tlet result=[];\n\tfor(let i of o){\n\t\tresult.push(i.label);\n\t}\n\treturn result;\n}\n\n// map spec default to slider range\nfunction SpecDefault(param){\n\tlet value=Number(param.default);\n\treturn SpecRange(param,value);\n}\n\n// map slider range to spec value\nfunction SpecValue(param,range){\n\tlet min=Number(param.min);\n\tlet max=Number(param.max);\n\tlet power=Number(param.power)||1\n\tlet curve=Math.pow(range/100,(power));\n\tlet value=min+curve*(max-min);\n\treturn value;\n}\n\n//  map spec value to slider range\nfunction SpecRange(param, value) {\n\tconst min=Number(param.min);\n\tconst max=Number(param.max);\n\tconst power=Number(param.power)||1;\n\tconst range=max-min;\n\tif (range===0) return 0;\n\tconst normalized=(value-min)/range;\n\tconst powered=Math.pow(normalized, 1/power);\n\treturn powered*100;\n}\n\nconst _LocalStorage=(typeof(Storage)!==\"undefined\")?window.localStorage:[];\n\nfunction SetStorageItem(key,object){\n\tif(object){\n\t\tconst value=JSON.stringify(object);\n\t\t_LocalStorage.setItem(key,value);\n\t}\n}\n\nfunction GetStorageItem(key){\n\tconst value=_LocalStorage.getItem(key);\n//\tconsole.log(\"GetStorageItem key : \"+key+\" value : \"+value);\n\treturn (!value)?null:JSON.parse(value);\n}\n\nfunction RemoveStorageItem(key){\n\t_LocalStorage.removeItem(key);\n\tconsole.log(\"RemoveStorageItem key : \"+key);\n}\n\n// set pixel size of canvas to match nearest integer client rectangle\n// based on css 100% rules applied to caller such as dspkeys canvas\n\nfunction resizeCanvas(canvas){\n\tlet pixelwidth=canvas.clientWidth;\n\tlet pixelheight=canvas.clientHeight;\t\n\tlet pixelratio=window.devicePixelRatio||1;\n\tlet w = (pixelwidth * pixelratio)|0;\n\tlet h = (pixelheight * pixelratio)|0;\n\tif(canvas.width!=w||canvas.height!=h){\n\t\tcanvas.width=w;\n\t\tcanvas.height=h;\n\t\treturn true;\n\t}\n\treturn false;\n}\n\n//const ResizeEventName=[\"resize\"];\nconst MouseEventNames=[\"mousedown\",\"mousemove\",\"mouseup\",\"mouseout\",\"mouseover\",\"mouseenter\",\"mouseleave\"];\nconst TouchEventNames=[\"touchstart\",\"touchend\",\"touchcancel\",\"touchmove\"];\nconst ForceTouchEventNames=[\"webkitmouseforcewillbegin\",\"webkitmouseforcechanged\",\"webkitmouseforcedown\",\"webkitmouseforceup\"];\nconst KeyEventNames=[\"keydown\",\"keyup\",\"keypress\"];\n\nconst BrowserKeyMask=[27,115,116,122,123];\t//Esc,F4,F5,F11,F12\n\nclass AppServer{\n\taddEvent(name,data){}\n\n}\nvar appServer=new AppServer();\n\n// note -> drawable touchable controlsurface -> note pad fader\n\nclass Applet\n{\n\t// interface\n\n\tnoteUnder(x,y){}\n\tdownNote(note,velocity){}\n\tupNote(note){}\n\tdrag(dx,dy){}\n\tjogZoom(deltaZoom){}\n\n\tfling(vx,vy,force){\n\t\tconsole.log(\"fling vx:\"+vx+\" vy:\"+vy+\" force:\"+force);\n\t}\n\n//\tdragnote(note,dx,dy){}\n\n\tconstructor(name){\n\t\tthis.id=name;\n\t\tthis.mousedown=false;\n\t\tthis.pointerTrack=[];\n\t\tthis.pixelSize=1.0;\n\t\tthis.touchNote=new Map();\n\t\tthis.touchPrevious=new Map();\n\t\tthis.mouseNote=0;\n//\t\tthis.note=false;\n\t}\n\n\trefresh(){\n\t\tthis.dirty=false;\n\t}\n\n\tresize(){\n//\t\tconsole.log(\"ResizeEvent applet dirty true\");\n\t\tthis.dirty=true;\n\t}\n\n\tkey(keyevent){\n\t\tconst type=keyevent.type;\n\t\tconst keycode=keyevent.keyCode;\n\t\tconst ts=keyevent.timeStamp;\n\t\tif(BrowserKeyMask.includes(keycode)) return;\n//\t\tconsole.log(type+keycode);\n\t\tswitch(type){\n\t\t\tcase \"keypress\":{\n\t\t\t\tif(!this.hitKey(keycode)) return;\n\t\t\t}break;\n\t\t\tcase \"keydown\":{\n\t\t\t\tappServer.addEvent(\"keydown\",{code:keycode,time:ts})\n\t\t\t}break;\n\t\t\tcase \"keyup\":{\n\t\t\t\tappServer.addEvent(\"keyup\",{code:keycode,time:ts})\n\t\t\t}\n\t\t}\n// passive says no preventDefault\n//\t\tkeyevent.preventDefault(); \n\t}\n\n\tforcetouch(touchevent){\n\t\tlog(\"forcetouch\");\n\t\ttouchevent.preventDefault();\n\t}\n\n\ttouch(touchevent){\n\t\ttouchevent.preventDefault(); \n\t\tconst type=touchevent.type;\n\t\tconst changed=touchevent.changedTouches;\n\t\tconst target=touchevent.targetTouches;\n\t\tconst touches=touchevent.touches;\n\t\tlet count=touches.length;\n\t\tconst scale=this.pixelSize;\n\t\tconst r=this.div.getBoundingClientRect();\n\t\tswitch(type){\n\t\t\tcase \"touchstart\":\n\t\t\t\tfor(let touch of target){\n\t\t\t\t\tlet x=touch.clientX*scale-r.left;\n\t\t\t\t\tlet y=touch.clientY*scale-r.top;\n\t\t\t\t\tlet v=100;// force disabled until further testing touch.webkitForce?touch.webkitForce*100:(touch.force?100000*touch.force:100);\n\t\t\t\t\tlet note=this.noteUnder(x,y);\n\t\t\t\t\tif(note){\n\t\t\t\t\t\tthis.downNote(note,v);\n\t\t\t\t\t\tthis.touchNote.set(touch.identifier,note);\n\t\t\t\t\t}\n\t\t\t\t\tthis.touchPrevious.set(touch.identifier,{x,y,v});\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\tcase \"touchmove\":\n\t\t\t\tfor(let touch of changed){\n\t\t\t\t\tlet x=touch.clientX*scale-r.left;\n\t\t\t\t\tlet y=touch.clientY*scale-r.top;\n\t\t\t\t\tlet note=this.noteUnder(x,y);\n\t\t\t\t\tlet defined=this.touchNote.has(touch.identifier);\n\t\t\t\t\tlet note0=defined?this.touchNote.get(touch.identifier):null;\n\t\t\t\t\tif(!note&&!note0){\n\t\t\t\t\t\t// noteless per finger previous trackers\n\t\t\t\t\t\tlet prev=this.touchPrevious.get(touch.identifier);\n\t\t\t\t\t\tif(prev){\n\t\t\t\t\t\t\tlet mx=x-prev.x;\n\t\t\t\t\t\t\tlet my=y-prev.y;\n\t\t\t\t\t\t\t// TODO: one finger may possibly change relative position of others when panning\n\t\t\t\t\t\t\tthis.drag(mx*2,my/scale);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\t// glissando touch\n\t\t\t\t\tif(note&& note!=note0)\n\t\t\t\t\t{\n\t\t\t\t\t\tthis.upNote(note0);\n\t\t\t\t\t\tlet velocity=50;\n//\t\t\t\t\t\tlet v=touch.webkitForce?touch.webkitForce*100:(touch.force?1000*touch.force:100);\n\t\t\t\t\t\tthis.downNote(note,velocity);\n\t\t\t\t\t\tthis.touchNote.set(touch.identifier,note);\n\t\t\t\t\t}\n\t\t\t\t\tlet p={x,y,v:100};\n\t\t\t\t\tthis.touchPrevious.set(touch.identifier,p);\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\tcase \"touchcancel\":\n\t\t\t\tbreak;\n\t\t\tcase \"touchend\":\n\t\t\t\tfor(let touch of changed){\n\t\t\t\t\tif(this.touchNote.has(touch.identifier))\n\t\t\t\t\t{\n\t\t\t\t\t\tlet note=this.touchNote.get(touch.identifier);\n\t\t\t\t\t\tthis.upNote(note);\n\t\t\t\t\t\tthis.touchNote.delete(touch.identifier);\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tlet x=touch.clientX*scale-r.left;\n\t\t\t\t\t\tlet y=touch.clientY*scale-r.top;\n\t\t\t\t\t\tthis.up({x,y});\n\t\t\t\t\t}\n\t\t\t\t\tthis.touchPrevious.delete(touch.identifier);\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t}\n\t}\n\n\tpointerTime(){\n\t\tconst t=this.pointerTrack.length-1;\n\t\tif(t>0){\n\t\t\tconst p0=this.pointerTrack[0];\n\t\t\tconst p1=this.pointerTrack[t];\n\t\t\treturn p1.ts-p0.ts;\n\t\t}\n\t}\n\n\tpointerSpeed(){\n\t\tconst n=this.pointerTrack.length;\n\t\tlet vx=0;\n\t\tlet vy=0;\n\t\tlet vv=0;\n\t\tlet t=n-1;\n\t\tlet stale=0;\n\t\twhile(t>1){\n\t\t\tconst p0=this.pointerTrack[t];\n\t\t\tconst p1=this.pointerTrack[t-1];\n\t\t\tconst dt=p0.ts-p1.ts;\n\t\t\tstale+=dt;\n\t\t\tif(stale>150){\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\tif(dt>0){\t\n\t\t\t\tconst m=15/dt;\n\t\t\t\tconst dx=(p0.x-p1.x)*m;\n\t\t\t\tconst dy=(p0.y-p1.y)*m;\n\t\t\t\tconst v=dx*dx+dy*dy;\n\t\t\t\tif(v>vv){\n\t\t\t\t\tvv=v;\n\t\t\t\t\tvx=dx;\n\t\t\t\t\tvy=dy;\n\t\t\t\t}\n\t\t\t}\n\t\t\tt--;\n\t\t}\n\t\treturn {x:vx,y:vy};\n\t}\n\n\trightMouse(mouseevent){\n\t\tconst type=mouseevent.type;\n\t\tconst buttons=mouseevent.buttons;\n\t\tswitch(type){\n\t\t\tcase \"mousedown\":{\n\t\t\t\tthis.mousedown=true;\n\t\t\t}break;\n\t\t\tcase \"mousemove\":{\n\t\t\t\tif(this.mousedown){\n\t\t\t\t\tconst mx=mouseevent.movementX;\n\t\t\t\t\tconst my=mouseevent.movementY;\n\t\t\t\t\tif(my*my>mx*mx){\n\t\t\t\t\t\tthis.addZoom(my);\n//\t\t\t\t\t\tthis.jogTilt(-my*0.1);\n\t\t\t\t\t}else{\n\t\t\t\t\t\t// reverse direction in bottom half\n\t\t\t\t\t\tthis.heading-=mx*32;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}break;\n\t\t\tcase \"mouseup\":{\n\t\t\t\tthis.pointerTrack=[];\n\t\t\t\tthis.mousedown=false;\n\t\t\t}break;\n\t\t\tcase \"mouseout\":{\n\t\t\t\tthis.mousedown=false;\n\t\t\t}break;\t\t\t\n\t\t\tcase \"mouseover\":\n\t\t\tcase \"mouseenter\":{\n\t\t\t\t\tthis.mousedown=buttons!=0;\n\t\t\t}break;\t\t\t\n\t\t}\n\t}\n\n\n\tmouse(mouseevent){\n\t\tconst scale=this.pixelSize;\n// not possible with passives\n//\t\tmouseevent.preventDefault(); \n\t\tconst type=mouseevent.type;\n\t\tconst buttons=mouseevent.buttons;\n\t\tconst ts=mouseevent.timeStamp;\n\n\t\tconst r=this.div.getBoundingClientRect();\n\n\t\tconst x=mouseevent.clientX*scale-r.left;\n\t\tconst y=mouseevent.clientY*scale-r.top;\n\t\tconst p={x,y,ts:ts};\n\n\t\tconst ctrl=mouseevent.ctrlKey;\n\n\t\tconst _buttons=this.mouseButtons||buttons;\n\t\tthis.mouseButtons=buttons;\n\t\tif(_buttons&2){\n\t\t\tthis.rightMouse(mouseevent);\n\t\t\treturn;\n\t\t}\n//\t\tlog(\"mouseevent type:\"+type);\n\t\tswitch(type){\n\t\t\tcase \"mousedown\":{\n//\t\t\t\tthis.canvas.focus();\n\t\t\t\tthis.pointerTrack.push(p);\n\t\t\t\tlet note=this.noteUnder(p.x,p.y);\n\t\t\t\tif(note){\n\t\t\t\t\tthis.mousedown=true;\n\t\t\t\t\tthis.downNote(note,100);\n\t\t\t\t}\n\t\t\t\tthis.mouseNote=note;\n\t\t\t}break;\n\t\t\tcase \"mousemove\":{\n\t\t\t\tif(this.mousedown){\n\t\t\t\t\tconst pp=this.pointerTrack.slice(-1)[0];\n\t\t\t\t\tthis.pointerTrack.push(p);\n\t\t\t\t\tconst mx=p.x-pp.x;//mouseevent.movementX;\n\t\t\t\t\tconst my=p.y-pp.y;//mouseevent.movementY;\n//\t\t\t\t\tconsole.log(\"mousemove drag \"+mx+\",\"+my);\n//\t\t\t\t\tthis.drag(p,-mx,my);\n\t\t\t\t\tlet note=this.noteUnder(p.x,p.y);\n\t\t\t\t\tif(!note && !this.mouseNote){\n\t\t\t\t\t\tthis.drag(mx,my);\n\t\t\t\t\t}\n\t\t\t\t\tif(note && note!=this.mouseNote){\n\t\t\t\t\t\tif(this.mouseNote) this.upNote(this.mouseNote);\n\t\t\t\t\t\tlet velocity=p.v?p.v*0.10:100;\n\t\t\t\t\t\tthis.downNote(note,velocity);\n\t\t\t\t\t\tthis.mouseNote=note;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}break;\n\t\t\tcase \"mouseup\":{\n\t\t\t\tthis.pointerTrack.push(p);\n\t\t\t\tif(this.mouseNote){\n\t\t\t\t\tthis.upNote(this.mouseNote);\n\t\t\t\t\tthis.mouseNote=0;\n\t\t\t\t}else{\n\t\t\t\t\tthis.up(p);\n\t\t\t\t}\n\t\t\t\tconst v=this.pointerSpeed();\n\t\t\t\tconst t=this.pointerTime();\n\t\t\t\tconst speed2=v.x*v.x+v.y*v.y;\n\t\t\t\tif(speed2>1){\n\t\t\t\t\tconst force=ctrl?3.0:1.0;\n\t\t\t\t\tthis.fling(-v.x,v.y,force);\n\t\t\t\t}else{\n\t\t\t\t\tif(t<200){\n\t\t\t\t\t\tthis.click(t);\n//\t\t\t\t\t\tconsole.log(\"mouse click\");\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tthis.mousedown=false;\n\t\t\t\tthis.pointerTrack=[];\n\t\t\t}break;\n\t\t\tcase \"mouseout\":{\n\t\t\t\tthis.mousedown=false;\n\t\t\t}break;\t\t\t\n\t\t\tcase \"mouseover\":\n\t\t\tcase \"mouseenter\":{\n//\t\t\t\tthis.mousedown=buttons!=0;\n\t\t\t}break;\t\t\t\n\t\t\tcase \"mouseleave\":\n\t\t\t\tif(this.mouseNote){\n\t\t\t\t\tthis.upNote(this.mouseNote);\n\t\t\t\t\tthis.mouseNote=0;\n\t\t\t\t}\n\t\t\t\tthis.mousedown=false;\n\t\t\t\tbreak;\n\t\t}\n\t}\n/* deprecated\n\twheel(wheelevent) {\n\t\twheelevent.preventDefault(); \n\t\tthis.jogZoom( wheelevent.deltaY/16);\n\t}\n*/\n\thitKey(keycode){\n//\t\tconsole.log(\"Applet hitkey keycode:\"+keycode);\n\t\treturn false;\n\t}\n\n\tdragNote(note,dx,dy){\n\t\tlog(\"drag dx:\"+dx+\" dy:\"+dy)\n\t}\n\n\tclick(t){\n//\t\tlog(\"click t:\"+t)\n\t}\n\n\taddEventHandlers(element,events,bind){\n\t\tfor(const eventname of events){\n\t\t\tvar options = {passive: false};\n//\t\t\tthis.canvas.addEventListener(eventname,bind,options);\n//\t\t\tif(this.video) this.video.addEventListener(eventname,bind,options);\n\t\t\telement.addEventListener(eventname,bind,options);\n\t\t}\n\t}\n\n\tbindEvents(node){\n//\t\tthis.addEventHandlers(node,ResizeEvents,this.resize.bind(this));\n\t\tthis.addEventHandlers(node,MouseEventNames,this.mouse.bind(this));\n\t\tthis.addEventHandlers(node,TouchEventNames,this.touch.bind(this));\n\t\tthis.addEventHandlers(node,KeyEventNames,this.key.bind(this));\n\t\tthis.addEventHandlers(node,ForceTouchEventNames,this.forcetouch.bind(this));\n\t\twindow.addEventListener(\"resize\",this.resize.bind(this));\n\t}\n\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dsptool.js\",\"length\":43276,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dsptool.js\n// (c)2025 Simon Armstrong\n// All rights reserved\n\n\"use strict\"\n\nconst AppVersion=\"MicroBit DSP 1.3.1\"\nconst AppBanner=AppVersion+\" ©2026 nitrologic, All Rights Reserved\";\nconst AppAbout=\"Private Lab Use Only.\\nPlease check system volume levels before switching Synth Vicious on.\";\n\n// a nitrohost fit3 client\n// depends: nitrogui.js nitrokernel.js dspwiki.js\n// onhash tracks wiki from here\n// const UnidentifiedAgent={brands:[],mobile:false,platform:\"\"};\n\nconst Permissions=[\n\t\"camera\",\n\t\"microphone\",\n\t\"display-capture\",\n\t\"geolocation\",\n\t\"notifications\",\n\t\"accelerometer\"\n];\n\nvar WatchDog=[];\n\nvar pageStatus,pageBody,pageTools,pageSettings,nightDay;\n\nvar rpcCount=0;\n\nvar sysDiv,sysUpgrade,sysInfos,sysTools,sysSpeak,sysScan,sysScanTop;\nvar sysPorts,sysIns,sysOuts,sysPCAP,sysRunApp,sysKillApp,sysRestart,sysShutdown,sysReset;\n\nvar SysStore={};\nvar SysSession,SysTick;\t// copied on tick\n\nvar logDiv,logTools,logClear,logText,logRefresh,logVals,logVars,logVarBar;\nvar logOnline;\nvar logFactoryReset;\n\nvar bluetoothDiv,bluetoothRefresh,bluetoothTools,bluetoothDevices,bluetoothConnections,bluetoothScripts,bluetoothImages;\nvar nmeaDiv,nmeaRefresh;\nvar uartDiv,uartRefresh,uartTools,uartPorts,uartConnections,uartMessage;\n\n//var actisenseDiv,actisenseRefresh,actisenseTools,actisenseDevices;\n//var redisDiv,redisTools,redisClear,redisSubscribe,redisSink,redisCommand,redisText;\n\nvar gpioDiv,gpioRefresh,gpioRegisters;\nvar pmicDiv,pmicRefresh,pmicTools,pmicRegisters;\nvar coproDiv,coproRefresh,coproTools,coproReset,coproScripts,coproSelect;\n\nvar dspDiv,dspRefresh,dspTools,dspAllRegisters;\nvar dspRegisters,dspGroups;\nvar dspReset,dspSelect,dspLoad,dspProgram,dspCompare;\nvar sigmaListen;\nvar layoutDiv,layoutTools,layoutPanel;\n\nvar scopeDiv,scope;\nvar memDiv,memRefresh,memValues;\nvar fbDiv,fbRefresh,fbImage,fbCount=0;\n\nconst nightDayStylesEmo={\n\tday:\"☀️ day\",\n\tnight:\"🌘 night\"\n//\tday:\"☀️\",\n//\tnight:\"🌑 🌒 🌓 🌔 🌕 🌖 🌗 🌘\"\n};\n\nconst nightDayStyles={\n\tday:\"day\",\n\tnight:\"night\"\n};\n\nfunction replaceString(a,b,c){\n\tvar split=a.split(b);\n\tvar join=split.join(c);\n\treturn join;\n}\n\nfunction shorten(number){\n\tif(number>=1e12) return (number/1e12).toFixed(3)+\"T\";\n\tif(number>=1e9) return (number/1e9).toFixed(3)+\"G\";\n\tif(number>=1e6) return (number/1e6).toFixed(3)+\"M\";\n\tif(number>=1e3) return (number/1e3).toFixed(3)+\"K\";\n\treturn number.toFixed(3);\n}\n\n// capture to host\n\nfunction log(line){\n\tconsole.log(line);\n\tvar text=document.createTextNode(line+\"\\n\");\n\tlogText.appendChild(text);\n\tlogText.scrollTop=logText.scrollHeight;\n\tvar message={src:\"log\",data:line};\n\tLocalEventQueueMessage(message);\n}\n\n// simon come here, escape comma in keys\n\nfunction unescapeRedisList(list){\n\tif(list.startsWith(\"[\") && list.endsWith(\"]\")){\n\t\tvar inner=list.substr(1,list.length-2);\n\t\tvar items=inner.split(\",\");\n\t\treturn items;\n\t}\n\treturn [];\n}\n\nfunction escapeRedisString(s){\n\tvar l=replaceString(s,\"\\\\\",\"\\\\\\\\\");\n\tvar e=replaceString(l,\"\\\"\",\"\\\\\\\"\");\n\tvar q=\"\\\"\"+e+\"\\\"\";\n\treturn q;\n}\n\nfunction unescapeRedisString(rs){\n\tvar s=rs.substr(1,rs.length-2);\n\tvar u=replaceString(s,\"\\\\\\\"\",\"\\\"\");\n\treturn u;\n}\n\nfunction onRPCLoad(e){\n\tvar target=e.currentTarget;\n\tvar response;\n\tif(target.status!=200){\n\t\tlog(\"RPC \"+target.rpc+\" Error status:\"+target.status+\" \"+target.statusText);\n\t}else{\n\t\ttry{\n\t\t\tresponse=JSON.parse(target.response);\n\t\t\tif(response.error){\n\t\t\t\tlog(\"RPC \"+target.rpc+\" Error response:\"+JSON.stringify(response.error));\n\t\t\t}else{\n\t\t\t\ttarget.handler(response.result,target.userdata);\n\t\t\t}\n\t\t}catch(exception){\n\t\t\tlog(\"onRPCLoad parse exception \"+exception.toString()+\" from \"+target.rpc);\n\t\t\tlog(target.response);\n\t\t}\n\t}\n}\n/*\n\t\ttry{\n\t\t\ttarget.handler(response.result,target.userdata);\n\t\t}catch(exception)\n\t\t{\n\t\t\tlog(\"onRPCLoad handler exception \"+exception.toString())\n\t\t\tfor(var property in exception){\n\t\t\t\tlog(\"\\t\"+property+\" = \"+exception[property]);\n\t\t\t}\n\t\t\tlog(target.rpc);\n\t\t\tlog(target.response);\n\t\t\tlog(target.userdata);\n\t\t}\n\t}\n*/\n\nfunction sendArray(uri,array){\n\tvar request=new XMLHttpRequest();\n\trequest.open(\"PUT\", uri);\n\trequest.setRequestHeader(\"Content-Type\",\"application/x-binary\");\n\ttry {\n\t\trequest.send(array);\n\t} catch (exception) {\n\t\tconsole.log(\"EXCEPTION: dsptool sendArray() \" + exception);\n\t}\n}\n\nfunction sendRPC(uri,method,params,handler,data){\n\tvar id=++rpcCount;\n\tvar json={jsonrpc:\"2.0\",id:id,method:method,params:params};\n\tvar body=JSON.stringify(json);\n\tvar param=JSON.stringify(params);\n\tvar rpc=method+\" (\"+param+\")\";\n// todo: optional rpc client logging\n//\tconsole.log(\"sendRPC \"+rpc+\" [\"+body.length+\"]\");\n\tvar request=new XMLHttpRequest();\n\trequest.addEventListener(\"load\", onRPCLoad);\n\trequest.handler=handler;\n\trequest.rpc=rpc;\n\trequest.userdata=data;\n\t// todo: explicit third parameter\n\trequest.open(\"POST\", uri);\n\trequest.setRequestHeader(\"Content-Type\",\"application/json\");\n\trequest.setRequestHeader(\"Accept\",\"application/json\");\n\ttry {\n\t\trequest.send(body);\n\t} catch (exception) {\n\t\tconsole.log(\"EXCEPTION: dsptool sendRPC() \" + exception);\n\t}\n}\n\n// DSP\n\nvar fixedPointOne=1<<24;\nvar fixedPointParams={};\nvar fixedPointInputs={};\nvar fixedPointChanged=[];\nvar paramDP=8;\n\nfunction onClickFavourite(e){\n\tvar button=e.target;\n\tvar address=button.getAttribute(\"address\");\n\tvar favourite=button.hasAttribute(\"favourite\");\n\tif(favourite){\n\t\tbutton.removeAttribute(\"favourite\",\"\")\n\t}else{\n\t\tbutton.setAttribute(\"favourite\",\"\")\n\t}\n}\n\nfunction onDSPRefresh(difList){\n\tfor(input of fixedPointChanged){\n\t\tinput.removeAttribute(\"changed\");\n\t}\n\tfixedPointChanged=[];\n\tvar n=difList.length;\n\tfor(var i=0;i<n;i+=2){\n\t\tvar address=difList[i+0];\n\t\tvar value=difList[i+1];\n\t\tvar input=fixedPointInputs[address];\n\t\tinput.value=(value/fixedPointOne).toFixed(paramDP);\n\t\tinput.setAttribute(\"changed\",\"\");\n\t\tfixedPointChanged.push(input);\n\t\tvar param=fixedPointParams[address];\n\t\tvar line=param.cell.name+\".\"+param.name+\"=\"+input.value+\" (\"+value+\")\";\n\t\tlog(line);\n\t}\n}\n\nfunction addFixedPoint(cell,param,group){\n\tvar address=param.address;\n\tif(address in fixedPointParams){\n\t\tconsole.log(\"multiple params for single address \"+address);\n\t}\n\tfixedPointParams[address]=param;\n\n\tvar span=document.createElement(\"span\");\n\tspan.className=\"param\";\n\tspan.setAttribute(\"fixedpoint\",\"\");\n\n\tvar input=document.createElement(\"input\");\n\tinput.setAttribute(\"type\",\"number\");\n\tinput.setAttribute(\"address\",address);\n\tinput.setAttribute(\"step\",0.01);\n\tinput.title=param.name;\n\tinput.value=(param.value/fixedPointOne).toFixed(paramDP);\n\tinput.onchange=setDSP;\n\n\tvar fave=document.createElement(\"button\");\n\tfave.className=\"favourite\";\n\tfave.setAttribute(\"address\",address);\n\tfave.onclick=onClickFavourite;\n//\tvar star=document.createTextNode(\"☆\");\n//\tfave.appendChild(star);\n\n\tvar div1=document.createElement(\"div\");\n\tdiv1.className=\"paramcell\";\n\tdiv1.title=cell.description;\n\tvar text1=document.createTextNode(cell.detail);\n\tdiv1.appendChild(text1);\n\n\tvar div2=document.createElement(\"div\");\n\tdiv2.className=\"paramname\";\n\tvar text2=document.createTextNode(param.name);\n\tdiv2.appendChild(text2);\n\n\tspan.appendChild(input);\n\tspan.appendChild(fave);\n\tspan.appendChild(div1);\n\tspan.appendChild(div2);\n\n\tgroup.appendChild(span);\n\n\tfixedPointInputs[address]=input;\n}\n\n\nfunction addDiv(type,group,name=\" \"){\n\tvar div=document.createElement(\"div\");\n\tdiv.className=type;\n\tif(name.trim().length>0){\n\t\tvar label=document.createElement(\"span\");\n\t\tlabel.className=type+\"label\";\n\t\tvar text=document.createTextNode(name);\n\t\tlabel.appendChild(text);\n\t\tdiv.appendChild(label);\n\t}\n\tgroup.appendChild(div);\n\treturn div;\n}\n\nfunction setRegister(name,high){\n\tif(gpioRegisters[name].checked!=high){\n\t\tgpioRegisters[name].checked=high;\n\t\tlog(\"gpio \"+name+\" = \"+(high?\"1\":\"0\"));\n\t}\n}\n\nfunction onGPIORegisters(registers){\n\tconsole.log(registers);\n\tif(gpioRegisters){\n\t\tfor(const register of registers){\n\t\t\tsetRegister(register.name,register.value==1);\n\t\t}\n\t}else{\n\t\tgpioRegisters=[];\n\t\tfor(const register of registers){\n\t\t\taddGPIO(register.name,register.value);\n\t\t}\n\t}\n}\n\nfunction refreshGPIO(){\n\tsendRPC(\"/api\",\"gpio.registers\",null,onGPIORegisters);\n}\n\nfunction onGPIOSet(result){\n}\n\nfunction toggleGPIO(e){\n\tvar checkbox=e.target;\n\tvar name=checkbox.getAttribute(\"gpioName\");\n\tvar value=checkbox.checked?true:false;\n\tsendRPC(\"/api\",\"gpio.set\",{[name]:value},onGPIOSet);\n}\n\nfunction addGPIO(name,value){\n\tvar checkbox=addInput(\"checkbox\",gpioDiv,name);\n\tcheckbox.onchange=toggleGPIO;\n\tcheckbox.setAttribute(\"gpioName\",name);\n\tcheckbox.checked=(value==1);\n\tgpioRegisters[name]=checkbox;\n\treturn checkbox;\n}\n\nfunction clearDSPRegisters(){\n\tdspRegisters=null;\n\tdspAllRegisters.innerHTML=\"\";\n}\n\nfunction toggleFolder(e){\n\tvar target=e.target;\n\tif(target.hasAttribute(\"closed\")){\n\t\ttarget.removeAttribute(\"closed\");\n\t}else{\n\t\ttarget.setAttribute(\"closed\",\"\");\n\t}\n\tvar content=target.querySelector(\".content\");\n\tif(content.hasAttribute(\"hidden\")){\n\t\tcontent.removeAttribute(\"hidden\");\n\t}else{\n\t\tcontent.setAttribute(\"hidden\",\"\");\n\t}\n}\n\n// used by onDSPProfile\n\nfunction addDSP(groups){\n\tconsole.log(\"addDSP\");\n\tdspGroups=groups;\n\tvar sorted=Object.keys(groups).sort();\n\tfor(var group of sorted){\n\t\tvar modDiv=addDiv(\"module\",dspAllRegisters,group);\n\t\tmodDiv.setAttribute(\"folder\",\"\");\n\t\tmodDiv.onclick=toggleFolder;\n\t\tvar content=addDiv(\"content\",modDiv);\n\t\tcontent.setAttribute(\"hidden\",\"\");\n\t\tvar blocks=Object.keys(groups[group]).sort();\n\t\tfor(var block of blocks){\n\t\t\tvar blockDiv=addDiv(\"block\",content,block);\n\t\t\tvar cells=groups[group][block];\n\t\t\tfor(var cellName in cells){\n\t\t\t\tvar cell=cells[cellName];\n\t\t\t\tfor(var param of cell.parameters){\n\t\t\t\t\tparam.cell=cell;\n\t\t\t\t\tswitch(param.type){\n\t\t\t\t\t\tcase \"FixedPoint\":\n\t\t\t\t\t\t\taddFixedPoint(cell,param,blockDiv);\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tcase \"HexArray\":\n//\t\t\t\t\t\t\tconsole.log(param.size);\t//8 or 20\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tdefault:\n\t\t\t\t\t\t\tconsole.log(param.type);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction onSigmaListen(sigmaStatus){\n\tlog(\"Sigma Studio Service - \"+sigmaStatus);\n}\n\nfunction onCoproImages(images){\n\tcoproSelect.innerHTML=\"\";\n\tfor(var image of images){\n\t\taddOption(coproSelect,image.hash,image.name)\n\t}\n}\n\nfunction onDSPProfiles(profiles){\n\tdspSelect.innerHTML=\"\";\n\tfor(var profile of profiles){\n\t\tvar line=profile.name+\" \"+profile.meta.major+\".\"+profile.meta.minor;\n\t\taddOption(dspSelect,profile.hash,line);\n\t}\n}\n\nfunction onDSPProfile(dspProfile){\n\tconsole.log(\"onDSPProfile\");//profile\n\tvar groups={};\n\n\tvar safeAddress=dspProfile.registers[\"__SafeLoad_Module__address_SafeLoad\"].address;\n\tvar safeData=dspProfile.registers[\"__SafeLoad_Module__data_SafeLoad\"].address;\n\tvar safeNum=dspProfile.registers[\"__SafeLoad_Module__num_SafeLoad\"].address;\n\n\tlog(\"DSP SafeLoad address:\"+safeAddress+\" data:\"+safeData+\" num:\"+safeNum);\n\n\tfor(var module of dspProfile.modules){\n\t\tvar names=module.name.split(\".\");\n\t\tvar group,block=\" \",name=\"\";\n\t\tgroup=names[0];\n\t\tif(names.length==2){\n\t\t\tname=names[1];\n\t\t}\n\t\tif(names.length==3){\n\t\t\tblock=names[1];\n\t\t\tname=names[2];\n\t\t}\n\t\tif(group in groups){\n\t\t\tif(block in groups[group]){\n\t\t\t\tgroups[group][block][name]=module;\n\t\t\t}else{\n\t\t\t\tgroups[group][block]={[name]:module};\n\t\t\t}\n\t\t}else{\n\t\t\tgroups[group]={[block]:{[name]:module}};\n\t\t}\n\t}\n\taddDSP(groups);\n}\n\nfunction onDSPLoad(profile){\n\tlog(\"DSP Programmed\")\n\tclearDSPRegisters();\n\tonDSPProfile(profile);\n}\n\nfunction onDSPProgram(profile){\n\tlog(\"DSP Programmed\")\n\tclearDSPRegisters();\n\tonDSPProfile(profile);\n}\n\nfunction onDSPCompare(diff){\n\tlog(\"DSP Comparison\")\n\tlog(JSON.stringify(diff,null,\"\\t\"));\n}\n\n\nfunction addInfo(name,value){\n\tSysStore[name]=value;\n\tvar info;\n\tif(sysDiv){\n\t\tinfo=addInput(\"text\",sysDiv,name,\"span\",\"box\");\n\t\tinfo.setAttribute(\"readonly\",\"\");\n\t\tinfo.value=value;\n\t\tsysInfos[name]=info;\n\t}\n\tif(name==\"name\"){\n\t\tdocument.title=value;\n\t}\n\treturn info;\n}\n\n// nitrojs Clock Time\n// addClock\n// refreshClocks resetClock\n\nfunction refreshClocks(){\n\tsendRPC(\"/api\",\"sys.clocks\",null,onClocks);\n}\n\nfunction resetClock(){\n\tvar millis=Date.now();\n\tsendRPC(\"/api\",\"sys.setclock\",millis,refreshClocks);\n}\n\nvar clockDiv,clockRefresh,clockTools,clockValues;\n\nfunction onClocks(sysClocks){\n\tif(clockValues){\n\t\tfor(const name of Object.keys(sysClocks)){\n\t\t\tvar value=sysClocks[name];\n\t\t\tclockValues[name].value=value;\n\t\t}\n\t}else{\n\t\tclockValues=[];\n\t\tfor(const name of Object.keys(sysClocks)){\n\t\t\tvar value=sysClocks[name];\n\t\t\taddClock(name,value);\n\t\t}\n\t}\n}\n\nfunction addClock(name,value){\n\tvar info=addInput(\"text\",clockDiv,name);\n\tinfo.setAttribute(\"readonly\",\"\");\n\tinfo.value=value;\n\tclockValues[name]=info;\n\treturn info;\n}\n\n// nitrojs various\n\nfunction addMemory(name,value){\n\tif(!memDiv) return null;\n\tvar info=addInput(\"text\",memDiv,name);\n\tinfo.setAttribute(\"readonly\",\"\");\n\tinfo.value=value;\n\tmemValues[name]=info;\n\treturn info;\n}\n\nfunction onFusionCommand(reply){\n\tconsole.log(\"onFusionCommand \"+JSON.stringify(reply));\n}\n\nfunction onPMICRead(values){\n\tconsole.log(\"onPMICRead \"+JSON.stringify(values));\n\tpmicRegisters.innerHTML=\"\";\n\tflushColumn(pmicRegisters);\n\tfor(var address=0;address<values.length;address++){\n\t\tvar register=addRegister(pmicRegisters,address,values[address]);\n\t\tregister.setAttribute(\"pmic.address\",address);\n\t}\n}\n\n\nfunction runCommand(){\n\tvar button=event.target;\n\tvar command=button.getAttribute(\"command\");\n\tsendRPC(\"/api\",command,null,onCommand);\n}\n\nfunction runCopro(){\n\tvar button=event.target;\n\tvar command=button.getAttribute(\"command\");\n\tsendRPC(\"/api\",\"copro.run\",{unit:\"\",command:command},onCoproRun);\n}\n\n\nfunction onMemory(sysMemory){\n\tif(memValues){\n\t\tfor(const name of Object.keys(sysMemory)){\n\t\t\tvar value=sysMemory[name];\n\t\t\tmemValues[name].value=value;\n\t\t}\n\t}else{\n\t\tmemValues=[];\n\t\tfor(const name of Object.keys(sysMemory)){\n\t\t\tvar value=sysMemory[name];\n\t\t\taddMemory(name,value);\n\t\t}\n\t\tvar available=sysMemory[\"PageSize\"]*sysMemory[\"Available\"]\n\t\tlog(\"Available Memory \"+shorten(available)+\"B\");\n\t\tvar physical=sysMemory[\"PageSize\"]*sysMemory[\"Physical\"]\n\t\tlog(\"Physical Memory \"+shorten(physical)+\"B\");\n\t}\n}\n\nvar PCAP_IF_LOOPBACK=0x00000001\t// interface is loopback\nvar PCAP_IF_UP=0x00000002\t// interface is up\nvar PCAP_IF_RUNNING=0x00000004\t// interface is running\nvar PCAP_IF_WIRELESS=0x00000008\t// interface is wireless (*NOT* necessarily Wi-Fi!)\nvar PCAP_IF_CONNECTION_STATUS=0x00000030\t// connection status:\nvar PCAP_IF_CONNECTION_STATUS_UNKNOWN=0x00000000\t// unknown\nvar PCAP_IF_CONNECTION_STATUS_CONNECTED=0x00000010\t// connected\nvar PCAP_IF_CONNECTION_STATUS_DISCONNECTED=0x00000020\t// disconnected\nvar PCAP_IF_CONNECTION_STATUS_NOT_APPLICABLE=0x00000030\t// not applicable\n\nfunction onInputs(devices){\n\tlog(\"System Input Device List\");\n\tlog(JSON.stringify(devices,null,\"\\t\"));\n}\n\nfunction onOutputs(devices){\n\tlog(\"System Output Device List\");\n\tlog(JSON.stringify(devices,null,\"\\t\"));\n}\n\nfunction onPCAP(results){\n//\tlog(JSON.stringify(results,null,\"\\t\",));\n\tlog(\"PCAP found\");\n\tfor(var nic of results){\n\t\tvar a=JSON.stringify(nic.addresses);\n\t\tvar line=\"\\t\"+nic.name+' '+nic.flags.toString(16)+\" \"+a;\n\t\tif(nic.description) line+=\" \"+nic.description;\n\t\tlog(line);\n\t}\n}\n\nfunction onReset(){\n}\n\nfunction onRun(){\n}\n\nfunction onRefresh(result){\n\tlocation.reload();\n}\n\nfunction onCoproRun(){\n\trefreshCopro();\n}\n\nfunction onCommand(){\n\n}\n\nfunction runApp(){\n\tsendRPC(\"/api\",\"sys.runapp\",null,onRun);\n}\n\nfunction killApp(){\n\tsendRPC(\"/api\",\"sys.killapp\",null,onRun);\n}\n\nfunction restartServer(){\n\tsendRPC(\"/api\",\"sys.restart\",null,onRun);\n}\n\nfunction onSay(){\n}\n\nfunction sayPhrase(){\n\tvar phrase=sysSpeak.value;\n\tsendRPC(\"/api\",\"sys.say\",{phrase:phrase},onSay);\n}\n\nfunction shutdownServer(){\n\tsendRPC(\"/api\",\"sys.shutdown\",null,onRun);\n}\n\nfunction resetServer(){\n\tsendRPC(\"/api\",\"sys.reset\",null,onReset);\n}\n\nfunction refreshServer(){\n\tsendRPC(\"/api\",\"sys.refresh\",null,onRefresh);\n}\n\nfunction refreshPCAP(){\n\tsendRPC(\"/api\",\"sys.pcap\",null,onPCAP);\n}\n\nfunction refreshLog(){\n\tfor(var key in ConnectedPorts){\n\t\tvar port=ConnectedPorts[key];\n\t\tport.read();\n\t}\n}\n\nvar onlineState=false;\n\nfunction onlineLog(){\n\tonlineState=!onlineState;\n\tEnablePolling(onlineState);\n\tif(onlineState){\n\t\tlogOnline.setAttribute(\"on\",\"\");\n\t}else{\n\t\tlogOnline.removeAttribute(\"on\");\n\t}\n}\n\nfunction clearRedis(){\n\tredisText.textContent=\"\";\n}\n\nfunction publishRedis(channel,message){\n\tvar command=utf8(\"publish \")+channel+\" \"+message;\n\tsendRPC(\"/api\",\"redis.run\",command,onRedisResult)\n}\n\nfunction postRedis(stream,nameValues){\n\tvar command=utf8(\"xadd \")+stream+\" * \"+nameValues;\t// \"message \"+message;\n\tsendRPC(\"/api\",\"redis.run\",command,onRedisResult)\n}\n\nfunction subscribeRedis(){\n\tsendRPC(\"/api\",\"redis.sub\",\"news\",onRedisResult)\n}\n\nfunction sinkRedis(){\n\tsendRPC(\"/api\",\"redis.sink\",\"logs\",onRedisResult)\n}\n\nfunction logRedis(line){\n\tconsole.log(line);\n\tvar text=document.createTextNode(line+\"\\n\");\n\tredisText.appendChild(text);\n\tredisText.scrollTop=redisText.scrollHeight;\n}\n\nfunction onRedisResult(result){\n\tlogRedis(\"onRedisResult:\"+result);//JSON.stringify(values));\n}\n\nfunction runRedis(e){\n\tvar command=e.target.value;\n\tlogRedis(\"Running \"+command);\n\tsendRPC(\"/api\",\"redis.run\",command,onRedisResult)\n}\n\nfunction refreshPMIC(){\n\tsendRPC(\"/api\",\"pmic.read\",null,onPMICRead);\n}\n\nfunction refreshMemory(){\n\tsendRPC(\"/api\",\"sys.memory\",null,onMemory);\n}\n\nfunction onSysPorts(sysPorts){\n\tfor(var index in sysPorts){\n\t\tvar port=sysPorts[index];\n\t\tlog(\"COM:\"+port.num+\" - \"+port.name);\n\t}\n}\n\n\n// digital signal processor\n\n// fetch a list of DSP images\n\nfunction refreshDSPProfiles(){\n\tsendRPC(\"/api\",\"dsp.profiles\",null,onDSPProfiles);\n}\n\n// listen for sigmastudio\n\nfunction listenSigma(e){\n\tvar target=e.target;\n\tvar verb=target.checked?\"connect\":\"disconnect\";\n\tsendRPC(\"/api\",\"sigma.listen\",verb,onSigmaListen);\n}\n\n// compare current DSP image with\n\nfunction compareDSPProfile(){\n\tsendRPC(\"/api\",\"dsp.compare\",null,onDSPCompare);\n}\n\n// refresh current DSP state called after upload, refresh button and timer\n\nfunction refreshDSPProfile(){\n\tsendRPC(\"/api\",\"dsp.refresh\",null,onDSPRefresh);\n}\n\nfunction onDragover(e){\n\te.preventDefault();\n}\n\n//const MaxTransferSize=3999000;\t// transfer limit is 3.9 MB\nconst MaxTransferSize=15999000;\t// transfer limit is 15.9 MB\nconst Base64Header=\"data:application/octet-stream;base64,\";\n\nfunction receiveFile(file){\n\tlet name=file.name;\n\tfile.arrayBuffer().then(function(arrayBuffer){\n\t\tvar blob=new Blob([arrayBuffer])\n\t\tvar reader=new FileReader();\n\t\treader.onload=function(event){\n\t\t\tvar content=event.target.result;\n\t\t\tif(content.startsWith(Base64Header)){\n\t\t\t\tcontent=content.substr(Base64Header.length);\n\t\t\t\tconsole.log(\"receiveFile stripped Base64Header\");\n\t\t\t}\n\t\t\tif(content.length>MaxTransferSize){\n\t\t\t\tconsole.log(\"receiveFile Content Too Large \"+content.length);\n\t\t\t\treturn;\n\t\t\t}\n\t\t\tconst raw=atob(content);\n\t\t\tconst n=raw.length;\n\t\t\tconst bytes=new Uint8Array(n);\n\t\t\tfor(let i=0;i<n;i++) bytes[i]=raw.charCodeAt(i);\n\t\t\tconst isMidi=(bytes[0]==77&&bytes[1]==84&&bytes[2]==104&&bytes[3]==100);\n\t\t\tif(isMidi){\n\t\t\t\tlet midi=parseMIDI(name,bytes);\n\t\t\t\tlet synth=synthLocal;\n\t\t\t\tlet synths=synthLocalArray;\n\t\t\t\tif(midi&&synths){\n\t\t\t\t\tPlayMidi(midi,synths);\n\t\t\t\t}\n\t\t\t}\n\n/* pass into redis.put\n\t\t\tvar fileType=file.type||\"text/plain\";\n\t\t\tvar transfer={name:file.name,size:file.size,type:fileType,content:content};\n\t\t\tsendRPC(\"/api\",\"redis.put\",transfer,onFileTransfer);\n*/\n\t\t};\n\t\treader.readAsDataURL(blob);\n\t}).catch(function(text){\n\t\tconsole.log(\"Error:\"+text);\n\t});\n}\n\nfunction onDropFile(e){\n\te.preventDefault();\n\tconsole.log(\"onDropFile:\"+e)\n\tif (e.dataTransfer.items) {\n\t\tfor (var i=0; i < e.dataTransfer.items.length; i++) {\n\t\t\tif (e.dataTransfer.items[i].kind === 'file') {\n\t\t\t\tvar file=e.dataTransfer.items[i].getAsFile();\n\t\t\t\treceiveFile(file);\n\t\t\t}\n\t\t}\n\t} else {\n\t\tfor (var i=0; i < e.dataTransfer.files.length; i++) {\n\t\t\treceiveFile(e.dataTransfer.files[i]);\n\t\t}\n\t}\n}\n\nfunction loadDSP(){\n\tvar param=dspSelect.value;\n\tsendRPC(\"/api\",\"dsp.load\",param,onDSPLoad);\n}\n\nfunction programDSP(){\n\tvar param=dspSelect.value;\n\tsendRPC(\"/api\",\"dsp.program\",param,onDSPProgram);\n}\n\nfunction compareDSP(){\n\tvar param=dspSelect.value;\n\tsendRPC(\"/api\",\"dsp.compare\",param,onDSPCompare);\n}\n\nfunction onDSPSet(result){\n}\n\nfunction setDSP(e){\n\tvar input=e.target;\n\tvar address=parseInt(input.getAttribute(\"address\"));\n\tvar value=(input.value*fixedPointOne)|0;\n\tsendRPC(\"/api\",\"dsp.set\",[address,value],onDSPSet);\n}\n\n// dac\n\nfunction resetDac(){\n\tsendRPC(\"/api\",\"dac.reset\",null,onDacReset);\n}\n\nfunction onDacReset(result){\n\tconsole.log(\"onDacReset \"+JSON.stringify(result));\n}\n\n// coprocessor\n\nfunction refreshCoproImages(){\n\tsendRPC(\"/api\",\"copro.images\",null,onCoproImages);\n}\n\nfunction resetCopro(){\n\tsendRPC(\"/api\",\"copro.reset\",null,onCoproReset);\n}\n\nfunction refreshCoproAPI(){\n\tsendRPC(\"/api\",\"copro.commands\",null,onCoproCommands);\n}\n\nfunction refreshCopro(){\n\tsendRPC(\"/api\",\"copro.refresh\",null,onCoproRefresh);\n}\n\nfunction onCoproReset(result){\n//\tconsole.log(\"onCoproReset \"+JSON.stringify(result));\n\trefreshCoproAPI();\n\trefreshGPIO();\n\trefreshCopro();\n}\n\n// TODO: document the makeButton embedding below\n\nfunction onCoproCommands(commands){\n\tconsole.log(\"onCoproCommands:\"+JSON.stringify(commands));\n\tcoproScripts.innerHTML=\"\";\n\tfor(var command of commands){\n\t\tvar button=function makeButton(group,name,handler){\n\t\t\tvar span=document.createElement(\"span\");\n\t\t\tspan.className=\"dspgroup\";\n\t\t\tvar button=document.createElement(\"button\");\n\t\t\tvar buttonText=document.createTextNode(name);\n\t\t\tbutton.onclick=handler;\n\t\t\tbutton.appendChild(buttonText);\n\t\t\tspan.appendChild(button);\n\t\t\tgroup.appendChild(span);\n\t\t\treturn button;\n\t\t}\n\n\t\tton(coproScripts,command,runCopro);\n\t\tbutton.setAttribute(\"command\",command);\n\t}\n}\n\nfunction decodeBase64(encoded){\n\tvar bin=atob(encoded);\n\tvar bytes=new Uint8Array(bin.length);\n\tfor (var i=0; i < bin.length; i++) {\n\t\tbytes[i]=bin.charCodeAt(i);\n\t}\n\treturn bytes;\n}\n\nfunction float32(bytes){\n\tvar view=new DataView(new ArrayBuffer(4));\n\tfor(var i=0;i<bytes.length;i++){\n\t\tview.setUint8(i, bytes[i]);\n\t}\n\treturn view.getFloat32(0);\n}\n\nfunction onCoproRefresh(result){\n\tif(result){\n\t\tfor(var packet of result){\n\t\t\tfor(command in packet){\n\t\t\t\tvar payload=decodeBase64(packet[command]);\n\t\t\t\tswitch(payload[0]){\n\t\t\t\t\tcase 3:\n\t\t\t\t\t\tif(payload[1]==1){\n\t\t\t\t\t\t\tvar version=payload[2]+(payload[3]<<8)+(payload[4]<<16)+(payload[5]<<24);\n\t\t\t\t\t\t\tvar mainBoard=payload[6];\n\t\t\t\t\t\t\tvar frontBoard=payload[7];\n\t\t\t\t\t\t\tvar ampBoard=payload[8];\n\t\t\t\t\t\t\tlog(\"Coprocessor version:\"+version+\" mainBoard:\"+mainBoard+\" frontBoard:\"+frontBoard+\" ampBoard\"+ampBoard);\n\t\t\t\t\t\t}\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase 11:\n\t\t\t\t\t\tvar ampTemp=float32([payload[1],payload[2],payload[3],payload[4]]);\n\t\t\t\t\t\tvar boardTemp=float32([payload[6],payload[7],payload[8],payload[9]]);\n\t\t\t\t\t\tlog(\"Coprocessor amp-temperature:\"+ampTemp+\" board-temperature:\"+boardTemp);\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tcase 14:\n\t\t\t\t\t\tvar watchdogState=payload[1]?\"On\":\"Off\";\n\t\t\t\t\t\tlog(\"Coprocessor watchdog:\"+watchdogState);\n\t\t\t\t\t\tbreak;\n\t\t\t\t\tdefault:\n\t\t\t\t\t\tlog(\"onCoproRefresh \"+command+\" \"+payload.toString());\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\n// framebuffer\n\nfunction onFBLoad(e){\n\n}\nfunction refreshFB(){\n\tif(!fbImage){\n\t\tfbImage=addImage(fbDiv,onFBLoad)\n\t}\n\tfbImage.src=\"dev/fb-\"+fbCount++;\n}\n\nfunction onBluetoothScan(status){\n}\n\nfunction scanBluetooth(){\n\tsendRPC(\"/api\",\"bt.scan\",null,onBluetoothScan);\n}\n\nfunction onBluetoothConfigure(status){\n}\n\nfunction configureBluetooth(){\n\tvar options=bluetoothDevices.selectedOptions;\n\tvar option=options[0];\n\tvar value=option.getAttribute(\"value\");\n\tvar address=parseInt(value,16);\n\tsendRPC(\"/api\",\"bt.configure\",address,onBluetoothConfigure);\n}\n\nfunction onBluetoothConnect(info){\n\taddOption(bluetoothConnections,info.address,info.name);\n}\n\nfunction connectBluetooth(){\n\tvar options=bluetoothDevices.selectedOptions;\n\tvar option=options[0];\n\tvar value=option.getAttribute(\"value\");\n\tvar bad=parseInt(value,16);\n\tsendRPC(\"/api\",\"bt.connect\",bad,onBluetoothConnect);\n}\n\nfunction runBluetoothScript(){\n\tvar button=event.target;\n\tvar script=button.getAttribute(\"script\");\n\tvar value=bluetoothConnections.value;\n\tvar address=parseInt(value,16);\n\tsendRPC(\"/api\",\"bt.invoke\",{address:address,script:script},onRun);\n}\n\nfunction onBluetoothUpdate(token){\n}\n\nfunction updateBluetooth(){\n\tvar value=bluetoothConnections.value;\n\tvar address=parseInt(value,16);\n\tvar image=bluetoothImages.value;\n\tsendRPC(\"/api\",\"bt.upload\",{address:address,image:image},onBluetoothUpdate);\n}\n\nfunction onBluetoothImages(images){\n\tbluetoothImages.innerHTML=\"\";\n\tfor(var image of images){\n\t\taddOption(bluetoothImages,image,image);\n\t}\n}\n\nfunction onBluetoothScripts(scripts){\n\tlog(\"onBluetoothScripts \"+JSON.stringify(scripts));\n//\tfillFAPI(bluetoothScripts,scripts,runBluetoothScript);\n}\n\nfunction onBluetoothPoll(lines){\n\tfor(var line of lines){\n\t\tlog(line);\n\t}\n}\n\nfunction onBluetoothDiscover(){\n\tlog(\"BT Discover\");\n}\n\nfunction onBluetoothDevices(list){\n\tbluetoothDevices.innerHTML=\"\";\n\tfor(var info of list){\n\t\taddOption(bluetoothDevices,info.address,info.name)\n\t}\n}\n\nfunction refreshBluetooth(){\n\tsendRPC(\"/api\",\"sys.images\",null,onBluetoothImages)\n\tsendRPC(\"/api\",\"fapi.scripts\",null,onBluetoothScripts);\n\tsendRPC(\"/api\",\"bt.devices\",null,onBluetoothDevices);\n}\n\nfunction initBluetooth(){\n\tbluetoothDiv=document.getElementById(\"bluetooth\");\n\tif(bluetoothDiv){\n\t\tbluetoothRefresh=addRefresh(bluetoothDiv,\"BLUETOOTH\",refreshBluetooth);\n//\taddTitle(bluetoothDiv,\"BLUETOOTH\");\n\t\tbluetoothTools=addToolbar(bluetoothDiv);\n\t\taddButton(bluetoothTools,\"Scan\",scanBluetooth);\n\t\tbluetoothDevices=addSelect(bluetoothTools,\"devices\");\n\t\taddButton(bluetoothTools,\"Configure\",configureBluetooth);\n\t\taddButton(bluetoothTools,\"Connnect\",connectBluetooth);\n\t\tbluetoothConnections=addSelect(bluetoothTools,\"connections\");\n\t\tbluetoothImages=addSelect(bluetoothTools,\"images\");\n\t\taddButton(bluetoothTools,\"Update\",updateBluetooth);\n\t\tbluetoothScripts=addToolbar(bluetoothDiv);\n//\t\tsessionHandler(\"bt.discover\",refreshBluetooth);\n\t}\n\tsessionHandler(\"bt.discover\",onBluetoothDiscover);\n}\n\nfunction onActisensePoll(messages){\n\tfor(var m of messages){\n\t\tvar json=JSON.stringify(m);\n\t\tlog(json);\n\t}\n}\n\nfunction pollActisense(){\n\tsendRPC(\"/api\",\"nmea.poll\",null,onActisensePoll);\n}\n\nfunction refreshNMEA(){\n\tsendRPC(\"/api\",\"nmea.hosts\",null,onNMEAHosts);\n}\n\n\nfunction onActisenseDevices(list){\n\tactisenseDevices.innerHTML=\"\";\n\tfor(var item of list){\n\t\taddOption(actisenseDevices,item.num,item.name);\n\t}\n}\n\nfunction onActisenseRefresh(){\n\t// NOP\n}\n\nfunction refreshActisense(){\n\tsendRPC(\"/api\",\"nmea.refresh\",null,onActisenseRefresh);\n}\n\nfunction enumerateActisense(){\n\tsendRPC(\"/api\",\"nmea.devices\",null,onActisenseDevices);\n}\n\nfunction onActisenseConnect(unit){\n\tlog(JSON.stringify(unit));\n}\n\nfunction attributeValue(select){\n\tvar options=select.selectedOptions;\n\tvar option=options[0];\n\tvar value=option.getAttribute(\"value\");\n\treturn value;\n}\n\nfunction connectActisense(){\n\tvar device=attributeValue(actisenseDevices);\n\tsendRPC(\"/api\",\"nmea.connect\",device,onActisenseConnect);\n}\n\nfunction onActisense(message){\n\tvar nmea=message.content;\n\tvar pgn=nmea.PGN;\n\tvar src=nmea.src;\n\tvar dest=nmea.dest;\n\tvar time=nmea.time;\n\tvar pri=nmea.priority;\n\tvar data=nmea.data;\n\tswitch(pgn){\n\t\tcase 126993:\n\t\t\tlog(\"NMEA 993: data:\"+JSON.stringify(data));\n\t\t\tbreak;\n\t\tcase 126720:\n\t\t\t// 163,153,24,0,0\n\t\t\tlog(\"NMEA 720: volume: \"+data[5]);\n\t\t\tbreak;\n\t\tdefault:\n\t\t\tlog(\"NMEA pgn unsupported \"+pgn);\n\t\t\tlog(\"NMEA RX:\"+JSON.stringify(message.content));\n\t}\n}\n\nfunction onSysOpen(handle){\n\tlog(\"onSysOpen:\"+handle);\n\taddOption(uartConnections,handle,handle);\n}\n\nfunction onSysWrite(status){\n\tlog(\"onSysWrite:\"+status);\n}\n\nfunction onSysClose(handle){\n\tlog(\"onSysClose:\"+handle);\n\tremoveOption(uartConnections,handle);\n}\n\nfunction openUART(){\n\tvar port=attributeValue(uartPorts);\n\tvar guid=\"123\";\n\tsendRPC(\"/api\",\"sys.open\",[port,guid],onSysOpen);\n}\n\nfunction messageUART(){// message box changed handler\n}\n\nfunction sendUART(){\n\tvar connection=attributeValue(uartConnections);\n//\tvar message=uartMessage.value+\"\\r\\n\";\n\tvar message=uartMessage.value+\"\\n\";\n\tuartMessage.value=\"\";\n\tsendRPC(\"/api\",\"sys.write\",[connection,message],onSysWrite);\n}\n\nfunction receiveUART(packet){\n//\tlog(\"RX:\"+JSON.stringify(packet));\n\tlog(\"[\"+packet.content.address+\"] \"+packet.content.data);\n}\nfunction closeUART(){\n\tvar connection=attributeValue(uartConnections);\n\tsendRPC(\"/api\",\"sys.close\",connection,onSysClose);\n}\n\nfunction onSysConnect(handle){\n//\tlog(\"onSysConnect:\"+handle);\n\taddOption(uartConnections,handle,handle);\n}\n\nfunction connectHost(){\n\tvar hostname=\"ono5\";\n\tsendRPC(\"/api\",\"sys.connect\",hostname,onSysConnect);\n}\n\nfunction onPorts(ports){\n\tuartPorts.innerHTML=\"\";\n\tfor(var port of ports){\n\t\taddOption(uartPorts,port.id,port.name+\" \"+port.description);\n\t}\n}\n\nfunction refreshPorts(){\n\tsendRPC(\"/api\",\"sys.ports\",\"\",onPorts);\n}\n\nfunction initComPorts(){\n\tuartDiv=document.getElementById(\"serial\");\n\tif(uartDiv){\n\t\tuartRefresh=addRefresh(uartDiv,\"UART\",refreshPorts);\n\t\tuartTools=addToolbar(uartDiv);\n\t\tuartPorts=addSelect(uartTools,\"devices\");\n\t\taddButton(uartTools,\"Open\",openUART);\n\t\tuartConnections=addSelect(uartTools,\"connections\");\n\t\tuartMessage=addTextInput(uartTools,\"Message\",messageUART,sendUART);\n\t\taddButton(uartTools,\"Transmit\",sendUART);\n\t\taddButton(uartTools,\"Close\",closeUART);\n\t\tsessionHandler(\"serial.rx\",receiveUART);\n\t\trefreshPorts();\n\t}\n}\n\nfunction initActisense(){\n\tactisenseDiv=document.getElementById(\"actisense\");\n\tactisenseRefresh=addRefresh(actisenseDiv,\"NMEA\",refreshActisense);\n//\taddTitle(actisenseDiv,\"ACTISENSE\");\n\tactisenseTools=addToolbar(actisenseDiv);\n\taddButton(actisenseTools,\"Discover\",enumerateActisense);\n\tactisenseDevices=addSelect(actisenseTools,\"devices\");\n\taddButton(actisenseTools,\"Connect\",connectActisense);\n\tenumerateActisense();\n\tsessionHandler(\"nmea.message\",onActisense);\n}\n\nfunction initFusionLink(){\n\tfapiDiv=document.getElementById(\"fusionlink\");\n\tfapiRefresh=addRefresh(fapiDiv,\"FUSION LINK\",refreshFAPI)\n\tfapiTools=addToolbar(fapiDiv);\n\taddTool(fapiTools,\"Listen\",\"fusion.listen\",runCommand);\n\taddTool(fapiTools,\"Probe\",\"fusion.probe\",runCommand);\n\taddTool(fapiTools,\"Mute\",\"fusion.mute\",runCommand);\n\taddTool(fapiTools,\"Unmute\",\"fusion.unmute\",runCommand);\n\taddTool(fapiTools,\"Power On\",\"fusion.poweron\",runCommand);\n\taddTool(fapiTools,\"Power Off\",\"fusion.poweroff\",runCommand);\n\tfapiSelect=addSelect(fapiTools,\"hosts\");\n\tfapiScripts=addToolbar(fapiDiv);\n\trefreshFAPI();\n}\n\nconst GridBrushes={\n\tpoint:\".\",\n\tdraw:\"/\",\n\tline:\"|\",\n\tlink:\"~\",\n\tbox:\"□\",\n\trect:\"■\"\n}\n\nconst GridTools={\n\tled:\"⊚\",\n\tlevel:\"🎚\",\n\tdelete:\"⌫\"\n}\n\nfunction initLayout(){\n\tlayoutDiv=document.getElementById(\"layout\");\n\tif(!layoutDiv) return false;\n\taddTitle(layoutDiv,\"LAYOUT\");\n\tlayoutTools=addToolbar(layoutDiv);\n//\taddStyleSelect(layoutTools,GridBrushes,onLayoutBrush)\n//\taddRadioButtons(layoutTools,\"tool\",GridTools,onLayoutTool)\n\tlayoutPanel=addDiv(\"panel\",layoutDiv);\n//\tlayoutGrid=addGrid(layoutPanel,160,120);\n\tlayoutGrid=addGrid(layoutPanel,16,12);\n\treturn true;\n}\n\nfunction onHash(){\n\tvar hash=location.hash;\n\tif(hash.length>6&&hash.startsWith('#wiki.')){\n\t\tvar key=hash.slice(6);\n\t\tgoWiki(key);\n\t}\n\telse if(hash.length>6&&hash.startsWith('#loc[')){\n\t\tvar gpn=hash.slice(4);\n\t\tconst gpn6=JSON.parse(gpn);\n\t\tgoWireLocation(gpn6);\n\t}else{\n\t\tconsole.log(\"dsptool::onHash \"+hash);\n\t}\n}\n\nvar eventHandlers={};//routes \"midi\" to onMidi\n\nvar messageHandlers={}; // aka SessionHandlers 1:1 connection\n\nfunction sessionHandler(type,handler){\n\tmessageHandlers[type]=handler;\n}\n\nvar RemoteHandlers={}\t// 1:n handlers\nfunction RemoteHandler(src,handler){\n\tif(!(src in RemoteHandlers)){\n\t\tRemoteHandlers[src]=[];\n\t}\n\tRemoteHandlers[src].push(handler);\n}\n\n\n\n// uart.io\n\n// dsptool session\n\nvar localEventCount=0;\nvar LocalEventQueue=[]\nvar LocalEventHandlers={}\nvar LocalEventRecording=[];\n\nfunction LocalEventHandler(src,handler){\n\tif(!(src in LocalEventHandlers)){\n\t\tLocalEventHandlers[src]=[];\n\t}\n\tLocalEventHandlers[src].push(handler);\n}\n\nfunction ClipRecording(){\n\tlet clip=LocalEventRecording;\n\tLocalEventRecording=[];\n\treturn clip;\n}\n\nfunction PlayClip(clip){\n\tplayEvent(clip,0);\n}\n\nfunction decodeHex16ToFloat64(hex) {\n    const count = hex.length / 4;\n\tconst mem64 = new Float64Array(count);\n    const gain16 = 0x7fff;\n\tfor (let i = 0; i < count; i++) {\n        const hexword = hex.substring(i * 4, i * 4 + 4);\n        let word = parseInt(hexword, 16);\n        if (word & 0x8000) {\n            word = word - 0x10000; // Subtract 2^16 to get the correct negative value\n        }\n        // Scale the sample value. The 20.0 factor is inherited from VSynthNode.onAudioIn\n        mem64[i] = (20.0 * word) / gain16;\n    }\n    return mem64;\n}\n\n// TODO: pass pcm packets to active synth\n\nfunction playEvent(clip,index){\n\tvar millis=performance.now();\n\tlet e=clip[index];\n\tlet synth=synthLocal;\n\twhile(e){\n\t\tswitch(e.src){\n\t\t\tcase \"midi\":\n\t\t\t\tif(synth){\n\t\t\t\t\tsynth.onMidi(e);\n\t\t\t\t}else{\n\t\t\t\t\tlog(\"synth unavailable\");\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\tcase \"pcm\":\n\t\t\t\tif(synth){\n\t\t\t\t\tsynth.onPCM(e);\n\t\t\t\t}else{\n\t\t\t\t\tlog(\"synth unavailable\");\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\tdefault:\n\t\t\t\tlog(\"playEvent unknown src\"+e.src);\n\t\t\t}\n\t\tlet ee=clip[++index];\n\t\tif(!ee){\n\n\t\t\treturn;\n\t\t}\n\t\tlet delay=ee.time-e.time;\n\t\tif(delay>0){\n\t\t\tsetTimeout(playEvent,delay*0.1,clip,index);\n\t\t\treturn;\n\t\t}\n\t\te=ee;\n\t}\n}\n\nfunction LogClip(clip){\n\tfor(let e of clip){\n//\t\tlet line=e.toString();\n\t\tlet line=JSON.stringify(e);\n\t\tlog(line);\n\t}\n}\n\nfunction clipToMidi(clip){\n\n}\nfunction SaveClip(clip, filename = \"generated.mid\") {\n\tconst midiData=clipToMidi();\n\tconst blob = new Blob([midiData], { type: \"audio/midi\" });\n\tconst url = URL.createObjectURL(blob);\n\tconst a = document.createElement(\"a\");\n\ta.href = url;\n\ta.download = filename;\n\tdocument.body.appendChild(a);\n\ta.click();\n\tdocument.body.removeChild(a);\n\tURL.revokeObjectURL(url);\n}\n\nfunction ClipStats(clip){\n\tlet stats={};\n\tfor(let e of clip){\n\t\tlet src=e.src;\n\t\tif(src in stats){\n\t\t\tstats[src]++;\n\t\t}else{\n\t\t\tstats[src]=1;\n\t\t}\n\t}\n\tlet r=[];\n\tfor(let src in stats){\n\t\tr.push(src+\" \"+stats[src]);\n\t}\n\treturn r.join(\" \");\n}\n\nfunction LocalEventQueueMessage(e){\n\tLocalEventQueue.push(e);\n\tLocalEventHandleMessage(e);\n}\n\nfunction LocalEventHandleMessage(e){\n\tLocalEventRecording.push(e);\n\tlocalEventCount++;\n\tlogVar(\"events\",localEventCount)\n\tvar src=e.src;\n\tif(src in LocalEventHandlers){\n\t\tvar handlers=LocalEventHandlers[src];\n\t\tfor(var handler of handlers){\n\t\t\thandler(e);\n\t\t}\n\t}\n}\nfunction LocalEventQueueFlush(){\n\tvar events=LocalEventQueue;\n\tLocalEventQueue=[];\n\treturn events;\n}\n\nvar RemoteEventHandlers={}\nfunction RemoteEventHandler(src,handler){\n\tif(!(src in RemoteEventHandlers)){\n\t\tRemoteEventHandlers[src]=[];\n\t}\n\tRemoteEventHandlers[src].push(handler);\n}\n\n// onTick\n\nvar PollMillis=0;\nvar PollSession=false;\n\nfunction onTick(tick){\n\tvar millis = performance.now();\n\tvar elapsed=PollMillis?(millis-PollMillis):0;\n//\tlogVal(\"pollSession.elapsed\",elapsed);\n\tlogVar(\"elapsed\",elapsed.toFixed(2));\n\tPollMillis=millis;\n\tvar index=tick.index;\n\tfor(var message of tick.messages){\n\t\tif(message.type==\"EventSink.underflow\"){\n\t\t\tcontinue;\n\t\t}\n\t\t// event and remotevent processing\n\t\tif(message.type==\"event\"){\n\t\t\tlet event=message.content;\n\t\t\tevent.tick=message.tick;\n\t\t\tevent.source=message.source;\n\t\t\tvar handlers=RemoteEventHandlers[event.src];\n\t\t\tif(handlers){\n\t\t\t\tfor(const handler of handlers){\n\t\t\t\t\thandler(event);\n\t\t\t\t}\n\t\t\t}else{\n\t\t\t\tif(event.src!=\"pcm\" && event.src!=\"log\")\n\t\t\t\t\tconsole.log(\"pollSession unhandled event:\"+JSON.stringify(message));\n\t\t\t}\n\t\t}else{\n\t\t\tvar sessionhandler=messageHandlers[message.type];\n\t\t\tvar handled=false;\n\t\t\tif(sessionhandler){\n\t\t\t\tsessionhandler(message)\n\t\t\t\thandled=true;\n\t\t\t}\n\n\t\t\tvar handlers=RemoteHandlers[message.type]||[];\n\t\t\tfor(var handler of handlers){\n\t\t\t\thandler(message);\n\t\t\t\thandled=true;\n\t\t\t}\n\n\t\t\tif(!handled){\n\t\t\t\tlog(\"pollSession unhandled message:\"+JSON.stringify(message));\n\t\t\t}\n\t\t}\n\t}\n\tif(PollSession){\n\t\tpollSession();\n\t}\n}\n\nfunction EnablePolling(enable){\n\tif(PollSession==enable){\n\t\treturn;\n\t}\n\tPollSession=enable;\n\tif(enable){\n\t\tpollSession();\n\t}\n}\n\n\n// first tick behavior -\n\nfunction pollSession(){\n\tvar recentEvents=LocalEventQueueFlush();\n\tvar tick=SysTick++;\n\tsendRPC(\"/api\",\"sys.tick\",{session:SysSession,tick,events:recentEvents},onTick);\n}\n\n\n// 10 pipes with usleep(2e3) at the other end = 20 ms target\n\nfunction pumpSession(){\n\tif(SysSession){\n\t\tlet count=2;\n\t\twhile(count-->0){\n\t\t\tpollSession();\n\t\t}\n\t}\n}\n\nfunction onSysInfo(sysInfo){\n\tlet latency=performance.now()-pollBegin;\n\tlogVar(\"ping\",latency.toFixed(2));\n\n\tif(sysInfos){\n\t\tfor(const name of Object.keys(sysInfo)){\n\t\t\tvar value=sysInfo[name];\n\t\t\tif(name in sysInfos){\n\t\t\t\tsysInfos[name].value=value;\n\t\t\t}\n\t\t\tif(name in SysStore){\n\t\t\t\tif(value!=SysStore[name]) log(\"New Info \"+name+\" \"+value);\n\t\t\t}else{\n\t\t\t\tSysStore[name]=value;\n\t\t\t}\n\t\t}\n\t}else{\n\t\tsysInfos={};\n\t\tvar user=\"guest\";\n\t\tvar host=\"localhost\";\n\t\tvar connection=0;\n\t\tfor(const name of Object.keys(sysInfo)){\n\t\t\tvar value=sysInfo[name];\n\t\t\taddInfo(name,value);\n\t\t\tif(name==\"Name\") host=value;\n\t\t\tif(name==\"User\") user=value;\n\t\t\tif(name==\"Session\") {\n\t\t\t\tSysSession=value;\n\t\t\t\tSysTick=0;\n\t\t\t}\n\t\t}\n\t\tlog(\"Connection courtesy \"+user + \" at \"+host+\" Session \"+SysSession);\n\t\tpumpSession();\n\t}\n}\n\nasync function queryScreens(){\n\ttry{\n\t\tconst details=await window.getScreenDetails();\n\t\tfor(const screen of details.screens){\n\t\t\tlet info={width:screen.width,height:screen.height,ratio:screen.devicePixelRatio};\n\t\t\tconsole.log(\"details:\"+JSON.stringify(info));\n\t\t}\n\t}catch(e){\n\t\tconsole.log(\"queryScreens error:\"+e.message);\n\t}\n}\n\n\nvar pollBegin;\n\nfunction refreshSession(){\n\tfor(const name of Permissions){\n\t\ttry{\n\t\t\tnavigator.permissions.query({ name:name }).then((result)=>{\n\t\t\t\tlet state=result.state;\n\t\t\t\tconsole.log(\"query result name:\"+name+\" state:\"+state);\n\t\t\t}).catch((err)=>{\n\t\t\t\tconsole.log(\"name:\"+name+\" err:\"+err);\n\t\t\t});\n\t\t}catch(exception){\n\t\t\tconsole.log(\"exception name:\"+name);\n\t\t}\n\t};\n\n\tlet s=window.screen;\n\tlet speech=!!speechSynthesis;\n\tconst agent = navigator.userAgentData||navigator;\n\tlet ratio=window.devicePixelRatio||1;\n\tlet xr=navigator.xr\n\n\tlet gyro=(typeof Gyroscope === \"function\");\n\tlet orient=(typeof OrientationSensor === \"function\");\n\tlet grav=(typeof GravitySensor==\"function\");\n\n\tconst platform=agent.platform;//+(navigator.userAgent||\"<null agent>\");\n\n\tlet userinfo={\n\t\ttouch:navigator.maxTouchPoints|0,\n\t\tlanguage:navigator.language,\n\t\tplatform,\n\t\tgyro,\n\t\torient,\n\t\tgrav,\n\t\tscreen:{\n\t\t\twidth:s.width,\n\t\t\theight:s.height,\n\t\t\tdepth:s.pixelDepth,\n\t\t\tratio,\n\t\t\tangle:s.orientation.angle,\n\t\t\trotation:s.orientation.type\n\t\t},\n\t\tmobile:agent.mobile,\n\t\tspeech\n\t};\n\tconsole.log(\"userinfo:\"+JSON.stringify(userinfo));\n\n\tpollBegin=performance.now();\n\tsendRPC(\"/api\",\"sys.info\",userinfo,onSysInfo);\n}\n\nfunction initUnits(){\n\tinitWiki();\n//\tinitPost();\n\t// may fails\n\tinitWire();\n//\tinitWASM();\n\tinitSynth();\n\tinitNavigator();\n\tinitProcess();\n\tinitStorage();\n\tinitNodes();\n\tinitAcid32();\n\tinitScribe();\n\tinitDisplay();\n\tinitExtern();\n\tInitSensors();\n\tInitControllers();\n\tinitVideo();\n\tinitMeter();\n\tinitLayout();\n\tinitWav();\n\tinitKeys();\n\tinitFloor();\n\tinitMidi();\n\tinitPico();\n//\tinitPool();\n//\tinitDaq();\n}\n\nasync function onFactoryReset(){\n\tlet key=\"dsptool.install\";\n\tRemoveStorageItem(key);\n\trefreshServer();\n}\n\nfunction initLog(){\n\tlogDiv=document.getElementById(\"log\");\n\taddTitle(logDiv,\"Log\");\n\tlogTools=addToolbar(logDiv);\n\n\tlogClear=addButton(logTools,\"Clear\",clearLog);\n\tlogRefresh=addButton(logTools,\"Flush\",refreshLog);\n\tlogRefresh=addButton(logTools,\"Refresh\",refreshSession);\n\tlogOnline=addButton(logTools,\"Online\",onlineLog);\n\tlogFactoryReset=addButton(logTools,\"Factory Reset\",onFactoryReset);\n\n\tlogText=addLog(logDiv);\n\tlogVars={}; // plain strings\n\tlogVals={};\t// have limits\n\tlogVarBar=addDiv(\"block\",logTools);\n}\n\nfunction clearLog(){\n\tlogText.textContent=\"\";\n\tfor(var name in logVals){\n\t\tlet varlimit=logVals[name];\n\t\tvarlimit.limit=0;\n\t\tvarlimit.filter=0;\n\t}\n}\n\nfunction logVar(name,label){\n\tlet varinfo=logVars[name];\n\tif(!varinfo){\n\t\tlet info=addInput(\"text\",logVarBar,name);\n\t\tinfo.setAttribute(\"readonly\",\"\");\n\t\tinfo.setAttribute(\"small\",\"\");\n\t\tvarinfo={info};\n\t\tlogVars[name]=varinfo;\n\t}\n\tlet var0=varinfo.info;\n\tvar0.value=label;\n}\n\nfunction logVal(name,value){\n\tif(!value)return;\n\tlet varlimit=logVals[name];\n\tif(!varlimit){\n\t\tlet info=addInput(\"text\",logVarBar,name);\n\t\tinfo.setAttribute(\"readonly\",\"\");\n\t\t// limit is peak until further notice\n\t\tvarlimit={info,limit:0,filter:0};\n\t\tlogVals[name]=varlimit;\n\t}\n\tif(value>varlimit.limit){\n\t\tvarlimit.limit=value;\n\t}\n\tvarlimit.filter=(varlimit.filter*8+value)/9;\n\tlet var0=varlimit.info;\n\tlet label=value.toFixed(2)+\" peak \"+varlimit.limit.toFixed(2)+\" ~ \"+varlimit.filter.toFixed(2);\n\tvar0.value=label;\n}\n\nfunction onFocus(){\n//\tconsole.log(\"FOCUS\")\n}\n\nfunction onLoad(){\n\tconst title=document.title;\t//DSP Diagnostics | Lab | Bike\n\tinitLog();\n\tlog(AppBanner);\n\tlog(AppAbout);\n\n\tpageStatus=document.getElementById(\"status\");\n\tconst quotedClass=\"\\\"title\\\"\";\n\tpageStatus.innerHTML=\"<span class=\"+quotedClass+\">\"+title+\"</span><br><small>ꔀ \"+AppVersion+\"</small>\";\n\n\tpageBody=document.body;\n\tpageBody.ondrop=onDropFile;\n\tpageBody.ondragover=onDragover;\n\n\tpageTools=document.getElementById(\"tools\");\n\n\tpageSettings=addDropdown(pageTools,\"⚙\")\n\tnightDay=addStyleSelect(pageTools,nightDayStyles,setPageStyle);\n\n\tpageBody.setAttribute(\"palette\",\"night\");\n\tselectOption(nightDay,1);\n\n\tif(document.title==\"NodeJS Tool\"){\n\t\treturn;\n\t}\n\n\tsysDiv=document.getElementById(\"system\");\n\tif(sysDiv){\n\t\tsysTools=addToolbar(sysDiv);\n\t\taddTitle(sysTools,\"Host\")\n\t\tsysUpgrade=addButton(sysTools,\"Upgrade\",refreshServer);\n\t}\n\n// TODO: enable admin features\n\n//\tsysShutdown=addButton(sysTools,\"Shutdown\",shutdownServer);\n//\tsysReset=addButton(sysTools,\"Reset\",resetServer);\n\n//\taddRedisKeyButton(sysTools,\"Sessions\",\"session\");\n//\taddRedisKeyButton(sysTools,\"Connections\",\"connection\");\n\n\tinitUnits();\n\n\t// dotnet framework C# host platform\n\n\tif(document.title==\"Framework Tool\"){\n\t\tsysSpeak=addTextInput(sysTools,\"Say\",sayPhrase);\n\t\tsysScan=addSelect(sysTools,\"scan\");\n\t\tinitWindowsScanPaths();\n\t\tsysScan.onchange=systemScanFiles;\n\t\tinitComPorts();\n\t\trefreshSession();\n\t\treturn;\n\t}\n\n//\tsysScan=addButton(sysTools,\"Scan Files\",systemScanFiles);\n//\tif(document.title==\"X64 Host\"){\n\tif(location.hostname==\"ono5\"){\n//\t\tinitFusionLink();\n//\t\tsysIns=addButton(sysTools,\"Inputs\",refreshInputs);\n//\t\tsysOuts=addButton(sysTools,\"Outputs\",refreshOutputs);\n\t\tsysPCAP=addButton(sysTools,\"PCAP\",refreshPCAP);\n\t\trefreshSession();\n\t\treturn;\n\t}\n\n\n\tinitComPorts();\n\n\tclockDiv=document.getElementById(\"time\");\n\tif(clockDiv){\n\t\tclockRefresh=addRefresh(clockDiv,\"TIME\",refreshClocks);\n//\t\tclockTools=addToolbar(clockDiv);\n//\t\taddButton(clockTools,\"RESET\",resetClock);\n\t\trefreshClocks();\n\t}\n\n\tmemDiv=document.getElementById(\"memory\");\n\tif(memDiv){\n\t\tmemRefresh=addRefresh(memDiv,\"MEMORY\",refreshMemory)\n\t\trefreshMemory();\n\t}\n\n\tfbDiv=document.getElementById(\"fb\");\n\tif(fbDiv){\n\t\tfbRefresh=addRefresh(fbDiv,\"FB\",refreshFB);\n\t}\n\n\tscopeDiv=document.getElementById(\"scope\");\n\tif(scopeDiv){\n\t\tscope=new Scope(scopeDiv);\n\t}\n\n\tif(document.title==\"DSP Lab\"){//\"Pi Host\"){\n//\t\tenumerateMedia();\n//\t\tenumerateMedia();\n\t\tsysScan=addSelect(sysTools,\"scan\");\n// TODO: FIX ME\t\t\n//\t\tinitPiScanPaths();\n//\t\tsysScan.onchange=systemScanFiles;\n\t}\n\n//\trefreshGPIO();\n\trefreshSession();\n}\n\nwindow.onfocus=onFocus;\nwindow.onload=onLoad;\nwindow.onhashchange=onHash;\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspwav.js\",\"length\":1940,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspwav\r\n// (C)2024 nitrologic\r\n// ALL RIGHTS RESERVED\r\n\r\n// currently removed due to midi mapping requirements\r\n\r\n\"use strict\"\r\n\r\nvar wavDiv;\r\nvar wavTools;\r\nvar wavSweeps;\r\nvar wavPlayer;\r\nvar wavVolume;\r\nvar wavLoop;\r\nvar wavPause;\r\n\r\nfunction playWav(){\r\n\tvar wav=wavSweeps.value;\r\n\tvar volume=wavPlayer.volume;\r\n\twavPlayer.src=wav;\r\n\twavPlayer.volume=volume;\r\n\tif(!wavPause.checked){\r\n\t\ttry\r\n\t\t{\r\n\t\t\t var promise = wavPlayer.play().catch(onWavCatch);\r\n\t\t}\r\n\t\tcatch(e)\r\n\t\t{\r\n\t\t\tlog(e.toString());\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction onWavVolume(){\r\n\tvar range=event.target;\r\n\tvar value=range.value|0;\r\n\twavPlayer.volume=value/100.0;\r\n\tlabelInput(wavVolume,\"Volume:\"+value);\r\n}\r\n\r\nfunction onWavLoop(){\r\n\twavPlayer.loop=wavLoop.checked;\r\n}\r\n\r\nfunction onWavCatch(error)\r\n{\r\n\tconsole.log(error.message);\r\n}\r\n\r\nfunction onWavPause(){\r\n\tvar pause=wavPause.checked;\r\n\tif(wavPlayer.paused!=pause){\r\n\t\tif(pause){\r\n\t\t\twavPlayer.pause();\r\n\t\t}else{\r\n\t\t\twavPlayer.play();\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction initWav(){\r\n\twavDiv=document.getElementById(\"wav\");\r\n\tif(!wavDiv) return false;\r\n\taddTitle(wavDiv,\"Waveform Generator\");\r\n\twavTools=addToolbar(wavDiv);\r\n\twavSweeps=addMidiSelect(wavTools,\"sweeps\",47,48);\r\n\twavSweeps.onchange=playWav;\r\n\tvar names=[\r\n\t\t\"noise16.wav\",\r\n\t\t\"sin1khz.wav\",\r\n\t\t\"sin10khz.wav\",\r\n\t\t\"siren5khzto15khz.wav\",\r\n\t\t\"siren50to5000hz.wav\",\r\n\t\t\"06 Kashmir.wav\",\r\n\t\t\"sinA440.wav\",\t\r\n\t\t\"sin100hz.wav\",\t\r\n\t\t\"sin50khz.wav\",\t\r\n\t\t\"sin100khz.wav\",\t\r\n\t\t\"sin1mhz.wav\",\r\n\t];\r\n\tfor(var name of names)\r\n\t{\r\n\t\taddOption(wavSweeps,\"nitrojs/wav/\"+name,name);\r\n\t}\r\n\r\n\twavPlayer=addAudio(wavTools,\"wavplayer\",\"nitrojs/wav/\"+names[0]);\t\r\n\twavVolume=addMidiSlider(wavTools,\"volume\",24,onWavVolume,16);\r\n\twavLoop=addMidiToggle(wavTools,\"loop\",onWavLoop,49);\r\n\twavPause=addMidiToggle(wavTools,\"pause\",onWavPause,50);\r\n\taddMidiTool(wavTools,\"Play\",\"wav.play\",playWav,47);//TODO: unclash dsptool usage 47 -> 45 PLAY\r\n\r\n\tcleanMidiControls();\t\r\n\treturn true;\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspextern.js\",\"length\":777,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspjs dspextern\r\n// work in progress project roa embed\r\n\r\n\"use strict\"\r\n\r\nvar externDiv,externTools,externSources;\r\n\r\nfunction addEmbed(group,src){\r\n\tvar embed = document.createElement(\"embed\");\r\n\tembed.className=\"dspembed\";\r\n\tembed.src=src;//\"http://ono5:8081\";\r\n\tgroup.appendChild(embed);\r\n\treturn embed;\r\n\t//<embed type=\"text/html\" src=\"slurpit.html\" width=\"500\" height=\"200\">\r\n}\r\n\r\nfunction addExtern(group){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"dspextern\";\r\n\tgroup.appendChild(div);\r\n\treturn div;\r\n}\r\n\r\n\r\nfunction initExtern(){\r\n\texternDiv=document.getElementById(\"extern\");\r\n\tif(!externDiv) return false;\r\n\taddTitle(externDiv,\"Extern\");\r\n\texternTools=addToolbar(externDiv);\r\n//\tvar d=addExtern(externTools);\r\n//\taddEmbed(d);\r\n    return true;\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspkernel.js\",\"length\":997,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspkernel.js \n// (c)2024 Simon Armstrong\n// All rights reserved\n\n// redis dictionary api \n// kernel methods need auth\n// slide -> redis\n// dspkernel -> nitro-redis\n\n\"use strict\"\n\nconst KeyPrefix=\"nitrodsp.\";\n\nfunction onRedisRange(result,key){\n\tlog(\"onRedisRange \"+key+\":\"+result.join('\\r\\n'));\n\tfor(var index in result){\n\t\tvar item=result[index];\n\t}\n}\n\nfunction onRedisDelete(result,key){\n\tlog(\"onRedisDelete: key \"+key+\":\"+result);\n}\n\nfunction onRedisButton(buttonEvent){\n\tvar remove=buttonEvent.ctrlKey;\n\tvar button=buttonEvent.target;\n\tif(button.hasAttribute(\"key\")){\n\t\tvar key=button.getAttribute(\"key\");\n\t\tif(remove){\n\t\t\tvar command=\"DEL \"+KeyPrefix+key\n\t\t\tsendRPC(\"/api\",\"redis.run\",command,onRedisDelete,key);\t\n\t\t}else{\n\t\t\tvar command=\"LRANGE \"+KeyPrefix+key+\" 0 -1\";\n\t\t\tsendRPC(\"/api\",\"redis.run\",command,onRedisRange,key);\t\n\t\t}\n\t}else{\n\t\tlog(\"onRedisButton: no key attribute\");\n\t}\n}\n\nfunction addRedisKeyButton(parent,name,key){\n\taddButton(sysTools,name,onRedisButton,{\"key\":key});\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspnavigator.js\",\"length\":14427,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspnavigator\r\n// (C)2024 nitrologic\r\n// ALL RIGHTS RESERVED\r\n\r\n\r\n\"use strict\"\r\n\r\nvar navigatorDiv;\r\n\r\nvar audioTools,audioIns,audioOuts,audioCanvas,audioPlayer;\r\nvar videoSources;\r\n\r\nvar serialTools,serialPorts,serialConnect,serialDisconnect;\r\nvar serialSendText;\r\n\r\nvar MediaStreams=[];\r\nvar SerialPorts=[];\r\nvar ConnectedComPorts={};\r\n\r\nvar audioAnimationId;\r\nvar audioAnimationTime;\r\n\r\n// webpc\r\n\r\nvar pcPads;\r\n\r\n// webaudio\r\n\r\nvar audioContext\r\n\r\nvar audioSource,audioNode,scriptNode,workletNode,microphone;\r\n\r\nclass MediaStream{\r\n\tconstructor(stream){\r\n\t\tthis.stream=stream;\r\n\t\tstream.onaddtrack=this.addTrack.bind(this);\r\n\t\tthis.tracks=stream.getTracks();\r\n//\t\tReturns a list of all MediaStreamTrack objects stored in the MediaStream object, regardless of the value of the kind attribute. The order is not defined, and may not only vary from one browser to another, but also from one call to another.\r\n\t\tthis.videotracks=stream.getVideoTracks();\r\n\t\tfor(var track of this.videotracks){\r\n\t\t\tvar imageCapture = new ImageCapture(track);\r\n\t\t\tvar caps=imageCapture.getPhotoCapabilities().then(function(caps2){\r\n\t\t\t\tlog(\"track image caps:\"+JSON.stringify(caps)+JSON.stringify(caps2));\r\n\t\t\t});\r\n\t\t}\r\n\t}\r\n\taddTrack(track){\r\n\t\tlog(\"AddTrack:\");\r\n\t}\r\n}\r\nfunction mediaGranted(stream) {\r\n\tif(!audioAnimationId){\r\n\t\taudioAnimationId=window.requestAnimationFrame(audioAnimation);\r\n\t}\r\n\tvar mediaStream=new MediaStream(stream);\r\n\tMediaStreams.push(mediaStream);\r\n\taudioContext.audioWorklet.addModule('nitrojs/dspprocessor.js').then(function(){\r\n\t\tclass DSPNode extends AudioWorkletNode {\r\n\t\t\tonDSPMessage(e){\r\n\t\t//\t\tconsole.log(\"DSPNode onDSPMessage:\");\r\n\t\t\t\tthis.leftFragments.push(e.data.left);\r\n\t\t\t\tthis.rightFragments.push(e.data.right);\r\n\t\t\t\tthis.reads+=e.data.left.length+e.data.right.length;\r\n\t\t\t\tvar count=e.data.count;\r\n\t\t//\t\tconsole.log(count);\r\n\t\t\t}\r\n\r\n\t\t\tconstructor(context) {\r\n\t\t\t\tsuper(context,'NitroAudioProcessor');\r\n\t\t\t\tthis.leftFragments=[];\r\n\t\t\t\tthis.rightFragments=[];\r\n\t\t\t\tthis.reads=0;\r\n\t\t\t\tthis.port.onmessage=this.onDSPMessage.bind(this);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\t\taudioSource=audioContext.createMediaStreamSource(stream);\r\n\t\taudioNode=new DSPNode(audioContext);\r\n\t\taudioSource.connect(audioNode)\r\n\t\taudioNode.connect(audioContext.destination);\r\n\r\n// TODO: MediaStreamAudioSourceNode has no start\r\n//\t\taudioSource.start();\r\n\t});\r\n}\r\n\r\nfunction mediaDenied(e) {\r\n\tlog('dspnavigator mediaDenied:'+e.message);\r\n}\r\n\r\n// prompt the user for permission to use media input to stream video\r\n\r\nfunction streamMedia(){\r\n\taudioContext=new AudioContext();\r\n//\tnavigator.getUserMedia({ audio: true, video: true },mediaGranted,mediaDenied);\r\n\tnavigator.mediaDevices\r\n\t.getUserMedia(constraints)\r\n\t.then((stream) => {\r\n\t\tmediaGranted(stream);\r\n\t})\r\n\t.catch((err) => {\r\n\t\tmediaDenied(err);\r\n\t});\r\n}\r\n\r\n// prompt the user for permission to use media input to monitor audio\r\n\r\nfunction monitorAudio(){\r\n\tvar device=audioIns.value;\r\n\tvar audioInConstraints={\r\n//\t\tvideo: {\r\n//\t\t\tgroupId:devinfo[0],\r\n//\t\t\tdeviceId:devinfo[1]\r\n//\t\t},\r\n\t\taudio: {\r\n\t\t\tdeviceId:device?{exact:device}:undefined,\r\n\t\t\techoCancellation: true,\r\n\t\t\tautoGainControl: false,\r\n\t\t\tnoiseSuppression: false\r\n\t\t}\r\n\t}\r\n\t// TODO: use current audioins setting\r\n\taudioContext=new AudioContext();\r\n\t//\tnavigator.getUserMedia({ audio: true, video: false },mediaGranted,mediaDenied);\r\n\tnavigator.mediaDevices\r\n\t.getUserMedia(audioInConstraints)\r\n\t.then((stream) => {\r\n\t\tmediaGranted(stream);\r\n\t})\r\n\t.catch((err) => {\r\n\t\tmediaDenied(err);\r\n\t});\r\n\r\n}\r\n\r\n//\r\n\r\nfunction onPlayAudio(deviceInfo){\r\n\tlog(\"playing on \"+deviceInfo.label);\r\n}\r\n\r\nfunction onPlayAudioError(e){\r\n\r\n}\r\n\r\nfunction playAudio() {\r\n\tvar id = audioOuts.value;\r\n\taudioContext = new AudioContext();\r\n\tvar audioSource = audioContext.createConstantSource();\r\n\taudioSource.connect(audioContext.destination);\r\n\taudioSource.start();\r\n\tlog(\"playAudio audioSource start\");\r\n}\r\n\r\nfunction playAudio2(){\r\n\tvar id=audioOuts.value;\r\n\taudioContext=new AudioContext();\r\n\taudioContext.audioWorklet.addModule('nitrojs/dspprocessor.js').then(function(){\r\n\t\tvar audioSource=audioContext.createConstantSource();\r\n//\t\tvar audioSource=aud