log(tag);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tdrawing.data=data;\r\n\t\t\tthis.drawings.push(drawing);\r\n\t\t\tthis.dirty=true;\r\n\t\t}catch(exception){\r\n\t\t\tconsole.log(\"tile postLoad exception:\"+exception.toString());\r\n//\t\t\tconsole.log(post.response);\r\n\t\t\tconsole.log(post.responseURL);\r\n\t\t}\r\n\t}\r\n\r\n\tdrawOutline(context,value,outline,style,up){\r\n\t\tconst tagattr=value.split(\":\");\r\n\t\tconst tag=tagattr[0];\r\n\t\tconst attrs=tagattr[1];\r\n\t\tconst attr=attrs.split(\",\");\r\n\t\tconst scale=TileSize/4096.0;\r\n\t\tif(!(tag in mapStyle)){\r\n\t\t\tconsole.log(\"tag needs mapStyle \"+tag);\r\n\t\t}\r\n\t\tstyle=tag in mapStyle?mapStyle[tag].style:style;\r\n\t\tlet lineWidth=mapStyle[tag].thick;\r\n\r\n\t\tif(tag==\"PARCEL\"){\r\n\t\t\tcontext.strokeStyle=style;\r\n\r\n\t\t}\r\n\r\n\t\tif(tag==\"POI\"){\r\n\t\t\tcontext.strokeStyle=style;\r\n\t\t\tcontext.beginPath();\r\n\t\t\tconst n=outline.length;\r\n\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\tconst x=outline[i][0]*scale;\r\n\t\t\t\tconst y=outline[i][1]*scale;\r\n\t\t\t\tcontext.arc(x,y,5*scale,0, 2 * Math.PI);\r\n\t\t\t}\r\n\t\t\tcontext.stroke();\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tif(tag==\"ROAD\"){\r\n\t\t\treturn;\r\n\t\t\tconst lanes=attr[2];\r\n\t\t\tlineWidth=2*(lanes||1);\r\n\t\t}\r\n\t\tif(lineWidth>0){\r\n\t\t\tcontext.strokeStyle=style;\r\n\t\t\tcontext.lineWidth=lineWidth;\r\n\t\t\tcontext.beginPath();\r\n\t\t\tif(tag==\"ROOF\"){\r\n\t\t\t\tconst n=outline.length;\r\n\t\t\t\tconst h=new Array(n);\r\n\t\t\t\tconst heightmap=this.heightmap;\r\n\t\t\t\tif(heightmap){\r\n\t\t\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\t\t\tconst x=outline[i][0];\r\n\t\t\t\t\t\tconst y=outline[i][1];\r\n\t\t\t\t\t\tconst res=this.resolution;\r\n\t\t\t\t\t\th[i]=this.pickHeight(x*res/TileSize,y*res/TileSize);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.moveTo(outline[0][0]*scale,outline[0][1]*scale);\r\n\t\t\t\tfor(let i=1;i<n;i++){\r\n\t\t\t\t\tcontext.lineTo(outline[i][0]*scale,outline[i][1]*scale);\r\n\t\t\t\t}\r\n\t\t\t\tif(up){\r\n\t\t\t\t\tcontext.moveTo((outline[0][0]+h[0]*up.x)*scale,(outline[0][1]+h[0]*up.y)*scale);\r\n\t\t\t\t\tconst n=outline.length;\r\n\t\t\t\t\tfor(let i=1;i<n;i++){\r\n\t\t\t\t\t\tcontext.lineTo((outline[i][0]+h[i]*up.x)*scale,(outline[i][1]+h[i]*up.y)*scale);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\t\t\tcontext.moveTo((outline[i][0])*scale,(outline[i][1])*scale);\r\n\t\t\t\t\t\tcontext.lineTo((outline[i][0]+h[i]*up.x)*scale,(outline[i][1]+h[i]*up.y)*scale);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tcontext.moveTo(outline[0][0]*scale,outline[0][1]*scale);\r\n\t\t\t\tconst n=outline.length;\r\n\t\t\t\tfor(let i=1;i<n;i++){\r\n\t\t\t\t\tcontext.lineTo(outline[i][0]*scale,outline[i][1]*scale);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcontext.stroke();\r\n\t\t}else{\r\n\t\t\tconsole.log(\"drawOutline no lineWidth for \"+tag);\r\n\t\t}\r\n\t}\r\n\r\n\tdrawFilled(context,value,outline){\r\n\t\tconst tagattr=value.split(\":\");\r\n\t\tconst tag=tagattr[0];\r\n\t\tconst attr=tagattr[1].split(\",\");\r\n\r\n\t\tif(!(tag in mapStyle)){\r\n\t\t\tconsole.log(\"tag needs mapstyle \"+tag);\r\n\t\t}\r\n\t\tconst fillStyle=mapStyle[tag].fill;\r\n\r\n\t\tif(fillStyle){\r\n\t\t\tconst scale=TileSize/4096.0;\r\n\t\t\tconst offset=0;\r\n\t\t\tcontext.fillStyle=fillStyle;\r\n\t\t\tcontext.beginPath();\r\n\t\t\tif(outline.length>1){\r\n\t\t\t\tcontext.moveTo(offset+outline[0][0]*scale,offset+outline[0][1]*scale);\r\n\t\t\t\tfor(let i=1;i<outline.length;i++){\r\n\t\t\t\t\tcontext.lineTo(offset+outline[i][0]*scale,offset+outline[i][1]*scale);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcontext.closePath();\r\n\t\t\tcontext.fill(\"evenodd\");\r\n\t\t}\r\n\t}\r\n\r\n\tdarken(context,style,alpha){\r\n\t\tcontext.fillStyle=style;\r\n\t\tcontext.globalAlpha=alpha; \r\n\t\tcontext.fillRect(0,0,TileSize,TileSize);\r\n\t}\r\n\r\n\tdrawBox(context){\r\n\t\tcontext.beginPath();\r\n\t\tcontext.fillStyle=GridStyle;\r\n\t\tfor(let i=16;i<TileSize;i+=64){\r\n\t\t\tcontext.fillRect(i,0,1,TileSize-1);\r\n\t\t\tcontext.fillRect(0,i,TileSize-1,1);\r\n\t\t}\r\n\t}\r\n\r\n\tdrawDiagram(context,tile,up){\r\n\t\tthis.drawBox(context);\r\n\t\tconst outlines=tile.outlines;\t\t\r\n\t\tconst segments=tile.segments;\r\n\t\tif(segments){\r\n\t\t\tfor(const segment of segments){\r\n\t\t\t\tconst value=segment[0];\r\n\t\t\t\tconst drawop=segment[1];\r\n\t\t\t\tconst start=segment[2];\r\n\t\t\t\tconst count=segment[3];\r\n\t\t\t\tfor(let i=0;i<count;i++){\r\n\t\t\t\t\tif(drawop==1) {\r\n\t\t\t\t\t\tthis.drawOutline(context,value,outlines[start+i],OutlineColor,up);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(drawop==2) {\r\n//\t\t\t\t\t\tthis.drawFilled(context,value,outlines[start+i],FillStyle,up);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\nclass TopoField{\r\n\tconstructor(grid){\r\n\t\tthis.grid=grid;\r\n\t\tthis.field=new Worker(\"nitrojs/worker_field.js\")\r\n\t\tthis.field.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\tonMessage(e){\r\n\t\tconst script=e.data;\r\n\t\tfor(const line of script){\r\n\t\t\tswitch (line.command){\r\n\t\t\t\tcase \"update\":\r\n//\t\t\t\t\tthis.tile.onBake(line.topo,line.diff,line.ground);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfetch(url,bind){\r\n\r\n\t}\r\n}\r\n\r\n\r\nclass TopoProcess{\r\n\tconstructor(grid){\r\n\t\tthis.grid=grid;\r\n\t\tthis.fetch=new Worker(\"nitrojs/worker_fetch.js\");\t\r\n\t\tthis.fetch.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\tonMessage(e){\r\n\t\tconst script=e.data;\r\n\t\tfor(const line of script){\r\n\t\t\tswitch (line.command){\r\n\t\t\t\tcase \"flora\":\r\n\t\t\t\t\tthis.tile.onFlora(line.verts,line.indices);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"bumpmap\":\r\n\t\t\t\t\tthis.tile.onBump(line.topo,line.diff,line.ground);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfetch(url,bind){\r\n\r\n\t}\r\n}\r\n\r\n// move fetch to web worker \r\n\r\nfunction compareTiles(a,b){\r\n\treturn a.priority-b.priority;\r\n}\r\n\r\nclass TopoGrid{\r\n\r\n\tconstructor(source,level,res){\r\n\t\tthis.hasFetch=false;\r\n//\t\tthis.field=new TopoField();\r\n//\t\tthis.process=new TopoProcess();\r\n\t\tthis.toposource=source;\r\n\t\tthis.gridlevel=level;\r\n\t\tthis.topores=res;\r\n\t\tthis._topoLayers=[];\r\n\t\tthis._tileGrid={};\r\n\t\tthis.fetchList=[];\r\n\t\tthis.frameCount=0;\r\n\t}\r\n\r\n\taddTerrain(tile){\r\n\t\tconst bumpmap=tile.heightmap;\r\n\r\n\t}\r\n\r\n\t// simon come here and document retire cycle\r\n\r\n\tflushGrid(layer0){\r\n\t\tconst level=this.gridlevel;\r\n\t\tconst grid=this._tileGrid;\r\n\t\tfor(const y in grid){\r\n\t\t\tfor(const x in grid[y]){\r\n\t\t\t\tconst tile=grid[y][x];\r\n//\t\t\t\ttile.flushMesh();\r\n\t\t\t\tlayer0.flushTile(tile);\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis._tileGrid={};\r\n\t}\r\n\r\n\ttileCache(top,bottom,left,right){\r\n\t\tthis.tileLimits=[left,top,right,bottom];\r\n\t\tthis._tileGrid={};\r\n\t}\r\n\r\n\tdistantTiles(active,cx,cy,r){\r\n\t\tconst frame=++this.frameCount;\r\n\t\tconst tx=((cx/TileSize)+0.5)|0;\r\n\t\tconst ty=((cy/TileSize)+0.5)|0;\r\n\t\tconst distant=[];\r\n\t\tfor(const tile of active){\r\n\t\t\tif(!tile.flushed){\r\n\t\t\t\tconst dx=tile.x-tx;\r\n\t\t\t\tconst dy=tile.y-ty;\r\n\t\t\t\tif(dx*dx+dy*dy>=r*r){\r\n\t\t\t\t\tdistant.push(tile);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn distant;\r\n\t}\r\n\r\n\ttouchTiles(cx,cy,r){\r\n\t\tconst frame=++this.frameCount;\r\n\t\tconst tx=((cx/TileSize)+0.5)|0;\r\n\t\tconst ty=((cy/TileSize)+0.5)|0;\r\n\t\tconst visible=[];\r\n\t\tfor(let a=-r;a<=r;a++){\r\n\t\t\tfor(let b=-r;b<=r;b++){\r\n\t\t\t\tif(a*a+b*b<=r*r){\r\n\t\t\t\t\tconst tile=this.tileGet(tx+a,ty+b);\r\n\t\t\t\t\tif(tile.fetched && tile.ready){\r\n\t\t\t\t\t\ttile.frame=frame;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn visible;\r\n\t}\r\n\r\n\trefreshTiles(cx,cy,r){\r\n\t\tconst frame=++this.frameCount;\r\n\t\tconst tx=((cx/TileSize)+0.5)|0;\r\n\t\tconst ty=((cy/TileSize)+0.5)|0;\r\n\t\tconst visible=[];\r\n\t\tfor(let a=-r;a<=r;a++){\r\n\t\t\tfor(let b=-r;b<=r;b++){\r\n\t\t\t\tif(a*a+b*b<=r*r){\r\n\t\t\t\t\tconst tile=this.tileGet(tx+a,ty+b);\r\n// moved to touchTiles\t\t\t\t\t\r\n//\t\t\t\t\ttile.frame=frame;\r\n\t\t\t\t\tif(tile.fetched){\r\n\t\t\t\t\t\tif(tile.ready){\r\n\t\t\t\t\t\t\tvisible.push(tile);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\ttile.priority=1-(a*a+b*b);\r\n\t\t\t\t\t\tthis.fetchTile(tile);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn visible;\r\n\t}\r\n\r\n\tsweep(){\r\n\t\tconst remove=[];\r\n\t\tconst minFrame=this.frameCount-20;\r\n\t\tconst grid=this._tileGrid;\r\n\t\tfor(const y in grid){\r\n\t\t\tconst row=grid[y];\r\n\t\t\tfor(const x in row){\r\n\t\t\t\tconst tile=row[x];\r\n\t\t\t\tif(tile.frame && tile.frame<minFrame){\r\n\t\t\t\t\tremove.push(tile);\r\n\t\t\t\t\ttile.frame=0;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn remove;\r\n\t}\r\n\r\n\ttileGet(x,y){\r\n\t\t// todo limits\r\n\t\tconst level=this.gridlevel;\r\n\t\tconst grid=this._tileGrid;\r\n\t\tlet tile;\r\n\t\tif(y in grid){\r\n\t\t\tif(x in grid[y]){\r\n\t\t\t\ttile=grid[y][x];\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tgrid[y]={};\r\n\t\t}\r\n\t\tif(!tile){\r\n\t\t\ttile=new TopoTile(this,level,x,y);\r\n\t\t// simon come here and add source layers\r\n\t\t\tgrid[y][x]=tile;\r\n\t\t}\r\n\t\treturn tile;\r\n\t}\r\n\t\r\n\tpick(mapx,mapy){\r\n\t\tconst tx=(mapx/TileSize)|0;\r\n\t\tconst ty=(mapy/TileSize)|0;\r\n\t\tconst tile=this.tileGet(tx,ty);\r\n\t\tconst px=mapx-tx*TileSize;\r\n\t\tconst py=mapy-ty*TileSize;\r\n\t\tconst topo=tile.heightmap;\r\n\t\tconst g=topo?topo.pickGround(px,py)-0xc000:0;\r\n\t\treturn g;\r\n\t}\r\n\r\n\t// simon come here and help fix this attempt\r\n\r\n\tfetchTile(tile,priority){\r\n\t\ttile.fetched=true;\r\n\t\tthis.fetchList.push(tile);\r\n\t\tthis.fetchList.sort(compareTiles);\r\n\t}\r\n\r\n\tupdate(){\r\n\t\tif(!this.hasFetch){\r\n\t\t\tif(this.fetchList.length>0 && _PostLoads>_PostCount-AppPlatform.MaxFetch){\r\n\t\t\t\tconst tile=this.fetchList.pop();\r\n\t\t\t\ttile.fetchTopoTile(this.toposource,this.topores);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_system.js\",\"length\":772,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_system.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\nconst externFuncs=[enableVR,failVR,enableXR];\r\n\r\n\r\nfunction enableVR(vr){\r\n\tconsole.log(\"enableVR:\"+vr.length);\r\n}\r\nfunction failVR(){\r\n\tconsole.log(\"failVR:\"+vr.length);\r\n}\r\n\r\nfunction enableXR(xr){\r\n\tconsole.log(\"enableXR:\"+xr.length);\r\n\txr.ondevicechange=enableXRDevice;\r\n}\r\n\r\nfunction enableXRDevice(){\r\n\tconsole.log(\"enableXRDevice:\"+vr.length);\r\n}\r\n\r\nconst WireSettings={\r\n\tabout:{\r\n\t\tmain:\"print('main')\\n\",\r\n\t\ttest:\"print('helloWorld')\"\r\n\t},\r\n\tdisplay:{\r\n\t\tantialias:true,\r\n\t\taudio:true\r\n\t},\r\n\tpermissions:{\r\n\t\tmidi:true,\r\n\t\tsysex:false,\r\n\t\tgamepads:true,\r\n\t\tlocation:false,\r\n\t\tsessionStorage:false,\r\n\t\tlocalStorage:false,\r\n\t\tfileSystem:false\r\n\t},\r\n\tblur:5,\r\n\tcommandKey:\"command this\"\r\n};\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_immersion.js\",\"length\":3014,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_immersion.js\r\n// (c)2022 Simon Armstrong\r\n// All rights reserved\r\n\r\n// https://github.com/RicoP/webgl.d.ts\r\n\r\n///<reference path=\"webgl.d.ts\" />\r\n\r\n\"use strict\";\r\n\r\nlet xrHost = null;\r\nlet xrSession = null;\r\nlet xrRefSpace=null;\r\n\r\nfunction BeginImmersion(host){\r\n\txrHost=host;\r\n\tif (xrSession) {\r\n\t\tconsole.log(\"BeginImmersion Error: immersion session exists\");\r\n\t\txrSession.end();\r\n\t\treturn;\r\n\t}\r\n\tnavigator.xr.requestSession(\"immersive-vr\").then(value=>onImmersionBegun(value),reason=>onImmersionBroken(reason));\r\n}\r\n\r\nfunction onImmersionBegun(session) {\r\n\txrSession = new XRSession(session);\r\n}\r\n\r\nfunction onImmersionBroken(reason) {\r\n\tconsole.log(\"onImmersionBroken\"+reason);\r\n\txrHost.toggleButton(\"Immerse\",false);\r\n}\r\n\r\nfunction EndImmersion(){\r\n\txrSession.end();\r\n//\txrSession=null;\r\n}\r\n\r\nfunction onImmersionEnded(event) {\r\n\txrSession = null;\r\n\tconsole.log(\"immersion ended\");\r\n}\r\n\r\nfunction onImmersionVisible(xrSessionEvent) {\r\n\tconsole.log(xrSessionEvent.session.visibilityState);\r\n}\r\n\r\nfunction postImmersion(script){\r\n\txrSession.post(script);\r\n}\r\n\r\n\r\nclass XRSession{\r\n\tconstructor(session){\r\n\t\tthis.session=session;\r\n\t\tsession.addEventListener(\"end\", onImmersionEnded);\r\n\t\tsession.addEventListener(\"visibilitychange\", onImmersionVisible);\r\n\r\n\t\tthis.canvas=document.createElement(\"canvas\");\r\n\t\tthis.glContext=this.canvas.getContext(\"webgl\", { xrCompatible: true });\r\n\r\n\t\tsession.updateRenderState({ baseLayer: new XRWebGLLayer(session, this.glContext) });\r\n\t\tsession.requestReferenceSpace(\"local\").then((refSpace) => {\r\n\t\t\tconsole.log(\"ref space is xr\");\r\n\t\t\txrRefSpace = refSpace;\r\n\t\t\tsession.requestAnimationFrame(this.onAnimate.bind(this));\r\n\t\t});\r\n\t}\r\n\r\n\tend(){\r\n\t\tif(this.session){\r\n\t\t\tthis.session.end();\r\n\t\t\tthis.session=null;\r\n\t\t}\r\n\t}\r\n\r\n\tpost(script){\r\n\r\n\t}\r\n\r\n\tonAnimate(time, frame) {\r\n\t\tconst refspace= xrRefSpace;\r\n\t\tconst session = frame.session;\r\n\t\tfor (const source of session.inputSources) {\r\n\t\t\tif (source.gamepad) {\r\n\t\t\t\tconst pose = frame.getPose(source.gripSpace, refspace);\t\r\n\t\t\t\tif(pose){\r\n\t\t\t\t\tconsole.log(\"H \"+pose.transform.position.y);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tsession.requestAnimationFrame(this.onAnimate.bind(this));\r\n\t\tconst pose = frame.getViewerPose(refspace);\r\n\t\tif (pose) {\t\r\n\t\t\tconst gl=xrSession.glContext;\r\n\t\t\tconst baseLayer = session.renderState.baseLayer;\r\n//\t\t\tconsole.log(\"p \"+pose.transform.position.y);\r\n\r\n\t\t\tgl.bindFramebuffer(gl.FRAMEBUFFER, baseLayer.framebuffer);\t\t\t\r\n\t\t\tgl.clearColor(Math.cos(time / 2000),Math.cos(time / 4000),Math.cos(time / 6000),1.0,);\r\n\t\t\tgl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\r\n\t\t\t/*for (let view of pose.views) {\r\n\t\t\tlet viewport = glLayer.getViewport(view);\r\n\t\t\tgl.viewport(viewport.x, viewport.y,\r\n\t\t\tviewport.width, viewport.height);\r\n\t\t\t\r\n\t\t\t// Draw a scene using view.projectionMatrix as the projection matrix\r\n\t\t\t// and view.transform to position the virtual camera. If you need a\r\n\t\t\t// view matrix, use view.transform.inverse.matrix.\r\n\t\t\t}*/\r\n\t\t}else{\r\n\t\t\tconsole.log(\"tracking lost\");\r\n\t\t}\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_grid.js\",\"length\":46451,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_grid.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n// onWire creates TopoEditor PixelLoader MeshLoader\r\n// used to govern max refreshGrid speed\r\n// PanelCanvas => Canvas\r\n\r\n\"use strict\"\r\n\r\n//const buttonControls=[\"A\",\"B\",\"X\",\"Y\",\"l\",\"r\",\"L\",\"R\"];\r\n//const axisControls=[\"LX\",\"LY\",\"RX\",\"RY\"]\r\n\r\nfunction VectorLengthSquared(a){\r\n\tlet l=0.0;\r\n\tfor(const b of a){\r\n\t\tl+=b*b;\r\n\t}\r\n\treturn l;\r\n}\r\n\r\nconst tools=true;\r\n\r\nvar epoch;\r\n\r\nvar WatchDog=[];\r\n\r\nconst BasementDepth=4;\t// TODO: go deeper with edge\r\n\r\nconst OceanBlue=\"#0c351b\";\r\nconst OceanGreen=\"#0c1b35\";\r\nconst OceanBlue2=\"#0c1b2e\";\r\n\r\nconst SceneModels=[];\r\n//const SceneModels=[\"Duck\"];\r\n//const SceneModels=[\"CesiumMilkTruck\"];\r\n//const SceneModels=[\"bluebird\"];\r\n//const SceneModels=[\"Te Manawa\"];\r\n\r\nconst SceneShaders=[\r\n\t\"pointFragment\",\r\n\t\"rayFragment\",\"rayVertex\",\r\n\t\"flat_fragment\",\"flat_vertex\",\r\n\t\"tile_fragment\",\"tile_vertex\",\r\n\t\"static_fragment\",\"static_vertex\",\r\n\t\"model_fragment\",\"model_vertex\",\r\n\t\"sprite_fragment\",\"sprite_vertex\"\r\n];\r\n\r\nconst UnidentifiedAgent={brands:[],mobile:false,platform:\"\"};\r\n\r\nconst _WireStorage=(typeof(Storage)!==\"undefined\")?window.localStorage:[];\r\n\r\nfunction SetStorageItem(key,object){\r\n\tconst value=JSON.stringify(object);\r\n\t_WireStorage.setItem(key,value);\r\n}\r\n\r\nfunction GetStorageItem(key){\r\n\tconst value=_WireStorage.getItem(key);\r\n\treturn value?JSON.parse(value):{};\r\n}\r\n\r\nconst HeadingsPerRevolution=2048.0/Math.PI;\r\nconst MaxTilt=4;\r\n\r\nconst MaxZoom=400;\r\nconst MinZoom=5;\r\n\r\nconst AboutSite=\"Toggle UI\"\r\nconst RoaAttributes=\"\";//Data courtesy Toitū Te Whenua - Land Information New Zealand, Waka Kotahi - NZ Transport Agency\";\r\nconst SiteAttributes=\"©2026 skid.nz - datasets provided by LINZ NZTA courtesy Community Commons by Attribute license\";\r\n\r\nconst AK17_License=[\r\n\t\"Auckland 0.075m Urban Aerial Photos (2017)\",\r\n\t\"Courtesy Land Information New Zealand\",\r\n\t\"https://data.linz.govt.nz/layer/95497-auckland-0075m-urban-aerial-photos-2017/\"\r\n];\r\n\r\n////\tAppEditor.flipLevel(state);\r\n\r\nfunction bindKeyCodes(){\r\n\treturn[\r\n\t\t{name:\"T\",code:'T',title:\"Tilt\",handler:SwitchTilt}\r\n//\t{name:\"GPS\",code:'G',title:\"Enable GPS\",handler:SwitchGPS},\r\n//\t{name:\"A\",code:'A',title:\"Aerial\",handler:SwitchAerial,state:true},\r\n//\t{name:\"H\",code:'H',title:\"Heightmap\",handler:SwitchHeight},\r\n//\t{name:\"O\",code:'O',title:\"Overlay\",handler:SwitchOverlay}\r\n//\t{name:\"J\",code:'J',handler:SwitchJyro},\r\n//\t{name:\"M\",code:'M',title:\"Mode\",handler:SwitchMode},\r\n//\t\t{name:\"1\",code:'1',title:\"Level 1\",handler:AppEditor.setLevel.bind(AppEditor,1)},\r\n//\t\t{name:\"2\",code:'2',title:\"Level 2\",handler:AppEditor.setLevel.bind(AppEditor,2)},\r\n//\t\t{name:\"3\",code:'3',title:\"Level 3\",handler:AppEditor.setLevel.bind(AppEditor,3)},\r\n//\t\t{name:\"4\",code:'4',title:\"Level 4\",handler:AppEditor.setLevel.bind(AppEditor,4)},\r\n//\t\t{name:\"5\",code:'5',title:\"Level 5\",handler:AppEditor.setLevel.bind(AppEditor,5)},\r\n//\t\t{name:\"HD\",code:'D',title:\"Resolution\",handler:SwitchRes}\r\n\t]\r\n}\r\n\r\nconst EventNames=[\"error\",\"create\",\"keydown\",\"keyup\"];\r\n\r\nlet AppPlatform;\r\nlet AppGrid;\r\nlet AppScreen;\r\nlet AppMedia;\r\nlet AppEditor;\r\nlet AppPanel;\r\nlet AppStatus=\"\";\r\n\r\nlet AppRuntime={\r\n\tUseAerial:true,//false,//true,\r\n\tUseLINZ:true\r\n};\r\n\r\n// Bounds are inclusive and in [W E S N]\r\n\r\nfunction WGS2NZTM(latlon){\r\n\tconst lat=latlon[0];\r\n\tconst lon=latlon[1];\r\n\tconst grid=AppGrid.wgsNZTM;\r\n\tconst y=grid.bounds[2]-lat;\r\n\tconst x=lon-grid.bounds[0];\r\n\tconst gridy=y/grid.increment;\r\n\tconst gridx=x/grid.increment;\r\n\r\n\tconst yy=(gridy)|0;\r\n\tconst xx=(gridx)|0;\r\n\tconst fracy=gridy-yy;\r\n\tconst fracx=gridx-xx;\r\n\r\n\tconst row0=grid.meters[yy].slice(xx*2,xx*2+4);\r\n\tconst row1=grid.meters[yy+1].slice(xx*2,xx*2+4);\r\n\r\n\tconst n0=row0[0]+fracx*(row0[2]-row0[0]);\r\n\tconst n1=row1[0]+fracx*(row1[2]-row1[0]);\r\n\r\n\tconst e0=row0[1]+fracx*(row0[3]-row0[1]);\r\n\tconst e1=row1[1]+fracx*(row1[3]-row1[1]);\r\n\r\n\tconst n=n0+fracy*(n1-n0);\r\n\tconst e=e0+fracy*(e1-e0);\r\n\r\n\treturn [n,e];\r\n}\r\n\r\nfunction NZTM2WGS(northeast){\r\n\tconst n=northeast[0];\r\n\tconst e=northeast[1];\r\n\tconst grid=AppGrid.nztmWGS;\r\n\tconst y=n-grid.bounds[2];\r\n\tconst x=e-grid.bounds[0];\r\n\tconst gridy=y/grid.increment;\r\n\tconst gridx=x/grid.increment;\r\n\r\n\tconst yy=(gridy)|0;\r\n\tconst xx=(gridx)|0;\r\n\tconst fracy=gridy-yy;\r\n\tconst fracx=gridx-xx;\r\n\r\n\tconst row0=grid.degrees[yy].slice(xx*2,xx*2+4);\r\n\tconst row1=grid.degrees[yy+1].slice(xx*2,xx*2+4);\r\n\r\n\tconst n0=row0[0]+fracx*(row0[2]-row0[0]);\r\n\tconst n1=row1[0]+fracx*(row1[2]-row1[0]);\r\n\r\n\tconst e0=row0[1]+fracx*(row0[3]-row0[1]);\r\n\tconst e1=row1[1]+fracx*(row1[3]-row1[1]);\r\n\r\n\tconst lat=n0+fracy*(n1-n0);\r\n\tconst lon=e0+fracy*(e1-e0);\r\n\r\n\treturn [lat,lon];\r\n}\r\n\r\n\r\nfunction WGS2NZTM2(latlon){\r\n\tconst lat=latlon[0];\r\n\tconst lon=latlon[1];\r\n\tconst grid=AppGrid.wgsNZTM;\r\n\tconst y=grid.bounds[2]-lat;\r\n\tconst x=lon-grid.bounds[0];\r\n\tconst yy=(y/grid.increment)|0;\r\n\tconst xx=(x/grid.increment)|0;\r\n\tconst row=grid.meters[yy];\r\n\treturn [row[xx*2+0],row[xx*2+1]];\r\n}\r\n\r\nfunction NZTM2WGS2(northeast){\r\n\tconst n=northeast[0];\r\n\tconst e=northeast[1];\r\n\tconst grid=AppGrid.nztmWGS;\r\n\tconst y=n-grid.bounds[2];\r\n\tconst x=e-grid.bounds[0];\r\n\tconst yy=(y/grid.increment)|0;\r\n\tconst xx=(x/grid.increment)|0;\r\n\tconst row=grid.degrees[yy];\r\n\treturn [row[xx*2+0],row[xx*2+1]];\r\n}\r\n\r\nfunction SetStatus(status){\r\n//\tconsole.log(\"SetStatus:\"+status);\r\n\tAppStatus=status;\r\n\tif(AppPanel){\r\n\t\tAppPanel.status.setAttribute(\"content\",status);\r\n\t}\r\n}\r\n\r\nfunction CreateCar(){\r\n\tconst cursor=AppPanel.toggleButton(\"Create Car\");\r\n\tif(cursor){\r\n\t\tAppEditor.cursorType=2;\r\n\t}else{\r\n//\t\tconst carsnap=AppEditor.snapshotCar();\r\n//\t\tAppEventServer.addEvent(\"create\",carsnap);\r\n\t\tAppEditor.cursorType=0;\r\n\t}\r\n}\r\n\r\nfunction Screen(){\r\n\twindow.open(\"/\",\"roa.2\",\"_parent\");\r\n}\r\n\r\nfunction Immerse(){\r\n\tconst on=AppPanel.toggleButton(\"Immerse\");\r\n\tif(on){\r\n\t\tBeginImmersion(AppPanel);\r\n\t}else{\r\n\t\tEndImmersion();\r\n\t}\r\n}\r\n\r\nfunction Transmit(){\r\n\tconst on=AppPanel.toggleButton(\"Transmit\");\r\n\tAppEditor.transmit(on);\r\n}\r\n\r\nfunction Camera(){\r\n\tconst on=AppPanel.toggleButton(\"Camera\");\r\n\tAppEditor.camera(on);\r\n}\r\n\r\nfunction Snapshot(){\r\n\tconst app=AppEditor;\r\n\tconst layerXY=JSON.stringify([app.layerx|0,app.layery|0]);\r\n\tSetStatus(\"location:\"+layerXY);\r\n\tconst location=app.getLocation();\r\n\tSetStorageItem(\"home\",{location});\r\n}\r\n\r\nfunction ToggleHelp(){\r\n\tconst show=AppPanel.toggleButton(\"Help\");\r\n\tif(show){\r\n\t\tAppPanel.pagediv.removeAttribute(\"hidden\");\r\n\t}else{\r\n\t\tAppPanel.pagediv.setAttribute(\"hidden\",\"\");\r\n\t}\r\n}\r\n\r\nfunction OnSettings(){\r\n\tconst show=AppPanel.toggleButton(\"Settings\");\r\n\tif(show){\r\n\t\tAppPanel.pagediv.removeAttribute(\"hidden\");\r\n\t}else{\r\n\t\tAppPanel.pagediv.setAttribute(\"hidden\",\"\");\r\n\t}\r\n}\r\n\r\nfunction appendDiv(body,classname){\r\n\tconst div=document.createElement(\"div\");\r\n\tdiv.className=classname;\r\n\tdiv.setAttribute(\"tabindex\",1);\r\n\tbody.appendChild(div);\r\n\treturn div;\r\n}\r\n\r\nfunction appendRange(div,id,action){\r\n\tconst fader=document.createElement(\"div\");\r\n\tfader.className=\"fader\";\r\n\tfader.id=id;\r\n\tconst divLevel=document.createElement(\"div\");\r\n\tdivLevel.className=\"faderlevel\";\r\n\tfader.appendChild(divLevel);\r\n//\tfader.addEventListener(\"input\",action);\r\n\tdiv.appendChild(fader);\r\n\treturn fader;\r\n}\r\n\r\n\r\nfunction appendButton(div,label,action,title,state){\r\n\tconst button=document.createElement(\"button\");\r\n\tif(title) button.title=title;\r\n\tbutton.appendChild(document.createTextNode(label));\r\n\r\n\tconst clickaction=action.bind(state);\r\n\tbutton.addEventListener(\"click\",clickaction);\r\n\r\n\tdiv.appendChild(button);\r\n\treturn button;\r\n}\r\n\r\n/*\r\nfunction addAnchor(group,label,link){\r\n\tconst div=document.createElement(\"div\");\r\n\tgroup.appendChild(div);\r\n}\r\n*/\r\n\r\nfunction appendText(div,content){\r\n\tconst pre=document.createElement(\"span\");\r\n\tconst text=document.createTextNode(content);\r\n\tpre.appendChild(text);\r\n\tdiv.appendChild(pre);\r\n\treturn text;\r\n}\r\n\r\n\r\n// returns NodeListOf<ChildNode>\r\nfunction createContent(div,content){\r\n\tconst template=document.createElement(\"template\");\r\n\ttemplate.innerHTML=content;\r\n\tconst kids=template.content.childNodes;\r\n\treturn kids;\r\n}\r\n\r\nfunction addIndex(div,root){\r\n\tappendText(div,RoaAttributes);\r\n}\r\n\r\nclass Panel{\r\n\r\n\ttoggleButton(name,onoff){\r\n\t\tconst toggle=onoff===undefined;\r\n\t\tconst button=this.buttons[name];\r\n\t\tif(!button) return true;\r\n\t\tconst on=toggle?(!button.hasAttribute(\"on\")):onoff;\r\n\t\tsetOn(button,on);\r\n\t\treturn on;\r\n\r\n\t}\r\n\r\n\taddFader(div,name){\r\n\t\tconst range=appendRange(div,name,this.fade.bind(this,name));\r\n\t\treturn range;\r\n\t}\r\n\r\n\taddButton(div,label,action,title){\r\n\t\tconst button=appendButton(div,label,action,title);\r\n\t\tthis.buttons[title]=button;\r\n\t\treturn button;\r\n\t}\r\n\r\n\t// Panel(body,handler,root)\r\n\t// root => index in top_panel\r\n\tconstructor(body,handler,root){\r\n\t\tthis.buttons={};\r\n\t\tthis.element=body;\r\n\t\tthis.clickButtons=[];\r\n\t\tthis.hitHandler=handler;\r\n\r\n\t\tconst div=appendDiv(body,\"top_panel\");\r\n//\t\tconst div=appendDiv(body,\"corner_panel\");\r\n//\t\taddText(div,RoaAttributes);\r\n\t\taddIndex(div,root);\r\n\r\n\t\tconst div2=appendDiv(body,\"bottom_panel\");\r\n\t\tdiv2.appendChild(document.createTextNode(SiteAttributes));\r\n\r\n\t\tthis.status=document.createElement(\"span\");\r\n\t\tthis.status.className=\"status\";\r\n\t\tdiv2.appendChild(this.status);\r\n\r\n\t\tconst div3=appendDiv(body,\"media_panel\");\r\n\r\n\t\tthis.div=div;\r\n\t\tthis.menu=div3;\r\n\r\n\t\tif(tools){\r\n\t\t\tconst div4=appendDiv(body,\"tool_panel\");\r\n\t\t\tthis.addButton(div4,\"⚙\",OnSettings,\"Settings\");\r\n\t//\t\tthis.addButton(div4,\"🖵\",Screen,\"Add Screen\");\r\n\t//\t\tthis.addButton(div4,\"🚗\",CreateCar,\"Create Car\");\r\n\t//\t\tthis.addButton(div4,\"📡\",Transmit,\"Transmit\");\r\n\t//\t\tthis.addButton(div4,\"👓\",Immerse,\"Immerse\");\t//🥽🤿\r\n\t//\t\tthis.addButton(div4,\"⛶\",Square,\"Square\");\r\n\t//\t\tthis.addButton(div4,\"📷\",Snapshot,\"Snapshot\");\r\n\t//\t\tthis.addButton(div4,\"📷\",Camera,\"Camera\");\r\n\t//\t\tthis.addButton(div4,\"☰\",this.toggleMenu.bind(this),\"ToggleUI\");\r\n//\t\t\tthis.toolpanel=div4;\r\n\t\t}\r\n\r\n\t\tconst div5=appendDiv(body,\"page\");\r\n\t\tdiv5.setAttribute(\"hidden\",\"\");\r\n\t\tthis.pagediv=div5;\r\n\r\n\t\tthis.page=new Page(this.pagediv);\r\n\t\tthis.page.request(\"skid\");\r\n\r\n\t\tconst keycodes=bindKeyCodes();\r\n\r\n\t\tfor(const k in keycodes){\r\n\t\t\tconst ascii=keycodes[k].code.charCodeAt(0);\r\n\t\t\tconst keyhandler=keycodes[k].handler;\r\n\t\t\tconst keytitle=keycodes[k].title;\r\n\t\t\tconst label=keycodes[k].name;\r\n\t\t\tconst state=keycodes[k].state;\r\n\t\t\tconst button=this.addKey(div3,label,ascii,keyhandler,keytitle,state);\r\n\t\t\tif(state){\r\n//\t\t\t\tbutton.click(state);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\r\n//\t\tdiv.focus();\r\n\t}\r\n\r\n\t_clickKey(key){\r\n\t\tthis.hitHandler(key);\r\n\t}\r\n\r\n\tfade(name,event){\r\n\t\tconst v=event.target.value|0;\r\n\t\tswitch(name){\r\n\t\t\tcase \"cursorWidth\":\r\n\t\t\t\tAppEditor.cursorWidth=4+v/12;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"cursorHeight\":\r\n\t\t\t\tAppEditor.cursorHeight=4+v/2;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"day\":{\r\n\t\t\t\tconst h=v*24/100;\r\n\t\t\t\tconst sun=Math.sin(h*Math.PI/24);\r\n\t\t\t\tconst moon=Math.sin((h-8)*Math.PI/24);\r\n\t\t//\t\tthis.screen.setAttribute(\"background-color\"daylight=sun;\r\n\t\t\t}break;\r\n\r\n\t\t}\r\n\t}\r\n\r\n\taddKey(div,label,key,handler,title,state){\r\n\t\tif(!handler){\r\n\t\t\thandler=this._clickKey.bind(this,key);\r\n\t\t}\r\n\t\tconst button=appendButton(div,label,handler,title,state);\r\n//\t\tif(title) button.title=title;\r\n\t\tthis.clickButtons[key]=button;\r\n\t\treturn button;\r\n\t}\r\n\r\n\ttoggleMenu(){\r\n\t\ttoggleAttribute(this.menu,\"hidden\");\r\n\t}\r\n}\r\n\r\nconst MouseEvents=[\"mousedown\",\"mousemove\",\"mouseup\",\"mouseout\",\"mouseover\",\"mouseenter\"];\r\nconst TouchEvents=[\"touchstart\",\"touchend\",\"touchcancel\",\"touchmove\"];\r\nconst KeyEvents=[\"keydown\",\"keyup\",\"keypress\"];\r\nconst BrowserKeyMaskList=[27,115,116,122,123];\t//Esc,F4,F5,F11,F12\r\n\r\n// TopoSource maintains available / visible set of aerial topo and roa TopoTile\r\n// populated from tiles.json\r\n\r\nclass TopoSource{\r\n\r\n\t// collect aerial topo and roa tile data\r\n\r\n\tconstructor(tiles){\r\n\t\tthis.aerial=tiles.aerial;\r\n\t\tthis.topo=tiles.topo;\r\n\t\tthis.roa=tiles.roa;\r\n\t\tthis.visible=tiles.aerial.concat(tiles.topo,tiles.roa);\r\n\t\tthis.fetchMasks();\r\n\t}\r\n\r\n\tloadRaw(raw,w,h,v){\r\n\t\tconst bytesWide=(w+7)>>3;\r\n\t\tconst size=2*bytesWide*h;\r\n\t\tconst maskBytes=new Uint8Array(raw);\r\n\t\tif(maskBytes.length!=size){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tv.mask={bytesWide,maskBytes};\r\n\t\tthis.maskCount++;\r\n\r\n\t}\r\n\r\n\tloaded(){\r\n\t\treturn this.maskCount+this.maskErrors==this.visible.length;\r\n\t}\r\n\r\n\terror(){\r\n\r\n\t}\r\n\r\n\tfetchMasks(){\r\n\t\tthis.maskCount=0;\r\n\t\tthis.maskErrors=0;\r\n\t\t// decode all layer.mask bytemaps\r\n\t\tfor(const v of this.visible){\r\n\t\t\tconst w=1+v.bounds[1]-v.bounds[0];\r\n\t\t\tconst h=1+v.bounds[3]-v.bounds[2];\r\n\t\t\tconst bytesWide=(w+7)>>3;\r\n\t\t\tconst name=v.aerialname||v.toponame||v.roaname;\r\n\t\t\tif(!name){\r\n\t\t\t\tdebugger;\r\n\t\t\t}\r\n\t\t\tconst url=\"mask/\"+name+\".\"+v.layer+\".tar.gz\";\r\n\t\t\tfetch(url).then(//then(response=>response.json()).then(\r\n\t\t\t\t(response)=>{\r\n\t\t\t\t\tif(response.ok){\r\n//\t\t\t\t\tconsole.log(...response.headers);\r\n\t\t\t\t\t\tresponse.arrayBuffer().then(\r\n\t\t\t\t\t\t\t(raw)=>\r\n\t\t\t\t\t\t\t\tthis.loadRaw(raw,w,h,v)\r\n\t\t\t\t\t\t\t,(_error)=>\r\n\t\t\t\t\t\t\t\tthis.error(\"4\"+_error)\r\n\t\t\t\t\t\t)\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tconsole.log(\"fetchMasks response not ok, url:\"+url);\r\n\t\t\t\t\t\tthis.maskErrors++;\r\n//\t\t\t\t\t\tthis.rawLoad([]);\r\n\t\t\t\t\t}\r\n\t\t\t\t},(_error)=>{\r\n\t\t\t\t\tthis.error(\"3\"+_error)\r\n\t\t\t\t}\r\n\t\t\t);\r\n\t\t}\r\n\t}\r\n\r\n\tlistSources(level,col,row){\r\n\t\tconst sources=[];\r\n\t\tfor(const v of this.visible){\r\n\t\t\tconst b=v.bounds;\r\n\t\t\tif(level==v.layer && col>=b[0] && col<=b[1] && row>=b[2] && row<=b[3]){\r\n\t\t\t\tconst x=col-b[0];\r\n\t\t\t\tconst y=row-b[2];\r\n//\t\t\t\tconst y=b[3]-row;\r\n\r\nconst h=1+b[3]-b[2];\r\n\t\t\t\tconst bytesWide=v.mask.bytesWide;\r\n\t\t\t\tconst mask=v.mask.maskBytes;\r\n\t\t\t\tlet on=mask[y*bytesWide+(x>>3)]&(1<<(x&7));\r\n\t\t\t\tlet partial=0;// mask[(y+h)*bytesWide+(x>>3)]&(1<<(x&7));\r\n\t\t\t\tif(on){\r\n\t\t\t\t\tsources.push({layer:v,partial});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn sources;\r\n\t}\r\n\r\n}\r\n\r\n// modes\r\n\r\n// 1 - isometric mouse finger wheel interface\r\n\r\nclass TopoEditor{\r\n\r\n\treset(){\r\n\t\tthis.shapeFiles=[];\r\n\t\tthis.instances=[];\r\n\t}\r\n\r\n\tconstructor(body,video,mode){\r\n//\t\tthis.layerx;\r\n//\t\tthis.layery;\r\n//\t\tthis.layerlevel;\r\n\r\n\t\tthis.tilesource=null;\r\n\t\tthis.topores=1;\r\n\r\n\t\tthis.topoTiles=null;\r\n\t\tthis.homex=0;\r\n\t\tthis.homey=0;\r\n\r\n\t\tthis.body=body;\r\n\t\tthis.video=video;\r\n\t\tthis.idle=true;\r\n\r\n\t\tthis.viewPanel=null;\r\n\r\n\t\tthis.pixelRatio=window.devicePixelRatio||1;\r\n\t\tthis.aspect=1.4;\r\n\r\n\t\tthis.frameCount=0;\r\n\t\tthis.frameTime=Date.now();\r\n\t\tthis.frameElapsed=0;\r\n\r\n\t\tthis.fullscreen=false;\r\n\r\n\t\tthis.zoom=320;//42.5;\r\n\t\tthis.heading=0;\r\n\r\n\t\tthis.gpsMode=0;\r\n\r\n\t\t// default to 0\r\n\t\tthis.tilt=MaxTilt;\r\n\t\tthis.altitude=780;\r\n\r\n\t\tthis.speed=[0,0,0,0]; //fling speed vx,vy,vz,vroty\r\n\r\n\t\tthis.gameAxis=[0,0,0,0];\r\n\t\tthis.gameButtons=[0,0,0,0,0,0,0,0];\r\n\t\tthis.gamePrevious=[0,0,0,0,0,0,0,0];\r\n\r\n\t\tthis.pointerTrack=[];\r\n\t\tthis.touchTrack=[];\r\n\t\tthis.touchCount=0;\r\n\t\tthis.mouseButtons=0;\r\n\r\n//\t\tthis.layerLevel=1;\r\n\t\tthis.reset();\r\n\t\tthis.setmode(mode);\r\n\r\n\t\tthis.cursorType=0;\r\n\t\tthis.cursorWidth=7;\r\n\t\tthis.cursorHeight=22;\r\n\r\n//\t\tthis.world=new World();\r\n\r\n\t\tLocalEventHandler(\"hid\",this._hid.bind(this));\r\n\t}\r\n\r\n\tpress(control,value){\r\n\t\tswitch(control){\r\n\t\t\tcase \"R\":\r\n\t\t\t\tthis.gameButtons[7]=value;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"L\":\r\n\t\t\t\tthis.gameButtons[6]=value;\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\r\n\t}\r\n\taxis(axis,value){\r\n\t\tswitch(axis){\r\n\t\t\tcase \"RX\":\r\n\t\t\t\tthis.gameAxis[2]=value;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"LX\":\r\n\t\t\t\tthis.gameAxis[0]=value;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"LY\":\r\n\t\t\t\tthis.gameAxis[1]=value;\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\r\n\t}\r\n\r\n\tonHIDModify(remote,mod){\r\n\t\tlet buttonaxis=mod[1];\r\n\t\tlet button=mod[2];\r\n\t\tlet value=mod[3];\r\n\t\tswitch(buttonaxis){\r\n\t\t\tcase 0:\r\n\t\t\t\tlet control=buttonControls[button];\r\n\t\t\t\tthis.press(control,value);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 1:\r\n\t\t\t\tlet axis=axisControls[button];\r\n\t\t\t\tthis.axis(axis,value);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\t_hid(hidevent){\r\n\t\tlet e=hidevent;\r\n\t\tlet payload=e.data;\r\n\t\tlet ts=(e.timeStamp*10)|0;\r\n\t\tlet remote=(\"source\" in e)?e.source:0;\r\n\t\tswitch(payload.event){\r\n\t\t\tcase \"connect\":\r\n\t\t\t\tconsole.log(\"_hid connect remote : \"+remote);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"modify\":\r\n//\t\t\t\tconsole.log(\"_hid modify remote : \"+remote);\r\n\t\t\t\tlet mods=payload.mods;\r\n\t\t\t\tfor(let mod of mods){\r\n\t\t\t\t\tthis.onHIDModify(remote,mod);\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"keydown\":\r\n\t\t\t\tthis.onKey(remote,payload.keycode,true);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"keyup\":\r\n\t\t\t\tthis.onKey(remote,payload.keycode,false);\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tconsole.log(\"_hid unhandled event : \"+payload.event);\r\n\t\t}\r\n\t}\r\n\r\n\t_gpsError(error){\r\n\t\tconsole.log(\"_gpsError \"+error.message)\r\n\t}\r\n\r\n\t_gpsPosition(position){\r\n\t\tif(!epoch){\r\n\t\t\tepoch=position.timestamp;\r\n\t\t}\r\n\t\tconst t=position.timestamp-epoch;\r\n\t\tconst c=position.coords;\r\n\t\tconst p=[c.latitude,c.longitude,c.altitude,c.heading,c.speed];\r\n\t\tconst loc={\r\n\t\t\tp:p,\r\n\t\t\tts:t\r\n\t\t}\r\n\t\tPostUserEvent(loc);\r\n\t\tconst nztm=WGS2NZTM([c.latitude,c.longitude]);\r\n\t\tif(nztm){\r\n\t\t\tconst measure=64<<(3*this.layerlevel);\r\n\t\t\tconst layery=TileSize*nztm[0]/measure;\r\n\t\t\tconst layerx=TileSize*nztm[1]/measure;\r\n\t\t\tthis.homex=layerx;\r\n\t\t\tthis.homey=layery;\r\n\t\t\tthis.home();\r\n\t\t}\r\n\r\n\t\tconst x=(c.longitude*1e7)&8191;\r\n\t\tconst y=(c.latitude*1e7)&8191;\r\n\t\tSetStatus(\"P:\"+x+\",\"+y+\" T:\"+t);\r\n//\t\tthis.gpsMode=1;\r\n\t}\r\n\r\n\ttoggleGPS(){\r\n\t\tif(this.gpsMode==0){\r\n\t\t\tif(navigator.geolocation){\r\n\t\t\t\tlet options={enableHighAccuracy:true};\r\n\t\t\t\tnavigator.geolocation.getCurrentPosition(this._gpsPosition.bind(this),this._gpsError.bind(this),options);\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tSetStatus(\"\");\r\n\t\t\tthis.gpsMode=0;\r\n\t\t}\r\n\t}\r\n\r\n\r\n\tmodifyTileLayer(level){\r\n\t\tthis.flushTiles();\r\n\t\tthis.layerlevel=level;\r\n\t}\r\n\r\n\tflushTiles(){\r\n\t\tconst tiles=this.topoTiles[this.layerlevel];\r\n\t\ttiles.flushGrid(this.viewPanel);\r\n\t}\r\n\r\n\tclearTiles(){\r\n\t\tif(this.topoTiles) this.flushTiles();\r\n\t\tconst source=this.tilesource;\r\n\t\tconst res=this.topores;\r\n\t\tconst gridLayers=[];\r\n\t\tfor(let i=1;i<6;i++){\r\n\t\t\tgridLayers[i]=new TopoGrid(source,i,res);\r\n\t\t\tgridLayers[i].tileCache(0,0,0,0);//_layer.top,_layer.bottom,_layer.left,_layer.right]);\r\n\t\t}\r\n\t\tthis.topoTiles=gridLayers;\r\n\t}\r\n\r\n\tloadGrid(grid){\r\n\t\tconsole.log(\"loadGrid\");\r\n\t\tAppGrid=grid;\r\n\r\n\t\tconst ne=WGS2NZTM([-4