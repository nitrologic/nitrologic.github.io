284aaa7d [deepseek-flash] #🟠nitrologic Relay 2.0.3 deepseek-flash 🐋 🪣 0.7° $0.000 502B 2.56s
284aaa7d [deepseek-flash] #In Godot (both 3.x and 4.x) the usual call is `get_tree().quit()` from any node:
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #func quit_game() -> void:
284aaa7d [deepseek-flash] #	get_tree().quit()
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #Optionally pass an exit code: `get_tree().quit(0)` for success, non-zero for an error.
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #Wiring it to a button:
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #func _ready() -> void:
284aaa7d [deepseek-flash] #	$QuitButton.pressed.connect(quit_game)
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #func quit_game() -> void:
284aaa7d [deepseek-flash] #	get_tree().quit()
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #
284aaa7d [deepseek-flash] #Notes worth knowing:
284aaa7d [deepseek-flash] #
284aaa7e [deepseek-flash] #- `SceneTree.quit()` is the correct way; `OS.kill()` is a blunt fallback and generally not needed.
284aaa7e [deepseek-flash] #- If you want a confirmation step, show a dialog before calling `quit_game()`.
284aaa7e [deepseek-flash] #- For a clean shutdown you can handle the notification `NOTIFICATION_WM_CLOSE_WINDOW` (window close
284aaa7e [deepseek-flash] #button) in a node to save data first, then call `get_tree().quit()`.
284aaa7e [deepseek-flash] #- On the Web export this call is effectively a no-op — the browser tab controls closing, so
284aaa7e [deepseek-flash] #design a "return to menu" path instead.
284aaa7e [deepseek-flash] #
