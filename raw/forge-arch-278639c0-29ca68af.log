28b38703 [gemini-3.8-flash] #🟠nitrologic Relay 2.0.3 gemini-3.8-flash 🌟 🪣 0.7° $0.005 21.18KB 2.27s
28b38703 [gemini-3.8-flash] #Yes, `pv` stands for Pipe Viewer. It is a small terminal utility that monitors the flow of
28b38703 [gemini-3.8-flash] #data through a pipe (`|`).
28b38703 [gemini-3.8-flash] #
28b38703 [gemini-3.8-flash] #It shows:
28b38703 [gemini-3.8-flash] #• A progress bar and percentage (if size is known)
28b38703 [gemini-3.8-flash] #• Transfer speed (e.g., `45.2MB/s`)
28b38703 [gemini-3.8-flash] #• Total data transferred so far
28b38703 [gemini-3.8-flash] #• An ETA timer
28b38703 [gemini-3.8-flash] #
28b38703 [gemini-3.8-flash] #It is not installed by default, but it is available in the official Arch repositories:
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #sudo pacman -S pv
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #Running without `pv`
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #If you don't want to install extra tools, you do not need it. The standard `tar` command works
28b38704 [gemini-3.8-flash] #completely fine on its own:
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #sudo tar -C /srv/http/grid -cf - . | sudo tar -C /mnt/grid26 -xf -
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #
28b38704 [gemini-3.8-flash] #• (This will run silently and return your terminal prompt when finished.)*
28b38704 [gemini-3.8-flash] #
