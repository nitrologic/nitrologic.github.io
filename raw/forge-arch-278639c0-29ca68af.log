28b3546e [gemini-3.8-flash] #To verify the physical health of the drive and ensure all previous partition headers, metadata, or
28b3546e [gemini-3.8-flash] #encryption signatures (such as Windows BitLocker remnants) are completely cleared, you can perform
28b3546e [gemini-3.8-flash] #the following steps:
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #1. S.M.A.R.T. Health Check
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #Install `smartmontools` if it is not already present:
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #sudo pacman -S smartmontools
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #Quick Assessment
28b3546e [gemini-3.8-flash] #Check the overall health assessment and error log:
28b3546e [gemini-3.8-flash] #
28b3546e [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #sudo smartctl -H /dev/sda
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #To display the complete SMART attributes table (looking particularly at `Reallocated_Sector_Ct`,
28b3546f [gemini-3.8-flash] #`Current_Pending_Sector`, and `Offline_Uncorrectable`):
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #sudo smartctl -A /dev/sda
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #Self-Test
28b3546f [gemini-3.8-flash] #You can run an internal short or extended self-test:
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #sudo smartctl -t short /dev/sda
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #Wait a few minutes, then view the results:
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #sudo smartctl -l selftest /dev/sda
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #• (For an exhaustive physical scan, `sudo smartctl -t long /dev/sda` tests the entire platter
28b3546f [gemini-3.8-flash] #surface, which typically takes several hours on a 3 TB drive.)*
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b3546f [gemini-3.8-flash] #
28b3546f [gemini-3.8-flash] #2. Clearing Previous Signatures (BitLocker / Windows Metadata)
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #The `16M` partition (`sda1`) seen in your `lsblk` output is the standard Windows Microsoft Reserved
28b35470 [gemini-3.8-flash] #(MSR) partition, which strongly indicates the drive previously held a Windows volume (potentially
28b35470 [gemini-3.8-flash] #with BitLocker encryption on `sda2`).
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #To ensure every signature, superblock, and volume header is removed from the drive before creating
28b35470 [gemini-3.8-flash] #a new table:
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #1. View existing signatures:
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #   sudo wipefs /dev/sda
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #2. Wipe all signatures across the drive and its partitions:
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #   sudo wipefs --all --force /dev/sda
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #3. Surface Verification (Optional)
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #If you wish to test for bad blocks non-destructively across the entire surface before writing data:
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #sudo badblocks -sv /dev/sda
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #
28b35470 [gemini-3.8-flash] #Once verified and wiped clean with `wipefs`, the drive will be free of any previous headers or
28b35471 [gemini-3.8-flash] #encryption structures and ready for partitioning.
28b35471 [gemini-3.8-flash] #
