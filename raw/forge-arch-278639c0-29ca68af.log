r\n//\tthis.diagramAlphas=[0,0,0];\r\n\r\n\tsetAlpha(index,on){\r\n\t\tthis.diagramAlphas[index]=on?0.8:0;\r\n//\t\tthis.dirty=true;\r\n\t}\r\n/*\r\n\tflipOverlay(on){\r\n\t\tthis.setAlpha(2,on);\r\n\t}\r\n\r\n\tflipHeight(on){\r\n\t\tthis.setAlpha(1,on);\r\n\t}\r\n\r\n\tflipAerial(on){\r\n\t\tthis.setAlpha(0,on);\r\n\t}\r\n*/\r\n\tsetLevel(level){\r\n\t\tconst d=8*(level-this.layerlevel);\r\n\t\tif(d==0) return;\r\n\t\tconst m=(d>0)?1/d:-d;\r\n\t\tthis.layerx*=m;\r\n\t\tthis.layery*=m;\r\n\t\tthis.homex*=m;\r\n\t\tthis.homey*=m;\r\n\t\tthis.home();\r\n\t\tthis.modifyTileLayer(level);\r\n//\t\tthis.clearTiles();\r\n//\t\tthis.roaLevel=(this.roaLevel+1)%RoaLayers.length;\r\n//\t\tthis.buildTopo(RoaLayers[this.roaLevel]);\r\n\t}\r\n\r\n\tflipMode(){\r\n\t\tthis.setmode(1-this.mode);\r\n\t}\r\n\r\n\ttoggleTilt(){\r\n\t\tthis.tilt=MaxTilt-this.tilt;\r\n\t}\r\n\r\n\tjogTilt(delta){\r\n\t\tlet tilt=this.tilt+delta;\r\n\t\tif(tilt>7) tilt=7;\r\n\t\tif(tilt<0) tilt=0;\r\n\t\tthis.tilt=tilt;\r\n\t}\r\n\r\n\t// simon come here and fix clamp\r\n\r\n\tjogLevel(dir){\r\n\t\tlet zoom=this.zoom;\r\n\t\tvar level;\r\n\t\tif(dir>0){\r\n\t\t\tif(this.layerlevel<5){\r\n\t\t\t\tzoom/=8;\r\n\t\t\t\tthis.homex=(this.layerx/8.0)|0;\r\n\t\t\t\tthis.homey=(this.layery/8.0)|0;\r\n\t\t\t\tlevel=this.layerlevel+1;\r\n\t\t\t}else{\r\n\t\t\t\treturn;\r\n\t\t\t\tconst m=8*8*8;\r\n\t\t\t\tzoom*=m;\r\n\t\t\t\tthis.homex=this.layerx*m;\r\n\t\t\t\tthis.homey=this.layery*m;\r\n\t\t\t\tlevel=1;\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tif(this.layerlevel>1){\r\n//\t\t\t\tzoom*=8;\r\n\t\t\t\tthis.homex=this.layerx*8.0;\r\n\t\t\t\tthis.homey=this.layery*8.0;\r\n\t\t\t\tlevel=this.layerlevel-1;\r\n\t\t\t}else{\r\n\t\t\t\treturn;\r\n\t\t\t\tconst m=8*8*8;\r\n\t\t\t\tzoom/=m;\r\n\t\t\t\tthis.homex=this.layerx/m;\r\n\t\t\t\tthis.homey=this.layerm/m;\r\n\t\t\t\tlevel=5;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.home();\r\n\t\tthis.modifyTileLayer(level);\r\n\t\treturn zoom;\r\n\t}\r\n\r\n\tjogDolly(x,y){\r\n//\t\tthis.drag(x*20,-y*20);\r\n\t\tconst d=Math.sqrt(x*x+y*y);\r\n\t\tthis.accelerate(d*x*4,-d*y*4);\r\n\t}\r\n\r\n\tjogHeading(spin){\r\n\t\tthis.speed[3]+=spin;\r\n\t}\r\n\r\n\tjogZoom(deltaZoom){\r\n\t\tthis.speed[2]+=0.2*deltaZoom;\r\n\t}\r\n\r\n\taddZoom(deltaZoom){\r\n\t\tlet zoom=this.zoom + deltaZoom;\r\n\t\tif(zoom>MaxZoom) {\r\n\t\t\tzoom=MaxZoom;\r\n//\t\t\tzoom=this.jogLevel(zoom,1);\r\n\t\t}\r\n\t\tif(zoom<MinZoom) {\r\n\t\t\tzoom=MinZoom;\r\n//\t\t\tzoom=this.jogLevel(zoom,-1);\r\n\t\t}\r\n\t\tthis.zoom=zoom;\r\n\t\tthis.dirty=true;\r\n\t}\r\n\r\n\taccelerate(dx,dy){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tdy*=tiltscale;\r\n\t\tconst scale=0.24;//this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.speed[0]+=scale*(dx*cos-dy*sin);\r\n\t\tthis.speed[1]+=scale*(dx*sin+dy*cos);\r\n\t}\r\n\r\n\tdrag(dx,dy){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tdy*=tiltscale;\r\n\t\tconst scale=this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.layerx+=scale*(dx*cos-dy*sin);\r\n\t\tthis.layery+=scale*(dx*sin+dy*cos);\r\n\t}\r\n\r\n\tclick(){\r\n\t\tswitch(this.cursorType){\r\n\t\t\tcase 2:\r\n\t\t\t\tconsole.log(\"create 2\");\r\n\t\t\t\tbreak;\r\n\r\n\t\t}\r\n\t}\r\n\tfling(vx,vy,force){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tvy*=tiltscale;\r\n\t\tconst scale=0.5*this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.speed[0]+=force*scale*(vx*cos-vy*sin);\r\n\t\tthis.speed[1]+=force*scale*(vx*sin+vy*cos);\r\n\t}\r\n\r\n\trefreshGraphics(){\r\n\t\tif(this.graphics){\r\n\t\t\tconst scale=100/this.zoom;\r\n\r\n\t\t\tconst rot=this.heading*Math.PI/32768;\r\n\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\r\n\t\t\tconst vx=this.layerx-this.homex;\r\n\t\t\tconst vy=this.layery-this.homey;\r\n\r\n\t\t\tconst level=this.layerlevel;\r\n\r\n\t\t\t// simon come here and modifiy for level\r\n\r\n\t\t\tconst hshift=1<<(level*3);\r\n\t\t\tconst hfac=0.77/hshift;\r\n\r\n\t\t\tconst view0=this.viewPanel.view0;\r\n\t\t\tview0.isoView(vx,vy,scale,rot,this.tilt,this.altitude,hfac);\r\n\t\t\tview0.refreshView(w,h);\r\n\r\n\t\t\tthis.graphics.render();\r\n\t\t}\r\n\t}\r\n\r\n\tscreenPick(topo,sx,sy){\r\n\t\tconst scale=0.1*this.zoom;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\r\n\t\tconst sin=Math.sin(-rot);\r\n\t\tconst cos=Math.cos(-rot);\r\n\r\n\t\tconst w=this.canvas.width;\r\n\t\tconst h=this.canvas.height;\r\n\r\n\t\tconst x=(sx-w/2)*scale;\r\n\t\tconst y=(sy-h/2)*scale;\r\n\r\n\t\tconst rx=sin*y+cos*x;\r\n\t\tconst ry=cos*y-sin*x;\r\n\r\n\t\tconst mapx=this.layerx+rx;\r\n\t\tconst mapy=this.layery+ry;\r\n\r\n\t\tconst g=topo?topo.pick(mapx,mapy):0;\r\n\r\n\t\tconst ox=mapx-this.homex;\r\n\t\tconst oy=mapy-this.homey;\r\n\r\n\t\tconst oz=g;//0x1a0+g;\r\n\r\n\t\treturn [ox,oy,oz];\r\n\t}\r\n\r\n\trefreshCursor(){\r\n\t\tconst balls=this.cursorshape;\r\n\t\t// simon come here and fix level\r\n\t\tconst topo=this.topoTiles[1];\r\n\t\tif(balls){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tconst n=balls.count;\r\n\t\t\tconst posrot=balls.posrot32;\r\n\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\tconst xyz=this.screenPick(topo,w/2,h/2+(i-5)*10);\r\n\t\t\t\tposrot[i*8+0]=xyz[0];//Math.random()*20-10;\r\n\t\t\t\tposrot[i*8+1]=xyz[1];\r\n\t\t\t\tposrot[i*8+2]=xyz[2];\r\n\t\t\t\tposrot[i*8+3]=65536*0;\r\n\t\t\t\tposrot[i*8+4]+=16;\r\n\t\t\t\tposrot[i*8+5]+=32;\r\n\t\t\t\tposrot[i*8+6]+=48;\r\n//\t\t\t\tballs.position(i,xyz[0],xyz[1],xyz[2]);\r\n\t\t\t}\r\n\t\t\tballs.useShape();\r\n\t\t\tballs.writePosRot();\r\n\t\t}\r\n\t}\r\n\r\n\trefreshCursor2(){\r\n\t\tconst scale=100/this.zoom;\r\n\t\tconst ww=this.cursorWidth*scale/2;\r\n\t\tconst hh=this.cursorHeight*scale/2;\r\n\t\tconst context=this.context;\r\n\t\tif(context){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tcontext.fillStyle=CursorStyle;\r\n\t\t\tcontext.resetTransform();\r\n\t\t\tswitch(this.cursorType){\r\n\t\t\t\tcase 1:\r\n\t\t\t\t\tcontext.fillRect(w/2,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 2:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(w/2+ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tcontext.fillRect(0,h/2+hh,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 3:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tfor(let i=0;i<16;i++){\r\n\t\t\t\t\t\tcontext.fillRect(w/2+ww*i,0,1,h);\r\n\t\t\t\t\t\tcontext.fillRect(0,h/2+hh*i,w,1);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// decrements this.frameElapsed in 18ms counts\r\n\t// ticks gamepads and apply drag to speed\r\n\t// if detect idle from max speed then snapshot address\r\n\r\n\trefreshGrid(){\r\n\t\tlet dirtygrid=this.dirty;\r\n\t\tthis.dirty=false;\r\n\r\n\t\tconst drag=this.mousedown?0.5:0.94;\r\n\t\tconst drag2=0.88;\r\n//\t\tconst drag=this.mousedown?0.5:0.95;\r\n//\t\tdirtygrid=true;\r\n\r\n\t\tlet frames=(((this.frameElapsed/6)|0)*2)||1;\r\n\t\tthis.frameElapsed=0;\r\n\r\n\t\tframes=1;\r\n\r\n\t\twhile(frames--){\r\n\r\n\t\t\tthis.layerx+=this.speed[0];\r\n\t\t\tthis.layery+=this.speed[1];\r\n\r\n\t\t\tthis.addZoom(this.speed[2]);\r\n\t\t\tthis.heading+=this.speed[3];\r\n\r\n\t\t\tthis.tickGamepads();\r\n\r\n\t\t\tthis.speed[0]*=drag;\r\n\t\t\tthis.speed[1]*=drag;\r\n\t\t\tthis.speed[2]*=drag2;\r\n\t\t\tthis.speed[3]*=drag2;\r\n\r\n\t\t\tconst max=VectorLengthSquared(this.speed);\r\n\t\t\tif(max<0.1){\r\n\t\t\t\tif(!this.idle){\r\n\t\t\t\t\tthis.idle=true;\r\n\t\t\t\t\t// ON IDLE snapeshot location in history state\r\n\t\t\t\t\tconst app=AppEditor;\r\n\t\t\t\t\tconst location=app.getLocation();\r\n\t\t\t\t\tif(location){\r\n\t\t\t\t\t\tconst locationHash=\"#\"+JSON.stringify(location);\r\n\t\t\t\t\t\thistory.replaceState(null, null, locationHash);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tthis.idle=false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\thome(){\r\n\t\tthis.layerx=this.homex;\r\n\t\tthis.layery=this.homey;\r\n\t}\r\n\r\n\ttoggleFullscreen2(){\r\n\t\tif(this.fullscreen){\r\n\t\t\tdocument.webkitExitFullscreen();\r\n\t\t\tthis.fullscreen=false;\r\n\t\t}else{\r\n\t\t\tconst element=AppMedia;\r\n\t\t\telement.webkitEnterFullScreen();\r\n\t\t\tthis.fullscreen=true;\r\n\t\t}\r\n\t}\r\n\r\n\ttoggleFullscreen(){\r\n//\t\tvar element=this.body;\r\n\t\tconst element=document.body;\r\n\t\tif(document.exitFullscreen){\r\n\t\t\tif(this.fullscreen){\r\n\t\t\t\tdocument.exitFullscreen();\r\n\t\t\t\tthis.fullscreen=false;\r\n\t\t\t}else{\r\n\t\t\t\t// on promise...\r\n\t\t\t\telement.requestFullscreen();\r\n\t\t\t\tthis.fullscreen=true;\r\n\t\t\t}\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tif(element.webkitEnterFullScreen){\r\n\t\t\t\treturn toggleFullscreen2();\r\n\t\t\t}else{\r\n\t\t\t\twindow.notify(\"html fullscreen support not detected\");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\nfunction IgnoreContextMenu(pointerevent){\r\n\tpointerevent.preventDefault();\r\n\treturn false;\r\n}\r\n\r\nfunction SwitchAerial(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipAerial(on);\r\n}\r\nfunction SwitchHeight(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipHeight(on);\r\n}\r\nfunction SwitchOverlay(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipOverlay(on);\r\n}\r\nfunction SwitchRes(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipRes();\r\n}\r\n\r\n//function SetLevel(click,state){\r\n//\tAppEditor.flipLevel(state);\r\n//}\r\nfunction SwitchMode(click){\r\n\tAppEditor.flipMode()\r\n}\r\nfunction SwitchTilt(click){\r\n\tAppEditor.toggleTilt();\r\n}\r\n\r\nfunction LogStats(click){\r\n\tAppEditor.logStats();\r\n}\r\n\r\nfunction SwitchGPS(click){\r\n\tAppEditor.toggleGPS();\r\n}\r\n\r\nfunction _deviceOrientation(o){\r\n\tif(!epoch){\r\n\t\tepoch=o.timestamp;\r\n\t}\r\n\tconst p=[o.absolute,o.alpha,o.beta,o.gamma];\r\n\tconst orientation={\r\n\t\to:p,\r\n\t\tts:o.timestamp-epoch\r\n\t}\r\n\tconst json=JSON.stringify(orientation);\r\n\tSetStatus(json);\r\n}\r\nlet JyroListener;\r\nfunction SwitchJyro(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tif(on){\r\n\t\tJyroListener=window.addEventListener(\"deviceorientation\",_deviceOrientation);\r\n\t}else{\r\n\t\twindow.removeEventListener(\"deviceorientation\",JyroListener);\r\n\t\tJyroListener=null;\r\n\t\tSetStatus(\"\");\r\n\t}\r\n}\r\n\r\nlet _PixelLoader=null;\r\nlet _MeshLoader=null;\r\n\r\nfunction loadWire(){\r\n\tfetchTiles();\r\n\tfetchGrid();\r\n}\r\n\r\nfunction fetchTiles(){\r\n\tconst url=\"json/tiles.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_tiles=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.onTiles(_tiles);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchTiles fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\nfunction fetchGrid(){\r\n\tconst url=\"json/grid.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_grid=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.loadGrid(_grid);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchGrid fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\n// !!! replaced with loadWire\r\nfunction launchWire(){\r\n//\teditor.buildTopo(_nz3);\r\n//\teditor.buildTopo(_w1);\r\n//\teditor.buildTopo(_ak1);\r\n//\teditor.home();\r\n//\tvideo.addEventListener(\"pause\",editor.pause.bind(editor));\r\n//\teditor.animate();\r\n}\r\n\r\n// body,[screen]\r\n\r\nfunction goWireLocation(gpn6){\r\n\tAppEditor.setLocation(gpn6);\r\n}\r\n\r\n// 2025-10-2 - video is now null and we need fullscreen\r\n\r\nfunction initWireGrid(body){\r\n//\tdocument.title=\"nitrologic wire grid\";\r\n\tAppPlatform=new DesktopPlatform();\r\n//\tAppPlatform=new MobilePlatform();\r\n//\tAppPlatform=new EmbeddedPlatform();\r\n\tconst agent = navigator.userAgentData||UnidentifiedAgent;\r\n\tconsole.log(\"wire agent : \" + JSON.stringify(agent));\r\n\r\n\tconst license=AK17_License.join(\"\\n\");\r\n\tconst title=\"[]\";\r\n\tbody.setAttribute(\"title\",title);\r\n\r\n\tconst screen=document.createElement(\"div\");\r\n\tscreen.className=\"wiregrid\";\t//was screen\r\n\r\n//\teditor.toggleFullscreen();\r\n\r\n\tbody.appendChild(screen);\r\n\r\n\tconst video=null;\r\n\t_PixelLoader=new PixelLoader();\r\n\t_MeshLoader=new MeshLoader();\r\n\r\n\t// todo: wire mode 0 not supported\r\n\tconst editor=new TopoEditor(screen,video,1);\r\n\r\n\tAppScreen=screen;\r\n\tAppEditor=editor;\r\n\r\n\tconst root=[];\r\n\r\n\tconst hit_grid=editor.hitKey.bind(editor);\r\n\tconst panel=new Panel(screen,hit_grid,root);\r\n\r\n\tAppPanel=panel;\r\n\r\n\teditor.animate();\r\n\tloadWire();\r\n}\r\n","name":"content"},{"role":"user","content":"good, 9MB logged, can we add aerial usage also\r\nFiles shared. Feel free to comment if content is new or different.","name":"friend"},{"role":"assistant","content":"`AppRuntime.UseAerial` is `false` in this file, so `imageStack` is empty and this will read 0 until you flip it back on. Assuming you want it on:\n\n```js\nfunction totalAerial(grids){\n\tif(!grids) return 0;\n\tlet bytes=0;\n\tfor(const level in grids){\n\t\tconst grid=grids[level]._tileGrid;\n\t\tfor(const y in grid){\n\t\t\tfor(const x in grid[y]){\n\t\t\t\tconst images=grid[y][x].imageStack;\n\t\t\t\tif(images){\n\t\t\t\t\tfor(const image of images){\n\t\t\t\t\t\tif(image.image){\n\t\t\t\t\t\t\tbytes+=image.image.width*image.image.height*4;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn bytes;\n}\n```\n\n```js\nlogStats(){\n\tlog(\"[TopoEditor] logStats\");\n\tconst grids=this.topoTiles;\n\tlog(\"[MB] tiles:\"+shorten(totalTiles(grids)));\n\tlog(\"[MB] aerial:\"+shorten(totalAerial(grids)));\n}\n```\n\nTwo caveats on the number:\n\n- It counts the decoded RGBA footprint of each `<img>` in `imageStack`, not the GPU texture. They match for aerial because each tile's src is unique, so nothing is double-counted — but if two tiles ever shared a src, GPU would hold one copy and this would count two.\n- The scratch canvas and wallmap per tile are *not* included and are larger than you'd expect — `ScratchRes=2048` means 16 MB of canvas per tile, versus ~6 MB of heightmap. If the tiles figure at 9 MB looks low next to the aerial figure, that's why. Say the word and I'll add a `totalScratch` alongside it."},{"role":"user","content":"i would like to consider baker handling a dig message","name":"friend"},{"role":"assistant","content":"Yes — the baker is the only place it can work. `post()` detaches `topo`/`diff`/`ground`, so the dig has exactly one window: after the merge, before `postFlora`. That window is inside the worker.\n\n## Message\n\n```js\n{command:\"dig\", outlines, depth, border}\n```\n\n`outlines` is the array of `drawing.outlines[start+i]` vertex arrays. Plain structured clone, no transfer list. `depth`/`border` sent from main so the knobs stay in `wire_grid.js`.\n\n## Worker state and gate\n\n`refresh()` currently fires on `topoCount==heightmaps.length` alone. It needs a second gate, because the outlines arrive on a different fetch.\n\n```js\nlet topoCount;\nlet digReady=false;\nlet digDepth=4;\nlet digBorder=40;\nconst heightmaps=[];\nconst roofOutlines=[];\n\nfunction refresh(){\n\tif(topoCount==heightmaps.length && digReady){\n\t\tcreateTopo();\n\t}\n}\n```\n\n```js\ncase \"dig\":\n\tonDig(line.outlines,line.depth,line.border);\n\tbreak;\n```\n\n```js\nfunction onDig(outlines,depth,border){\n\tfor(const outline of outlines){\n\t\troofOutlines.push(outline);\n\t}\n\tdigDepth=depth;\n\tdigBorder=border;\n\tdigReady=true;\n\trefresh();\n}\n```\n\nAccumulate rather than replace, so multiple drawings on one tile merge.\n\n## Ordering in `createTopo`\n\nThe whole point. Dig, then flora, then post:\n\n```js\nfunction createTopo(){\n\tconst bytes=heightmaps[0]||[];\n\tconst heightmap=AllocBumpmap(bytes);\n\theightmap.setBytes(bytes);\n\tconst n=heightmaps.length;\n\tfor(let i=1;i<n;i++){\n\t\tif(heightmaps[i].length==bytes.length){\n\t\t\theightmap.orBytes(heightmaps[i]);\n\t\t}\n\t}\n\theightmaps.length=0;\n\n\tfor(const outline of roofOutlines){\n\t\tdigOutline(heightmap,outline,digDepth,digBorder);\n\t}\n\troofOutlines.length=0;\n\n\theightmap.postFlora(512,4,15,2);\n\theightmap.post();\n}\n```\n\n`digOutline` uses only `heightmap.pickTopo` and `heightmap.setGround/setHeight`, and the worker's own `Bumpmap` implements all three — so the same free function works on both sides without modification.\n\n## Getting `digOutline` into the worker\n\nTwo options.\n\n**Option A — `importScripts`.** One line, but `wire_util.js` runs `const AppEventServer=new EventServer();` at top level and `EventServer` constructs a `Worker` with a document-relative path. Guard that line:\n\n```js\nconst AppEventServer=(typeof window!==\"undefined\")?new EventServer():null;\n```\n\nThen:\n\n```js\nimportScripts(\"../wirejs/wire_util.js\");\n```\n\nPath is relative to the worker's own URL (`.../nitrojs/worker_baker.js`), so `../wirejs/` is correct.\n\n**Option B — inline `Bits` and `digOutline` into the worker.** Self-contained, no import, but duplicates the rasteriser. Only worth it if you want the worker to stay dependency-free.\n\nI'd take A. The guard is one line and the worker stays in sync with the main-thread `Bits`.\n\n## Main thread — minimal\n\nOne helper, called from two places:\n\n```js\nmaybeSendDig(){\n\tif(this.digSent) return;\n\tif(this.drawingCount!=this.drawings.length) return;\n\tthis.digSent=true;\n\tconst outlines=[];\n\tfor(const drawing of this.drawings){\n\t\tfor(const roof of drawing.data[\"ROOF\"]){\n\t\t\tconst start=roof.start;\n\t\t\tconst count=roof.count;\n\t\t\tfor(let i=0;i<count;i++){\n\t\t\t\toutlines.push(drawing.outlines[start+i]);\n\t\t\t}\n\t\t}\n\t}\n\tif(this.instance){\n\t\tthis.instance.post([{\n\t\t\tcommand:\"dig\",\n\t\t\toutlines,\n\t\t\tdepth:BasementDepth,\n\t\t\tborder:BasementBorder\n\t\t}]);\n\t}\n}\n```\n\nCall it at the end of `onDrawingResponse` and at the end of `fetchTopoTile` (after the instance is created). The second call covers `level>=3` and `UseLINZ=false`, where no drawing is fetched and `digReady` would otherwise never be set.\n\n## Two decisions\n\n**Fail-open or strict gate.** As written, if the drawing fetch errors out without calling `onDrawingResponse`, the worker stalls forever — no bump, no flora, no tile. `hasLoaded()` already stalls in that case on the main side, so it's not a new failure mode, but it does move the stall into the worker. If you'd rather degrade, drop the `digReady` gate and instead send an empty `dig` from a timer, or just let `createTopo` run when the topo is ready and dig only if outlines happen to have arrived.\n\n**Shared border or two.** `BasementBorder=40` is the carve halo. Flora clearance wants to be wider than the basement (eaves, not wall line). If they're different, `digTopo` needs either two passes or a separate flora mask, which is a bigger change than a message.\n\n## What still has to be true\n\n- `BasementDepth` is `4`. At `SeaLevel=186*16` that's ~25 cm and won't read. Pick a value in those units.\n- `build_roof2` in `Builder.buildTile` must not also call `tile.digOutline` — remove that call, or the main thread digs a heightmap the worker already transferred and dug.\n- `Bits.poly` has the `y` clamp commented out. Worth a `bits.dump()` check before trusting edge outlines, though `Bits` is allocated at the outline's own min so interior coordinates are non-negative by construction.\n\nWant me to write this as the patch against `worker_baker.js`, `wire_util.js` and `wire_topo.js`?"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_topo.js\",\"length\":34352,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_topo.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n//  TopoTile Pixelmap Bumpmap PixelLoader HtmlImage Point\r\n\r\n\"use strict\"\r\n\r\nconst GroundPen=1;\r\n\r\nlet ScratchCount=0;\r\nlet WallCount=0;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\n\r\nconst WallSize=1024;// simon come here 2048;\r\nconst TileSize=2048;\r\n\r\nconst OutlineColor=\"#04c\";\r\nconst FillStyle=\"#00f\";\r\n\r\nconst GridStyle=\"#048\";\r\nconst _GridAlpha=0.4;\r\nconst _GridThick=0.2;\r\n\r\nconst CursorStyle=\"#ff8\";\r\n\r\nconst TopoMipName=[\"sd-\",\"\",\"hd-\"]\r\n\r\nconst mapStyle={\r\n\tLAND:{thick:2,fill:\"#030\"},\r\n\tCOAST:{thick:10},\r\n\tCONTOUR:{thick:0.4},\r\n\tROAD:{thick:0.2,style:\"#888\"},\r\n\tRAIL:{thick:1.8,style:\"#882\"},\r\n\tBRIDGE:{thick:3},\r\n\tTRAILS:{thick:0},\r\n\tTARMAC:{thick:3},\r\n\tROOF:{thick:3.6,style:\"#000\",fill:\"#333\"},\r\n\tPARCEL:{thick:0.3},\r\n\tTRANSIT:{thick:2.6,style:\"#26a\"}, //,fill:\"#444\"}\r\n\tROAD1:{thick:0.2,style:\"#800\"},\r\n\tPOI:{thick:3,style:\"#cf2\"}\r\n}\r\n\r\nfunction Log2(n){\r\n\tif(n<0){\r\n\t\tdebugger;\r\n\t}\r\n\tlet result=0;\r\n\twhile(n){\r\n\t\tn>>=1;\r\n\t\tresult++;\r\n\t}\r\n\treturn result;\r\n}\r\n\r\nclass Pixelmap{\r\n\tconstructor(imagedata){\r\n\t\tconst bytes=imagedata.data;\r\n\t\tconst rgb=new Array(TileSize*TileSize);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<TileSize;y++){\r\n\t\t\tfor(let x=0;x<TileSize;x++){\r\n\t\t\t\tconst _rgb1=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.rgb=rgb;\r\n\t}\r\n}\r\n\r\nlet BumpCache={1:[],129:[],513:[],1025:[],2049:[]};\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n//\tconst cache=BumpCache[res];\r\n//\tconst map=cache.length?cache.pop():new Bumpmap(res);\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\n\r\nfunction RecycleBumpmap(bumpmap){\r\n\tbumpmap.clear();\r\n\tconst res=bumpmap.resolution;\r\n\tBumpCache[res].push(bumpmap);\r\n}\r\n\r\nclass Bumpmap{\r\n\treset(res){\r\n\t\tthis.resolution=res;\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.resolution=Math.sqrt(res);\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\t// todo: test me\r\n\t\t\ttopo[0]=-0x4000+SeaLevel;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tlakeLine(waterLevel){\r\n\t\tconst lakeLevel=waterLevel-1000;\r\n\t\tconst t=this.topo;\r\n\t\tconst g=this.ground;\r\n\t\tlet n=0;\r\n\t\tconst count=this.resolution*this.resolution;\r\n\t\tfor(let i=0;i<count;i++){\r\n\t\t\tif (t[i]<=waterLevel){\r\n\t\t\t\tn++;\r\n\t\t\t\tt[i]=lakeLevel;\r\n\t\t\t}\r\n\t\t}\r\n//\t\tconsole.log(\"lakeline\",n)\r\n\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let i=0;i<res*res;i++){\r\n\t\t\tlet h=topo[i];\r\n\t\t\tif(h==0){\r\n\t\t\t\ttopo[i]=1000-TopoLevel;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tprocessOutline(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0){\r\n\t\t\th=this.topo[i];\r\n\t\t}\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\nclass PixelLoader{\r\n\tconstructor(){\r\n\t\tthis.canvas=document.createElement('canvas');\r\n\t\tthis.canvas.width=TileSize;\r\n\t\tthis.canvas.height=TileSize;\r\n\t\tthis.context=this.canvas.getContext('2d');\r\n\t}\r\n\timageRGBPixels(image){\r\n\t\tthis.context.clearRect(0,0,TileSize,TileSize);\r\n\t\tthis.context.drawImage(image,0,0);\r\n\t\tconst imagedata=this.context.getImageData(0,0,TileSize,TileSize);\r\n\t\treturn new Pixelmap(imagedata);\r\n\t}\r\n}\r\n\r\nclass HtmlImage{\r\n\r\n\t// leyer is a source entry from tilemaps.json\r\n\r\n\tconstructor(tile,layer,partial){\r\n\t\tthis.tile=tile;\r\n\t\tthis.layer=layer;\r\n\t\tthis.partial=partial;\r\n\t\tconst image=new Image();\r\n\t\timage.crossOrigin=\"anonymous\";\r\n\t\timage.onload=this.imageLoad.bind(this);\r\n\t\timage.onerror=this.imageError.bind(this);\r\n\t\tthis.image=image;\r\n\t}\r\n\r\n\timageLoad(){\r\n\t\tthis.loaded=true;\r\n\t\tthis.tile.dirty=true;\r\n\t\tthis.tile.addImage(this);\r\n//\t\tif(this.layer==0){\r\n//\t\t\tthis.colormap=PixelLoader.imageRGBPixels(this.image);\r\n//\t\t\tthis.tile.setBasemap(this.image);\r\n//\t\t}\r\n\t}\r\n\r\n\timageError(errorevent){\r\n\t\tconsole.log(\"imageError:\",this.image.src,errorevent.message);\r\n\t}\r\n\r\n\tload(src){\r\n\t\tthis.image.src=src;\r\n\t}\r\n}\r\n\r\n// simon come here and allocate baker workers to bake\r\n\r\n\r\nclass Instance{\r\n\r\n}\r\n\r\nclass Bake{\r\n\r\n\tinit(workerCount){\r\n\t\tconsole.log(\"[BAKE] init\",workerCount)\r\n\t\tconst bakers=[];\r\n\t\tfor(let i=0;i<workerCount;i++){\r\n\t\t\tconst baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\t\tbakers.push(baker);\r\n\t\t}\r\n\t\tthis.bakers=bakers;\r\n\t}\r\n\r\n\tlisten(instance){\r\n\r\n\t}\r\n}\r\n\r\n// todo; TileInstance v TopoProcess\r\n\r\nclass TileInstance{\r\n\tconstructor(tile){\r\n\t\tthis.heightmaps=[];\r\n\t\tthis.tile=tile;\r\n//\t\tconsole.log(\"[WIRE] instance\",tile);\r\n\t\tthis.baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\tthis.baker.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\t// e.data is script - an array of line objects that include a command field\r\n\r\n\tpost(message,transfer){\r\n\t\tthis.baker.postMessage(message,transfer);\r\n\t}\r\n\r\n\tterminate(){\r\n\t\tthis.baker.terminate();\r\n\t\t// simon come here and recylcled typed arrays\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\r\n\tonMessage(e){\r\n\t\tconst script=e.data;\r\n\t\tfor(const line of script){\r\n\t\t\tswitch (line.command){\r\n\t\t\t\tcase \"flora\":\r\n\t\t\t\t\tthis.tile.onFlora(line.verts,line.indices);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"bump\":\r\n\t\t\t\t\tthis.tile.onBump(line.topo,line.diff,line.ground);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tbakeTopo(count){\r\n\t\tconst message=[{command:\"bake\",value:count}];\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\trawLoad(raw){\r\n\t\tthis.heightmaps.push(raw);\r\n\t\tconst message=[{command:\"heightmap\",array:raw}];\r\n\t\tconst transfer=[raw.buffer];\r\n//\t\tthis.baker.postMessage(message,transfer);\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\t// support merge or multiple heightmaps here\r\n\r\n\tcreateTopo(){\r\n\t\tconst bytes=this.heightmaps[0]||[];\r\n\t\tthis.heightmap=AllocBumpmap(bytes);\r\n\t\tthis.heightmap.setBytes(bytes);\r\n\t\tfor(let i=1;i<this.heightmaps.length;i++){\r\n\t\t\tthis.heightmap.orBytes(this.heightmaps[i]);\r\n\t\t}\r\n\t\tthis.heightmap.heal();\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\tbakeTile2(tile){\r\n\t\ttile.createTopo();\r\n\t\tconst topo=CreateTopoSurface(128,16,0,tile.heightmap);\r\n\t\ttopo.calcNormals();\r\n\t\ttile.topoSurface=topo;\r\n\t}\r\n}\r\n\r\nlet _PostCount=0;\r\nlet _PostLoads=0;\r\n\r\n// pickHeight pickElevation maxHeight retire fetch request loadTileImage redrawTile\r\n// drawOutline drawFilled drawBox drawDiagram \r\n// layer was source level is now resolution\r\n\r\nclass TopoTile{\r\n\r\n\tconstructor(grid,level,x,y){\r\n\r\n\t\tthis.hasBaker=true;\t\t// false debug mode - release make true;\r\n\t\tthis.flushed=false;\r\n\t\tthis.baker=null;\r\n\r\n\t\t// 2026 - heightmaps is back for no baker mode\r\n\t\tthis.heightmaps=[];\r\n\r\n//\t\tthis.sourceLayers=[];\t// have extensions\r\n\t\tthis.topogrid=grid;\r\n\t\tthis.level=level;\r\n\t\tthis.x=x;\r\n\t\tthis.y=y;\r\n\t\tthis.name=\".\"+level+\",\"+x+\",\"+y;\r\n\r\n\t\tthis.imageCount=0;\r\n\t\tthis.topoCount=0;\r\n\t\tthis.drawingCount=0;\r\n\t\tthis.posts=[];\r\n\t\tthis.drawings=[];\r