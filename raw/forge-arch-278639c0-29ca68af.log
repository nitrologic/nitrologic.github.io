29a2f7b9 [deepseek-flash] #
29a2f7b9 [deepseek-flash] #Two filters stack:
29a2f7b9 [deepseek-flash] #
29a2f7b9 [deepseek-flash] #- Scan order — `a` outer, `b` inner.
29a2f7b9 [deepseek-flash] #- Readiness — only `fetched && ready` tiles land in `visible`.
29a2f7b9 [deepseek-flash] #
29a2f7b9 [deepseek-flash] #So the array is scan-ordered within a frame, but a tile only enters on the frame it becomes
29a2f7b9 [deepseek-flash] #ready. A far tile that loads late appends after near ones. Across frames the order is effectively
29a2f7b9 [deepseek-flash] #load-completion order, which is nearest-first because of the fetch priority:
29a2f7b9 [deepseek-flash] #
29a2f7b9 [deepseek-flash] #
29a2f7b9 [deepseek-flash] #tile.priority=1-(a*a+b*b);   // closest = highest
29a2f7b9 [deepseek-flash] #this.fetchList.sort(compareTiles);   // ascending
29a2f7b9 [deepseek-flash] #this.fetchList.pop();                 // takes highest
29a2f7b9 [deepseek-flash] #
29a2f7b9 [deepseek-flash] #
29a2f7ba [deepseek-flash] #Net: roughly front-to-back, but not guaranteed. Not a design decision, a consequence.
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #Does it matter
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #The `tile` layer is tagged `depthEnable`, so it's depth-tested with `LESS`, and `depthMask` is
29a2f7ba [deepseek-flash] #default true. Terrain tiles are disjoint in world xy — each covers its own 2048² area. So for the
29a2f7ba [deepseek-flash] #terrain itself, order is irrelevant; the depth buffer resolves it, and front-to-back is the cheap
29a2f7ba [deepseek-flash] #path anyway.
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #Where order does bite:
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #- Blend. `WebGL2Context.clear` enables `BLEND` globally and never disables it. Terrain
29a2f7ba [deepseek-flash] #alpha is `0.94` (`O` in `RoaPalette`), flora is `0.52` (`A`). Blended geometry needs back-to-front.
29a2f7ba [deepseek-flash] #Front-to-back gives the wrong blend wherever two blended fragments cover the same pixel.
29a2f7ba [deepseek-flash] #- Equal z. Depth func is `LESS`, not `LEQUAL`. Two surfaces at exactly the same z resolve
29a2f7ba [deepseek-flash] #by draw order — first one drawn wins.
29a2f7ba [deepseek-flash] #- `depthDisable` pass. Lines and sprites are drawn before everything, with no depth
29a2f7ba [deepseek-flash] #test. Pure draw order, no z-buffer safety net.
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #If your symptom is "a far tile draws over a near one", that isn't order — depth test would prevent
29a2f7ba [deepseek-flash] #it. That'd be winding/culling, or depth not written. If your symptom is seams or flora blending
29a2f7ba [deepseek-flash] #wrong, it is order.
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #If you want back-to-front
29a2f7ba [deepseek-flash] #
29a2f7ba [deepseek-flash] #The sort has to live in the draw path, not `meshTile`, because the `shapes` array persists across
29a2f7ba [deepseek-flash] #frames and only changes on mesh/flush. Sort in `drawLayerList`, using each shape's origin from
29a2f7ba [deepseek-flash] #`transforms[0]`:
29a2f7ba [deepseek-flash] #
29a2f7bb [deepseek-flash] #
29a2f7bb [deepseek-flash] #function sortShapes(shapes,m){
29a2f7bb [deepseek-flash] #	const a=m[4];
29a2f7bb [deepseek-flash] #	const b=m[5];
29a2f7bb [deepseek-flash] #	const keyed=shapes.map((shape,index)=>{
29a2f7bb [deepseek-flash] #		const t=shape.transforms[0];
29a2f7bb [deepseek-flash] #		return {shape,depth:a*t[3]+b*t[7],index};
29a2f7bb [deepseek-flash] #	});
29a2f7bb [deepseek-flash] #	keyed.sort((p,q)=>p.depth-q.depth);
29a2f7bb [deepseek-flash] #	return keyed.map(k=>k.shape);
29a2f7bb [deepseek-flash] #}
29a2f7bb [deepseek-flash] #
29a2f7bb [deepseek-flash] #
29a2f7bb [deepseek-flash] #`t[3],t[7]` are the origin xy set by `setOrigin`. `m[4],m[5]` are the view matrix's xy→screen-y
29a2f7bb [deepseek-flash] #terms, so the dot product is proportional to screen y; NDC +y is up-screen, which is back.
29a2f7bb [deepseek-flash] #Ascending sort draws back first.
29a2f7bb [deepseek-flash] #
29a2f7bb [deepseek-flash] #Two notes:
29a2f7bb [deepseek-flash] #
29a2f7bb [deepseek-flash] #- Sort only the blended layers. `static` and `tile` are mostly opaque and depth-tested;
29a2f7bb [deepseek-flash] #reordering them buys nothing but costs the sort every frame.
29a2f7bb [deepseek-flash] #- `z_clip` is pure world z. Row 2 of the matrix is `[0, 0, -1/2048, 0.5]`. So the depth
29a2f7bb [deepseek-flash] #buffer already orders correctly by height, independent of draw order. Sorting only affects what
29a2f7bb [deepseek-flash] #depth can't separate.
29a2f7bb [deepseek-flash] #
29a2f7bb [deepseek-flash] #What are you actually seeing — tiles overpainting each other, seams, or something in the flora? The
29a2f7bb [deepseek-flash] #fix differs.
29a2f7bb [deepseek-flash] #
