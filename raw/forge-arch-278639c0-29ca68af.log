278672a5 [gemini-3.8-flash] #
278672a5 [gemini-3.8-flash] #ls -l /dev/blackmagic*
278672a6 [gemini-3.8-flash] #
278672a6 [gemini-3.8-flash] #
278672a6 [gemini-3.8-flash] #If the kernel drivers attached to the card correctly, you will see a character device such as
