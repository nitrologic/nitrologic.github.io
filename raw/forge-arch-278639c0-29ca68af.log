29a237ce [deepseek-flash] #Three files changed. One unblocks the render, one adds a dead method, one turns on walls.
29a237ce [deepseek-flash] #
29a237ce [deepseek-flash] #`worker_baker.js` — dig gate is now inert
29a237ce [deepseek-flash] #
29a237ce [deepseek-flash] #`digReady=true` at the top means `refresh()` reduces to `topoCount==heightmaps.length` — exactly
29a237cf [deepseek-flash] #the ungated form. Tiles render again, which is the quick unblock.
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #But it also means the dig path is now fully dead: `createTopo` fires on the topo count alone, so
29a237cf [deepseek-flash] #any `dig` message that arrives later finds `roofOutlines` populated but `createTopo` already run.
29a237cf [deepseek-flash] #The gate only does something if `digReady` starts `false` and the message arrives before the topo
29a237cf [deepseek-flash] #completes.
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #If you're keeping this for now, fine — just be aware the `dig` case in `onmessage`, `onDig`, and
29a237cf [deepseek-flash] #the `roofOutlines` loop are all currently no-ops.
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #`wire_topo.js` — `TileInstance.digTopo()` is broken and never called
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #digTopo(){
29a237cf [deepseek-flash] #	const outlines=this.tile.outlines;
29a237cf [deepseek-flash] #	const message=[{command:"dig",outlines,depth,border}];
29a237cf [deepseek-flash] #	this.post(message);
29a237cf [deepseek-flash] #}
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #
29a237cf [deepseek-flash] #Three problems:
29a237cf [deepseek-flash] #- `this.tile.outlines` doesn't exist. Outlines live in `tile.drawings[i].outlines`, indexed by
29a237cf [deepseek-flash] #`roof.start + o`.
