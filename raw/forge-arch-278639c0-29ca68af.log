));\r\n\t}\r\n\r\n\tstd::cout << \"valkey reply \" << hiredisReplyNames[r->type] << \" result : \" << result << std::endl;\r\n\r\n\treturn error;\r\n}\r\n\r\nint replyPlainString(redisReply *r,utf8 &result){\r\n\tint error=0;\r\n\tstd::stringstream ss;\r\n\tswitch(r->type){\r\n\t\tcase REDIS_REPLY_STRING: // 1\r\n\t\t\tresult=utf8(r->str,r->len);\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_ARRAY: // 2\r\n\t\t\tss<<\"[\";\r\n\t\t\tfor(int i=0;i<r->elements;i++){\r\n\t\t\t\tif(i>0) ss << \",\";\r\n\t\t\t\tutf8 reply;\r\n\t\t\t\tint error=replyPlainString(r->element[i],reply);\r\n\t\t\t\tss<<reply;\r\n\t\t\t}\r\n\t\t\tss<<\"]\";\r\n\t\t\tresult=ss.str();\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_INTEGER: // 3\r\n//\t\t\tresult=quoted(utf8(\":\")+std::to_string(r->integer));\r\n\t\t\tresult=std::to_string(r->integer);\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_NIL: // 4\r\n\t\t\tresult=\"<nil>\";//\"<nil>\";\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_STATUS: // 5\t\r\n\t\t\tresult=utf8(\"+\")+r->str;\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_ERROR: // 6\r\n\t\t\tresult=utf8(\"-\")+r->str;\r\n\t\t\terror=1;\r\n\t\t\tbreak;\r\n\t\tdefault:\r\n\t\t\tresult=utf8(\"?\")+std::to_string(r->type)+utf8(\"?\");\r\n\t}\r\n\treturn error;\r\n}\r\n\r\n\r\nint replyStrings(redisReply *r,Strings &result){\r\n\tint error=0;\r\n\tswitch(r->type){\r\n\t\tcase REDIS_REPLY_STRING: // 1\r\n\t\t\tresult.push_back(utf8(r->str,r->len));\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_ARRAY: // 2\r\n\t\t\tfor(int i=0;i<r->elements;i++){\r\n\t\t\t\tutf8 s;\r\n\t\t\t\terror=replyPlainString(r->element[i],s);\r\n\t\t\t\tresult.push_back(s);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_INTEGER: // 3\r\n//\t\t\tresult=quoted(utf8(\":\")+std::to_string(r->integer));\r\n\t\t\tresult.push_back(std::to_string(r->integer));\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_NIL: // 4\r\n\t\t\tresult.push_back(\"\");//\"<nil>\";\r\n\t\t\tbreak;\r\n\t\tcase REDIS_REPLY_STATUS: // 5\t\r\n\t\t\tresult.push_back(utf8(\"+\")+r->str);\r\