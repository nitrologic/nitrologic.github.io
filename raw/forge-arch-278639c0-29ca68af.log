28dcb446 [claude-sonnet-5] #🟠nitrologic Relay 2.0.3 claude-sonnet-5 A\ 🪠 🧊 $0.025 11.49KB 19.21s
28dcb446 [claude-sonnet-5] #Tainted canvas errors happen when an image is drawn onto a `<canvas>` without proper CORS clearance
28dcb446 [claude-sonnet-5] #— even if your origin server sends the right headers, there are several places this can break down,
28dcb446 [claude-sonnet-5] #especially with a CDN in front.
28dcb446 [claude-sonnet-5] #
28dcb446 [claude-sonnet-5] #1. Client-Side: Set `crossOrigin` on the Image
28dcb446 [claude-sonnet-5] #
28dcb446 [claude-sonnet-5] #This is the most commonly missed step. Even if the server sends `Access-Control-Allow-Origin: *`,
28dcb446 [claude-sonnet-5] #the browser won't apply it unless you explicitly request it:
28dcb446 [claude-sonnet-5] #
28dcb446 [claude-sonnet-5] #
28dcb446 [claude-sonnet-5] #function loadImage(url) {
28dcb446 [claude-sonnet-5] #	return new Promise((resolve, reject) => {
28dcb446 [claude-sonnet-5] #		const img = new Image();
28dcb446 [claude-sonnet-5] #		img.crossOrigin = "anonymous"; // Must be set BEFORE img.src
28dcb446 [claude-sonnet-5] #		img.onload = () => resolve(img);
28dcb446 [claude-sonnet-5] #		img.onerror = reject;
28dcb446 [claude-sonnet-5] #		img.src = url;
28dcb447 [claude-sonnet-5] #	});
28dcb447 [claude-sonnet-5] #}
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #If `crossOrigin` isn't set, the browser treats the image as opaque for canvas purposes regardless
28dcb447 [claude-sonnet-5] #of server headers.
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #2. CDN Header Stripping/Caching Issue
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #This is very likely your actual problem. Here's why:
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #- Many CDNs cache the response the first time it's fetched
28dcb447 [claude-sonnet-5] #- If that first request didn't include an `Origin` header (or came from a different context), the
28dcb447 [claude-sonnet-5] #cached response might not have `Access-Control-Allow-Origin` attached — and the CDN may serve
28dcb447 [claude-sonnet-5] #that cached version to everyone afterward, headers included
28dcb447 [claude-sonnet-5] #- Some CDNs also strip custom headers by default unless explicitly configured to pass them through
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #• Fix:* Add `Vary: Origin` so caches don't serve a CORS-less response to a CORS request:
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #
28dcb447 [claude-sonnet-5] #location /aerialgrid/ {
28dcb447 [claude-sonnet-5] #	add_header Access-Control-Allow-Origin *;
28dcb447 [claude-sonnet-5] #	add_header Vary Origin;
28dcb447 [claude-sonnet-5] #	add_header Cache-Control "public, max-age=31536000, immutable";
28dcb447 [claude-sonnet-5] #	tcp_nopush on;
28dcb447 [claude-sonnet-5] #	sendfile on;
28dcb447 [claude-sonnet-5] #	sendfile_max_chunk 4m;
28dcb447 [claude-sonnet-5] #	root /mnt/grid26;
28dcb448 [claude-sonnet-5] #}
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #Then purge the CDN cache for `/aerialgrid/*` and test again — if the CDN cached a bad
28dcb448 [claude-sonnet-5] #response before your `add_header` was in place, no client-side fix will help until that cache
28dcb448 [claude-sonnet-5] #clears.
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #3. Verify Headers Are Actually Reaching the Browser
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #Don't trust — verify. Check what's actually being returned through the CDN, not directly
28dcb448 [claude-sonnet-5] #from your origin:
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #curl -I https://your-cdn-domain.com/aerialgrid/example.png
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #Look specifically for:
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #access-control-allow-origin: *
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #If it's missing when going through the CDN (but present when hitting your origin directly), the CDN
28dcb448 [claude-sonnet-5] #is stripping it — this is common with CDNs that don't pass through unrecognized/custom headers by
28dcb448 [claude-sonnet-5] #default.
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #4. Double-Check the Draw Sequence
28dcb448 [claude-sonnet-5] #
28dcb448 [claude-sonnet-5] #Make sure you're not accidentally reading pixel data before the image fully loads, or mixing
28dcb448 [claude-sonnet-5] #tainted and untainted sources on the same canvas:
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #async function drawFromCDN(canvas, url) {
28dcb449 [claude-sonnet-5] #	const ctx = canvas.getContext("2d");
28dcb449 [claude-sonnet-5] #	const img = await loadImage(url); // uses crossOrigin version above
28dcb449 [claude-sonnet-5] #	ctx.drawImage(img, 0, 0);
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #	// This will now succeed if CORS was properly honored:
28dcb449 [claude-sonnet-5] #	const pixelData = ctx.getImageData(0, 0, canvas.width, canvas.height);
28dcb449 [claude-sonnet-5] #	return pixelData;
28dcb449 [claude-sonnet-5] #}
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #If any single image drawn to that canvas was loaded without proper CORS clearance, the
28dcb449 [claude-sonnet-5] #entire canvas becomes tainted — even for later, well-behaved draws.
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28dcb449 [claude-sonnet-5] #
28dcb449 [claude-sonnet-5] #• Quickest diagnostic step:* Run the `curl -I` command above through the actual CDN URL
28dcb449 [claude-sonnet-5] #you're using in the browser, and paste the response headers here — that'll tell us definitively
28dcb449 [claude-sonnet-5] #whether this is a CDN pass-through problem or a client-side `crossOrigin` issue.
