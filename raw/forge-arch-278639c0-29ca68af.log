e(context,outline);\r\n\t\t\t\t\t\tif(build_walls_geom){\r\n\t\t\t\t\t\t\tconst surface=this.buildWalls(tile,outline);\r\n\t\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\t\troofSurfaces.push(surface);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(build_roof_geom){\r\n\t\t\t\t\t\t\tconst surface=this.buildRoof(tile,outline);\r\n\t\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\t\troofSurfaces.push(surface);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(build_roof_basement){\r\n\t\t\t\t\t\t\ttile.digOutline(outline,BasementDepth,40);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.clip();\r\n\r\n\t\t\t\tcontext.fillStyle=\"#555\";\t// basement color\r\n\r\n\t\t\t\tconst res=AppPlatform.ScratchRes;\r\n\t\t\t\tcontext.fillRect(0,0,res,res);\r\n//\t\t\t\tcontext.clearRect(0,0,res,res);\r\n\t\t\t\tcontext.restore();\r\n\r\n\t\t\t\tconst pixels=((this.wallPixels/1e6)|0);\r\n\t\t\t\tif(pixels){\r\n\t\t\t\t\tconsole.log(\"tile roof wall MegaPixels \"+pixels);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tcontext.globalAlpha=0.32; \r\n\r\n\t\t\t\tcontext.strokeStyle=\"goldenrod\";\r\n\t\t\t\tcontext.lineWidth=0.5;\r\n\t\t\t\tcontext.beginPath();\r\n\r\n\t\t\t\tfor(const surface of roofSurfaces){\r\n\t\t\t\t\tDrawSurface(context,surface);\r\n\t\t\t\t}\r\n\t\t\t\tcontext.stroke();\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\r\n\t\t\t\tsurfaces=surfaces.concat(roofSurfaces);\r\n\t\t\t}\r\n\r\n\t\t\tif(build_transit && transit.length){\r\n\r\n\t\t\t\tif(true){\r\n\r\n\t\t\t\t}else{\r\n\t\t\t\t\tconst transitSurfaces=[];\r\n\t\t\t\t\tfor(const block of transit){\r\n\t\t\t\t\t\tconst start=block.start;\r\n\t\t\t\t\t\tconst count=block.count;\r\n\t\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\t\tconst surface=this.buildTransit(tile,outline);\r\n\t\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\t\ttransitSurfaces.push(surface);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontext.globalAlpha=0.5; \r\n\t\t\t\t\tcontext.strokeStyle=\"blue\";\r\n\t\t\t\t\tcontext.lineWidth=1.4;\r\n\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\tfor(const surface of transitSurfaces){\r\n\t\t\t\t\t\tDrawSurface(context,surface);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontext.stroke();\r\n\t\t\t\t\tcontext.globalAlpha=1.0; \r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\treturn surfaces;\r\n\t}\r\n}\r\n\r\n\r\nclass PointCloud{\r\n\tconstructor(w,h,x,y){\t\t\r\n\t\tthis.clear(w,h,x,y)\r\n\t}\r\n\r\n\tclear(w,h,x,y){\r\n\t\tw=1+((w+15)/16)|0;\r\n\t\th=1+((h+15)/16)|0;\r\n\t\tthis.offsetX=x;\r\n\t\tthis.offsetY=y;\r\n\t\tthis.width=w;\t//dimension of pointcloud (box/16)\r\n\t\tthis.height=h;\r\n\t\tconst pointmap=[];\r\n\t\tlet n=w*h;\r\n\t\twhile(n--) pointmap.push([]);\r\n\t\tthis.pointMap=pointmap;\t\t\r\n\t\tthis.points=[];\r\n\t\tthis.inside=true;\r\n\t\tthis.exit=0;\r\n\t\tthis.recent=[0,0];\r\n\t}\r\n\r\n\taddPoint(x,y,u){\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tconst px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tconst py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tconst index=py*this.width+px;\r\n\t\tconst i=this.points.length;\r\n\t\tconst p=[x,y,i,u];\r\n\t\tthis.points.push(p);\r\n\t\tif(index<0||index>=this.pointMap.length){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tthis.pointMap[index].push(p);\r\n\t\treturn i;\r\n\t}\r\n\r\n\taddraw(x,y){\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tlet px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tlet py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px<0) px=0;\r\n\t\tif(py<0) py=0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tconst index=py*w+px;\r\n\t\tconst i=this.points.length;\r\n\t\tconst p=[x,y,i,0,0];\r\n\t\tthis.points.push(p);\r\n\t\tif(index<0||index>=this.pointMap.length){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tthis.pointMap[index].push(p);\r\n\t\tthis.recent=p;\r\n\t\treturn i;\r\n\t}\r\n\r\n\r\n\tsplit2(a,b){\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst x2=(x0+x1)/2;\r\n\t\tconst y2=(y0+y1)/2;\r\n\t\tconst v=this.addraw(x2,y2);\r\n\t\treturn v;\r\n\t}\r\n\r\n\tsplit3(a,b,c){\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n\t\tconst p2=this.points[c];\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst x2=p2[0];\r\n\t\tconst y2=p2[1];\r\n\t\tconst x3=x1+(x0+x2-2*x1)*0.6;\r\n\t\tconst y3=y1+(y0+y2-2*y1)*0.6;\r\n\t\tconst v=this.addraw(x3,y3);\r\n\t\treturn v;\r\n\t}\r\n\r\n\t// a,b are along edge\r\n\t// returns new point if equalat safe from others\r\n\r\n\ttriangulate2(a,b,c){\r\n\t\tconst e=0.866;\r\n\t\tconst e1=0.5;\r\n\t\tconst e2=1.0;\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n//\t\tconst p2=c?this.points[c]:null;\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst dx=x1-x0;\r\n\t\tconst dy=y1-y0;\r\n\t\tconst dd=dx*dx+dy*dy;\t\t\r\n\t\tlet isnew=false;\r\n\t\tlet v=-1;\r\n\t\tif(dd>0){\r\n\t\t\tconst x2=(x0+x1)/2-e1*dy;\r\n\t\t\tconst y2=(y0+y1)/2+e1*dx;\r\n\t\t\tconst target2=this.closest(x2,y2,-1);\r\n\t\t\tconst v2=target2.vertex;\r\n\r\n\t\t\tconst x3=(x0+x1)/2-e2*dy;\r\n\t\t\tconst y3=(y0+y1)/2+e2*dx;\r\n\t\t\tconst target3=this.closest(x3,y3,-1);\r\n\t\t\tconst v3=target3.vertex;\r\n\r\n\t\t\tif(v3!=a&&v3!=b&&v3!=c){//||target.distance>3){\r\n\t\t\t\tv=v3;\r\n\t\t\t}else{\r\n\t\t\t\tif(v2==a||v2==b){//||target.distance>3){\r\n\t\t\t\t\tconst x4=(x0+x1)/2-e*dy;\r\n\t\t\t\t\tconst y4=(y0+y1)/2+e*dx;\r\n\t\t\t\t\tv=this.addraw(x4,y4);\r\n\t\t\t\t\tisnew=true;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tv=v2;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {v,isnew}\r\n\t}\r\n\r\n\ttriangulate(a,b){\r\n\t\tconst e=0.866;\r\n\t\tconst e1=0.5;\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n//\t\tconst p2=c?this.points[c]:null;\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst dx=x1-x0;\r\n\t\tconst dy=y1-y0;\r\n\t\tconst dd=dx*dx+dy*dy;\t\t\r\n\t\tlet isnew=false;\r\n\t\tlet v=-1;\r\n\t\tif(dd>0){\r\n\t\t\tconst x2=(x0+x1)/2-e1*dy;\r\n\t\t\tconst y2=(y0+y1)/2+e1*dx;\r\n\t\t\tconst target2=this.closest(x2,y2,-1);\r\n\t\t\tconst v2=target2.vertex;\r\n\t\t\tif(v2==a||v2==b||target2.distance>3){\r\n\t\t\t\tconst x4=(x0+x1)/2-e*dy;\r\n\t\t\t\tconst y4=(y0+y1)/2+e*dx;\r\n\t\t\t\tv=this.addraw(x4,y4);\r\n\t\t\t\tisnew=true;\r\n\t\t\t}else{\r\n\t\t\t\tv=v2;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {v,isnew}\r\n\t}\r\n\r\n\tweld(a,b){\r\n\t\tconst pts=this.points;\r\n\t\tconst x=(pts[a][0]+pts[b][0])/2;\r\n\t\tconst y=(pts[a][1]+pts[b][1])/2;\r\n\t\tpts[a][0]=x;\r\n\t\tpts[b][0]=x;\r\n\t\tpts[a][1]=y;\r\n\t\tpts[b][1]=y;\r\n\t}\r\n\r\n\t// fat search -2..2 in pointmap\r\n\r\n\tclosestEdge(edge,x,y,c){\r\n\t\tlet vertex=-1;\r\n\t\tlet distance=1e9;\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tlet px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tlet py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px<0) px=0;\r\n\t\tif(py<0) py=0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tfor(let sy=-2;sy<3;sy++){\r\n\t\t\tconst psy=py+sy;\r\n\t\t\tif(psy<0) continue;\r\n\t\t\tif(psy>=h) continue;\t\t\r\n\t\t\tfor(let sx=-2;sx<3;sx++){\r\n\t\t\t\tconst psx=px+sx;\r\n\t\t\t\tif(psx<0) continue;\r\n\t\t\t\tif(psx>=w) continue;\r\n\t\t\t\tconst index=psy*w+psx;\r\n\t\t\t\tfor(const p of this.pointMap[index]){\r\n\t\t\t\t\tconst vert=p[2];\r\n\t\t\t\t\tif(vert!=c && edge.includes(vert)){\r\n\t\t\t\t\t\tconst dx=p[0]-x;\r\n\t\t\t\t\t\tconst dy=p[1]-y;\r\n\t\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\t\tif(dd<distance){\r\n\t\t\t\t\t\t\tdistance=dd;\r\n\t\t\t\t\t\t\tvertex=vert;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {vertex,distance};\r\n\t}\r\n\r\n\tclosest(x,y,c){\r\n\t\tlet vertex=-1;\r\n\t\tlet distance=1e9;\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tlet px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tlet py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px<0) px=0;\r\n\t\tif(py<0) py=0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tfor(let sy=-1;sy<2;sy++){\r\n\t\t\tconst psy=py+sy;\r\n\t\t\tif(psy<0) continue;\r\n\t\t\tif(psy>=h) continue;\t\t\r\n\t\t\tfor(let sx=-1;sx<2;sx++){\r\n\t\t\t\tconst psx=px+sx;\r\n\t\t\t\tif(psx<0) continue;\r\n\t\t\t\tif(psx>=w) continue;\r\n\t\t\t\tconst index=psy*w+psx;\r\n\t\t\t\tfor(const p of this.pointMap[index]){\r\n\t\t\t\t\tif(p[2]!=c){\r\n\t\t\t\t\t\tconst dx=p[0]-x;\r\n\t\t\t\t\t\tconst dy=p[1]-y;\r\n\t\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\t\tif(dd<distance){\r\n\t\t\t\t\t\t\tdistance=dd;\r\n\t\t\t\t\t\t\tvertex=p[2];\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n//\t\tif(vertex==-1) debugger;\r\n\t\treturn {vertex,distance};\r\n\t}\r\n\r\n\tspiral(v,c,topo,measure,rings){\r\n\t\tlet u=0.0;\r\n\t\tconst verts=[];\r\n\t\tconst tris=[];\r\n\t\tconst points=this.points;\r\n\t\tconst n=v.length;\r\n\t\tlet list=[];\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst x0=v[i][0];\r\n\t\t\tconst y0=v[i][1];\r\n\t\t\tconst ii=(i+1);\r\n\t\t\tconst x1=v[ii][0];\r\n\t\t\tconst y1=v[ii][1];\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tconst div=(d/measure)|0;\r\n\t\t\tif(div>0){\r\n\t\t\t\tconst nn=(i==n-2)?div+1:div;\r\n\t\t\t\tfor(let j=0;j<nn;j++){\r\n\t\t\t\t\tconst px=x0+dx*j/div;\r\n\t\t\t\t\tconst py=y0+dy*j/div;\r\n//\t\t\t\t\tthis.addraw(px,py);\r\n\t\t\t\t\tconst v=this.addPoint(px,py,u);\r\n\t\t\t\t\tif(v!=-1) {\r\n\t\t\t\t\t\tlist.push(v);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// simon come here and validate this\r\n\t\t\t\t\tu+=d/div;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tconst threshold=600;\r\n\t\tconst threshold2=250;\r\n\t\tfor(let ring=0;ring<rings;ring++){\r\n\t\t\tconst edge=[];\t//list of indexes with -1 separator\r\n\t\t\tconst count=list.length;\r\n\t\t\tlet prevt=-1;\r\n\t\t\tfor(let i=0;i<count-1;i++){\r\n\t\t\t\tconst t0=list[i];\t\t\t\t\r\n\t\t\t\tconst t1=list[i+1];\r\n\t\t\t\tif(t0==-1 || t1==-1) {\r\n\t\t\t\t\tprevt=-1;\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\tconst tt=this.triangulate(t0,t1,prevt);\r\n\t\t\t\tlet t=tt.v;\r\n\t\t\t\tif(t==-1){\r\n\t\t\t\t\tedge.push(-1);\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\r\n\t\t\t\ttris.push([t0,t,t1]);\r\n\t\t\t\tif(t==prevt){\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(!tt.isnew){\r\n\t\t\t\t\tedge.push(-1);\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tif(prevt>-1){//} && t!=prevt){\r\n\t\t\t\t\tconst p0=points[prevt];\r\n\t\t\t\t\tconst p1=points[t];\r\n\t\t\t\t\tif(!(p0&&p1)){\r\n\t\t\t\t\t\tdebugger;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tconst dx=p1[0]-p0[0];\r\n\t\t\t\t\tconst dy=p1[1]-p0[1];\r\n\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\tif(dd<threshold2){\r\n\t\t\t\t\t\tthis.weld(prevt,t);\r\n\r\n\t\t\t\t\t}else{\r\n\r\n\t\t\t\t\t\tif (dd<threshold){\r\n\t\t\t\t\t\t\ttris.push([t0,prevt,t]);\r\n\t\t\t\t\t\t\tedge.push(t);\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tconst t2=this.split3(prevt,t0,t);\r\n\t\t\t\t\t\t\tconst slice=points.slice(-2,-1);\r\n\t\t\t\t\t\t\tpoints.push(slice[0]);\r\n\t\t\t\t\t\t\tedge.push(t2);\r\n\t\t\t\t\t\t\tedge.push(t);\r\n\t\t\t\t\t\t\ttris.push([t0,prevt,t2]);\r\n\t\t\t\t\t\t\ttris.push([t0,t2,t]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tprevt=t;\r\n\t\t\t}\r\n/*\r\n// weld members of edge\r\n\t\t\tconst count2=edge.length;\r\n\t\t\tprevt=-1;\r\n\t\t\tconst weld=[];\r\n\t\t\tfor(let i=1;i<count-1;i++){\r\n\t\t\t\tconst p0=edge[i-1];\r\n\t\t\t\tconst p1=edge[i];\r\n\t\t\t\tconst p2=edge[i+1];\r\n\t\t\t\tif(p1>-1){\r\n\t\t\t\t\tconst p=points[p1];\r\n\t\t\t\t\tconst c=this.closestEdge(edge,p[0],p[1],p[2]);\t// x,y,c(exclude)\r\n\t\t\t\t\tconst v=c.vertex;\r\n\t\t\t\t\tif(v==-1||v==p0||v==p2) continue;\r\n\t\t\t\t\tconst ii=edge.indexOf(v);\r\n\t\t\t\t\tweld.push([i,ii]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tconsole.log(\"welds:\"+weld.length);\r\n\t\t\tfor(const w of weld){\r\n\t\t\t\tconst w0=edge[w[0]];\r\n\t\t\t\tconst w1=edge[w[1]];\r\n\t\t\t\tthis.weld(w0,w1);\r\n\t\t\t}\r\n\t\t\tfor(const w of weld){\r\n\t\t\t\tedge[w[0]]=-1;\r\n\t\t\t\tedge[w[1]]=-1;\r\n\t\t\t}\r\n*/\r\n//\t\t\tconst log=edge.join();\r\n//\t\t\tconsole.log(\"edge:\",edge);\r\n\t\t\tlist=edge;\r\n\t\t}\r\n\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n\t\t\tconst h1=topo.pickHeight(px,py);\r\n\t\t\tverts.push([px,-py,h0+h1,3,0,0,0,c]);\r\n\t\t}\r\n\r\n\t\tif(verts.length&&tris.length){\r\n\t\t\treturn new Surface(verts,tris,[]);\r\n\t\t}\r\n\t}\r\n\r\n\twalledSpiral(v,roofc,wallc,topo,wallRect){\r\n\t\tconst age=1;//12//rings\r\n\t\tconst measure=5;//=5;\r\n\t\tconst verts=[];\r\n\t\tconst tris=[];\r\n\t\tconst points=this.points;\r\n\t\tconst n=v.length;\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst ii=i+1;\r\n\t\t\tif(v[i][3]&&v[ii][3]){\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tconst x0=v[i][0];\r\n\t\t\tconst y0=v[i][1];\r\n\t\t\tconst u0=v[i][2];\r\n\t\t\tconst x1=v[ii][0];\r\n\t\t\tconst y1=v[ii][1];\r\n\t\t\tconst u1=v[ii][2];\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst du=u1-u0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tconst div=(d/measure)|0;\r\n\t\t\tif(div>0){\r\n\t\t\t\tconst count=(ii==n-1)?div+1:div;\r\n\t\t\t\tfor(let j=0;j<count;j++){\r\n\t\t\t\t\tconst px=x0+dx*j/div;\r\n\t\t\t\t\tconst py=y0+dy*j/div;\r\n\t\t\t\t\tconst pu=u0+du*j/div;\r\n\t\t\t\t\tthis.addPoint(px,py,pu);\r\n\t\t\t\t}\r\n\t\t\t}\r\n//\t\t\tthis.close();\r\n\t\t}\r\n\t\tconst ww=points.length;\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst pu=p[2];\r\n\t\t\tconst g0=topo.pickGround(px,py);\r\n\t\t\tverts.push([px,-py,g0,pu,0,0,0,wallc]);\r\n\t\t}\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst pu=p[2];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n\t\t\tconst h1=topo.sampleHeight(px,py,2).max;\r\n\t\t\tverts.push([px,-py,h0+h1+16,pu,0,0,0,wallc]);\r\n\t\t}\r\n\t\tfor(let w=0;w<ww-1;w++){\r\n\t\t\ttris.push([w,w+ww,w+ww+1]);\r\n\t\t\ttris.push([w,w+ww+1,w+1]);\r\n\t\t}\r\n/*\r\n\t\tlet ground=verts.length;\r\n\t\tlet count=points.length;\r\n\t\tlet offset=0;\r\n\t\tfor(let ring=0;ring<age;ring++){\r\n\t\t\tlet prevt=-1;\r\n\t\t\tfor(let i=0;i<count-1;i++){\r\n\t\t\t\tconst ii=i+1;\r\n\t\t\t\tconst t0=offset+i;\r\n\t\t\t\tconst t1=offset+ii;\r\n\t\t\t\tconst tt=this.triangulate(t0,t1);\r\n\t\t\t\tlet t=tt.v;\r\n\t\t\t\tif(t==-1){\r\n//\t\t\t\t\tprevt=t;\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\tif(prevt>-1 && prevt!=t){\r\n\t\t\t\t\tconst p0=points[prevt];\r\n\t\t\t\t\tconst p1=points[t];\r\n\t\t\t\t\tif(!(p0&&p1)){\r\n\t\t\t\t\t\tdebugger;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tconst dx=p1[0]-p0[0];\r\n\t\t\t\t\tconst dy=p1[1]-p0[1];\r\n\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\tif (dd<150){\r\n\t\t\t\t\t\ttris.push([ground+t0,ground+prevt,ground+t]);\r\n\t\t\t\t\t}else{ // fan from prevt to t\r\n\t\t\t\t\t\t// warning overly complicated insert method\r\n\t\t\t\t\t\tconst tt1=this.triangulate(prevt,t);\r\n\t\t\t\t\t\tif(tt1.isnew){\r\n\t\t\t\t\t\t\tconst slice=points.slice(-2,-1);\r\n\t\t\t\t\t\t\tpoints.push(slice[0]);\r\n\t\t\t\t\t\t\tconst t2=tt1.v;\r\n\t\t\t\t\t\t\ttris.push([ground+prevt,ground+t2,ground+t0]);\r\n\t\t\t\t\t\t\ttris.push([ground+t0,ground+t2,ground+t]);\r\n\t\t\t\t\t\t\tt=t2;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\ttris.push([ground+t0,ground+t,ground+t1]);\r\n\t\t\t\tif(tt.isnew){\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(prevt>-1){\r\n\t\t\t\t\t\ttris.push([ground+offset+i,ground+prevt,ground+t]);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n//\t\t\t\ttris.push([ground+offset+i,ground+t,ground+offset+ii]);\r\n\t\t\t\tprevt=t;\r\n\t\t\t}\t\t\r\n\t\t\toffset+=count;\r\n\t\t\tcount=points.length-offset;\r\n\t\t\tif(count==0){\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n//\t\t\tconst h1=topo.pickHeight(px,py);\r\n\t\t\tconst h1=topo.pickHeightMinMax(px,py).max;\r\n\t\t\tverts.push([px,-py,h0+h1,3,0,0,0,roofc]);\r\n\t\t}\r\n\t\t\r\n*/\r\n\t\tif(verts.length&&tris.length){\r\n\t\t\treturn new Surface(verts,tris,[]);\r\n\t\t}\r\n\r\n\t}\r\n\r\n\tspiral2(v,c,tile,measure,rings){\r\n\t\tlet u=0.0;\r\n\t\tconst verts=[];\r\n\t\tconst tris=[];\r\n\t\tconst points=this.points;\r\n\t\tconst n=v.length;\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst x0=v[i][0];\r\n\t\t\tconst y0=v[i][1];\r\n\t\t\tconst ii=(i+1);\r\n\t\t\tconst x1=v[ii][0];\r\n\t\t\tconst y1=v[ii][1];\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tconst div=(d/measure)|0;\r\n\t\t\tif(div>0){\r\n\t\t\t\tconst nn=(i==n-2)?div+1:div;\r\n\t\t\t\tfor(let j=0;j<nn;j++){\r\n\t\t\t\t\tconst px=x0+dx*j/div;\r\n\t\t\t\t\tconst py=y0+dy*j/div;\r\n//\t\t\t\t\tthis.addraw(px,py);\r\n\t\t\t\t\tthis.addPoint(px,py,u);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tlet offset=0;\r\n\t\tlet count=points.length;\r\n\t\tfor(let ring=0;ring<rings;ring++){\r\n\t\t\tlet prevt=-1;\r\n\t\t\tfor(let i=0;i<count-1;i++){\r\n\t\t\t\tconst ii=i+1;\r\n\t\t\t\tconst tt=this.triangulate(offset+i,offset+ii);\r\n\t\t\t\tconst t=tt.v;\r\n\t\t\t\tif(t==-1){\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\ttris.push([offset+i,t,offset+ii]);\r\n\t\t\t}\t\t\r\n\r\n\t\t\toffset+=count;\r\n\t\t\tcount=points.length-offset;\r\n\t\t\tif(count==0){\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n\t\t\tconst h1=topo.pickHeight(px,py);\r\n\t\t\tverts.push([px,-py,h0+h1,3,0,0,0,c]);\r\n\t\t}\r\n\r\n\t\tif(verts.length&&tris.length){\r\n\t\t\treturn new Surface(verts,tris,[]);\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\n\r\n// final point not always weld of first\r\n\r\nfunction TraceClosedOutline(context,outline){\r\n\tconst clip=ScratchRes;\r\n\tconst n=outline.length;\r\n\tconst p=outline[n-1];\r\n\tlet px=p[0]/2;\r\n\tlet py=p[1]/2;\r\n\tlet exitEdge=0;\r\n\tlet enterEdge=0;\r\n\tconst edge=[];\r\n\tfor(let w=0;w<outline.length;w++){\r\n\t\tconst v=outline[w];\r\n\t\tconst x=v[0]/2;\r\n\t\tconst y=v[1]/2;\r\n\t\tif(px<0 && x>0) enterEdge=4;\r\n\t\tif(py<0 && y>0) enterEdge=1;\r\n\t\tif(px>=clip&&x<clip) enterEdge=2;\r\n\t\tif(py>=clip&&py<clip) enterEdge=3;\r\n\t\tif(enterEdge&&exitEdge){\r\n\t\t\twhile(exitEdge!=enterEdge){\r\n\t\t\t\tswitch(exitEdge){\r\n\t\t\t\t\tcase 4:\r\n\t\t\t\t\t\tedge.push([0,0]);\r\n\t\t\t\t\t\texitEdge=1;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 1:\r\n\t\t\t\t\t\tedge.push([clip-1,0]);\r\n\t\t\t\t\t\texitEdge=2;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 2:\r\n\t\t\t\t\t\tedge.push([clip-1,clip-1]);\r\n\t\t\t\t\t\texitEdge=3;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 3:\r\n\t\t\t\t\t\tedge.push([0,clip-1]);\r\n\t\t\t\t\t\texitEdge=4;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tedge.push([x,y]);\r\n\t\texitEdge=enterEdge;\r\n\t}\r\n\tlet count=0;\r\n\tfor(const e of edge){\r\n\t\tconst x=e[0];\r\n\t\tconst y=e[1];\r\n\t\tif(count==0){\r\n\t\t\tcontext.moveTo(x,y);\r\n\t\t}else{\r\n\t\t\tcontext.lineTo(x,y);\r\n\t\t}\r\n\t\tcount++;\r\n\t}\r\n}\r\n\r\nfunction DrawSurface(context,surface){\r\n\tconst c=surface.verts32;\r\n\tconst t=surface.tris.flat();\r\n\tfor(let i=0;i<t.length;i+=3){\r\n\t\tconst v0=c[t[i+0]];\r\n\t\tconst v1=c[t[i+1]];\r\n\t\tconst v2=c[t[i+2]];\r\n\t\tcontext.moveTo(v0[0],-v0[1]);\r\n\t\tcontext.lineTo(v1[0],-v1[1]);\r\n\t\tcontext.lineTo(v2[0],-v2[1]);\r\n\t\tcontext.lineTo(v0[0],-v0[1]);\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_surface.js\",\"length\":5021,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_surface.js\r\n// (c)2022 Simon Armstrong\r\n// All rights reserved\r\n\r\n// verts are 8 shorts x,y,z,w,nx,ny,nz,c\r\n\r\nfunction Normalfy(a4){\r\n\tconst d=Math.sqrt(a4[0]*a4[0]+a4[1]*a4[1]+a4[2]*a4[2]);\r\n\tconst q=1.0/d;\r\n\ta4[0]*=q;\r\n\ta4[1]*=q;\r\n\ta4[2]*=q;\r\n}\r\n\r\nclass Normals{\r\n\tconstructor(n){\r\n\t\tthis.data=new Float32Array(n*4);\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.data.fill(0);\r\n\t}\r\n\r\n\tadd(index,v4){\r\n\t\tconst n4=this.data;\r\n\t\tn4[index*4+0]+=v4[0];\r\n\t\tn4[index*4+1]+=v4[1];\r\n\t\tn4[index*4+2]+=v4[2];\r\n\t\tn4[index*4+3]++;\r\n\t}\r\n\t\r\n\taverageNormalfy(index){\r\n\t\tconst n4=this.data;\r\n\t\tconst n=n4[index*4+3];\r\n\t\tif(n>1){\r\n\t\t\tn4[index*4+0]/=n;\r\n\t\t\tn4[index*4+1]/=n;\r\n\t\t\tn4[index*4+2]/=n;\r\n\t\t}\r\n\t\tn4[index*4+3]=0;\r\n\t}\r\n\r\n}\r\n\r\nconst One=0x7fff;\r\n\r\nclass Surface{\r\n\tconstructor(verts,tris,quads){\r\n\t\tlet n=0;\r\n\t\tlet verts32=null;\r\n\t\tif(verts.flat){\r\n\t\t\tn=verts.length;\r\n\t\t\tverts32=new Float32Array(n*8);\r\n\t\t\tlet o=0;\r\n\t\t\tfor(const v of verts){\r\n\t\t\t\tfor(let i=0;i<v.length;i++){\r\n\t\t\t\t\tverts32[o+i]=v[i];\r\n\t\t\t\t}\r\n\t\t\t\to+=8;\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tn=verts.length/8;\r\n\t\t\tverts32=new Float32Array(n*8);\r\n\t\t\tverts32.set(verts);\r\n\t\t}\r\n\t\tthis.vertCount=n;\r\n\t\tthis.verts32=verts32;\r\n//\t\tthis.verts=verts;\r\n// if typedarray no flatten required\r\n\t\tthis.tris=tris.flat?tris.flat():tris;\r\n\t\tthis.quads=quads.flat();\r\n\t\tthis.divs={}\r\n\t\tif(n>65534){\r\n\t\t\tconsole.log(\"Warning surface count:\",n);\r\n\t\t}\r\n\t}\r\n\r\n\tflatifyVerts(){\r\n\t\tthis.calcNormals();\r\n\t\treturn this.verts32;\r\n\t}\r\n\r\n\tquadTris(){\r\n\t\tconst q=this.quads;\r\n\t\tconst n=q.length/4;\r\n\t\tlet t=[this.tris];\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tconst v0=q[i*4+0];\r\n\t\t\tconst v1=q[i*4+1];\r\n\t\t\tconst v2=q[i*4+2];\r\n\t\t\tconst v3=q[i*4+3];\r\n\t\t\tt.push([v0,v2,v1]);\r\n\t\t\tt.push([v0,v3,v2]);\r\n\t\t}\r\n\t\tt=t.flat();\r\n\t\tthis.tris=t;\r\n//\t\tthis.quads=[];\r\n\t\treturn t;\r\n\t}\r\n\r\n\tflatNormals(){\r\n\t\tconst n=vertCount;\r\n\t\tconst verts=this.verts32;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tverts[i*8+4]=0;\r\n\t\t\tverts[i*8+5]=One;\r\n\t\t\tverts[i*8+6]=0;\r\n\t\t\tverts[i*8+7]=1;\r\n\t\t}\r\n\t}\r\n/*\t\r\n\t\tconst i3=this.tris;\r\n\t\tconst n3=this.tris.length/3;\r\n\t\tconst nn=new Array(n*4).fill(0);\r\n\t\tfor(let i=0;i<n3;i++){\r\n\t\t\tconst v0=i3[i*3+0];\r\n\t\t\tconst v1=i3[i*3+1];\r\n\t\t\tconst v2=i3[i*3+2];\r\n\t\t}\r\n\r\n\t}\r\n\r\n*/\r\n\tcalcNormals(zfactor){\r\n\t\tconst n=this.vertCount;\r\n\t\tconst v32=this.verts32;\r\n\t\tconst i3=this.tris;\r\n\t\tconst n3=this.tris.length/3;\t\r\n\t\t\r\n\t\tconst normals=new Normals(n);\r\n\r\n\t\t// simon come here and adjust zfactor normal for level\r\n\r\n\t\tfor(let i=0;i<n3;i++){\r\n\t\t\tconst a=i3[i*3+0];\r\n\t\t\tconst b=i3[i*3+1];\r\n\t\t\tconst c=i3[i*3+2];\r\n\t\t\tif(a>=n||b>=n||c>=n){\r\n\t\t\t\tdebugger;\r\n\t\t\t}\r\n\t\t\tconst u=[v32[b*8+0]-v32[a*8+0],v32[b*8+1]-v32[a*8+1],(v32[b*8+2]-v32[a*8+2])*zfactor];\r\n\t\t\tconst v=[v32[c*8+0]-v32[a*8+0],v32[c*8+1]-v32[a*8+1],(v32[c*8+2]-v32[a*8+2])*zfactor];\r\n\r\n\t\t\tNormalfy(u);\r\n\t\t\tNormalfy(v);\r\n\r\n\t\t\tconst t=[u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]];\r\n\r\n\t\t\tnormals.add(a,t);\r\n\t\t\tnormals.add(b,t);\r\n\t\t\tnormals.add(c,t);\r\n\t\t}\r\n\t\tconst n4=normals.data;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tnormals.averageNormalfy(i);\r\n\t\t\tv32[i*8+4]=One*n4[i*4+0];\r\n\t\t\tv32[i*8+5]=One*n4[i*4+1];\r\n\t\t\tv32[i*8+6]=One*n4[i*4+2];\r\n\t\t\tv32[i*8+7]=0;\r\n\t\t}\r\n\t}\r\n\r\n\tfuzzNormals(){\r\n\t\tconst n=this.vertCount;\r\n\t\tconst v32=this.verts32;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tconst nx=Math.random()-0.5;\r\n\t\t\tconst ny=Math.random()-0.5;\r\n\t\t\tconst nz=Math.random()-0.5;\r\n\t\t\tconst d=nx*nx+ny*ny+nz*nz;\r\n\t\t\tconst one=One;//1.0;\r\n\t\t\tv32[i*8+4]=one*nx/d;\r\n\t\t\tv32[i*8+5]=one*ny/d;\r\n\t\t\tv32[i*8+6]=one*nz/d;\r\n\t\t\tv32[i*8+7]=0;\r\n\t\t}\r\n\r\n\t}\r\n\r\n\r\n/*\r\n\r\n\r\n\r\ncross(i0,i1,i2){\r\n\t\tconst v0=this.verts[i0];\r\n\t\tconst v1=this.verts[i1];\r\n\t\tconst v2=this.verts[i2];\r\n\t\treturn Cross(\r\n\t\t\t[v0[0]-v1[0],v0[1]-v1[1],v0[2]-v1[2]],\r\n\t\t\t[v2[0]-v1[0],v2[1]-v1[1],v2[2]-v1[2]]);\r\n\t}\r\n*/\r\n\tdiv(v0,v1,r,verts){\r\n\t\tconst key=(v0>v1)?hex6(v1)+hex6(v0):hex6(v0)+hex6(v1);\r\n\t\tconst divs=this.divs;\r\n\t\tconst v32=this.verts32;\r\n\t\tif(!(key in divs)){\r\n\t\t\tconst n=this.vertCount++;\r\n\t\t\tdivs[key]=n;\r\n//\t\t\tconst p0=this.verts[v0];\r\n//\t\t\tconst p1=this.verts[v1];\r\n\t\t\tconst x=v32[v0*8+0]+v32[v1*8+0];\r\n\t\t\tconst y=v32[v0*8+1]+v32[v1*8+1];\r\n\t\t\tconst z=v32[v0*8+2]+v32[v1*8+2];\r\n\t\t\tconst m=r?r/Math.sqrt(x*x+y*y+z*z):0.5;\r\n\t\t\tconst w=v32[v0*8+3]||v32[v1*8+3];\r\n\t\t\tverts.push([x*m,y*m,z*m,w]);\r\n\t\t}\r\n\t\treturn divs[key];\r\n\t}\r\n\r\n\tdivide(r){\r\n\t\tconst e=[];\r\n\t\tconst tcount=this.tris.length;\r\n\t\tconst verts=[];\r\n\t\tfor(let t=0;t<tcount;t+=3){\r\n\t\t\tconst v0=this.tris[t+0];\r\n\t\t\tconst v1=this.tris[t+1];\r\n\t\t\tconst v2=this.tris[t+2];\r\n\t\t\tconst s0=this.div(v0,v1,r,verts);\r\n\t\t\tconst s1=this.div(v1,v2,r,verts);\r\n\t\t\tconst s2=this.div(v2,v0,r,verts);\r\n\t\t\te.push([v0,s0,s2]);\r\n\t\t\te.push([s2,s0,s1]);\r\n\t\t\te.push([v2,s2,s1]);\r\n\t\t\te.push([s1,s0,v1]);\r\n\t\t}\r\n\t\tconst n=this.vertCount;\r\n\t\tconst verts32=this.verts32;\r\n\t\tconst n2=verts.length;\r\n\t\tconst v32=new Float32Array((n+n2)*8)\r\n\t\t// add new verts to old\r\n\t\tv32.set(this.verts32);\r\n\t\tfor(let i=0;i<n2;i++){\r\n\t\t\tconst o=(n+i)*8;\r\n\t\t\tv32[o+0]=verts[i][0];\r\n\t\t\tv32[o+1]=verts[i][1];\r\n\t\t\tv32[o+2]=verts[i][2];\r\n\t\t\tv32[o+3]=verts[i][3];\r\n\t\t}\r\n\t\tthis.verts32=v32;\r\n\t\tthis.vertCount=n+n2;\r\n\t\tthis.tris=e.flat();\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_core.js\",\"length\":25938,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_core.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n// GLViewport Shape Layer Program Shader WebGL2Context\r\n\r\n/*\r\n\r\npoint cloud sprites\r\n\r\ncamera facing quads with same vertex corners\r\n\r\n*/\r\n\r\n\"use strict\"\r\n\r\nlet TilesRetired=0;\r\n\r\nconst PointCloudRes=16;\r\n\r\nconst WallFactor=1.0/64;\r\n\r\nconst TypeDim={SCALAR:1,VEC3:3,VEC2:2,VEC4:4};\r\n\r\nconst SkipRoads=[\"motorway\",\"residential\",\"secondary\",\"tertiary\",\"service\",\"parking\"];\r\n\r\nclass TextureLoader{\r\n\tconstructor(path,handler){\r\n\t\tthis.handler=handler;\r\n\t\tconst image=new Image();\r\n\t\timage.crossOrigin=\"anonymous\";\r\n\t\timage.onload=this.imageLoad.bind(this);\r\n\t\timage.onerror=this.imageError.bind(this);\r\n\t\tthis.image=image;\r\n\t\tthis.image.src=path;\r\n// yeh nah\tif(image.complete) handler(image);\r\n\t}\r\n\timageLoad(){\r\n\t\tconsole.log(\"imageLoaded:\",this.image.src);\r\n\t\tthis.loaded=true;\r\n\t\tif (this.handler) this.handler(this.image);\r\n\t}\r\n\timageError(errorevent){\r\n\t\tconsole.log(\"imageError:\",this.image.src,errorevent.message);\r\n\t}\r\n}\r\n\r\nconst SharedTextures={}; //src:{texture,count}\r\nconst TextureBin=[]; // of textures\r\n\r\nfunction ShareTexture(gl,image){\t\r\n\tif(image.src in SharedTextures){\r\n\t\tconst tc=SharedTextures[image.src];\r\n\t\ttc.count++;\r\n\t\treturn tc;\r\n\t}\r\n\tconst texture = gl.createTexture();\r\n\tgl.bindTexture(gl.TEXTURE_2D, texture);\r\n\tgl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, image);\r\n\tgl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\r\n\tgl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\r\n\tgl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\r\n\tconst tc={src:image.src,texture:texture,count:1};\r\n\tSharedTextures[image.src]=tc;\r\n\treturn tc;\r\n}\r\n\r\nfunction ReleaseTexture(tc){\r\n\tif(--tc.count==0){\r\n\t\tTextureBin.push(tc.texture);\r\n\t\tdelete SharedTextures[tc.src];\r\n\t}\r\n}\r\n\r\nfunction FlushTextureBin(gl){\r\n\tfor(const texture of TextureBin){\r\n\t\tgl.deleteTexture(texture);\r\n\t}\r\n\tTextureBin.length=0;\r\n}\r\n\r\n\r\n// moved to baker\r\n\r\nfunction TopoFloraSurface(count,mag,c,topo,floraMin){\r\n\tconst p=2048/count;\r\n\tconst res=count+1;\r\n\tconst a=new Array(res);\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(res);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h0=topo.pickElevation(x*p,y*p);\r\n//\t\t\tlet h1=topo.pickHeight(x*p,y*p);\r\n\t\t\tconst m=topo.pickHeightMinMax(x*p,y*p);\r\n\t\t\tif(m.min>floraMin){\r\n\t\t\t\tconst h1=m.max;\r\n\t\t\t\ta[y][x]=h0+h1;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tconst verts=[];\r\n\tconst v=[];\r\n\tconst i=[];\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mz=a[y][x];\r\n\t\t\tlet vert=-1;\r\n\t\t\tif(mz){\r\n\t\t\t\tconst mx=mag*x;\r\n\t\t\t\tconst my=-mag*y;\r\n\t\t\t\tvert=v.length;\r\n\t\t\t\tv.push([mx,my,mz,15, 0,0,0,c]);\r\n\t\t\t}\r\n\t\t\tverts.push(vert);\r\n\t\t}\r\n\t}\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=verts[y*res+x];\r\n\t\t\tconst v1=verts[y*res+x+1];\r\n\t\t\tconst v2=verts[(y+1)*res+x+1];\r\n\t\t\tconst v3=verts[(y+1)*res+x];\r\n\t\t\tif(v0>-1&&v1>-1&&v2>-1&&v3>-1){\r\n\t\t\t\ti.push([v0,v2,v1]);\r\n\t\t\t\ti.push([v0,v3,v2]);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n\r\n// 0x4000 is new zero, count is typically 128, short index friendly\r\n\r\n// in which verticy sample is too steep skip edge\r\n\r\nfunction CreateTopoSurface(count,m,c,topo){\r\n\tconst a=new Array(count+1);\r\n\tconst p=2048/count;\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(count+1);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h=topo.pickTopo(x*p,y*p);\r\n\t\t\ta[y][x]=h;\r\n\t\t}\r\n\t}\r\n\t\r\n\tlet v=[];\r\n\tconst i=[];\r\n\r\n\tconst crack=[];\r\n\tconst max=[];\r\n\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mx=m*x;\r\n\t\t\tconst my=-m*y;\r\n\t\t\tconst ground=a[y][x].ground;\r\n\t\t\tconst minz=a[y][x].min;\r\n\t\t\tconst maxz=a[y][x].max;\r\n\t\t\tlet bits=0;\r\n\t\t\tif(ground==0 && maxz-minz>12){\r\n\t\t\t\tmax.push(crack.length);\r\n\t\t\t\tbits=1;\r\n\t\t\t\tcrack.push([mx,my,maxz,c, 0,0,0,bits]);\r\n\t\t\t}else{\r\n\t\t\t\tmax.push(-1);\r\n\t\t\t}\r\n\t\t\tconst z=ground||minz;\r\n\t\t\tv.push([mx,my,z,c, 0,0,0,bits]);\r\n\t\t}\r\n\t}\r\n\tconst crackOffset=v.length;\r\n\tv=v.concat(crack);\r\n\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=x+y*d;\r\n\t\t\tconst v1=x+1+y*d;\r\n\t\t\tconst v2=x+(y+1)*d;\r\n\t\t\tconst v3=x+1+(y+1)*d;\r\n\t\t\t\r\n\t\t\tconst b0=v[v0][7];\r\n\t\t\tconst b1=v[v1][7];\r\n\t\t\tconst b2=v[v2][7];\r\n\t\t\tconst b3=v[v3][7];\r\n\r\n\t\t\tif(!(b0|b1|b2|b3)){\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t\ti.push(v1);\r\n\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v2);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t}else{\r\n\t\t\t\tconst m0=max[v0]>=0?crackOffset+max[v0]:v0;\r\n\t\t\t\tconst m1=max[v1]>=0?crackOffset+max[v1]:v1;\r\n\t\t\t\tconst m2=max[v2]>=0?crackOffset+max[v2]:v2;\r\n\t\t\t\tconst m3=max[v3]>=0?crackOffset+max[v3]:v3;\r\n\r\n\t\t\t\tif(b0||b3||b1){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\t\t\t\tif(b0||b2||b3){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b1||b0){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b3||b1){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n\r\n\r\nfunction TopoSurface2(count,m,c,topo){\r\n\tconst a=new Array(count+1);\r\n\tconst p=2048/count;\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(count+1);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h=topo.pickElevation(x*p,y*p);\r\n\t\t\ta[y][x]=h;\r\n\t\t}\r\n\t}\r\n\tconst v=[];\r\n\tconst i=[];\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mx=m*x;\r\n\t\t\tconst my=-m*y;\r\n\t\t\tconst mz=a[y][x];\r\n\t\t\tv.push([mx,my,mz,3, 0,0,0,c]);\r\n\t\t}\r\n\t}\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=x+y*d;\r\n\t\t\tconst v1=x+1+y*d;\r\n\t\t\tconst v2=x+(y+1)*d;\r\n\t\t\tconst v3=x+1+(y+1)*d;\r\n\t\t\ti.push(v0);\r\n\t\t\ti.push(v3);\r\n\t\t\ti.push(v1);\r\n\t\t\ti.push(v0);\r\n\t\t\ti.push(v2);\r\n\t\t\ti.push(v3);\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n\r\n\r\n// writes array with orthogonal view matrix\r\n\r\nfunction TranslateZoomAngleAspect(array,tx,ty,zoom,angle,w,h,tilt,altitude,hfactor,rect){\r\n\tconst yscale=1.0-tilt*0.1;\r\n\tconst zoomx=zoom*2.0/w;\r\n\tconst zoomy=-zoom*2.0*yscale/h;\r\n\r\n\tconst zoomz=zoom*hfactor/512;//384 1024;//256;\r\n\r\n\tconst sin=Math.sin(angle);\r\n\tconst cos=Math.cos(angle);\r\n\r\n\tarray[0]=zoomx*cos;\r\n\tarray[1]=zoomx*sin;\r\n\r\n\tarray[4]=zoomy*sin;\r\n\tarray[5]=zoomy*-cos;\r\n\tarray[6]=zoomz;\r\n\r\n\tarray[8]=0;\r\n\tarray[9]=0;\r\n\tarray[10]=-1.0/2048;//1024;//4096;\r\n\r\n\tarray[11]=0.5;//0x4000;//0.5;\r\n\r\n\tarray[15]=1;\r\n\r\n\tconst vcx=rect?-1+2*(rect[0]+rect[2]/2)/w:0;\r\n\tconst vcy=rect?1-2*(rect[1]+rect[3]/2)/h:0;\r\n\r\n\tarray[3]=vcx+zoomx*(-tx*cos-ty*sin);\r\n//\tarray[7]=zoomy*(-tx*sin+ty*cos-altitude);\r\n\tarray[7]=vcy+zoomy*(-tx*sin+ty*cos);\r\n}\r\n\r\nclass GraphicsDevice{\r\n\r\n\tconstructor(){\r\n\t\tthis.ResetArrays(16);\r\n//\t\tthis._RawPoints;\r\n\t}\r\n\tflush(){\r\n\t\t// pre delete stuff goes here\r\n\t}\r\n\tResetArrays(count){\r\n\t\tthis.RawPalette=new Float32Array(RoaPalette)\r\n\t\tthis.RawStyle=new Int16Array(StylePalette);\r\n//\t\tthis.RawSun=new Float32Array([-1,1,0,0]);\r\n//\t\tthis.RawSun=new Float32Array([-.2,-.8,.3,0]);\r\n\r\n\t\tthis.RawSun=new Float32Array([-0.8,0.5,0.02,0]);\r\n\t}\r\n}\r\n\r\nconst DisplayProfiles={\r\n\t\"Nvidia4096\":{\r\n\t\tAntiAlias:true,\r\n\t\tMaxHandles:512\r\n\t},\r\n\t\"Intel1056\":{\r\n\t\tAntiAlias:true,\r\n\t\tMaxHandles:32\r\n\t}\r\n}\r\n\r\nfunction MatrixArray(count){\r\n\tconst h=new Float32Array(16*count);\r\n\tfor(let i=0;i<count;i++){\r\n\t\th[i*16+0]=1;\r\n\t\th[i*16+5]=1;\r\n\t\th[i*16+10]=1;\r\n\t\th[i*16+15]=1;\r\n\t}\r\n\treturn h;\r\n}\r\n\r\nfunction hex6(d) {\r\n\treturn (d & 0xFFFFFF).toString(16).padStart(6, '0');\r\n}\r\n\r\n// a world of app panels\r\n\r\nclass GraphicsDisplay{\r\n\tconstructor(){\r\n\t\tthis.panels=[];\r\n\t\tthis.activePanel=null;\r\n\t\tthis.gpu=new GraphicsDevice();\r\n\t}\r\n\r\n\tflush(){\r\n\t\tfor(const app of this.panels){\r\n\t\t\tapp.flush();\r\n\t\t}\r\n\t\tthis.panels=null;\r\n\t\tthis.activePanel=null;\r\n\t\tthis.gpu.flush();\r\n\t}\r\n\r\n\tcompilePanels(){\r\n\t\tfor(const app of this.panels){\r\n\t\t\tapp.compile();\r\n\t\t}\t\r\n\t}\r\n\r\n\trender(){\r\n\t\tfor(const app of this.panels){\r\n\t\t\tapp.bake(this.gpu);\r\n\t\t}\t\r\n\t}\r\n\r\n\taddPanelLayers(canvas,scene){\r\n\t\tconst panel=new GraphicsStack(canvas,scene.glsl)\r\n\t\tif(panel.context){\r\n//\t\t\tpanel.fitCanvas();\r\n\t\t}\r\n// focus\r\n\t\tthis.panels.push(panel);\r\n\t\tif(!this.activePanel){\r\n\t\t\tthis.activePanel=panel;\r\n\t\t}\t\t\r\n\t\treturn panel;\r\n\t}\r\n}\r\n\r\n// build list of handles line segments styles\r\n\r\nconst StylePalette=[\r\n\t0,0,0,60,\r\n\t0,0,0,40\r\n]\r\n\r\nclass GLViewport{\r\n\tconstructor(x,y,w,h,m){\r\n\t\tthis.x=x;\r\n\t\tthis.y=y;\r\n\t\tthis.w=w;\r\n\t\tthis.h=h;\r\n\t\tthis.pixelRatio=m;\r\n\t}\r\n\r\n\tsetBounds(x,y,w,h){\r\n\t\tconst moved=(x!=this.x||y!=this.y);\r\n\t\tif(moved){\r\n\t\t\tthis.x=x;\r\n\t\t\tthis.y=y;\r\n\t\t}\r\n\t\tconst sized=(w!=this.w||h!=this.h);\r\n\t\tif(sized){\r\n\t\t\tthis.w=w;\r\n\t\t\tthis.h=h;\r\n\t\t}\r\n\t}\r\n\r\n\tset(gl,bounds,origin){\r\n\t\tconst _width=origin.width;\r\n\t\tconst height=origin.height;\r\n\t\tconst x=bounds.x-origin.x;\r\n\t\tconst y=bounds.y-origin.y;\r\n\t\tconst w=bounds.width;\r\n\t\tconst h=bounds.height;\r\n\t\tthis.setBounds(x,y,w,h);\r\n\t\tif(w>0&&h>0){\r\n\t\t\tconst m=this.pixelRatio;\r\n\t\t\tgl.viewport(m*x,m*(height-y),m*w,m*h);\r\n\t\t\tgl.scissor (m*x,m*(height-y),m*w,m*h);\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\treturn false;\r\n\t}\r\n}\r\n\r\nfunction _GridPositions(step,count,c){\r\n\tconst grid=[];\r\n\tfor(let i=-count;i<=count;i++){\r\n\t\tfor(let j=-count;j<=count;j++){\r\n\t\t\tgrid.push([i*step,j*step,0,c]);\r\n\t\t}\r\n\t}\r\n\treturn grid;\r\n}\r\n\r\n\r\nclass Scene{\r\n\tconstructor(){\r\n\t\tthis.glsl={\r\n\t\t\trayUniforms:[\"handles\",\"view\",\"palette\",\"style\"],\r\n\t\t\trayAttributes:[\"xyzc\"],\r\n\t\t\tflatUniforms:[\"handles\",\"view\",\"sun\",\"palette\",\"style\"],\r\n\t\t\tflatAttributes:[\"xyzc\",\"normal\",\"flatpos\",\"flatrot1\",\"flatrot2\",\"flatdim\"],\r\n\t\t\ttileUniforms:[\"handles\",\"view\",\"sun\",\"palette\",\"style\",\"basemap\",\"scratch\"],\t\r\n\t\t\ttileAttributes:[\"xyzc\",\"normal\"],\r\n\t\t\tstaticUniforms:[\"handles\",\"view\",\"sun\",\"palette\",\"style\",\"basemap\",\"wallmap\"],\t\t\t\r\n\t\t\tstaticAttributes:[\"xyzc\",\"normal\"],\r\n\t\t\tmodelUniforms:[\"handles\",\"view\",\"sun\",\"palette\",\"style\",\"diffuse\"],\r\n\t\t\tmodelAttributes:[\"xyzc\",\"normal\",\"coords\"],\r\n\t\t\tspriteUniforms:[\"view\"],\r\n\t\t\tspriteAttributes:[\"xyzc\"],//,\"normal\",\"coords\"],\r\n\t\t\tdisplayAspect:4.0/3.0\r\n\t\t}\r\n\t\tthis.shaders={};\r\n\t\tthis.requests=0;\r\n\t\tthis.gets=0;\r\n\t}\r\n\r\n\tloadScene(shaderNames,modelNames,handler){\r\n\t\tthis.handler=handler;\r\n\t\tfor(const name o