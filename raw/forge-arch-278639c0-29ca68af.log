=false;\r\n\t\t\t\tthis.pointerTrack=[];\r\n\t\t\t}break;\r\n\t\t\tcase \"mouseout\":{\r\n\t\t\t\tthis.mousedown=false;\r\n\t\t\t}break;\r\n\t\t\tcase \"mouseover\":\r\n\t\t\tcase \"mouseenter\":{\r\n\t\t\t\t\tthis.mousedown=buttons!=0;\r\n\t\t\t}break;\r\n\t\t}\r\n\t}\r\n// no longer deprecated\r\n\twheel(wheelevent) {\r\n\t\twheelevent.preventDefault();\r\n\t\tthis.jogZoom( wheelevent.deltaY/16);\r\n\t}\r\n\tcontextmenu(event) {\r\n\t\tevent.preventDefault();\r\n\t\treturn false;\r\n\t}\r\n\tflipRes(){\r\n\t\tthis.topores=(this.topores==1)?2:1;\r\n\t\tthis.clearTiles();\r\n\t}\r\n\r\n//\tthis.diagramAlphas=[0,0,0];\r\n\r\n\tsetAlpha(index,on){\r\n\t\tthis.diagramAlphas[index]=on?0.8:0;\r\n//\t\tthis.dirty=true;\r\n\t}\r\n/*\r\n\tflipOverlay(on){\r\n\t\tthis.setAlpha(2,on);\r\n\t}\r\n\r\n\tflipHeight(on){\r\n\t\tthis.setAlpha(1,on);\r\n\t}\r\n\r\n\tflipAerial(on){\r\n\t\tthis.setAlpha(0,on);\r\n\t}\r\n*/\r\n\tsetLevel(level){\r\n\t\tconst d=8*(level-this.layerlevel);\r\n\t\tif(d==0) return;\r\n\t\tconst m=(d>0)?1/d:-d;\r\n\t\tthis.layerx*=m;\r\n\t\tthis.layery*=m;\r\n\t\tthis.homex*=m;\r\n\t\tthis.homey*=m;\r\n\t\tthis.home();\r\n\t\tthis.modifyTileLayer(level);\r\n//\t\tthis.clearTiles();\r\n//\t\tthis.roaLevel=(this.roaLevel+1)%RoaLayers.length;\r\n//\t\tthis.buildTopo(RoaLayers[this.roaLevel]);\r\n\t}\r\n\r\n\tflipMode(){\r\n\t\tthis.setmode(1-this.mode);\r\n\t}\r\n\r\n\ttoggleTilt(){\r\n\t\tthis.tilt=MaxTilt-this.tilt;\r\n\t}\r\n\r\n\tjogTilt(delta){\r\n\t\tlet tilt=this.tilt+delta;\r\n\t\tif(tilt>7) tilt=7;\r\n\t\tif(tilt<0) tilt=0;\r\n\t\tthis.tilt=tilt;\r\n\t}\r\n\r\n\t// simon come here and fix clamp\r\n\r\n\tjogLevel(dir){\r\n\t\tlet zoom=this.zoom;\r\n\t\tvar level;\r\n\t\tif(dir>0){\r\n\t\t\tif(this.layerlevel<5){\r\n\t\t\t\tzoom/=8;\r\n\t\t\t\tthis.homex=(this.layerx/8.0)|0;\r\n\t\t\t\tthis.homey=(this.layery/8.0)|0;\r\n\t\t\t\tlevel=this.layerlevel+1;\r\n\t\t\t}else{\r\n\t\t\t\treturn;\r\n\t\t\t\tconst m=8*8*8;\r\n\t\t\t\tzoom*=m;\r\n\t\t\t\tthis.homex=this.layerx*m;\r\n\t\t\t\tthis.homey=this.layery*m;\r\n\t\t\t\tlevel=1;\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tif(this.layerlevel>1){\r\n//\t\t\t\tzoom*=8;\r\n\t\t\t\tthis.homex=this.layerx*8.0;\r\n\t\t\t\tthis.homey=this.layery*8.0;\r\n\t\t\t\tlevel=this.layerlevel-1;\r\n\t\t\t}else{\r\n\t\t\t\treturn;\r\n\t\t\t\tconst m=8*8*8;\r\n\t\t\t\tzoom/=m;\r\n\t\t\t\tthis.homex=this.layerx/m;\r\n\t\t\t\tthis.homey=this.layerm/m;\r\n\t\t\t\tlevel=5;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.home();\r\n\t\tthis.modifyTileLayer(level);\r\n\t\treturn zoom;\r\n\t}\r\n\r\n\tjogDolly(x,y){\r\n//\t\tthis.drag(x*20,-y*20);\r\n\t\tconst d=Math.sqrt(x*x+y*y);\r\n\t\tthis.accelerate(d*x*4,-d*y*4);\r\n\t}\r\n\r\n\tjogHeading(spin){\r\n\t\tthis.speed[3]+=spin;\r\n\t}\r\n\r\n\tjogZoom(deltaZoom){\r\n\t\tthis.speed[2]+=0.2*deltaZoom;\r\n\t}\r\n\r\n\taddZoom(deltaZoom){\r\n\t\tlet zoom=this.zoom + deltaZoom;\r\n\t\tif(zoom>MaxZoom) {\r\n\t\t\tzoom=MaxZoom;\r\n//\t\t\tzoom=this.jogLevel(zoom,1);\r\n\t\t}\r\n\t\tif(zoom<MinZoom) {\r\n\t\t\tzoom=MinZoom;\r\n//\t\t\tzoom=this.jogLevel(zoom,-1);\r\n\t\t}\r\n\t\tthis.zoom=zoom;\r\n\t\tthis.dirty=true;\r\n\t}\r\n\r\n\taccelerate(dx,dy){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tdy*=tiltscale;\r\n\t\tconst scale=0.24;//this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.speed[0]+=scale*(dx*cos-dy*sin);\r\n\t\tthis.speed[1]+=scale*(dx*sin+dy*cos);\r\n\t}\r\n\r\n\tdrag(dx,dy){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tdy*=tiltscale;\r\n\t\tconst scale=this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.layerx+=scale*(dx*cos-dy*sin);\r\n\t\tthis.layery+=scale*(dx*sin+dy*cos);\r\n\t}\r\n\r\n\tclick(){\r\n\t\tswitch(this.cursorType){\r\n\t\t\tcase 2:\r\n\t\t\t\tconsole.log(\"create 2\");\r\n\t\t\t\tbreak;\r\n\r\n\t\t}\r\n\t}\r\n\tfling(vx,vy,force){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tvy*=tiltscale;\r\n\t\tconst scale=0.5*this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.speed[0]+=force*scale*(vx*cos-vy*sin);\r\n\t\tthis.speed[1]+=force*scale*(vx*sin+vy*cos);\r\n\t}\r\n\r\n\trefreshGraphics(){\r\n\t\tif(this.graphics){\r\n\t\t\tconst scale=100/this.zoom;\r\n\r\n\t\t\tconst rot=this.heading*Math.PI/32768;\r\n\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\r\n\t\t\tconst vx=this.layerx-this.homex;\r\n\t\t\tconst vy=this.layery-this.homey;\r\n\r\n\t\t\tconst level=this.layerlevel;\r\n\r\n\t\t\t// simon come here and modifiy for level\r\n\r\n\t\t\tconst hshift=1<<(level*3);\r\n\t\t\tconst hfac=0.77/hshift;\r\n\r\n\t\t\tconst view0=this.viewPanel.view0;\r\n\t\t\tview0.isoView(vx,vy,scale,rot,this.tilt,this.altitude,hfac);\r\n\t\t\tview0.refreshView(w,h);\r\n\r\n\t\t\tthis.graphics.render();\r\n\t\t}\r\n\t}\r\n\r\n\tscreenPick(topo,sx,sy){\r\n\t\tconst scale=0.1*this.zoom;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\r\n\t\tconst sin=Math.sin(-rot);\r\n\t\tconst cos=Math.cos(-rot);\r\n\r\n\t\tconst w=this.canvas.width;\r\n\t\tconst h=this.canvas.height;\r\n\r\n\t\tconst x=(sx-w/2)*scale;\r\n\t\tconst y=(sy-h/2)*scale;\r\n\r\n\t\tconst rx=sin*y+cos*x;\r\n\t\tconst ry=cos*y-sin*x;\r\n\r\n\t\tconst mapx=this.layerx+rx;\r\n\t\tconst mapy=this.layery+ry;\r\n\r\n\t\tconst g=topo?topo.pick(mapx,mapy):0;\r\n\r\n\t\tconst ox=mapx-this.homex;\r\n\t\tconst oy=mapy-this.homey;\r\n\r\n\t\tconst oz=g;//0x1a0+g;\r\n\r\n\t\treturn [ox,oy,oz];\r\n\t}\r\n\r\n\trefreshCursor(){\r\n\t\tconst balls=this.cursorshape;\r\n\t\t// simon come here and fix level\r\n\t\tconst topo=this.topoTiles[1];\r\n\t\tif(balls){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tconst n=balls.count;\r\n\t\t\tconst posrot=balls.posrot32;\r\n\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\tconst xyz=this.screenPick(topo,w/2,h/2+(i-5)*10);\r\n\t\t\t\tposrot[i*8+0]=xyz[0];//Math.random()*20-10;\r\n\t\t\t\tposrot[i*8+1]=xyz[1];\r\n\t\t\t\tposrot[i*8+2]=xyz[2];\r\n\t\t\t\tposrot[i*8+3]=65536*0;\r\n\t\t\t\tposrot[i*8+4]+=16;\r\n\t\t\t\tposrot[i*8+5]+=32;\r\n\t\t\t\tposrot[i*8+6]+=48;\r\n//\t\t\t\tballs.position(i,xyz[0],xyz[1],xyz[2]);\r\n\t\t\t}\r\n\t\t\tballs.useShape();\r\n\t\t\tballs.writePosRot();\r\n\t\t}\r\n\t}\r\n\r\n\trefreshCursor2(){\r\n\t\tconst scale=100/this.zoom;\r\n\t\tconst ww=this.cursorWidth*scale/2;\r\n\t\tconst hh=this.cursorHeight*scale/2;\r\n\t\tconst context=this.context;\r\n\t\tif(context){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tcontext.fillStyle=CursorStyle;\r\n\t\t\tcontext.resetTransform();\r\n\t\t\tswitch(this.cursorType){\r\n\t\t\t\tcase 1:\r\n\t\t\t\t\tcontext.fillRect(w/2,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 2:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(w/2+ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tcontext.fillRect(0,h/2+hh,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 3:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tfor(let i=0;i<16;i++){\r\n\t\t\t\t\t\tcontext.fillRect(w/2+ww*i,0,1,h);\r\n\t\t\t\t\t\tcontext.fillRect(0,h/2+hh*i,w,1);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// decrements this.frameElapsed in 18ms counts\r\n\t// ticks gamepads and apply drag to speed\r\n\t// if detect idle from max speed then snapshot address\r\n\r\n\trefreshGrid(){\r\n\t\tlet dirtygrid=this.dirty;\r\n\t\tthis.dirty=false;\r\n\r\n\t\tconst drag=this.mousedown?0.5:0.94;\r\n\t\tconst drag2=0.88;\r\n//\t\tconst drag=this.mousedown?0.5:0.95;\r\n//\t\tdirtygrid=true;\r\n\r\n\t\tlet frames=(((this.frameElapsed/6)|0)*2)||1;\r\n\t\tthis.frameElapsed=0;\r\n\r\n\t\tframes=1;\r\n\r\n\t\twhile(frames--){\r\n\r\n\t\t\tthis.layerx+=this.speed[0];\r\n\t\t\tthis.layery+=this.speed[1];\r\n\r\n\t\t\tthis.addZoom(this.speed[2]);\r\n\t\t\tthis.heading+=this.speed[3];\r\n\r\n\t\t\tthis.tickGamepads();\r\n\r\n\t\t\tthis.speed[0]*=drag;\r\n\t\t\tthis.speed[1]*=drag;\r\n\t\t\tthis.speed[2]*=drag2;\r\n\t\t\tthis.speed[3]*=drag2;\r\n\r\n\t\t\tconst max=VectorLengthSquared(this.speed);\r\n\t\t\tif(max<0.1){\r\n\t\t\t\tif(!this.idle){\r\n\t\t\t\t\tthis.idle=true;\r\n\t\t\t\t\t// ON IDLE snapeshot location in history state\r\n\t\t\t\t\tconst app=AppEditor;\r\n\t\t\t\t\tconst location=app.getLocation();\r\n\t\t\t\t\tif(location){\r\n\t\t\t\t\t\tconst locationHash=\"#\"+JSON.stringify(location);\r\n\t\t\t\t\t\thistory.replaceState(null, null, locationHash);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tthis.idle=false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\thome(){\r\n\t\tthis.layerx=this.homex;\r\n\t\tthis.layery=this.homey;\r\n\t}\r\n\r\n\ttoggleFullscreen2(){\r\n\t\tif(this.fullscreen){\r\n\t\t\tdocument.webkitExitFullscreen();\r\n\t\t\tthis.fullscreen=false;\r\n\t\t}else{\r\n\t\t\tconst element=AppMedia;\r\n\t\t\telement.webkitEnterFullScreen();\r\n\t\t\tthis.fullscreen=true;\r\n\t\t}\r\n\t}\r\n\r\n\ttoggleFullscreen(){\r\n//\t\tvar element=this.body;\r\n\t\tconst element=document.body;\r\n\t\tif(document.exitFullscreen){\r\n\t\t\tif(this.fullscreen){\r\n\t\t\t\tdocument.exitFullscreen();\r\n\t\t\t\tthis.fullscreen=false;\r\n\t\t\t}else{\r\n\t\t\t\t// on promise...\r\n\t\t\t\telement.requestFullscreen();\r\n\t\t\t\tthis.fullscreen=true;\r\n\t\t\t}\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tif(element.webkitEnterFullScreen){\r\n\t\t\t\treturn toggleFullscreen2();\r\n\t\t\t}else{\r\n\t\t\t\twindow.notify(\"html fullscreen support not detected\");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\nfunction IgnoreContextMenu(pointerevent){\r\n\tpointerevent.preventDefault();\r\n\treturn false;\r\n}\r\n\r\nfunction SwitchAerial(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipAerial(on);\r\n}\r\nfunction SwitchHeight(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipHeight(on);\r\n}\r\nfunction SwitchOverlay(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipOverlay(on);\r\n}\r\nfunction SwitchRes(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipRes();\r\n}\r\n\r\n//function SetLevel(click,state){\r\n//\tAppEditor.flipLevel(state);\r\n//}\r\nfunction SwitchMode(click){\r\n\tAppEditor.flipMode()\r\n}\r\nfunction SwitchTilt(click){\r\n\tAppEditor.toggleTilt();\r\n}\r\n\r\nfunction LogStats(click){\r\n\tAppEditor.logStats();\r\n}\r\n\r\nfunction SwitchGPS(click){\r\n\tAppEditor.toggleGPS();\r\n}\r\n\r\nfunction _deviceOrientation(o){\r\n\tif(!epoch){\r\n\t\tepoch=o.timestamp;\r\n\t}\r\n\tconst p=[o.absolute,o.alpha,o.beta,o.gamma];\r\n\tconst orientation={\r\n\t\to:p,\r\n\t\tts:o.timestamp-epoch\r\n\t}\r\n\tconst json=JSON.stringify(orientation);\r\n\tSetStatus(json);\r\n}\r\nlet JyroListener;\r\nfunction SwitchJyro(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tif(on){\r\n\t\tJyroListener=window.addEventListener(\"deviceorientation\",_deviceOrientation);\r\n\t}else{\r\n\t\twindow.removeEventListener(\"deviceorientation\",JyroListener);\r\n\t\tJyroListener=null;\r\n\t\tSetStatus(\"\");\r\n\t}\r\n}\r\n\r\nlet _PixelLoader=null;\r\nlet _MeshLoader=null;\r\n\r\nfunction loadWire(){\r\n\tfetchTiles();\r\n\tfetchGrid();\r\n}\r\n\r\nfunction fetchTiles(){\r\n\tconst url=\"json/tiles.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_tiles=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.onTiles(_tiles);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchTiles fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\nfunction fetchGrid(){\r\n\tconst url=\"json/grid.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_grid=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.loadGrid(_grid);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchGrid fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\n// !!! replaced with loadWire\r\nfunction launchWire(){\r\n//\teditor.buildTopo(_nz3);\r\n//\teditor.buildTopo(_w1);\r\n//\teditor.buildTopo(_ak1);\r\n//\teditor.home();\r\n//\tvideo.addEventListener(\"pause\",editor.pause.bind(editor));\r\n//\teditor.animate();\r\n}\r\n\r\n// body,[screen]\r\n\r\nfunction goWireLocation(gpn6){\r\n\tAppEditor.setLocation(gpn6);\r\n}\r\n\r\n// 2025-10-2 - video is now null and we need fullscreen\r\n\r\nfunction initWireGrid(body){\r\n//\tdocument.title=\"nitrologic wire grid\";\r\n\tAppPlatform=new DesktopPlatform();\r\n//\tAppPlatform=new MobilePlatform();\r\n//\tAppPlatform=new EmbeddedPlatform();\r\n\tconst agent = navigator.userAgentData||UnidentifiedAgent;\r\n\tconsole.log(\"wire agent : \" + JSON.stringify(agent));\r\n\r\n\tconst license=AK17_License.join(\"\\n\");\r\n\tconst title=\"[]\";\r\n\tbody.setAttribute(\"title\",title);\r\n\r\n\tconst screen=document.createElement(\"div\");\r\n\tscreen.className=\"wiregrid\";\t//was screen\r\n\r\n//\teditor.toggleFullscreen();\r\n\r\n\tbody.appendChild(screen);\r\n\r\n\tconst video=null;\r\n\t_PixelLoader=new PixelLoader();\r\n\t_MeshLoader=new MeshLoader();\r\n\r\n\t// todo: wire mode 0 not supported\r\n\tconst editor=new TopoEditor(screen,video,1);\r\n\r\n\tAppScreen=screen;\r\n\tAppEditor=editor;\r\n\r\n\tconst root=[];\r\n\r\n\tconst hit_grid=editor.hitKey.bind(editor);\r\n\tconst panel=new Panel(screen,hit_grid,root);\r\n\r\n\tAppPanel=panel;\r\n\r\n\teditor.animate();\r\n\tloadWire();\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker_baker.js\",\"length\":13064,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_baker.js\r\n\r\n// one per TopoTile\r\n\r\n// a worker thread for processing heightmaps for a topo tile\r\n\r\nconst FloraPen=20;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\nconst TopoNoLevel=-0x4000;\r\n\r\n//const _unicode = new TextEncoder();\r\n\r\nlet topoCount;\r\nlet digReady=false;\r\nlet digDepth=4;\r\nlet digBorder=40;\r\nconst heightmaps=[];\r\nconst roofOutlines=[];\r\n\r\nfunction refresh(){\r\n\tif(topoCount==heightmaps.length && digReady){\r\n\t\tcreateTopo();\r\n\t}\r\n}\r\n\r\n//let outgoingBaker=[];\r\n//let connectedBaker=false;\r\n\r\nonmessage = (message) => {\r\n\tconst commands=message.data;\r\n\tfor(const line of commands){\r\n//\t\tconsole.log(\"wire_baker \",line);\r\n\t\tswitch(line.command){\r\n\t\t\tcase \"heightmap\":\r\n\t\t\t\tonHeightmap(line.array);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"bake\":\r\n\t\t\t\tonTopoCount(line.value);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"dig\":\r\n\t\t\t\tonDig(line.outlines,line.depth,line.border);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"build\":\r\n\t\t\t\tonBuild(line.value);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n//\tconsole.log(\"wire_baker woke\",data.name);\r\n//\toutgoing.push(data);\r\n}\r\n\r\nfunction refresh(){\r\n\tif(topoCount==heightmaps.length){\r\n//\t\tdebugger;\r\n\t\tcreateTopo();\r\n\t}\r\n}\r\n\r\nfunction onHeightmap(rawbytes){\r\n\tif(rawbytes.length==0){\r\n//\t\treturn;\r\n\t}\r\n\theightmaps.push(rawbytes);\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildTopo(plan){\r\n\r\n}\r\n\r\nfunction onDig(outlines,depth,border){\r\n\tfor(const outline of outlines){\r\n\t\troofOutlines.push(outline);\r\n\t}\r\n\tdigDepth=depth;\r\n\tdigBorder=border;\r\n\tdigReady=true;\r\n\trefresh();\r\n}\r\n\r\n// onBake handler\r\nfunction onTopoCount(count){\r\n\ttopoCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildCount(count){\r\n\tbuildCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\nfunction createTopo(){\r\n\tconst bytes=heightmaps[0]||[];\r\n\tconst heightmap=AllocBumpmap(bytes);\r\n\theightmap.setBytes(bytes);\r\n\tconst n=heightmaps.length;\r\n\tfor(let i=1;i<n;i++){\r\n\t\tif(heightmaps[i].length==bytes.length){\r\n\t\t\theightmap.orBytes(heightmaps[i]);\r\n\t\t}\r\n\t}\r\n\theightmaps.length=0;\r\n\r\n\tfor(const outline of roofOutlines){\r\n\t\tdigOutline(heightmap,outline,digDepth,digBorder);\r\n\t}\r\n\troofOutlines.length=0;\r\n\r\n\theightmap.postFlora(512,4,15,2);\r\n\theightmap.post();\r\n}\r\n\r\nfunction createTopoOld(){\r\n\tconst bytes=heightmaps[0]||[];\r\n\tconst heightmap=AllocBumpmap(bytes);\r\n\theightmap.setBytes(bytes);\r\n\tconst n=heightmaps.length;\r\n\tfor(let i=1;i<n;i++){\r\n\t\tif(heightmaps[i].length==bytes.length){\r\n\t\t\theightmap.orBytes(heightmaps[i]);\r\n\t\t}\r\n\t\telse{\r\n//\t\t\theightmap.setBytes(heightmaps[i]);\r\n\t\t}\r\n\t}\r\n\r\n// simon come here and fix up flora\r\n//\theightmap.heal(n);\r\n\r\n//\theightmap.postFlora(1024,2,15,2);\r\n//\theightmap.postFlora(512,4,15,2);\r\n\theightmap.postFlora(256,8,FloraPen,22);\r\n//\theightmap.postFlora(128,16,0,22);\r\n\r\n\theightmap.post();\r\n\r\n\theightmaps.length=0;\r\n}\r\n\r\nclass Bumpmap{\r\n\tpost(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst diff=this.diff;\r\n\t\tconst ground=this.ground;\r\n\t\tconst message=[{command:\"bump\",topo,diff,ground}];\r\n\t\tconst transfer=[topo.buffer,diff.buffer,ground.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n// a worker method that replies with a \"flora\" message containing a surface for flora placement\r\n\r\n\tpostFlora(count,mag,c,floraMin){\r\n\t\tconst p=2048/count;\r\n\t\tconst res=count+1;\r\n\t\tconst a=new Array(res);\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\ta[y]=new Array(res);\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tlet h0=this.pickElevation(x*p,y*p);\r\n\t//\t\t\tlet h1=topo.pickHeight(x*p,y*p);\r\n\t\t\t\tconst m=this.pickHeightMinMax(x*p,y*p);\r\n\t\t\t\tif(m.min>floraMin){\r\n\t\t\t\t\tconst h1=m.max;\r\n\t\t\t\t\ta[y][x]=h0+h1;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst vverts=[];\r\n\t\tconst v=[];\r\n\t\tconst i=[];\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tconst mz=a[y][x];\r\n\t\t\t\tlet vert=-1;\r\n\t\t\t\tif(mz){\r\n\t\t\t\t\tconst mx=mag*x;\r\n\t\t\t\t\tconst my=-mag*y;\r\n\t\t\t\t\tvert=v.length;\r\n\t\t\t\t\tv.push([mx,my,mz,c, 0,0,0,0]);\r\n\t\t\t\t}\r\n\t\t\t\tvverts.push(vert);\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst d=count+1;\r\n\t\tfor(let y=0;y<count;y++){\r\n\t\t\tfor(let x=0;x<count;x++){\r\n\t\t\t\tconst v0=vverts[y*res+x];\r\n\t\t\t\tconst v1=vverts[y*res+x+1];\r\n\t\t\t\tconst v2=vverts[(y+1)*res+x+1];\r\n\t\t\t\tconst v3=vverts[(y+1)*res+x];\r\n\t\t\t\tif(v0>-1&&v1>-1&&v2>-1&&v3>-1){\r\n\t\t\t\t\ti.push([v0,v2,v1]);\r\n\t\t\t\t\ti.push([v0,v3,v2]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst verts=new Int32Array(v.flat());\r\n\t\tconst indices=new Int32Array(i.flat());\r\n\t\tconst message=[{command:\"flora\",verts,indices}];\r\n\t\tconst transfer=[verts.buffer,indices.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n\treset(res){\r\n\t\tthis.resolution=res;\t\t\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}else{\r\n\t\t\t\t\ttopo[i]=TopoNoLevel;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(srccount){\r\n\t\tlet count=0;\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tconst i=y*res+x;\r\n\t\t\t\tlet h=topo[i];\r\n\t\t\t\tif(h==0){\r\n\r\n//\t\t\t\t\ttopo[i]=SeaLevel-TopoLevel;\r\n\t\t\t\t\t// simon come here\r\n/*\r\n\t\t\t\t\tif(x>0&&topo[i-1]) h=topo[i-1];\r\n\t\t\t\t\tif(y>0&&topo[i-res]) h=topo[i-res];\r\n\t\t\t\t\tif(x<res-1&&topo[i+1]) h=topo[i+1];\r\n\t\t\t\t\tif(y<res-1&&topo[i+res]) h=topo[i+res];\r\n\t\t\t\t\ttopo[i]=h;\r\n*/\t\t\t\t\t\r\n\t\t\t\t\tcount++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(count){\r\n//\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\tprocess(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0) h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\n\r\n\r\n/*\r\n\r\nfunction heartbeat(){\r\n\tconst messages=outgoing;\r\n\toutgoing=[];\r\n\tif(connected){\r\n\t\tpost(\"tick\",messages);\r\n\t}\r\n}\r\n\r\nlet timer=setInterval(heartbeat,500);\r\n\r\nfunction post(name,body){\r\n\tevent={name:name,body:body};\r\n\tconst js=JSON.stringify(event);\r\n\tconst bytes=_unicode.encode(js);\r\n\tconst t0=new Date();\r\n\tfetch(\"/fetch\",{\r\n\t\tmethod:'POST',\r\n\t\theaders: {\r\n\t\t\t'Content-Type': 'application/json',\r\n\t\t\t'Content-Length': bytes.length\r\n\t\t},\r\n\t\tbody: bytes\r\n\t})\r\n\t.then(response => response.json())\r\n\t.then(data => {\r\n//\t\tconsole.log(data);\r\n\t\tconst t1=new Date();\r\n\t\tconst d=t1-t0;\r\n\t\tpostMessage({ping:d});\r\n\t});\t\t\r\n}\r\n\r\n*/\r\n\r\n\r\n// 0x4000 is new zero, count is typically 128, short index friendly\r\n\r\n// in which verticy sample is too steep skip edge\r\n\r\nfunction CreateTopoSurface(count,m,c,topo){\r\n\tconst a=new Array(count+1);\r\n\tconst p=2048/count;\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(count+1);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h=topo.pickTopo(x*p,y*p);\r\n\t\t\ta[y][x]=h;\r\n\t\t}\r\n\t}\r\n\t\r\n\tlet v=[];\r\n\tconst i=[];\r\n\r\n\tconst crack=[];\r\n\tconst max=[];\r\n\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mx=m*x;\r\n\t\t\tconst my=-m*y;\r\n\t\t\tconst ground=a[y][x].ground;\r\n\t\t\tconst minz=a[y][x].min;\r\n\t\t\tconst maxz=a[y][x].max;\r\n\t\t\tlet bits=0;\r\n\t\t\tif(ground==0 && maxz-minz>12){\r\n\t\t\t\tmax.push(crack.length);\r\n\t\t\t\tbits=1;\r\n\t\t\t\tcrack.push([mx,my,maxz,c, 0,0,0,bits]);\r\n\t\t\t}else{\r\n\t\t\t\tmax.push(-1);\r\n\t\t\t}\r\n\t\t\tconst z=ground||minz;\r\n\t\t\tv.push([mx,my,z,c, 0,0,0,bits]);\r\n\t\t}\r\n\t}\r\n\tconst crackOffset=v.length;\r\n\tv=v.concat(crack);\r\n\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=x+y*d;\r\n\t\t\tconst v1=x+1+y*d;\r\n\t\t\tconst v2=x+(y+1)*d;\r\n\t\t\tconst v3=x+1+(y+1)*d;\r\n\t\t\t\r\n\t\t\tconst b0=v[v0][7];\r\n\t\t\tconst b1=v[v1][7];\r\n\t\t\tconst b2=v[v2][7];\r\n\t\t\tconst b3=v[v3][7];\r\n\r\n\t\t\tif(!(b0|b1|b2|b3)){\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t\ti.push(v1);\r\n\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v2);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t}else{\r\n\t\t\t\tconst m0=max[v0]>=0?crackOffset+max[v0]:v0;\r\n\t\t\t\tconst m1=max[v1]>=0?crackOffset+max[v1]:v1;\r\n\t\t\t\tconst m2=max[v2]>=0?crackOffset+max[v2]:v2;\r\n\t\t\t\tconst m3=max[v3]>=0?crackOffset+max[v3]:v3;\r\n\r\n\t\t\t\tif(b0||b3||b1){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\t\t\t\tif(b0||b2||b3){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b1||b0){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b3||b1){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n","name":"content"},{"role":"user","content":"draw order of tiles is current issue\r\nFiles shared. Feel free to comment if content is new or different.","name":"friend"},{"role":"assistant","content":"Looking at the path, the order isn't chosen anywhere — it falls out of *when* a tile finishes loading.\n\n## How the order is actually determined\n\n`refreshTiles` hands tiles to `populateHome` in scan order:\n\n```js\nfor(let a=-r;a<=r;a++){\n\tfor(let b=-r;b<=r;b++){\n\t\tif(a*a+b*b<=r*r){\n\t\t\tconst tile=this.tileGet(tx+a,ty+b);\n\t\t\tif(tile.fetched){\n\t\t\t\tif(tile.ready){\n\t\t\t\t\tvisible.push(tile);\n```\n\nBut `visible` only contains tiles that are `fetched && ready`, and tiles become ready asynchronously. A tile is meshed on the first frame it appears there, and `meshTile` appends its shapes to the layer:\n\n```js\ntile.staticmeesh=layer0.addStaticShapes(surfaces,...);\ntile.tilemesh=layer0.addTileShape(topo,...);\n```\n\n`drawLayerList` then walks `layer.shapes` in that array order, so **draw order == mesh order == order of load completion**.\n\nAnd load order is nearest-first, because the fetch priority is a distance:\n\n```js\ntile.priority=1-(a*a+b*b);\nthis.fetchTile(tile);\n```\n\n`compareTiles` sorts ascending, `fetchTile` pops from the end, so the closest tile is fetched and meshed first. The tile layer is therefore drawn **front-to-back**.\n\n## Why that's visible\n\nFor an opaque, depth-tested scene, front-to-back is fine — it's even the fast path. It only bites where geometry is blended or coincident:\n\n- Terrain alpha is `O=0.94`, and `WebGL2Context.clear` enables `BLEND` globally with depth writes on. So each tile is 94% opaque and blended. Where adjacent tiles overlap at the seam, the second tile blends over the first, and how much darkening you see depends on which was drawn first. Front-to-back makes it worse, and it changes as tiles stream in.\n- Flora is genuinely transparent (`A=0.52`), so it needs strict back-to-front. Front-to-back guarantees the wrong blend.\n- Coincident surfaces (walls/coast on terrain) resolve by draw order because the depth func is `LESS`, not `LEQUAL`.\n\n## Two ways out\n\n**Make the opaque layers order-independent.** If the terrain is meant to be solid, alpha should be `1.0` — the `0.94` is what forces blending and thus order sensitivity. That plus depth test removes terrain from the problem entirely.\n\n**Sort the blended layer back-to-front each frame.** `populateHome` sorting at mesh time won't hold, because a far tile that loads later still appends after the near ones. The sort has to happen in the draw path, not the mesh path. Give each shape a depth key when it's created and order `layer.shapes` in `compileLayers`:\n\n```js\ncompileLayers(layers){\n\tthis.layers=layers;\n\tthis.drawlist=this.drawLayerList(layers);\n}\n```\n\n`sortedShapes(layer)` there, sorting `shape.depth` descending, with `shape.depth` set from the tile's position relative to `heading` in `addTileShape`.\n\n## One thing to confirm first\n\nWhich symptom are you seeing?\n\n- **Seams / dark lines between tiles** → the `0.94` alpha, fix by making terrain opaque.\n- **A far tile painting over a near one** → depth isn't doing its job (winding/culling, or depth not written), not order.\n- **Flora popping or blending wrong as you pan** → the front-to-back mesh order, fix by sorting in the draw path.\n\nThe fix differs per case, so tell me which one and I'll write it against `wire_graphics.js` — I don't have that file in this batch."},{"role":"system","content":"models under test include kimi-k2.7-code"},{"role":"user","content":"hi kimi, can you review history of our chat and summarise","name":"friend"}],"tools":[{"type":"function","function":{"name":"read_time","description":"Returns current local time","parameters":{"type":"object","properties":{},"required":[]}}},{"type":"function","function":{"name":"submit_file","description":"Submit a file for review","parameters":{"type":"object","properties":{"contentType":{"type":"string"},"content":{"type":"string"}},"required":["contentType","content"]}}},{"type":"function","function":{"name":"fetch_file","description":"Request a file for analysis","parameters":{"type":"object","properties":{"fileName":{"type":"string"}},"required":["fileName"]}}},{"type":"function","function":{"name":"tag_slop","description":"Attach description to code tag and share Fountain objects","parameters":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string","description":"forge category","enum":["code","session","share","lode"]},"description":{"type":"string"}},"required":["name","type","description"]}}}]}
