278685c4 [gemini-3.8-flash] #
278685c4 [gemini-3.8-flash] #1. Build Dependencies
278685c4 [gemini-3.8-flash] #`bmdtools` uses FFmpeg’s internal libraries to mux the captured video into a stream format. Ensure
278685c4 [gemini-3.8-flash] #you have the standard build utilities and `pkg-config` available:
278685c4 [gemini-3.8-flash] #
278685c4 [gemini-3.8-flash] #
