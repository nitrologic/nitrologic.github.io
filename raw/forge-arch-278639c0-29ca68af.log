29860686 [deepseek-flash] #const heightmaps=[];
29860686 [deepseek-flash] #const roofOutlines=[];
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #function refresh(){
29860686 [deepseek-flash] #	if(topoCount==heightmaps.length && digReady){
29860686 [deepseek-flash] #		createTopo();
29860686 [deepseek-flash] #	}
29860686 [deepseek-flash] #}
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #
29860686 [deepseek-flash] #case "dig":
29860686 [deepseek-flash] #	onDig(line.outlines,line.depth,line.border);
29860686 [deepseek-flash] #	break;
29860686 [deepseek-flash] #
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #function onDig(outlines,depth,border){
29860687 [deepseek-flash] #	for(const outline of outlines){
29860687 [deepseek-flash] #		roofOutlines.push(outline);
29860687 [deepseek-flash] #	}
29860687 [deepseek-flash] #	digDepth=depth;
