itions});\r\n\t\tif(this.viewPanel && this.gui){\r\n\t\t\tthis.gui.addScaleModel(model,positions);\r\n\t\t}\r\n\t}\r\n\r\n\tsnapshotCar(){\r\n\t\tconst snap={\r\n\t\t\tbox:{width:this.cursorWidth,height:this.cursorHeight},\r\n\t\t\tlocation:this.getLocation()\r\n\t\t};\r\n\t\treturn snap;\r\n\t}\r\n\r\n\tsnapshotCanvas(){\r\n\t\tconst can=this.canvas;\r\n\t\tconst w=can.width;\r\n\t\tconst h=can.height;\r\n\t\tconst canvas=document.createElement(\"CANVAS\");\r\n\t\tcanvas.width=w/2;\r\n\t\tcanvas.height=h/2;\r\n\t\tconst context=canvas.getContext(\"2d\");\r\n\t\tcontext.drawImage(this.canvas,0,0,w,h,0,0,w/2,h/2);\r\n\t\treturn{\r\n\t\t\timage:canvas,\r\n\t\t\tlocation:this.location()\r\n\t\t};\r\n\t}\r\n\r\n\t// used by snapshot and animate hash\r\n\tgetLocation(){\r\n\t\tif(!this.layerlevel)\r\n\t\t\treturn undefined;\r\n\t\tconst x=this.layerx|0;\r\n\t\tconst y=this.layery|0;\r\n\t\tconst level=this.layerlevel;\r\n\t\tconst zoom=this.zoom|0;\r\n\t\tconst head=this.heading|0;\r\n\t\tconst tilt=this.tilt|0;\r\n\t\tconst p=[x,y,level,zoom,head,tilt];\r\n\t\treturn p;\r\n\t}\r\n\r\n\tsetLocation(p){\r\n\t\tthis.homex=p[0];\r\n\t\tthis.homey=p[1];\r\n// simon come here and infer home()\r\n\t//\tthis.layerx=0;//p[0];\r\n\t//\tthis.layery=0;//p[1];\r\n\t\tthis.layerlevel=p[2];\r\n\t\tthis.zoom=p[3];\r\n\t\tthis.heading=p[4];\r\n\t\tthis.tilt=p[5];\r\n\t\tconsole.log(\"[WIREGRID] setLocation\",p)\r\n\t}\r\n\r\n\taddEventHandlers(events,bind){\r\n\t\tfor(const eventname of events){\r\n\t\t\tvar options = {passive: true};\r\n\t\t\tthis.canvas.addEventListener(eventname,bind,options);\r\n\t\t\tif(this.video) this.video.addEventListener(eventname,bind,options);\r\n\t\t}\r\n\t}\r\n\r\n\tbindEvents(){\r\n\t\tthis.addEventHandlers(MouseEvents,this.mouse.bind(this));\r\n\t\tthis.addEventHandlers(TouchEvents,this.touch.bind(this));\r\n\t\tthis.addEventHandlers(KeyEvents,this.key.bind(this));\r\n\t}\r\n\r\n\t// create a new canvas\r\n\r\n\tsetmode(mode){\r\n\t\tthis.mode=mode;\r\n\t\tif(this.canvas) this.canvas.remove();\r\n\t\tif(this.context) this.context=null;\r\n\t\tif(this.scene) this.scene=null;\r\n\t\tif(this.viewPanel) this.closeScene();\r\n\t\tthis.canvas=document.createElement(\"canvas\");\r\n\t\tthis.canvas.setAttribute(\"tabindex\",1);\r\n\t\tthis.canvas.setAttribute(\"tile\",\"\");\r\n\t\tthis.bindEvents();\r\n\t\tthis.canvas.addEventListener(\"wheel\",this.wheel.bind(this));\r\n\t\tthis.canvas.addEventListener(\"contextmenu\",this.contextmenu.bind(this));\r\n\t\tthis.resize();\r\n\t\tthis.body.appendChild(this.canvas);\r\n// todo: flag an autofocus\t\t\r\n//\t\tthis.canvas.focus();\r\n\t\tswitch (mode){\r\n\t\t\tcase 0:\r\n\t\t\t\tthis.context=this.canvas.getContext(\"2d\");\r\n\t\t\t\tthis.context.lineCap='round';\r\n\t\t\t\tbreak;\r\n\t\t\tcase 1:\r\n\t\t\t\tthis.scene=new Scene();\r\n\t\t\t\tconst callback=this.sceneLoaded.bind(this);\r\n\t\t\t\tthis.scene.loadScene(SceneShaders,SceneModels,callback);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\tsceneLoaded(){\r\n\t\tthis.graphics=new GraphicsDisplay();\r\n\t\tthis.viewPanel=this.graphics.addPanelLayers(this.canvas,this.scene);\r\n\t\tthis.graphics.compilePanels();\r\n\t\tthis.viewPanel.populateScene();\r\n\t\tthis.addCursor();\r\n\t}\r\n\r\n\trefreshGui(){\r\n\t\tconst can=this.canvas;\r\n\t\tconst width=can.width;\r\n\t\tconst height=can.height;\r\n\t\tthis.gui.refreshView(width,height);\r\n\t}\r\n\r\n\taddCursor(){\r\n//\t\treturn;\r\n\r\n\t\t// bad bad\r\n\t\tconst origin=[0,0,-8192];\r\n\r\n//\t\tconst surf=draw.icosahedron(150,7,2);\r\n//\t\tconst surf=Sphere(500,3,2);\r\n//\t\tconst surf=Torus(24,260,32,12,6);\r\n\t\tconst n=4;\r\n\t\tconst surf=FlatCube(150,150,50,5);\r\n\t\tconst balls=this.viewPanel.view0.layer.addFlatShape(surf,origin,n);\r\n\t\tthis.cursorshape=balls;\r\n\r\n\t\tconst z=0.1;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tballs.scaleInstance(i,z,z,z);\r\n\t\t\tballs.positionInstance(i,i*400,0,i*40);\r\n\t\t}\r\n\r\n\t\tballs.writePosRotDim();\r\n\t\tballs.glCheck();\r\n\t}\r\n\r\n\taddCursor2(){\r\n\t\tconst origin=[0,0,0];\r\n\t\t//\t\tconst draw=new Draw();\r\n\r\n\t\t// roapalette\r\n\t\t// 6 yellow\r\n\t\t// 7 lipstick\r\n\t\t// 8 soot\r\n\t\t// 9 royal blue\r\n\t\t// 10 g\r\n\t\t// 11 b\r\n\t\t// 12 r\r\n\t\t// 13 purp\r\n\t\t// 14 rust\r\n\t\t// 15 gray\r\n\r\n//\t\tconst surf=draw.icosahedron(150,7,2);\r\n\r\n//\t\tconst surf=Icosahedron(5,7,2);\r\n\t\tconst surf=Torus(24,260,32,12,6);\r\n//\t\tconst surf=Cube(5,6);\r\n\r\n\t\tconst balls=this.viewPanel.view0.addFlatShape(surf,origin,1);\r\n\t\tthis.cursorshape=balls;\r\n\t\tballs.position(0,0,0,0);\r\n\t}\r\n\r\n\tcloseScene(){\r\n/*\r\n\t\tfor(const tile of this._tileSet){\r\n\t\t\ttile.flushMesh();\r\n\t\t}\r\n*/\r\n\t\tFlushTextureBin(this.viewPanel.glcontext.gl);\r\n\r\n\t\tthis.viewPanel.flush();\r\n\t\tthis.viewPanel=null;\r\n\r\n\t\tthis.graphics.flush();\r\n\t\tthis.graphics=null;\r\n\t}\r\n\r\n\tanimate(){\r\n\r\n\t\tconst location=this.getLocation();\r\n\r\n\t\tthis.checkCanvasSize();\r\n\t\tconst frame=this.frameCount++;\r\n\r\n\t\tconst t=Date.now();\r\n\t\tconst elapsed=t-this.frameTime;\r\n\r\n\t\tthis.frameTime+=elapsed;\r\n\t\tthis.frameElapsed+=elapsed;\r\n\r\n\t\tconst events=FetchEvents();\r\n\t\tfor(let e of events){\r\n// log joypad\r\n//\t\t\tconsole.log(JSON.stringify(e));\r\n\t\t\tswitch(e.event){\r\n\t\t\t\tcase \"controller\":{\r\n\t\t\t\t\tthis.onController(e.mods);\r\n\t\t\t\t}break;\r\n\t\t\t\tcase\"createcar\":{\r\n\t\t\t\t}break;\r\n\t\t\t\tcase\"loadmodel\":{\r\n\t\t\t\t\tconst model=_MeshLoader.gltfModel[e.url];\r\n//\t\t\t\t\tconst xyz=[0,0,1275];\r\n//\t\t\t\t\tconst xyz=[0,0,275];\r\n\t\t\t\t\tconst xyzr=[0,0,0,65536];\r\n\t\t\t\t\tthis.instanceModels(model,[xyzr]);\r\n\t\t\t\t}break;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif(this.idle){\r\n\t\t\tconst t=frame/50;\r\n\t\t\tthis.heading+=.2*Math.sin(t);\r\n\t\t}\r\n\r\n\t\tif(this.topoTiles){\r\n\r\n\t\t\tfor(let layer in this.topoTiles){\r\n\t\t\t\tconst tilegrid=this.topoTiles[layer];\r\n\t\t\t\ttilegrid.update(); // empty fetchlists\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t\tif(this.viewPanel && this.viewPanel.glcontext){\r\n\r\n//\t\t\tthis.refreshGui();\r\n\r\n\t\t\tlet ready=true;\r\n\r\n\t\t\tif(!this.topoTiles){\r\n\t\t\t\tif(this.tilesource && this.tilesource.loaded()){\r\n\t\t\t\t\tthis.setDefaultHome();\r\n\t\t\t\t}else{\r\n\t\t\t\t\tready=false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tif(ready){\r\n//\t\t\t\tthis.refreshCursor();\r\n\r\n\t\t\t\tFlushTextureBin(this.viewPanel.glcontext.gl);\r\n//\t\t\t\tthis.viewPanel.scene.updateGLTF();\r\n\t\t\t\tthis.refreshGrid();\r\n\t\t\t\tif(this.topoTiles){\r\n\t\t\t\t\tconst level=this.layerlevel;\r\n\t\t\t\t\tconst tiles=this.topoTiles[level];\r\n\t\t\t\t\tif(tiles){\r\n\t\t\t\t\t\tconst cx=this.layerx;\r\n\t\t\t\t\t\tconst cy=this.layery;\r\n\r\n\t\t\t\t\t\ttiles.touchTiles(cx,cy,5);\r\n\r\n\t\t\t\t\t\t// simon come here and connect radius to 3\r\n\r\n\t\t\t\t\t\tconst visibleTiles=tiles.refreshTiles(cx,cy,5);\r\n\r\n//\t\t\t\t\t\tconst active=this.viewPanel._activeTiles;\r\n//\t\t\t\t\t\tconst distantTiles=tiles.distantTiles(active,cx,cy,5);\r\n//\t\t\t\t\t\tthis.viewPanel.retireTiles(distantTiles);\r\n\r\n\t\t\t\t\t\tthis.viewPanel.populateHome(visibleTiles,[this.homex,this.homey]);\r\n\r\n\t\t\t\t\t\tconst remove=tiles.sweep();\r\n\t\t\t\t\t\tfor(const tile of remove){\r\n\t\t\t\t\t\t\tthis.viewPanel.flushTile(tile);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tthis.graphics.compilePanels();\r\n\t\t\t}\r\n\t\t\tthis.refreshGraphics();\r\n\t\t}\r\n\t\tself.window.requestAnimationFrame(this.animate.bind(this))\r\n\t}\r\n\r\n\tonError(e){\r\n//\t\tconst txt=JSON.stringify(e);\r\n\t\twindow.alert(e.message);\r\n\t}\r\n\r\n\tresize(){\r\n\t\tconst r=window.devicePixelRatio;\r\n\t\tconst w=window.innerWidth;\r\n\t\tconst h=window.innerHeight;\r\n\t\tconst width=(w*r)&-2;\r\n\t\tconst height=(h*r)&-2;\r\n\t\tthis.aspect=w/h;\r\n\t\tthis.pixelSize=r;\r\n\t\tconst can=this.canvas;\r\n\t\tif(can){\r\n\t\t\tcan.style.width=w+\"px\";\r\n\t\t\tcan.style.height=h+\"px\";\r\n\t\t\tcan.width=width;\r\n\t\t\tcan.height=height;\r\n\t\t}\r\n\t\tthis.dirty=true;\r\n\t\tthis.mousedown=false;\r\n\t\tSetStatus(\"res:\"+width+\"x\"+height+\" pixel:\"+r);\r\n\t}\r\n\r\n\tcheckCanvasSize(){\r\n\t\tconst r=window.devicePixelRatio||1;\r\n\t\tconst w=(window.innerWidth*r)&-2;\r\n\t\tconst h=(window.innerHeight*r)&-2;\r\n\t\tif(this.canvas.width!=w||this.canvas.height!=h){\r\n\t\t\tthis.resize();\r\n\t\t}\r\n\t}\r\n\r\n\tkey(keyevent){\r\n\t\tconst type=keyevent.type;\r\n\t\tconst keycode=keyevent.keyCode;\r\n\t\tconst ts=keyevent.timeStamp;\r\n\t\tif(BrowserKeyMaskList.includes(keycode)) return;\r\n\t\tconsole.log(type+keycode);\r\n\t\tswitch(type){\r\n\t\t\tcase \"keypress\":{\r\n\t\t\t\tif(!this.hitKey(keycode)) return;\r\n\t\t\t}break;\r\n\t\t\tcase \"keydown\":{\r\n\t\t\t\tAppEventServer.addEvent(\"keydown\",{code:keycode,time:ts})\r\n\t\t\t}break;\r\n\t\t\tcase \"keyup\":{\r\n\t\t\t\tAppEventServer.addEvent(\"keyup\",{code:keycode,time:ts})\r\n\t\t\t}\r\n\t\t}\r\n// passive says no preventDefault\r\n//\t\tkeyevent.preventDefault();\r\n\t}\r\n\r\n\tonController(mods){\r\n\t\tfor(const mod of mods){\r\n\t\t\tconst gamer=mod[0];\r\n\t\t\tif(gamer==0){\r\n\t\t\t\tswitch (mod[1]){\r\n\t\t\t\t\tcase 0:{\r\n\t\t\t\t\t\tconst b=mod[2]\r\n\t\t\t\t\t\tlet w=mod[3];\r\n\t\t\t\t\t\tthis.gameButtons[b]=w;\r\n\t\t\t\t\t}break;\r\n\t\t\t\t\tcase 1:{\r\n\t\t\t\t\t\tconst a=mod[2]\r\n\t\t\t\t\t\tlet v=mod[3];\r\n\t\t\t\t\t\tthis.gameAxis[a]=v;\r\n\t\t\t\t\t}break;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\ttickKeyboard(){\r\n\r\n\t}\r\n\r\n\ttickGamepads(){\r\n\t\tconst axis=this.gameAxis;\r\n\t\tconst buttons=this.gameButtons;\r\n\t\tconst previous=this.gamePrevious;\r\n\t\tthis.gamePrevious=buttons.slice();\r\n\r\n\t\tconst rx=axis[2];\r\n\t\tconst spin=-rx*rx*rx*10;\r\n//\t\tthis.heading+=spin;\r\n\r\n\t\tthis.jogHeading(spin);\r\n\r\n\t\tif(buttons[5] && !previous[5]){\r\n\t\t\tconsole.log(\"zoom in\");\r\n\t\t\tthis.jogLevel(-1);\r\n\t\t}\r\n\t\tif(buttons[4] && !previous[4]){\r\n\t\t\tconsole.log(\"zoom out\");\r\n\t\t\tthis.jogLevel(1);\r\n\t\t}\r\n\r\n\t\tthis.jogZoom((buttons[6]-buttons[7]));\r\n//\t\tthis.jogZoom(axis[3]*0.25);\r\n\t\tthis.jogDolly(axis[0],axis[1]);\r\n\t}\r\n\r\n\tsingletouch(touchevent){\r\n\t\tconst scale=this.pixelSize;\r\n\t\tconst type=touchevent.type;\r\n\t\tconst ts=touchevent.timeStamp;\r\n\r\n\t\tswitch(type){\r\n\t\t\tcase \"touchstart\":{\r\n\t\t\t\tconst t=touchevent.touches[0];\r\n\t\t\t\tconst cx=scale*t.clientX;\r\n\t\t\t\tconst cy=scale*t.clientY;\r\n\t\t\t\tconst p={x:cx,y:cy,ts:ts};\r\n\t\t\t\tthis.pointerTrack.push(p);\r\n\t\t\t\tthis.mousedown=true;\r\n\t\t\t}break;\r\n\r\n\t\t\tcase \"touchmove\":{\r\n\t\t\t\tconst t=touchevent.touches[0];\r\n\t\t\t\tconst cx=scale*t.clientX;\r\n\t\t\t\tconst cy=scale*t.clientY;\r\n\t\t\t\tconst p={x:cx,y:cy,ts:ts};\r\n\t\t\t\tconst pp=this.pointerTrack.slice(-1)[0];\r\n\t\t\t\tthis.pointerTrack.push(p);\r\n\t\t\t\tif(pp){\r\n\t\t\t\t\tconst dx=cx-pp.x;\r\n\t\t\t\t\tconst dy=cy-pp.y;\r\n\t\t\t\t\tthis.drag(-dx,dy);\r\n\t\t\t\t}\r\n\t\t\t}break;\r\n\r\n\t\t\tcase \"touchcancel\":\r\n\t\t\tcase \"touchend\":{\r\n\t\t\t\tconst pp=this.pointerTrack.slice(-1)[0];\r\n\t\t\t\tconst p={x:pp.x,y:pp.y,ts:ts};\r\n\t\t\t\tthis.pointerTrack.push(p);\r\n\t\t\t\tthis.mousedown=false;\r\n\t\t\t\tconst v=this.pointerSpeed();\r\n\t\t\t\tconst t=this.pointerTime();\r\n\t\t\t\tconst speed2=v.x*v.x+v.y*v.y;\r\n\t\t\t\tif(speed2>1){\r\n\t\t\t\t\tconst force=1.0;\r\n\t\t\t\t\tthis.fling(-v.x,v.y,force);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(t<200){\r\n\t\t\t\t\t\tthis.click();\r\n\t\t\t\t\t\tconsole.log(\"touch click\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tthis.pointerTrack=[];\r\n\t\t\t}break;\r\n\t\t}\r\n\t}\r\n\r\n\tmultitouch(touchevent){\r\n\t\tconst scale=this.pixelSize;\r\n\t\tconst type=touchevent.type;\r\n\t\tconst ts=touchevent.timeStamp;\r\n\t\tconst touches=touchevent.touche