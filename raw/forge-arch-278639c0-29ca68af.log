2848a813 [deepseek-flash] #🟠nitrologic Relay 2.0.3 deepseek-flash 🐋 🪣 0.7° $0.002 17.09KB 7.08s
2848a813 [deepseek-flash] #Yes. There's no built-in binding, but it's a few lines. Which API you use depends on the Godot
2848a813 [deepseek-flash] #version.
2848a813 [deepseek-flash] #
2848a813 [deepseek-flash] #• Godot 4* — `DisplayServer.window_set_mode()`:
2848a813 [deepseek-flash] #
2848a814 [deepseek-flash] #
2848a814 [deepseek-flash] #extends Node
2848a814 [deepseek-flash] #
2848a814 [deepseek-flash] #const FULLSCREEN_MODES := [
2848a814 [deepseek-flash] #	DisplayServer.WINDOW_MODE_FULLSCREEN,
2848a814 [deepseek-flash] #	DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN,
2848a814 [deepseek-flash] #]
2848a814 [deepseek-flash] #
2848a814 [deepseek-flash] #func _unhandled_input(event: InputEvent) -> void:
