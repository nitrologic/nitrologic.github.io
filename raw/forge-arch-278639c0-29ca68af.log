.ARRAY_BUFFER;\r\n\t\tconst offset=this.vertCount*16;\r\n\t\tconst array32=this.posrot32;\r\n\t\tgl.bindBuffer(bufferType,this.vbo);\r\n\t\tgl.bufferSubData(bufferType,offset,array32);\r\n\t\tthis.glCheck();\r\n\t}\r\n\r\n\tglCheck(){\r\n\t\tconst error=this.gl.getError();\r\n//\t\tconst error=null;\r\n\t\tif(error){\r\n\t\t\tconsole.log(\"webgl2 check glError:\"+error);\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n// operate on bound vertex array \r\n\r\n\tdynamicBuffer(bufferType,shorts,instanceCount){\r\n\t\tconst shorts16=new Int16Array(shorts);\r\n\t\tconst gl=this.gl;\r\n\t\tconst bo=gl.createBuffer();\r\n\t\tconst byteCount=shorts16.byteLength+instanceCount*32;\r\n//\t\tconsole.log(\"byteCount:\",byteCount)\r\n\t\tgl.bindBuffer(bufferType,bo);\r\n\t\tgl.bufferData(bufferType,byteCount,gl.DYNAMIC_DRAW);\r\n\t\tgl.bufferSubData(bufferType,0,shorts16);\r\n\t\treturn bo;\r\n\t}\r\n\r\n\tstaticBuffer(bufferType,array){\r\n\t\tconst gl=this.gl;\r\n\t\tconst bo=gl.createBuffer();\r\n\t\tgl.bindBuffer(bufferType,bo);\r\n\t\tgl.bufferData(bufferType,array,gl.STATIC_DRAW);\r\n\t\treturn bo;\r\n\t}\r\n\r\n\taddFlatSurface(surface){\r\n\t\tconst tris=surface.quadTris();\r\n\t\t// rename me - short source is float32\r\n\t\tconst shorts=surface.flatifyVerts();\r\n\t\tconst n=shorts.length/8;\r\n\t\tif(n>65535){\r\n\t\t\tthis.triCount3=tris.length/3;\r\n\t\t\tthis.ibo=this.staticBuffer(this.gl.ELEMENT_ARRAY_BUFFER,new Uint32Array(tris));\r\n\t\t}else{\r\n\t\t\tthis.triCount1=tris.length/3;\r\n\t\t\tthis.ibo=this.staticBuffer(this.gl.ELEMENT_ARRAY_BUFFER,new Uint16Array(tris));\r\n\t\t}\r\n\t\tthis.vertCount=n;\r\n//\t\tthis.vbo=this.dynamicBuffer(this.gl.ARRAY_BUFFER,shorts,this.count);\r\n\t\tthis.vbo=this.instanceBuffer(shorts,this.instances,false);\r\n\t}\r\n\t\r\n// todo: rename these as add is a misnomer\r\n\r\n\taddMeshSurface(mesh){\r\n\t\tconst ibo=TypedMemory(mesh.indices);\r\n\t\tconst pos=TypedMemory(mesh.position);\r\n\t\tconst coords=TypedMemory(mesh.coords);\r\n\t\tconst n=mesh.position.count;\r\n\t\tconst shorts=n*12;\r\n\t\tconst vbo=new Int16Array(shorts);\r\n\t\tconst f=256;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tvbo[i*12+0]=pos[i*3+0]*f;\r\n\t\t\tvbo[i*12+1]=-pos[i*3+2]*f;\r\n\t\t\tvbo[i*12+2]=pos[i*3+1]*f;\r\n\t\t\tvbo[i*12+8]=coords[i*2+0]*32768;\r\n\t\t\tvbo[i*12+9]=coords[i*2+1]*32768;\r\n\t\t}\r\n\t\tthis.ibo=this.staticBuffer(this.gl.ELEMENT_ARRAY_BUFFER,ibo);\r\n\t\tthis.vbo=this.staticBuffer(this.gl.ARRAY_BUFFER,vbo);\r\n\t\tswitch(mesh.indices.component){\r\n\t\t\tcase \"Uint16\":\r\n\t\t\t\tthis.triCount1=ibo.length/3;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"Uint32\":\r\n\t\t\t\tthis.triCount3=ibo.length/3;\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\taddSurface(surface){\r\n\t\tif(!surface){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tconst tris=surface.tris;\r\n// todo validate normals\t\t\r\n//\t\tsurface.calcNormals();\r\n// rename shorts\r\nconst n=surface.vertCount;\r\nconst shorts=surface.verts32;\r\n\t\tif(n>65535){\r\n\t\t\tthis.triCount3=tris.length/3;\r\n\t\t\tthis.ibo=this.staticBuffer(this.gl.ELEMENT_ARRAY_BUFFER,new Uint32Array(tris));\r\n\t\t}else{\r\n\t\t\tthis.triCount1=tris.length/3;\r\n\t\t\tthis.ibo=this.staticBuffer(this.gl.ELEMENT_ARRAY_BUFFER,new Uint16Array(tris));\r\n\t\t}\r\n\t\tthis.vbo=this.staticBuffer(this.gl.ARRAY_BUFFER,new Int16Array(shorts));\r\n\t}\r\n\r\n\taddPoints(shorts){\r\n\t\tthis.pointCount=shorts.length/4;\r\n\t\tthis.vbo=this.staticBuffer(this.gl.ARRAY_BUFFER,new Int16Array(shorts));\r\n\t}\r\n\r\n\taddLines(shorts){\r\n\t\tthis.lineCount=shorts.length/8;\r\n\t\tthis.vbo=this.staticBuffer(this.gl.ARRAY_BUFFER,new Int16Array(shorts));\r\n\t}\r\n\r\n\taddTris(shorts,indices){\r\n\t\tthis.triCount1=indices.length/3;\r\n\t\tthis.ibo=this.staticBuffer(this.gl.ELEMENT_ARRAY_BUFFER,new Uint16Array(indices));\r\n\t\tthis.vbo=this.staticBuffer(this.gl.ARRAY_BUFFER,new Int16Array(shorts));\r\n\t}\r\n\r\n\taddDraw(draw,handlesUniform){\r\n\t\tconst gl=this.gl;\r\n\t\tdraw.push({command:gl.bindVertexArray,arguments:[this.vao]});\r\n\t\tconst textures=this.texturemaps;\r\n\t\tif(textures[0]){\r\n\t\t\tdraw.push({command:gl.activeTexture,arguments:[this.gl.TEXTURE0]});\r\n\t\t\tdraw.push({command:gl.bindTexture,arguments:[this.gl.TEXTURE_2D,textures[0].texture]});\r\n\t\t}\r\n\t\tif(textures[1]){\r\n\t\t\tdraw.push({command:gl.activeTexture,arguments:[this.gl.TEXTURE1]});\r\n\t\t\tdraw.push({command:gl.bindTexture,arguments:[this.gl.TEXTURE_2D,textures[1].texture]});\r\n\t\t}\r\n\t\tif(textures[2]){\r\n\t\t\tdraw.push({command:gl.activeTexture,arguments:[this.gl.TEXTURE2]});\r\n\t\t\tdraw.push({command:gl.bindTexture,arguments:[this.gl.TEXTURE_2D,textures[2].texture]});\r\n\t\t}\r\n\t\tfor(let t=0;t<this.transforms.length;t++){\r\n\t\t\tconst trans=this.transforms[t];\r\n\t\t\tconst n=trans.length/16;\r\n\t\t\tdraw.push({command:gl.uniformMatrix4fv,arguments:[handlesUniform,false,trans]});\r\n\t\t\tif (this.lineCount) \r\n\t\t\t\tdraw.push({command:gl.drawArraysInstanced,arguments:[gl.LINES,0,this.lineCount*2,n]});\r\n\t\t\tif (this.pointCount) \r\n\t\t\t\tdraw.push({command:gl.drawArraysInstanced,arguments:[gl.POINTS,0,this.pointCount,n]});\r\n\t\t\tif (this.triCount1) \r\n\t\t\t\tdraw.push({command:gl.drawElementsInstanced,arguments:[gl.TRIANGLES,this.triCount1*3,gl.UNSIGNED_SHORT,0,n]});\r\n\t\t\tif (this.triCount2) \r\n\t\t\t\tdraw.push({command:gl.drawArraysInstanced,arguments:[gl.TRIANGLES,0,this.triCount2*3,n]});\r\n\t\t\tif (this.triCount3) \r\n\t\t\t\tdraw.push({command:gl.drawElementsInstanced,arguments:[gl.TRIANGLES,this.triCount3*3,gl.UNSIGNED_INT,0,n]});\r\n\t\t}\r\n\t}\r\n\r\n\tbindAttributes(attributes,dim,vertcount){\r\n\t\tconst gl=this.gl;\r\n\t\tlet stride=0;\r\n\t\tlet stride2=0;\r\n//\t\tconst stride=Object.keys(attributes).length*dim*2;\r\n\t\tfor(const key in attributes){\r\n\t\t\tconst flat=key.startsWith(\"flat\");\r\n\t\t\tif(flat){\r\n\t\t\t\tstride2+=dim*4;\r\n\t\t\t}else{\r\n\t\t\t\tstride+=dim*2\r\n\t\t\t}\r\n\t\t}\r\n\t\tlet offset=0;\r\n\t\tlet offset2=vertcount*stride;\r\n\t\tfor(const key in attributes){\r\n\t\t\tconst index=attributes[key];\r\n\t\t\tgl.enableVertexAttribArray(index);\r\n\t\t\tconst norm=key.startsWith(\"norm\");\r\n\t\t\tconst flat=key.startsWith(\"flat\");\r\n\t\t\tif(flat){\r\n\t\t\t\tgl.vertexAttribIPointer(index,dim,gl.INT,stride2,offset2);\r\n\t\t\t\tgl.vertexAttribDivisor(index,1);\r\n\t\t\t\toffset2+=dim*4;\r\n\t\t\t}else if(norm){\r\n\t\t\t\tgl.vertexAttribPointer(index,dim,gl.SHORT,true,stride,offset);\t\t\r\n\t\t\t\toffset+=dim*2;\r\n\t\t\t}else{\r\n\t\t\t\tgl.vertexAttribIPointer(index,dim,gl.SHORT,stride,offset);\t\t\r\n\t\t\t\toffset+=dim*2;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.glCheck();\r\n\t}\r\n}\r\n\r\nclass Layer{\r\n\tconstructor(gl,program,attributeNames,uniformNames,tags){\r\n\t\tthis.gl=gl;\r\n\t\tthis.program=program;\r\n\t\tthis.tags=tags;\r\n\t\tthis.attributes={};\t//normal bind attribute names begin with \"norm\"\r\n\t\tthis.uniforms={};\r\n\t\tfor(const name of attributeNames){\r\n\t\t\tthis.attributes[name]=this.program.attribute(name);\r\n\t\t}\r\n\t\tfor(const name of uniformNames){\r\n\t\t\tthis.uniforms[name]=this.program.uniform(name);\r\n\t\t}\r\n\t\tthis.shapes=[];\r\n\t\tthis.useLayer();\r\n\t}\r\n\tflushLayer(){\r\n\t\tfor(const shape of this.shapes){\r\n\t\t\tshape.flushBuffers();\r\n\t\t\tshape.flushTextures();\r\n\t\t}\r\n\t}\r\n\tuseLayer(){\r\n\t\tthis.gl.useProgram(this.program.name);\r\n\t}\r\n\tclearBuffers(){\r\n\t\tthis.shapes=[];\r\n\t}\r\n\taddShape(shape){\r\n\t\tthis.shapes.push(shape);\r\n\t}\r\n\taddTexturedShape(shape,texture){\r\n\t\tthis.shapes.push(shape);\r\n\t}\r\n\tremoveShape(shape){\r\n\t\tconst index=this.shapes.indexOf(shape);\r\n\t\tif(index>=0){\r\n\t\t\tthis.shapes.splice(index,1);\r\n\t\t}\r\n\t}\r\n\tsetShorts(bufferType,array){\r\n\t\tgl.bufferData(bufferType,array,gl.DYNAMIC_DRAW);\r\n\t}\r\n\r\n\tpokeArray(array){\r\n\t\tconst gl=this.gl;\r\n\t\tgl.bufferData(gl.ARRAY_BUFFER,array,gl.DYNAMIC_DRAW);\r\n\t}\r\n\tsetColor(r,g,b,a){\r\n\t\tthis.color=[r,g,b,a];\r\n\t}\r\n\tsetMatrix(name,array){\r\n\t\tconst index=this.uniforms[name];\r\n\t\tconst gl=this.gl;\r\n\t\tgl.uniformMatrix4fv(index,false,array);\r\n\t}\r\n\tsetFloats(name,array){\r\n\t\tconst index=this.uniforms[name];\r\n\t\tconst gl=this.gl;\r\n\t\tthis.gl.uniform4fv(index,array);\r\n\t}\r\n\tsetInts(name,array){\r\n\t\tconst index=this.uniforms[name];\r\n\t\tconst gl=this.gl;\r\n\t\tgl.uniform4iv(index,array);\r\n\t}\r\n\tsetSampler(name,sampler){\r\n\t\tconst uniform=this.uniforms[name];\r\n\t\tconst gl=this.gl;\r\n\t\tgl.uniform1i(uniform, sampler);\t\t\r\n\t}\r\n}\r\n\r\nclass WireProgram {\r\n\tconstructor(gl,shaders) {\r\n\t\tconst program = gl.createProgram();\r\n\t\tfor(const key in shaders){\r\n\t\t\tconst shader=shaders[key];\r\n\t\t\ttry{\r\n\t\t\t\tgl.attachShader(program, shader);\r\n\t\t\t}catch(typeError){\r\n\t\t\t\tconsole.log(typeError.toString());\r\n\t\t\t}\r\n\t\t}\r\n\t\tgl.linkProgram(program);\r\n\t\tconst success=gl.getProgramParameter(program,gl.LINK_STATUS);\r\n\t\tif (success){\r\n\t\t\tthis.gl=gl;\r\n\t\t\tthis.name=program;\r\n\t\t}else{\r\n\t\t\tconsole.log(\"Could not link WebGL program\");\r\n\t\t\tReportError(gl.getProgramInfoLog(program));\r\n\t\t\tgl.deleteProgram(program);\r\n\t\t}\r\n\t}\r\n\tattribute(name){\r\n\t\tconst n=this.gl.getAttribLocation(this.name,name);\r\n\t\tif(n==-1){\r\n\t\t\tReportError(\"attribute not found with name:\"+name);\r\n\t\t}\r\n\t\treturn n;\r\n\t}\r\n\tuniform(name){\r\n\t\tconst n=this.gl.getUniformLocation(this.name,name);\r\n\t\tif(n==-1){\r\n\t\t\tconsole.error(\"uniform not found with name:\"+name);\r\n\t\t}\r\n\t\treturn n;\r\n\t}\r\n}\r\n\r\nclass Shader {\r\n\tconstructor(gl,source,shaderType,uri) {\r\n\t\tconst shader = gl.createShader(shaderType);\r\n\t\tgl.shaderSource(shader,source);\r\n\t\tgl.compileShader(shader);\r\n\t\tconst success = gl.getShaderParameter(shader, gl.COMPILE_STATUS);\r\n\t\tif (success) {\r\n\t\t\tthis.shader=shader;\t\t\t\r\n\t\t}else{\r\n\t\t\tconst info=gl.getShaderInfoLog(shader);\r\n\t\t\tconsole.error(\"Could not compile WebGL shader\",uri);\r\n\t\t\tconsole.error(info);\r\n\t\t\tconst split=info.split(\":\");\r\n\t\t\tif (split[0]==\"ERROR\"){\r\n\t\t\t\tthis.error=split;\r\n\t\t\t}\r\n\t\t\tgl.deleteShader(shader);\r\n\t\t}\r\n\t}\r\n}\r\n\r\nconst GLParamsList=[\"VERSION\",\"MAX_UNIFORM_BLOCK_SIZE\",\"MAX_VERTEX_UNIFORM_BLOCKS\",\"MAX_FRAGMENT_UNIFORM_COMPONENTS\",]\r\n\r\n//const GLTextureParamsList=[\"VERSION\",\"MAX_TEXTURE_IMAGE_UNITS\",\"MAX_VERTEX_TEXTURE_IMAGE_UNITS\",\"MAX_COMBINED_TEXTURE_IMAGE_UNITS\"]\r\n//\"SHADING_LANGUAGE_VERSION\",\"MAX_TEXTURE_SIZE\",\"MAX_3D_TEXTURE_SIZE\",\"MAX_ELEMENT_INDEX\",\r\n//\"ALIASED_POINT_SIZE_RANGE\",\"ALIASED_LINE_WIDTH_RANGE\"];\r\n\r\nclass WebGL2Context {\r\n\r\n\tconstructor(canvas,profile) {\r\n\t\tlet gl=canvas.getContext(\"webgl2\",{antialias:profile.AntiAlias});\r\n\t\tif(!gl){\r\n\t\t\tgl=canvas.getContext(\"webgl2\");\r\n\t\t}\r\n\t\tif(gl){\r\n\t\t\tthis.canvas=canvas;\r\n\t\t\tthis.profile=profile;\r\n\t\t\tthis.gl=gl\r\n//\t\t\tthis.logParams(GLParamsList);\r\n\t\t\tthis.errorsInfo={};\r\n\t\t\tthis.errorsInfo[0x9242]=\"CONTEXT_LOST_WEBGL\";\r\n\t\t\tthis.errorsInfo[0x0505]=\"OUT_OF_MEMORY\";\r\n\t\t\tthis.errorsInfo[0x0502]=\"INVALID_OPERATION\";\r\n\t\t\tthis.errorsInfo[0x0501]=\"INVALID_ENUM\";\r\n\t\t\tthis.errorsInfo[1281]=\"BAD VALUE\";\r\n\t\t\tthis.errorsInfo[1282]=\"INVALID_OPERATION\";\r\n\t\t}\r\n\t}\r\n\tlogParams(names){\r\n\t\tfor(const name of names){\r\n\t\t\tconsole.log(name+\"=\"+this.gl.getParameter(this.gl[name]));\r\n\t\t}\r\n\t}\r\n\tclear(rgb) {\r\n\t\tconst gl=this.gl;\r\n\t\tgl.viewport(0, 0, this.canvas.width, this.canvas.height);\r\n\t\tif(rgb){\r\n\t\t\tgl.clearColor(rgb[0]/255.0,rgb[1]/255.0,rgb[2]/255.0,0.5);\r\n\t\t\tgl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);\r\n\t\t}else{\r\n\t\t\tgl.clear(gl.DEPTH_BUFFER_BIT);\r\n\t\t}\r\n\t\tgl.enable(gl.BLEND);\r\n\t\tgl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);\r\n\t\tgl.enable(gl.CULL_FACE);\r\n//\t\tgl.depthMask(false);\r\n\t}\r\n}\r\n\r\nfunction lineOffset(text,line){\r\n\tlet p=0;\r\n\twhile(line--){\r\n\t\tp=text.indexOf(\"\\n\",p+1)+1;\r\n\t}\r\n\treturn p;\r\n}\r\n\r\nfunction shaderError(id,split){\r\n\tconst line=split[2]|0;\r\n\tconst status=\"shaderError:\"+split.toString()+\" line:\"+line;\r\n\tSetStatus(status);\r\n}\r\n\r\n\r\n// const _externTypes=[GraphicsDevice,GraphicsDisplay,GraphicsStack,Scene];\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_util.js\",\"length\":5991,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_util.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\nclass Bits{\r\n\tconstructor(w,h,x,y){\r\n\t\tthis.clear(w,h,x,y)\r\n\t}\r\n\r\n\tclear(w,h,x,y){\r\n\t\tw=(w+3)>>2;\r\n\t\th=(h+3)>>2;\r\n\t\tthis.home=[x,y];\r\n\t\tthis.width=w;\r\n\t\tthis.height=h;\r\n\t\tthis.bits=[\r\n\t\t\tnew Uint16Array(w*h),\r\n\t\t\tnew Uint16Array(w*h),\r\n\t\t\tnew Uint16Array(w*h)\r\n\t\t];\r\n\t\tthis.verts=[];\r\n\t\tthis.tris=[];\r\n\t}\r\n\r\n\tpoly(v){\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tconst ox=this.home[0];\r\n\t\tconst oy=this.home[1];\r\n\t\tconst bits=this.bits[0];\r\n\t\tconst n=v.length;\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst x0=(v[i][0]-ox)>>2;\r\n\t\t\tconst y0=(v[i][1]-oy)>>2;\r\n\t\t\tconst x1=(v[i+1][0]-ox)>>2;\r\n\t\t\tconst y1=(v[i+1][1]-oy)>>2;\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst d=(dx*dx>dy*dy)?Math.abs(dx)|0:Math.abs(dy)|0;\r\n//\t\t\tconst d=Math.abs(dy)|0;\r\n\t\t\tfor(let j=0;j<d;j++){\r\n\t\t\t\tlet x=(x0+(dx*j)/d)|0;\r\n\t\t\t\tlet y=(y0+(dy*j)/d)|0;\r\n\t\t\t\tif(x<0)x=0;\r\n\t\t\t\tif(x>w-1)x=w-1;\r\n//\t\t\t\tif(y<0)y=0;\r\n//\t\t\t\tif(y>h-1)y=h-1;\r\n\t\t\t\tbits[y*w+x]++;\r\n\t\t\t}\r\n\t\t}\t\t\r\n\t}\r\n\r\n\tcropTopo(heightmap,height){\r\n\t\tconst minx=this.home[0];\r\n\t\tconst miny=this.home[1];\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<this.height;y++){\r\n\t\t\tlet on=false;\r\n\t\t\tfor(let x=0;x<this.width;x++){\r\n\t\t\t\tconst ebits=this.bits[0][i];\r\n\t\t\t\tif(ebits&1){\r\n\t\t\t\t\ton=!on;\r\n\t\t\t\t}\r\n\t\t\t\tif(on||ebits){\r\n\t\t\t\t\tconst tx=(x<<2)+minx;\r\n\t\t\t\t\tconst ty=(y<<2)+miny;\r\n\t\t\t\t\tfor(var bx=-border;bx<=border;bx++){\r\n\t\t\t\t\t\tfor(var by=-border;by<=border;by++){\r\n\t\t\t\t\t\t\theightmap.setHeight(tx+bx,ty+by,0);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n//\t\t\t\t\tthis.bits[1][i]=index++;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tdigTopo(heightmap,depth,border){\r\n\t\tconst minx=this.home[0];\r\n\t\tconst miny=this.home[1];\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<this.height;y++){\r\n\t\t\tlet on=false;\r\n\t\t\tfor(let x=0;x<this.width;x++){\r\n\t\t\t\tconst ebits=this.bits[0][i];\r\n\t\t\t\tif(ebits&1){\r\n\t\t\t\t\ton=!on;\r\n\t\t\t\t}\r\n\t\t\t\tif(on||ebits){\r\n\t\t\t\t\tconst tx=(x<<2)+minx;\r\n\t\t\t\t\tconst ty=(y<<2)+miny;\r\n\t\t\t\t\tfor(var bx=-border;bx<=border;bx++){\r\n\t\t\t\t\t\tfor(var by=-border;by<=border;by++){\r\n\t\t\t\t\t\t\theightmap.setGround(tx+bx,ty+by,depth);\r\n\t\t\t\t\t\t\theightmap.setHeight(tx+bx,ty+by,0);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n//\t\t\t\t\tthis.bits[1][i]=index++;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tdig2(heightmap,depth){\r\n\t\tconst minx=this.home[0];\r\n\t\tconst miny=this.home[1];\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<this.height;y++){\r\n\t\t\tlet on=false;\r\n\t\t\tfor(let x=0;x<this.width;x++){\r\n\t\t\t\tconst ebits=this.bits[0][i];\r\n\t\t\t\tif(ebits&1){\r\n\t\t\t\t\ton=!on;\r\n\t\t\t\t}\r\n\t\t\t\tif(on||ebits){\r\n\t\t\t\t\tconst tx=(x<<2)+minx;\r\n\t\t\t\t\tconst ty=(y<<2)+miny;\r\n\t\t\t\t\theightmap.setGround(tx,ty,depth);\r\n\t\t\t\t\theightmap.setHeight(tx,ty,0);\r\n//\t\t\t\t\tthis.bits[1][i]=index++;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tfill(tile,c){\r\n\t\tconst minx=this.home[0];\r\n\t\tconst miny=this.home[1];\r\n\t\tlet i=0;\r\n\t\tconst verts=this.verts;\r\n\t\tverts.push([0,0,0,3,0,0,0,c]);\t//make index 1 based with origin at 0\r\n\t\tlet index=verts.length;\r\n\t\tfor(let y=0;y<this.height;y++){\r\n\t\t\tlet on=false;\r\n\t\t\tfor(let x=0;x<this.width;x++){\r\n\t\t\t\tconst ebits=this.bits[0][i];\r\n\t\t\t\tif(ebits&1){\r\n//\t\t\t\t\ton=!on;\r\n\t\t\t\t}\r\n\t\t\t\tif(on||ebits){\r\n\t\t\t\t\tconst tx=(x<<2)+minx;\r\n\t\t\t\t\tconst ty=(y<<2)+miny;\r\n\t\t\t\t\tconst h0=tile.pickElevation(tx,ty);\r\n\t\t\t\t\tconst h1=tile.pickHeight(tx,ty);\r\n\t\t\t\t\tverts.push([tx,-ty,h0+h1,3,0,0,0,c]);\r\n\t\t\t\t\tthis.bits[1][i]=index++;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst tris=this.tris;\r\n\t\tfor(let y=0;y<this.height-1;y++){\r\n\t\t\tfor(let x=0;x<this.width-1;x++){\r\n\t\t\t\tconst v0=this.bits[1][y*this.width+x];\r\n\t\t\t\tconst v1=this.bits[1][y*this.width+x+1];\r\n\t\t\t\tconst v2=this.bits[1][(y+1)*this.width+x+1];\r\n\t\t\t\tconst v3=this.bits[1][(y+1)*this.width+x];\r\n\t\t\t\tif(v0&&v1&&v2){\r\n\t\t\t\t\ttris.push([v0,v2,v1]);\r\n\t\t\t\t\tif(v0&&v2&&v3){\r\n\t\t\t\t\t\ttris.push([v0,v3,v2]);\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(v1&&v2&&v3){\r\n\t\t\t\t\t\ttris.push([v1,v3,v2]);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(v1&&v3&&v0){\r\n\t\t\t\t\t\ttris.push([v1,v0,v3]);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tdump(){\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<this.height;y++){\r\n\t\t\tlet line=\"\";\r\n\t\t\tfor(let x=0;x<this.width;x++){\r\n\t\t\t\tconst ebits=this.bits[0][i++];\r\n\t\t\t\tline+=(ebits&1)?\"X\":\".\";\r\n\t\t\t}\r\n\t\t\tconsole.log(line);\r\n\t\t}\r\n\t\tconsole.log(\":)\");\r\n\t}\r\n\r\n\tbuild(){\r\n//\t\tthis.dump();\r\n\t\tif(this.verts.length>65535){\r\n\t\t\tconsole.log(\"Warning! Bits verts.length \"+this.verts.length);\r\n\t\t}\r\n\t\treturn new Surface(this.verts,this.tris,[]);\r\n\t}\r\n}\r\n\r\n//const _unicode = new TextEncoder();\r\n\r\nfunction ReportError(message){\r\n\tconsole.error(message);\r\n\tdebugger;\r\n}\r\n\r\nclass EventServer{\r\n\tconstructor(){\r\n\t\tthis.worker=new Worker(\"nitrojs/worker_post.js\");\r\n\t\tthis.worker.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\tonMessage(e){\r\n\t\tSetStatus(\"ping:\"+e.data.ping);\r\n\t}\r\n\r\n\taddEvent(name,body){\r\n\t\tevent={name:name,body:body};\r\n\t\tthis.worker.postMessage(event);\r\n\t}\r\n}\r\n\r\nlet AppUserEvents=[];\r\nconst AppEventServer=new EventServer();\r\n\r\nfunction PostUserEvent(userevent){\r\n\tAppUserEvents.push(userevent);\r\n}\r\n\r\nfunction FetchEvents(){\r\n\tconst events=AppUserEvents;\r\n\tAppUserEvents=[];\r\n\treturn events;\r\n}\r\n\r\nfunction setOn(element,on){\r\n\tif(on){\r\n\t\telement.setAttribute(\"on\",\"\");\r\n\t}else{\r\n\t\telement.removeAttribute(\"on\");\r\n\t}\r\n}\r\n\r\nfunction toggleAttribute(element,attribute){\r\n\tif(element.hasAttribute(attribute)){\r\n\t\telement.removeAttribute(attribute);\r\n\t\treturn false;\r\n\t}else{\r\n\t\telement.setAttribute(attribute,\"\");\r\n\t\treturn true;\r\n\t}\r\n}\r\n\r\nconst utf8Decoder = new TextDecoder('utf-8');\r\n\r\nasync function fetchText(fileURL) {\r\n\tconst response = await fetch(fileURL);\r\n\tconst blob = await response.blob();\r\n\tconst buffer=await blob.arrayBuffer();\r\n\treturn utf8Decoder.decode(buffer);\r\n}\r\n\r\nclass Page{\r\n\tconstructor(div){\r\n\t\tthis.element=div;\r\n\t\tthis.requests=0;\r\n\t}\r\n\r\n\tset(md){\r\n\t\tconst html=markUp(md);\r\n//\t\tconst html=markdownPage(md);\r\n\t\tthis.element.innerHTML=html;\r\n\t}\r\n\r\n\tgetLoad(get,name){\r\n\t\tthis.glsl[name]=get.response;\r\n\t\tthis.gets++;\r\n\t\tif(this.gets==this.requests){\r\n\t\t\tthis.handler();\r\n\t\t}\r\n\t}\r\n\r\n\tgetError(){}\r\n\tgetAbort(){}\r\n\r\n\tasync request(name){\r\n\t\tthis.requests++;\r\n\t\tconst uri=\"doc/\"+name+\".md\";\r\n\t\tconst text=await fetchText(uri);\r\n\t\tthis.set(text);\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_model.js\",\"length\":7350,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_model.js\r\n// (c)2022 nitrologic@gmail.com\r\n// All rights reserved\r\n\r\n// Importer Model\r\n\r\n// PostEvent({event:\"loadmodel\",url:model.url})\r\n\r\n\"use strict\"\r\n\r\nfunction MatrixTransform(a,b){ //Float32Array a,Float32Array b\r\n\r\n}\r\n\r\nconst TypeComponent={5123:\"Uint16\",5125:\"Uint32\",5126:\"Float32\"};\r\nconst ViewTargets={34962:\"Array\",34963:\"Element\"};\r\n\r\nfunction TypedMemory(mem){\r\n\tconst v=mem.view;\r\n\tswitch (mem.component){\r\n\t\tcase \"Uint16\":\r\n\t\t\treturn new Uint16Array(v.array,v.offset,v.length/2)\r\n\t\tcase \"Uint32\":\r\n\t\t\treturn new Uint32Array(v.array,v.offset,v.length/4);\r\n\t\tcase \"Float32\":\r\n\t\t\treturn new Float32Array(v.array,v.offset,v.length/4);\r\n\t\tdefault:\r\n\t\t\tdebugger;\r\n\t}\r\n}\r\n\r\nclass Model{\r\n\r\n\tconstructor(dir,url,name,handler){\r\n\r\n\t\tthis.refCount=1;\r\n\t\tthis.images={};\r\n\t\tthis.blobs={};\r\n\t\t\r\n\t\tthis.meesh=[];\r\n\t\tthis.meep=[];\r\n\t\r\n\t\tthis.root=null;\r\n\t\tthis.meshnode=null;\r\n\t\r\n\t\tthis.dir=dir;\r\n\t\tthis.url=url;\r\n\t\tthis.name=name;\r\n\t\tthis.handler=handler;\r\n\t}\r\n\r\n\trelease(){\r\n\t\tif(--this.refCount==0){\r\n\t\t\tthis.handler();\r\n\t\t}\r\n\t}\r\n\r\n\tdrawGraph(node,graph){\r\n\t\tgraph.push(node.matrix);\r\n\t\tfor(const kid of node.nodes){\r\n\t\t\tthis.drawGraph(kid,graph);\r\n\t\t}\r\n\t}\r\n\r\n\tgetMeshTransform(m){\r\n\t\tconst graph=[];\r\n\t\tthis.drawGraph(this.root,graph);\r\n\t\tconst t=new Float32Array([m,0,0,0,m,0,0,0,m]);\r\n/*\t\t\r\n\t\tlet node=this.meshnode;\r\n\t\twhile(node){\r\n\t\t\tlet m=node.matrix;\r\n\t\t\tif(m){\r\n\t\t\t\tMatrixTransform(t,m);\r\n\t\t\t}\r\n\t\t\tnode=node.parent;\r\n\t\t}\r\n*/\t\t\r\n\t\treturn t;\r\n\t}\r\n\r\n\t// called from request handlers\r\n\r\n\tsetBlob(uri,blob){\r\n\t\tthis.blobs[uri]=blob;\r\n\t\tthis.release();\r\n\t}\r\n\r\n\tsetImage(uri,image){\r\n\t\tthis.images[uri]=image;\r\n\t\tthis.release();\r\n\t}\r\n}\r\n\r\n// emits mesh loaded events\r\n\r\nclass MeshLoader{\r\n\r\n\tconstructor(){\r\n\t\tthis.gltfModel={};\r\n\t\tthis.gltfMain={};\r\n\t\tthis.gltfBlob={};\r\n\t\tthis.gltfImage={};\r\n\t\tthis.gltfLoader={};\r\n\t}\r\n\r\n\tmodelLoad(url){\r\n\t\tconst model=this.gltfModel[url];\r\n\t\tconst main=this.gltfMain[url];\r\n\t\tthis.parseGLTFData(model,main);\r\n\t}\r\n\r\n\trequestGLTF(name){\r\n//\t\tconst dir=\"roagrid/glb/\"+name+\"_glb/\"\r\n\t\tconst dir=\"world/\"+name.toLowerCase()+\"/\";\r\n\t\tconst url=dir+name+\".gltf\";\r\n\t\tconst handler=this.modelLoad.bind(this,url);\r\n\t\tconst model=new Model(dir,url,name,handler);\r\n\t\tthis.gltfModel[url]=model;\t\t\r\n\t\tfetch(url).then(response=>response.json()).then(\r\n\t\t\tbody=>{\r\n\t\t\t\tthis.gltfMain[url]=body;\t\t\r\n\t\t\t\tthis.parseGLTFBody(model,body);\r\n\t\t\t\tmodel.release();\r\n\t\t\t\tconsole.log(\"requestGLTF:\"+name);\r\n\t\t\t},error=>{\r\n\t\t\t\tconsole.log(\"requestGLTF:\"+error);\r\n\t\t\t}\r\n\t\t);\r\n\t}\r\n\r\n\trequestBlob(model,uri,_length,_body){\r\n\t\tmodel.refCount++;\r\n\t\tconst url=model.dir+uri;\r\n\t\tif(url in this.gltfBlob){\r\n\t\t\tconst blob=this.gltfBlob[url];\r\n\t\t\tmodel.setBlob(uri,blob);\r\n\t\t}else{\r\n\t\t\tconsole.log(\"fetching \",url);\r\n\t\t\tfetch(url)\r\n\t\t\t\t.then(response => response.blob())\r\n\t\t\t\t.then(blob => {\r\n\t\t\t\t\tthis.gltfBlob[url]=blob;\r\n\t\t\t\t\tmodel.setBlob(uri,blob);\r\n\t\t\t\t\tconsole.log(\"setBlob\",uri);\r\n\t\t\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\trequestImage(model,src){\r\n\t\tmodel.refCount++;\r\n\t\tconst url=model.dir+src;\r\n\t\tconsole.log(\"requesting \",url);\r\n\t\tif(url in this.gltfLoader){\r\n\t\t\tconst loader=this.gltfImage[url];\r\n\t\t\tif(loader.image.complete){\r\n\t\t\t\tmodel.setImage(src,loader.image.img);\r\n\t\t\t}else{\r\n\t\t\t\t// simon come here\r\n\t\t\t\tconsole.log(\"requestImage work in progress\");\r\n\t\t\t\tdebugger;\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tconst callback=model.setImage.bind(model,src);\r\n\t\t\tconst loader=new TextureLoader(url,callback);\r\n\t\t\tthis.gltfLoader[url]=loader;\r\n\t\t}\r\n\t}\r\n\r\n\tparseGLTFBody(model,body){\r\n\t\tfor(const b of body.buffers){\r\n\t\t\tthis.requestBlob(model,b.uri,b.byteLength,body);\r\n\t\t}\r\n\t\tfor(const i of body.images){\r\n\t\t\tthis.requestImage(model,i.uri);\r\n\t\t}\r\n\t}\r\n\r\n/*\r\n\r\n  \"nodes\": [\r\n    {\r\n      \"children\": [\r\n        2,\r\n        1\r\n      ],\r\n      \"matrix\": [\r\n        0.009999999776482582,\r\n        0,\r\n        0,\r\n        0,\r\n        0,\r\n        0.009999999776482582,\r\n        0,\r\n        0,\r\n        0,\r\n        0,\r\n        0.009999999776482582,\r\n        0,\r\n        0,\r\n        0,\r\n        0,\r\n        1\r\n      ]\r\n    },\r\n    {\r\n      \"matrix\": [\r\n        -0.7289686799049377,\r\n        0,\r\n        -0.6845470666885376,\r\n        0,\r\n        -0.42520490288734436,\r\n        0.7836934328079224,\r\n        0.4527972936630249,\r\n        0,\r\n        0.5364750623703003,\r\n        0.6211478114128113,\r\n        -0.571287989616394,\r\n        0,\r\n        400.1130065917969,\r\n        463.2640075683594,\r\n        -431.0780334472656,\r\n        1\r\n      ],\r\n      \"camera\": 0\r\n    },\r\n    {\r\n      \"mesh\": 0\r\n    }\r\n  ],\r\n*/\r\n\r\n\r\n\tasync parseGLTFData(model,gltf){\r\n\t\tconst meep=[];\r\n\t\tfor(const image of gltf.images){\r\n\t\t\tconst src=image.uri;\r\n\t\t\tconst img=model.images[src];\r\n\t\t\tmeep.push(img);\r\n\t\t}\r\n\r\n\t\tconst blobs=[];\r\n\t\tfor(const buffer of gltf.buffers){\r\n\t\t\tconst blob=this.gltfBlob[model.dir+buffer.uri];\r\n\t\t\tconst array=await blob.arrayBuffer();\r\n\t\t\tblobs.push(array);\r\n\t\t}\r\n\r\n\t\tconst views=[];\r\n\t\tfor(const view of gltf.bufferViews){\r\n\t\t\tconst array=blobs[view.buffer];\r\n\t\t\tconst offset=view.byteOffset;\r\n\t\t\tconst length=view.byteLength;\r\n\t\t\tconst target=(view.target in ViewTargets)?ViewTargets[view.target]:\"???\";\r\n//\t\t\tif(!target){\r\n//\t\t\t\tconsole.log(\"loadGLTF did not recognise bufferview target \"+view.target);\r\n//\t\t\t}\r\n\t\t\tviews.push({array,offset,length,target});\r\n\t\t}\r\n\r\n\t\tconst mem=[];\r\n\t\tfor(const a of gltf.accessors){\r\n\t\t\tconst view=views[a.bufferView];\r\n\t\t\tconst offset=a.byteOffset;\r\n\t\t\tconst count=a.count;\r\n\t\t\tconst dim=TypeDim[a.type];\r\n\t\t\tconst component=TypeComponent[a.componentType];\r\n\t\t\tif(!dim){\r\n\t\t\t\tconsole.log(\"accessory unknown dim\");\r\n\t\t\t}\r\n\t\t\tif(!component){\r\n\t\t\t\tconsole.log(\"accessory unknown type:\",a.type,a.componentType);\r\n\t\t\t}\r\n\t\t\tif(gltf.sparse){\r\n\t\t\t\tconsole.log(\"accessory sparse not supported\");\r\n\t\t\t}\r\n\t\t\tmem.push({view,offset,count,dim,component});\r\n\t\t}\r\n\r\n\t\tconst meesh=[];\r\n\t\tfor(const mesh of gltf.meshes){\r\n\t\t\tfor(const prim of mesh.primitives){\r\n\t\t\t\tconst attributes=prim.attributes;\r\n\t\t\t\tconst position=mem[attributes.POSITION];\r\n\t\t\t\tconst normal=mem[attributes.NORMAL];\r\n\t\t\t\tconst coords=mem[attributes.TEXCOORD_0];\r\n\t\t\t\tconst indices=mem[prim.indices];\r\n\t\t\t\tconst mode=prim.mode;\r\n\t\t\t\tif(mode!=4){\r\n\t\t\t\t\tconsole.log(\"gltf primitive unsupported mode \"+mode);\r\n\t\t\t\t}\r\n\t\t\t\tmeesh.push({position,coords,indices})\r\n\t\t\t\t// TRIANGLES\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tlet meshnode=null;\r\n\t\tlet root=null;\r\n\t\tconst nodes=[];\r\n\t\tfor(const node of gltf.nodes){\r\n\t\t\tconst mesh=meesh[node.mesh];\r\n\t\t\tconst name=node.name;\r\n\t\t\tconst camera=node.camera;\r\n\t\t\tconst matrix=node.matrix;\r\n\t\t\tconst kids=node.children;\r\n\t\t\tnodes.push({mesh,name,camera,matrix,kids});\r\n\t\t}\r\n\t\tfor(const node of nodes){\r\n\t\t\tnode.nodes=[];\r\n\t\t\tif(node.kids){\r\n\t\t\t\tconst n=node.kids.length;\r\n\t\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\t\tconst kid=nodes[node.kids[i]];\r\n\t\t\t\t\tnode.nodes.push(kid);\r\n\t\t\t\t\tif(kid.parent){\r\n\t\t\t\t\t\tconsole.log(\"multiple parents for kid in gltf nodes\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\tkid.parent=node;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(const node of nodes){\r\n\t\t\tif(!node.parent){\r\n\t\t\t\tif(root){\r\n\t\t\t\t\tconsole.log(\"multiple roots found in gltf nodes\");\r\n\t\t\t\t}\r\n\t\t\t\troot=node;\r\n\t\t\t}\r\n\t\t\tif(node.mesh){\r\n\t\t\t\tif(meshnode){\r\n\t\t\t\t\tconsole.log(\"multiple mesh nodes found in gltf nodes\")\r\n\t\t\t\t}\r\n\t\t\t\tmeshnode=node;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\r\n\t\tmodel.meesh=meesh;\r\n\t\tmodel.meep=meep;\r\n\t\tmodel.nodes=nodes.length;\r\n\t\tmodel.root=root;\r\n\t\tmodel.meshnode=meshnode;\r\n\r\n\t\tPostUserEvent({event:\"loadmodel\",url:model.url})\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_geometry.js\",\"length\":8715,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_geometry.js\r\n// (c)2022 Simon Armstrong\r\n// All rights reserved\r\n\r\nfunction Normalize(a,o){\r\n\tconst d=Math.sqrt(a[o+0]*a[o+0]+a[o+1]*a[o+1]+a[o+2]*a[o+2]);\r\n\tconst q=1.0/d;\r\n\ta[o+0]*=q;\r\n\ta[o+1]*=q;\r\n\ta[o+2]*=q;\r\n}\r\n\r\nfunction Cross(a,b){\r\n\treturn [a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];\r\n}\r\n\r\nfunction CalculateNormal(a,b,c) {\r\n\tconst u=[b[0]-a[0],b[1]-a[1],b[2]-a[2]];\r\n\tconst v=[c[0]-a[0],c[1]-a[1],c[2]-a[2]];\r\n\tconst n=[u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]];\r\n\treturn n;\r\n}\r\n\r\nfunction CalculateNormalSlow(a,b,c) {\r\n\tconst u=[b[0]-a[0],b[1]-a[1],b[2]-a[2]];\r\n\tconst v=[c[0]-a[0],c[1]-a[1],c[2]-a[2]];\r\n\tNormalize(u,0);\r\n\tNormalize(v,0);\r\n\tconst n=[u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]];\r\n\tNormalize(n,0);\r\n\treturn n;\r\n}\r\n\r\n/*\r\n\r\nclass SuperSurface{\r\n\r\n\tflip(o,i0,i1,i2){\r\n\t\tconst v=this.verts[o];\r\n\t\tconst v0=this.verts[i0];\r\n\t\tconst v1=this.verts[i1];\r\n\t\tconst v2=this.verts[i2];\r\n\t\tconst t=CalculateNormal(v0,v1,v2);\r\n\t\tconst dot=t[0]*v[0]+t[1]*v[1]+t[2]*v[2];\r\n\t\tif(dot>0){\r\n\t\t\treturn [i0,i1,i2];\r\n\t\t}else{\r\n\t\t\treturn [i0,i2,i1];\r\n\t\t}\r\n\t}\r\n\r\n\t// for all single face edges fatten inner walls\r\n\t// -vertex are 1\"s complement backwards links\r\n\r\n\tdrill(r,c){\r\n\t\tconst i3=this.tris;\r\n\t\tconst n3=this.tris.length/3;\r\n\t\tconst i4=this.quads;\r\n\t\tconst n4=this.quads.length/4;\r\n\t\tconst e={};\r\n\t\tfor(let i=0;i<n3;i++){\r\n\t\t\tconst v=[i3[i*3+0],i3[i*3+1],i3[i*3+2]];\r\n\t\t\taddEdge(e,v);\r\n\t\t}\r\n\t\tfor(let i=0;i<n4;i++){\r\n\t\t\tconst v=[i4[i*4+0],i4[i*4+1],i4[i*4+2],i4[i*4+3]];\r\n\t\t\taddEdge(e,v);\r\n\t\t}\r\n\t\tconst walls=[];\r\n\t\tfor(const v in e){\r\n\t\t\tif(e[v].length==2){\r\n\t\t\t\taddWall(walls,e[v][0],e[v][1]);\r\n\t\t\t}\r\n\t\t}\r\n\t\t// each wall point uses cross product of ajoining edges to drill r amount with color c\r\n\t\tfor(const w in walls){\r\n\t\t\tconst wall=walls[w];\r\n\t\t\tif(wall.begin!=wall.end){\r\n\t\t\t\tconsole.log(\"skipping unclosed hole\");\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tthis.extrudeEdge(wall.verts,r,c,true);\r\n\t\t}\r\n\t}\r\n\t\r\n\tbevil(r,c){\r\n\t\tconst verts=this.verts;\r\n\t\tconst i3=this.tris;\r\n\t\tconst n3=this.tris.length/3;\r\n\t\tconst i4=this.quads;\r\n\t\tconst n4=this.quads.length/4;\r\n\t\tconst _n=n3*3+n4*6;\t\t\r\n\t\tconst q=[];\r\n\t\tconst t=[];\r\n\t\tconst edges={};\r\n\t\tconst bev=[];\r\n\t\tconst caps=[];\r\n\t\tfor(let i=0;i<n3;i++){\r\n\t\t\tconst v=[i3[i*3+0],i3[i*3+1],i3[i*3+2]];\r\n\t\t\tconst ii=verts.length;\r\n\t\t\tconst _n=skimpPoly(verts,v,r,c);\r\n\t\t\tt.push([ii+0,ii+1,ii+2]);\r\n\t\t\tedges[key(v[0],v[1])]=[ii+0,ii+1];\r\n\t\t\tedges[key(v[1],v[2])]=[ii+1,ii+2];\r\n\t\t\tedges[key(v[2],v[0])]=[ii+2,ii+0];\r\n\t\t\tconst e0=edge(v[0],v[1]);\r\n\t\t\tconst e1=edge(v[1],v[2]);\r\n\t\t\tconst e2=edge(v[2],v[0]);\r\n\t\t\tbev[e0]=[ii+1,ii+0].concat(bev[e0]||[]);\r\n\t\t\tbev[e1]=[ii+2,ii+1].concat(bev[e1]||[]);\r\n\t\t\tbev[e2]=[ii+0,ii+2].concat(bev[e2]||[]);\r\n\t\t\tfor(let j=0;j<3;j++){\r\n\t\t\t\tcaps[v[j]]=[ii+j].concat(caps[v[j]]||[]);\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(let i=0;i<n4;i++){\r\n\t\t\tconst v=[i4[i*4+0],i4[i*4+1],i4[i*4+2],i4[i*4+3]];\r\n\t\t\tconst ii=verts.length;\r\n\t\t\tconst _n=skimpPoly(verts,v,r,c);\r\n\t\t\tq.push([ii+0,ii+1,ii+2,ii+3]);\r\n\t\t\tedges[key(v[0],v[1])]=[ii+0,ii+1];\r\n\t\t\tedges[key(v[1],v[2])]=[ii+1,ii+2];\r\n\t\t\tedges[key(v[2],v[3])]=[ii+2,ii+3];\r\n\t\t\tedges[key(v[3],v[0])]=[ii+3,ii+0];\r\n\t\t\tconst e0=edge(v[0],v[1]);\r\n\t\t\tconst e1=edge(v[1],v[2]);\r\n\t\t\tconst e2=edge(v[2],v[3]);\r\n\t\t\tconst e3=edge(v[3],v[0]);\r\n\t\t\tbev[e0]=[ii+1,ii+0].concat(bev[e0]||[]);\r\n\t\t\tbev[e1]=[ii+2,ii+1].concat(bev[e1]||[]);\r\n\t\t\tbev[e2]=[ii+3,ii+2].concat(bev[e2]||[]);\r\n\t\t\tbev[e3]=[ii+0,ii+3].concat(bev[e3]||[]);\t\t\t\r\n\t\t\tfor(let j=0;j<4;j++){\r\n\t\t\t\tcaps[v[j]]=[ii+j].concat(caps[v[j]]||[]);\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(const b in bev){\r\n\t\t\tconst verts=bev[b];\r\n\t\t\tswitch(verts.length){\r\n\t\t\t\tcase 4:\r\n\t\t\t\t\tq.push(verts);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tconsole.log(\"unexpected bevil verts length \"+verts.length)\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(const v in caps){\r\n\t\t\tconst verts=caps[v];\r\n\t\t\tconst v0=parseInt(v);\r\n\t\t\tswitch(verts.length){\r\n\t\t\t\tcase 3:{\r\n\t\t\t\t\tconst tri=this.flip(v0,verts[0],verts[1],verts[2]);\r\n\t\t\t\t\tt.push(tri);\r\n\t\t\t\t}break;\t\t\t\t\r\n\t\t\t\tdefault:{\r\n\t//\t\t\t\t\tthis.fillHole(t,verts);\r\n\t\t\t\t}break;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.tris=t.flat();\r\n\t\tthis.quads=q.flat();\r\n\t}\r\n\r\n\tflatten(){\r\n\t\tconst verts=this.verts;\r\n\t\tconst i3=this.tris;\r\n\t\tconst n3=this.tris.length/3;\r\n\t\tconst i4=this.quads;\r\n\t\tconst n4=this.quads.length/4;\r\n\t\tconst n=n3*3+n4*6;\r\n\t\tconst shorts=new Int16Array(n*8);\r\n\t\tlet ii=0;\r\n\t\tfor(let i=0;i<n3;i++){\r\n\t\t\tconst v=[verts[i3[i*3+0]],verts[i3[i*3+1]],verts[i3[i*3+2]]];\r\n\t\t\tconst t=CalculateNormal(v[0],v[1],v[2]);\r\n\t\t\tfor(let j=0;j<3;j++){\r\n\t\t\t\tshorts[ii+0]=v[j][0];\r\n\t\t\t\tshorts[ii+1]=v[j][1];\r\n\t\t\t\tshorts[ii+2]=v[j][2];\r\n\t\t\t\tshorts[ii+3]=v[j][3];\r\n\t\t\t\tshorts[ii+4]=One*t[0];\r\n\t\t\t\tshorts[ii+5]=One*t[1];\r\n\t\t\t\tshorts[ii+6]=One*t[2];\r\n\t\t\t\tshorts[ii+7]=One*t[3];\r\n\t\t\t\tii+=8;\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(let i=0;i<n4;i++){\r\n\t\t\tconst v=[verts[i4[i*4+0]],verts[i4[i*4+1]],verts[i4[i*4+2]],verts[i4[i*4+3]]];\r\n\t\t\tconst t=CalculateNormal(v[0],v[1],v[2]);\r\n\t\t\tfor(const j of [0,1,2,0,2,3]){\r\n\t\t\t\tshorts[ii+0]=v[j][0];\r\n\t\t\t\tshorts[ii+1]=v[j][1];\r\n\t\t\t\tshorts[ii+2]=v[j][2];\r\n\t\t\t\tshorts[ii+3]=v[j][3];\r\n\t\t\t\tshorts[ii+4]=One*t[0];\r\n\t\t\t\tshorts[ii+5]=One*t[1];\r\n\t\t\t\tshorts[ii+6]=One*t[2];\r\n\t\t\t\tshorts[ii+7]=One*t[3];\r\n\t\t\t\tii+=8;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn shorts;\r\n\t}\r\n\r\n\tedges(){\r\n\t\tconst e=[]\r\n\t\tconst tricount=this.tris.length;\r\n\t\tfor(let t=0;t<tricount;t+=3){\r\n\t\t\tconst v0=this.tris[t+0];\r\n\t\t\tconst v1=this.tris[t+1];\r\n\t\t\tconst v2=this.tris[t+2];\r\n\t\t\te.push([v0,v1,v1,v2,v2,v0]);\r\n\t\t}\r\n\t\tconst quadcount=this.quads.length;\r\n\t\tfor(let t=0;t<quadcount;t+=4){\r\n\t\t\tconst v0=this.quads[t+0];\r\n\t\t\tconst v1=this.quads[t+1];\r\n\t\t\tconst v2=this.quads[t+2];\r\n\t\t\tconst v3=this.quads[t+3];\r\n\t\t\te.push([v0,v1,v1,v2,v2,v3,v3,v0]);\r\n\t\t}\r\n\t\treturn e.flat();\r\n\t}\r\n\r\n\tdiv(v0,v1,r){\r\n\t\tconst key=(v0>v1)?hex6(v1)+hex6(v0):hex6(v0)+hex6(v1);\r\n\t\tconst divs=this.divs;\r\n\t\tif(!(key in divs)){\r\n\t\t\tdivs[key]=this.verts.length;\r\n\t\t\tconst p0=this.verts[v0];\r\n\t\t\tconst p1=this.verts[v1];\r\n\t\t\tconst x=p0[0]+p1[0];\r\n\t\t\tconst y=p0[1]+p1[1];\r\n\t\t\tconst z=p0[2]+p1[2];\r\n\t\t\tconst m=r?r/Math.sqrt(x*x+y*y+z*z):0.5;\r\n\t\t\tthis.verts.push([x*m,y*m,z*m,p0[3]||p1[3]]);\r\n\t\t}\r\n\t\treturn divs[key];\r\n\t}\r\n\r\n\tlinear(v0,v1,distance,normal,depth,c){\r\n\t\tconst d=distance;///length(v0,v1);\r\n\t\tconst x=(v0[0]+(v1[0]-v0[0])*d)+normal[0]*depth;\r\n\t\tconst y=(v0[1]+(v1[1]-v0[1])*d)+normal[1]*depth;\r\n\t\tconst z=(v0[2]+(v1[2]-v0[2])*d)+normal[2]*depth;\r\n\t\tconst v=this.verts.length;\r\n\t\tthis.verts.push([x,y,z,c]);\r\n\t\treturn v;\r\n\t}\r\n\r\n\textrudeEdge(edge,r,c,both){\r\n\t\tconst index=this.verts.length;\r\n\t\tconst n=edge.length-1;\r\n\t\tlet ii=n-1;\r\n\t\tconst a=[0,0,0];\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tconst i2=(i+1)%n;\r\n\t\t\tconst v0=edge[ii];\r\n\t\t\tconst v1=edge[i];\r\n\t\t\tconst v2=edge[i2];\r\n\t\t\tii=i;\r\n\t\t\tconst t=this.cross(v0,v1,v2);\r\n\t\t\tt=Normalize(t);\r\n\t\t\ta[0]+=t[0]/n;\r\n\t\t\ta[1]+=t[1]/n;\r\n\t\t\ta[2]+=t[2]/n;\r\n\t\t}\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tconst v1=edge[i];\r\n\t\t\tconst v=this.verts[v1];\r\n\t\t\tthis.verts.push([\r\n\t\t\t\tv[0]+r*a[0],\r\n\t\t\t\tv[1]+r*a[1],\r\n\t\t\t\tv[2]+r*a[2],\r\n\t\t\t\tc,0,0,0,0\r\n\t\t\t]);\r\n\t\t}\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tconst i2=(i+1)%n;\r\n\t\t\tif(r<0 || both){\r\n\t\t\t\tthis.quads=this.quads.concat([edge[i],edge[i2],index+i2,index+i]);\r\n\t\t\t}\r\n\t\t\tif(r>0 || both){\r\n\t\t\t\tthis.quads=this.quads.concat([edge[i2],edge[i],index+i,index+i2]);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\textrude(shape,c){\r\n\t\tconst e=[];\r\n\t\tconst q=[];\r\n\t\tconst n=this.tris.length;\r\n\t\tconst verts=this.verts;\r\n\t\tfor(let t=0;t<n;t+=3){\r\n\t\t\tconst v0=this.tris[t+0];\r\n\t\t\tconst v1=this.tris[t+1];\r\n\t\t\tconst v2=this.tris[t+2];\r\n\t\t\tconst s0=this.div(v0,v1);\r\n\t\t\tconst s1=this.div(v1,v2);\r\n\t\t\tconst s2=this.div(v2,v0);\r\n\t\t\tconst e0=this.div(s2,s0);\r\n\t\t\tconst e1=this.div(s0,s1);\r\n\t\t\tconst e2=this.div(s1,s2);\r\n\t\t\tconst vert0=verts[v0];\r\n\t\t\tconst vert1=verts[v1];\r\n\t\t\tconst vert2=verts[v2];\r\n\t\t\tconst normal=CalculateNormal(vert0,vert1,vert2);\r\n\t\t\tfor(const fd of shape){\r\n\t\t\t\tc=fd.color;\r\n\t\t\t\tconst f0=this.linear(vert0,verts[e0],fd.frac,normal,fd.depth,c);\r\n\t\t\t\tconst f1=this.linear(vert1,verts[e1],fd.frac,normal,fd.depth,c);\r\n\t\t\t\tconst f2=this.linear(vert2,verts[e2],fd.frac,normal,fd.depth,c);\r\n\t\t\t\tq.push([v0,v1,f1,f0]);\r\n\t\t\t\tq.push([v1,v2,f2,f1]);\r\n\t\t\t\tq.push([v2,v0,f0,f2]);\r\n\t\t\t\tv0=f0;\r\n\t\t\t\tv1=f1;\r\n\t\t\t\tv2=f2;\r\n\t\t\t}\r\n\t\t\te.push([v0,v1,v2]);\r\n\t\t}\r\n\t\tthis.tris=e.flat();\r\n\t\tthis.quads=q.flat();\r\n\t}\r\n\r\n\tdivide(r){\r\n\t\tconst e=[];\r\n\t\tconst n=this.tris.length;\r\n\t\tfor(let t=0;t<n;t+=3){\r\n\t\t\tconst v0=this.tris[t+0];\r\n\t\t\tconst v1=this.tris[t+1];\r\n\t\t\tconst v2=this.tris[t+2];\r\n\t\t\tconst s0=this.div(v0,v1,r);\r\n\t\t\tconst s1=this.div(v1,v2,r);\r\n\t\t\tconst s2=this.div(v2,v0,r);\r\n\t\t\te.push([v0,s0,s2]);\r\n\t\t\te.push([s2,s0,s1]);\r\n\t\t\te.push([v2,s2,s1]);\r\n\t\t\te.push([s1,s0,v1]);\r\n\t\t}\r\n\t\tthis.tris=e.flat();\r\n\t}\r\n}\r\n*/\r\n\r\nfunction _length(v0,v1){\r\n\tconst x=v1[0]-v0[0];\r\n\tconst y=v1[1]-v0[1];\r\n\tconst z=v1[2]-v0[2];\r\n\treturn Math.sqrt(x*x+y*y+z*z);\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_field.js\",\"length\":700,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_field.js\n// (c)2022 Simon Armstrong\n// All rights reserved\n\n// one per physics world\n// dynamic collection of terrain tiles\n\n//const _unicode = new TextEncoder();\n\nconst terrain=[];\n\n//let outgoing=[];\n//let connected=false;\n\nfunction testPost(){\n    const message=[{command:\"flora\",verts,indices}];\n    const transfer=[verts.buffer,indices.buffer];\n    postMessage(message,transfer);\n}\n\nonmessage = (message) => {\n\tconst commands=message.data;\n\tfor(const line of commands){\n//\t\tconsole.log(\"wire_field \",line);\n\t\tswitch(line.command){\n\t\t\tcase \"terrain\":\n\t\t\t\tonTerrain(line.topo,line.diff,line.ground);\n\t\t\t\tbreak;\n\t\t}\n\t}\n//\tconsole.log(\"wire_baker woke\",data.name);\n//\toutgoing.push(data);\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_drawsurface.js\",\"length\":11103,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_drawsurface.js\r\n// (c)2022 nitrologic@gmail.com\r\n// All rights reserved\r\n\r\nconst PI2=Math.PI*2;\r\n\r\nfunction FlatCube(w,d,h,c){\r\n\tconst v=[];\r\n\t// triple count for flat shading ,+0 +8 and +16\r\n\tfor(let i=0;i<3;i++){\r\n\t\tv.push([-w,d,-h,c]);\r\n\t\tv.push([w,d,-h,c]);\r\n\t\tv.push([w,d,h,c]);\r\n\t\tv.push([-w,d,h,c]);\r\n\r\n\t\tv.push([-w,-d,-h,c]);\r\n\t\tv.push([w,-d,-h,c]);\r\n\t\tv.push([w,-d,h,c]);\r\n\t\tv.push([-w,-d,h,c]);\r\n\t}\r\n\r\n\treturn new Surface(v,[],[\r\n\t\t0,1,2,3,\t\t\t\r\n\t\t1+8,0+8,4,5,\r\n\t\t2+8,1+16,5+8,6,\r\n\t\t3+8,2+16,6+8,7,\r\n\t\t0+16,3+16,7+8,4+8,\r\n\t\t7+16,6+16,5+16,4+16\r\n\t]);\r\n}\r\n\r\n\r\nfunction Cube(r,c){\r\n\tconst v=[];\r\n\tv.push([-r,-r,-r,c]);\r\n\tv.push([r,-r,-r,c]);\r\n\tv.push([r,-r,r,c]);\r\n\tv.push([-r,-r,r,c]);\r\n\tv.push([-r,r,-r,c]);\r\n\tv.push([r,r,-r,c]);\r\n\tv.push([r,r,r,c]);\r\n\tv.push([-r,r,r,c]);\r\n\treturn new Surface(v,[],[\r\n\t\t0,1,2,3,\t\t\t\r\n\t\t1,0,4,5,\r\n\t\t2,1,5,6,\r\n\t\t3,2,6,7,\r\n\t\t0,3,7,4,\r\n\t\t7,6,5,4\r\n\t]);\r\n}\r\n\r\nfunction Torus(n1,r1,n2,r2,c){\r\n\tconst v=[];\r\n\tconst t=[];\r\n\tlet ii=n1-1;\r\n\tfor (let i=0;i<n1;i++){\r\n\t\tconst th0=i*PI2/n1;\r\n\t\tconst tx=Math.cos(th0);\t\t\r\n\t\tconst ty=-Math.sin(th0);\r\n\t\tfor (let j=0;j<n2;j++){\t\t\r\n\t\t\tconst th1=j*PI2/n2;\r\n\t\t\tconst bx=Math.cos(th1);\r\n\t\t\tconst by=-Math.sin(th1);\r\n\t\t\tconst x=(r2*bx+r1)*tx;\r\n\t\t\tconst y=r2*by;\r\n\t\t\tconst z=(r2*bx+r1)*ty;\r\n\t\t\tv.push([x,y,z,c]);\r\n\t\t}\r\n\t\tlet jj=n2-1;\r\n\t\tfor (let j=0;j<n2;j++){\r\n\t\t\tconst v0=(i*n2+j);\r\n\t\t\tconst v1=(i*n2+jj);\r\n\t\t\tconst v2=(ii*n2+jj);\r\n\t\t\tconst v3=(ii*n2+j);\r\n\t\t\tt.push([v0,v1,v2]);\r\n\t\t\tt.push([v0,v2,v3]);\r\n\t\t\tjj=j;\r\n\t\t}\r\n\t\tii=i;\r\n\t}\r\n\tconst s=new Surface(v,t,[]);\r\n//\ts.divide();\r\n\treturn s;\r\n}\r\n\r\nfunction Wheel(r,x0,x1,cc){\r\n\tconst v=[];\r\n\tconst t=[];\r\n\tconst q=[];\r\n\tconst n=12;\r\n\tv.push([x0,0,0,cc[0]]);\r\n\tv.push([x1,0,0,cc[0]]);\r\n\tfor (let i=0;i<=n;i++){\r\n\t\tconst th=i*PI2/n;\r\n\t\tconst y=r*Math.cos(th);\t\t\r\n\t\tconst z=-r*Math.sin(th);\r\n\t\tfor(let j=0;j<2;j++){\r\n\t\t\tv.push([x0,y,z,cc[j]]);\r\n\t\t\tv.push([x1,y,z,cc[j]]);\r\n\t\t}\r\n\t\tif(i>0){\r\n\t\t\tconst o=2+(i-1)*4;\r\n\t\t\tt.push([0,o+0,o+4]);\r\n\t\t\tt.push([1,o+5,o+1]);\r\n\t\t\tq.push([o+3,o+2,o+6,o+7]);\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,t,q);\r\n}\r\n\r\nfunction Tube(l,r,cc){\r\n\tconst s=Wheel(r,0,l,cc);\r\n\ts.flipAxis(0,2);\r\n\treturn s;\r\n}\r\n\r\n\r\nfunction Cylinder(p0,p1,r,c){\r\n\tconst v=[];\r\n\tconst tris=[];\r\n\tconst quads=[];\r\n\r\n\tconst x=p0[0];\r\n\tconst y=p0[1];\r\n\tconst z=p0[2];\r\n\r\n\tconst x1=p1[0];\r\n\tconst y1=p1[1];\r\n\tconst z1=p1[2];\r\n\r\n\tconst dx=x1-x;\r\n\tconst dy=y1-y;\r\n\tconst dz=z1-z;\r\n\r\n\tconst l=Math.sqrt(dx*dx+dy*dy+dz*dz);\r\n\r\n\tconst d=[dx/l,dy/l,dz/l];\r\n\tconst s=[-dy/l,dz/l,dx/l];\r\n\r\n\tconst t=[s[1]*d[2]-s[2]*d[1],s[2]*d[0]-s[0]*d[2],s[0]*d[1]-s[1]*d[0]];\r\n\r\n\tconst n=10;\r\n\r\n\tfor (let i=0;i<=n;i++){\r\n\t\tconst th=2*i*Math.PI/n;\r\n\t\tconst tx=-r*Math.sin(th);\r\n\t\tconst ty=r*Math.cos(th);\r\n\r\n\t\tconst rx=tx*s[0]+ty*t[0];\r\n\t\tconst ry=tx*s[1]+ty*t[1];\r\n\t\tconst rz=tx*s[2]+ty*t[2];\r\n\r\n\t\tv.push([x+rx,y+ry,z+rz,c]);\r\n\t\tv.push([x1+rx,y1+ry,z1+rz,c]);\r\n\r\n\t\tif(i<n){\r\n\t\t\tconst o=i*2;\r\n\t\t\tquads.push([o+0,o+1,o+3,o+2]);\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,tris,quads);\r\n}\r\n\r\n// todo plot cylinder p0,p1 with radius r\r\n\r\nfunction Segment(p0,p1,r,c){\r\n\tconst v=[];\r\n\tconst t=[];\r\n\tconst q=[];\r\n\r\n\tconst n1=32;\r\n\tconst n2=6;\r\n\r\n\tconst x=p0[0];\r\n\tconst y=p0[1];\r\n\tconst z=p0[2];\r\n\tconst dx=p1[0]-x;\r\n\tconst dy=p1[1]-y;\r\n\tconst dz=p1[2]-z;\r\n\tconst l=Math.sqrt(dx*dx+dy*dy+dz*dz);\r\n\r\n\tfor (let i=0;i<=n1;i++){\r\n\r\n\t\tconst t=i/(l+n1);\r\n\r\n\t\tconst x0=x+dx*t;\r\n\t\tconst y0=y+dy*t;\r\n\t\tconst z0=z+dz*t;\r\n\t\t\r\n/*\t\t\r\n\t\tp0[0]+(p1[0]-p0[0])*i/n;\r\n\t\tconst y0=p0[1]+(p1[1]-p0[1])*i/n;\r\n\t\tconst z0=p0[2]+(p1[2]-p0[2])*i/n;\r\n\r\n\t\tfor(let j=0;j<n2;j++){\r\n\t\t\tconst th0=j*PI2/n2;\r\n\t\t\tconst tx=Math.cos(th0);\t\t\r\n\t\t\tconst ty=-Math.sin(th0);\r\n\t\t\t// radial spoke at tangent\r\n\t\t\tv.push([x+rx,y+ry,z+rz,c]);\r\n\t\t}\r\n\r\n\t\tif(i>0){\r\n\t\t\tconst o=2+(i-1)*4;\r\n\t\t\tq.push([o+3,o+2,o+6,o+7]);\r\n\t\t}\r\n*/\t\r\n\t}\r\n\treturn new Surface(v,t,q);\r\n\r\n}\r\n\r\nfunction Tear(length,width,thick,cc){\r\n\tconst v=[];\r\n\tconst q=[];\r\n\tconst n=12;\r\n\tlet v0=0;\r\n\tfor (let i=0;i<=n;i++){\r\n\t\tconst x=i/n;\r\n\t\tconst dx=Math.abs(x*x*x*x-x*x*x);\r\n\t\tconst mx=x*length;\r\n\t\tconst my=Math.sqrt(dx)*width;\r\n\t\tconst o=v.length;\r\n\t\tfor(let j=0;j<2;j++){\r\n\t\t\tv.push([thick,-my,mx,cc[j]]);\r\n\t\t\tv.push([-thick,-my,mx,cc[j]]);\r\n\t\t\tv.push([-thick,my,mx,cc[j]]);\r\n\t\t\tv.push([thick,my,mx,cc[j]]);\r\n\t\t}\r\n\t\tif(i>0){\r\n\t\t\tfor(let j=0;j<4;j++){\r\n\t\t\t\tconst oo=o+((j&1)*4);\r\n\t\t\t\tconst j1=(j+1)&3;\r\n\t\t\t\tq.push(oo-8+j);\r\n\t\t\t\tq.push(oo-8+j1);\r\n\t\t\t\tq.push(oo+j1);\r\n\t\t\t\tq.push(oo+j);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tconst wing=new Surface(v,[],q);\r\n\treturn wing;\r\n}\r\n\r\n// Icosahedron with single poles shared\r\n\r\nfunction Sphere(r,order,c){\r\n\tconst rx=r*Math.sin(Math.PI/3);\r\n\tconst ry=r*Math.cos(Math.PI/3);\r\n\tconst v=[];\r\n\tv.push([0,r,0,c]);\r\n\tfor (let i=0;i<5;i++){\r\n\t\tconst th=(i*2+0.5)*Math.PI/5;\r\n\t\tconst cx=rx*Math.sin(th);\r\n\t\tconst cy=rx*Math.cos(th);\r\n\t\tv.push([cx,ry,cy,c]);\r\n\t}\r\n\tfor (let i=0;i<5;i++){\r\n\t\tconst th=(i*2-0.5)*Math.PI/5;\r\n\t\tconst cx=rx*Math.sin(th);\r\n\t\tconst cy=rx*Math.cos(th);\r\n\t\tv.push([cx,-ry,cy,c]);\r\n\t}\r\n\tv.push([0,-r,0,c]);\r\n\tconst t=new Surface(v,[\r\n\t\t0,1,2,\r\n\t\t0,2,3,\r\n\t\t0,3,4,\r\n\t\t0,4,5,\r\n\t\t0,5,1,\r\n\t\t1,6,7,\r\n\t\t1,7,2,\r\n\t\t2,7,8,\r\n\t\t2,8,3,\r\n\t\t3,8,9,\r\n\t\t3,9,4,\r\n\t\t4,9,10,\r\n\t\t4,10,5,\r\n\t\t5,10,6,\r\n\t\t5,6,1,\r\n\t\t11,7,6,\r\n\t\t11,8,7,\r\n\t\t11,9,8,\r\n\t\t11,10,9,\r\n\t\t11,6,10\r\n\t],[]);\r\n\twhile(order--){\r\n//\t\tt.divide(0);\r\n\t\tt.divide(r);\r\n\t}\r\n\treturn t;\r\n}\r\n\r\n/*\r\n\r\nclass draw{\t\r\n\r\n\tconstructor(){\r\n\t\tthis.segs=[];\r\n\t\tthis.verts=[];\r\n\t\tthis.indices=[];\r\n\t}\r\n\r\n\tflushTris(){\r\n\t\tconst verts=this.verts.flat();\t\t\r\n\t\tconst indices=this.indices.flat();\r\n\t\tthis.verts=[];\r\n\t\tthis.indices=[];\r\n\t\treturn {verts,indices};\r\n\t}\r\n\r\n\tflushSegs(){\r\n\t\tconst result=this.segs.flat();\r\n\t\tthis.segs=[];\r\n\t\treturn result;\r\n\t}\r\n\r\n\tswizzle(count,a,b){\r\n\t\tconst n=this.segs.length;\r\n\t\tconst i=n-count*4;\r\n\t\twhile(i<n){\r\n\t\t\tconst t=this.segs[i+a];\r\n\t\t\tthis.segs[i+a]=segs[i+b];\r\n\t\t\tthis.segs[i+b]=t;\r\n\t\t\ti+=4;\r\n\t\t}\r\n\t}\r\n\t\r\n\tdrawSegs(v3,ii){\r\n\t\tfor(let i=0;i<ii.length;i+=2){\r\n\t\t\tconst v0=v3[ii[i+0]];\r\n\t\t\tconst v1=v3[ii[i+1]];\r\n\t\t\tthis.segs.push(v0[0],v0[1],v0[2],v0[3]);\r\n\t\t\tthis.segs.push(v1[0],v1[1],v1[2],v1[3]);\r\n\t\t}\r\n\t}\r\n\r\n\tdrawColorSegs(v3,ii,c){\r\n\t\tfor(let i=0;i<ii.length;i+=2){\r\n\t\t\tconst v0=v3[ii[i+0]];\r\n\t\t\tconst v1=v3[ii[i+1]];\r\n\t\t\tthis.segs.push(v0[0],v0[1],v0[2],c);\r\n\t\t\tthis.segs.push(v1[0],v1[1],v1[2],c);\r\n\t\t}\r\n\t}\r\n\t\r\n\tgrid(step,count,c){\r\n\t\tconst segs=this.segs;\r\n\t\tconst r=count*step;\r\n\t\tfor(let i=-count;i<=count;i++){\r\n\t\t\tconst s=step*i;\r\n\t\t\tsegs.push([-r,s,0,c, r,s,0,c]);\r\n\t\t\tsegs.push([s,-r,0,c, s,r,0,c]);\r\n\t\t}\r\n\t}\r\n\r\n\tprint(text,c){\r\n\t\tlet cx=4;\r\n\t\tlet cy=2;\r\n\t\tfor(const index in text){\r\n\t\t\tconst char=text[index];\r\n\t\t\tif(char in IncittiFont){\r\n\t\t\t\tif(char==10){\r\n\t\t\t\t\tcx=4;\r\n\t\t\t\t\tcy+=20;\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\tconst shape=IncittiFont[char];\r\n\t\t\t\tconst n=shape[0];\r\n\t\t\t\tfor(let i=0;i<n*4;i+=2) {\r\n\t\t\t\t\tthis.segs.push([cx+shape[1+i],cy+shape[2+i],0,c]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tcx+=7;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n// deno-lint-ignore no-dupe-keys\r\nconst IncittiFont={\r\n\t\"a\":[5,0,2,4,2,4,2,4,6,4,6,0,6,0,6,0,3,0,3,4,3],\r\n\t\"b\":[4,0,0,0,6,0,6,4,6,4,6,4,2,4,2,0,2],\r\n\t\"c\":[3,0,2,0,6,0,6,4,6,0,2,4,2],\r\n\t\"d\":[4,4,0,4,6,4,6,0,6,0,6,0,2,0,2,4,2],\r\n\t\"e\":[5,4,6,0,6,0,6,0,2,0,2,4,2,4,2,4,3,4,3,1,3],\r\n\t\"f\":[3,4,0,2,0,2,0,2,6,1,2,3,2],\r\n\t\"g\":[5,0,7,4,7,4,7,4,2,4,2,0,2,0,2,0,6,0,6,4,6],\r\n\t\"h\":[3,0,0,0,6,0,2,4,2,4,2,4,6],\r\n\t\"i\":[2,2,2,2,6,2,1,2,0],\r\n\t\"j\":[4,3,1,3,1,3,2,3,7,3,7,0,7,0,7,0,5],\r\n\t\"k\":[3,0,0,0,6,0,4,3,2,0,4,3,6],\r\n\t\"l\":[1,2,0,2,6],\r\n\t\"m\":[4,0,6,0,2,0,2,4,2,2,2,2,4,4,2,4,6],\r\n\t\"n\":[4,0,2,0,6,0,3,1,2,1,2,4,2,4,2,4,6],\r\n\t\"o\":[4,0,2,0,6,0,6,4,6,4,6,4,2,4,2,0,2],\r\n\t\"p\":[4,0,2,0,7,0,2,4,2,0,6,4,6,4,2,4,6],\r\n\t\"q\":[4,0,2,0,6,0,6,4,6,4,2,4,7,0,2,4,2],\r\n\t\"r\":[3,0,2,0,6,0,3,1,2,1,2,4,2],\r\n\t\"s\":[5,4,2,0,2,0,2,0,4,0,4,4,4,4,4,4,6,4,6,0,6],\r\n\t\"t\":[2,0,2,4,2,2,0,2,6],\r\n\t\"u\":[3,0,2,0,6,0,6,4,6,4,6,4,2],\r\n\t\"v\":[2,0,2,2,6,2,6,4,2],\r\n\t\"w\":[4,0,2,1,6,1,6,2,4,2,4,3,6,3,6,4,2],\r\n\t\"x\":[2,0,2,4,6,0,6,4,2],\r\n\t\"y\":[2,0,2,2,5,4,2,1,