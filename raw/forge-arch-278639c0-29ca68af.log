evel(dir){\r\n\t\tlet zoom=this.zoom;\r\n\t\tvar level;\r\n\t\tif(dir>0){\r\n\t\t\tif(this.layerlevel<5){\r\n\t\t\t\tzoom/=8;\r\n\t\t\t\tthis.homex=(this.layerx/8.0)|0;\r\n\t\t\t\tthis.homey=(this.layery/8.0)|0;\r\n\t\t\t\tlevel=this.layerlevel+1;\r\n\t\t\t}else{\r\n\t\t\t\treturn;\r\n\t\t\t\tconst m=8*8*8;\r\n\t\t\t\tzoom*=m;\r\n\t\t\t\tthis.homex=this.layerx*m;\r\n\t\t\t\tthis.homey=this.layery*m;\r\n\t\t\t\tlevel=1;\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\tif(this.layerlevel>1){\r\n//\t\t\t\tzoom*=8;\r\n\t\t\t\tthis.homex=this.layerx*8.0;\r\n\t\t\t\tthis.homey=this.layery*8.0;\r\n\t\t\t\tlevel=this.layerlevel-1;\r\n\t\t\t}else{\r\n\t\t\t\treturn;\r\n\t\t\t\tconst m=8*8*8;\r\n\t\t\t\tzoom/=m;\r\n\t\t\t\tthis.homex=this.layerx/m;\r\n\t\t\t\tthis.homey=this.layerm/m;\r\n\t\t\t\tlevel=5;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.home();\r\n\t\tthis.modifyTileLayer(level);\r\n\t\treturn zoom;\r\n\t}\r\n\r\n\tjogDolly(x,y){\r\n//\t\tthis.drag(x*20,-y*20);\r\n\t\tconst d=Math.sqrt(x*x+y*y);\r\n\t\tthis.accelerate(d*x*4,-d*y*4);\r\n\t}\r\n\r\n\tjogHeading(spin){\r\n\t\tthis.speed[3]+=spin;\r\n\t}\r\n\r\n\tjogZoom(deltaZoom){\r\n\t\tthis.speed[2]+=0.2*deltaZoom;\r\n\t}\r\n\r\n\taddZoom(deltaZoom){\r\n\t\tlet zoom=this.zoom + deltaZoom;\r\n\t\tif(zoom>MaxZoom) {\r\n\t\t\tzoom=MaxZoom;\r\n//\t\t\tzoom=this.jogLevel(zoom,1);\r\n\t\t}\r\n\t\tif(zoom<MinZoom) {\r\n\t\t\tzoom=MinZoom;\r\n//\t\t\tzoom=this.jogLevel(zoom,-1);\r\n\t\t}\r\n\t\tthis.zoom=zoom;\r\n\t\tthis.dirty=true;\r\n\t}\r\n\r\n\taccelerate(dx,dy){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tdy*=tiltscale;\r\n\t\tconst scale=0.24;//this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.speed[0]+=scale*(dx*cos-dy*sin);\r\n\t\tthis.speed[1]+=scale*(dx*sin+dy*cos);\r\n\t}\r\n\r\n\tdrag(dx,dy){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tdy*=tiltscale;\r\n\t\tconst scale=this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.layerx+=scale*(dx*cos-dy*sin);\r\n\t\tthis.layery+=scale*(dx*sin+dy*cos);\r\n\t}\r\n\r\n\tclick(){\r\n\t\tswitch(this.cursorType){\r\n\t\t\tcase 2:\r\n\t\t\t\tconsole.log(\"create 2\");\r\n\t\t\t\tbreak;\r\n\r\n\t\t}\r\n\t}\r\n\tfling(vx,vy,force){\r\n\t\tconst tiltscale=1.0+this.tilt*0.2;\r\n\t\tvy*=tiltscale;\r\n\t\tconst scale=0.5*this.zoom/100;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\t\tconst sin=Math.sin(rot);\r\n\t\tconst cos=Math.cos(rot);\r\n\t\tthis.speed[0]+=force*scale*(vx*cos-vy*sin);\r\n\t\tthis.speed[1]+=force*scale*(vx*sin+vy*cos);\r\n\t}\r\n\r\n\trefreshGraphics(){\r\n\t\tif(this.graphics){\r\n\t\t\tconst scale=100/this.zoom;\r\n\r\n\t\t\tconst rot=this.heading*Math.PI/32768;\r\n\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\r\n\t\t\tconst vx=this.layerx-this.homex;\r\n\t\t\tconst vy=this.layery-this.homey;\r\n\r\n\t\t\tconst level=this.layerlevel;\r\n\r\n\t\t\t// simon come here and modifiy for level\r\n\r\n\t\t\tconst hshift=1<<(level*3);\r\n\t\t\tconst hfac=0.77/hshift;\r\n\r\n\t\t\tconst view0=this.viewPanel.view0;\r\n\t\t\tview0.isoView(vx,vy,scale,rot,this.tilt,this.altitude,hfac);\r\n\t\t\tview0.refreshView(w,h);\r\n\r\n\t\t\tthis.graphics.render();\r\n\t\t}\r\n\t}\r\n\r\n\tscreenPick(topo,sx,sy){\r\n\t\tconst scale=0.1*this.zoom;\r\n\t\tconst rot=this.heading*Math.PI/32768;\r\n\r\n\t\tconst sin=Math.sin(-rot);\r\n\t\tconst cos=Math.cos(-rot);\r\n\r\n\t\tconst w=this.canvas.width;\r\n\t\tconst h=this.canvas.height;\r\n\r\n\t\tconst x=(sx-w/2)*scale;\r\n\t\tconst y=(sy-h/2)*scale;\r\n\r\n\t\tconst rx=sin*y+cos*x;\r\n\t\tconst ry=cos*y-sin*x;\r\n\r\n\t\tconst mapx=this.layerx+rx;\r\n\t\tconst mapy=this.layery+ry;\r\n\r\n\t\tconst g=topo?topo.pick(mapx,mapy):0;\r\n\r\n\t\tconst ox=mapx-this.homex;\r\n\t\tconst oy=mapy-this.homey;\r\n\r\n\t\tconst oz=g;//0x1a0+g;\r\n\r\n\t\treturn [ox,oy,oz];\r\n\t}\r\n\r\n\trefreshCursor(){\r\n\t\tconst balls=this.cursorshape;\r\n\t\t// simon come here and fix level\r\n\t\tconst topo=this.topoTiles[1];\r\n\t\tif(balls){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tconst n=balls.count;\r\n\t\t\tconst posrot=balls.posrot32;\r\n\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\tconst xyz=this.screenPick(topo,w/2,h/2+(i-5)*10);\r\n\t\t\t\tposrot[i*8+0]=xyz[0];//Math.random()*20-10;\r\n\t\t\t\tposrot[i*8+1]=xyz[1];\r\n\t\t\t\tposrot[i*8+2]=xyz[2];\r\n\t\t\t\tposrot[i*8+3]=65536*0;\r\n\t\t\t\tposrot[i*8+4]+=16;\r\n\t\t\t\tposrot[i*8+5]+=32;\r\n\t\t\t\tposrot[i*8+6]+=48;\r\n//\t\t\t\tballs.position(i,xyz[0],xyz[1],xyz[2]);\r\n\t\t\t}\r\n\t\t\tballs.useShape();\r\n\t\t\tballs.writePosRot();\r\n\t\t}\r\n\t}\r\n\r\n\trefreshCursor2(){\r\n\t\tconst scale=100/this.zoom;\r\n\t\tconst ww=this.cursorWidth*scale/2;\r\n\t\tconst hh=this.cursorHeight*scale/2;\r\n\t\tconst context=this.context;\r\n\t\tif(context){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tcontext.fillStyle=CursorStyle;\r\n\t\t\tcontext.resetTransform();\r\n\t\t\tswitch(this.cursorType){\r\n\t\t\t\tcase 1:\r\n\t\t\t\t\tcontext.fillRect(w/2,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 2:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(w/2+ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tcontext.fillRect(0,h/2+hh,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 3:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tfor(let i=0;i<16;i++){\r\n\t\t\t\t\t\tcontext.fillRect(w/2+ww*i,0,1,h);\r\n\t\t\t\t\t\tcontext.fillRect(0,h/2+hh*i,w,1);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// decrements this.frameElapsed in 18ms counts\r\n\t// ticks gamepads and apply drag to speed\r\n\t// if detect idle from max speed then snapshot address\r\n\r\n\trefreshGrid(){\r\n\t\tlet dirtygrid=this.dirty;\r\n\t\tthis.dirty=false;\r\n\r\n\t\tconst drag=this.mousedown?0.5:0.94;\r\n\t\tconst drag2=0.88;\r\n//\t\tconst drag=this.mousedown?0.5:0.95;\r\n//\t\tdirtygrid=true;\r\n\r\n\t\tlet frames=(((this.frameElapsed/6)|0)*2)||1;\r\n\t\tthis.frameElapsed=0;\r\n\r\n\t\tframes=1;\r\n\r\n\t\twhile(frames--){\r\n\r\n\t\t\tthis.layerx+=this.speed[0];\r\n\t\t\tthis.layery+=this.speed[1];\r\n\r\n\t\t\tthis.addZoom(this.speed[2]);\r\n\t\t\tthis.heading+=this.speed[3];\r\n\r\n\t\t\tthis.tickGamepads();\r\n\r\n\t\t\tthis.speed[0]*=drag;\r\n\t\t\tthis.speed[1]*=drag;\r\n\t\t\tthis.speed[2]*=drag2;\r\n\t\t\tthis.speed[3]*=drag2;\r\n\r\n\t\t\tconst max=VectorLengthSquared(this.speed);\r\n\t\t\tif(max<0.1){\r\n\t\t\t\tif(!this.idle){\r\n\t\t\t\t\tthis.idle=true;\r\n\t\t\t\t\t// ON IDLE snapeshot location in history state\r\n\t\t\t\t\tconst app=AppEditor;\r\n\t\t\t\t\tconst location=app.getLocation();\r\n\t\t\t\t\tif(location){\r\n\t\t\t\t\t\tconst locationHash=\"#\"+JSON.stringify(location);\r\n\t\t\t\t\t\thistory.replaceState(null, null, locationHash);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tthis.idle=false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\thome(){\r\n\t\tthis.layerx=this.homex;\r\n\t\tthis.layery=this.homey;\r\n\t}\r\n\r\n\ttoggleFullscreen2(){\r\n\t\tif(this.fullscreen){\r\n\t\t\tdocument.webkitExitFullscreen();\r\n\t\t\tthis.fullscreen=false;\r\n\t\t}else{\r\n\t\t\tconst element=AppMedia;\r\n\t\t\telement.webkitEnterFullScreen();\r\n\t\t\tthis.fullscreen=true;\r\n\t\t}\r\n\t}\r\n\r\n\ttoggleFullscreen(){\r\n//\t\tvar element=this.body;\r\n\t\tconst element=document.body;\r\n\t\tif(document.exitFullscreen){\r\n\t\t\tif(this.fullscreen){\r\n\t\t\t\tdocument.exitFullscreen();\r\n\t\t\t\tthis.fullscreen=false;\r\n\t\t\t}else{\r\n\t\t\t\t// on promise...\r\n\t\t\t\telement.requestFullscreen();\r\n\t\t\t\tthis.fullscreen=true;\r\n\t\t\t}\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tif(element.webkitEnterFullScreen){\r\n\t\t\t\treturn toggleFullscreen2();\r\n\t\t\t}else{\r\n\t\t\t\twindow.notify(\"html fullscreen support not detected\");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\nfunction IgnoreContextMenu(pointerevent){\r\n\tpointerevent.preventDefault();\r\n\treturn false;\r\n}\r\n\r\nfunction SwitchAerial(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipAerial(on);\r\n}\r\nfunction SwitchHeight(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipHeight(on);\r\n}\r\nfunction SwitchOverlay(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipOverlay(on);\r\n}\r\nfunction SwitchRes(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipRes();\r\n}\r\n\r\n//function SetLevel(click,state){\r\n//\tAppEditor.flipLevel(state);\r\n//}\r\nfunction SwitchMode(click){\r\n\tAppEditor.flipMode()\r\n}\r\nfunction SwitchTilt(click){\r\n\tAppEditor.toggleTilt();\r\n}\r\n\r\nfunction LogStats(click){\r\n\tAppEditor.logStats();\r\n}\r\n\r\nfunction SwitchGPS(click){\r\n\tAppEditor.toggleGPS();\r\n}\r\n\r\nfunction _deviceOrientation(o){\r\n\tif(!epoch){\r\n\t\tepoch=o.timestamp;\r\n\t}\r\n\tconst p=[o.absolute,o.alpha,o.beta,o.gamma];\r\n\tconst orientation={\r\n\t\to:p,\r\n\t\tts:o.timestamp-epoch\r\n\t}\r\n\tconst json=JSON.stringify(orientation);\r\n\tSetStatus(json);\r\n}\r\nlet JyroListener;\r\nfunction SwitchJyro(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tif(on){\r\n\t\tJyroListener=window.addEventListener(\"deviceorientation\",_deviceOrientation);\r\n\t}else{\r\n\t\twindow.removeEventListener(\"deviceorientation\",JyroListener);\r\n\t\tJyroListener=null;\r\n\t\tSetStatus(\"\");\r\n\t}\r\n}\r\n\r\nlet _PixelLoader=null;\r\nlet _MeshLoader=null;\r\n\r\nfunction loadWire(){\r\n\tfetchTiles();\r\n\tfetchGrid();\r\n}\r\n\r\nfunction fetchTiles(){\r\n\tconst url=\"json/tiles.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_tiles=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.onTiles(_tiles);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchTiles fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\nfunction fetchGrid(){\r\n\tconst url=\"json/grid.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_grid=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.loadGrid(_grid);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchGrid fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\n// !!! replaced with loadWire\r\nfunction launchWire(){\r\n//\teditor.buildTopo(_nz3);\r\n//\teditor.buildTopo(_w1);\r\n//\teditor.buildTopo(_ak1);\r\n//\teditor.home();\r\n//\tvideo.addEventListener(\"pause\",editor.pause.bind(editor));\r\n//\teditor.animate();\r\n}\r\n\r\n// body,[screen]\r\n\r\nfunction goWireLocation(gpn6){\r\n\tAppEditor.setLocation(gpn6);\r\n}\r\n\r\n// 2025-10-2 - video is now null and we need fullscreen\r\n\r\nfunction initWireGrid(body){\r\n//\tdocument.title=\"nitrologic wire grid\";\r\n\tAppPlatform=new DesktopPlatform();\r\n//\tAppPlatform=new MobilePlatform();\r\n//\tAppPlatform=new EmbeddedPlatform();\r\n\tconst agent = navigator.userAgentData||UnidentifiedAgent;\r\n\tconsole.log(\"wire agent : \" + JSON.stringify(agent));\r\n\r\n\tconst license=AK17_License.join(\"\\n\");\r\n\tconst title=\"[]\";\r\n\tbody.setAttribute(\"title\",title);\r\n\r\n\tconst screen=document.createElement(\"div\");\r\n\tscreen.className=\"wiregrid\";\t//was screen\r\n\r\n//\teditor.toggleFullscreen();\r\n\r\n\tbody.appendChild(screen);\r\n\r\n\tconst video=null;\r\n\t_PixelLoader=new PixelLoader();\r\n\t_MeshLoader=new MeshLoader();\r\n\r\n\t// todo: wire mode 0 not supported\r\n\tconst editor=new TopoEditor(screen,video,1);\r\n\r\n\tAppScreen=screen;\r\n\tAppEditor=editor;\r\n\r\n\tconst root=[];\r\n\r\n\tconst hit_grid=editor.hitKey.bind(editor);\r\n\tconst panel=new Panel(screen,hit_grid,root);\r\n\r\n\tAppPanel=panel;\r\n\r\n\teditor.animate();\r\n\tloadWire();\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker_baker.js\",\"length\":12132,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_baker.js\r\n\r\n// one per TopoTile\r\n\r\n// a worker thread for processing heightmaps for a topo tile\r\n\r\nconst FloraPen=20;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\nconst TopoNoLevel=-0x4000;\r\n\r\n//const _unicode = new TextEncoder();\r\n\r\nlet topoCount;\r\nconst heightmaps=[];\r\n\r\n//let outgoingBaker=[];\r\n//let connectedBaker=false;\r\n\r\nonmessage = (message) => {\r\n\tconst commands=message.data;\r\n\tfor(const line of commands){\r\n//\t\tconsole.log(\"wire_baker \",line);\r\n\t\tswitch(line.command){\r\n\t\t\tcase \"heightmap\":\r\n\t\t\t\tonHeightmap(line.array);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"bake\":\r\n\t\t\t\tonTopoCount(line.value);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"build\":\r\n\t\t\t\tonBuild(line.value);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n//\tconsole.log(\"wire_baker woke\",data.name);\r\n//\toutgoing.push(data);\r\n}\r\n\r\nfunction refresh(){\r\n\tif(topoCount==heightmaps.length){\r\n//\t\tdebugger;\r\n\t\tcreateTopo();\r\n\t}\r\n}\r\n\r\nfunction onHeightmap(rawbytes){\r\n\tif(rawbytes.length==0){\r\n//\t\treturn;\r\n\t}\r\n\theightmaps.push(rawbytes);\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildTopo(plan){\r\n\t\r\n}\r\n\r\nfunction onTopoCount(count){\r\n\ttopoCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildCount(count){\r\n\tbuildCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\nfunction createTopo(){\r\n\tconst bytes=heightmaps[0]||[];\r\n\tconst heightmap=AllocBumpmap(bytes);\r\n\theightmap.setBytes(bytes);\r\n\tconst n=heightmaps.length;\r\n\tfor(let i=1;i<n;i++){\r\n\t\tif(heightmaps[i].length==bytes.length){\r\n\t\t\theightmap.orBytes(heightmaps[i]);\r\n\t\t}\r\n\t\telse{\r\n//\t\t\theightmap.setBytes(heightmaps[i]);\r\n\t\t}\r\n\t}\r\n\r\n// simon come here and fix up flora\r\n//\theightmap.heal(n);\r\n\r\n//\theightmap.postFlora(1024,2,15,2);\r\n\theightmap.postFlora(512,4,15,2);\r\n//\theightmap.postFlora(256,8,FloraPen,22);\r\n//\theightmap.postFlora(128,16,0,22);\r\n\r\n\theightmap.post();\r\n\r\n\theightmaps.length=0;\r\n}\r\n\r\nclass Bumpmap{\r\n\tpost(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst diff=this.diff;\r\n\t\tconst ground=this.ground;\r\n\t\tconst message=[{command:\"bump\",topo,diff,ground}];\r\n\t\tconst transfer=[topo.buffer,diff.buffer,ground.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n// a worker method that replies with a \"flora\" message containing a surface for flora placement\r\n\r\n\tpostFlora(count,mag,c,floraMin){\r\n\t\tconst p=2048/count;\r\n\t\tconst res=count+1;\r\n\t\tconst a=new Array(res);\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\ta[y]=new Array(res);\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tlet h0=this.pickElevation(x*p,y*p);\r\n\t//\t\t\tlet h1=topo.pickHeight(x*p,y*p);\r\n\t\t\t\tconst m=this.pickHeightMinMax(x*p,y*p);\r\n\t\t\t\tif(m.min>floraMin){\r\n\t\t\t\t\tconst h1=m.max;\r\n\t\t\t\t\ta[y][x]=h0+h1;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst vverts=[];\r\n\t\tconst v=[];\r\n\t\tconst i=[];\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tconst mz=a[y][x];\r\n\t\t\t\tlet vert=-1;\r\n\t\t\t\tif(mz){\r\n\t\t\t\t\tconst mx=mag*x;\r\n\t\t\t\t\tconst my=-mag*y;\r\n\t\t\t\t\tvert=v.length;\r\n\t\t\t\t\tv.push([mx,my,mz,c, 0,0,0,0]);\r\n\t\t\t\t}\r\n\t\t\t\tvverts.push(vert);\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst d=count+1;\r\n\t\tfor(let y=0;y<count;y++){\r\n\t\t\tfor(let x=0;x<count;x++){\r\n\t\t\t\tconst v0=vverts[y*res+x];\r\n\t\t\t\tconst v1=vverts[y*res+x+1];\r\n\t\t\t\tconst v2=vverts[(y+1)*res+x+1];\r\n\t\t\t\tconst v3=vverts[(y+1)*res+x];\r\n\t\t\t\tif(v0>-1&&v1>-1&&v2>-1&&v3>-1){\r\n\t\t\t\t\ti.push([v0,v2,v1]);\r\n\t\t\t\t\ti.push([v0,v3,v2]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst verts=new Int32Array(v.flat());\r\n\t\tconst indices=new Int32Array(i.flat());\r\n\t\tconst message=[{command:\"flora\",verts,indices}];\r\n\t\tconst transfer=[verts.buffer,indices.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n\treset(res){\r\n\t\tthis.resolution=res;\t\t\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}else{\r\n\t\t\t\t\ttopo[i]=TopoNoLevel;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(srccount){\r\n\t\tlet count=0;\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tconst i=y*res+x;\r\n\t\t\t\tlet h=topo[i];\r\n\t\t\t\tif(h==0){\r\n\r\n//\t\t\t\t\ttopo[i]=SeaLevel-TopoLevel;\r\n\t\t\t\t\t// simon come here\r\n/*\r\n\t\t\t\t\tif(x>0&&topo[i-1]) h=topo[i-1];\r\n\t\t\t\t\tif(y>0&&topo[i-res]) h=topo[i-res];\r\n\t\t\t\t\tif(x<res-1&&topo[i+1]) h=topo[i+1];\r\n\t\t\t\t\tif(y<res-1&&topo[i+res]) h=topo[i+res];\r\n\t\t\t\t\ttopo[i]=h;\r\n*/\t\t\t\t\t\r\n\t\t\t\t\tcount++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(count){\r\n//\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\tprocess(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0) h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\n\r\n\r\n/*\r\n\r\nfunction heartbeat(){\r\n\tconst messages=outgoing;\r\n\toutgoing=[];\r\n\tif(connected){\r\n\t\tpost(\"tick\",messages);\r\n\t}\r\n}\r\n\r\nlet timer=setInterval(heartbeat,500);\r\n\r\nfunction post(name,body){\r\n\tevent={name:name,body:body};\r\n\tconst js=JSON.stringify(event);\r\n\tconst bytes=_unicode.encode(js);\r\n\tconst t0=new Date();\r\n\tfetch(\"/fetch\",{\r\n\t\tmethod:'POST',\r\n\t\theaders: {\r\n\t\t\t'Content-Type': 'application/json',\r\n\t\t\t'Content-Length': bytes.length\r\n\t\t},\r\n\t\tbody: bytes\r\n\t})\r\n\t.then(response => response.json())\r\n\t.then(data => {\r\n//\t\tconsole.log(data);\r\n\t\tconst t1=new Date();\r\n\t\tconst d=t1-t0;\r\n\t\tpostMessage({ping:d});\r\n\t});\t\t\r\n}\r\n\r\n*/\r\n\r\n\r\n// 0x4000 is new zero, count is typically 128, short index friendly\r\n\r\n// in which verticy sample is too steep skip edge\r\n\r\nfunction CreateTopoSurface(count,m,c,topo){\r\n\tconst a=new Array(count+1);\r\n\tconst p=2048/count;\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(count+1);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h=topo.pickTopo(x*p,y*p);\r\n\t\t\ta[y][x]=h;\r\n\t\t}\r\n\t}\r\n\t\r\n\tlet v=[];\r\n\tconst i=[];\r\n\r\n\tconst crack=[];\r\n\tconst max=[];\r\n\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mx=m*x;\r\n\t\t\tconst my=-m*y;\r\n\t\t\tconst ground=a[y][x].ground;\r\n\t\t\tconst minz=a[y][x].min;\r\n\t\t\tconst maxz=a[y][x].max;\r\n\t\t\tlet bits=0;\r\n\t\t\tif(ground==0 && maxz-minz>12){\r\n\t\t\t\tmax.push(crack.length);\r\n\t\t\t\tbits=1;\r\n\t\t\t\tcrack.push([mx,my,maxz,c, 0,0,0,bits]);\r\n\t\t\t}else{\r\n\t\t\t\tmax.push(-1);\r\n\t\t\t}\r\n\t\t\tconst z=ground||minz;\r\n\t\t\tv.push([mx,my,z,c, 0,0,0,bits]);\r\n\t\t}\r\n\t}\r\n\tconst crackOffset=v.length;\r\n\tv=v.concat(crack);\r\n\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=x+y*d;\r\n\t\t\tconst v1=x+1+y*d;\r\n\t\t\tconst v2=x+(y+1)*d;\r\n\t\t\tconst v3=x+1+(y+1)*d;\r\n\t\t\t\r\n\t\t\tconst b0=v[v0][7];\r\n\t\t\tconst b1=v[v1][7];\r\n\t\t\tconst b2=v[v2][7];\r\n\t\t\tconst b3=v[v3][7];\r\n\r\n\t\t\tif(!(b0|b1|b2|b3)){\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t\ti.push(v1);\r\n\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v2);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t}else{\r\n\t\t\t\tconst m0=max[v0]>=0?crackOffset+max[v0]:v0;\r\n\t\t\t\tconst m1=max[v1]>=0?crackOffset+max[v1]:v1;\r\n\t\t\t\tconst m2=max[v2]>=0?crackOffset+max[v2]:v2;\r\n\t\t\t\tconst m3=max[v3]>=0?crackOffset+max[v3]:v3;\r\n\r\n\t\t\t\tif(b0||b3||b1){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\t\t\t\tif(b0||b2||b3){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b1||b0){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b3||b1){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n","name":"content"},{"role":"user","content":"Files shared. Feel free to comment if content is new or different.","name":"friend"},{"role":"assistant","content":"Compared against the versions I used for the doc, two files changed. Here's what moved and what it means for the sprint.\n\n## `worker_baker.js`\n\nThe active flora call changed and `FloraPen` is now dead:\n\n```js\nconst FloraPen=20;\t// retained, but no longer referenced\n...\n//\theightmap.postFlora(256,8,FloraPen,22);\n\theightmap.postFlora(512,4,15,2);\n```\n\nThree effects:\n\n- **The doc's snippets in §3 and §9 are stale.** They quote `postFlora(256,8,FloraPen,22)`. The `createTopo` ordering (dig → flora → post) is unaffected, but the literal call needs updating so the doc doesn't mislead.\n- **`floraMin` dropped from 22 to 2.** `digTopo` zeroes `diff`, so a dug cell yields `m.min = 0`, which still fails `m.min > 2`. Exclusion still works — but the margin is now razor-thin. At `22` there was slack for a leaky border; at `2` any single non-zero `diff` sample inside the footprint keeps flora. The `border` halo becomes load-bearing, not cosmetic. This strengthens §16 open question 2 (separate flora clearance vs basement carve).\n- **`count` 256→512 doubles the flora grid.** 513² samples instead of 257². The worker dig now runs in front of a substantially heavier flora pass, which matters for §13/§14 — the dig cost is small, but it's serialised ahead of a bigger job on the same worker thread. Worth measuring before committing the estimate.\n\nColour is now hardcoded `15` (`G,B,G,A` — muted green, alpha 0.52), so the `FloraPen` prerequisite row in §12 should become \"unused constant; delete or re-point the active call at it.\"\n\n## `wire_grid.js`\n\n`bindKeyCodes` gained a live button:\n\n```js\n{name:\"L\",code:'L',title:\"LogStats\",handler:LogStats},\n{name:\"A\",code:'A',title:\"Aerial\",handler:SwitchAerial,state:true},\n```\n\nBoth are new relative to the doc's baseline, and one has a problem:\n\n- **`A` will throw on click.** `SwitchAerial` calls `AppEditor.flipAerial(on)`, but `flipAerial` is inside the commented-out block in `TopoEditor` (alongside `flipHeight`/`flipOverlay`). It's only safe because `Panel` doesn't auto-click `state:true` buttons — that call is commented out too. The moment someone presses A, it's a `TypeError`. Not dig-related, but it's live and the doc's baseline doesn't mention it.\n- **`LogStats` depends on a `log` global.** `TopoEditor.logStats()` calls `log(...)`, and `log` isn't defined in any of the shared wire files — it's a nitrojs-side global. If the L key is pressed on a page where that isn't loaded, it's a `ReferenceError`. Either way, `logStats` currently only prints a string, so it won't report anything about tiles yet.\n\n`BasementDepth` is still `4`, and `BasementBorder` still doesn't exist — both §12 rows stand.\n\n## What I'd change in the doc\n\n- §3, §9: update the flora call to `postFlora(512,4,15,2)`.\n- §12: `FloraPen` → unused; add a row for `floraMin=2` narrowing the exclusion margin; add the `A`/`flipAerial` and `log` items under a small \"pre-existing, touched by this sprint\" note.\n- §13 test 3: note the flora density makes visual diffing harder — the dug footprint will read as a bare patch in a sea of green, which is arguably a better test.\n- §14: add \"heavier flora pass serialised behind the dig\" to the risk table.\n\nWant me to fold these into `submission-6ab98dd7.md`, or hold until you've decided on the `border` fork in §16? The border decision changes §9 and §12 anyway, so updating twice may be wasted motion."},{"role":"user","content":"logstats should include tiles in cache, if there is active distinction, also memory stats for all the layers","name":"friend"},{"role":"assistant","content":"Yes — there's a distinction, but it's derived rather than stored, and one half of it leaks. That matters because a stats report built on the leaky half will show a number that only ever grows.\n\n## What \"active\" currently means\n\nThree separate notions exist, and they aren't the same set:\n\n```\n╭───────────────┬─────────────────────────────────────────────┬────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\n│  Notion       │  Where                                      │  Meaning                                                                                                       │\n├───────────────┼─────────────────────────────────────────────┼────────────────────────────────────────────────────────────────────────────────────────────────────────────────┤\n│  **Touched**  │  `TopoTile.frame` vs `TopoGrid.frameCount`  │  Set by `touchTiles` for tiles that are `fetched && ready`; `sweep` removes them once `frame < frameCount-20`  │\n│  **Meshed**   │  `GraphicsStack._activeTiles`               │  Pushed in `meshTile`; never removed                                                                           │\n│  **Cached**   │  `TopoGrid._tileGrid`                       │  Everything in the grid, whether touched or not                                                                │\n╰───────────────┴─────────────────────────────────────────────┴────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\n```\n\nSo \"active vs cached\" is `tile.frame >= frameCount-20` versus the rest of `_tileGrid`. That's computable. But two things are broken around it:\n\n- **`GraphicsStack.flushTile` never splices `_activeTiles`.** It removes the meshes from the layers and calls `tile.retire()`, but the tile stays in the array. That array grows for the lifetime of the session, so `_activeTiles.length` is a leak counter, not an active count.\n- **`sweep` skips tiles whose `frame` was never set.** The guard is `if(tile.frame && tile.frame<minFrame)`, and `undefined` is falsy, so a tile that was created by `tileGet` but never touched — a failed load, or one created via `TopoGrid.pick` — is never swept and is retained forever. Those are the real \"cached\" population.\n\nBoth are worth fixing before the number means anything.\n\n## Memory: what's reachable\n\nThe dominant cost is the heightmap, and it's fully reachable: `Bumpmap.topo/diff/ground` are `Uint16Array(res*res)`, so `3 * res² * 2` bytes per tile. At `res=1024` that's 6.3 MB per tile; a radius-5 view holds ~81 tiles, so ~500 MB. That dwarfs everything else.\n\nSurfaces and shapes are reachable too, except **GPU buffer sizes**, which are computed in `Shape.staticBuffer`/`instanceBuffer` and then discarded. Textures are counted in `SharedTextures` but without dimensions. Both need a little bookkeeping to report honestly.\n\n## Supporting edits\n\n**`wire_core.js` — retain GPU byte counts.**\n\n```js\n// Shape constructor\nthis.bufferBytes=0;\n```\n\n```js\nstaticBuffer(bufferType,array){\n\tconst gl=this.gl;\n\tconst bo=gl.createBuffer();\n\tgl.bindBuffer(bufferType,bo);\n\tgl.bufferData(bufferType,array,gl.STATIC_DRAW);\n\tthis.bufferBytes+=array.byteLength;\n\treturn bo;\n}\n```\n\n```js\ninstanceBuffer(shorts,instanceCount){\n\tthis.glCheck();\n\tconst bufferType=this.gl.ARRAY_BUFFER;\n\tconst gl=this.gl;\n\tconst shorts16=new Int16Array(shorts);\n\tconst bo=gl.createBuffer();\n\tconst byteCount=shorts16.byteLength+instanceCount*32;\n\tgl.bindBuffer(bufferType,bo);\n\tgl.bufferData(bufferType,byteCount,gl.DYNAMIC_DRAW);\n\tgl.bufferSubData(bufferType,0,shorts16);\n\tthis.glCheck();\n\tthis.bufferBytes+=byteCount;\n\treturn bo;\n}\n```\n\n```js\nflushBuffers(){\n\tthis.gl.deleteVertexArray(this.vao);\n\tthis.vao=null;\n\tthis.gl.deleteBuffer(this.vbo);\n\tthis.vbo=null;\n\tif(this.ibo){\n\t\tthis.gl.deleteBuffer(this.ibo);\n\t\tthis.ibo=null;\n\t}\n\tthis.bufferBytes=0;\n}\n```\n\n**`wire_core.js` — keep texture dimensions.**\n\n```js\nconst tc={src:image.src,texture:texture,count:1,w:image.width,h:image.height};\n```\n\n## `TopoGrid.stats()` — `wire_topo.js`\n\n```js\nstats(){\n\tconst frame=this.frameCount;\n\tconst minFrame=frame-20;\n\tconst grid=this._tileGrid;\n\tlet count=0;\n\tlet active=0;\n\tlet cached=0;\n\tlet orphan=0;\n\tlet fetched=0;\n\tlet ready=0;\n\tlet meshed=0;\n\tlet bytes=0;\n\tfor(const y in grid){\n\t\tconst row=grid[y];\n\t\tfor(const x in row){\n\t\t\tconst tile=row[x];\n\t\t\tcount++;\n\t\t\tif(tile.frame && tile.frame>=minFrame){\n\t\t\t\tactive++;\n\t\t\t}else{\n\t\t\t\tcached++;\n\t\t\t\tif(!tile.fetched) orphan++;\n\t\t\t}\n\t\t\tif(tile.fetched) fetched++;\n\t\t\tif(tile.ready) ready++;\n\t\t\tif(tile.tilemesh) meshed++;\n\t\t\tbytes+=tileBytes(tile);\n\t\t}\n\t}\n\treturn {level:this.gridlevel,count,active,cached,orphan,fetched,ready,meshed,bytes};\n}\n```\n\n## Stats helpers\n\nThese are free functions; put them in `wire_util.js` (already loaded everywhere) or a new `wire_stats.js` added to the script list.\n\n```js\nfunction heightmapBytes(heightmap){\n\tif(!heightmap) return 0;\n\tlet bytes=0;\n\tif(heightmap.topo) bytes+=heightmap.topo.byteLength;\n\tif(heightmap.diff) bytes+=heightmap.diff.byteLength;\n\tif(heightmap.ground) bytes+=heightmap.ground.byteLength;\n\treturn bytes;\n}\n\nfunction surfaceBytes(surface){\n\tif(!surface) return 0;\n\tlet bytes=0;\n\tif(surface.verts32) bytes+=surface.verts32.byteLength;\n\tif(surface.tris){\n\t\tconst index=surface.vertCount>65535?4:2;\n\t\tbytes+=surface.tris.length*index;\n\t}\n\treturn bytes;\n}\n\nfunction shapeBytes(shape){\n\tif(!shape) return 0;\n\tlet bytes=shape.bufferBytes||0;\n\tif(shape.posrotdim16) bytes+=shape.posrotdim16.byteLength;\n\tif(shape.transforms){\n\t\tfor(const t of shape.transforms){\n\t\t\tbytes+=t.byteLength;\n\t\t}\n\t}\n\treturn bytes;\n}\n\nfunction tileBytes(tile){\n\tlet bytes=heightmapBytes(tile.heightmap);\n\tbytes+=surfaceBytes(tile.topoSurface);\n\tbytes+=surfaceBytes(tile.floraSurface);\n\tbytes+=shapeBytes(tile.tilemesh);\n\tbytes+=shapeBytes(tile.floramesh);\n\tfor(const mesh of tile.staticmeesh) bytes+=shapeBytes(mesh);\n\tfor(const mesh of tile.flatmeesh) bytes+=shapeBytes(mesh);\n\treturn bytes;\n}\n\nconst LayerNames=[\"model\",\"static\",\"tile\",\"flat\",\"line\",\"point\",\"edge\"];\n\nfunction layerStats(graphicsLayer){\n\tconst layers=graphicsLayer.layers||[];\n\tconst out=[];\n\tlet index=0;\n\tfor(const layer of layers){\n\t\tlet shapes=0;\n\t\tlet bytes=0;\n\t\tfor(const shape of layer.shapes){\n\t\t\tshapes++;\n\t\t\tbytes+=shapeBytes(shape);\n\t\t}\n\t\tout.push({name:LayerNames[index]||(\"layer\"+index),tags:layer.tags,shapes,bytes});\n\t\tindex++;\n\t}\n\treturn out;\n}\n\nfunction textureStats(){\n\tlet count=0;\n\tlet bytes=0;\n\tfor(const src in SharedTextures){\n\t\tconst tc=SharedTextures[src];\n\t\tcount++;\n\t\tbytes+=(tc.w||0)*(tc.h||0)*4;\n\t}\n\treturn {count,bytes};\n}\n\nfunction megabytes(bytes){\n\treturn (bytes/1048576).toFixed(1);\n}\n```\n\n## `TopoEditor.logStats()` — `wire_grid.js`\n\n```js\nstats(){\n\tconst levels=[];\n\tlet tileTotal=0;\n\tlet tileBytes=0;\n\tif(this.topoTiles){\n\t\tfor(const level in this.topoTiles){\n\t\t\tconst grid=this.topoTiles[level];\n\t\t\tif(!grid) continue;\n\t\t\tconst s=grid.stats();\n\t\t\tlevels.push(s);\n\t\t\ttileTotal+=s.count;\n\t\t\ttileBytes+=s.bytes;\n\t\t}\n\t}\n\n\tconst layers=[];\n\tlet layerBytes=0;\n\tif(this.viewPanel){\n\t\tfor(const gl of this.viewPanel.graphicsLayers){\n\t\t\tconst list=layerStats(gl);\n\t\t\tfor(const l of list){\n\t\t\t\tlayers.push(l);\n\t\t\t\tlayerBytes+=l.bytes;\n\t\t\t}\n\t\t}\n\t}\n\n\tconst textures=textureStats();\n\n\treturn {\n\t\tlevel:this.layerlevel,\n\t\tactiveTiles:this.viewPanel?this.viewPanel._activeTiles.length:0,\n\t\ttiles:{total:tileTotal,levels},\n\t\tlayers,\n\t\ttextures,\n\t\tmemory:{\n\t\t\ttiles:tileBytes,\n\t\t\tlayers:layerBytes,\n\t\t\ttextures:textures.bytes,\n\t\t\ttotal:tileBytes+layerBytes+textures.bytes\n\t\t}\n\t};\n}\n\nlogStats(){\n\tconst stats=this.stats();\n\tconsole.log(formatStats(stats));\n\tlog(\"[TopoEditor] level \"+stats.level+\" tiles \"+stats.tiles.total+\" mem \"+megabytes(stats.memory.total)+\"MB\");\n\tSetStatus(\"tiles \"+stats.tiles.total+\" mem \"+megabytes(stats.memory.total)+\"MB\");\n}\n```\n\n```js\nfunction formatStats(stats){\n\tconst lines=[];\n\tlines.push(\"TopoEditor level \"+stats.level+\" activeTiles \"+stats.activeTiles);\n\tfor(const s of stats.tiles.levels){\n\t\tlines.push(\"  grid \"+s.level\n\t\t\t+\" tiles \"+s.count\n\t\t\t+\" active \"+s.active\n\t\t\t+\" cached \"+s.cached\n\t\t\t+\" orphan \"+s.orphan\n\t\t\t+\" fetched \"+s.fetched\n\t\t\t+\" ready \"+s.ready\n\t\t\t+\" meshed \"+s.meshed\n\t\t\t+\" \"+megabytes(s.bytes)+\"MB\");\n\t}\n\tlines.push(\"  tiles total \"+stats.tiles.total+\" \"+megabytes(stats.memory.tiles)+\"MB\");\n\tfor(const l of stats.layers){\n\t\tlines.push(\"  layer \"+l.name+\" shapes \"+l.shapes+\" \"+megabytes(l.bytes)+\"MB\");\n\t}\n\tlines.push(\"  textures \"+stats.textures.count+\" \"+megabytes(stats.textures.bytes)+\"MB\");\n\tlines.push(\"  memory total \"+megabytes(stats.memory.total)+\"MB\");\n\treturn lines.join(\"\\n\");\n}\n```\n\n## The two fixes the numbers depend on\n\n```js\n// wire_graphics.js — GraphicsStack.flushTile\nflushTile(tile){\n\tconst meesh=[tile.tilemesh,tile.floramesh,tile.staticmeesh,tile.flatmeesh].flat();\n\tfor(const mesh of meesh){\n\t\tif(mesh){\n\t\t\tconst layer0=this.graphicsLayers[0];\n\t\t\tlayer0.removeMesh(mesh);\n\t\t}\n\t}\n\tconst active=this._activeTiles;\n\tconst index=active.indexOf(tile);\n\tif(index>=0){\n\t\tactive.splice(index,1);\n\t}\n\ttile.flushMesh();\n\ttile.retire();\n}\n```\n\nWithout this, `activeTiles` in the report is meaningless. For the orphan set, the smallest safe change is to stamp `tile.frame=this.frameCount` in `tileGet` so newly created tiles fall inside the sweep window and are retired if nothing touches them — but check the fetch path first, since a slow tile could then be swept while loading and re-created next frame.\n\n## Caveats on the numbers\n\n- `orphan` is `cached` minus tiles that have at least been fetched, so it counts both failed loads and `pick`-created tiles. If it climbs steadily, that's the `tileGet` leak.\n- `surfaceBytes` uses `tris.length * (vertCount>65535?4:2)` — a close match to the GL index buffer, not the JS array's actual footprint.\n- `layerBytes` counts only what the `Shape` objects retain. Textures are counted globally in `textures`, so a shape's texture cost isn't double-counted but also isn't attributed to its layer.\n- `topoTiles` levels with no tiles report zero, so an empty level is silent rather than absent — worth showing, since it tells you the grid exists but hasn't fetched.\n\nWant this folded into the design doc as a section, or submitted as a patch against the three files?"},{"role":"user","content":"what a bunch of crud, 4 lines max that measures footprint of all tiles pls","name":"friend"},{"role":"assistant","content":"Fair. The heightmap dominates everything else, so this is the whole footprint in one line:\n\n```js\nfunction tilesMB(e){let b=0;for(const g in e.topoTiles)for(const y in e.topoTiles[g]._tileGrid)for(const x in e.topoTiles[g]._tileGrid[y]){const h=e.topoTiles[g]._tileGrid[y][x].heightmap;b+=h?h.topo.byteLength+h.diff.byteLength+h.ground.byteLength:0}return (b/1048576).toFixed(1);}\n```\n\nCall `tilesMB(AppEditor)` → MB across every cached tile, every level. Heightmap only; GPU buffers and textures excluded."},{"role":"user","content":"ok 20 lines properly spaced, no comments but more my style","name":"friend"},{"role":"assistant","content":"```js\nfunction TilesMegabytes(editor){\n\tconst grids=editor.topoTiles;\n\tif(!grids) return 0;\n\tlet bytes=0;\n\tfor(const level in grids){\n\t\tconst grid=grids[level]._tileGrid;\n\t\tfor(const y in grid){\n\t\t\tfor(const x in grid[y]){\n\t\t\t\tconst heightmap=grid[y][x].heightmap;\n\t\t\t\tif(heightmap){\n\t\t\t\t\tbytes+=heightmap.topo.byteLength;\n\t\t\t\t\tbytes+=heightmap.diff.byteLength;\n\t\t\t\t\tbytes+=heightmap.ground.byteLength;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\treturn (bytes/1048576).toFixed(1);\n}\n```\n\n`SetStatus(TilesMegabytes(AppEditor)+\" MB tiles\")`"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_grid.js\",\"length\":47124,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_grid.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n// onWire creates TopoEditor PixelLoader MeshLoader\r\n// used to govern max refreshGrid speed\r\n// PanelCanvas => Canvas\r\n\r\n\"use strict\"\r\n\r\n//const buttonControls=[\"A\",\"B\",\"X\",\"Y\",\"l\",\"r\",\"L\",\"R\"];\r\n//const axisControls=[\"LX\",\"LY\",\"RX\",\"RY\"]\r\n\r\nfunction VectorLengthSquared(a){\r\n\tlet l=0.0;\r\n\tfor(const b of a){\r\n\t\tl+=b*b;\r\n\t}\r\n\treturn l;\r\n}\r\n\r\nconst tools=true;\r\n\r\nvar epoch;\r\n\r\nvar WatchDog=[];\r\n\r\nconst BasementDepth=4;\t// TODO: go deeper with edge\r\n\r\nconst OceanBlue=\"#0c351b\";\r\nconst OceanGreen=\"#0c1b35\";\r\nconst OceanBlue2=\"#0c1b2e\";\r\n\r\nconst SceneModels=[];\r\n//const SceneModels=[\"Duck\"];\r\n//const SceneModels=[\"CesiumMilkTruck\"];\r\n//const SceneModels=[\"bluebird\"];\r\n//const SceneModels=[\"Te Manawa\"];\r\n\r\nconst SceneShaders=[\r\n\t\"pointFragment\",\r\n\t\"rayFragment\",\"rayVertex\",\r\n\t\"flat_fragment\",\"flat_vertex\",\r\n\t\"tile_fragment\",\"tile_vertex\",\r\n\t\"static_fragment\",\"static_vertex\",\r\n\t\"model_fragment\",\"model_vertex\",\r\n\t\"sprite_fragment\",\"sprite_vertex\"\r\n];\r\n\r\nconst UnidentifiedAgent={brands:[],mobile:false,platform:\"\"};\r\n\r\nconst _WireStorage=(typeof(Storage)!==\"undefined\")?window.localStorage:[];\r\n\r\nfunction SetStorageItem(key,object){\r\n\tconst value=JSON.stringify(object);\r\n\t_WireStorage.setItem(key,value);\r\n}\r\n\r\nfunction GetStorageItem(key){\r\n\tconst value=_WireStorage.getItem(key);\r\n\treturn value?JSON.parse(value):{};\r\n}\r\n\r\nconst HeadingsPerRevolution=2048.0/Math.PI;\r\nconst MaxTilt=4;\r\n\r\nconst MaxZoom=400;\r\nconst MinZoom=5;\r\n\r\nconst AboutSite=\"Toggle UI\"\r\nconst RoaAttributes=\"\";//Data courtesy Toitū Te Whenua - Land Information New Zealand, Waka Kotahi - NZ Transport Agency\";\r\nconst SiteAttributes=\"©2026 skid.nz - datasets provided by LINZ NZTA courtesy Community Commons by Attribute license\";\r\n\r\nconst AK17_License=[\r\n\t\"Auckland 0.075m Urban Aerial Photos (2017)\",\r\n\t\"Courtesy Land Information New Zealand\",\r\n\t\"https://data.linz.govt.nz/layer/95497-auckland-0075m-urban-aerial-photos-2017/\"\r\n];\r\n\r\n////\tAppEditor.flipLevel(state);\r\n\r\nfunction bindKeyCodes(){\r\n\treturn[\r\n\t\t{name:\"L\",code:'L',title:\"LogStats\",handler:LogStats},\r\n\t\t{name:\"T\",code:'T',title:\"Tilt\",handler:SwitchTilt},\r\n//\t{name:\"GPS\",code:'G',title:\"Enable GPS\",handler:SwitchGPS},\r\n\t\t{name:\"A\",code:'A',title:\"Aerial\",handler:SwitchAerial,state:true},\r\n//\t{name:\"H\",code:'H',title:\"Heightmap\",handler:SwitchHeight},\r\n//\t{name:\"O\",code:'O',title:\"Overlay\",handler:SwitchOverlay}\r\n//\t{name:\"J\",code:'J',handler:SwitchJyro},\r\n//\t{name:\"M\",code:'M',title:\"Mode\",handler:SwitchMode},\r\n//\t\t{name:\"1\",code:'1',title:\"Level 1\",handler:AppEditor.setLevel.bind(AppEditor,1)},\r\n//\t\t{name:\"2\",code:'2',title:\"Level 2\",handler:AppEditor.setLevel.bind(AppEditor,2)},\r\n//\t\t{name:\"3\",code:'3',title:\"Level 3\",handler:AppEditor.setLevel.bind(AppEditor,3)},\r\n//\t\t{name:\"4\",code:'4',title:\"Level 4\",handler:AppEditor.setLevel.bind(AppEditor,4)},\r\n//\t\t{name:\"5\",code:'5',title:\"Level 5\",handler:AppEditor.setLevel.bind(AppEditor,5)},\r\n//\t\t{name:\"HD\",code:'D',title:\"Resolution\",handler:SwitchRes}\r\n\t]\r\n}\r\n\r\nconst EventNames=[\"error\",\"create\",\"keydown\",\"keyup\"];\r\n\r\nlet AppPlatform;\r\nlet AppGrid;\r\nlet AppScreen;\r\nlet AppMedia;\r\nlet AppEditor;\r\nlet AppPanel;\r\nlet AppStatus=\"\";\r\n\r\nlet AppRuntime={\r\n\tUseAerial:false,//true,//false,//true,\r\n\tUseLINZ:true\r\n};\r\n\r\n// Bounds are inclusive and in [W E S N]\r\n\r\nfunction WGS2NZTM(latlon){\r\n\tconst lat=latlon[0];\r\n\tconst lon=latlon[1];\r\n\tconst grid=AppGrid.wgsNZTM;\r\n\tconst y=grid.bounds[2]-lat;\r\n\tconst x=lon-grid.bounds[0];\r\n\tconst gridy=y/grid.increment;\r\n\tconst gridx=x/grid.increment;\r\n\r\n\tconst yy=(gridy)|0;\r\n\tconst xx=(gridx)|0;\r\n\tconst fracy=gridy-yy;\r\n\tconst fracx=gridx-xx;\r\n\r\n\tconst row0=grid.meters[yy].slice(xx*2,xx*2+4);\r\n\tconst row1=grid.meters[yy+1].slice(xx*2,xx*2+4);\r\n\r\n\tconst n0=row0[0]+fracx*(row0[2]-row0[0]);\r\n\tconst n1=row1[0]+fracx*(row1[2]-row1[0]);\r\n\r\n\tconst e0=row0[1]+fracx*(row0[3]-row0[1]);\r\n\tconst e1=row1[1]+fracx*(row1[3]-row1[1]);\r\n\r\n\tconst n=n0+fracy*(n1-n0);\r\n\tconst e=e0+fracy*(e1-e0);\r\n\r\n\treturn [n,e];\r\n}\r\n\r\nfunction NZTM2WGS(northeast){\r\n\tconst n=northeast[0];\r\n\tconst e=northeast[1];\r\n\tconst grid=AppGrid.nztmWGS;\r\n\tconst y=n-grid.bounds[2];\r\n\tconst x=e-grid.bounds[0];\r\n\tconst gridy=y/grid.increment;\r\n\tconst gridx=x/grid.increment;\r\n\r\n\tconst yy=(gridy)|0;\r\n\tconst xx=(gridx)|0;\r\n\tconst fracy=gridy-yy;\r\n\tconst fracx=gridx-xx;\r\n\r\n\tconst row0=grid.degrees[yy].slice(xx*2,xx*2+4);\r\n\tconst row1=grid.degrees[yy+1].slice(xx*2,xx*2+4);\r\n\r\n\tconst n0=row0[0]+fracx*(row0[2]-row0[0]);\r\n\tconst n1=row1[0]+fracx*(row1[2]-row1[0]);\r\n\r\n\tconst e0=row0[1]+fracx*(row0[3]-row0[1]);\r\n\tconst e1=row1[1]+fracx*(row1[3]-row1[1]);\r\n\r\n\tconst lat=n0+fracy*(n1-n0);\r\n\tconst lon=e0+fracy*(e1-e0);\r\n\r\n\treturn [lat,lon];\r\n}\r\n\r\n\r\nfunction WGS2NZTM2(latlon){\r\n\tconst lat=latlon[0];\r\n\tconst lon=latlon[1];\r\n\tconst grid=AppGrid.wgsNZTM;\r\n\tconst y=grid.bounds[2]-lat;\r\n\tconst x=lon-grid.bounds[0];\r\n\tconst yy=(y/grid.increment)|0;\r\n\tconst xx=(x/grid.increment)|0;\r\n\tconst row=grid.meters[yy];\r\n\treturn [row[xx*2+0],row[xx*2+1]];\r\n}\r\n\r\nfunction NZTM2WGS2(northeast){\r\n\tconst n=northeast[0];\r\n\tconst e=northeast[1];\r\n\tconst grid=AppGrid.nztmWGS;\r\n\tconst y=n-grid.bounds[2];\r\n\tconst x=e-grid.bounds[0];\r\n\tconst yy=(y/grid.increment)|0;\r\n\tconst xx=(x/grid.increment)|0;\r\n\tconst row=grid.degrees[yy];\r\n\treturn [row[xx*2+0],row[xx*2+1]];\r\n}\r\n\r\nfunction SetStatus(status){\r\n//\tconsole.log(\"SetStatus:\"+status);\r\n\tAppStatus=status;\r\n\tif(AppPanel){\r\n\t\tAppPanel.status.setAttribute(\"content\",status);\r\n\t}\r\n}\r\n\r\nfunction CreateCar(){\r\n\tconst cursor=AppPanel.toggleButton(\"Create Car\");\r\n\tif(cursor){\r\n\t\tAppEditor.cursorType=2;\r\n\t}else{\r\n//\t\tconst carsnap=AppEditor.snapshotCar();\r\n//\t\tAppEventServer.addEvent(\"create\",carsnap);\r\n\t\tAppEditor.cursorType=0;\r\n\t}\r\n}\r\n\r\nfunction Screen(){\r\n\twindow.open(\"/\",\"roa.2\",\"_parent\");\r\n}\r\n\r\nfunction Immerse(){\r\n\tconst on=AppPanel.toggleButton(\"Immerse\");\r\n\tif(on){\r\n\t\tBeginImmersion(AppPanel);\r\n\t}else{\r\n\t\tEndImmersion();\r\n\t}\r\n}\r\n\r\nfunction Transmit(){\r\n\tconst on=AppPanel.toggleButton(\"Transmit\");\r\n\tAppEditor.transmit(on);\r\n}\r\n\r\nfunction Camera(){\r\n\tconst on=AppPanel.toggleButton(\"Camera\");\r\n\tAppEditor.camera(on);\r\n}\r\n\r\nfunction Snapshot(){\r\n\tconst app=AppEditor;\r\n\tconst layerXY=JSON.stringify([app.layerx|0,app.layery|0]);\r\n\tSetStatus(\"location:\"+layerXY);\r\n\tconst location=app.getLocation();\r\n\tSetStorageItem(\"home\",{location});\r\n}\r\n\r\nfunction ToggleHelp(){\r\n\tconst show=AppPanel.toggleButton(\"Help\");\r\n\tif(show){\r\n\t\tAppPanel.pagediv.removeAttribute(\"hidden\");\r\n\t}else{\r\n\t\tAppPanel.pagediv.setAttribute(\"hidden\",\"\");\r\n\t}\r\n}\r\n\r\nfunction OnSettings(){\r\n\tconst show=AppPanel.toggleButton(\"Settings\");\r\n\tif(show){\r\n\t\tAppPanel.pagediv.removeAttribute(\"hidden\");\r\n\t}else{\r\n\t\tAppPanel.pagediv.setAttribute(\"hidden\",\"\");\r\n\t}\r\n}\r\n\r\nfunction appendDiv(body,classname){\r\n\tconst div=document.createElement(\"div\");\r\n\tdiv.className=classname;\r\n\tdiv.setAttribute(\"tabindex\",1);\r\n\tbody.appendChild(div);\r\n\treturn div;\r\n}\r\n\r\nfunction appendRange(div,id,action){\r\n\tconst fader=document.createElement(\"div\");\r\n\tfader.className=\"fader\";\r\n\tfader.id=id;\r\n\tconst divLevel=document.createElement(\"div\");\r\n\tdivLevel.className=\"faderlevel\";\r\n\tfader.appendChild(divLevel);\r\n//\tfader.addEventListener(\"input\",action);\r\n\tdiv.appendChild(fader);\r\n\treturn fader;\r\n}\r\n\r\n\r\nfunction appendButton(div,label,action,title,state){\r\n\tconst button=document.createElement(\"button\");\r\n\tif(title) button.title=title;\r\n\tbutton.appendChild(document.createTextNode(label));\r\n\r\n\tconst clickaction=action.bind(state);\r\n\tbutton.addEventListener(\"click\",clickaction);\r\n\r\n\tdiv.appendChild(button);\r\n\treturn button;\r\n}\r\n\r\n/*\r\nfunction addAnchor(group,label,link){\r\n\tconst div=document.createElement(\"div\");\r\n\tgroup.appendChild(div);\r\n}\r\n*/\r\n\r\nfunction appendText(div,content){\r\n\tconst pre=document.createElement(\"span\");\r\n\tconst text=document.createTextNode(content);\r\n\tpre.appendChild(text);\r\n\tdiv.appendChild(pre);\r\n\treturn text;\r\n}\r\n\r\n\r\n// returns NodeListOf<ChildNode>\r\nfunction createContent(div,content){\r\n\tconst template=document.createElement(\"template\");\r\n\ttemplate.innerHTML=content;\r\n\tconst kids=template.content.childNodes;\r\n\treturn kids;\r\n}\r\n\r\nfunction addIndex(div,root){\r\n\tappendText(div,RoaAttributes);\r\n}\r\n\r\nclass Panel{\r\n\r\n\ttoggleButton(name,onoff){\r\n\t\tconst toggle=onoff===undefined;\r\n\t\tconst button=this.buttons[name];\r\n\t\tif(!button) return true;\r\n\t\tconst on=toggle?(!button.hasAttribute(\"on\")):onoff;\r\n\t\tsetOn(button,on);\r\n\t\treturn on;\r\n\r\n\t}\r\n\r\n\taddFader(div,name){\r\n\t\tconst range=appendRange(div,name,this.fade.bind(this,name));\r\n\t\treturn range;\r\n\t}\r\n\r\n\taddButton(div,label,action,title){\r\n\t\tconst button=appendButton(div,label,action,title);\r\n\t\tthis.buttons[title]=button;\r\n\t\treturn button;\r\n\t}\r\n\r\n\t// Panel(body,handler,root)\r\n\t// root => index in top_panel\r\n\tconstructor(body,handler,root){\r\n\t\tthis.buttons={};\r\n\t\tthis.element=body;\r\n\t\tthis.clickButtons=[];\r\n\t\tthis.hitHandler=handler;\r\n\r\n\t\tconst div=appendDiv(body,\"top_panel\");\r\n//\t\tconst div=appendDiv(body,\"corner_panel\");\r\n//\t\taddText(div,RoaAttributes);\r\n\t\taddIndex(div,root);\r\n\r\n\t\tconst div2=appendDiv(body,\"bottom_panel\");\r\n\t\tdiv2.appendChild(document.createTextNode(SiteAttributes));\r\n\r\n\t\tthis.status=document.createElement(\"span\");\r\n\t\tthis.status.className=\"status\";\r\n\t\tdiv2.appendChild(this.status);\r\n\r\n\t\tconst div3=appendDiv(body,\"media_panel\");\r\n\r\n\t\tthis.div=div;\r\n\t\tthis.menu=div3;\r\n\r\n\t\tif(tools){\r\n\t\t\tconst div4=appendDiv(body,\"tool_panel\");\r\n\t\t\tthis.addButton(div4,\"⚙\",OnSettings,\"Settings\");\r\n\t//\t\tthis.addButton(div4,\"🖵\",Screen,\"Add Screen\");\r\n\t//\t\tthis.addButton(div4,\"🚗\",CreateCar,\"Create Car\");\r\n\t//\t\tthis.addButton(div4,\"📡\",Transmit,\"Transmit\");\r\n\t//\t\tthis.addButton(div4,\"👓\",Immerse,\"Immerse\");\t//🥽🤿\r\n\t//\t\tthis.addButton(div4,\"⛶\",Square,\"Square\");\r\n\t//\t\tthis.addButton(div4,\"📷\",Snapshot,\"Snapshot\");\r\n\t//\t\tthis.addButton(div4,\"📷\",Camera,\"Camera\");\r\n\t//\t\tthis.addButton(div4,\"☰\",this.toggleMenu.bind(this),\"ToggleUI\");\r\n//\t\t\tthis.toolpanel=div4;\r\n\t\t}\r\n\r\n\t\tconst div5=appendDiv(body,\"page\");\r\n\t\tdiv5.setAttribute(\"hidden\",\"\");\r\n\t\tthis.pagediv=div5;\r\n\r\n\t\tthis.page=new Page(this.pagediv);\r\n\t\tthis.page.request(\"skid\");\r\n\r\n\t\tconst keycodes=bindKeyCodes();\r\n\r\n\t\tfor(const k in keycodes){\r\n\t\t\tconst ascii=keycodes[k].code.charCodeAt(0);\r\n\t\t\tconst keyhandler=keycodes[k].handler;\r\n\t\t\tconst keytitle=keycodes[k].title;\r\n\t\t\tconst label=keycodes[k].name;\r\n\t\t\tconst state=keycodes[k].state;\r\n\t\t\tconst button=this.addKey(div3,label,ascii,keyhandler,keytitle,state);\r\n\t\t\tif(state){\r\n//\t\t\t\tbutton.click(state);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\r\n\r\n//\t\tdiv.focus();\r\n\t}\r\n\r\n\t_clickKey(key){\r\n\t\tthis.hitHandler(key);\r\n\t}\r\n\r\n\tfade(name,event){\r\n\t\tconst v=event.target.value|0;\r\n\t\tswitch(name){\r\n\t\t\tcase \"cursorWidth\":\r\n\t\t\t\tAppEditor.cursorWidth=4+v/12;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"cursorHeight\":\r\n\t\t\t\tAppEditor.cursorHeight=4+v/2;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"day\":{\r\n\t\t\t\tconst h=v*24/100;\r\n\t\t\t\tconst sun=Math.sin(h*Math.PI/24);\r\n\t\t\t\tconst moon=Math.sin((h-8)*Math.PI/24);\r\n\t\t//\t\tthis.screen.setAttribute(\"background-color\"daylight=sun;\r\n\t\t\t}break;\r\n\r\n\t\t}\r\n\t}\r\n\r\n\taddKey(div,label,key,handler,title,state){\r\n\t\tif(!handler){\r\n\t\t\thandler=this._clickKey.bind(this,key);\r\n\t\t}\r\n\t\tconst button=appendButton(div,label,handler,title,state);\r\n//\t\tif(title) button.title=title;\r\n\t\tthis.clickButtons[key]=button;\r\n\t\treturn button;\r\n\t}\r\n\r\n\ttoggleMenu(){\r\n\t\ttoggleAttribute(this.menu,\"hidden\");\r\n\t}\r\n}\r\n\r\nconst MouseEvents=[\"mousedown\",\"mousemove\",\"mouseup\",\"mouseout\",\"mouseover\",\"mouseenter\"];\r\nconst TouchEvents=[\"touchstart\",\"touchend\",\"touchcancel\",\"touchmove\"];\r\nconst KeyEvents=[\"keydown\",\"keyup\",\"keypress\"];\r\nconst BrowserKeyMaskList=[27,115,116,122,123];\t//Esc,F4,F5,F11,F12\r\n\r\n// TopoSource maintains available / visible set of aerial topo and roa TopoTile\r\n// populated from tiles.json\r\n\r\nclass TopoSource{\r\n\r\n\t// collect aerial topo and roa tile data\r\n\r\n\tconstructor(tiles){\r\n\t\tthis.aerial=tiles.aerial;\r\n\t\tthis.topo=tiles.topo;\r\n\t\tthis.roa=tiles.roa;\r\n\t\tthis.visible=tiles.aerial.concat(tiles.topo,tiles.roa);\r\n\t\tthis.fetchMasks();\r\n\t}\r\n\r\n\tloadRaw(raw,w,h,v){\r\n\t\tconst bytesWide=(w+7)>>3;\r\n\t\tconst size=2*bytesWide*h;\r\n\t\tconst maskBytes=new Uint8Array(raw);\r\n\t\tif(maskBytes.length!=size){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tv.mask={bytesWide,maskBytes};\r\n\t\tthis.maskCount++;\r\n\r\n\t}\r\n\r\n\tloaded(){\r\n\t\treturn this.maskCount+this.maskErrors==this.visible.length;\r\n\t}\r\n\r\n\terror(){\r\n\r\n\t}\r\n\r\n\tfetchMasks(){\r\n\t\tthis.maskCount=0;\r\n\t\tthis.maskErrors=0;\r\n\t\t// decode all layer.mask bytemaps\r\n\t\tfor(const v of this.visible){\r\n\t\t\tconst w=1+v.bounds[1]-v.bounds[0];\r\n\t\t\tconst h=1+v.bounds[3]-v.bounds[2];\r\n\t\t\tconst bytesWide=(w+7)>>3;\r\n\t\t\tconst name=v.aerialname||v.toponame||v.roaname;\r\n\t\t\tif(!name){\r\n\t\t\t\tdebugger;\r\n\t\t\t}\r\n\t\t\tconst url=\"mask/\"+name+\".\"+v.layer+\".tar.gz\";\r\n\t\t\tfetch(url).then(//then(response=>response.json()).then(\r\n\t\t\t\t(response)=>{\r\n\t\t\t\t\tif(response.ok){\r\n//\t\t\t\t\tconsole.log(...response.headers);\r\n\t\t\t\t\t\tresponse.arrayBuffer().then(\r\n\t\t\t\t\t\t\t(raw)=>\r\n\t\t\t\t\t\t\t\tthis.loadRaw(raw,w,h,v)\r\n\t\t\t\t\t\t\t,(_error)=>\r\n\t\t\t\t\t\t\t\tthis.error(\"4\"+_error)\r\n\t\t\t\t\t\t)\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tconsole.log(\"fetchMasks response not ok, url:\"+url);\r\n\t\t\t\t\t\tthis.maskErrors++;\r\n//\t\t\t\t\t\tthis.rawLoad([]);\r\n\t\t\t\t\t}\r\n\t\t\t\t},(_error)=>{\r\n\t\t\t\t\tthis.error(\"3\"+_error)\r\n\t\t\t\t}\r\n\t\t\t);\r\n\t\t}\r\n\t}\r\n\r\n\tlistSources(level,col,row){\r\n\t\tconst sources=[];\r\n\t\tfor(const v of this.visible){\r\n\t\t\tconst b=v.bounds;\r\n\t\t\tif(level==v.layer && col>=b[0] && col<=b[1] && row>=b[2] && row<=b[3]){\r\n\t\t\t\tconst x=col-b[0];\r\n\t\t\t\tconst y=row-b[2];\r\n//\t\t\t\tconst y=b[3]-row;\r\n\r\nconst h=1+b[3]-b[2];\r\n\t\t\t\tconst bytesWide=v.mask.bytesWide;\r\n\t\t\t\tconst mask=v.mask.maskBytes;\r\n\t\t\t\tlet on=mask[y*bytesWide+(x>>3)]&(1<<(x&7));\r\n\t\t\t\tlet partial=0;// mask[(y+h)*bytesWide+(x>>3)]&(1<<(x&7));\r\n\t\t\t\tif(on){\r\n\t\t\t\t\tsources.push({layer:v,partial});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn sources;\r\n\t}\r\n}\r\n\r\n\r\nfunction totalTiles(grids){\r\n\tif(!grids) return 0;\r\n\tlet bytes=0;\r\n\tfor(const level in grids){\r\n\t\tconst grid=grids[level]._tileGrid;\r\n\t\tfor(const y in grid){\r\n\t\t\tfor(const x in grid[y]){\r\n\t\t\t\tconst heightmap=grid[y][x].heightmap;\r\n\t\t\t\tif(heightmap){\r\n\t\t\t\t\t\tbytes+=heightmap.topo.byteLength;\r\n\t\t\t\t\t\tbytes+=heightmap.diff.byteLength;\r\n\t\t\t\t\t\tbytes+=heightmap.ground.byteLength;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn bytes;\r\n}\r\n\r\n// modes\r\n\r\n// 1 - isometric mouse finger wheel interface\r\n\r\nclass TopoEditor{\r\n\r\n\tlogStats(){\r\n\t\tlog(\"[TopoEditor] logStats\");\r\n\t\tconst grids=this.topoTiles;\r\n\t\tlog(\"[MB] tiles:\"+shorten(totalTiles(grids)));\r\n\t}\r\n\r\n\treset(){\r\n\t\tthis.shapeFiles=[];\r\n\t\tthis.instances=[];\r\n\t}\r\n\r\n\tconstructor(body,video,mode){\r\n//\t\tthis.layerx;\r\n//\t\tthis.layery;\r\n//\t\tthis.layerlevel;\r\n\r\n\t\tthis.tilesource=null;\r\n\t\tthis.topores=1;\r\n\r\n\t\tthis.topoTiles=null;\r\n\t\tthis.homex=0;\r\n\t\tt