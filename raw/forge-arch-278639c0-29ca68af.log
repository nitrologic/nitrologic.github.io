29a2775d [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.023 1.553MB 18.72s
29a2775d [deepseek-flash] #Yes — but only for part of the frame, and that matters for how you read the gap.
29a2775d [deepseek-flash] #
29a2775d [deepseek-flash] #Where it's turned on
29a2775d [deepseek-flash] #
29a2775d [deepseek-flash] #`drawLayerList` in `wire_graphics.js` walks two passes:
29a2775d [deepseek-flash] #
29a2775d [deepseek-flash] #
29a2775d [deepseek-flash] #for(const pass of ["depthDisable","depthEnable"]){
29a2775d [deepseek-flash] #	if(pass=="depthEnable"){
29a2775d [deepseek-flash] #		draw.push({command:gl.enable,arguments:[gl.DEPTH_TEST]});
29a2775d [deepseek-flash] #	}
29a2775d [deepseek-flash] #	...draw tagged layers...
29a2775d [deepseek-flash] #	if(pass=="depthEnable"){
29a2775d [deepseek-flash] #		draw.push({command:gl.disable,arguments:[gl.DEPTH_TEST]});
29a2775d [deepseek-flash] #	}
29a2775e [deepseek-flash] #}
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #So depth test is enabled for the second pass only and disabled at the end of it. It's not global
29a2775e [deepseek-flash] #state — it's a raw GL call baked into the draw list.
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #Which layers carry which tag (`GraphicsLayer.reset`):
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #depthDisable only : sprite, line
29a2775e [deepseek-flash] #depthEnable only  : model, static, tile, flat, edge
29a2775e [deepseek-flash] #both              : point
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #So all the geometry you care about — walls (`static`), terrain (`tile`), roof surfaces (`static`),
29a2775e [deepseek-flash] #models — is in the depthEnable pass and z-tests against each other.
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #What that means for your gap
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #Buildings and terrain are z-tested against each other. So the gap you're seeing is real
29a2775e [deepseek-flash] #geometry separation — different world z — not a depth-buffer artifact. Depth test can't hide a 100
29a2775e [deepseek-flash] #m wall sitting above the ground; it only decides which of two fragments at the same pixel wins.
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #Three things worth knowing while debugging this
29a2775e [deepseek-flash] #
29a2775e [deepseek-flash] #- Depth func is default `LESS`. Never set anywhere. So equal z fails, and coincident
29a2775e [deepseek-flash] #surfaces resolve by draw order.
29a2775e [deepseek-flash] #- Blend is globally on. `WebGL2Context.clear` does `gl.enable(gl.BLEND)` and never disables
29a2775e [deepseek-flash] #it. Terrain alpha is `0.94`, so it blends. Combined with `LESS`, a blended surface drawn later
29a2775f [deepseek-flash] #paints over one at equal depth.
29a2775f [deepseek-flash] #- Draw order is static → tile. `rawLayers()` returns `[model, static, tile, flat, line,
29a2775f [deepseek-flash] #point, edge]`, and the pass loop preserves that order within each pass. So walls are drawn
29a2775f [deepseek-flash] #before terrain. If terrain is in front, it blends 94% over the wall; if behind, depth test
29a2775f [deepseek-flash] #rejects it. Neither produces a gap — but it does affect how the seam reads.
29a2775f [deepseek-flash] #
29a2775f [deepseek-flash] #`depthMask` is left at default (true), so blended surfaces write depth. That's why draw order is
29a2775f [deepseek-flash] #load-bearing here.
29a2775f [deepseek-flash] #
29a2775f [deepseek-flash] #No polygon offset
29a2775f [deepseek-flash] #
29a2775f [deepseek-flash] #No `gl.polygonOffset`, no depth bias, no `gl.depthFunc` call anywhere. So there's no GL trickery
29a2775f [deepseek-flash] #either hiding or creating the gap. What you see on screen is what's in the buffers.
29a2775f [deepseek-flash] #
29a2775f [deepseek-flash] #If you want to confirm the geometry mismatch is the cause rather than the renderer, the fastest
29a2775f [deepseek-flash] #check is to temporarily set `FloraPen`-style wall top to `h0` (zero height) — flat ribbons on the
29a2775f [deepseek-flash] #terrain. If those sit flush, the base sampling is right and the problem is elsewhere. If they still
29a2775f [deepseek-flash] #float or sink, it's the `pickElevation` vs `pickTopo().min` mismatch from the last answer.
29a2775f [deepseek-flash] #
