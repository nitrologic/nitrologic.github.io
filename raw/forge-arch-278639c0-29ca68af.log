29a308ec [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.027 1.646MB 32.27s
29a308ec [deepseek-flash] #Yes, there's a `zbias` in every vertex shader — and it's `0.0` in all of them. So the bias
29a308ec [deepseek-flash] #mechanism exists but is unused. The thing actually controlling depth is the divisor applied
29a308ec [deepseek-flash] #after `v.z`, and that differs between layers.
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #The divisors
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #╭──────────────────────┬────────────────────┬──────────────────────────────────╮
29a308ed [deepseek-flash] #│  shader              │  depth line        │  NDC z at world z                │
29a308ed [deepseek-flash] #├──────────────────────┼────────────────────┼──────────────────────────────────┤
29a308ed [deepseek-flash] #│  static_vertex       │  zbias+v.z/2048.0  │  (0.5 - z/2048) / 2048           │
29a308ed [deepseek-flash] #│  flat_vertex         │  zbias+v.z/2048.0  │  (0.5 - z/2048) / 2048           │
29a308ed [deepseek-flash] #│  model_vertex        │  zbias+v.z/2048.0  │  (0.5 - z/2048) / 2048           │
29a308ed [deepseek-flash] #│  tile_vertex         │  zbias+v.z/4096.0  │  (0.5 - z/2048) / 4096           │
29a308ed [deepseek-flash] #│  rayVertex           │  zbias+v.z         │  0.5 - z/2048                    │
29a308ed [deepseek-flash] #│  sprite_vertex       │  none              │  raw xyzc, no view transform     │
29a308ed [deepseek-flash] #╰──────────────────────┴────────────────────┴──────────────────────────────────╯
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #`v.z` here is post-`view`. The view matrix (`TranslateZoomAngleAspect`) already sets row 2 to `[0,
29a308ed [deepseek-flash] #0, -1/2048, 0.5]`, so `v.z = 0.5 - z_world/2048` before the shader's own divide.
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #That's the whole problem. Terrain is at half the depth value of walls at the same world z.
29a308ed [deepseek-flash] #With `LESS`, smaller wins, so terrain always beats static at any contested pixel.
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #What that does to a wall base
29a308ed [deepseek-flash] #
29a308ed [deepseek-flash] #At a pixel where the wall base and terrain coincide in world space (same x, y, z), the wall needs
29a308ed [deepseek-flash] #`2*z_wall - z_terrain > 1024` to win — i.e. the wall only becomes visible above roughly 512 world
29a308ed [deepseek-flash] #units (32 m at 16 units/m). Everything below that is occluded by the terrain. The wall appears to
29a308ed [deepseek-flash] #start above its base, and the visible gap depends on terrain z at that pixel, which is why it
29a308ee [deepseek-flash] #"varies".
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #Fix
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #Unify the divisor. `/2048` matches the view matrix term, so make `tile_vertex` match the others:
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #float d=zbias+v.z/2048.0;
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #`rayVertex` at `v.z` (no divisor) is a separate case — its NDC z is ~0.5, far behind everything, so
29a308ee [deepseek-flash] #lines and points are always occluded when depth is enabled. If that's not intended, it needs a
29a308ee [deepseek-flash] #divisor too. The `lineLayer` is `depthDisable` so it doesn't matter there, but `pointLayer` is
29a308ee [deepseek-flash] #tagged both and gets drawn twice.
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #Even with matching divisors
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #At a coincident pixel, terrain and wall are at equal NDC z. `LESS` fails on equal, so draw
29a308ee [deepseek-flash] #order decides. `rawLayers()` is `[model, static, tile, ...]`, so static is drawn first, tile second
29a308ee [deepseek-flash] #— tile wins the tie. Wall base still hidden.
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #Two ways out, both one line:
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #- Nudge the wall forward. The `zbias` variable is already there:
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #  float zbias=-0.00005;
29a308ee [deepseek-flash] #
29a308ee [deepseek-flash] #  NDC units, so a small constant offset. Shifts the whole wall, top included — usually fine since
29a308ee [deepseek-flash] #the top is far above terrain anyway.
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #- Or bias the wall base in world space in `walledSpiral`:
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #  verts.push([px,-py,g0-8,pu,0,0,0,wallc]);
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #  `-8` units = 0.5 m below the terrain sample. Sinks the base under the surface so the seam is
29a308ef [deepseek-flash] #hidden regardless of depth quirks. Cheapest and most robust.
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #On sharing shaders
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #The depth line is four lines of copy-paste across five shaders. You don't need to share the file —
29a308ef [deepseek-flash] #just make the constant identical. If you'd rather enforce it, the cleanest place is the view
29a308ef [deepseek-flash] #matrix: pre-multiply `array[10]` by the divisor and drop the shader-side divide entirely, so
29a308ef [deepseek-flash] #`gl_Position.z = v.z` everywhere. Then there's one number to get right, in one place.
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #But that changes `hfac`-driven z exaggeration at every level, so do it deliberately, not as a
29a308ef [deepseek-flash] #drive-by.
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #Not the cause
29a308ef [deepseek-flash] #
29a308ef [deepseek-flash] #`hfac = 0.77 / (1<<(level*3))` is uniform across all layers, so level scaling isn't the mismatch.
29a308ef [deepseek-flash] #Neither is the `z` term in the view matrix — both layers see it. It's purely the shader-side
29a308ef [deepseek-flash] #divide.
29a308ef [deepseek-flash] #
