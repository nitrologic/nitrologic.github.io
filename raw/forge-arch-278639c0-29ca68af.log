298750e7 [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪣 0.7° $0.019 1.105MB 28.83s
298750e7 [deepseek-flash] #Short answer: yes, but the risk isn't inside the worker — a `Worker` gets a fresh global scope and
298750e7 [deepseek-flash] #is freed the moment you `terminate()` it. The risk is the main thread failing to terminate
298750e7 [deepseek-flash] #it, plus main-side buffers that outlive the tile. The discipline is: every `TopoTile` must be
298750e7 [deepseek-flash] #flushed exactly once, and nothing on the main thread may retain per-tile buffers.
298750e7 [deepseek-flash] #
298750e8 [deepseek-flash] #Why the worker's own state is safe
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #`heightmaps`, `roofOutlines`, `topoCount`, `digReady` are all module-level in `worker_baker.js`.
298750e8 [deepseek-flash] #Each `new Worker(...)` is a separate global, so there's no cross-tile contamination, and
298750e8 [deepseek-flash] #`terminate()` discards the whole realm. `createTopo` also clears `heightmaps.length=0` and
298750e8 [deepseek-flash] #`roofOutlines.length=0`, and `post()` transfers `topo`/`diff`/`ground` out (detaching them). So the
298750e8 [deepseek-flash] #worker holds nothing after a successful bake.
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #The four real gaps
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #╭─────┬──────────────────────────────────────────┬───────────────────────────────────────────────────────────────╮
298750e8 [deepseek-flash] #│  #  │  Leak                                    │  Cause                                                        │
298750e8 [deepseek-flash] #├─────┼──────────────────────────────────────────┼───────────────────────────────────────────────────────────────┤
298750e8 [deepseek-flash] #│  1  │  Orphan workers                          │  sweep() only removes tiles with tile.frame set; tiles that   │
298750e8 [deepseek-flash] #│     │                                          │  never became ready keep their Worker alive forever           │
298750e8 [deepseek-flash] #│  2  │  Double instance                         │  fetchTopoTile() overwrites this.instance; only a debugger    │
298750e8 [deepseek-flash] #│     │                                          │  guards it, so the old Worker leaks                           │
298750e8 [deepseek-flash] #│  3  │  Main-thread heightmaps array            │  rawLoad() pushes raw and never clears; transfer is           │
298750e8 [deepseek-flash] #│     │                                          │  commented out so the buffer is copied, not moved             │
298750e8 [deepseek-flash] #│  4  │  Worker holds heightmaps on stall        │  if createTopo never runs, heightmaps/roofOutlines never clear │
298750e8 [deepseek-flash] #╰─────┴──────────────────────────────────────────┴───────────────────────────────────────────────────────────────╯
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #• 1 — orphan workers.* `sweep()` uses `if(tile.frame && tile.frame<minFrame)`. `touchTiles`
298750e8 [deepseek-flash] #only stamps `frame` on `fetched && ready` tiles, so anything that fetched but never finished is
298750e8 [deepseek-flash] #never swept and its worker is never terminated. Stamp on creation so untouch-ed tiles age out:
298750e8 [deepseek-flash] #
298750e8 [deepseek-flash] #
298750e9 [deepseek-flash] #tileGet(x,y){
298750e9 [deepseek-flash] #	...
298750e9 [deepseek-flash] #	if(!tile){
298750e9 [deepseek-flash] #		tile=new TopoTile(this,level,x,y);
298750e9 [deepseek-flash] #		tile.frame=this.frameCount;
298750e9 [deepseek-flash] #		grid[y][x]=tile;
298750e9 [deepseek-flash] #	}
298750e9 [deepseek-flash] #	return tile;
298750e9 [deepseek-flash] #}
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #Caveat: a tile mid-fetch now has a 20-frame window before it's swept and re-created. If fetches can
298750e9 [deepseek-flash] #exceed that, sweep on `!fetched` instead, or raise the window.
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #• 2 — double instance.* Make it explicit rather than a `debugger`:
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #if(this.hasBaker){
298750e9 [deepseek-flash] #	if(this.instance){
298750e9 [deepseek-flash] #		this.instance.terminate();
298750e9 [deepseek-flash] #		this.instance=null;
298750e9 [deepseek-flash] #	}
298750e9 [deepseek-flash] #	this.flushed=false;
298750e9 [deepseek-flash] #	this.instance=new TileInstance(this);
298750e9 [deepseek-flash] #	this.instance.bakeTopo(this.topoCount);
298750e9 [deepseek-flash] #}
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #
298750e9 [deepseek-flash] #• 3 — main-thread buffer retention. `rawLoad` accumulates `raw` in `this.heightmaps`
298750ea [deepseek-flash] #and posts a copy* because the transfer is commented out. Neither is needed — the worker owns
298750ea [deepseek-flash] #the buffer:
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #rawLoad(raw){
298750ea [deepseek-flash] #	const message=[{command:"heightmap",array:raw}];
298750ea [deepseek-flash] #	this.post(message,[raw.buffer]);
298750ea [deepseek-flash] #}
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #Drop `this.heightmaps.push(raw)` entirely. `TileInstance.heightmaps` is only read by
298750ea [deepseek-flash] #`TileInstance.createTopo`, which the baker path never calls — it's a dead accumulator. Same fix for
298750ea [deepseek-flash] #`TileInstance.post` callers: pass the transfer.
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #• 4 — worker retention on stall.* Covered by clearing in `createTopo`, but only if
298750ea [deepseek-flash] #`createTopo` runs. See below.
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #The thing that matters more than the leaks
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #As shipped, the worker gate will never open. `refresh()` is:
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #
298750ea [deepseek-flash] #function refresh(){
298750ea [deepseek-flash] #	if(topoCount==heightmaps.length && digReady){
298750ea [deepseek-flash] #		createTopo();
298750ea [deepseek-flash] #	}
298750ea [deepseek-flash] #}
298750ea [deepseek-flash] #
298750eb [deepseek-flash] #
298750eb [deepseek-flash] #`digReady` is `false` until `onDig` fires, and I can't find a `dig` post anywhere on the main side
298750eb [deepseek-flash] #— `onDrawingResponse` still ends at `this.drawings.push(drawing)`. So `createTopo` never runs: no
298750eb [deepseek-flash] #bump, no flora, no mesh, and `heightmaps`/`roofOutlines` grow for the life of every worker. That's
298750eb [deepseek-flash] #leak #1 and #4 at once, and it presents as an empty view, not as a memory problem.
298750eb [deepseek-flash] #
298750eb [deepseek-flash] #You need `maybeSendDig()` wired into `onDrawingResponse` and the end of `fetchTopoTile`
298750eb [deepseek-flash] #(the second call covers `level>=3`, where no drawing is fetched and nothing would ever set
298750eb [deepseek-flash] #`digReady`).
298750eb [deepseek-flash] #
298750eb [deepseek-flash] #Summary
298750eb [deepseek-flash] #
298750eb [deepseek-flash] #- Worker realm itself: no leak, terminate = freed.
298750eb [deepseek-flash] #- Terminate discipline: fix the orphan sweep and the double-instance overwrite.
298750eb [deepseek-flash] #- Main thread: stop retaining `raw` buffers; transfer them.
298750eb [deepseek-flash] #- Blocker: without the main-thread `dig` send, every worker stalls and retains everything. Fix that
298750eb [deepseek-flash] #first — it's both the render bug and the biggest leak.
298750eb [deepseek-flash] #
