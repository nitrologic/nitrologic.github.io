279e7d3f [gemini-3.8-flash] #GUI software centers on Arch (such as Discover, Pamac, or GNOME Software) often default to
279e7d3f [gemini-3.8-flash] #installing Flatpaks instead of native Arch packages unless explicitly configured otherwise.
279e7d3f [gemini-3.8-flash] #
279e7d3f [gemini-3.8-flash] #If VS Code was installed as a Flatpak, it is completely sandboxed:
279e7d3f [gemini-3.8-flash] #• It cannot see host binaries like `/usr/bin/deno` or `~/.deno/bin/deno`.
279e7d3f [gemini-3.8-flash] #• The integrated terminal and extensions run inside an isolated mount namespace.
279e7d40 [gemini-3.8-flash] #• Standard system tools will report `command not found` inside that environment.
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #1. Verify if VS Code is a Flatpak
279e7d40 [gemini-3.8-flash] #Run this in your normal host terminal:
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #flatpak list | grep -i code
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #If you see `com.visualstudio.code` listed, it is running inside a Flatpak container.
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #2. The Clean Fix (Replace Flatpak with Native Arch Package)
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #To get direct access to system binaries, host environments, and Deno:
279e7d40 [gemini-3.8-flash] #
279e7d40 [gemini-3.8-flash] #1. Remove the Flatpak:
