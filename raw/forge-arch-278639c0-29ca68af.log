;\r\n\t\t}else{\r\n\t\t\tthis.video.removeAttribute(\"camera\",\"\");\r\n\t\t\tthis.video.removeAttribute(\"broadcast\");\r\n\t\t\tthis.body.removeAttribute(\"broadcast\");\r\n\t\t}\r\n\t}\r\n\r\n\ttransmit(on){\r\n\t\tconst video=this.video;\r\n\t\tif(on){\r\n\t\t\tvideo.setAttribute(\"broadcast\",\"\");\r\n\t\t\tthis.body.setAttribute(\"broadcast\",\"\");\r\n\t\t\tconst can=AppEditor.canvas;\r\n\t\t\tconst stream=can.captureStream();\r\n\t\t\tvideo.srcObject=stream;\r\n\t\t\tvideo.play();\r\n\t\t}else{\r\n\t\t\tvideo.removeAttribute(\"broadcast\");\r\n\t\t\tthis.body.removeAttribute(\"broadcast\");\r\n\t\t}\r\n\t}\r\n\r\n\tinstanceModels(model,positions){\r\n\t\tthis.instances.push({model,positions});\r\n\t\tif(this.viewPanel && this.gui){\r\n\t\t\tthis.gui.addScaleModel(model,positions);\r\n\t\t}\r\n\t}\r\n\r\n\tsnapshotCar(){\r\n\t\tconst snap={\r\n\t\t\tbox:{width:this.cursorWidth,height:this.cursorHeight},\r\n\t\t\tlocation:this.getLocation()\r\n\t\t};\r\n\t\treturn snap;\r\n\t}\r\n\r\n\tsnapshotCanvas(){\r\n\t\tconst can=this.canvas;\r\n\t\tconst w=can.width;\r\n\t\tconst h=can.height;\r\n\t\tconst canvas=document.createElement(\"CANVAS\");\r\n\t\tcanvas.width=w/2;\r\n\t\tcanvas.height=h/2;\r\n\t\tconst context=canvas.getContext(\"2d\");\r\n\t\tcontext.drawImage(this.canvas,0,0,w,h,0,0,w/2,h/2);\r\n\t\treturn{\r\n\t\t\timage:canvas,\r\n\t\t\tlocation:this.location()\r\n\t\t};\r\n\t}\r\n\r\n\t// used by snapshot and animate hash\r\n\tgetLocation(){\r\n\t\tif(!this.layerlevel)\r\n\t\t\treturn undefined;\r\n\t\tconst x=this.layerx|0;\r\n\t\tconst y=this.layery|0;\r\n\t\tconst level=this.layerlevel;\r\n\t\tconst zoom=this.zoom|0;\r\n\t\tconst head=this.heading|0;\r\n\t\tconst tilt=this.tilt|0;\r\n\t\tconst p=[x,y,level,zoom,head,tilt];\r\n\t\treturn p;\r\n\t}\r\n\r\n\tsetLocation(p){\r\n\t\tthis.homex=p[0];\r\n\t\tthis.homey=p[1];\r\n// simon come here and infer home()\r\n\t//\tthis.layerx=0;//p[0];\r\n\t//\tthis.layery=0;//p[1];\r\n\t\tthis.layerlevel=p[2];\r\n\