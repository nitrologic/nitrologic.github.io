29860687 [deepseek-flash] #Accumulate rather than replace, so multiple drawings on one tile merge.
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #Ordering in `createTopo`
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #The whole point. Dig, then flora, then post:
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #function createTopo(){
29860687 [deepseek-flash] #	const bytes=heightmaps[0]||[];
29860687 [deepseek-flash] #	const heightmap=AllocBumpmap(bytes);
