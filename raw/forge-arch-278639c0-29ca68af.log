2986f770 [roha] {"model":"kimi-k2.7-code","messages":[{"role":"system","content":"As a guest assistant language model please be mindful of others, courteous and professional. Only post code on request and do not patronise. Use tabs when indenting source files. Prefer named reusable functions over inlining code with arrow and map style suggestions."},{"role":"system","content":"models under test include deepseek-flash"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_display.js\",\"length\":16098,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_display.js\n\nfunction CombineSurfaces(surfs){\n\t\n}\n\n\n/*\n\nCombineSurfaces\n\n\nDependencies:\n\nfrom wire_grid\n\tSetStatus\n\tSceneShaders\n\tSceneModels\n\nfrom wire_util\n\tFetchEvents\n\nfrom wire_core\n\tScene\n\tGraphicsDisplay\n\tTopoSource\n\tTopoTile\n\nfrom wire_drawsurface\n\tCylinder\n\tSphere\n\tWheel\n\tTear\n\n\n\t_MeshLoader.gltfModel\n\n*/\n\n\nconst AKHarborXY=[3431,11563];\n\nfunction Camber(mast,boom,curve,color){\n\tconst xyz=[];\n\tconst segs=[];\n\n\tconst n=10;\n\tconst r=5;\n\n\tfor(let i=0;i<=n;i++){\n\n\t\tconst o=i*3;\n\t\tconst z=i*mast/n;\n\t\tconst y=1+(n-i)*boom/n;\n\n\t\tconst cam1=curve*Math.sin(i*Math.PI/n);\n\t\tconst cam2=Math.sin(i*Math.PI*0.5/n);\n\n\t\txyz.push([0,0,z]);\n\t\txyz.push([cam1,-y/3,z]);\n\t\txyz.push([cam1,-y,z]);\n\n\t\tsegs.push([o,o+1,o+2]);\n\n\t\tif(i>0){\n\t\t\tsegs.push([o-3,o]);\n\t\t\tsegs.push([o-1,o+2]);\n\t\t}\n\t}\n\n\treturn Frame(xyz,segs,r,color);\n}\n\nfunction Hull(ribs,r,c){\n\tconst xyz=[];\n\tconst segs=[];\n\tconst count=ribs.length;\n\tlet prev,prev0;\n\tfor(let i=0;i<count;i++){\n\t\tconst d=i*-180;\n\t\tconst rib=ribs[i];\n\t\tconst n=rib.length/2;\n\t\tfor(let j=0;j<n;j++){\n\t\t\tconst x=rib[j*2+0];\n\t\t\tconst y=rib[j*2+1];\n\t\t\t\n\t\t\tconst o=xyz.length;\n\t\t\txyz.push([0+x,d,0-y]);\n\t\t\txyz.push([0-x,d,0-y]);\n\n\t\t\tif(j>0){\n\t\t\t\tsegs.push([o-2,o+0]);\n\t\t\t\tsegs.push([o-1,o+1]);\n\t\t\t}\n\t\t\tif(j==0){\n\t\t\t\tsegs.push([o+0,o+1]);\n\t\t\t\tif(i>0){\n\t\t\t\t\tsegs.push([o+0,prev0+0]);\n\t\t\t\t\tsegs.push([o+1,prev0+1]);\n\t\t\t\t}\n\t\t\t\tprev0=o;\n\t\t\t}\n\n\t\t\tif(j==n-1){\n\t\t\t\tsegs.push([o+0,o+1]);\n\t\t\t\tif(i>0){\n\t\t\t\t\tsegs.push([o+0,prev+0]);\n\t\t\t\t\tsegs.push([o+1,prev+1]);\n\t\t\t\t}\n\t\t\t\tprev=o;\n\t\t\t}\n\t\t}\n\t}\n\n\treturn Frame(xyz,segs,r,c);\n}\n\nfunction Frame(xyz,segments,r,c){\n\tconst surfs=[];\n\tfor(const segment of segments){\n\t\tfor(let i=0;i<segment.length-1;i++){\n\t\t\tconst v0=segment[i+0];\n\t\t\tconst v1=segment[i+1];\t\t\n\t\t\tsurfs.push(Cylinder(xyz[v0],xyz[v1],r,c));\n\t\t}\n\t}\n\treturn CombineSurfaces(surfs);\n}\n\nclass ViewBuilder{\n\tconstructor(view){\n\t\tthis.view=view;\n\t}\n\n\taddFlatShape(geom,position,count){\n\t\treturn this.view.layer.addFlatShape(geom,position,count);\n\t}\n\n\tRoaIcon(){\n\n\t\tconst radius=100;\n\t\tconst order=2;\n\t\tconst color=7;\n\n\t\tconst position=[0,0,0];\n\n\t\tconst geom=Sphere(radius,order,color);\n\n\t\tgeom.divide(90);\n\t\tgeom.divide(110);\n\n\t\treturn this.addFlatShape(geom,position,1);\n\t}\n\n\n\tCamber(length,boom,curve,color,position){\n\t\tconst sail=Camber(length,boom,curve,color);\n\t\treturn this.addFlatShape(sail,position,1);\n\t}\n\n\tTube(length,radius,colors,position,axis){\n\t\tconst tube=Wheel(radius,0,length,colors);\n\t\tswitch(axis){\n\t\t\tcase 0:\n\t\t\t\ttube.flipAxis(0,2);\n\t\t\t\tbreak;\n\t\t\tcase 1:\n\t\t\t\ttube.flipAxis(0,1);\n\t\t\t\tbreak;\n\t\t\tcase 2:\n\t\t\t\ttube.flipAxis(2,0);\n\t\t\t\tbreak;\n\t\t}\n\t\treturn this.addFlatShape(tube,position,1);\n\t}\n\n\tBall(radius,order,color,position){\n\t\tconst ball=Sphere(radius,order,color);\n\t\treturn this.addFlatShape(ball,position,1);\n\t}\n\n\tWheel(r,w,cc,pos){\n\t\tconst wheel=Wheel(r,-w/2,w/2,cc);\n\t\twheel.verts32[0*8+0]=wheel.verts32[0*8+0]/2;\n\t\twheel.verts32[1*8+0]=wheel.verts32[1*8+0]/2;\n\t\treturn this.addFlatShape(wheel,pos,1);\n\t}\n\n\tJoint(r,w,cc,pos){\n\t\tconst wheel=Wheel(r,-w,w,cc);\n\t\twheel.flipAxis(0,1);\n\t\treturn this.addFlatShape(wheel,pos,1);\n\t}\n\n\tHull(xy,r,c,pos){\n\t\tconst hull=Hull(xy,r,c);\t\t\n\t\treturn this.addFlatShape(hull,pos,1);\n\t}\n\n\tTear(length,width,depth,cc,pos,axis){\n\t\tconst foot=Tear(length,width,depth,cc);\n\t\tswitch(axis){\n\t\t\tcase 1:\n\t\t\t\tfoot.flipAxis(2,0);\n\t\t\t\tfoot.flipAxis(0,1);\n\t\t\t\tbreak;\n\t\t\tcase 2:\n\t\t\t\tfoot.flipAxis(1,2);\n\t\t\t\tbreak;\n\t\t\tcase 3:\n\t\t\t\tfoot.flipAxis(0,2);\n\t\t\t\tbreak;\n\t\t}\n\t\treturn this.addFlatShape(foot,pos,1)\n\t}\n\n\tFrame(points,lines,radius,color,pos){\n\t\tconst frame=Frame(points,lines,radius,color);\n\t\treturn this.addFlatShape(frame,pos,1);\n\n\t}\n\n\tBoat(){\n\t\tconst x=-300;\n\t\tconst z=-180;\n\t\tconst xy=[\n\t\t\t[1,40,30,20,20,-40],\n\t\t\t[1,120,80,40,100,-40],\n\t\t\t[1,200,120,40,140,-40],\n\t\t\t[1,200,150,40,180,-40],\n\t\t\t[1,200,160,40,190,-40],\n\t\t\t[1,120,170,40,190,-40],\n\t\t\t[1,100,160,40,180,-40],\n\t\t\t[1,80,150,40,160,-40]\n\t\t];\n\t\tconst hull=this.Hull(xy,6,6,[x,600,z]);\n\t\tconst mast=this.Tube(1920,12,[0,0],[x,200,z],2);\n\t\tconst boom=this.Tube(800,10,[0,0],[x,180,z+120],1);\n\n\t\tconst sail=this.Camber(1780,800,100,1,[x,180,z+140]);\n\n//\t\tconst q=Math.PI/2;\n//\t\tboom.rotate(0,0,q);\n\t\treturn {hull};\n\t}\n\n\n\tMiniWheel(pos){\n\t\tconst tyre=Wheel(72,-32,32,[0,0]);\n\t\tconst rim=Wheel(40,-34,34,[1,1]);\t\t\n\t\tconst axle=Wheel(6,-38,38,[2,2]);\t\t\n\t\tconst wheel=CombineSurfaces([tyre,rim,axle]);\n\t\treturn this.addFlatShape(wheel,pos,1);\n\t}\n\n\tMiniCar(){\n\n\t\tconst x=400;\n\t\tconst z=0;\n\n\t\tconst tyre0=this.MiniWheel([x-160,120,z]);\n\t\tconst tyre1=this.MiniWheel([x+160,120,z]);\n\t\tconst tyre2=this.MiniWheel([x-172,-250,z]);\n\t\tconst tyre3=this.MiniWheel([x+172,-250,z]);\n\n\t\tconst points=[\n\t\t\t[100,-260,0],[-100,-260,0],\n\t\t\t[99,0,0],[-99,0,0],\n\t\t\t[100,120,0],[-100,120,0],\n\t\t\t\n\t\t\t[0,140,0,],[0,40,80],[0,0,0]\n\t\t];\n\t\tconst segments=[[0,1],[0,2],[2,3],[3,1],[4,5],[2,4],[3,5],[6,7],[7,8]];\n\t\tconst frame=this.Frame(points,segments,6,6,[x,0,z]);\t\t\n\n\t\tconst seatpoints=[\n\t\t\t[50,-20,20],[-50,-20,20],\n\t\t\t[60,-100,10],[-60,-100,10],\n\t\t\t[40,-140,60],[-40,-140,60]\n\t\t];\n\t\tconst seatsegments=[[3,2,0,1,3,5,4,2]];\n\t\tconst seat0=this.Frame(seatpoints,seatsegments,6,8,[x-72,0,z]);\n\t\tconst seat1=this.Frame(seatpoints,seatsegments,6,8,[x+72,0,z]);\n\t\tconst seat2=this.Frame(seatpoints,seatsegments,6,8,[x-60,-160,z+10]);\n\t\tconst seat3=this.Frame(seatpoints,seatsegments,6,8,[x+60,-160,z+10]);\n\n\t\tconst wheelpoints=[\n\t\t\t[-40,0,0],[40,0,0],\t// crossbar\n\t\t\t[-50,0,10],[50,0,10]\t// handles\n\t\t]\n\t\tconst wheelsegments=[[0,1]];//,[2,0],[3,1]];\n\n\t\tconst dash=this.Frame(wheelpoints,wheelsegments,10,7,[x,30,z+80])\n//\t\tconst wheel=\n\n\t\treturn {tyre0,tyre1,tyre2,tyre3,seat0,seat1,frame};\n\n//\t\tconst steeringwheel=this.Ball(30,2,12,[x+0,40,z+80]);\n\t}\n\n\tGokart(){\n\t\tconst x=400;\n\t\tconst z=-300;\n\t\tconst c=2;\n\t\tconst tyre0=this.Wheel(40,60,[c,0],[x-120,140,z]);\n\t\tconst tyre1=this.Wheel(40,60,[c,0],[x+120,140,z]);\n\t\tconst tyre2=this.Wheel(40,60,[c,0],[x-120,-140,z]);\n\t\tconst tyre3=this.Wheel(40,60,[c,0],[x+120,-140,z]);\n\t\tconst points=[\n\t\t\t[88,-140,0],[-88,-140,0],[60,0,0],[-60,0,0],\n\t\t\t[88,140,0],[-88,140,0],\n\t\t\t[0,140,0,],[0,40,80],[0,0,0]\n\t\t];\n\t\tconst segments=[[0,1],[0,2],[2,3],[3,1],[4,5],[2,4],[3,5],[6,7],[7,8]];\n\t\tconst frame=this.Frame(points,segments,6,6,[x,0,z]);\t\t\n\n\t\tconst seatpoints=[\n\t\t\t[50,-20,40],[-50,-20,40],\n\t\t\t[60,-100,10],[-60,-100,10],\n\t\t\t[40,-140,60],[-40,-140,60]\n\n\t\t];\n\t\tconst seatsegments=[[3,2,0,1,3,5,4,2]];\n\t\tconst seat=this.Frame(seatpoints,seatsegments,6,8,[x,0,z]);\n\n\t\tconst wheelpoints=[\n\t\t\t[-40,0,0],[40,0,0],\t// crossbar\n\t\t\t[-50,0,10],[50,0,10]\t// handles\n\t\t]\n\t\tconst wheelsegments=[[0,1]];//,[2,0],[3,1]];\n\t\tconst wheel=this.Frame(wheelpoints,wheelsegments,10,7,[x,30,z+80])\n\n\t\treturn {tyre0,tyre1,tyre2,tyre3,wheel,seat,frame};\n\n//\t\tconst steeringwheel=this.Ball(30,2,12,[x+0,40,z+80]);\n\t}\n\n\n\tSkateboard(){\n\t\tconst view=this.view;\n\n\t\tconst x=200;\n\t\tconst z=-300;\n\t\tconst c=7;\n\n\t\tconst wheel0=this.Wheel(10,12,[c,c],[x-24,60,z]);\n\t\tconst wheel1=this.Wheel(10,12,[c,c],[x+12,60,z]);\n\n\t\tconst wheel2=this.Wheel(10,12,[c,c],[x-24,-60,z]);\n\t\tconst wheel3=this.Wheel(10,12,[c,c],[x+12,-60,z]);\n\n\t\tconst board=this.Tear(240,92,2,[2,1], [x,-150,z+16], 1);\n\n\t\treturn {wheel0,wheel1};\n\t}\n\n\tBike(){\n\t\tconst z=-160;\n\t\tconst x=120;\n\t\tconst wheel0=this.Wheel(140,15,[5,0],[x,200,z]);\n\t\tconst wheel1=this.Wheel(140,15,[5,0],[x,-200,z]);\n\n\t\tconst ring0=this.Wheel(40,5,[4,1],[x+20,-25,z]);\n\t\tconst ring1=this.Wheel(15,5,[4,1],[x+20,-200,z]);\n\t\tconst crank=this.Wheel(5,60,[4,1],[x-20,-25,z]);\n\n\t\tconst points=[\n\t\t\t[30,-200,0],[-30,-200,0],[12,-20,0],[-12,-20,0],[0,-30,0],[0,-80,180],[0,160,180],[0,160,160],\n\t\t\t[12,200,0],[-12,200,0],[15,160,160],[-15,160,160],[60,160,180],[-60,160,180]\t// 8 wheel wheel fork fork handlebar handlebar\n\t\t]; \n\t\tconst segments=[[0,2],[1,3],[4,5],[0,5],[1,5],[5,6],[4,7],[6,7],[8,10],[9,11],[10,11],[12,13]];\n\t\tconst frame=this.Frame(points,segments,5,6,[x,0,z]);\n\n\t\tconst saddle=this.Tear(60,40,10,[7,1],[x,-120,z+200],2);\n\t\t\n\t\treturn {wheel0,wheel1,ring0,ring1,crank,frame,saddle};\n\t}\n\n\tHat(){\n\t\tconst x=0;\n\t\tconst z=300;\n\t\tconst c=8;\n\n\t\tconst ring1=this.Tube(20,24,[c,c],[x,0,z+25],0);\n\t\tconst ring2=this.Tube(8,34,[c,c],[x,0,z-0],0);\n\n//\t\tconst ring2=this.Tube(150,10,[1,2],[x,0,z]);\n\n\t\treturn {ring1};\n\n\t}\n\n\tBod(){\n\n\t\tconst chest=this.Tear(140,220,25,[5,1],[0,0,60],0);\n\t\tconst tum=this.Ball(24,2,2,[0,0,40]);\n\t\tconst pelvis=this.Tear(-80,-80,25,[5,1],[0,0,40],0);\n\t\tconst head=this.Ball(40,2,9,[0,0,260]);\n\n\t\tfor(let side=0;side<=1;side++){\n\t\t\tconst s80=(side*2-1)*80;\n\t\t\tconst shoulder=this.Ball(20,2,2,[0,s80,170]);\n\t\t\tconst humerus=this.Tube(120,8,[0,0],[0,s80,170],0);\n//\t\t\tconst elbow=this.Ball(14,2,2,[0,s80,32]);\n\t\t\tconst elbow=this.Joint(14,10,[4,4],[0,s80,32]);\n\t\t\tconst radius=this.Tube(100,6,[0,0],[0,s80,20],0);\n\t\t\tconst wrist=this.Ball(12,2,2,[0,s80,-100]);\n\n\t\t\tconst s30=(side*2-1)*30;\n\t\t\tconst hip=this.Ball(30,2,2,[0,s30,-30]);\n\t\t\tconst femur=this.Tube(140,16,[0,0],[0,s30,-30],0);\n\t\t\tconst knee=this.Ball(20,2,2,[0,s30,-200]);\n\t\t\tconst fibular=this.Tube(140,10,[4,4],[0,s30,-200],0);\n\t\t\tconst ankle=this.Ball(16,2,2,[0,s30,-340]);\n\t\t\tconst foot=this.Tear(40,40,10,[5,1],[0,s30,-340],3);\n\n\t\t\tconst s20=(side*2-1)*10;\n\t\t\tconst eye=this.Ball(12,2,1,[20,s20,280])\n\t\t\tconst s22=(side*2-1)*12;\n\t\t\tconst eyeball=this.Ball(4,2,0,[30,s22,284]);\n\t\t}\n\t\treturn {chest,pelvis,head};\n\t}\n}\n\nfunction AddPin(view){\n\tconst surf=Tear(150,150,15,[5,1]);\n\tconst origin=[0,0,0];\n\tconst shape=view.layer.addFlatShape(surf,origin,1);\n\treturn shape;\n}\n\n// simon come here and remove deprecated implementations\n\nclass TopoDisplay{\n\tpumpEvents(){\n\t\tconst events=FetchEvents();\n\t\tfor(let e of events){\n// log joypad\t\n//\t\t\tconsole.log(JSON.stringify(e));\n\t\t\tswitch(e.event){\n\t\t\t\tcase \"ready\":{\n\t\t\t\t\tthis.onTopoTileReady(e.name);\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tcase \"source\":{\n\t\t\t\t\tthis.onTopoTileSource(e.type);\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t\tcase \"controller\":{\n\t\t\t\t\tthis.onController(e.mods);\n\t\t\t\t}break;\n\t\t\t\tcase\"createcar\":{\n\t\t\t\t}break;\n\t\t\t\tcase\"loadmodel\":{\n\t\t\t\t\tconst model=_MeshLoader.gltfModel[e.url];\n//\t\t\t\t\tconst xyz=[0,0,1275];\n//\t\t\t\t\tconst xyz=[0,0,275];\n\t\t\t\t\tconst xyzr=[0,0,0,65536];\n\t\t\t\t\tthis.instanceModels(model,[xyzr]);\n\t\t\t\t}break;\n\t\t\t}\n\t\t}\n\t}\n\n\tonTopoTileSource(){\n\t\tconst source=this.tilesource;\n\t\tconst tile=this.loadingTile;\n\t\tif(!tile){\n\t\t\tthis.fetchTile();\n\t\t}else if(tile.hasLoaded()){\n\t\t\tconsole.log(\"tile loaded already?\");\n\t\t}\n\t}\n\n\tonTopoTileReady(name){\n\t\tconst tile=this.loadingTile;\n\t\tconst panel=this.panelLayers;\n\t\tconst home=this.home;\n\t\tpanel.meshTile(tile,home);\n\n\t}\n\tupdateFrames(frames){\n\n\t\t// emits loaded message\n//\t\tthis.tilesource.update();\n\n\t\tconst drag=0.8;\n\t\tconst drag2=0.88;\n\t\n\t\twhile(frames--){\n\t\n\t\t\tthis.tickGamepads();\n\t\n\t\t\tthis.position[0]+=this.speed[0];\n\t\t\tthis.position[1]+=this.speed[1];\n\t//\t\tthis.layerrot+=this.speed[2];\n\t\n\t\t\tthis.heading+=this.speed[3];\n\t\n\t\t\tthis.addZoom(this.speed[2]);\n\t\n\t\t\tthis.speed[0]*=drag;\n\t\t\tthis.speed[1]*=drag;\n\t\t\tthis.speed[2]*=drag2;\n\t\t\tthis.speed[3]*=drag2;\n\t\n//\t\t\tconst frame=this.frameCount++;\n//\t\t\tconst balls=this.balls;\n//\t\t\tballs.position(0,frame*0.1,0,0);\n\t//\t\tballs.rotate(0,0,0.02);\n\t//\t\tballs.rotate(0,1,0.03);\n//\t\t\tballs.rotate(0,2,0.004);\n\t\t}\n\t}\n\t\n\tconstructor(body){\n\t\tthis.body=body;\n\n\t\tthis.canvas=document.createElement(\"canvas\");\n\t\tthis.canvas.setAttribute(\"tabindex\",1);\n\t\tthis.canvas.setAttribute(\"tile\",\"\");\n//\t\tthis.bindEvents();\n//\t\tthis.canvas.addEventListener(\"wheel\",this.wheel.bind(this));\n//\t\tthis.onWindowResize();\n\t\tthis.body.appendChild(this.canvas);\n\n\t\tthis.pixelRatio=window.devicePixelRatio||1;\n\t\tthis.aspect=1.4;\n\t\tthis.tilt=0;\n\n\t\tthis.frameCount=0;\n\t\tthis.frameTime=Date.now();\n\t\tthis.frameElapsed=0;\n\n\t\tthis.refreshCanvas();\n\n\t\tthis.gameAxis=[0,0,0,0];\n\t\tthis.gameButtons=[0,0,0,0,0,0,0,0];\n\t\tthis.gamePrevious=[0,0,0,0,0,0,0,0];\n\n\t\tthis.speed=[0,0,0,0]; //fling speed vx,vy,vz,vroty\n\t\tthis.position=[0,0,0];\n\t\tthis.heading=12384;\n\t\tthis.zoom=140;//42.5;\n\t}\n\n\t// fetchTiles is complete so load masks\n\tonTiles(tiles){\n\t\tconsole.log(\"TopoDisplay.onTiles\");\n\t\tconst source=new TopoSource(tiles);\n\t\tsource.fetchMasks();\n\t\tthis.tilesource=source;\n\t}\n\n\tfetchTile(){\n\t\tconst source=this.tilesource;\n\t\tconst x=AKHarborXY[0];\n\t\tconst y=AKHarborXY[1];\n\n\t\tthis.home=[x,y];\n\t\tconst tile=new TopoTile(this,1,x,y);\n\t\ttile.fetchTopoTile(source);\n\t\tthis.loadingTile=tile;\n\t}\n\n\tonController(mods){\n\t\tfor(const mod of mods){\n\t\t\tconst gamer=mod[0];\n\t\t\tif(gamer==0){\n\t\t\t\tswitch (mod[1]){\n\t\t\t\t\tcase 0:{\n\t\t\t\t\t\tconst b=mod[2]\n\t\t\t\t\t\tlet w=mod[3];\n\t\t\t\t\t\tthis.gameButtons[b]=w;\n\t\t\t\t\t}break;\n\t\t\t\t\tcase 1:{\n\t\t\t\t\t\tconst a=mod[2]\n\t\t\t\t\t\tlet v=mod[3];\n\t\t\t\t\t\tthis.gameAxis[a]=v;\n\t\t\t\t\t}break;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tload(){\n\t\tthis.scene=new Scene();\n\t\tconst callback=this.onLoadScene.bind(this);\n\t\tthis.scene.loadScene(SceneShaders,SceneModels,callback);\n\t}\n\n\tonLoadScene(){\n\t\tthis.graphics=new GraphicsDisplay();\n\t\tvar panels=this.graphics.addPanelLayers(this.canvas,this.scene);\n\t\tconst view=panels.view0;\n\t\tconst builder=new ViewBuilder(view);\n\t\tconst bod=builder.Bod();\n/*\n\t\tconst hat=builder.Hat();\n\n\t\tconst bike=builder.Bike();\t\t\n\t\tconst skateboard=builder.Skateboard();\n\t\tconst gokart=builder.Gokart();\n*/\t\t\n//\t\tconst boat=builder.Boat();\n//\t\tconst icon=builder.RoaIcon();\n\t\tconst car=builder.MiniCar();\n\n//\t\tthis.balls=bod;\n/*\n\t\tfor(let i=0;i<balls.count;i++){\n\t\t\tconst tx=Math.sin(i*.3);\n\t\t\tconst ty=Math.cos(i*.3);\n\t\t\tconst r=i*40;\n\t\t\tballs.position(i,r*tx,r*ty,0);\n\t\t\tballs.rotate(i,2,-i*0.18);\n\t\t}\n*/\n\t\tthis.panelLayers=panels;\n\t\tthis.graphics.compilePanels();\n//\t\tthis.viewPanel.populateScene();\n//\t\tthis.addCursor();\n\t}\n\n\taccelerate(dx,dy){\n\t\tconst tiltscale=1.0+this.tilt*0.2;\n\t\tdy*=tiltscale;\n\t\tconst scale=0.24;//this.zoom/100;\n\t\tconst rot=this.heading*Math.PI/32768;\n\t\tconst sin=Math.sin(rot);\n\t\tconst cos=Math.cos(rot);\n\t\tthis.speed[0]+=scale*(dx*cos-dy*sin);\n\t\tthis.speed[1]+=scale*(dx*sin+dy*cos);\n\t}\n\n\taddZoom(deltaZoom){\n\t\tlet zoom=this.zoom + deltaZoom;\n\t\tif(zoom>MaxZoom) {\n\t\t\tzoom=MaxZoom;\n//\t\t\tzoom=this.jogLevel(zoom,1);\n\t\t}\n\t\tif(zoom<MinZoom) {\n\t\t\tzoom=MinZoom;\n//\t\t\tzoom=this.jogLevel(zoom,-1);\n\t\t}\n\t\tthis.zoom=zoom;\n\t\tthis.dirty=true;\n\t}\t\n\n\tjogTilt(delta){\n\t\tconsole.log(\"jogTilt\",delta);\n\t\tlet tilt=this.tilt+delta;\n\t\tif(tilt>7) tilt=7;\n\t\tif(tilt<0) tilt=0;\n\t\tthis.tilt=tilt;\n\t}\n\n\tjogDolly(x,y){\n\t\t//\t\tthis.drag(x*20,-y*20);\n\t\tconst d=Math.sqrt(x*x+y*y);\n\t\tthis.accelerate(d*x*4,-d*y*4);\n\t}\n\n\tjogHeading(spin){\n\t\tthis.speed[3]+=spin;\n\t}\n\n\tjogZoom(deltaZoom){\n\t\tthis.speed[2]+=0.2*deltaZoom;\n\t}\n\t\t\n\ttickGamepads(){\n\t\tconst axis=this.gameAxis;\n\t\tconst buttons=this.gameButtons;\n\n\t\tconst previous=this.gamePrevious;\n\t\tthis.gamePrevious=buttons.slice();\n\n\t\tconst rx=axis[2];\n\t\tconst spin=-rx*rx*rx*50;\n//\t\tthis.heading+=spin;\n\n\t\tthis.jogHeading(spin);\n\n\t\tif(!previous[4] && buttons[4]) \n\t\t\tthis.jogTilt(1);\n\t\tif(!previous[5] && buttons[5]) \n\t\t\tthis.jogTilt(-1);\n\n\t\tthis.jogZoom((buttons[6]-buttons[7]));\n//\t\tthis.jogZoom(axis[3]*0.25);\n\t\tthis.jogDolly(axis[0],axis[1]);\n\t}\n\n    onKeyHit(){\t\t\n\t}\n\n\ttoggleTilt(){\n\t\tthis.tilt=MaxTilt-this.tilt;\n\t}\n\n    animate(){\n\t\tif(this.graphics){\t\t\t\n\t\t\tthis.graphics.compilePanels();\n//\t\tthis.refreshGraphiscs();\n\n\t\t\tthis.pumpEvents();\n\n\t\t\tthis.updateFrames(1);\n\n\t\t\tif(this.panelLayers){\n\t\t\t\tconst view0=this.panelLayers.view0;\n\n\t\t\t\tconst tilt=this.tilt;\n\t\t\t\tconst rot=this.heading*Math.PI/32768;\n\t\t\t\tconst scale=100/this.zoom;\n\n\t\t\t\tconst vx=this.position[0];\n\t\t\t\tconst vy=this.position[1];\n\t\t\t\tconst altitude=0;\n\n\t\t\t\tconst hfac=0.1;\n\t\t\t\tview0.isoView(vx,vy,scale,rot,tilt,altitude,hfac);\n\n\t\t\t\tconst can=this.canvas;\n\t\t\t\tconst width=can.width;\n\t\t\t\tconst height=can.height;\n\t\t\n\t\t\t\tview0.refreshView(width,height);\n\n\t\t\t\tthis.graphics.render();\n\t\t\t}\n\n\t\t}\n\t\twindow.requestAnimationFrame(this.animate.bind(this))\t\n\t}\n\n\tonWindowResize(){\n        this.refreshCanvas();\n    }\n\n    refreshCanvas(){\n\t\tconst r=window.devicePixelRatio;\n\t\tconst w=window.innerWidth;\n\t\tconst h=window.innerHeight;\n\t\tconst width=(w*r)&-2;\n\t\tconst height=(h*r)&-2;\n\t\tthis.aspect=w/h;\n\t\tthis.pixelSize=r;\n\t\tconst can=this.canvas;\n\t\tif(can){\n\t\t\tcan.style.width=w+\"px\";\n\t\t\tcan.style.height=h+\"px\";\n\t\t\tcan.width=width;\n\t\t\tcan.height=height;\n\t\t}\n\t\tthis.dirty=true;\n\t\tthis.mousedown=false;\n\t\tSetStatus(\"res:\"+width+\"x\"+height+\" pixel:\"+r);\n\n\t}\n}\n\n\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_topo.js\",\"length\":34296,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_topo.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n//  TopoTile Pixelmap Bumpmap PixelLoader HtmlImage Point\r\n\r\n\"use strict\"\r\n\r\nconst GroundPen=1;\r\n\r\nlet ScratchCount=0;\r\nlet WallCount=0;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\n\r\nconst WallSize=1024;// simon come here 2048;\r\nconst TileSize=2048;\r\n\r\nconst OutlineColor=\"#04c\";\r\nconst FillStyle=\"#00f\";\r\n\r\nconst GridStyle=\"#048\";\r\nconst _GridAlpha=0.4;\r\nconst _GridThick=0.2;\r\n\r\nconst CursorStyle=\"#ff8\";\r\n\r\nconst TopoMipName=[\"sd-\",\"\",\"hd-\"]\r\n\r\nconst mapStyle={\r\n\tLAND:{thick:2,fill:\"#030\"},\r\n\tCOAST:{thick:10},\r\n\tCONTOUR:{thick:0.4},\r\n\tROAD:{thick:0.2,style:\"#888\"},\r\n\tRAIL:{thick:1.8,style:\"#882\"},\r\n\tBRIDGE:{thick:3},\r\n\tTRAILS:{thick:0},\r\n\tTARMAC:{thick:3},\r\n\tROOF:{thick:3.6,style:\"#000\",fill:\"#333\"},\r\n\tPARCEL:{thick:0.3},\r\n\tTRANSIT:{thick:2.6,style:\"#26a\"}, //,fill:\"#444\"}\r\n\tROAD1:{thick:0.2,style:\"#800\"},\r\n\tPOI:{thick:3,style:\"#cf2\"}\r\n}\r\n\r\nfunction Log2(n){\r\n\tif(n<0){\r\n\t\tdebugger;\r\n\t}\r\n\tlet result=0;\r\n\twhile(n){\r\n\t\tn>>=1;\r\n\t\tresult++;\r\n\t}\r\n\treturn result;\r\n}\r\n\r\nclass Pixelmap{\r\n\tconstructor(imagedata){\r\n\t\tconst bytes=imagedata.data;\r\n\t\tconst rgb=new Array(TileSize*TileSize);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<TileSize;y++){\r\n\t\t\tfor(let x=0;x<TileSize;x++){\r\n\t\t\t\tconst _rgb1=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.rgb=rgb;\r\n\t}\r\n}\r\n\r\nlet BumpCache={1:[],129:[],513:[],1025:[],2049:[]};\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n//\tconst cache=BumpCache[res];\r\n//\tconst map=cache.length?cache.pop():new Bumpmap(res);\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\n\r\nfunction RecycleBumpmap(bumpmap){\r\n\tbumpmap.clear();\r\n\tconst res=bumpmap.resolution;\r\n\tBumpCache[res].push(bumpmap);\r\n}\r\n\r\nclass Bumpmap{\r\n\treset(res){\r\n\t\tthis.resolution=res;\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.resolution=Math.sqrt(res);\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\t// todo: test me\r\n\t\t\ttopo[0]=-0x4000+SeaLevel;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tlakeLine(waterLevel){\r\n\t\tconst lakeLevel=waterLevel-1000;\r\n\t\tconst t=this.topo;\r\n\t\tconst g=this.ground;\r\n\t\tlet n=0;\r\n\t\tconst count=this.resolution*this.resolution;\r\n\t\tfor(let i=0;i<count;i++){\r\n\t\t\tif (t[i]<=waterLevel){\r\n\t\t\t\tn++;\r\n\t\t\t\tt[i]=lakeLevel;\r\n\t\t\t}\r\n\t\t}\r\n//\t\tconsole.log(\"lakeline\",n)\r\n\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let i=0;i<res*res;i++){\r\n\t\t\tlet h=topo[i];\r\n\t\t\tif(h==0){\r\n\t\t\t\ttopo[i]=1000-TopoLevel;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tprocessOutline(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0){\r\n\t\t\th=this.topo[i];\r\n\t\t}\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\nclass PixelLoader{\r\n\tconstructor(){\r\n\t\tthis.canvas=document.createElement('canvas');\r\n\t\tthis.canvas.width=TileSize;\r\n\t\tthis.canvas.height=TileSize;\r\n\t\tthis.context=this.canvas.getContext('2d');\r\n\t}\r\n\timageRGBPixels(image){\r\n\t\tthis.context.clearRect(0,0,TileSize,TileSize);\r\n\t\tthis.context.drawImage(image,0,0);\r\n\t\tconst imagedata=this.context.getImageData(0,0,TileSize,TileSize);\r\n\t\treturn new Pixelmap(imagedata);\r\n\t}\r\n}\r\n\r\nclass HtmlImage{\r\n\r\n\t// leyer is a source entry from tilemaps.json\r\n\r\n\tconstructor(tile,layer,partial){\r\n\t\tthis.tile=tile;\r\n\t\tthis.layer=layer;\r\n\t\tthis.partial=partial;\r\n\t\tconst image=new Image();\r\n\t\timage.crossOrigin=\"anonymous\";\r\n\t\timage.onload=this.imageLoad.bind(this);\r\n\t\timage.onerror=this.imageError.bind(this);\r\n\t\tthis.image=image;\r\n\t}\r\n\r\n\timageLoad(){\r\n\t\tthis.loaded=true;\r\n\t\tthis.tile.dirty=true;\r\n\t\tthis.tile.addImage(this);\r\n//\t\tif(this.layer==0){\r\n//\t\t\tthis.colormap=PixelLoader.imageRGBPixels(this.image);\r\n//\t\t\tthis.tile.setBasemap(this.image);\r\n//\t\t}\r\n\t}\r\n\r\n\timageError(errorevent){\r\n\t\tconsole.log(\"imageError:\",this.image.src,errorevent.message);\r\n\t}\r\n\r\n\tload(src){\r\n\t\tthis.image.src=src;\r\n\t}\r\n}\r\n\r\n// simon come here and allocate baker workers to bake\r\n\r\n\r\nclass Instance{\r\n\r\n}\r\n\r\nclass Bake{\r\n\r\n\tinit(workerCount){\r\n\t\tconsole.log(\"[BAKE] init\",workerCount)\r\n\t\tconst bakers=[];\r\n\t\tfor(let i=0;i<workerCount;i++){\r\n\t\t\tconst baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\t\tbakers.push(baker);\r\n\t\t}\r\n\t\tthis.bakers=bakers;\r\n\t}\r\n\r\n\tlisten(instance){\r\n\r\n\t}\r\n}\r\n\r\n// todo; TileInstance v TopoProcess\r\n\r\nclass TileInstance{\r\n\tconstructor(tile){\r\n\t\tthis.heightmaps=[];\r\n\t\tthis.tile=tile;\r\n//\t\tconsole.log(\"[WIRE] instance\",tile);\r\n\t\tthis.baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\tthis.baker.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\t// e.data is script - an array of line objects that include a command field\r\n\r\n\tpost(message,transfer){\r\n\t\tthis.baker.postMessage(message,transfer);\r\n\t}\r\n\r\n\tterminate(){\r\n\t\tthis.baker.terminate();\r\n\t\t// simon come here and recylcled typed arrays\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\r\n\tonMessage(e){\r\n\t\tconst script=e.data;\r\n\t\tfor(const line of script){\r\n\t\t\tswitch (line.command){\r\n\t\t\t\tcase \"flora\":\r\n\t\t\t\t\tthis.tile.onFlora(line.verts,line.indices);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"bump\":\r\n\t\t\t\t\tthis.tile.onBump(line.topo,line.diff,line.ground);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tbakeTopo(count){\r\n\t\tconst message=[{command:\"bake\",value:count}];\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\trawLoad(raw){\r\n\t\tthis.heightmaps.push(raw);\r\n\t\tconst message=[{command:\"heightmap\",array:raw}];\r\n\t\tconst transfer=[raw.buffer];\r\n//\t\tthis.baker.postMessage(message,transfer);\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\t// support merge or multiple heightmaps here\r\n\r\n\tcreateTopo(){\r\n\t\tconst bytes=this.heightmaps[0]||[];\r\n\t\tthis.heightmap=AllocBumpmap(bytes);\r\n\t\tthis.heightmap.setBytes(bytes);\r\n\t\tfor(let i=1;i<this.heightmaps.length;i++){\r\n\t\t\tthis.heightmap.orBytes(this.heightmaps[i]);\r\n\t\t}\r\n\t\tthis.heightmap.heal();\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\tbakeTile2(tile){\r\n\t\ttile.createTopo();\r\n\t\tconst topo=CreateTopoSurface(128,16,0,tile.heightmap);\r\n\t\ttopo.calcNormals();\r\n\t\ttile.topoSurface=topo;\r\n\t}\r\n}\r\n\r\nlet _PostCount=0;\r\nlet _PostLoads=0;\r\n\r\n// pickHeight pickElevation maxHeight retire fetch request loadTileImage redrawTile\r\n// drawOutline drawFilled drawBox drawDiagram \r\n// layer was source level is now resolution\r\n\r\nclass TopoTile{\r\n\r\n\tconstructor(grid,level,x,y){\r\n\r\n\t\tthis.hasBaker=true;\t\t// false debug mode - release make true;\r\n\t\tthis.flushed=false;\r\n\t\tthis.baker=null;\r\n\r\n\t\t// 2026 - heightmaps is back for no baker mode\r\n\t\tthis.heightmaps=[];\r\n\r\n//\t\tthis.sourceLayers=[];\t// have extensions\r\n\t\tthis.topogrid=grid;\r\n\t\tthis.level=level;\r\n\t\tthis.x=x;\r\n\t\tthis.y=y;\r\n\t\tthis.name=\".\"+level+\",\"+x+\",\"+y;\r\n\r\n\t\tthis.imageCount=0;\r\n\t\tthis.topoCount=0;\r\n\t\tthis.drawingCount=0;\r\n\t\tthis.posts=[];\r\n\t\tthis.drawings=[];\r\n\t\tthis.imageStack=[];\r\n\r\n\t\tthis.dirty=false;\r\n\t\tthis.fetched=false;\r\n\t\tthis.ready=false;\r\n\t\tthis.fresh=0;\r\n\t\tthis.retired=false;\r\n\r\n\t\tthis.heightmap=null;\r\n\t\tthis.basemap=null;\r\n\t\tthis.scratch=null;\r\n\t\tthis.wallmap=null;\r\n\t\tthis.tilemesh=null;\r\n\t\tthis.staticmeesh=[];\r\n\t\tthis.flatmeesh=[];\r\n\t//\troofs=[]\r\n\t\tthis.wallx=0;\r\n\t\tthis.wally=0;\r\n\t\tthis.wallhi=0;\r\n\t}\r\n\r\n\tflushMesh(){\r\n\t\tif(this.flushed){\r\n\t\t\t// simon come here and fix sanity test\r\n//\t\t\tdebugger;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tthis.flushed=true;\r\n\t\tif(this.hasBaker){\r\n\t\t\tif(this.instance){\r\n\t\t\t\tthis.instance.terminate();\r\n\t\t\t}\r\n\t\t\tthis.instance=null;\r\n\t\t}\r\n\t\tif(this.tilemesh){\r\n\t\t\tthis.tilemesh.flushBuffers();\r\n\t\t\tthis.tilemesh.flushTextures();\r\n\t\t\tthis.tilemesh=null;\r\n\t\t}\r\n\t\tif(this.floramesh){\r\n\t\t\tthis.floramesh.flushBuffers();\r\n\t\t\tthis.floramesh.flushTextures();\r\n\t\t\tthis.floramesh=null;\r\n\t\t}\r\n\t\tfor(const mesh of this.staticmeesh){\r\n\t\t\tmesh.flushBuffers();\r\n\t\t\tmesh.flushTextures();\r\n\t\t}\r\n\t\tthis.staticmeesh=[];\r\n\t\tfor(const mesh of this.flatmeesh){\r\n\t\t\tmesh.flushBuffers();\r\n\t\t}\r\n\t\tthis.flatmeesh=[];\r\n\t}\r\n\r\n\tcropOutline(outline,height){\r\n\t\tconst bits=outlinePoints(outline);\r\n\t\tbits.cropTopo(topo,height);\r\n\t}\r\n\r\n\toutlinePoints(){\r\n\t\tlet xmin=1e9;\r\n\t\tlet xmax=-1e9;\r\n\t\tlet ymin=1e9;\r\n\t\tlet ymax=-1e9;\r\n\t\tlet zmin=1e9;\r\n\t\tlet zmax=-1e9;\r\n\t\tconst pts=[];\r\n\t\tconst n=outline.length;\r\n\t\tfor(let w=0;w<n;w++){\r\n\t\t\tconst o=outline[w];\r\n\t\t\tconst x=(o[0]/2)|0;\r\n\t\t\tconst y=(o[1]/2)|0;\t\t\r\n\t\t\tymin=Math.min(ymin,y);\r\n\t\t\tymax=Math.max(ymax,y);\r\n\t\t\txmin=Math.min(xmin,x);\r\n\t\t\txmax=Math.max(xmax,x);\r\n\t\t\tpts.push([x,y]);\t\r\n\t\t}\r\n\t\tconst width=(xmax-xmin)|0;\r\n\t\tconst height=(ymax-ymin)|0;\r\n\t\tconst bits=new Bits(width,height,xmin,ymin);\r\n\t\tbits.poly(pts);\r\n\t\treturn bits;\r\n\t}\r\n\r\n\tfloodLake(x,y){\r\n\t\tconst topo=this.heightmap;\r\n\t\tconst pick=topo.pickTopo(x|0,y|0)\t\t\r\n\t\tconst h0=pick.min;\r\n\t\ttopo.lakeLine(h0);\r\n//\t\tconst h1=topo.pickHeight(x,y);\r\n\t}\r\n\r\n\tdigOutline(outline,deep,border){\r\n\t\tconst topo=this.heightmap;\r\n\t\tlet xmin=1e9;\r\n\t\tlet xmax=-1e9;\r\n\t\tlet ymin=1e9;\r\n\t\tlet ymax=-1e9;\r\n\t\tlet zmin=1e9;\r\n\t\tlet zmax=-1e9;\r\n\t\tconst pts=[];\r\n\t\tconst n=outline.length;\r\n\t\tfor(let w=0;w<n;w++){\r\n\t\t\tconst o=outline[w];\r\n\t\t\tconst x=(o[0]/2)|0;\r\n\t\t\tconst y=(o[1]/2)|0;\r\n\t\t\t// todo: change to lowest\r\n//\t\t\tconst h0=topo.pickElevation(x,y);\r\n\t\t\t\r\n\t\t\tconst h0=topo.pickTopo(x,y).min;\r\n\t\t\tconst h1=topo.pickHeight(x,y);\r\n\r\n\t\t\tzmin=Math.min(zmin,h0);\r\n\t\t\tzmax=Math.max(zmax,h0+h1);\r\n\t\t\tymin=Math.min(ymin,y);\r\n\t\t\tymax=Math.max(ymax,y);\r\n\t\t\txmin=Math.min(xmin,x);\r\n\t\t\txmax=Math.max(xmax,x);\r\n\t\t\tpts.push([x,y]);\t\r\n\t\t}\r\n\t\tconst width=(xmax-xmin)|0;\r\n\t\tconst height=(ymax-ymin)|0;\r\n\t\tconst depth=(zmin-deep)|0;\r\n\t\tconst bits=new Bits(width,height,xmin,ymin);\r\n\t\tbits.poly(pts);\r\n\t\tbits.digTopo(topo,depth,border);\r\n\t}\r\n\r\n\tallocWallPixels(w,h){\r\n\t\tw|=0;\r\n\t\th|=0;\r\n\t\tif(this.wallx+w>WallSize){\r\n\t\t\tthis.wallx=0;\r\n\t\t\tthis.wally+=this.wallhi;\r\n\t\t\tthis.wallhi=0;\r\n\t\t}\r\n\t\tconst x=this.wallx;\r\n\t\tthis.wallx+=w;\r\n\t\tconst y=this.wally;\r\n\t\treturn({x,y,w,h});\r\n\t}\r\n\r\n\tallocWallmap(){\r\n\t\tconst w=WallSize;\r\n\t\tconst h=WallSize;//this.wally+this.wallhi;\r\n\t\tconst src=\"wall\"+(++WallCount);//this.basemap.src;\r\n\t\tconst can=document.createElement('canvas');\r\n\t\tcan.width=w;\r\n\t\tcan.height=h;\r\n\t\tcan.src=src;\r\n\t\tcan.id=src;\r\n\t\tconst context=can.getContext(\"2d\",{antialias:false});\r\n\t\tcontext.fillStyle=\"green\";\r\n\t\tcontext.fillRect(0,0,w,h);\r\n\t\tcontext.fillStyle=\"white\";\r\n\t\tfor(let i=0;i<WallSize;i+=16){\r\n\t\t\tcontext.fillRect(0,i,w,1);\r\n\t\t\tcontext.fillRect(i,0,1,h);\r\n\t\t}\r\n\t\tthis.setWallmap(can);\r\n\t}\r\n\r\n\tonFlora(verts,indices){\r\n\t\tthis.floraSurface=new Surface(verts,indices,[]);\r\n\t}\r\n\r\n\tonBump(topo,diff,ground){\r\n\t\tconst bump=new Bumpmap(); \r\n\t\tbump.create(topo,diff,ground);\r\n\t\tthis.setHeightmap(bump);\r\n//\t\tthis.heightmap=bump;\r\n\t\tconst surface=CreateTopoSurface(128,16,GroundPen,bump);\r\n// simon come here and clean up magic numbers\r\n\t\tconst zfactor=4.6/(this.level*8.0);\r\n\t\tsurface.calcNormals(zfactor);\r\n//\t\tsurface.fuzzNormals();\r\n\t\tthis.topoSurface=surface;\r\n\t}\r\n\r\n\thasLoaded(){\r\n\t\tlet topoReady=false;\r\n\t\tif(this.hasBaker){\r\n\t\t\ttopoReady=this.heightmap && this.floraSurface;\r\n\t\t}else{\r\n\t\t\ttopoReady=this.heightmap && (this.topoCount==this.heightmaps.length);\r\n\t\t}\r\n\r\n\t\treturn this.ready\r\n\t\t\t&& topoReady\r\n//\t\t\t&& this.heightmap\r\n//\t\t\t&& this.topoCount==this.heightmaps.length\r\n\t\t\t&& this.imageCount==this.imageStack.length \r\n\t\t\t&& this.drawingCount==this.drawings.length;\r\n\t}\r\n\r\n\tsetHeightmap(bump){\r\n\t\tthis.heightmap=bump;\r\n\t\tthis.topogrid.addTerrain(this);\r\n\t}\r\n\r\n\tsetWallmap(wallmap){\r\n\t\tthis.wallmap=wallmap;\r\n\t}\r\n\r\n\taddImage(image){\r\n\t\tconst layer=image.layer;\r\n\t\tconst basemap=layer.attributes && layer.attributes[\"basemap\"];\r\n\t\tif(basemap){\r\n\t\t\tthis.setBasemap(image.image);\r\n\t\t}\r\n\t\tthis.imageCount++;\r\n\t}\r\n\r\n\tsetBasemap(basemap){\r\n\t\tthis.basemap=basemap;\r\n\t}\r\n\r\n\t// simon come here and don't crash if flushed\r\n\r\n\tonRawLoad(url,buffer){\t\t\r\n\t\tconst bytes=new Uint8Array(buffer);\r\n\t\tif(this.hasBaker && this.instance){\r\n\t\t\tthis.instance.rawLoad(bytes);\r\n\t\t}else{\r\n\t\t\t// simon come here - debug should not need web workers\r\n\t\t\tconsole.log(\"[TOPO] web workers needed\");\r\n\t\t}\t\t\t\r\n\t}\r\n\r\n\tcreateTopo(){\r\n\t\tconst bytes=this.heightmaps[0]||[];\r\n\t\tthis.heightmap=AllocBumpmap(bytes);\r\n\t\tthis.heightmap.setBytes(bytes);\r\n\t\tfor(let i=1;i<this.heightmaps.length;i++){\r\n\t\t\tthis.heightmap.orBytes(this.heightmaps[i]);\r\n\t\t}\r\n\t\tthis.heightmap.heal();\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\tscratchGrid16(){\r\n\t\tconst scratch=this.scratch;\r\n\t\tconst context=scratch.getContext(\"2d\",{antialias:false});\r\n\t\tcontext.beginPath();\r\n\t\tcontext.lineWidth=0.5;\r\n\t\tcontext.strokeStyle=\"white\";\r\n\t\tconst w=scratch.width;\r\n\t\tconst h=scratch.height;\r\n\t\tconst f=2;\r\n\t\tfor(let x=0;x<w+16;x+=16){\r\n\t\t\tfor(let y=0;y<h+8;y+=8){\r\n\t\t\t\tcontext.moveTo(x,y+4);\r\n\t\t\t\tcontext.lineTo(x+f,y);\r\n\r\n\t\t\t\tcontext.moveTo(x+f,y);\r\n\t\t\t\tcontext.lineTo(x+8,y);\r\n\r\n\t\t\t\tcontext.moveTo(x+8,y);\r\n\t\t\t\tcontext.lineTo(x+8+f,y+4);\r\n\r\n\t\t\t\tcontext.moveTo(x+8+f,y+4);\r\n\t