balAlpha=1.0; \r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n/*\r\n\t\t\t\tcontext.globalAlpha=0.5; \r\n\t\t\t\tcontext.strokeStyle=\"pink\";\r\n\t\t\t\tcontext.lineWidth=1.4;\r\n\t\t\t\tcontext.beginPath();\r\n\t\t\t\tfor(const surface of powergrid){\r\n\t\t\t\t\tDrawSurface(context,surface);\r\n\t\t\t\t}\r\n\t\t\t\tcontext.stroke();\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n*/\t\t\t\t\r\n\t\t\t}\r\n\r\n\t\t\tif(build_coast){\r\n\t\t\t\tconst coastSurfaces=[];\r\n\t\t\t\tfor(const coast of coasts){\r\n\t\t\t\t\tconst start=coast.start;\r\n\t\t\t\t\tconst count=coast.count;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\tconst surface=this.buildCoast(tile,outline);\r\n\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\tcoastSurfaces.push(surface);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.globalAlpha=0.8; \r\n\t\t\t\tcontext.strokeStyle=\"#025\";\r\n\t\t\t\tcontext.lineWidth=1.4;\r\n\t\t\t\tcontext.beginPath();\r\n\t\t\t\tfor(const surface of coastSurfaces){\r\n\t\t\t\t\tDrawSurface(context,surface);\r\n\t\t\t\t}\r\n\t\t\t\tcontext.stroke();\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\t\t\t}\r\n\r\n\t\t\tif(build_roof2 && roofs.length){\r\n\t\t\t\tconst roofSurfaces=[];\r\n\t\t\t\tthis.wallPixels=0;\r\n\t\t\t\tcontext.save();\r\n\t\t\t\tcontext.beginPath();\r\n\t\t\t\tfor(const roof of roofs){\r\n\t\t\t\t\tconst start=roof.start;\r\n\t\t\t\t\tconst count=roof.count;\r\n\t\t\t\t\tconst walls=roof.walls;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n//\t\t\t\t\t\tTraceClosedOutline(context,outline);\r\n\t\t\t\t\t\tif(build_walls_geom){\r\n\t\t\t\t\t\t\tconst surface=this.buildWalls(tile,outline);\r\n\t\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\t\troofSurfaces.push(surface);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(build_roof_geom){\r\n\t\t\t\t\t\t\tconst surface=this.buildRoof(tile,outline);\r\n\t\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\t\troofSurfaces.push(surface);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tif(build_roof_basement){\r\n\t\t\t\t\t\t\ttile.digOutline(outline,BasementDepth,40);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.clip();\r\n\r\n\t\t\t\tcontext.fillStyle=\"#555\";\t// basement color\r\n\r\n\t\t\t\tconst res=AppPlatform.ScratchRes;\r\n\t\t\t\tcontext.fillRect(0,0,res,res);\r\n//\t\t\t\tcontext.clearRect(0,0,res,res);\r\n\t\t\t\tcontext.restore();\r\n\r\n\t\t\t\tconst pixels=((this.wallPixels/1e6)|0);\r\n\t\t\t\tif(pixels){\r\n\t\t\t\t\tconsole.log(\"tile roof wall MegaPixels \"+pixels);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tcontext.globalAlpha=0.32; \r\n\r\n\t\t\t\tcontext.strokeStyle=\"goldenrod\";\r\n\t\t\t\tcontext.lineWidth=0.5;\r\n\t\t\t\tcontext.beginPath();\r\n\r\n\t\t\t\tfor(const surface of roofSurfaces){\r\n\t\t\t\t\tDrawSurface(context,surface);\r\n\t\t\t\t}\r\n\t\t\t\tcontext.stroke();\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\r\n\t\t\t\tsurfaces=surfaces.concat(roofSurfaces);\r\n\t\t\t}\r\n\r\n\t\t\tif(build_transit && transit.length){\r\n\r\n\t\t\t\tif(true){\r\n\r\n\t\t\t\t}else{\r\n\t\t\t\t\tconst transitSurfaces=[];\r\n\t\t\t\t\tfor(const block of transit){\r\n\t\t\t\t\t\tconst start=block.start;\r\n\t\t\t\t\t\tconst count=block.count;\r\n\t\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\t\tconst surface=this.buildTransit(tile,outline);\r\n\t\t\t\t\t\t\tif(surface){\r\n\t\t\t\t\t\t\t\ttransitSurfaces.push(surface);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontext.globalAlpha=0.5; \r\n\t\t\t\t\tcontext.strokeStyle=\"blue\";\r\n\t\t\t\t\tcontext.lineWidth=1.4;\r\n\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\tfor(const surface of transitSurfaces){\r\n\t\t\t\t\t\tDrawSurface(context,surface);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcontext.stroke();\r\n\t\t\t\t\tcontext.globalAlpha=1.0; \r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\treturn surfaces;\r\n\t}\r\n}\r\n\r\n\r\nclass PointCloud{\r\n\tconstructor(w,h,x,y){\t\t\r\n\t\tthis.clear(w,h,x,y)\r\n\t}\r\n\r\n\tclear(w,h,x,y){\r\n\t\tw=1+((w+15)/16)|0;\r\n\t\th=1+((h+15)/16)|0;\r\n\t\tthis.offsetX=x;\r\n\t\tthis.offsetY=y;\r\n\t\tthis.width=w;\t//dimension of pointcloud (box/16)\r\n\t\tthis.height=h;\r\n\t\tconst pointmap=[];\r\n\t\tlet n=w*h;\r\n\t\twhile(n--) pointmap.push([]);\r\n\t\tthis.pointMap=pointmap;\t\t\r\n\t\tthis.points=[];\r\n\t\tthis.inside=true;\r\n\t\tthis.exit=0;\r\n\t\tthis.recent=[0,0];\r\n\t}\r\n\r\n\taddPoint(x,y,u){\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tconst px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tconst py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tconst index=py*this.width+px;\r\n\t\tconst i=this.points.length;\r\n\t\tconst p=[x,y,i,u];\r\n\t\tthis.points.push(p);\r\n\t\tif(index<0||index>=this.pointMap.length){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tthis.pointMap[index].push(p);\r\n\t\treturn i;\r\n\t}\r\n\r\n\taddraw(x,y){\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tlet px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tlet py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px<0) px=0;\r\n\t\tif(py<0) py=0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tconst index=py*w+px;\r\n\t\tconst i=this.points.length;\r\n\t\tconst p=[x,y,i,0,0];\r\n\t\tthis.points.push(p);\r\n\t\tif(index<0||index>=this.pointMap.length){\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t\tthis.pointMap[index].push(p);\r\n\t\tthis.recent=p;\r\n\t\treturn i;\r\n\t}\r\n\r\n\r\n\tsplit2(a,b){\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst x2=(x0+x1)/2;\r\n\t\tconst y2=(y0+y1)/2;\r\n\t\tconst v=this.addraw(x2,y2);\r\n\t\treturn v;\r\n\t}\r\n\r\n\tsplit3(a,b,c){\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n\t\tconst p2=this.points[c];\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst x2=p2[0];\r\n\t\tconst y2=p2[1];\r\n\t\tconst x3=x1+(x0+x2-2*x1)*0.6;\r\n\t\tconst y3=y1+(y0+y2-2*y1)*0.6;\r\n\t\tconst v=this.addraw(x3,y3);\r\n\t\treturn v;\r\n\t}\r\n\r\n\t// a,b are along edge\r\n\t// returns new point if equalat safe from others\r\n\r\n\ttriangulate2(a,b,c){\r\n\t\tconst e=0.866;\r\n\t\tconst e1=0.5;\r\n\t\tconst e2=1.0;\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n//\t\tconst p2=c?this.points[c]:null;\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst dx=x1-x0;\r\n\t\tconst dy=y1-y0;\r\n\t\tconst dd=dx*dx+dy*dy;\t\t\r\n\t\tlet isnew=false;\r\n\t\tlet v=-1;\r\n\t\tif(dd>0){\r\n\t\t\tconst x2=(x0+x1)/2-e1*dy;\r\n\t\t\tconst y2=(y0+y1)/2+e1*dx;\r\n\t\t\tconst target2=this.closest(x2,y2,-1);\r\n\t\t\tconst v2=target2.vertex;\r\n\r\n\t\t\tconst x3=(x0+x1)/2-e2*dy;\r\n\t\t\tconst y3=(y0+y1)/2+e2*dx;\r\n\t\t\tconst target3=this.closest(x3,y3,-1);\r\n\t\t\tconst v3=target3.vertex;\r\n\r\n\t\t\tif(v3!=a&&v3!=b&&v3!=c){//||target.distance>3){\r\n\t\t\t\tv=v3;\r\n\t\t\t}else{\r\n\t\t\t\tif(v2==a||v2==b){//||target.distance>3){\r\n\t\t\t\t\tconst x4=(x0+x1)/2-e*dy;\r\n\t\t\t\t\tconst y4=(y0+y1)/2+e*dx;\r\n\t\t\t\t\tv=this.addraw(x4,y4);\r\n\t\t\t\t\tisnew=true;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tv=v2;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {v,isnew}\r\n\t}\r\n\r\n\ttriangulate(a,b){\r\n\t\tconst e=0.866;\r\n\t\tconst e1=0.5;\r\n\t\tconst p0=this.points[a];\r\n\t\tconst p1=this.points[b];\r\n//\t\tconst p2=c?this.points[c]:null;\r\n\t\tconst x0=p0[0];\r\n\t\tconst y0=p0[1];\r\n\t\tconst x1=p1[0];\r\n\t\tconst y1=p1[1];\r\n\t\tconst dx=x1-x0;\r\n\t\tconst dy=y1-y0;\r\n\t\tconst dd=dx*dx+dy*dy;\t\t\r\n\t\tlet isnew=false;\r\n\t\tlet v=-1;\r\n\t\tif(dd>0){\r\n\t\t\tconst x2=(x0+x1)/2-e1*dy;\r\n\t\t\tconst y2=(y0+y1)/2+e1*dx;\r\n\t\t\tconst target2=this.closest(x2,y2,-1);\r\n\t\t\tconst v2=target2.vertex;\r\n\t\t\tif(v2==a||v2==b||target2.distance>3){\r\n\t\t\t\tconst x4=(x0+x1)/2-e*dy;\r\n\t\t\t\tconst y4=(y0+y1)/2+e*dx;\r\n\t\t\t\tv=this.addraw(x4,y4);\r\n\t\t\t\tisnew=true;\r\n\t\t\t}else{\r\n\t\t\t\tv=v2;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {v,isnew}\r\n\t}\r\n\r\n\tweld(a,b){\r\n\t\tconst pts=this.points;\r\n\t\tconst x=(pts[a][0]+pts[b][0])/2;\r\n\t\tconst y=(pts[a][1]+pts[b][1])/2;\r\n\t\tpts[a][0]=x;\r\n\t\tpts[b][0]=x;\r\n\t\tpts[a][1]=y;\r\n\t\tpts[b][1]=y;\r\n\t}\r\n\r\n\t// fat search -2..2 in pointmap\r\n\r\n\tclosestEdge(edge,x,y,c){\r\n\t\tlet vertex=-1;\r\n\t\tlet distance=1e9;\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tlet px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tlet py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px<0) px=0;\r\n\t\tif(py<0) py=0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tfor(let sy=-2;sy<3;sy++){\r\n\t\t\tconst psy=py+sy;\r\n\t\t\tif(psy<0) continue;\r\n\t\t\tif(psy>=h) continue;\t\t\r\n\t\t\tfor(let sx=-2;sx<3;sx++){\r\n\t\t\t\tconst psx=px+sx;\r\n\t\t\t\tif(psx<0) continue;\r\n\t\t\t\tif(psx>=w) continue;\r\n\t\t\t\tconst index=psy*w+psx;\r\n\t\t\t\tfor(const p of this.pointMap[index]){\r\n\t\t\t\t\tconst vert=p[2];\r\n\t\t\t\t\tif(vert!=c && edge.includes(vert)){\r\n\t\t\t\t\t\tconst dx=p[0]-x;\r\n\t\t\t\t\t\tconst dy=p[1]-y;\r\n\t\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\t\tif(dd<distance){\r\n\t\t\t\t\t\t\tdistance=dd;\r\n\t\t\t\t\t\t\tvertex=vert;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {vertex,distance};\r\n\t}\r\n\r\n\tclosest(x,y,c){\r\n\t\tlet vertex=-1;\r\n\t\tlet distance=1e9;\r\n\t\tconst w=this.width;\r\n\t\tconst h=this.height;\r\n\t\tlet px=((x-this.offsetX)/PointCloudRes)|0;\r\n\t\tlet py=((y-this.offsetY)/PointCloudRes)|0;\r\n\t\tif(px<0) px=0;\r\n\t\tif(py<0) py=0;\r\n\t\tif(px>w-1) px=w-1;\r\n\t\tif(py>h-1) py=h-1;\r\n\t\tfor(let sy=-1;sy<2;sy++){\r\n\t\t\tconst psy=py+sy;\r\n\t\t\tif(psy<0) continue;\r\n\t\t\tif(psy>=h) continue;\t\t\r\n\t\t\tfor(let sx=-1;sx<2;sx++){\r\n\t\t\t\tconst psx=px+sx;\r\n\t\t\t\tif(psx<0) continue;\r\n\t\t\t\tif(psx>=w) continue;\r\n\t\t\t\tconst index=psy*w+psx;\r\n\t\t\t\tfor(const p of this.pointMap[index]){\r\n\t\t\t\t\tif(p[2]!=c){\r\n\t\t\t\t\t\tconst dx=p[0]-x;\r\n\t\t\t\t\t\tconst dy=p[1]-y;\r\n\t\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\t\tif(dd<distance){\r\n\t\t\t\t\t\t\tdistance=dd;\r\n\t\t\t\t\t\t\tvertex=p[2];\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n//\t\tif(vertex==-1) debugger;\r\n\t\treturn {vertex,distance};\r\n\t}\r\n\r\n\tspiral(v,c,topo,measure,rings){\r\n\t\tlet u=0.0;\r\n\t\tconst verts=[];\r\n\t\tconst tris=[];\r\n\t\tconst points=this.points;\r\n\t\tconst n=v.length;\r\n\t\tlet list=[];\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst x0=v[i][0];\r\n\t\t\tconst y0=v[i][1];\r\n\t\t\tconst ii=(i+1);\r\n\t\t\tconst x1=v[ii][0];\r\n\t\t\tconst y1=v[ii][1];\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tconst div=(d/measure)|0;\r\n\t\t\tif(div>0){\r\n\t\t\t\tconst nn=(i==n-2)?div+1:div;\r\n\t\t\t\tfor(let j=0;j<nn;j++){\r\n\t\t\t\t\tconst px=x0+dx*j/div;\r\n\t\t\t\t\tconst py=y0+dy*j/div;\r\n//\t\t\t\t\tthis.addraw(px,py);\r\n\t\t\t\t\tconst v=this.addPoint(px,py,u);\r\n\t\t\t\t\tif(v!=-1) {\r\n\t\t\t\t\t\tlist.push(v);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t// simon come here and validate this\r\n\t\t\t\t\tu+=d/div;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tconst threshold=600;\r\n\t\tconst threshold2=250;\r\n\t\tfor(let ring=0;ring<rings;ring++){\r\n\t\t\tconst edge=[];\t//list of indexes with -1 separator\r\n\t\t\tconst count=list.length;\r\n\t\t\tlet prevt=-1;\r\n\t\t\tfor(let i=0;i<count-1;i++){\r\n\t\t\t\tconst t0=list[i];\t\t\t\t\r\n\t\t\t\tconst t1=list[i+1];\r\n\t\t\t\tif(t0==-1 || t1==-1) {\r\n\t\t\t\t\tprevt=-1;\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\tconst tt=this.triangulate(t0,t1,prevt);\r\n\t\t\t\tlet t=tt.v;\r\n\t\t\t\tif(t==-1){\r\n\t\t\t\t\tedge.push(-1);\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\r\n\t\t\t\ttris.push([t0,t,t1]);\r\n\t\t\t\tif(t==prevt){\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(!tt.isnew){\r\n\t\t\t\t\tedge.push(-1);\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tif(prevt>-1){//} && t!=prevt){\r\n\t\t\t\t\tconst p0=points[prevt];\r\n\t\t\t\t\tconst p1=points[t];\r\n\t\t\t\t\tif(!(p0&&p1)){\r\n\t\t\t\t\t\tdebugger;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tconst dx=p1[0]-p0[0];\r\n\t\t\t\t\tconst dy=p1[1]-p0[1];\r\n\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\tif(dd<threshold2){\r\n\t\t\t\t\t\tthis.weld(prevt,t);\r\n\r\n\t\t\t\t\t}else{\r\n\r\n\t\t\t\t\t\tif (dd<threshold){\r\n\t\t\t\t\t\t\ttris.push([t0,prevt,t]);\r\n\t\t\t\t\t\t\tedge.push(t);\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tconst t2=this.split3(prevt,t0,t);\r\n\t\t\t\t\t\t\tconst slice=points.slice(-2,-1);\r\n\t\t\t\t\t\t\tpoints.push(slice[0]);\r\n\t\t\t\t\t\t\tedge.push(t2);\r\n\t\t\t\t\t\t\tedge.push(t);\r\n\t\t\t\t\t\t\ttris.push([t0,prevt,t2]);\r\n\t\t\t\t\t\t\ttris.push([t0,t2,t]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\tprevt=t;\r\n\t\t\t}\r\n/*\r\n// weld members of edge\r\n\t\t\tconst count2=edge.length;\r\n\t\t\tprevt=-1;\r\n\t\t\tconst weld=[];\r\n\t\t\tfor(let i=1;i<count-1;i++){\r\n\t\t\t\tconst p0=edge[i-1];\r\n\t\t\t\tconst p1=edge[i];\r\n\t\t\t\tconst p2=edge[i+1];\r\n\t\t\t\tif(p1>-1){\r\n\t\t\t\t\tconst p=points[p1];\r\n\t\t\t\t\tconst c=this.closestEdge(edge,p[0],p[1],p[2]);\t// x,y,c(exclude)\r\n\t\t\t\t\tconst v=c.vertex;\r\n\t\t\t\t\tif(v==-1||v==p0||v==p2) continue;\r\n\t\t\t\t\tconst ii=edge.indexOf(v);\r\n\t\t\t\t\tweld.push([i,ii]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tconsole.log(\"welds:\"+weld.length);\r\n\t\t\tfor(const w of weld){\r\n\t\t\t\tconst w0=edge[w[0]];\r\n\t\t\t\tconst w1=edge[w[1]];\r\n\t\t\t\tthis.weld(w0,w1);\r\n\t\t\t}\r\n\t\t\tfor(const w of weld){\r\n\t\t\t\tedge[w[0]]=-1;\r\n\t\t\t\tedge[w[1]]=-1;\r\n\t\t\t}\r\n*/\r\n//\t\t\tconst log=edge.join();\r\n//\t\t\tconsole.log(\"edge:\",edge);\r\n\t\t\tlist=edge;\r\n\t\t}\r\n\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n\t\t\tconst h1=topo.pickHeight(px,py);\r\n\t\t\tverts.push([px,-py,h0+h1,3,0,0,0,c]);\r\n\t\t}\r\n\r\n\t\tif(verts.length&&tris.length){\r\n\t\t\treturn new Surface(verts,tris,[]);\r\n\t\t}\r\n\t}\r\n\r\n\twalledSpiral(v,roofc,wallc,topo,wallRect){\r\n\t\tconst age=1;//12//rings\r\n\t\tconst measure=5;//=5;\r\n\t\tconst verts=[];\r\n\t\tconst tris=[];\r\n\t\tconst points=this.points;\r\n\t\tconst n=v.length;\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst ii=i+1;\r\n\t\t\tif(v[i][3]&&v[ii][3]){\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tconst x0=v[i][0];\r\n\t\t\tconst y0=v[i][1];\r\n\t\t\tconst u0=v[i][2];\r\n\t\t\tconst x1=v[ii][0];\r\n\t\t\tconst y1=v[ii][1];\r\n\t\t\tconst u1=v[ii][2];\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst du=u1-u0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tconst div=(d/measure)|0;\r\n\t\t\tif(div>0){\r\n\t\t\t\tconst count=(ii==n-1)?div+1:div;\r\n\t\t\t\tfor(let j=0;j<count;j++){\r\n\t\t\t\t\tconst px=x0+dx*j/div;\r\n\t\t\t\t\tconst py=y0+dy*j/div;\r\n\t\t\t\t\tconst pu=u0+du*j/div;\r\n\t\t\t\t\tthis.addPoint(px,py,pu);\r\n\t\t\t\t}\r\n\t\t\t}\r\n//\t\t\tthis.close();\r\n\t\t}\r\n\t\tconst ww=points.length;\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst pu=p[2];\r\n\t\t\tconst g0=topo.pickGround(px,py);\r\n\t\t\tverts.push([px,-py,g0,pu,0,0,0,wallc]);\r\n\t\t}\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst pu=p[2];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n\t\t\tconst h1=topo.sampleHeight(px,py,2).max;\r\n\t\t\tverts.push([px,-py,h0+h1+16,pu,0,0,0,wallc]);\r\n\t\t}\r\n\t\tfor(let w=0;w<ww-1;w++){\r\n\t\t\ttris.push([w,w+ww,w+ww+1]);\r\n\t\t\ttris.push([w,w+ww+1,w+1]);\r\n\t\t}\r\n/*\r\n\t\tlet ground=verts.length;\r\n\t\tlet count=points.length;\r\n\t\tlet offset=0;\r\n\t\tfor(let ring=0;ring<age;ring++){\r\n\t\t\tlet prevt=-1;\r\n\t\t\tfor(let i=0;i<count-1;i++){\r\n\t\t\t\tconst ii=i+1;\r\n\t\t\t\tconst t0=offset+i;\r\n\t\t\t\tconst t1=offset+ii;\r\n\t\t\t\tconst tt=this.triangulate(t0,t1);\r\n\t\t\t\tlet t=tt.v;\r\n\t\t\t\tif(t==-1){\r\n//\t\t\t\t\tprevt=t;\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\tif(prevt>-1 && prevt!=t){\r\n\t\t\t\t\tconst p0=points[prevt];\r\n\t\t\t\t\tconst p1=points[t];\r\n\t\t\t\t\tif(!(p0&&p1)){\r\n\t\t\t\t\t\tdebugger;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tconst dx=p1[0]-p0[0];\r\n\t\t\t\t\tconst dy=p1[1]-p0[1];\r\n\t\t\t\t\tconst dd=dx*dx+dy*dy;\r\n\t\t\t\t\tif (dd<150){\r\n\t\t\t\t\t\ttris.push([ground+t0,ground+prevt,ground+t]);\r\n\t\t\t\t\t}else{ // fan from prevt to t\r\n\t\t\t\t\t\t// warning overly complicated insert method\r\n\t\t\t\t\t\tconst tt1=this.triangulate(prevt,t);\r\n\t\t\t\t\t\tif(tt1.isnew){\r\n\t\t\t\t\t\t\tconst slice=points.slice(-2,-1);\r\n\t\t\t\t\t\t\tpoints.push(slice[0]);\r\n\t\t\t\t\t\t\tconst t2=tt1.v;\r\n\t\t\t\t\t\t\ttris.push([ground+prevt,ground+t2,ground+t0]);\r\n\t\t\t\t\t\t\ttris.push([ground+t0,ground+t2,ground+t]);\r\n\t\t\t\t\t\t\tt=t2;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\ttris.push([ground+t0,ground+t,ground+t1]);\r\n\t\t\t\tif(tt.isnew){\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(prevt>-1){\r\n\t\t\t\t\t\ttris.push([ground+offset+i,ground+prevt,ground+t]);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n//\t\t\t\ttris.push([ground+offset+i,ground+t,ground+offset+ii]);\r\n\t\t\t\tprevt=t;\r\n\t\t\t}\t\t\r\n\t\t\toffset+=count;\r\n\t\t\tcount=points.length-offset;\r\n\t\t\tif(count==0){\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n//\t\t\tconst h1=topo.pickHeight(px,py);\r\n\t\t\tconst h1=topo.pickHeightMinMax(px,py).max;\r\n\t\t\tverts.push([px,-py,h0+h1,3,0,0,0,roofc]);\r\n\t\t}\r\n\t\t\r\n*/\r\n\t\tif(verts.length&&tris.length){\r\n\t\t\treturn new Surface(verts,tris,[]);\r\n\t\t}\r\n\r\n\t}\r\n\r\n\tspiral2(v,c,tile,measure,rings){\r\n\t\tlet u=0.0;\r\n\t\tconst verts=[];\r\n\t\tconst tris=[];\r\n\t\tconst points=this.points;\r\n\t\tconst n=v.length;\r\n\t\tfor(let i=0;i<n-1;i++){\r\n\t\t\tconst x0=v[i][0];\r\n\t\t\tconst y0=v[i][1];\r\n\t\t\tconst ii=(i+1);\r\n\t\t\tconst x1=v[ii][0];\r\n\t\t\tconst y1=v[ii][1];\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tconst div=(d/measure)|0;\r\n\t\t\tif(div>0){\r\n\t\t\t\tconst nn=(i==n-2)?div+1:div;\r\n\t\t\t\tfor(let j=0;j<nn;j++){\r\n\t\t\t\t\tconst px=x0+dx*j/div;\r\n\t\t\t\t\tconst py=y0+dy*j/div;\r\n//\t\t\t\t\tthis.addraw(px,py);\r\n\t\t\t\t\tthis.addPoint(px,py,u);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tlet offset=0;\r\n\t\tlet count=points.length;\r\n\t\tfor(let ring=0;ring<rings;ring++){\r\n\t\t\tlet prevt=-1;\r\n\t\t\tfor(let i=0;i<count-1;i++){\r\n\t\t\t\tconst ii=i+1;\r\n\t\t\t\tconst tt=this.triangulate(offset+i,offset+ii);\r\n\t\t\t\tconst t=tt.v;\r\n\t\t\t\tif(t==-1){\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\ttris.push([offset+i,t,offset+ii]);\r\n\t\t\t}\t\t\r\n\r\n\t\t\toffset+=count;\r\n\t\t\tcount=points.length-offset;\r\n\t\t\tif(count==0){\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfor(const p of points){\r\n\t\t\tconst px=p[0];\r\n\t\t\tconst py=p[1];\r\n\t\t\tconst h0=topo.pickElevation(px,py);\r\n\t\t\tconst h1=topo.pickHeight(px,py);\r\n\t\t\tverts.push([px,-py,h0+h1,3,0,0,0,c]);\r\n\t\t}\r\n\r\n\t\tif(verts.length&&tris.length){\r\n\t\t\treturn new Surface(verts,tris,[]);\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\n\r\n// final point not always weld of first\r\n\r\nfunction TraceClosedOutline(context,outline){\r\n\tconst clip=ScratchRes;\r\n\tconst n=outline.length;\r\n\tconst p=outline[n-1];\r\n\tlet px=p[0]/2;\r\n\tlet py=p[1]/2;\r\n\tlet exitEdge=0;\r\n\tlet enterEdge=0;\r\n\tconst edge=[];\r\n\tfor(let w=0;w<outline.length;w++){\r\n\t\tconst v=outline[w];\r\n\t\tconst x=v[0]/2;\r\n\t\tconst y=v[1]/2;\r\n\t\tif(px<0 && x>0) enterEdge=4;\r\n\t\tif(py<0 && y>0) enterEdge=1;\r\n\t\tif(px>=clip&&x<clip) enterEdge=2;\r\n\t\tif(py>=clip&&py<clip) enterEdge=3;\r\n\t\tif(enterEdge&&exitEdge){\r\n\t\t\twhile(exitEdge!=enterEdge){\r\n\t\t\t\tswitch(exitEdge){\r\n\t\t\t\t\tcase 4:\r\n\t\t\t\t\t\tedge.push([0,0]);\r\n\t\t\t\t\t\texitEdge=1;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 1:\r\n\t\t\t\t\t\tedge.push([clip-1,0]);\r\n\t\t\t\t\t\texitEdge=2;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 2:\r\n\t\t\t\t\t\tedge.push([clip-1,clip-1]);\r\n\t\t\t\t\t\texitEdge=3;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 3:\r\n\t\t\t\t\t\tedge.push([0,clip-1]);\r\n\t\t\t\t\t\texitEdge=4;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tedge.push([x,y]);\r\n\t\texitEdge=enterEdge;\r\n\t}\r\n\tlet count=0;\r\n\tfor(const e of edge){\r\n\t\tconst x=e[0];\r\n\t\tconst y=e[1];\r\n\t\tif(count==0){\r\n\t\t\tcontext.moveTo(x,y);\r\n\t\t}else{\r\n\t\t\tcontext.lineTo(x,y);\r\n\t\t}\r\n\t\tcount++;\r\n\t}\r\n}\r\n\r\nfunction DrawSurface(context,surface){\r\n\tconst c=surface.verts32;\r\n\tconst t=surface.tris.flat();\r\n\tfor(let i=0;i<t.length;i+=3){\r\n\t\tconst v0=c[t[i+0]];\r\n\t\tconst v1=c[t[i+1]];\r\n\t\tconst v2=c[t[i+2]];\r\n\t\tcontext.moveTo(v0[0],-v0[1]);\r\n\t\tcontext.lineTo(v1[0],-v1[1]);\r\n\t\tcontext.lineTo(v2[0],-v2[1]);\r\n\t\tcontext.lineTo(v0[0],-v0[1]);\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker_baker.js\",\"length\":12132,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_baker.js\r\n\r\n// one per TopoTile\r\n\r\n// a worker thread for processing heightmaps for a topo tile\r\n\r\nconst FloraPen=32;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\nconst TopoNoLevel=-0x4000;\r\n\r\n//const _unicode = new TextEncoder();\r\n\r\nlet topoCount;\r\nconst heightmaps=[];\r\n\r\n//let outgoingBaker=[];\r\n//let connectedBaker=false;\r\n\r\nonmessage = (message) => {\r\n\tconst commands=message.data;\r\n\tfor(const line of commands){\r\n//\t\tconsole.log(\"wire_baker \",line);\r\n\t\tswitch(line.command){\r\n\t\t\tcase \"heightmap\":\r\n\t\t\t\tonHeightmap(line.array);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"bake\":\r\n\t\t\t\tonTopoCount(line.value);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"build\":\r\n\t\t\t\tonBuild(line.value);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n//\tconsole.log(\"wire_baker woke\",data.name);\r\n//\toutgoing.push(data);\r\n}\r\n\r\nfunction refresh(){\r\n\tif(topoCount==heightmaps.length){\r\n//\t\tdebugger;\r\n\t\tcreateTopo();\r\n\t}\r\n}\r\n\r\nfunction onHeightmap(rawbytes){\r\n\tif(rawbytes.length==0){\r\n//\t\treturn;\r\n\t}\r\n\theightmaps.push(rawbytes);\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildTopo(plan){\r\n\t\r\n}\r\n\r\nfunction onTopoCount(count){\r\n\ttopoCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildCount(count){\r\n\tbuildCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\nfunction createTopo(){\r\n\tconst bytes=heightmaps[0]||[];\r\n\tconst heightmap=AllocBumpmap(bytes);\r\n\theightmap.setBytes(bytes);\r\n\tconst n=heightmaps.length;\r\n\tfor(let i=1;i<n;i++){\r\n\t\tif(heightmaps[i].length==bytes.length){\r\n\t\t\theightmap.orBytes(heightmaps[i]);\r\n\t\t}\r\n\t\telse{\r\n//\t\t\theightmap.setBytes(heightmaps[i]);\r\n\t\t}\r\n\t}\r\n\r\n// simon come here and fix up flora\r\n//\theightmap.heal(n);\r\n\r\n//\theightmap.postFlora(1024,2,15,2);\r\n//\theightmap.postFlora(512,4,15,2);\r\n\theightmap.postFlora(256,8,FloraPen,22);\r\n//\theightmap.postFlora(128,16,0,22);\r\n\r\n\theightmap.post();\r\n\r\n\theightmaps.length=0;\r\n}\r\n\r\nclass Bumpmap{\r\n\tpost(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst diff=this.diff;\r\n\t\tconst ground=this.ground;\r\n\t\tconst message=[{command:\"bump\",topo,diff,ground}];\r\n\t\tconst transfer=[topo.buffer,diff.buffer,ground.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n// a worker method that replies with a \"flora\" message containing a surface for flora placement\r\n\r\n\tpostFlora(count,mag,c,floraMin){\r\n\t\tconst p=2048/count;\r\n\t\tconst res=count+1;\r\n\t\tconst a=new Array(res);\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\ta[y]=new Array(res);\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tlet h0=this.pickElevation(x*p,y*p);\r\n\t//\t\t\tlet h1=topo.pickHeight(x*p,y*p);\r\n\t\t\t\tconst m=this.pickHeightMinMax(x*p,y*p);\r\n\t\t\t\tif(m.min>floraMin){\r\n\t\t\t\t\tconst h1=m.max;\r\n\t\t\t\t\ta[y][x]=h0+h1;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst vverts=[];\r\n\t\tconst v=[];\r\n\t\tconst i=[];\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tconst mz=a[y][x];\r\n\t\t\t\tlet vert=-1;\r\n\t\t\t\tif(mz){\r\n\t\t\t\t\tconst mx=mag*x;\r\n\t\t\t\t\tconst my=-mag*y;\r\n\t\t\t\t\tvert=v.length;\r\n\t\t\t\t\tv.push([mx,my,mz,c, 0,0,0,0]);\r\n\t\t\t\t}\r\n\t\t\t\tvverts.push(vert);\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst d=count+1;\r\n\t\tfor(let y=0;y<count;y++){\r\n\t\t\tfor(let x=0;x<count;x++){\r\n\t\t\t\tconst v0=vverts[y*res+x];\r\n\t\t\t\tconst v1=vverts[y*res+x+1];\r\n\t\t\t\tconst v2=vverts[(y+1)*res+x+1];\r\n\t\t\t\tconst v3=vverts[(y+1)*res+x];\r\n\t\t\t\tif(v0>-1&&v1>-1&&v2>-1&&v3>-1){\r\n\t\t\t\t\ti.push([v0,v2,v1]);\r\n\t\t\t\t\ti.push([v0,v3,v2]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst verts=new Int32Array(v.flat());\r\n\t\tconst indices=new Int32Array(i.flat());\r\n\t\tconst message=[{command:\"flora\",verts,indices}];\r\n\t\tconst transfer=[verts.buffer,indices.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n\treset(res){\r\n\t\tthis.resolution=res;\t\t\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}else{\r\n\t\t\t\t\ttopo[i]=TopoNoLevel;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(srccount){\r\n\t\tlet count=0;\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tconst i=y*res+x;\r\n\t\t\t\tlet h=topo[i];\r\n\t\t\t\tif(h==0){\r\n\r\n//\t\t\t\t\ttopo[i]=SeaLevel-TopoLevel;\r\n\t\t\t\t\t// simon come here\r\n/*\r\n\t\t\t\t\tif(x>0&&topo[i-1]) h=topo[i-1];\r\n\t\t\t\t\tif(y>0&&topo[i-res]) h=topo[i-res];\r\n\t\t\t\t\tif(x<res-1&&topo[i+1]) h=topo[i+1];\r\n\t\t\t\t\tif(y<res-1&&topo[i+res]) h=topo[i+res];\r\n\t\t\t\t\ttopo[i]=h;\r\n*/\t\t\t\t\t\r\n\t\t\t\t\tcount++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(count){\r\n//\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\tprocess(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0) h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\n\r\n\r\n/*\r\n\r\nfunction heartbeat(){\r\n\tconst messages=outgoing;\r\n\toutgoing=[];\r\n\tif(connected){\r\n\t\tpost(\"tick\",messages);\r\n\t}\r\n}\r\n\r\nlet timer=setInterval(heartbeat,500);\r\n\r\nfunction post(name,body){\r\n\tevent={name:name,body:body};\r\n\tconst js=JSON.stringify(event);\r\n\tconst bytes=_unicode.encode(js);\r\n\tconst t0=new Date();\r\n\tfetch(\"/fetch\",{\r\n\t\tmethod:'POST',\r\n\t\theaders: {\r\n\t\t\t'Content-Type': 'application/json',\r\n\t\t\t'Content-Length': bytes.length\r\n\t\t},\r\n\t\tbody: bytes\r\n\t})\r\n\t.then(response => response.json())\r\n\t.then(data => {\r\n//\t\tconsole.log(data);\r\n\t\tconst t1=new Date();\r\n\t\tconst d=t1-t0;\r\n\t\tpostMessage({ping:d});\r\n\t});\t\t\r\n}\r\n\r\n*/\r\n\r\n\r\n// 0x4000 is new zero, count is typically 128, short index friendly\r\n\r\n// in which verticy sample is too steep skip edge\r\n\r\nfunction CreateTopoSurface(count,m,c,topo){\r\n\tconst a=new Array(count+1);\r\n\tconst p=2048/count;\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(count+1);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h=topo.pickTopo(x*p,y*p);\r\n\t\t\ta[y][x]=h;\r\n\t\t}\r\n\t}\r\n\t\r\n\tlet v=[];\r\n\tconst i=[];\r\n\r\n\tconst crack=[];\r\n\tconst max=[];\r\n\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mx=m*x;\r\n\t\t\tconst my=-m*y;\r\n\t\t\tconst ground=a[y][x].ground;\r\n\t\t\tconst minz=a[y][x].min;\r\n\t\t\tconst maxz=a[y][x].max;\r\n\t\t\tlet bits=0;\r\n\t\t\tif(ground==0 && maxz-minz>12){\r\n\t\t\t\tmax.push(crack.length);\r\n\t\t\t\tbits=1;\r\n\t\t\t\tcrack.push([mx,my,maxz,c, 0,0,0,bits]);\r\n\t\t\t}else{\r\n\t\t\t\tmax.push(-1);\r\n\t\t\t}\r\n\t\t\tconst z=ground||minz;\r\n\t\t\tv.push([mx,my,z,c, 0,0,0,bits]);\r\n\t\t}\r\n\t}\r\n\tconst crackOffset=v.length;\r\n\tv=v.concat(crack);\r\n\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=x+y*d;\r\n\t\t\tconst v1=x+1+y*d;\r\n\t\t\tconst v2=x+(y+1)*d;\r\n\t\t\tconst v3=x+1+(y+1)*d;\r\n\t\t\t\r\n\t\t\tconst b0=v[v0][7];\r\n\t\t\tconst b1=v[v1][7];\r\n\t\t\tconst b2=v[v2][7];\r\n\t\t\tconst b3=v[v3][7];\r\n\r\n\t\t\tif(!(b0|b1|b2|b3)){\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t\ti.push(v1);\r\n\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v2);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t}else{\r\n\t\t\t\tconst m0=max[v0]>=0?crackOffset+max[v0]:v0;\r\n\t\t\t\tconst m1=max[v1]>=0?crackOffset+max[v1]:v1;\r\n\t\t\t\tconst m2=max[v2]>=0?crackOffset+max[v2]:v2;\r\n\t\t\t\tconst m3=max[v3]>=0?crackOffset+max[v3]:v3;\r\n\r\n\t\t\t\tif(b0||b3||b1){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\t\t\t\tif(b0||b2||b3){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b1||b0){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b3||b1){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitro-wire.js\",\"length\":1821,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs nitro-wire.js\n// (c)2025 Simon Armstrong \n// All rights reserved\n\n// load the wire_ scripts and invoke onWire() finction in wire_grid.js\n\nvar wireDiv,wireBar,wireTools,wireBody,wireFullscreen;\n\nfunction fullscreenWire(){\n\twireBody.requestFullscreen();\n}\n\nvar loadedScripts=[];\n\nfunction loadScripts(names){\n\tvar count=names.length;\n\tfor(var name of names){\n\t\tvar script=document.createElement(\"script\");\n\t\tscript.onload=function(){\n\t\t\tloadedScripts.push(script);\n\t\t\tif(loadedScripts.length==count){\n\t\t\t\tconsole.log(\"All wire scripts loaded\");\n\t\t\t\tinitWireGrid(wireBody);\n\t\t\t}\n\t\t}\n\t\tdocument.body.appendChild(script);\n\t\tscript.src=\"wirejs/wire_\"+name+\".js\";\n\t}\n}\n\nconst wireScripts=[\n\t\"core\",\n\t\"display\",\n\t\"drawsurface\",\n\t\"field\",\n\t\"geometry\",\n\t\"graphics\",\n\t\"grid\",\n\t\"immersion\",\n\t\"model\",\n\t\"surface\",\"system\",\n\t\"topo\",\n\t\"util\"\n];\n\nconst wireWorkers=[\n\t\"baker\",\n\t\"fetch\",\n\t\"post\"\n];\n\nconst GridHome=\"https://github.com/nitrologic/roagrid\";\n\nfunction initWire(){\n\twireDiv=document.getElementById(\"wire\");\n\tif(!wireDiv) return false;\n\twireBar=addTitle(wireDiv,\"GRID6\");\n\taddTitle(wireDiv,\"grid6\",GridHome);\n\twireFullscreen=addToolButton(wireBar,\"[⛶]<Enter full screen>\",fullscreenWire, {command:\"wire.fullscreen\",inline:\"true\"});\n\tconst details=createContent(wireBar,\"WebGL with shonky flora <a href='https://github.com/nitrologic/roagrid'>roagrid</a> - data courtesy <a href='https://linz.govt.nz'>Land Information New Zealand</a>\");\n\twireBar.append(...details);\n\twireTools=addToolbar(wireDiv);\n\twireBody=addDiv(\"wire\",wireTools);\n// TODO: switch between debug and realtime engines\n\tinitWireGrid(wireBody);\n//\tloadScripts(wireScripts);\n//\taddTool(wireTools,\"Unmute\",\"wire.unmute\",unmutewire);\n//\taddTool(wireTools,\"Mute\",\"wire.mute\",mutewire);\n//\twireVolume=addMidiSlider(wireTools,\"gain\",16,onwireGain,40);\n}\n","name":"content"},{"role":"user","content":"why is flora layer so dark?\r\nFiles shared. Feel free to comment if content is new or different.","name":"friend"},{"role":"assistant","content":"Two separate problems combine here, and the primary one is not in the palette.\n\n## Primary cause: flora has zero normals\n\nThe flora surface is posted by `worker_baker.js` with normals explicitly zeroed:\n\n```js\nv.push([mx,my,mz,c, 0,0,0,0]);\n//                 ^^^^^^^^^ nx,ny,nz all zero\n```\n\nCompare with `CreateTopoSurface` in the same worker — also zero normals, but it gets fixed up afterwards in `TopoTile.onBump`:\n\n```js\nconst surface=CreateTopoSurface(128,16,GroundPen,bump);\nconst zfactor=4.6/(this.level*8.0);\nsurface.calcNormals(zfactor);   // <-- fixes the tile surface\nthis.topoSurface=surface;\n```\n\nFlora has no equivalent. `onFlora` just stores it:\n\n```js\nonFlora(verts,indices){\n    this.floraSurface=new Surface(verts,indices,[]);\n}\n```\n\nAnd `addTileShape` does not compute normals the way `addFlatShape` does:\n\n```js\naddFlatShape(surface,origin,count){\n    shape.addFlatSurface(surface);   // -> flatifyVerts -> calcNormals\n    ...\n}\n\naddTileShape(surface,basemap,scratch,origin){\n    ...\n    shape.addSurface(surface);       // raw verts32, no normal pass\n    ...\n}\n```\n\nThe tile shader has `sun` as a uniform and `normal` as an attribute, so lighting is `dot(normal, sun)`. With normals all zero, that's zero — you get ambient only, which reads as a very dark flat surface. That's the symptom.\n\nFix: compute normals for the flora surface, using the same `zfactor` expression as `onBump` so shading is consistent with the terrain underneath.\n\n```js\nonFlora(verts,indices){\n    this.floraSurface=new Surface(verts,indices,[]);\n    const zfactor=4.6/(this.level*8.0);\n    this.floraSurface.calcNormals(zfactor);\n}\n```\n\nIf you'd rather keep the main thread free, call `calcNormals` in the worker's `postFlora` before posting — but `calcNormals` uses the `Surface` class, and `worker_baker.js` doesn't import `wire_surface.js`, so you'd have to duplicate the routine. Doing it in `onFlora` is the smaller change.\n\n## Secondary: `FloraPen=32` is out of palette range\n\n`RoaPalette` has 30 entries (indices 0–29). `FloraPen` is defined as `32` in `worker_baker.js`:\n\n```js\nconst FloraPen=32;\n```\n\nWebGL uniform-array out-of-bounds reads are undefined; in practice most drivers return 0, so the flora colour term collapses to black on top of the normal problem. If your intended colour was a green, use one of the palette indices that actually is green — 4 (`G,B,G,A`), 15 (`G,B,G,A` with alpha), or 24 (`0,G,0,A`). Given the terrain uses `GroundPen=1` and the tree-like flora sits on grass, `15` is a reasonable pick.\n\nIf you change `FloraPen`, do it in one place and pass it through to `postFlora`; right now it's a hard-coded constant on the worker side.\n\n## Why it looks \"dark\" rather than \"missing\"\n\nThe flora geometry is still emitted — that's why you see a shape — but with NdotL at zero and a black palette entry, it's only the alpha-blended fringe against the terrain below that keeps it visible at all. Once you add the `calcNormals` call, you should see it light up immediately; fixing the palette index after that will give it the colour you actually intended."},{"role":"user","content":"have set pen to 31, how do i change from what is now transparent green","name":"friend"},{"role":"assistant","content":"31 is still out of range — `RoaPalette` in `wire_core.js` has 30 entries, indices 0–29. Whatever colour you're seeing is coming from the driver's undefined-behaviour read of the `palette` uniform, which is why it's not what you'd expect.\n\n## How the colour actually gets picked\n\nThe vertex `xyzc` attribute carries a colour byte in `c`. In `worker_baker.js`, `postFlora` writes that byte from the `c` argument, which is `FloraPen`. The tile fragment shader uses it to index a `palette` uniform:\n\n```js\nthis.RawPalette=new Float32Array(RoaPalette)   // wire_core.js\nlayer.setFloats(\"palette\",gpu.RawPalette);     // wire_graphics.js\n```\n\nEach palette entry is 4 floats (r,g,b,a). So both the colour *and* the transparency come from the same index — the 4th float is alpha.\n\n## The green entries, with their alpha\n\nReading `RoaPalette`, the entries that read as green are:\n\n```\n╭─────────┬──────────────────────┬─────────┬────────────────────────────────╮\n│  Index  │  RGB                 │  Alpha  │  Look                          │\n├─────────┼──────────────────────┼─────────┼────────────────────────────────┤\n│  4      │  (0.40, 0.70, 0.40)  │  0.94   │  muted green, **opaque**       │\n│  9      │  (0.40, 0.94, 0.70)  │  0.94   │  mint, **opaque**              │\n│  15     │  (0.40, 0.70, 0.40)  │  0.52   │  muted green, **transparent**  │\n│  20     │  (0.40, 0.94, 0.70)  │  0.52   │  mint, **transparent**         │\n│  24     │  (0, 0.40, 0)        │  0.52   │  dark green, **transparent**   │\n│  25     │  (0, 0.40, 0.70)     │  0.52   │  teal, **transparent**         │\n╰─────────┴──────────────────────┴─────────┴────────────────────────────────╯\n```\n\nThe `O` constant is `0.94` (opaque-ish), the `A` constant is `0.52` (transparent). So the transparent green you're seeing is one of the `A`-alpha entries — most likely 15 or 24.\n\nIf you want an opaque green, set `FloraPen` to `4` or `9`.\n\n## If none of those is the green you want\n\nAdd a new entry to `RoaPalette` in `wire_core.js`:\n\n```js\nconst RoaPalette=[\n\t...\n\tG,G,G,A,      // 29\n\t0.15,0.55,0.15,0.94   // 30 - new opaque forest green\n];\n```\n\nThen set `FloraPen=30` in `worker_baker.js`.\n\nTwo caveats:\n\n- The tile shader declares `uniform vec4 palette[N]`. If `N` is currently 30, the 31st entry will be dropped or the program will fail to link depending on the driver. Check the shader source and bump `N` if you're adding beyond index 29.\n- `RawPalette` is `new Float32Array(RoaPalette)`, so it picks up the new length automatically — no change needed there.\n\n## Also still worth doing\n\nThe transparent green will still look wrong under lighting until you add the `calcNormals` call in `TopoTile.onFlora` — the flora verts ship with `0,0,0` normals, so NdotL is zero and the shader falls back to ambient. Fix that first, then the palette change will read as intended rather than as a flat dark silhouette."},{"role":"user","content":"is there code for removing building shape from flora layer,","name":"friend"},{"role":"assistant","content":"No — nothing in the codebase removes building footprints from the flora surface. The pieces needed are all present, but they're not wired together.\n\n## Why buildings currently show up in flora\n\nFlora is generated in the worker, from the merged heightmap, before any drawing data reaches the tile:\n\n```js\n// worker_baker.js createTopo()\nheightmap.postFlora(256,8,FloraPen,22);   // <-- flora built here\nheightmap.post();\n```\n\nThe mask inside `postFlora` is purely `diff`-based:\n\n```js\nconst m=this.pickHeightMinMax(x*p,y*p);\nif(m.min>floraMin){        // floraMin = 22\n\tconst h1=m.max;\n\ta[y][x]=h0+h1;\n}\n```\n\n`pickHeight` reads `this.diff`, and on LiDAR that second channel is high around building edges, so those cells pass the `>22` test. There is no reference to roofs, ground, or any exclusion mask anywhere in the worker.\n\n## What already exists that does the right thing\n\n`TopoTile.digOutline` (in `wire_topo.js`) is invoked per roof outline when `build_roof2` is on. It calls `Bits.digTopo`, which does exactly the zeroing you'd want:\n\n```js\n// wire_util.js\nheightmap.setGround(tx+bx, ty+by, depth);\nheightmap.setHeight(tx+bx, ty+by, 0);   // <-- diff becomes 0\n```\n\n`setHeight` writes to `diff`, so any cell inside the footprint (plus a `border` halo) fails the `m.min > floraMin` test. If `TopoFloraSurface` ran *after* `digTopo`, buildings would already be excluded — no new exclusion logic needed.\n\nAnd `TopoFloraSurface` does exist, in `wire_core.js`, marked \"moved to baker\" but never deleted:\n\n```js\n// moved to baker\n\nfunction TopoFloraSurface(count,mag,c,topo,floraMin){\n\t...\n}\n```\n\nIt is byte-for-byte the same algorithm as the worker's `postFlora`, minus the `postMessage`/transfer at the end.\n\n## The ordering problem\n\nThe worker runs at fetch time. `digOutline` runs at mesh time, much later, and only inside `Builder.buildTile`:\n\n```js\nmeshTile(tile,home){\n\t...\n\tconst surfaces=this.builder.buildTile(tile,2);   // digOutline fires here\n\t...\n\tconst floraSurface=tile.floraSurface;            // <-- already built by worker\n\tconst floramesh=layer0.addTileShape(floraSurface,...);\n}\n```\n\nSo even with `build_roof2` enabled, the flora surface was constructed before the dig and is unaffected. Regenerating it after `buildTile` is the whole fix.\n\n## Minimal patch\n\nIn `wire_graphics.js` `meshTile`, after `buildTile` returns and before the flora mesh is uploaded, rebuild the flora surface on the main thread:\n\n```js\nconst surfaces=this.builder.buildTile(tile,2);\n\ntile.allocWallmap();\ntile.staticmeesh=layer0.addStaticShapes(surfaces,tile.scratch,tile.wallmap,origin);\n\nconst topo=tile.topoSurface;\ntile.tilemesh=layer0.addTileShape(topo,tile.basemap,tile.scratch,origin);\n\n// flora is rebuilt here so that digOutline has already zeroed diff\n// over building footprints\nconst floraSurface=TopoFloraSurface(256,8,FloraPen,tile.heightmap,22);\nconst zfactor=4.6/(tile.level*8.0);\nfloraSurface.calcNormals(zfactor);\ntile.floraSurface=floraSurface;\n\nconst floramesh=layer0.addTileShape(floraSurface,tile.basemap,tile.scratch,origin);\ntile.floramesh=floramesh;\n```\n\n`FloraPen` is defined in `wire_topo.js`, which is loaded alongside `wire_graphics.js`, so it's in scope.\n\n## Caveats\n\n- **`build_roof2` must be on.** It's `false` by default in `Builder.buildTile`, so `digOutline` never runs. Flip it to `true` and you'll get the roof-block behaviour — including the basement fill, the roof wall pixel accounting, and the `context.clip()` region, all of which will now execute. If you only want the dig and not the rest, the cleaner change is to split the block: call `tile.digOutline(outline,BasementDepth,40)` in a small loop before the `build_roof2` block, leaving `build_roof2` off.\n\n- **The worker still generates its flora.** With this patch, `tile.floraSurface` is overwritten on the main thread, so the worker's version is discarded — but it was still computed and transferred, which is wasted work. To reclaim it, delete the `heightmap.postFlora(...)` call in `worker_baker.js createTopo()` and drop the `flora` case from `TileInstance.onMessage`. Otherwise you're paying for two flora passes per tile.\n\n- **`border=40` is generous.** `digOutline` takes a `border` in heightmap pixels, so each footprint gets a 40-pixel halo of zeroed `diff`. At LiDAR resolution that's several metres — probably fine for tree exclusion, but tune it once you can see the result.\n\n- **Normals.** The worker's `postFlora` ships `0,0,0` normals, and `TopoFloraSurface` inherits that (`v.push([mx,my,mz,c, 0,0,0,0])`). Calling `calcNormals` after rebuilding is what lights the surface — otherwise the flora will still look dark, independent of any exclusion.\n\n- **`AppRuntime.UseLINZ` and `level<3`** gate whether roof drawings are fetched at all in `fetchTopoTile`. Both are already `true`/`<3` in the default config, but worth confirming for whichever level you're viewing."},{"role":"user","content":"cant i post once footprints are dug?","name":"friend"},{"role":"assistant","content":"Yes — and it's the cleaner shape. But it means moving the dig into the worker, because the worker can't do it after the fact.\n\n## Why the worker can't do it post-hoc\n\n`Bumpmap.post()` transfers the buffers away:\n\n```js\nconst transfer=[topo.buffer,diff.buffer,ground.buffer];\npostMessage(message,transfer);\n```\n\nAfter that the worker's `topo`/`diff`/`ground` are detached. Even if you sent a `dig` command later, there's nothing to dig into. So \"post once footprints are dug\" only works if the dig happens in the worker, before the transfer.\n\n## What that requires\n\nThree things move to the worker side:\n\n- **`Bits`** from `wire_util.js` — the polygon rasteriser. Currently only loaded on the main thread.\n- **`TopoTile.digOutline`** — or a shared version of it. It's ~30 lines and reads only from the heightmap and the outline.\n- **A protocol change** — the worker must not `post()` until it has received the roof outlines.\n\nAnd one thing has to be reordered on the main thread: `onDrawingResponse` must forward the roof outlines to the worker, and `createTopo()` in the worker must defer its `postFlora` + `post` until those arrive.\n\n## New flow\n\n```\nmain                          worker\n────                          ──────\nfetchTileRaw  ──heightmap──▶  accumulate\nfetchDrawing                  (hold, don't post yet)\n  onDrawingResponse\n    extract ROOF outlines\n                ──dig───────▶  apply dig to topo/diff/ground\n                               postFlora(256,8,FloraPen,22)\n                               post({bump, flora})  ──▶ main\n                              (transfer buffers now)\n```\n\nBecause the dig runs first, both the bump surface and the flora surface are built from the same dug state. The main thread's `onBump` creates `topoSurface` from an already-dug heightmap — no rebuild in `meshTile` needed. The whole \"rebuild after buildTile\" workaround disappears.\n\n## The two messages become one\n\nRight now `postFlora` and `post` each fire their own `postMessage`. Collapse them:\n\n```js\nfunction postAll(){\n\tconst message=[{\n\t\tcommand:\"bump\",\n\t\ttopo:this.topo, diff:this.diff, ground:this.ground,\n\t\tfloraVerts:floraVerts, floraIndices:floraIndices\n\t}];\n\tconst transfer=[\n\t\tthis.topo.buffer, this.diff.buffer, this.ground.buffer,\n\t\tfloraVerts.buffer, floraIndices.buffer\n\t];\n\tpostMessage(message,transfer);\n}\n```\n\nThen `TileInstance.onMessage` handles one case instead of two, and `hasLoaded()` loses the `topoCount == heightmaps.length` / `floraSurface` conditions — the tile is loaded the moment the single message arrives.\n\n## The gate on the main thread\n\nThe worker only knows when to build once both the topo and the drawing have landed. `TopoTile.hasLoaded()` already tracks both (`topoCount == heightmaps.length` and `drawingCount == drawings.length`), but the worker's `refresh()` currently fires on the topo count alone. So the worker needs to know to wait.\n\nTwo ways:\n\n- **Send a `dig` command** from the main thread once `hasLoaded()` is true, carrying the extracted roof outlines. Worker applies the dig, then builds. Simple, one-shot, no extra state.\n- **Send `topoCount` and `drawingCount`** to the worker and let it decide. More coupling, not worth it.\n\nThe first is cleaner. `TopoGrid.refreshTiles` / `populateHome` already gate on `hasLoaded()`, so you have a natural place to fire the dig message.\n\n## Gotchas\n\n- **`BasementDepth` is 4.** That's a near-invisible dig. The outline points are halved before hitting `Bits` (`o[0]/2`), and `digTopo` writes `depth` directly into `ground`. At `4` the surface barely moves. Bump it to something like `200` before you can tell it's working.\n\n- **`heightmaps.length=0` in `createTopo`.** If you defer the build, don't clear until after the dig. The merged `heightmap` object survives, but the raw `heightmaps` array is what the count is compared against.\n\n- **`fetchTileRaw` bumps `topoCount` on the main thread**, and that count is what the worker is told via `bakeTopo(count)`. If drawings arrive first (common — they're small JSON, topo is a big binary), the dig message can arrive before `topoCount` is satisfied. Either buffer the dig in the worker until the topo count is met, or gate on the main thread so the dig is only sent once `hasLoaded()` is true. The latter is simpler.\n\n- **`level<3` gate.** `fetchTopoTile` only fetches `roaname` drawings when `level<3`. So at level 3+ there are no roof outlines and the dig is a no-op. That's fine — the flora just comes out un-dug, same as today.\n\n- **`Bits.poly` clamps `x` but not `y`.** A negative `y` writes off the end of the typed array silently, and `digTopo` then toggles the wrong region. Roof outlines near the tile edge will hit this. Fix the clamp before relying on the dig.\n\n- **Duplicate `Bits` and `digOutline`.** If you don't want to maintain two copies, load `wire_util.js` into the worker via `importScripts`, and factor `digOutline` into a free function that both the worker and `TopoTile` call. That's the tidier option, at the cost of a small refactor.\n\n## Is it worth it\n\nCompared to rebuilding flora on the main thread after `buildTile`:\n\n```\n╭──────────────────────────────────────────────────┬───────────────────────┬───────────────────────────────╮\n│                                                  │  Main-thread rebuild  │  Worker dig                   │\n├──────────────────────────────────────────────────┼───────────────────────┼───────────────────────────────┤\n│  Flora passes per tile                           │  2                    │  1                            │\n│  Code churn                                      │  ~6 lines             │  ~120 lines, protocol change  │\n│  Ordering guarantees                             │  implicit             │  explicit                     │\n│  Fits existing \"everything in the worker\" shape  │  no                   │  yes                          │\n╰──────────────────────────────────────────────────┴───────────────────────┴───────────────────────────────╯\n```\n\nIf you're already planning to touch the worker protocol, the worker dig is the right end state. If you just want to see it working, the rebuild is a five-minute change and you can migrate later."},{"role":"user","content":"no i dont agree, you seem to have jumped to first thought you had","name":"friend"},{"role":"assistant","content":"You're right — I overcomplicated it. The dig already runs on the main thread, and so does the heightmap once it's transferred. Nothing needs to move into the worker.\n\nThe answer is simpler: stop the worker generating flora at all.\n\n## The pieces are already on the main thread\n\n- `heightmap` arrives via `Bumpmap.post()` transfer — main thread has it.\n- `drawings` (with `ROOF` outlines) arrive via `fetchDrawing` — main thread has them.\n- `digOutline` runs in `Builder.buildTile` — main thread.\n- `TopoFloraSurface` exists in `wire_core.js`, unused, and is the same algorithm as the worker's `postFlora` — main thread.\n\nSo the sequence on the main thread is just: dig, then flora. No protocol change.\n\n## The change\n\nIn `worker_baker.js` `createTopo`, drop the flora call:\n\n```js\n//\theightmap.postFlora(256,8,FloraPen,22);\n\theightmap.post();\n```\n\nIn `wire_topo.js` `TileInstance.onMessage`, drop the flora case (nothing will send it):\n\n```js\nonMessage(e){\n\tconst script=e.data;\n\tfor(const line of script){\n\t\tswitch (line.command){\n\t\t\tcase \"bump\":\n\t\t\t\tthis.tile.onBump(line.topo,line.diff,line.ground);\n\t\t\t\tbreak;\n\t\t}\n\t}\n}\n```\n\nAnd `hasLoaded()` — `topoReady` was waiting on `floraSurface`, which no longer arrives:\n\n```js\ntopoReady=this.heightmap;\n```\n\nIn `wire_graphics.js` `meshTile`, generate flora after `buildTile` returns (which is where `digOutline` ran):\n\n```js\nconst surfaces=this.builder.buildTile(tile,2);\n\ntile.allocWallmap();\ntile.staticmeesh=layer0.addStaticShapes(surfaces,tile.scratch,tile.wallmap,origin);\n\nconst topo=tile.topoSurface;\ntile.tilemesh=layer0.addTileShape(topo,tile.basemap,tile.scratch,origin);\n\n// flora built here so digOutline has already zeroed diff over footprints\nconst floraSurface=TopoFloraSurface(256,8,FloraPen,tile.heightmap,22);\nfloraSurface.calcNormals(4.6/(tile.level*8.0));\n\nconst floramesh=layer0.addTileShape(floraSurface,tile.basemap,tile.scratch,origin);\ntile.floramesh=floramesh;\n```\n\nThat's the whole thing. No worker protocol, no importing `Bits` into the worker, no deferring `post()`.\n\n## What still has to be true\n\n`build_roof2` must be on for `digOutline` to actually run inside `buildTile`. Otherwise `diff` is untouched and the flora comes out the same as today. If you want the dig without the rest of the roof block, hoist the `tile.digOutline(outline,BasementDepth,40)` call out of the `build_roof2` guard into a small loop before it.\n\nAnd `BasementDepth` at `4` is a near-invisible dig — bump it before you can tell whether it worked.\n\nAlso: `calcNormals` matters here regardless, since `TopoFloraSurface` writes `0,0,0` normals just like `postFlora` did. Without it the flora will be lit flat and read dark, which is the problem you were chasing in the first place."},{"role":"user","content":"worker role must come first, please dont put anything in main thread if you can help it","name":"friend"},{"role":"assistant","content":"Agreed — worker owns it. The main thread's only job is to hand over the outlines; everything else stays where it already is.\n\n## What the worker already has\n\nAt `createTopo` time, the worker holds the merged `heightmap` with `topo`/`diff`/`ground` — the same object `digOutline` operates on. The only thing it lacks is the roof outlines, which are sitting on the main thread in `drawing.data[\"ROOF\"]` after `onDrawingResponse` parses them.\n\nSo: forward the outlines once, then the worker does dig → `postFlora` → `post`, in that order, in one pass.\n\n## Worker changes\n\n**`worker_baker.js`** — import the shared bits, hold the outlines, gate on them.\n\n```js\nimportScripts(\"wirejs/wire_util.js\");   // Bits + digOutline (see below)\n\nconst roofOutlines=[];\nlet digReady=false;\n\nonmessage = (message) => {\n\tconst commands=message.data;\n\tfor(const line of commands){\n\t\tswitch(line.command){\n\t\t\tcase \"heightmap\": onHeightmap(line.array); break;\n\t\t\tcase \"bake\":      onTopoCount(line.value); break;\n\t\t\tcase \"dig\":\n\t\t\t\tonDig(line.outlines, line.depth, line.border);\n\t\t\t\tbreak;\n\t\t}\n\t}\n}\n\nfunction onDig(outlines,depth,border){\n\tfor(const o of outlines) roofOutlines.push(o);\n\tdigDepth=depth;\n\tdigBorder=border;\n\tdigReady=true;\n\trefresh();\n}\n\nfunction refresh(){\n\tif(topoCount==heightmaps.length && digReady){\n\t\tcreateTopo();\n\t}\n}\n```\n\n**`createTopo`** — dig before flora, post once:\n\n```js\nfunction createTopo(){\n\tconst bytes=heightmaps[0]||[];\n\tconst heightmap=AllocBumpmap(bytes);\n\theightmap.setBytes(bytes);\n\tfor(let i=1;i<heightmaps.length;i++){\n\t\tif(heightmaps[i].length==bytes.length){\n\t\t\theightmap.orBytes(heightmaps[i]);\n\t\t}\n\t}\n\theightmaps.length=0;\n\n\t// footprints dug here, before flora samples diff\n\tfor(const outline of roofOutlines){\n\t\tdigOutline(heightmap, outline, digDepth, digBorder);\n\t}\n\troofOutlines.length=0;\n\n\t// flora sees the dug state, so building cells fail m.min>floraMin\n\theightmap.postFlora(256,8,FloraPen,22);\n\theightmap.post();\n}\n```\n\nThat's the whole worker change. `postFlora` and `post` are unchanged; they just run later.\n\n## Move `digOutline` into `wire_util.js`\n\nIt currently lives on `TopoTile`, but its body only touches `Bits` and a heightmap — no tile state. Lift it out and both sides can share it. `importScripts` picks it up in the worker; the existing `<script>` tag picks it up on the main thread.\n\n```js\n// wire_util.js\nfunction digOutline(heightmap, outline, deep, border){\n\tlet xmin=1e9, xmax=-1e9, ymin=1e9, ymax=-1e9;\n\tlet zmin=1e9;\n\tconst pts=[];\n\tconst n=outline.length;\n\tfor(let w=0;w<n;w++){\n\t\tconst o=outline[w];\n\t\tconst x=(o[0]/2)|0;\n\t\tconst y=(o[1]/2)|0;\n\t\tconst h0=heightmap.pickTopo(x,y).min;\n\t\tzmin=Math.min(zmin,h0);\n\t\tif(x<xmin)xmin=x; if(x>xmax)xmax=x;\n\t\tif(y<ymin)ymin=y; if(y>ymax)ymax=y;\n\t\tpts.push([x,y]);\n\t}\n\tconst bits=new Bits((xmax-xmin)|0,(ymax-ymin)|0,xmin,ymin);\n\tbits.poly(pts);\n\tbits.digTopo(heightmap,(zmin-deep)|0,border);\n}\n```\n\nDelete the `TopoTile.digOutline` method — it's now redundant, and the main thread should not be digging at all under this design.\n\n## Main thread — one forward, no work\n\nIn `TopoTile.onDrawingResponse`, after `drawing.data=data` and `this.drawings.push(drawing)`, collect the roof outlines and hand them off once all drawings have arrived. The `hasLoaded` gate already tells you when that is; hook the send into wherever you first observe it true. Simplest is a small check at the end of `onDrawingResponse`:\n\n```js\nthis.drawings.push(drawing);\nthis.dirty=true;\n\nif(this.drawingCount==this.drawings.length && this.instance){\n\tconst outlines=[];\n\tfor(const d of this.drawings){\n\t\tfor(const roof of d.data[\"ROOF\"]){\n\t\t\tconst start=roof.start, count=roof.count;\n\t\t\tfor(let i=0;i<count;i++){\n\t\t\t\toutlines.push(d.outlines[start+i]);\n\t\t\t}\n\t\t}\n\t}\n\tthis.instance.post([{\n\t\tcommand:\"dig\",\n\t\toutlines,\n\t\tdepth:BasementDepth,\n\t\tborder:40\n\t}]);\n}\n```\n\nThat is the only main-thread addition, and it is pure data marshalling — no geometry, no rasterising, no surface building.\n\n## Remove the main-thread dig\n\n`Builder.buildTile`'s `build_roof2` block currently calls `tile.digOutline`. With the dig moved to the worker it must not run again — the worker already zeroed `diff` and set `ground` before the buffers were transferred. Delete that call (or the whole `build_roof2` block if you weren't using the rest of it). Leaving it in would dig a second time on an already-transferred heightmap, which is at best a no-op and at worst double-offsets `ground`.\n\n## Ordering guarantees\n\n- The worker's two gates (`topoCount` and `digReady`) mean `createTopo` fires only when both the merged heightmap and the outlines are present, regardless of which arrived first.\n- `postFlora` reads `diff`, which `digTopo` has already zeroed over each footprint, so building cells fail `m.min>floraMin` and are omitted from the flora grid.\n- `post` transfers `topo`/`diff`/`ground` after both the dig and the flora pass, so the main thread receives a single, final, consistent state — no rebuild in `meshTile`, no second flora pass, no ordering assumptions on the main side.\n\n## Small things\n\n- `BasementDepth` is `4` in `wire_grid.js`. At that value the dig is invisible against the terrain. Bump it before you can judge the result — a few hundred is a reasonable starting point.\n- `Bits.poly` clamps `x` but not `y`; a negative `y` writes off the typed array. Roof outlines near the tile edge will hit this. Worth fixing in `wire_util.js` before the worker starts relying on it.\n- `FloraPen` is `32`, which is outside `RoaPalette`'s 0–29 range. Set it to a real green (4, 9, 15, 24) — otherwise the flora you're now correctly generating will still render as whatever the driver returns for an out-of-bounds uniform read.\n- `postFlora` writes `0,0,0` normals. `TopoFloraSurface` in `wire_core.js` does the same. Whichever side ends up generating flora, `calcNormals` has to run on it before upload, or the surface stays flat-lit regardless of the palette fix."},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_topo.js\",\"length\":34270,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_topo.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n//  TopoTile Pixelmap Bumpmap PixelLoader HtmlImage Point\r\n\r\n\"use strict\"\r\n\r\nconst GroundPen=1;\r\n\r\nlet ScratchCount=0;\r\nlet WallCount=0;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\n\r\nconst WallSize=1024;// simon come here 2048;\r\nconst TileSize=2048;\r\n\r\nconst OutlineColor=\"#04c\";\r\nconst FillStyle=\"#00f\";\r\n\r\nconst GridStyle=\"#048\";\r\nconst _GridAlpha=0.4;\r\nconst _GridThick=0.2;\r\n\r\nconst CursorStyle=\"#ff8\";\r\n\r\nconst TopoMipName=[\"sd-\",\"\",\"hd-\"]\r\n\r\nconst mapStyle={\r\n\tLAND:{thick:2,fill:\"#030\"},\r\n\tCOAST:{thick:10},\r\n\tCONTOUR:{thick:0.4},\r\n\tROAD:{thick:0.2,style:\"#888\"},\r\n\tRAIL:{thick:1.8,style:\"#882\"},\r\n\tBRIDGE:{thick:3},\r\n\tTRAILS:{thick:0},\r\n\tTARMAC:{thick:3},\r\n\tROOF:{thick:3.6,style:\"#000\",fill:\"#333\"},\r\n\tPARCEL:{thick:0.3},\r\n\tTRANSIT:{thick:2.6,style:\"#26a\"}, //,fill:\"#444\"}\r\n\tROAD1:{thick:0.2,style:\"#800\"},\r\n\tPOI:{thick:3,style:\"#cf2\"}\r\n}\r\n\r\nfunction Log2(n){\r\n\tif(n<0){\r\n\t\tdebugger;\r\n\t}\r\n\tlet result=0;\r\n\twhile(n){\r\n\t\tn>>=1;\r\n\t\tresult++;\r\n\t}\r\n\treturn result;\r\n}\r\n\r\nclass Pixelmap{\r\n\tconstructor(imagedata){\r\n\t\tconst bytes=imagedata.data;\r\n\t\tconst rgb=new Array(TileSize*TileSize);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<TileSize;y++){\r\n\t\t\tfor(let x=0;x<TileSize;x++){\r\n\t\t\t\tconst _rgb1=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.rgb=rgb;\r\n\t}\r\n}\r\n\r\nlet BumpCache={1:[],129:[],513:[],1025:[],2049:[]};\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n//\tconst cache=BumpCache[res];\r\n//\tconst map=cache.length?cache.pop():new Bumpmap(res);\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\n\r\nfunction RecycleBumpmap(bumpmap){\r\n\tbumpmap.clear();\r\n\tconst res=bumpmap.resolution;\r\n\tBumpCache[res].push(bumpmap);\r\n}\r\n\r\nclass Bumpmap{\r\n\treset(res){\r\n\t\tthis.resolution=res;\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.resolution=Math.sqrt(res);\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\t// todo: test me\r\n\t\t\ttopo[0]=-0x4000+SeaLevel;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tlakeLine(waterLevel){\r\n\t\tconst lakeLevel=waterLevel-1000;\r\n\t\tconst t=this.topo;\r\n\t\tconst g=this.ground;\r\n\t\tlet n=0;\r\n\t\tconst count=this.resolution*this.resolution;\r\n\t\tfor(let i=0;i<count;i++){\r\n\t\t\tif (t[i]<=waterLevel){\r\n\t\t\t\tn++;\r\n\t\t\t\tt[i]=lakeLevel;\r\n\t\t\t}\r\n\t\t}\r\n//\t\tconsole.log(\"lakeline\",n)\r\n\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let i=0;i<res*res;i++){\r\n\t\t\tlet h=topo[i];\r\n\t\t\tif(h==0){\r\n\t\t\t\ttopo[i]=1000-TopoLevel;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tprocessOutline(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0){\r\n\t\t\th=this.topo[i];\r\n\t\t}\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\nclass PixelLoader{\r\n\tconstructor(){\r\n\t\tthis.canvas=document.createElement('canvas');\r\n\t\tthis.canvas.width=TileSize;\r\n\t\tthis.canvas.height=TileSize;\r\n\t\tthis.context=this.canvas.getContext('2d');\r\n\t}\r\n\timageRGBPixels(image){\r\n\t\tthis.context.clearRect(0,0,TileSize,TileSize);\r\n\t\tthis.context.drawImage(image,0,0);\r\n\t\tconst imagedata=this.context.getImageData(0,0,TileSize,TileSize);\r\n\t\treturn new Pixelmap(imagedata);\r\n\t}\r\n}\r\n\r\nclass HtmlImage{\r\n\r\n\t// leyer is a source entry from tilemaps.json\r\n\r\n\tconstructor(tile,layer,partial){\r\n\t\tthis.tile=tile;\r\n\t\tthis.layer=layer;\r\n\t\tthis.partial=partial;\r\n\t\tconst image=new Image();\r\n\t\timage.crossOrigin=\"anonymous\";\r\n\t\timage.onload=this.imageLoad.bind(this);\r\n\t\timage.onerror=this.imageError.bind(this);\r\n\t\tthis.image=image;\r\n\t}\r\n\r\n\timageLoad(){\r\n\t\tthis.loaded=true;\r\n\t\tthis.tile.dirty=true;\r\n\t\tthis.tile.addImage(this);\r\n//\t\tif(this.layer==0){\r\n//\t\t\tthis.colormap=PixelLoader.imageRGBPixels(this.image);\r\n//\t\t\tthis.tile.setBasemap(this.image);\r\n//\t\t}\r\n\t}\r\n\r\n\timageError(errorevent){\r\n\t\tconsole.log(\"imageError:\",this.image.src,errorevent.message);\r\n\t}\r\n\r\n\tload(src){\r\n\t\tthis.image.src=src;\r\n\t}\r\n}\r\n\r\n// simon come here and allocate baker workers to bake\r\n\r\n\r\nclass Instance{\r\n\r\n}\r\n\r\nclass Bake{\r\n\r\n\tinit(workerCount){\r\n\t\tconsole.log(\"[BAKE] init\",workerCount)\r\n\t\tconst bakers=[];\r\n\t\tfor(let i=0;i<workerCount;i++){\r\n\t\t\tconst baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\t\tbakers.push(baker);\r\n\t\t}\r\n\t\tthis.bakers=bakers;\r\n\t}\r\n\r\n\tlisten(instance){\r\n\r\n\t}\r\n}\r\n\r\n// todo; TileInstance v TopoProcess\r\n\r\nclass TileInstance{\r\n\tconstructor(tile){\r\n\t\tthis.heightmaps=[];\r\n\t\tthis.tile=tile;\r\n//\t\tconsole.log(\"[WIRE] instance\",tile);\r\n\t\tthis.baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\tthis.baker.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\t// e.data is script - an array of line objects that include a command field\r\n\r\n\tpost(message,transfer){\r\n\t\tthis.baker.postMessage(message,transfer);\r\n\t}\r\n\r\n\tterminate(){\r\n\t\tthis.baker.terminate();\r\n\t\t// simon come here and recylcled typed arrays\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\r\n\tonMessage(e){\r\n\t\tconst script=e.data;\r\n\t\tfor(const line of script){\r\n\t\t\tswitch (line.command){\r\n\t\t\t\tcase \"flora\":\r\n\t\t\t\t\tthis.tile.onFlora(line.verts,line.indices);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"bump\":\r\n\t\t\t\t\tthis.tile.onBump(line.topo,line.diff,line.ground);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tbakeTopo(count){\r\n\t\tconst message=[{command:\"bake\",value:count}];\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\trawLoad(raw){\r\n\t\tthis.heightmaps.push(raw);\r\n\t\tconst message=[{command:\"heightmap\",array:raw}];\r\n\t\tconst transfer=[raw.buffer];\r\n//\t\tthis.baker.postMessage(message,transfer);\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\t// support merge or multiple heightmaps here\r\n\r\n\tcreateTopo(){\r\n\t\tconst bytes=this.heightmaps[0]||[];\r\n\t\tthis.heightmap=AllocBumpmap(bytes);\r\n\t\tthis.heightmap.setBytes(bytes);\r\n\t\tfor(let i=1;i<this.heightmaps.length;i++){\r\n\t\t\tthis.heightmap.orBytes(this.heightmaps[i]);\r\n\t\t}\r\n\t\tthis.heightmap.heal();\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\tbakeTile2(tile){\r\n\t\ttile.createTopo();\r\n\t\tconst topo=CreateTopoSurface(128,16,0,tile.heightmap);\r\n\t\ttopo.calcNormals();\r\n\t\ttile.topoSurface=topo;\r\n\t}\r\n}\r\n\r\nlet _PostCount=0;\r\nlet _PostLoads=0;\r\n\r\n// pickHeight pickElevation maxHeight retire fetch request loadTileImage redrawTile\r\n// drawOutline drawFilled drawBox drawDiagram \r\n// layer was source level is now resolution\r\n\r\nclass TopoTile{\r\n\r\n\tconstructor(grid,level,x,y){\r\n\r\n\t\tthis.hasBaker=true;\t\t// false debug mode - release make true;\r\n\t\tthis.flushed=false;\r\n\t\tthis.baker=null;\r\n\r\n\t\t// 2026 - heightmaps is back for no baker mode\r\n\t\tthis.heightmaps=[];\r\n\r\n//\t\tthis.sourceLayers=[];\t// have extensions\r\n\t\tthis.topogrid=grid;\r\n\t\tthis.level=level;\r\n\t\tthis.x=x;\r\n\t\tthis.y=y;\r\n\t\tthis.name=\".\"+level+\",\"+x+\",\"+y;\r\n\r\n\t\tthis.imageCount=0;\r\n\t\tthis.topoCount=0;\r\n\t\tthis.drawingCount=0;\r\n\t\tthis.posts=[];\r\n\t\tthis.drawings=[];\r\n\t\tthis.imageStack=[];\r\n\r\n\t\tthis.dirty=false;\r\n\t\tthis.fetched=false;\r\n\t\tthis.ready=false;\r\n\t\tthis.fresh=0;\r\n\t\tthis.retired=false;\r\n\r\n\t\tthis.heightmap=null;\r\n\t\tthis.basemap=null;\r\n\t\tthis.scratch=null;\r\n\t\tthis.wallmap=null;\r\n\t\tthis.tilemesh=null;\r\n\t\tthis.staticmeesh=[];\r\n\t\tthis.flatmeesh=[];\r\n\t//\troofs=[]\r\n\t\tthis.wallx=0;\r\n\t\tthis.wally=0;\r\n\t\tthis.wallhi=0;\r\n\t}\r\n\r\n\tflushMesh(){\r\n\t\tif(this.flushed){\r\n\t\t\t// simon come here and fix sanity test\r\n//\t\t\tdebugger;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tthis.flushed=true;\r\n\t\tif(this.hasBaker){\r\n\t\t\tif(this.instance){\r\n\t\t\t\tthis.instance.terminate();\r\n\t\t\t}\r\n\t\t\tthis.instance=null;\r\n\t\t}\r\n\t\tif(this.tilemesh){\r\n\t\t\tthis.tilemesh.flushBuffers();\r\n\t\t\tthis.tilemesh.flushTextures();\r\n\t\t\tthis.tilemesh=null;\r\n\t\t}\r\n\t\tif(this.floramesh){\r\n\t\t\tthis.floramesh.flushBuffers();\r\n\t\t\tthis.floramesh.flushTextures();\r\n\t\t\tthis.floramesh=null;\r\n\t\t}\r\n\t\tfor(const mesh of this.staticmeesh){\r\n\t\t\tmesh.flushBuffers();\r\n\t\t\tmesh.flushTextures();\r\n\t\t}\r\n\t\tthis.staticmeesh=[];\r\n\t\tfor(const mesh of this.flatmeesh){\r\n\t\t\tmesh.flushBuffers();\r\n\t\t}\r\n\t\tthis.flatmeesh=[];\r\n\t}\r\n\r\n\tcropOutline(outline,height){\r\n\t\tconst bits=outlinePoints(outline);\r\n\t\tbits.cropTopo(topo,height);\r\n\t}\r\n\r\n\toutlinePoints(){\r\n\t\tlet xmin=1e9;\r\n\t\tlet xmax=-1e9;\r\n\t\tlet ymin=1e9;\r\n\t\tlet ymax=-1e9;\r\n\t\tlet zmin=1e9;\r\n\t\tlet zmax=-1e9;\r\n\t\tconst pts=[];\r\n\t\tconst n=outline.length;\r\n\t\tfor(let w=0;w<n;w++){\r\n\t\t\tconst o=outline[w];\r\n\t\t\tconst x=(o[0]/2)|0;\r\n\t\t\tconst y=(o[1]/2)|0;\t\t\r\n\t\t\tymin=Math.min(ymin,y);\r\n\t\t\tymax=Math.max(ymax,y);\r\n\t\t\txmin=Math.min(xmin,x);\r\n\t\t\txmax=Math.max(xmax,x);\r\n\t\t\tpts.push([x,y]);\t\r\n\t\t}\r\n\t\tconst width=(xmax-xmin)|0;\r\n\t\tconst height=(ymax-ymin)|0;\r\n\t\tconst bits=new Bits(width,height,xmin,ymin);\r\n\t\tbits.poly(pts);\r\n\t\treturn bits;\r\n\t}\r\n\r\n\tfloodLake(x,y){\r\n\t\tconst topo=this.heightmap;