\n\t\tconst width=can.width;\r\n\t\tconst height=can.height;\r\n\t\tthis.gui.refreshView(width,height);\r\n\t}\r\n\r\n\taddCursor(){\r\n//\t\treturn;\r\n\r\n\t\t// bad bad\r\n\t\tconst origin=[0,0,-8192];\r\n\r\n//\t\tconst surf=draw.icosahedron(150,7,2);\r\n//\t\tconst surf=Sphere(500,3,2);\r\n//\t\tconst surf=Torus(24,260,32,12,6);\r\n\t\tconst n=4;\r\n\t\tconst surf=FlatCube(150,150,50,5);\r\n\t\tconst balls=this.viewPanel.view0.layer.addFlatShape(surf,origin,n);\r\n\t\tthis.cursorshape=balls;\r\n\r\n\t\tconst z=0.1;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tballs.scaleInstance(i,z,z,z);\r\n\t\t\tballs.positionInstance(i,i*400,0,i*40);\r\n\t\t}\r\n\r\n\t\tballs.writePosRotDim();\r\n\t\tballs.glCheck();\r\n\t}\r\n\r\n\taddCursor2(){\r\n\t\tconst origin=[0,0,0];\r\n\t\t//\t\tconst draw=new Draw();\r\n\r\n\t\t// roapalette\r\n\t\t// 6 yellow\r\n\t\t// 7 lipstick\r\n\t\t// 8 soot\r\n\t\t// 9 royal blue\r\n\t\t// 10 g\r\n\t\t// 11 b\r\n\t\t// 12 r\r\n\t\t// 13 purp\r\n\t\t// 14 rust\r\n\t\t// 15 gray\r\n\r\n//\t\tconst surf=draw.icosahedron(150,7,2);\r\n\r\n//\t\tconst surf=Icosahedron(5,7,2);\r\n\t\tconst surf=Torus(24,260,32,12,6);\r\n//\t\tconst surf=Cube(5,6);\r\n\r\n\t\tconst balls=this.viewPanel.view0.addFlatShape(surf,origin,1);\r\n\t\tthis.cursorshape=balls;\r\n\t\tballs.position(0,0,0,0);\r\n\t}\r\n\r\n\tcloseScene(){\r\n/*\r\n\t\tfor(const tile of this._tileSet){\r\n\t\t\ttile.flushMesh();\r\n\t\t}\r\n*/\r\n\t\tFlushTextureBin(this.viewPanel.glcontext.gl);\r\n\r\n\t\tthis.viewPanel.flush();\r\n\t\tthis.viewPanel=null;\r\n\r\n\t\tthis.graphics.flush();\r\n\t\tthis.graphics=null;\r\n\t}\r\n\r\n\tanimate(){\r\n\r\n\t\tconst location=this.getLocation();\r\n\r\n\t\tthis.checkCanvasSize();\r\n\t\tconst frame=this.frameCount++;\r\n\r\n\t\tconst t=Date.now();\r\n\t\tconst elapsed=t-this.frameTime;\r\n\r\n\t\tthis.frameTime+=elapsed;\r\n\t\tthis.frameElapsed+=elapsed;\r\n\r\n\t\tconst events=FetchEvents();\r\n\t\tfor(let e of events){\r\n// log joypad\r\n//\t\t\tconsole.log(JSON.stringify(e));\r\n\t\t\tswitch(e.event){\r\n\t\t\t\tcase \"controller\":{\r\n\t\t\t\t\tthis.onController(e.mods);\r\n\t\t\t\t}break;\r\n\t\t\t\tcase\"createcar\":{\r\n\t\t\t\t}break;\r\n\t\t\t\tcase\"loadmodel\":{\r\n\t\t\t\t\tconst model=_MeshLoader.gltfModel[e.url];\r\n//\t\t\t\t\tconst xyz=[0,0,1275];\r\n//\t\t\t\t\tconst xyz=[0,0,275];\r\n\t\t\t\t\tconst xyzr=[0,0,0,65536];\r\n\t\t\t\t\tthis.instanceModels(model,[xyzr]);\r\n\t\t\t\t}break;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif(this.idle){\r\n\t\t\tconst t=frame/50;\r\n\t\t\tthis.heading+=.2*Math.sin(t);\r\n\t\t}\r\n\r\n\t\tif(this.topoTiles){\r\n\r\n\t\t\tfor(let layer in this.topoTiles){\r\n\t\t\t\tconst tilegrid=this.topoTiles[layer];\r\n\t\t\t\ttilegrid.update(); // empty fetchlists\r\n\t\t\t}\r\n\r\n\t\t}\r\n\r\n\t\tif(this.viewPanel && this.viewPanel.glcontext){\r\n\r\n//\t\t\tthis.refreshGui();\r\n\r\n\t\t\tlet ready=true;\r\n\r\n\t\t\tif(!this.topoTiles){\r\n\t\t\t\tif(this.tilesource && this.tilesource.loaded()){\r\n\t\t\t\t\tthis.setDefaultHome();\r\n\t\t\t\t}else{\r\n\t\t\t\t\tready=false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tif(ready){\r\n//\t\t\t\tthis.refreshCursor();\r\n\r\n\t\t\t\tFlushTextureBin(this.viewPanel.glcontext.gl);\r\n//\t\t\t\tthis.viewPanel.scene.updateGLTF();\r\n\t\t\t\tthis.refreshGrid();\r\n\t\t\t\tif(this.topoTiles){\r\n\t\t\t\t\tconst level=this.layerlevel;\r\n\t\t\t\t\tconst tiles=this.topoTiles[level];\r\n\t\t\t\t\tif(tiles){\r\n\t\t\t\t\t\tconst cx=this.layerx;\r\n\t\t\t\t\t\tconst cy=this.layery;\r\n\r\n\t\t\t\t\t\ttiles.touchTiles(cx,cy,5);\r\n\r\n\t\t\t\t\t\t// simon come here and connect radius to 3\r\n\r\n\t\t\t\t\t\tconst visibleTiles=tiles.refreshTiles(cx,cy,5);\r\n\r\n//\t\t\t\t\t\tconst active=this.viewPanel._activeTiles;\r\n//\t\t\t\t\t\tconst distantTiles=tiles.distantTiles(active,cx,cy,5);\r\n//\t\t\t\t\t\tthis.viewPanel.retireTiles(distantTiles);\r\n\r\n\t\t\t\t\t\tthis.viewPanel.populateHome(visibleTiles,[this.homex,this.homey]);\r\n\r\n\t\t\t\t\t\tconst remove=tiles.sweep();\r\n\t\t\t\t\t\tfor(const tile of remove){\r\n\t\t\t\t\t\t\tthis.viewPanel.flushTile(tile);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tthis.graphics.compilePanels();\r\n\t\t\t}\r\n\t\t\tthis.refreshGraphics();\r\n\t\t}\r\n\t\tself.window.requestAnimationFrame(this.animate.bind(this))\r\n\t}\r\n\r\n\tonError(e){\r\n//\t\tconst txt=JSON.stringify(e);\r\n\t\twindow.alert(e.message);\r\n\t}\r\n\r\n\tresize(){\r\n\t\tconst r=window.devicePixelRatio;\r\n\t\tconst w=window.innerWidth;\r\n\t\tconst h=window.innerHeight;\r\n\t\tconst width=(w*r)&-2;\r\n\t\tconst height=(h*r)&-2;\r\n\t\tthis.aspect=w/h;\r\n\t\tthis.pixelSize=r;\r\n\t\tconst can=this.canvas;\r\n\t\tif(can){\r\n\t\t\tcan.style.width=w+\"px\";\r\n\t\t\tcan.style.height=h+\"px\";\r\n\t\t\tcan.width=width;\r\n\t\t\tcan.height=height;\r\n\t\t}\r\n\t\tthis.dirty=true;\r\n\t\tthis.mousedown=false;\r\n\t\tSetStatus(\"res:\"+width+\"x\"+height+\" pixel:\"+r);\r\n\t}\r\n\r\n\tcheckCanvasSize(){\r\n\t\tconst r=window.devicePixelRatio||1;\r\n\t\tconst w=(window.innerWidth*r)&-2;\r\n\t\tconst h=(window.innerHeight*r)&-2;\r\n\t\tif(this.canvas.width!=w||this.canvas.height!=h){\r\n\t\t\tthis.resize();\r\n\t\t}\r\n\t}\r\n\r\n\tkey(keyevent){\r\n\t\tconst type=keyevent.type;\r\n\t\tconst keycode=keyevent.keyCode;\r\n\t\tconst ts=keyevent.timeStamp;\r\n\t\tif(BrowserKeyMaskList.includes(keycode)) return;\r\n\t\tconsole.log(type+keycode);\r\n\t\tswitch(type){\r\n\t\t\tcase \"keypress\":{\r\n\t\t\t\tif(!this.hitKey(keycode)) return;\r\n\t\t\t}break;\r\n\t\t\tcase \"keydown\":{\r\n\t\t\t\tAppEventServer.addEvent(\"keydown\",{code:keycode,time:ts})\r\n\t\t\t}break;\r\n\t\t\tcase \"keyup\":{\r\n\t\t\t\tAppEventServer.addEvent(\"keyup\",{code:keycode,time:ts})\r\n\t\t\t}\r\n\t\t}\r\n// passive says no preventDefault\r\n//\t\tkeyevent.preventDefault();\r\n\t}\r\n\r\n\tonController(mods){\r\n\t\tfor(const mod of mods){\r\n\t\t\tconst gamer=mod[0];\r\n\t\t\tif(gamer==0){\r\n\t\t\t\tswitch (mod[1]){\r\n\t\t\t\t\tcase 0:{\r\n\t\t\t\t\t\tconst b=mod[2]\r\n\t\t\t\t\t\tlet w=mod[3];\r\n\t\t\t\t\t\tthis.gameButtons[b]=w;\r\n\t\t\t\t\t}break;\r\n\t\t\t\t\tcase 1:{\r\n\t\t\t\t\t\tconst a=mod[2]\r\n\t\t\t\t\t\tlet v=mod[3];\r\n\t\t\t\t\t\tthis.gameAxis[a]=v;\r\n\t\t\t\t\t}break;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\ttickKeyboard(){\r\n\r\n\t}\r\n\r\n\ttickGamepads(){\r\n\t\tconst axis=this.gameAxis;\r\n\t\tconst buttons=this.gameButtons;\r\n\t\tconst previous=this.gamePrevious;\r\n\t\tthis.gamePrevious=buttons.slice();\r\n\r\n\t\tconst rx=axis[2];\r\n\t\tconst spin=-rx*rx*rx*10;\r\n//\t\tthis.heading+=spin;\r\n\r\n\t\tthis.jogHeading(spin);\r\n\r\n\t\tif(buttons[5] && !previous[5]){\r\n\t\t\tconsole.log(\"zoom in\");\r\n\t\t\tthis.jogLevel(-1);\r\n\t\t}\r\n\t\tif(buttons[4] && !previous[4]){\r\n\t\t\tconsole.log(\"zoom out\");\r\n\t\t\tthis.jogLevel(1);\r\n\t\t}\r\n\r\n\t\tthis.jogZoom((buttons[6]-buttons[7]));\r\n//\t\tthis.jogZoom(axis[3]*0.25);\r\n\t\tthis.jogDolly(axis[0],axis[1]);\r\n\t}\r\n\r\n\tsingletouch(touchevent){\r\n\t\tconst scale=this.pixelSize;\r\n\t\tconst type=touchevent.type;\r\n\t\tconst ts=touchevent.timeStamp;\r\n\r\n\t\tswitch(type){\r\n\t\t\tcase \"touchstart\":{\r\n\t\t\t\tconst t=touchevent.touches[0];\r\n\t\t\t\tconst cx=scale*t.clientX;\r\n\t\t\t\tconst cy=scale*t.clientY;\r\n\t\t\t\tconst p={x:cx,y:cy,ts:ts};\r\n\t\t\t\tthis.pointerTrack.push(p);\r\n\t\t\t\tthis.mousedown=true;\r\n\t\t\t}break;\r\n\r\n\t\t\tcase \"touchmove\":{\r\n\t\t\t\tconst t=touchevent.touches[0];\r\n\t\t\t\tconst cx=scale*t.clientX;\r\n\t\t\t\tconst cy=scale*t.clientY;\r\n\t\t\t\tconst p={x:cx,y:cy,ts:ts};\r\n\t\t\t\tconst pp=this.pointerTrack.slice(-1)[0];\r\n\t\t\t\tthis.pointerTrack.push(p);\r\n\t\t\t\tif(pp){\r\n\t\t\t\t\tconst dx=cx-pp.x;\r\n\t\t\t\t\tconst dy=cy-pp.y;\r\n\t\t\t\t\tthis.drag(-dx,dy);\r\n\t\t\t\t}\r\n\t\t\t}break;\r\n\r\n\t\t\tcase \"touchcancel\":\r\n\t\t\tcase \"touchend\":{\r\n\t\t\t\tconst pp=this.pointerTrack.slice(-1)[0];\r\n\t\t\t\tconst p={x:pp.x,y:pp.y,ts:ts};\r\n\t\t\t\tthis.pointerTrack.push(p);\r\n\t\t\t\tthis.mousedown=false;\r\n\t\t\t\tconst v=this.pointerSpeed();\r\n\t\t\t\tconst t=this.pointerTime();\r\n\t\t\t\tconst speed2=v.x*v.x+v.y*v.y;\r\n\t\t\t\tif(speed2>1){\r\n\t\t\t\t\tconst force=1.0;\r\n\t\t\t\t\tthis.fling(-v.x,v.y,force);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(t<200){\r\n\t\t\t\t\t\tthis.click();\r\n\t\t\t\t\t\tconsole.log(\"touch click\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tthis.pointerTrack=[];\r\n\t\t\t}break;\r\n\t\t}\r\n\t}\r\n\r\n\tmultitouch(touchevent){\r\n\t\tconst scale=this.pixelSize;\r\n\t\tconst type=touchevent.type;\r\n\t\tconst ts=touchevent.timeStamp;\r\n\t\tconst touches=touchevent.touches;\r\n\t\tswitch(type){\r\n\t\t\tcase \"touchstart\":{\r\n\t\t\t\tthis.touchTrack.push({touches:touches,ts:ts});\r\n\t\t\t}break;\r\n\t\t\tcase \"touchmove\":{\r\n\t\t\t\tconst prev=this.touchTrack.slice(-1)[0];\r\n\t\t\t\tif(prev){\r\n\t\t\t\t\tconst ptt=prev.touches;\r\n\t\t\t\t\tconst pts=prev.ts;\r\n\r\n\t\t\t\t\tthis.touchTrack.push({touches:touches,ts:ts});\r\n\r\n\t\t\t\t\tconst cx0=touches[0].clientX;\r\n\t\t\t\t\tconst cy0=touches[0].clientY;\r\n\t\t\t\t\tconst cx1=touches[1].clientX;\r\n\t\t\t\t\tconst cy1=touches[1].clientY;\r\n\r\n\t\t\t\t\tconst px0=ptt[0].clientX;\r\n\t\t\t\t\tconst py0=ptt[0].clientY;\r\n\t\t\t\t\tconst px1=ptt[1].clientX;\r\n\t\t\t\t\tconst py1=ptt[1].clientY;\r\n\r\n\t\t\t\t\tconst dragy=scale*((cy1+cy0)-(py1+py0));\r\n\t\t\t\t\tconst dragx=scale*((cx1+cx0)-(px1+px0));\r\n\r\n\t\t\t\t\tconst r=Math.atan2(cy1-cy0,cx1-cx0);\r\n\t\t\t\t\tconst rr=Math.atan2(py1-py0,px1-px0);\r\n\r\n\t\t\t\t\tconst rotate=(rr-r)*HeadingsPerRevolution;\r\n\r\n\t\t\t\t\tconst d=(cx1-cx0)*(cx1-cx0)+(cy1-cy0)*(cy1-cy0);\r\n\t\t\t\t\tconst dd=(px1-px0)*(px1-px0)+(py1-py0)*(py1-py0);\r\n\t\t\t\t\tconst widen=0.5 * (Math.sqrt(d)-Math.sqrt(dd));\r\n\r\n\t\t\t\t\tif(Math.abs(dragy)>1){\r\n\t//\t\t\t\t\tthis.jogTilt(-0.05*dragy);\r\n\t\t\t\t\t\tthis.drag(0,dragy);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(Math.abs(dragx)>1){\r\n\t\t\t\t\t\tthis.drag(-dragx,0);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(Math.abs(rotate)>1){\r\n\t\t\t\t\t\tthis.heading-=rotate*8;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(Math.abs(widen)>1){\r\n\t\t\t\t\t\tthis.jogZoom(-widen);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}break;\r\n\t\t\tcase \"touchcancel\":\r\n\t\t\tcase \"touchend\":\r\n\t\t\t\tthis.touchTrack=[];\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\ttouch(touchevent){\r\n\t\ttouchevent.preventDefault();\r\n\t\tconst type=touchevent.type;\r\n\t\tconst touches=touchevent.touches;\r\n\t\tlet count=touches.length;\r\n//\t\tconsole.log(\"touchevent type:\"+type+\" count:\"+count);\r\n//\t\tcount=count||this.touchCount;\r\n\r\n\t\tswitch(type){\r\n\t\t\tcase \"touchstart\":\r\n\t\t\t\tthis.touchCount=count;\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"touchmove\":\r\n\t\t\t\tif(count!=this.touchCount) {\r\n//\t\t\t\t\tthis.pointerTrack=[];\r\n\t\t\t\t\tthis.touchTrack=[];\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"touchcancel\":\r\n\t\t\tcase \"touchend\":\r\n\t\t\t\tcount=this.touchCount;\r\n\t\t\t\tthis.touchCount=0;\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\r\n\t\tswitch(count){\r\n\t\t\tcase 1:\r\n\t\t\t\tthis.singletouch(touchevent);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 2:\r\n\t\t\t\tthis.multitouch(touchevent);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\tpointerTime(){\r\n\t\tconst t=this.pointerTrack.length-1;\r\n\t\tif(t>0){\r\n\t\t\tconst p0=this.pointerTrack[0];\r\n\t\t\tconst p1=this.pointerTrack[t];\r\n\t\t\treturn p1.ts-p0.ts;\r\n\t\t}\r\n\t}\r\n\r\n\tpointerSpeed(){\r\n\t\tconst n=this.pointerTrack.length;\r\n\t\tlet vx=0;\r\n\t\tlet vy=0;\r\n\t\tlet vv=0;\r\n\t\tlet t=n-1;\r\n\t\tlet stale=0;\r\n\t\twhile(t>1){\r\n\t\t\tconst p0=this.pointerTrack[t];\r\n\t\t\tconst p1=this.pointerTrack[t-1];\r\n\t\t\tconst dt=p0.ts-p1.ts;\r\n\t\t\tstale+=dt;\r\n\t\t\tif(stale>150){\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t\tif(dt>0){\r\n\t\t\t\tconst m=15/dt;\r\n\t\t\t\tconst dx=(p0.x-p1.x)*m;\r\n\t\t\t\tconst dy=(p0.y-p