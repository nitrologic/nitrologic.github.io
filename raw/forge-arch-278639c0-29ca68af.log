279ecc79 [gemini-3.8-flash] #On Arch Linux, the conventions adhere closely to the XDG Base Directory specification and the
279ecc79 [gemini-3.8-flash] #Filesystem Hierarchy Standard (FHS). Here are the primary options depending on whether you want the
279ecc79 [gemini-3.8-flash] #scripts accessible to a single user or system-wide:
279ecc79 [gemini-3.8-flash] #
279ecc79 [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
279ecc79 [gemini-3.8-flash] #
279ecc79 [gemini-3.8-flash] #1. User-Specific Locations (Recommended)
279ecc79 [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #These directories do not require root privileges (`sudo`) to add or edit scripts, keeping your
279ecc7a [gemini-3.8-flash] #personal workflow clean and isolated.
279ecc7a [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #• `~/.local/bin`
279ecc7a [gemini-3.8-flash] #  * Status: The modern standard (XDG-compliant).
279ecc7a [gemini-3.8-flash] #  * Behavior: Systemd-based user sessions and many desktop environments automatically
279ecc7a [gemini-3.8-flash] #append this directory to `$PATH` if it exists when you log in. If not already present, you can add
279ecc7a [gemini-3.8-flash] #it to your shell configuration (`~/.bashrc`, `~/.zshrc`, etc.).
279ecc7a [gemini-3.8-flash] #  * Best for: General user scripts, Python user installs (`pip install --user`), and
279ecc7a [gemini-3.8-flash] #standard user-level binaries.
279ecc7a [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #• `~/bin`
279ecc7a [gemini-3.8-flash] #  * Status: Traditional Unix convention.
279ecc7a [gemini-3.8-flash] #  * Behavior: Historically popular and often supported out-of-the-box by default shell
279ecc7a [gemini-3.8-flash] #skeleton files (`/etc/skel/.bashrc`).
279ecc7a [gemini-3.8-flash] #  * Best for: Personal preference if you prefer fewer subdirectories in your home folder.
279ecc7a [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #• `~/.deno/bin`
279ecc7a [gemini-3.8-flash] #  * Status: Deno-specific standard.
279ecc7a [gemini-3.8-flash] #  * Behavior: Default installation target when running `deno install`.
279ecc7a [gemini-3.8-flash] #  * Best for: Isolating Deno-managed executables. You can either export this directly into
279ecc7a [gemini-3.8-flash] #your `$PATH` or keep your general scripts in `~/.local/bin` and symlink into it.
279ecc7a [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
279ecc7a [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #2. System-Wide Locations
279ecc7a [gemini-3.8-flash] #
279ecc7a [gemini-3.8-flash] #These directories apply to every user account on the machine and require root permissions to manage
279ecc7a [gemini-3.8-flash] #files.
279ecc7b [gemini-3.8-flash] #
279ecc7b [gemini-3.8-flash] #• `/usr/local/bin`
279ecc7b [gemini-3.8-flash] #  * Status: Standard system administrator hierarchy (FHS).
279ecc7b [gemini-3.8-flash] #  * Behavior: Pre-configured in `$PATH` on practically all Arch Linux installations.
279ecc7b [gemini-3.8-flash] #  * Best for: Custom tools, compiled utilities, or team-shared scripts meant for all users
279ecc7b [gemini-3.8-flash] #without conflicting with Arch's package manager (`pacman`).
279ecc7b [gemini-3.8-flash] #
279ecc7b [gemini-3.8-flash] #• `/usr/bin`
279ecc7b [gemini-3.8-flash] #  * Status: Managed strictly by `pacman`.
279ecc7b [gemini-3.8-flash] #  * Recommendation: Avoid placing custom scripts here directly, as package upgrades or name
279ecc7b [gemini-3.8-flash] #collisions could cause issues or overwrite files.
279ecc7b [gemini-3.8-flash] #
279ecc7b [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
279ecc7b [gemini-3.8-flash] #
279ecc7b [gemini-3.8-flash] #Recommendation
279ecc7b [gemini-3.8-flash] #
279ecc7b [gemini-3.8-flash] #For Deno scripts and local utility shortcuts on Arch, `~/.local/bin` (or
279ecc7b [gemini-3.8-flash] #`~/.deno/bin` if relying heavily on `deno install`) offers the smoothest integration with
279ecc7b [gemini-3.8-flash] #contemporary Linux tooling.
279ecc7b [gemini-3.8-flash] #
