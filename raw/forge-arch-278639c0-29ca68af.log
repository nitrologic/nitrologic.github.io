 {\r\n\t\tlet offset = this.bufferPosition;\r\n\t\tif(samples){\r\n\t\t\tthis.leftBuffer.set(this.buffer.subarray(0, 128), offset);\r\n\t\t\tthis.rightBuffer.set(this.buffer.subarray(128, 256), offset);\r\n\t\t\tthis.bufferPosition += 128;\r\n\t\t}\r\n\t\tif (samples==0||this.bufferPosition === 1024) {\r\n\t\t\tthis.worklet.port.postMessage({\r\n\t\t\t\tname: \"vsynth\",\r\n\t\t\t\tleft: this.leftBuffer,\r\n\t\t\t\tright: this.rightBuffer,\r\n\t\t\t\tcount: this.bufferPosition,\r\n\t\t\t\taudio: true\r\n\t\t\t}, [this.leftBuffer.buffer, this.rightBuffer.buffer]);\r\n\t\t\tthis.leftBuffer = new Float64Array(1024);\r\n\t\t\tthis.rightBuffer = new Float64Array(1024);\r\n\t\t\tthis.bufferPosition = 0;\r\n\t\t}\r\n\t}\r\n\r\n\tSetCapture(on) {\r\n\t\tif (on==this.capture) return;\r\n\t\tif (on) {\r\n\t\t\tthis.bufferPosition = 0;\r\n\t\t}else{\r\n\t\t\tthis.captureAudio(0);\r\n\t\t}\r\n\t\tthis.capture = on;\r\n\t}\r\n\r\n\t// line.command=\"pcm64\";\r\n\r\n\tRawAudioIn(event){\r\n\t\tlet command=event.command;\r\n\t\tlet data64=event.data;\r\n\t\tlet count=event.count;\r\n\t\tlet rate=event.rate;\r\n\t\tlet source=event.source;\r\n\t\tif(!(source in this.inputStreams)){\r\n\t\t\tthis.inputStreams[source]=new Stream(count);\r\n\t\t}\r\n\t\tlet stream=this.inputStreams[source];\r\n\t\tstream.Feed(data64,count,rate);\r\n\t}\r\n\r\n\tSetAmp(id,lfoIndex,target,index,factor)\r\n\t{\r\n\t\tif(!(lfoIndex in this.lfo)) return;\r\n\t\tif(!(id in this.amp)){\r\n\t\t\tlog(\"adding amp id:\"+id);\r\n\t\t\tlet amp=new Amp(id);\r\n\t\t\tthis.amp[id]=amp;\r\n\t\t}\r\n\t\tlet amp=this.amp[id]\r\n\t\tif(amp.lfo!=lfoIndex){\r\n\t\t\tif(amp.lfo){\r\n\t\t\t\tlet lfo=this.lfo[amp.lfo];\r\n\t\t\t\tthis.ResetAmp(amp);\r\n\t\t\t\tlfo.DropAmp(amp);\r\n\t\t\t}\r\n\t\t\tlet lfo=this.lfo[lfoIndex];\r\n\t\t\tlfo.AddAmp(amp);\r\n\t\t\tamp.lfo=lfoIndex;\r\n\t\t}\r\n\t\tamp.SetParam(target,index,factor);\r\n\t}\r\n\r\n\tSetLFO(index,osc,pow,freq,sync,gain)\r\n\t{\r\n\t\tif(!(index in this.lfo)){\r\n\t\t\tlog(\"adding lfo\");\r\n\t\t\tlet lfo=new LFO();\r\n\t\t\tthis.lfo[index]=lfo;\r\n//\t\t\tthis.poly.addLFO(lfo);\r\n//\t\t\tthis.mono.addLFO(lfo);\t\t\t\r\n\t\t}\r\n\t\tlet lfo=this.lfo[index];\r\n\t\tlfo.SetLFOParam(osc,pow,freq,sync,gain);\r\n\t}\r\n\r\n\tSetFilter(index,enabled,type,cutoff,q){\r\n\t\tif(!(index in this.filter)){\r\n\t\t\tlog(\"adding filter\");\r\n\t\t\tlet biquad=new BiquadFilter();\r\n\t\t\tthis.filter[index]=biquad;\r\n\t\t\tthis.poly.addFilter(biquad);\r\n\t\t\tthis.mono.addFilter(biquad);\r\n\t\t}\r\n\t\tlet filter=this.filter[index];\r\n\t\tfilter.SetFilterParam(enabled,type,cutoff,q);\r\n\t}\r\n\r\n\tSetArpeggiation(algo,prog){\r\n\t\tthis.arp.SetArpeggiation(algo,prog);\r\n\t}\r\n\r\n\tSetTempo(tempo){\r\n\t\tthis.arp.SetTempo(tempo);\r\n\t}\r\n\r\n\tSetBeat(div,duty,reps){\r\n\t\tthis.arp.SetBeat(div,duty,reps);\r\n\t}\r\n\r\n\t// mono,poly,external\r\n\r\n\tSetMode(synthmode){\r\n\t\tthis.synthVicious=synthmode;\r\n\t\tswitch(synthmode){\r\n\t\t\tcase 0:\r\n\t\t\t\tthis.arp.SetSynth(this.mono);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 1:\r\n\t\t\t\tthis.arp.SetSynth(this.poly);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 2:\r\n\t\t\t\tthis.arp.SetSynth(this.outboard);\r\n\t\t\t\tbreak;\r\n\t\t}\t\t\r\n\t}\r\n\r\n\tResetAmp(amp){\r\n\t\tlet index=amp.index;\r\n\t\tlet factor=amp.factor*amp.factor2;\r\n\t\tlet phase=amp.phase;\r\n\t\tlet v=0;\r\n\t\tswitch (amp.target){\r\n\t\t\tcase 2://filter cutoff\r\n\t\t\t\tlet filter0=this.filter[index];\r\n\t\t\t\tif(filter0) {\r\n\t\t\t\t\tfilter0.cutoff2=0;\r\n\t\t\t\t\tfilter0.updateCoefficients();\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 3://filter Q\r\n\t\t\t\tlet filter1=this.filter[index];\r\n\t\t\t\tif(filter1) {\r\n\t\t\t\t\tfilter1.Q2=0;\r\n\t\t\t\t\tfilter1.updateCoefficients();\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 4://lfo fade\r\n\t\t\t\tlet lfo0=this.lfo[index];\r\n\t\t\t\tif(lfo0) lfo0.fade=0;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 5://lfo rate\r\n\t\t\t\tlet lfo1=this.lfo[index];\r\n\t\t\t\tif(lfo1) lfo1.rate=1;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 6:// amp factor\r\n\t\t\t\tlet amp0=this.amp[index];\r\n\t\t\t\tif(amp0) amp0.factor2=1;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 7:// amp phase\r\n\t\t\t\tlet amp1=this.amp[index];\r\n\t\t\t\tif(amp1) amp1.phase=0;\r\n\t\t\t\tbreak;\r\n\t\t\tcase 8:// effect value\r\n\t\t\t\tlet names=this.effects.ControlNames();\r\n\t\t\t\tif(index in names){\r\n\t\t\t\t\tlet name=names[index];\r\n\t\t\t\t\tthis.effectValues[name]=0;\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\r\n\tupdateLFO(samples){\r\n\t\tfor(const lfo of this.lfo){\r\n\t\t\tlet amps=lfo.amps;\r\n\t\t\tfor(let amp of amps){\r\n\t\t\t\tlet index=amp.index;\r\n\t\t\t\tlet factor=amp.factor*amp.factor2;\r\n\t\t\t\tlet phase=amp.phase;\r\n\t\t\t\tlet v=0;\r\n\t\t\t\tswitch (amp.target){\r\n\t\t\t\t\tcase 0://tremolo\r\n\t\t\t\t\t\tlet fade=this.fadeBuffer;\r\n\t\t\t\t\t\tfor (let i=0;i < samples;i++){\r\n\t\t\t\t\t\t\tv=lfo.Sample(i,phase);\t\t\r\n\t\t\t\t\t\t\tfade[i]+=v*factor;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 1://vibrato\r\n\t\t\t\t\t\tlet rate=this.rateBuffer;\r\n\t\t\t\t\t\tfor (let i=0;i < samples;i++){\r\n\t\t\t\t\t\t\tv=lfo.Sample(i,phase);\r\n\t\t\t\t\t\t\trate[i]+=v*factor;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tbreak;\t\t\t\t\t\t\t\r\n\t\t\t\t\tcase 2://filter cutoff\r\n\t\t\t\t\t\tlet filter0=this.filter[index];\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tif(filter0) {\r\n\t\t\t\t\t\t\tfilter0.cutoff2=v*factor*100;\r\n\t\t\t\t\t\t\tfilter0.updateCoefficients();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 3://filter Q\r\n\t\t\t\t\t\tlet filter1=this.filter[index];\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tif(filter1) {\r\n\t\t\t\t\t\t\tfilter1.Q2=v*factor;\r\n\t\t\t\t\t\t\tfilter1.updateCoefficients();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 4://lfo fade\r\n\t\t\t\t\t\tlet lfo0=this.lfo[index];\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tif(lfo0) lfo0.fade=v*factor;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 5://lfo rate\r\n\t\t\t\t\t\tlet lfo1=this.lfo[index];\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tif(lfo1) lfo1.rate=v*factor;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 6:// amp factor\r\n\t\t\t\t\t\tlet amp0=this.amp[index];\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tif(amp0) amp0.factor2=v;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 7:// amp phase\r\n\t\t\t\t\t\tlet amp1=this.amp[index];\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tif(amp1) amp1.phase=v;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 8:// effect value\r\n\t\t\t\t\t\tv=lfo.Sample(samples,phase);\r\n\t\t\t\t\t\tlet names=this.effects.ControlNames();\r\n\t\t\t\t\t\tif(index in names){\r\n\t\t\t\t\t\t\tlet name=names[index];\r\n\t\t\t\t\t\t\tthis.effectValues[name]=v*factor;\t// warning not safe, stay away\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tlfo.Step(samples);\r\n\t\t}\r\n\t}\r\n\r\n\t// MixAudiobuffers was FillAudioBuffer\r\n\r\n\tmixAudioBuffers(samples){\r\n\r\n\t\tlet pan=this.effectValues[\"position_pan\"]||0;\r\n\t\tlet overdrive0=this.effectValues[\"distortion_overdrive\"]||20;\r\n\t\tlet gain0=this.effectValues[\"distortion_gain\"]||1.0;\r\n\t\tlet wet0=this.effectValues[\"reverb_wet\"]||1;\r\n\t\tlet dry0=this.effectValues[\"reverb_dry\"]||1;\r\n\t\tlet falloff0=this.effectValues[\"reverb_falloff\"]||1.5;\r\n\r\n\t\t// hardcode modulation wheel test\r\n\t\tgain0*=(2.0+this.modulate)/5;\r\n\r\n\t\tlet effect=this.effectBuffers;\r\n\t\tfor (let i=0;i < samples;i++){\r\n\t\t\tthis.buffer[i*2+0]=0;\r\n\t\t\tthis.buffer[i*2+1]=0;\r\n\t\t\tthis.rateBuffer[i]=1.0+this.detune0+i*(this.detune-this.detune0)/samples;\r\n\t\t\tthis.fadeBuffer[i]=this.fade0+i*(this.fade-this.fade0)/samples;\r\n\t\t\teffect.overdrive[i]=overdrive0;\r\n\t\t\teffect.gain[i]=gain0;\r\n\t\t\teffect.wet[i]=wet0;\r\n\t\t\teffect.dry[i]=dry0;\r\n\t\t\teffect.falloff[i]=falloff0;\r\n\t\t}\r\n\t\tthis.detune0= this.detune;\r\n\t\tthis.fade0= this.fade;\t\r\n\t\t// apply LFO matrix to 0 fade 1 gain 2 nextfade 3 nxextgain\r\n\r\n\t\tthis.updateLFO(samples);\r\n\r\n\t\t//let controls=this.effectBuffers;\r\n\t\tlet controls=[effect.overdrive,effect.gain,effect.wet,effect.dry,effect.falloff];\r\n\r\n\t\tthis.root.FillAudioBuffer(this.buffer,samples,this.rateBuffer,this.fadeBuffer,pan);\r\n\t\tfor (const [key,stream] of Object.entries(this.inputStreams)){\r\n\t\t\tstream.Mix(this.buffer,samples);\r\n\t\t}\r\n\t\tif(this.samplers){\r\n\t\t\tfor (let sampler of this.samplers){\r\n\t\t\t\tlet sampleControls=[];\r\n\t\t\t\tsampler.Mix(this.buffer,samples,sampleControls);\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (this.effecting){\r\n\t\t\tthis.effects.EffectAudio(this.buffer,samples,controls);\r\n\t\t}\r\n\t\tthis.Duration += samples;\r\n\r\n\t\tif(this.scope){\r\n\t\t\tthis.PlotScope(samples);\r\n\t\t}\r\n\r\n\t\tif(this.capture){\r\n\t\t\tthis.captureAudio(samples);\r\n\t\t}\r\n\r\n\t\tif (this.recording){\r\n\t\t\tthis.Record(this.buffer,samples);\r\n\t\t}\r\n/*\r\n\t\tlet keys=this.root.GetKeys();\r\n\t\tlet keystate=keys.ToJson();\r\n\t\tif(keystate!=this.keystate){\r\n\t\t\tthis.keystate=keystate;\r\n\t\t\tlog(\"keystate : \"+keystate)\r\n\t\t}\r\n*/\r\n\t\treturn this.buffer;\r\n\t}\r\n\r\n\ttoggleRecord(){\r\n\t\tthis.recording= !this.recording;\r\n\t}\r\n\r\n\tPanic(){\r\n\t\tthis.SetSustain(false);\r\n\t\tthis.root.Panic();\r\n\t}\r\n\r\n\tSetValue(slide){\r\n\t\t\r\n\t}\r\n\r\n\tSetEffect(effecting){\r\n\t\tthis.effecting=effecting;\r\n\t\tlog(\"effecting : \"+(this.effecting?\"true\":\"false\"));\r\n\t}\r\n\r\n\tSetRecord(arm){\r\n\t\tif(arm && !this.recording){\r\n\t\t\tthis.recordPos = 0;\r\n\t\t\tthis.passCount = 0;\r\n\t\t}\r\n\t\tthis.recording=arm;\r\n\t\tthis.emitSnapshot();\r\n\t}\r\n\r\n\tSetSustain(sustain){\r\n\t\tthis.root.SetSustain(sustain);\r\n\t}\r\n\r\n\tSetHold(hold){\r\n\t\tthis.root.SetHold(hold);\r\n\t}\r\n\r\n\tSetTimbre(osc,env,pow){\r\n\t\tthis.root.SetTimbre(osc,env,pow);\r\n\t}\r\n\r\n\tNoteOn(note,velocity){\r\n\t\tthis.root.NoteOn(note,velocity);\r\n\t}\r\n\r\n\tNoteOff(note){\r\n\t\tthis.root.NoteOff(note);\r\n\t}\r\n\r\n\tGetKeys(){\r\n\t\treturn this.root.GetKeys();\r\n\t}\r\n\r\n\t// AudioWorkletProcessor entry point\r\n\r\n\tonCommands(commands){\r\n\t\tfor(const line of commands){\r\n//\t\t\tlog(\"[VSYNTH] \"+JSON.stringify(line));\r\n\t\t\tswitch(line.command){\t\t\t\t\r\n\t\t\t\tcase \"pcm64\":\r\n\t\t\t\t\tthis.RawAudioIn(line);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"stop\":\r\n\t\t\t\t\tthis.Panic();\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"panic\":\r\n\t\t\t\t\tthis.Panic();\r\n\t\t\t\t\tthis.emitSnapshot();\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"noteon\":\r\n\t\t\t\t\tlet note1=line.note+this.transpose;\r\n \t\t\t\t\tlet velocity=line.velocity;\r\n\t\t\t\t\tthis.NoteOn(note1,velocity);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"noteoff\":\r\n\t\t\t\t\tlet note2=line.note+this.transpose;\r\n\t\t\t\t\tthis.NoteOff(note2);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"controlchange\":\r\n\t\t\t\t\tlet control=line.control;\r\n\t\t\t\t\tswitch(control){\r\n\t\t\t\t\t\tcase 1:\r\n\t\t\t\t\t\t\tthis.modulate=line.value;\r\n//\t\t\t\t\t\t\tlog(\"modulate 1\");\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 4:\r\n\t\t\t\t\t\t\tthis.modulate=line.value;//foot pedal\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 6:\r\n\t\t\t\t\t\t\tthis.SetValue(line.value);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 10:\r\n\t\t\t\t\t\t\tlet pan=(line.value-64)/60.0;\r\n\t\t\t\t\t\t\tif(pan<-1) pan=-1;\r\n\t\t\t\t\t\t\tif(pan>1) pan=1;\r\n\t\t\t\t\t\t\tthis.effectValues[\"position_pan\"]=pan;\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 64:\r\n\t\t\t\t\t\t\tthis.SetSustain(line.value);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 44:\r\n//\t\t\t\t\t\t\tthis.SetRecord(line.value>0);\r\n\t\t\t\t\t\t\tthis.SetCapture(line.value>0);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 176://48://176:\r\n\t\t\t\t\t\t\tthis.modulate=line.value;\r\n\t\t\t\t\t\t\tlog(\"modulate 176\");\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 49:\r\n\t\t\t\t\t\t\tthis.SetHold(line.value>0);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 50:\r\n\t\t\t\t\t\t\tthis.SetEffect(line.value>0);\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 96:\r\n\t\t\t\t\t\t\tthis.transpose+=12;\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 224://96://224:\r\n\t\t\t\t\t\t\tlet bend=(line.value-8192)/8000;\r\n\t\t\t\t\t\t\tif ((bend*bend)<0.020) bend=0;\r\n\t\t\t\t\t\t\tif(bend>1) bend=1;\r\n\t\t\t\t\t\t\tif(bend<-1) bend=-1;\r\n\t\t\t\t\t\t\tthis.detune=bend;\r\n//\t\t\t\t\t\t\tlog(\"detune : \"+bend)\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 97:\r\n\t\t\t\t\t\t\tthis.transpose-=12;\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 123:\r\n\t\t\t\t\t\t\tthis.Panic();\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tdefault:\r\n\t\t\t\t\t\t\tlog(\"?controller control : \"+line.control+\" value : \"+line.value,true);\r\n\t\t\t\t\t}\t\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"beat\":\r\n\t\t\t\t\tthis.SetBeat(line.div,line.duty,line.reps);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"amp\":\r\n\t\t\t\t\tthis.SetAmp(line.id,line.lfo,line.target,line.index,line.factor);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"lfo\":\r\n\t\t\t\t\tthis.SetLFO(line.index,line.oscillator,line.power,line.frequency,line.sync,line.gain);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"filter\":\r\n\t\t\t\t\tthis.SetFilter(line.index,line.enabled,line.type,line.cutoff,line.Q);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"arp\":\r\n\t\t\t\t\tthis.SetArpeggiation(line.algo,line.prog);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"tempo\":\r\n\t\t\t\t\tthis.SetTempo(line.bpm);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"voice\":\r\n\t\t\t\t\tthis.SetMode(line.mode);\r\n\t\t\t\t\tthis.SetTimbre(line.oscillator,line.envelope,line.power);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"snapshot\":\r\n\t\t\t\t\tthis.emitSnapshot();\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"effect\":\r\n\t\t\t\t\tlet effect=line.control;\r\n\t\t\t\t\tlet value=line.value;\r\n\t\t\t\t\tthis.effectValues[effect]=value;\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tdefault:\r\n\t\t\t\t\tlog(\"VSynth::onEvent unsupported command : \"+line.command,true);\r\n\t\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitro-wire.js\",\"length\":1826,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs nitro-wire.js\n// (c)2025 Simon Armstrong \n// All rights reserved\n\n// load the wire_ scripts and invoke onWire() finction in wire_grid.js\n\nvar wireDiv,wireBar,wireTools,wireBody,wireFullscreen;\n\nfunction fullscreenWire(){\n\twireBody.requestFullscreen();\n}\n\nvar loadedScripts=[];\n\nfunction loadScripts(names){\n\tvar count=names.length;\n\tfor(var name of names){\n\t\tvar script=document.createElement(\"script\");\n\t\tscript.onload=function(){\n\t\t\tloadedScripts.push(script);\n\t\t\tif(loadedScripts.length==count){\n\t\t\t\tconsole.log(\"All wire scripts loaded\");\n\t\t\t\tinitWireGrid(wireBody);\n\t\t\t}\n\t\t}\n\t\tdocument.body.appendChild(script);\n\t\tscript.src=\"wirejs/wire_\"+name+\".js\";\n\t}\n}\n\nconst wireScripts=[\n\t\"core\",\n\t\"display\",\n\t\"drawsurface\",\n\t\"field\",\n\t\"geometry\",\n\t\"graphics\",\n\t\"grid\",\n\t\"immersion\",\n\t\"model\",\n\t\"surface\",\"system\",\n\t\"topo\",\n\t\"util\"\n];\n\nconst wireWorkers=[\n\t\"baker\",\n\t\"fetch\",\n\t\"post\"\n];\n\nconst GridHome=\"https://github.com/nitrologic/roagrid\";\n\nfunction initWire(){\n\twireDiv=document.getElementById(\"wire\");\n\tif(!wireDiv) return false;\n\twireBar=addTitle(wireDiv,\"GRID6\");\n\taddTitle(wireDiv,\"grid6\",GridHome);\n\twireFullscreen=addToolButton(wireBar,\"[⛶]<Enter full screen>\",fullscreenWire, {command:\"wire.fullscreen\",inline:\"true\"});\n\tconst details=createContent(wireBar,\"WebGL Disply Demo feeding on <a href='https://github.com/nitrologic/roagrid'>roagrid</a> - data courtesy <a href='https://linz.govt.nz'>Land Information New Zealand</a>\");\n\twireBar.append(...details);\n\twireTools=addToolbar(wireDiv);\n\twireBody=addDiv(\"wire\",wireTools);\n// TODO: switch between debug and realtime engines\n\tinitWireGrid(wireBody);\n//\tloadScripts(wireScripts);\n//\taddTool(wireTools,\"Unmute\",\"wire.unmute\",unmutewire);\n//\taddTool(wireTools,\"Mute\",\"wire.mute\",mutewire);\n//\twireVolume=addMidiSlider(wireTools,\"gain\",16,onwireGain,40);\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker-vscope.js\",\"length\":1401,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs worker-vscop\r\n// (C)2024 nitrologic\r\n// ALL RIGHTS RESERVED\r\n\r\n// courtesy dspprocessor\r\n// emits \"scope\"\r\n\r\nclass VScopeAudioProcessor extends AudioWorkletProcessor {\r\n\tconstructor() {\t\t\r\n\t\tsuper();\r\n\t\tthis.osc=0.0; // test tone\r\n\t\tthis.reads=0;\r\n\t\tthis.writes=0;\r\n\t\tthis.outs=0;\r\n\t\tthis.count=0;\r\n\t}\r\n\r\n\tprocess(inputs, outputs, parameters) {\r\n\t\tif(inputs && inputs.length>0){\r\n\t\t\tvar in0=inputs[0];\r\n\t\t\tvar channels=in0.length;\r\n\t\t\tif(channels==2){\r\n\t\t\t\tvar name=\"scope\";\r\n\t\t\t\tvar left=in0[0];\r\n\t\t\t\tvar right=in0[1];\r\n\t\t\t\tvar n=left.length;\r\n\t\t\t\tthis.writes+=n;\r\n\t\t\t\tthis.port.postMessage({name,left,right,count:this.count++});\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(outputs && outputs.length>0 && parameters.beep){\r\n\t\t\tvar out0=outputs[0];\r\n\t\t\tvar channels=out0.length;\r\n\t\t\tvar left=out0[0];\r\n\t\t\tvar right=out0[1];\r\n\t\t\tvar osc=this.osc;\r\n\t\t\tvar n=left.length;\r\n\t\t\tif(channels==1){\r\n\t\t\t\tfor(var i=0;i<n;i++){\r\n\t\t\t\t\tvar saw=(1.0-(osc%2.0));\r\n\t\t\t\t\tvar sin=Math.sin(osc*22);\r\n\t\t\t\t\tleft[i]=0.5*saw+0.2*sin;\r\n\t\t\t\t\tosc+=140.0/44100;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif(channels==2){\r\n\t\t\t\tfor(var i=0;i<n;i++){\r\n\t\t\t\t\tvar saw=(1.0-(osc%2.0));\r\n\t\t\t\t\tvar sin=Math.sin(osc*22);\r\n\t\t\t\t\tleft[i]=0.5*saw+0.2*sin;\r\n//left[i]=Math.sin(osc/Math.PI);\r\n\t\t\t\t\tright[i]=left[i];\r\n\t\t\t\t\tosc+=140.0/44100;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.osc=osc;\r\n\t\t\tthis.outs+=n;\r\n\t}\r\n\t\treturn true;\r\n\t}\r\n}\r\n\r\nregisterProcessor('VScopeAudioProcessor', VScopeAudioProcessor);\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker_post.js\",\"length\":848,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wireworker.js\r\n\r\nconst _unicode = new TextEncoder();\r\n\r\nlet outgoing=[];\r\nlet connected=false;\r\n\r\nonmessage = (message) => {\r\n\tconst data=message.data;\r\n//\tconsole.log(\"wireworker woke\",data.name);\r\n\toutgoing.push(data);\r\n}\r\n\r\nfunction heartbeat(){\r\n\tconst messages=outgoing;\r\n\toutgoing=[];\r\n\tif(connected){\r\n\t\tpost(\"tick\",messages);\r\n\t}\r\n}\r\n\r\nlet timer=setInterval(heartbeat,500);\r\n\r\nfunction post(name,body){\r\n\tevent={name:name,body:body};\r\n\tconst js=JSON.stringify(event);\r\n\tconst bytes=_unicode.encode(js);\r\n\tconst t0=new Date();\r\n\tfetch(\"/fetch\",{\r\n\t\tmethod:'POST',\r\n\t\theaders: {\r\n\t\t\t'Content-Type': 'application/json',\r\n\t\t\t'Content-Length': bytes.length\r\n\t\t},\r\n\t\tbody: bytes\r\n\t})\r\n\t.then(response => response.json())\r\n\t.then(data => {\r\n//\t\tconsole.log(data);\r\n\t\tconst t1=new Date();\r\n\t\tconst d=t1-t0;\r\n\t\tpostMessage({ping:d});\r\n\t});\t\t\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitromarkup.js\",\"length\":9179,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitromarkup.js\r\n// (C)2024 nitrologic\r\n// ALL RIGHTS RESERVED\r\n\r\n// https://datatracker.ietf.org/doc/html/rfc4180\r\n\r\nconst github_href='/github';\r\n\r\nfunction csvHTML(lines){\r\n\tvar html=\"<table><tbody>\";\r\n\tvar rows=[];\r\n\tvar count=0;\r\n\tvar values=[];\r\n\tvar inquote=false;\r\n\tvar cell=\"\";\r\n\tfor(var line of lines){\r\n\t\tvar i=0;\r\n\t\twhile(i<line.length){\r\n\t\t\tvar c=line[i++];\r\n\t\t\tif(cell.length==0 && c=='\"'){\r\n\t\t\t\tinquote=true;\r\n\t\t\t\tcontinue;\r\n\t\t\t}else{\r\n\t\t\t\tif(inquote){\r\n\t\t\t\t\tif(c=='\"'){\r\n\t\t\t\t\t\tif(line[i]=='\"'){\r\n\t\t\t\t\t\t\ti++;\r\n\t\t\t\t\t\t\tcell=cell+'\"';\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tinquote=false;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(c==','){\r\n\t\t\t\t\t\tvalues.push(cell);\r\n\t\t\t\t\t\tcell=\"\";\r\n\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\t\t\t\t\r\n\t\t\t}\r\n\t\t\tcell+=c;\r\n\t\t}\r\n\t\tif(inquote){\r\n\t\t\tcell+=\"<br>\";\t\t\t\t\r\n\t\t}else{\r\n\t\t\tif(cell.length){\r\n\t\t\t\tvalues.push(cell);\r\n\t\t\t\tcell=\"\";\r\n\t\t\t}\r\n\t\t\trows.push(values);\r\n\t\t\tif(values.length>count) count=values.length;\r\n\t\t\tvalues=[];\r\n\t\t}\r\n\t}\r\n\tfor(var row of rows){\r\n\t\thtml+=\"<tr>\";\r\n\t\tfor(var i=0;i<count;i++){\r\n\t\t\tif(i<row.length){\r\n\t\t\t\tvar value=row[i];\r\n\t\t\t\thtml+=\"<td>\"+value+\"</td>\"\r\n\t\t\t}else{\r\n\t\t\t\thtml+=\"<td></td>\"\r\n\t\t\t}\r\n\t\t}\r\n\t\thtml+=\"</tr>\";\r\n\t}\r\n\thtml+=\"</tbody></table>\";\r\n\treturn html;\r\n}\r\n\r\nconst escapeHTML = str => str.replace(/[&<>'\"]/g, \r\n\ttag => ({\r\n\t\t'&': '&amp;',\r\n\t\t'<': '&lt;',\r\n\t\t'>': '&gt;',\r\n\t\t\"'\": '&#39;',\r\n\t\t'\"': '&quot;'\r\n\t}[tag]));\r\n\r\n\r\n// macro keys '²⁰²¹.³'\r\n\r\nfunction escapeChars(text){\r\n\twhile(true){\r\n\t\tvar index=text.indexOf(\"&#\");\r\n\t\tif(index==-1) return text;\r\n\t\tvar term=text.indexOf(\";\",index);\r\n\t\tif(term==-1) return text;\r\n\t\tvar form=text[index+2];\r\n\t\tvar ref=\"\";\r\n\t\tif(form=='x'||form==\"X\"){\r\n\t\t\tvar hex=text.substring(index+3,term);\r\n\t\t\tref=parseInt(hex,16);\r\n\t\t}\r\n\t\tif(form>='0'&&form<='9'){\r\n\t\t\tvar dec=text.substring(index+2,term);\r\n\t\t\tref=parseInt(dec,10);\r\n\t\t}\r\n\t\tvar charCode=String.fromCharCode(ref);\r\n\t\ttext=text.substring(0,index)+charCode+text.substring(term+1);\r\n\t}\r\n\treturn text;\r\n}\r\n\r\nfunction markdownLine(line){\r\n\tlet tabindex=1;\r\n\tlet buffer='';\r\n\tlet depth=0;\r\n\tlet hash=0;\r\n\twhile(line[0]=='#'){\r\n\t\thash++\r\n\t\tline=line.substring(1);\r\n\t}\r\n\tline=']'+line;\r\n\tconst s1=line.split('[');\r\n\tfor(const i in s1){\r\n\t\tconst s=s1[i];\r\n\t\tconst split=s.split(']');\t\r\n\t\tconst blob=split[0];\r\n\t\tif(blob==''){\r\n\t\t\tdepth++;\r\n\t\t}else{\r\n\t\t\tdepth--;\r\n//\t\t\tlet code='<pre>' + escape(blob) + '</pre><br>';\r\n\t\t\tlet code='';\r\n\t\t\tconst split2=blob.split(' ');\r\n\t\t\tconst type=split2[0];\r\n\t\t\tconst path=split2[1];\r\n\t\t\tif(!path){\r\n\t\t\t\tlet name=blob;\r\n\t\t\t\tlet href='';\r\n\t\t\t\tif (name.startsWith(\"https:\")){\r\n\t\t\t\t\thref=name;\r\n\t\t\t\t\tcode='<a href=\"'+href+'\" target=\"blank\">'+name+'</a>';\r\n\t\t\t\t}else if (name.startsWith(\"#\")){\r\n\t\t\t\t\t// yuck - expand local anchors to json arrays\r\n\t\t\t\t\thref=\"#loc[\"+name.substring(1)+\"]\";\r\n\t\t\t\t\tcode='<a href=\"'+href+'\" target=\"_self\">'+name+'</a>';\r\n\t\t\t\t}else{\r\n\t\t\t\t\thref='/doc/'+name.split('-').join('').toLowerCase();\r\n\t\t\t\t\tname=name.split('-').join(' ');\r\n\t\t\t\t\tcode='<a href=\"'+href+'\">'+name+'</a>';\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tconst url=escape(path);\r\n\t\t\t\tswitch(type){\r\n\t\t\t\t\tcase 'connect':\r\n\t\t\t\t\t\tswitch(path){\r\n\t\t\t\t\t\t\tcase 'github':\r\n\t\t\t\t\t\t\t\tcode='login <a href=\"'+github_href+'\">github login</a>';\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase 'position':\r\n\t\t\t\t\t\t\t\tcode='<button onclick=\"return readPosition();\"}>read position</button>';\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase 'orientation':\r\n\t\t\t\t\t\t\t\tcode='<button onclick=\"return readOrientation();\"}>read orientation</button>';\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\tcase 'motion':\r\n\t\t\t\t\t\t\t\tcode='<button onclick=\"return readMotion();\"}>read motion</button>';\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'svg':\r\n\t\t\t\t\t\tcode='<div class=\"svg\" id=\"'+path+'\" tabindex=\"'+(tabindex++)+'\"></div>'\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'app':\r\n\t\t\t\t\t\tcode='<canvas app></canvas>'\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'map':\r\n\t\t\t\t\t\tcode='<div map id=\"'+path+'\" onfocus=\"return onMapFocus(event);\" tabindex=\"'+(tabindex++)+'\"></div>'\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'screen':{\r\n\t\t\t\t\t\tconst id=path;\r\n\t\t\t\t\t\tsplit2.shift();\r\n\t\t\t\t\t\tif(split2.length){\r\n\t\t\t\t\t\t\tconst path=split2[split2.length-1];\r\n\t\t\t\t\t\t\tif(path.startsWith('/')||path.startsWith('https:')){\r\n\t\t\t\t\t\t\t\tsplit2.pop;\r\n\t\t\t\t\t\t\t\tsplit2.push('uri=\"'+path+'\"');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tconst attributes=split2.join(' ');\r\n\t\t\t\t\t\tcode='<div screen '+attributes+' id=\"'+id+'\" onfocus=\"return onScreenFocus(event);\" tabindex=\"'+(tabindex++)+'\"></div>'\t\r\n\t\t\t\t\t\t}break;\r\n\t\t\t\t\tcase 'image':{\r\n\t\t\t\t\t\tconst large=split2[2]||'';\r\n\t\t\t\t\t\tcode='<img '+large+' src=\"'+url+'\">';\r\n\t\t\t\t\t\t}break;\r\n\t\t\t\t\tcase 'audio':{\r\n\t\t\t\t\t\tconst large=split2[2]||'';\r\n\t\t\t\t\t\tif(path.startsWith('https:')||path.startsWith('/')){\r\n\t\t\t\t\t\t\tcode='<audio controls src=\"'+url+'\"></audio>';\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tswitch(url){\r\n\t\t\t\t\t\t\t\tcase \"microphone\":\r\n\t\t\t\t\t\t\t\t\tcode='<audio controls muted mic name=\"'+url+'\"></audio>';\r\n\t\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\t\tcase \"synth\":\r\n\t\t\t\t\t\t\t\t\tcode='<audio controls synth id=\"'+url+'\"></audio>';\r\n\t\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcode='<div player>'+code+'</div>';\r\n\t\t\t\t\t\t}break;\r\n\t\t\t\t\tcase 'video':\r\n\t\t\t\t\t\tif(path.startsWith('https:')){\r\n\t\t\t\t\t\t\tcode='<video controls src=\"'+url+'\"></video>';\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tswitch(url){\r\n\t\t\t\t\t\t\t\tcase \"camera\":\r\n\t\t\t\t\t\t\t\t\tcode='<video camera muted controls name=\"'+url+'\"></video>';\r\n\t\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcode='<div player>'+code+'</div>';\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'pdf':\r\n//\t\t\t\t\t\tcode='<embed src=\"'+url+'\" width=\"600\" height=\"500\" alt=\"pdf\" pluginspage=\"http://www.adobe.com/products/acrobat/readstep2.html\">';\r\n\t\t\t\t\t\tcode='<object pdf data=\"'+url+'\"><a href=\"'+url+'\">Download PDF</a></object>';\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'media':\r\n\t\t\t\t\t\tcode='<media controls src=\"'+url+'\"></media>';\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'sequence':\r\n\t\t\t\t\t\tcode='<media controls src=\"'+url+'\"></media><a href=\"'+url+'\">click</a>';\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase 'youtube2':{\r\n\t\t\t\t\t\tconst t=split2[2]||'0';\r\n\t\t\t\t\t\tcode='<iframe src=\"https://www.youtube.com/embed/'+url+'?start='+t+'\" frameborder=\"0\" allowfullscreen></iframe>';\r\n\t\t\t\t\t\t}break;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tbuffer=buffer.concat(code)\r\n\t\t}\r\n\t\tconst raw=split[1];\r\n\t\tif(raw){\r\n\t\t\tlet content=escapeHTML(raw);\r\n\t\t\tcontent=markList(content,'*',\"<li>\",\"</li>\");\r\n\t\t\tcontent=markTags(content,'**','<strong>','</strong>');\r\n\t\t\tcontent=markTags(content,'__','<strong>','</strong>');\r\n\t\t\tcontent=markTags(content,'*','<em>','</em>');\r\n\t\t\tcontent=markTags(content,'_','<em>','</em>');\r\n\t\t\tif(hash){\r\n\t\t\t\tcontent='<h'+hash+'>'+content+'</h'+hash+'>';\r\n\t\t\t}\r\n\t\t\tbuffer=buffer.concat(content);\r\n\t\t}else{\r\n\t\t\tbuffer=buffer.concat(\"<br>\");\r\n\t\t}\r\n\t}\r\n\treturn buffer;\r\n}\r\n\r\nfunction markdownHeaders(cells,dashes){\r\n\tvar html=\"<tr>\";\r\n\tvar n=cells.length;\r\n\tfor(var i=0;i<n;i++){\r\n\t\tvar cell=cells[i];\r\n\t\tvar dash=dashes[i];\r\n\t\thtml+=\"<th>\"+markdownLine(cell)+\"</th>\\n\";\r\n\t}\r\n\thtml+=\"</tr>\\n\";\r\n\treturn html;\r\n}\r\n\r\nfunction markdownCells(cells){\r\n\tvar html=\"<tr>\";\r\n\tfor(var cell of cells){\r\n\t\thtml+=\"<td>\"+markdownLine(cell)+\"</td>\\n\";\r\n\t}\r\n\thtml+=\"</tr>\\n\";\r\n\treturn html;\r\n}\r\n\r\nfunction markList(line,prefix,pre,post){\r\n\tif(line.startsWith(prefix)){\r\n\t\treturn pre+line.substring(1)+post;\r\n\t}\t\r\n\treturn line;\r\n}\r\n\r\nfunction markTags(raw,sep,pre,post){\r\n\tvar bits=raw.split(sep);\r\n\tif(bits.length>1){\r\n\t\traw=\"\"\r\n\t\tfor(var i=0;i<bits.length-1;i+=2){\r\n\t\t\traw+=bits[i]+pre+bits[i+1]+post;\r\n\t\t}\r\n\t}\r\n\treturn raw;\r\n}\r\n\r\nfunction markUp(md){\r\n\tvar lines=md?md.split(\"\\n\"):[\"\"];\r\n\tvar html=\"\";\r\n\tvar incode=false;\r\n\tvar fenced=false;\r\n\tvar lang=\"\";\r\n\tvar intable=false;\r\n\tvar header=null;\r\n\tvar pre=[];\r\n\tvar latex={};\r\n\tfor(var line of lines){\r\n\t\tvar fence=line.startsWith(\"```\")\r\n\t\tif (fenced){\r\n\t\t\tif(fence){\r\n\t\t\t\tswitch(lang){\r\n\t\t\t\t\tcase \"latex\":\r\n\t\t\t\t\t\tvar tex=pre.join(\" \\\\\\\\\\n\");\r\n\t\t\t\t\t\tvar markup = katex.renderToString(tex, {throwOnError: false, displayMode:true});\r\n\t\t\t\t\t\thtml+=markup;\r\n\t\t\t\t\t\tbreak;\t\r\n\t\t\t\t\tcase \"csv\":\r\n\t\t\t\t\t\thtml+=csvHTML(pre);\r\n\t\t\t\t\t\tbreak\r\n\t\t\t\t\tcase \"html\":\r\n\t\t\t\t\t\thtml+=pre.join(\"\\n\");\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tdefault:\r\n\t\t\t\t\t\tvar raw=escapeHTML(pre.join(\"\\n\"));\r\n\t\t\t\t\t\thtml+=\"<pre>\"+raw+\"</pre>\";\r\n\t\t\t\t}\r\n\t\t\t\tpre=[];\r\n\t\t\t\tfenced=false;\r\n\t\t\t}else{\r\n\t\t\t\tpre.push(line);\r\n\t\t\t}\r\n\t\t\tcontinue;\r\n\t\t}else{\r\n\t\t\tif(fence){\r\n\t\t\t\tlang=line.substring(3);\r\n\t\t\t\tfenced=true;\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t}\r\n\t\tvar dented=line.startsWith('\\t') || line.startsWith(\"    \");\r\n\t\tif(dented){\r\n\t\t\tif(!incode){\t\t\t\t\t\r\n\t\t\t\thtml+=\"<pre>\\n\";\r\n\t\t\t\tincode=true;\r\n\t\t\t}\r\n\t\t\thtml+=line+\"\\n\";\r\n\t\t}else{\r\n\t\t\tif(incode){\r\n\t\t\t\thtml+=\"</pre>\\n\";\r\n\t\t\t\tincode=false;\r\n\t\t\t}\r\n\t\t\tvar cells=line.split('|');\r\n\t\t\tif(cells.length>1){\r\n\t\t\t\tif(!intable){\r\n\t\t\t\t\thtml+=\"<table>\";\r\n\t\t\t\t\tintable=true;\r\n\t\t\t\t\theader=cells;\r\n\t\t\t\t\tcontinue;\t\t\t\t\t\t\r\n\t\t\t\t}\r\n\t\t\t\tif(header){\r\n\t\t\t\t\tvar dashes=cells[0].includes('---');\r\n\t\t\t\t\tif(dashes){\r\n\t\t\t\t\t\thtml+=\"<thead>\";\r\n\t\t\t\t\t\thtml+=markdownHeaders(header,dashes);\r\n\t\t\t\t\t\thtml+=\"</thead><tbody>\";\r\n\t\t\t\t\t\theader=null;\r\n\t\t\t\t\t\tcontinue;\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\thtml+=\"<tbody>\";\r\n\t\t\t\t\t\thtml+=markdownCells(header);\r\n\t\t\t\t\t}\r\n\t\t\t\t\theader=null;\r\n\t\t\t\t}\r\n\t\t\t\thtml+=markdownCells(cells);\r\n\t\t\t}else{\r\n\t\t\t\tif(header){\r\n\t\t\t\t\thtml+=markdownCells(header);\r\n\t\t\t\t\theader=null;\r\n\t\t\t\t}\r\n\t\t\t\tif(intable){\r\n\t\t\t\t\thtml+=\"</tbody></table>\"\r\n\t\t\t\t\tintable=false;\r\n\t\t\t\t}\r\n\t\t\t\thtml+=markdownLine(line);\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn html;\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitrostorage.js\",\"length\":460,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrostorage.js\r\n// (C)2025 nitrologic\r\n// All rights reserved\r\n\r\n\"use strict\"\r\n\r\n// files section in storage to manage user uploads\r\n\r\nvar filesDiv;\r\nvar fileTools;\r\nvar fileHome;\r\n\r\nfunction homeFiles(){\r\n\r\n}\r\n\r\nfunction initStorage(){\r\n\tfilesDiv=document.getElementById(\"storage\");\r\n\tif(!filesDiv) return false;\r\n\taddTitle(filesDiv,\"Store\");\r\n\r\n\taddForm(filesDiv);\r\n\r\n\tfileTools=addToolbar(filesDiv);\r\n\tfileHome=addButton(fileTools,\"/\",homeFiles);\r\n\r\n}\r\n","name":"content"},{"role":"user","content":"Files shared. Feel free to comment if content is new or different.","name":"friend"},{"role":"assistant","content":"A substantial codebase — thanks for sharing. A few observations, grouped by what stands out and what looks risky.\n\n## Architecture notes\n\nThe tile system (`TopoGrid` / `TopoTile` / `TopoSource`) is cleanly layered: source→tile→baker worker→bumpmap→surface. The `Bumpmap` topo/diff/ground triple with `pickElevation`/`pickHeight`/`pickGround` separation is a nice way to keep elevation and detail separate — it lets the surface crack logic (`CreateTopoSurface`) keep detail verts only where `ground==0 && maxz-minz>12`.\n\n`Bits` is a tidy little polygon rasterizer using 4×4 packed cells; the `digTopo` / `cropTopo` variants read well.\n\nThe `Shape` instancing layout (16 shorts per instance: 4 floats xyzw + 9 rotated matrix as shorts + 3 dim) packed into a single `Int16Array` is efficient, but I'd worry about the `flat` attribute stride computation in `bindAttributes` — it walks `attributes` twice and relies on `flat`-prefixed names appearing after non-flat ones in the same object. If insertion order ever changes that will silently corrupt the VAO.\n\nThe `Arpeggiator` progression table with mythology names is charming and the state-machine in `Beat()` is compact.\n\n## Things that look like real bugs\n\n- `Pixelmap` constructor never writes to `this.rgb` — the loop reads `bytes` and advances `p`, but `rgb` is populated nowhere. The class is effectively a no-op.\n- `wire_topo.js` `TopoTile.cropOutline` calls `outlinePoints(outline)` but the method defined is `outlinePoints()` with no parameters and it returns `Bits` — signature mismatch.\n- `TopoTile.drawOutline` references `this.resolution` and `this.pickHeight(...)`, neither of which exist on `TopoTile` (they live on `heightmap`).\n- `wire_topo.js` `fetchDrawing2` uses undefined `data` and `this.grid`.\n- `wire_util.js` `EventServer.addEvent` assigns to an undeclared `event` (implicit global). Same pattern in `worker_post.js`.\n- `worker-vsynth.js` `Keys.ToJson` is missing a comma between `this.lowhigh[1]` and `this.lowhigh[2]` — concatenation, not array.\n- `wire_grid.js` `Panel.constructor` calls `this.addKey(...)` before `addKey` is defined on the class? Actually it's fine because methods are on the prototype at construction time; but `this.addKey` internally calls `this._clickKey` via `bind`, which is also fine. No bug here, just worth noting it's only safe because of prototype timing.\n- `wire_display.js` `CombineSurfaces` is empty — every `Frame()`/`Hull()`/`MiniWheel()` path returns `undefined`.\n- `Shape.addFlatSurface` calls `this.instanceBuffer(shorts, this.instances, false)` with three args, but `instanceBuffer(shorts, instanceCount)` takes two. The third is silently dropped.\n- `wire_grid.js` `TopoEditor.onTiles` uses `console.log(\"TopoEditor.onTiles\")` but `TopoSource` constructor calls `this.fetchMasks()` — and then `TopoDisplay.onTopoTileSource` also seems to expect a different shape. The two tile pipelines (`TopoDisplay` in wire_display vs `TopoEditor` in wire_grid) look like they've diverged.\n- `wire_geometry.js` `SuperSurface.extrudeEdge` does `t=Normalize(t)` on a local `const t` — reassignment of a const, which would throw in strict mode. Same file, `drill()` references `addEdge`/`addWall` that don't exist.\n- `worker-vsynth.js` `Reverb.EffectAudio` has `this.future = this.future.slice(0, maxOffset)` which *truncates* when `future.length < maxOffset` — that condition should be growing, not slicing. Probably should be `if (this.future.length < maxOffset) { extend }`.\n- `worker-vsynth.js` `Stream.Feed` compares `count > this.count + 1` and stashes into `reorder`, but the loop only ever consumes `count+1` once — there's no drain for the stashed entries beyond a single step. If you get two out-of-order packets it will wedge.\n\n## Style / consistency\n\nThe \"simon come here\" markers are a good habit, but several mark real correctness gaps (worker fallback, `_MeshLoader` null deref, retirement sanity). Might be worth a `// TODO(simon):` convention so they show up in tooling.\n\nIndentation is inconsistent across files: most wire_*.js use tabs, but `wire_topo.js`'s `TopoTile` mixes tabs and 8-space continuation lines inside `drawFilled`/`drawOutline`. Not fatal but noisy in diffs.\n\n## Smaller things\n\n- `wire_system.js` `failVR()` takes no parameter but logs `vr.length`.\n- `wire_field.js` `testPost()` references `verts`, `indices`, and `postMessage` as if in a worker context, but the file *is* a worker — the function is dead code referencing outer-scope names that don't exist.\n- `Bumpmap.lakeLine` declares `const g=this.ground` unused.\n- `wire_topo.js` `Bumpmap.processOutline` calls `contract()` then three `expand()`s — comment says outline, but the effect is a dilate; name is misleading.\n- `wire_display.js` `TopoDisplay.onTopoTileSource` reads `this.tilesource` and `this.loadingTile` but nothing appears to set `this.loadingTile` in the display class itself (it's set in `fetchTile`, which is only called from `onTopoTileSource` when `!tile` — potential infinite no-op).\n- `nitromarkup.js` `markUp` never closes `<pre>` if input ends while `incode` is true.\n- `nitromarkup.js` `markTags` loop `for(var i=0;i<bits.length-1;i+=2)` drops the trailing segment after the last pair.\n\n## What looks genuinely new/interesting\n\n- The NZTM↔WGS grid interpolation using precomputed `meters`/`degrees` rows is a nice trick for cheap runtime coordinate conversion.\n- `Bits` + `digTopo` for basement excavation during roof tracing is a neat way to punch holes in terrain that follow building outlines.\n- The worker-vsynth architecture — worklet holding `VSynth`, main thread holding a thin `VSynthNode` — is clean separation, and the `pcm64` hex-string→Float64 path is unusual but workable.\n- The `Surface.div()` subdivision with a `divs` map keyed by vertex-pair hex is a nice way to avoid duplicate midpoints during icosphere refinement.\n\nIf you want, I can go through one file at a time with specific patches — `worker-vsynth.js` and `wire_topo.js` look like the highest-value places to start."},{"role":"user","content":"how can i enable the digtopo code","name":"friend"},{"role":"assistant","content":"The `digTopo` path exists but is disabled at two points, and there's an ordering problem you'll hit once you turn it on. Here's the full chain.\n\n## 1. The feature switches\n\nIn `wire_graphics.js`, `Builder.buildTile` starts with a block of `const` flags. `digOutline` is called from inside the `build_roof2` block:\n\n```js\nconst build_roof=false;\nconst build_roof2=false;         // <-- gate on the whole roof block\nconst build_roof_basement=true;  // <-- gate on digOutline inside it\n```\n\nFlip `build_roof2` to `true`. `build_roof_basement` is already `true`, so that's the only flag you need. `build_roof` and `build_roof_geom`/`build_walls_geom` control separate features (scratch drawing, wall geometry) — leave them off initially.\n\n## 2. The ordering problem\n\n`meshTile` in `wire_graphics.js` does this, in order:\n\n```js\ntile.createScratch(AppPlatform.ScratchRes);\nconst surfaces = this.builder.buildTile(tile, 2);   // digOutline runs here\n...\nconst topo = tile.topoSurface;                       // already built!\ntile.tilemesh = layer0.addTileShape(topo, ...);\n```\n\nBut `tile.topoSurface` was created earlier — either in `TopoTile.onBump` (worker path) or in `GraphicsStack.bakeTileSurface` (no-baker path) — *before* `digOutline` mutated `heightmap.ground`/`heightmap.diff`. So the dig will silently do nothing visible.\n\nYou need to rebuild the surface after `buildTile` returns. Add this to `meshTile`:\n\n```js\nmeshTile(tile, home){\n\tthis._activeTiles.push(tile);\n\tconst tx = (tile.x)*TileSize - home[0];\n\tconst ty = (tile.y)*TileSize - home[1];\n\tconst origin = [tx, ty, 0x4000];\n\tconst layer0 = this.view0.layer;\n\n\ttile.createScratch(AppPlatform.ScratchRes);\n\n\tconst surfaces = this.builder.buildTile(tile, 2);\n\n\t// digTopo may have mutated heightmap.ground/diff; rebuild the surface\n\tif(tile.heightmap){\n\t\tconst topo = CreateTopoSurface(128, 16, GroundPen, tile.heightmap);\n\t\tconst zfactor = 4.6/(tile.level*8.0);\n\t\ttopo.calcNormals(zfactor);\n\t\ttile.topoSurface = topo;\n\t}\n\n\ttile.allocWallmap();\n\ttile.staticmeesh = layer0.addStaticShapes(surfaces, tile.scratch, tile.wallmap, origin);\n\n\tconst topo = tile.topoSurface;\n\ttile.tilemesh = layer0.addTileShape(topo, tile.basemap, tile.scratch, origin);\n}\n```\n\n`GroundPen` is declared in `wire_topo.js`, and the `zfactor` expression matches what `TopoTile.onBump` uses — keep them consistent or the shading will differ between dug and undug tiles.\n\n## 3. Prerequisites\n\n- `AppRuntime.UseLINZ` must be `true` (it is by default in `wire_grid.js`).\n- The tile source must actually have a `roa` layer with `ROOF` outlines. That means the source entry needs `\"roaname\" in layer` and `level < 3` in `fetchTopoTile`. The `ROOF` array in `onDrawingResponse` will otherwise be empty and the whole `build_roof2` block is skipped by `roofs.length`.\n- `BasementDepth` in `wire_grid.js` is currently `4`. That's tiny — the dig will be nearly invisible. Bump it to something like `200` to test.\n\n## 4. Debugging the bits\n\n`Bits.digTopo` depends on `Bits.poly` producing a consistent even-odd scanline, and `poly` has two rough edges that will bite on complex roofs:\n\n- it only clamps `x`, not `y` (negative `y` silently drops writes on the typed array);\n- it steps one pixel per Bresenham increment, so a thin diagonal can leave single-pixel gaps, and `digTopo`'s `on = !on` toggling then inverts the wrong region.\n\nBefore wiring it up, call `bits.dump()` on a known roof outline to see the filled region as `X`/`.` ASCII. If the fill looks correct in the dump, `digTopo` will behave. If it looks like a stipple pattern instead of a solid interior, the `poly` fill is the thing to fix, not `digTopo`.\n\n## 5. What `digTopo` actually writes\n\nFor reference, so you can verify the effect is reaching the surface:\n\n```js\nheightmap.setGround(tx+bx, ty+by, depth);  // pickGround returns this when nonzero\nheightmap.setHeight(tx+bx, ty+by, 0);      // clears diff (detail height)\n```\n\n`CreateTopoSurface` reads `pickTopo(...).ground` and uses `const z = ground || minz;` — so a nonzero `ground` overrides the terrain elevation and the vertex drops to the basement depth. The `border` argument (40 in the call site) is a halo in *heightmap pixels*, not world units — worth tuning once you can see it working.\n\nStart with `BasementDepth = 200`, `build_roof2 = true`, and the `meshTile` rebuild in place. If nothing appears, dump `bits` first."},{"role":"user","content":"if i want default height map to include lidar height is there already a setting","name":"friend"},{"role":"assistant","content":"Short answer: no, there's no runtime setting that switches on LiDAR. The topo grid choice is data-driven from `json/tiles.json`, and the code will fetch whatever `toponame` each layer entry names.\n\n## Where the choice actually lives\n\n`TopoTile.fetchTopoTile` in `wire_topo.js` builds the URL from the layer's `toponame`:\n\n```js\nif(\"toponame\" in layer){\n\tconst src=\"topogrid/topo-\"+layer.toponame+\"/\"+level+\"/\"+x+\"/\"+y+\".raw\";\n\t...\n\tthis.fetchTileRaw(src2);\n\tnotopo=false;\n}\n```\n\nSo whether you get LiDAR-derived tiles, contour-derived DEM, or something else is decided entirely by what `tiles.json` says. There's no mip variant for topo either — unlike aerial, which picks `TopoMipName[res]` / `AppPlatform.MipName` (`\"\"` vs `\"sd-\"`). The `.raw` path is fixed.\n\nThe only two flags in `AppRuntime` (`wire_grid.js`) are:\n\n```js\nlet AppRuntime={\n\tUseAerial:true,\n\tUseLINZ:true\n};\n```\n\n`UseAerial` gates the JPEG overlay, `UseLINZ` gates the `roagrid` drawing JSON (roads, roofs, coast, etc.). Neither touches the topo `.raw`.\n\n## The combining mechanism already exists\n\n`TopoSource.listSources` returns every layer in `this.visible` that matches `level` and bounds. If `tiles.json` lists two topo layers for the same tile, both `.raw` files are fetched and handed to the worker, which merges them via `orBytes`:\n\n```js\nfunction createTopo(){\n\tconst bytes=heightmaps[0]||[];\n\tconst heightmap=AllocBumpmap(bytes);\n\theightmap.setBytes(bytes);\n\tconst n=heightmaps.length;\n\tfor(let i=1;i<n;i++){\n\t\tif(heightmaps[i].length==bytes.length){\n\t\t\theightmap.orBytes(heightmaps[i]);\n\t\t}\n\t\t...\n\t}\n}\n```\n\nTwo important caveats about that path:\n\n- `orBytes` is **overwrite where nonzero**, not max or blend. It only writes where the incoming source has `h != 0`. So order in `sourceList` decides who wins — and that order is just the order of `tiles.aerial.concat(tiles.topo, tiles.roa)` in the `TopoSource` constructor. If you add a LiDAR layer alongside a base DEM, whichever is later in that concatenation overwrites the other on overlapping pixels.\n- It requires the two heightmaps to have the *same byte length* (`heightmaps[i].length == bytes.length`). Different resolutions won't merge — the else branch is commented out.\n\nSo \"include LiDAR\" via the existing path means: put a LiDAR-derived topo entry in `tiles.json` at the right `layer` and with the right `bounds`, either replacing the existing topo entry or adding it after it.\n\n## If you want an explicit switch\n\nAdding one is straightforward and mirrors `UseAerial`. In `wire_grid.js`:\n\n```js\nlet AppRuntime={\n\tUseAerial:true,\n\tUseLINZ:true,\n\tUseLiDAR:false\n};\n```\n\nThen in `fetchTopoTile`, gate the LiDAR-named layer:\n\n```js\nif(\"toponame\" in layer){\n\tconst useLidar = layer.toponame.startsWith(\"lidar\");\n\tif(!useLidar || AppRuntime.UseLiDAR){\n\t\tconst src=\"topogrid/topo-\"+layer.toponame+\"/\"+level+\"/\"+x+\"/\"+y+\".raw\";\n\t\t...\n\t\tthis.fetchTileRaw(src2);\n\t}\n}\n```\n\nThat assumes your `tiles.json` naming convention identifies LiDAR entries — check what the `toponame` values actually are before committing to a predicate. If they're opaque (`\"ak17\"`, `\"nz1\"`), you'll need a per-entry boolean like `layer.lidar: true` instead.\n\n## One thing that will bite you\n\n`heal()` is commented out in `worker_baker.js`:\n\n```js\n// simon come here and fix up flora\n//\theightmap.heal(n);\n```\n\nLiDAR coverage is patchy — swaths, water masks, no-data areas all come back as `h == 0`. The worker's `setBytes` converts those to `topo[i] = -TopoLevel`, which is a full 16384 units below the topo origin. On screen that's a deep pit, not a flat gap. If you enable LiDAR and see scattered depressions, that's this. `heal()` was meant to fill them (the body is a stub — it counts zeros but doesn't actually repair), so you'd be implementing it, not just uncommenting it.\n\nThe main-thread `Bumpmap.setBytes` in `wire_topo.js` doesn't have the `else` branch, so the no-baker path leaves zeros as `h = 0` (interpreting as sea-level topo offset). Different symptom, same root cause.\n\n## What to check first\n\nOpen `json/tiles.json` and look at the `topo` array entries — specifically the `toponame` fields and the `layer` numbers. That will tell you whether LiDAR is already in the default set, whether it's a separate entry you can toggle, or whether you need to add one. Without that file I can't tell you which."},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_topo.js\",\"length\":34270,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_topo.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n//  TopoTile Pixelmap Bumpmap PixelLoader HtmlImage Point\r\n\r\n\"use strict\"\r\n\r\nconst GroundPen=1;\r\n\r\nlet ScratchCount=0;\r\nlet WallCount=0;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\n\r\nconst WallSize=1024;// simon come here 2048;\r\nconst TileSize=2048;\r\n\r\nconst OutlineColor=\"#04c\";\r\nconst FillStyle=\"#00f\";\r\n\r\nconst GridStyle=\"#048\";\r\nconst _GridAlpha=0.4;\r\nconst _GridThick=0.2;\r\n\r\nconst CursorStyle=\"#ff8\";\r\n\r\nconst TopoMipName=[\"sd-\",\"\",\"hd-\"]\r\n\r\nconst mapStyle={\r\n\tLAND:{thick:2,fill:\"#030\"},\r\n\tCOAST:{thick:10},\r\n\tCONTOUR:{thick:0.4},\r\n\tROAD:{thick:0.2,style:\"#888\"},\r\n\tRAIL:{thick:1.8,style:\"#882\"},\r\n\tBRIDGE:{thick:3},\r\n\tTRAILS:{thick:0},\r\n\tTARMAC:{thick:3},\r\n\tROOF:{thick:3.6,style:\"#000\",fill:\"#333\"},\r\n\tPARCEL:{thick:0.3},\r\n\tTRANSIT:{thick:2.6,style:\"#26a\"}, //,fill:\"#444\"}\r\n\tROAD1:{thick:0.2,style:\"#800\"},\r\n\tPOI:{thick:3,style:\"#cf2\"}\r\n}\r\n\r\nfunction Log2(n){\r\n\tif(n<0){\r\n\t\tdebugger;\r\n\t}\r\n\tlet result=0;\r\n\twhile(n){\r\n\t\tn>>=1;\r\n\t\tresult++;\r\n\t}\r\n\treturn result;\r\n}\r\n\r\nclass Pixelmap{\r\n\tconstructor(imagedata){\r\n\t\tconst bytes=imagedata.data;\r\n\t\tconst rgb=new Array(TileSize*TileSize);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<TileSize;y++){\r\n\t\t\tfor(let x=0;x<TileSize;x++){\r\n\t\t\t\tconst _rgb1=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.rgb=rgb;\r\n\t}\r\n}\r\n\r\nlet BumpCache={1:[],129:[],513:[],1025:[],2049:[]};\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n//\tconst cache=BumpCache[res];\r\n//\tconst map=cache.length?cache.pop():new Bumpmap(res);\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\n\r\nfunction RecycleBumpmap(bumpmap){\r\n\tbumpmap.clear();\r\n\tconst res=bumpmap.resolution;\r\n\tBumpCache[res].push(bumpmap);\r\n}\r\n\r\nclass Bumpmap{\r\n\treset(res){\r\n\t\tthis.resolution=res;\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.resolution=Math.sqrt(res);\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\t// todo: test me\r\n\t\t\ttopo[0]=-0x4000+SeaLevel;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tlakeLine(waterLevel){\r\n\t\tconst lakeLevel=waterLevel-1000;\r\n\t\tconst t=this.topo;\r\n\t\tconst g=this.ground;\r\n\t\tlet n=0;\r\n\t\tconst count=this.resolution*this.resolution;\r\n\t\tfor(let i=0;i<count;i++){\r\n\t\t\tif (t[i]<=waterLevel){\r\n\t\t\t\tn++;\r\n\t\t\t\tt[i]=lakeLevel;\r\n\t\t\t}\r\n\t\t}\r\n//\t\tconsole.log(\"lakeline\",n)\r\n\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let i=0;i<res*res;i++){\r\n\t\t\tlet h=topo[i];\r\n\t\t\tif(h==0){\r\n\t\t\t\ttopo[i]=1000-TopoLevel;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tprocessOutline(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0){\r\n\t\t\th=this.topo[i];\r\n\t\t}\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\nclass PixelLoader{\r\n\tconstructor(){\r\n\t\tthis.canvas=document.createElement('canvas');\r\n\t\tthis.canvas.width=TileSize;\r\n\t\tthis.canvas.height=TileSize;\r\n\t\tthis.context=this.canvas.getContext('2d');\r\n\t}\r\n\timageRGBPixels(image){\r\n\t\tthis.context.clearRect(0,0,TileSize,TileSize);\r\n\t\tthis.context.drawImage(image,0,0);\r\n\t\tconst imagedata=this.context.getImageData(0,0,TileSize,TileSize);\r\n\t\treturn new Pixelmap(imagedata);\r\n\t}\r\n}\r\n\r\nclass HtmlImage{\r\n\r\n\t// leyer is a source entry from tilemaps.json\r\n\r\n\tconstructor(tile,layer,partial){\r\n\t\tthis.tile=tile;\r\n\t\tthis.layer=layer;\r\n\t\tthis.partial=partial;\r\n\t\tconst image=new Image();\r\n\t\timage.crossOrigin=\"anonymous\";\r\n\t\timage.onload=this.imageLoad.bind(this);\r\n\t\timage.onerror=this.imageError.bind(this);\r\n\t\tthis.image=image;\r\n\t}\r\n\r\n\timageLoad(){\r\n\t\tthis.loaded=true;\r\n\t\tthis.tile.dirty=true;\r\n\t\tthis.tile.addImage(this);\r\n//\t\tif(this.layer==0){\r\n//\t\t\tthis.colormap=PixelLoader.imageRGBPixels(this.image);\r\n//\t\t\tthis.tile.setBasemap(this.image);\r\n//\t\t}\r\n\t}\r\n\r\n\timageError(errorevent){\r\n\t\tconsole.log(\"imageError:\",this.image.src,errorevent.message);\r\n\t}\r\n\r\n\tload(src){\r\n\t\tthis.image.src=src;\r\n\t}\r\n}\r\n\r\n// simon come here and allocate baker workers to bake\r\n\r\n\r\nclass Instance{\r\n\r\n}\r\n\r\nclass Bake{\r\n\r\n\tinit(workerCount){\r\n\t\tconsole.log(\"[BAKE] init\",workerCount)\r\n\t\tconst bakers=[];\r\n\t\tfor(let i=0;i<workerCount;i++){\r\n\t\t\tconst baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\t\tbakers.push(baker);\r\n\t\t}\r\n\t\tthis.bakers=bakers;\r\n\t}\r\n\r\n\tlisten(instance){\r\n\r\n\t}\r\n}\r\n\r\n// todo; TileInstance v TopoProcess\r\n\r\nclass TileInstance{\r\n\tconstructor(tile){\r\n\t\tthis.heightmaps=[];\r\n\t\tthis.tile=tile;\r\n//\t\tconsole.log(\"[WIRE] instance\",tile);\r\n\t\tthis.baker=new Worker(\"nitrojs/worker_baker.js\");\r\n\t\tthis.baker.onmessage=this.onMessage.bind(this);\r\n\t}\r\n\r\n\t// e.data is script - an array of line objects that include a command field\r\n\r\n\tpost(message,transfer){\r\n\t\tthis.baker.postMessage(message,transfer);\r\n\t}\r\n\r\n\tterminate(){\r\n\t\tthis.baker.terminate();\r\n\t\t// simon come here and recylcled typed arrays\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\r\n\tonMessage(e){\r\n\t\tconst script=e.data;\r\n\t\tfor(const line of script){\r\n\t\t\tswitch (line.command){\r\n\t\t\t\tcase \"flora\":\r\n\t\t\t\t\tthis.tile.onFlora(line.verts,line.indices);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase \"bump\":\r\n\t\t\t\t\tthis.tile.onBump(line.topo,line.diff,line.ground);\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tbakeTopo(count){\r\n\t\tconst message=[{command:\"bake\",value:count}];\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\trawLoad(raw){\r\n\t\tthis.heightmaps.push(raw);\r\n\t\tconst message=[{command:\"heightmap\",array:raw}];\r\n\t\tconst transfer=[raw.buffer];\r\n//\t\tthis.baker.postMessage(message,transfer);\r\n\t\tthis.post(message);\r\n\t}\r\n\r\n\t// support merge or multiple heightmaps here\r\n\r\n\tcreateTopo(){\r\n\t\tconst bytes=this.heightmaps[0]||[];\r\n\t\tthis.heightmap=AllocBumpmap(bytes);\r\n\t\tthis.heightmap.setBytes(bytes);\r\n\t\tfor(let i=1;i<this.heightmaps.length;i++){\r\n\t\t\tthis.heightmap.orBytes(this.heightmaps[i]);\r\n\t\t}\r\n\t\tthis.heightmap.heal();\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\tbakeTile2(tile){\r\n\t\ttile.createTopo();\r\n\t\tconst topo=CreateTopoSurface(128,16,0,tile.heightmap);\r\n\t\ttopo.calcNormals();\r\n\t\ttile.topoSurface=topo;\r\n\t}\r\n}\r\n\r\nlet _PostCount=0;\r\nlet _PostLoads=0;\r\n\r\n// pickHeight pickElevation maxHeight retire fetch request loadTileImage redrawTile\r\n// drawOutline drawFilled drawBox drawDiagram \r\n// layer was source level is now resolution\r\n\r\nclass TopoTile{\r\n\r\n\tconstructor(grid,level,x,y){\r\n\r\n\t\tthis.hasBaker=true;\t\t// false debug mode - release make true;\r\n\t\tthis.flushed=false;\r\n\t\tthis.baker=null;\r\n\r\n\t\t// 2026 - heightmaps is back for no baker mode\r\n\t\tthis.heightmaps=[];\r\n\r\n//\t\tthis.sourceLayers=[];\t// have extensions\r\n\t\tthis.topogrid=grid;\r\n\t\tthis.level=level;\r\n\t\tthis.x=x;\r\n\t\tthis.y=y;\r\n\t\tthis.name=\".\"+level+\",\"+x+\",\"+y;\r\n\r\n\t\tthis.imageCount=0;\r\n\t\tthis.topoCount=0;\r\n\t\tthis.drawingCount=0;\r\n\t\tthis.posts=[];\r\n\t\tthis.drawings=[];\r\n\t\tthis.imageStack=[];\r\n\r\n\t\tthis.dirty=false;\r\n\t\tthis.fetched=false;\r\n\t\tthis.ready=false;\r\n\t\tthis.fresh=0;\r\n\t\tthis.retired=false;\r\n\r\n\t\tthis.heightmap=null;\r\n\t\tthis.basemap=null;\r\n\t\tthis.scratch=null;\r\n\t\tthis.wallmap=null;\r\n\t\tthis.tilemesh=null;\r\n\t\tthis.staticmeesh=[];\r\n\t\tthis.flatmeesh=[];\r\n\t//\troofs=[]\r\n\t\tthis.wallx=0;\r\n\t\tthis.wally=0;\r\n\t\tthis.wallhi=0;\r\n\t}\r\n\r\n\tflushMesh(){\r\n\t\tif(this.flushed){\r\n\t\t\t// simon come here and fix sanity test\r\n//\t\t\tdebugger;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tthis.flushed=true;\r\n\t\tif(this.hasBaker){\r\n\t\t\tif(this.instance){\r\n\t\t\t\tthis.instance.terminate();\r\n\t\t\t}\r\n\t\t\tthis.instance=null;\r\n\t\t}\r\n\t\tif(this.tilemesh){\r\n\t\t\tthis.tilemesh.flushBuffers();\r\n\t\t\tthis.tilemesh.flushTextures();\r\n\t\t\tthis.tilemesh=null;\r\n\t\t}\r\n\t\tif(this.floramesh){\r\n\t\t\tthis.floramesh.flushBuffers();\r\n\t\t\tthis.floramesh.flushTextures();\r\n\t\t\tthis.floramesh=null;\r\n\t\t}\r\n\t\tfor(const mesh of this.staticmeesh){\r\n\t\t\tmesh.flushBuffers();\r\n\t\t\tmesh.flushTextures();\r\n\t\t}\r\n\t\tthis.staticmeesh=[];\r\n\t\tfor(const mesh of this.flatmeesh){\r\n\t\t\tmesh.flushBuffers();\r\n\t\t}\r\n\t\tthis.flatmeesh=[];\r\n\t}\r\n\r\n\tcropOutline(outline,height){\r\n\t\tconst bits=outlinePoints(outline);\r\n\t\tbits.cropTopo(topo,height);\r\n\t}\r\n\r\n\toutlinePoints(){\r\n\t\tlet xmin=1e9;\r\n\t\tlet xmax=-1e9;\r\n\t\tlet ymin=1e9;\r\n\t\tlet ymax=-1e9;\r\n\t\tlet zmin=1e9;\r\n\t\tlet zmax=-1e9;\r\n\t\tconst pts=[];\r\n\t\tconst n=outline.length;\r\n\t\tfor(let w=0;w<n;w++){\r\n\t\t\tconst o=outline[w];\r\n\t\t\tconst x=(o[0]/2)|0;\r\n\t\t\tconst y=(o[1]/2)|0;\t\t\r\n\t\t\tymin=Math.min(ymin,y);\r\n\t\t\tymax=Math.max(ymax,y);\r\n\t\t\txmin=Math.min(xmin,x);\r\n\t\t\txmax=Math.max(xmax,x);\r\n\t\t\tpts.push([x,y]);\t\r\n\t\t}\r\n\t\tconst width=(xmax-xmin)|0;\r\n\t\tconst height=(ymax-ymin)|0;\r\n\t\tconst bits=new Bits(width,height,xmin,ymin);\r\n\t\tbits.poly(pts);\r\n\t\treturn bits;\r\n\t}\r\n\r\n\tfloodLake(x,y){\r\n\t\tconst topo=this.heightmap;\r\n\t\tconst pick=topo.pickTopo(x|0,y|0)\t\t\r\n\t\tconst h0=pick.min;\r\n\t\ttopo.lakeLine(h0);\r\n//\t\tconst h1=topo.pickHeight(x,y);\r\n\t}\r\n\r\n\tdigOutline(outline,deep,border){\r\n\t\tconst topo=this.heightmap;\r\n\t\tlet xmin=1e9;\r\n\t\tlet xmax=-1e9;\r\n\t\tlet ymin=1e9;\r\n\t\tlet ymax=-1e9;\r\n\t\tlet zmin=1e9;\r\n\t\tlet zmax=-1e9;\r\n\t\tconst pts=[];\r\n\t\tconst n=outline.length;\r\n\t\tfor(let w=0;w<n;w++){\r\n\t\t\tconst o=outline[w];\r\n\t\t\tconst x=(o[0]/2)|0;\r\n\t\t\tconst y=(o[1]/2)|0;\r\n\t\t\t// todo: change to lowest\r\n//\t\t\tconst h0=topo.pickElevation(x,y);\r\n\t\t\t\r\n\t\t\tconst h0=topo.pickTopo(x,y).min;\r\n\t\t\tconst h1=topo.pickHeight(x,y);\r\n\r\n\t\t\tzmin=Math.min(zmin,h0);\r\n\t\t\tzmax=Math.max(zmax,h0+h1);\r\n\t\t\tymin=Math.min(ymin,y);\r\n\t\t\tymax=Math.max(ymax,y);\r\n\t\t\txmin=Math.min(xmin,x);\r\n\t\t\txmax=Math.max(xmax,x);\r\n\t\t\tpts.push([x,y]);\t\r\n\t\t}\r\n\t\tconst width=(xmax-xmin)|0;\r\n\t\tconst height=(ymax-ymin)|0;\r\n\t\tconst depth=(zmin-deep)|0;\r\n\t\tconst bits=new Bits(width,height,xmin,ymin);\r\n\t\tbits.poly(pts);\r\n\t\tbits.digTopo(topo,depth,border);\r\n\t}\r\n\r\n\tallocWallPixels(w,h){\r\n\t\tw|=0;\r\n\t\th|=0;\r\n\t\tif(this.wallx+w>WallSize){\r\n\t\t\tthis.wallx=0;\r\n\t\t\tthis.wally+=this.wallhi;\r\n\t\t\tthis.wallhi=0;\r\n\t\t}\r\n\t\tconst x=this.wallx;\r\n\t\tthis.wallx+=w;\r\n\t\tconst y=this.wally;\r\n\t\treturn({x,y,w,h});\r\n\t}\r\n\r\n\tallocWallmap(){\r\n\t\tconst w=WallSize;\r\n\t\tconst h=WallSize;//this.wally+this.wallhi;\r\n\t\tconst src=\"wall\"+(++WallCount);//this.basemap.src;\r\n\t\tconst can=document.createElement('canvas');\r\n\t\tcan.width=w;\r\n\t\tcan.height=h;\r\n\t\tcan.src=src;\r\n\t\tcan.id=src;\r\n\t\tconst context=can.getContext(\"2d\",{antialias:false});\r\n\t\tcontext.fillStyle=\"green\";\r\n\t\tcontext.fillRect(0,0,w,h);\r\n\t\tcontext.fillStyle=\"white\";\r\n\t\tfor(let i=0;i<WallSize;i+=16){\r\n\t\t\tcontext.fillRect(0,i,w,1);\r\n\t\t\tcontext.fillRect(i,0,1,h);\r\n\t\t}\r\n\t\tthis.setWallmap(can);\r\n\t}\r\n\r\n\tonFlora(verts,indices){\r\n\t\tthis.floraSurface=new Surface(verts,indices,[]);\r\n\t}\r\n\r\n\tonBump(topo,diff,ground){\r\n\t\tconst bump=new Bumpmap(); \r\n\t\tbump.create(topo,diff,ground);\r\n\t\tthis.setHeightmap(bump);\r\n\t\tconst surface=CreateTopoSurface(128,16,GroundPen,bump);\r\n// simon come here and clean up magic numbers\r\n\t\tconst zfactor=4.6/(this.level*8.0);\r\n\t\tsurface.calcNormals(zfactor);\r\n//\t\tsurface.fuzzNormals();\r\n\t\tthis.topoSurface=surface;\r\n\t}\r\n\r\n\thasLoaded(){\r\n\t\tlet topoReady=false;\r\n\t\tif(this.hasBaker){\r\n\t\t\ttopoReady=this.heightmap && this.floraSurface;\r\n\t\t}else{\r\n\t\t\ttopoReady=this.heightmap && (this.topoCount==this.heightmaps.length);\r\n\t\t}\r\n\r\n\t\treturn this.ready\r\n\t\t\t&& topoReady\r\n//\t\t\t&& this.heightmap\r\n//\t\t\t&& this.topoCount==this.heightmaps.length\r\n\t\t\t&& this.imageCount==this.imageStack.length \r\n\t\t\t&& this.drawingCount==this.drawings.length;\r\n\t}\r\n\r\n\tsetHeightmap(bump){\r\n\t\tthis.heightmap=bump;\r\n\t\tthis.topogrid.addTerrain(this);\r\n\t}\r\n\r\n\tsetWallmap(wallmap){\r\n\t\tthis.wallmap=wallmap;\r\n\t}\r\n\r\n\taddImage(image){\r\n\t\tconst layer=image.layer;\r\n\t\tconst basemap=layer.attributes && layer.attributes[\"basemap\"];\r\n\t\tif(basemap){\r\n\t\t\tthis.setBasemap(image.image);\r\n\t\t}\r\n\t\tthis.imageCount++;\r\n\t}\r\n\r\n\tsetBasemap(basemap){\r\n\t\tthis.basemap=basemap;\r\n\t}\r\n\r\n\t// simon come here and don't crash if flushed\r\n\r\n\tonRawLoad(url,buffer){\t\t\r\n\t\tconst bytes=new Uint8Array(buffer);\r\n\t\tif(this.hasBaker && this.instance){\r\n\t\t\tthis.instance.rawLoad(bytes);\r\n\t\t}else{\r\n\t\t\t// simon come here - debug should not need web workers\r\n\t\t\tconsole.log(\"[TOPO] web workers needed\");\r\n\t\t}\t\t\t\r\n\t}\r\n\r\n\tcreateTopo(){\r\n\t\tconst bytes=this.heightmaps[0]||[];\r\n\t\tthis.heightmap=AllocBumpmap(bytes);\r\n\t\tthis.heightmap.setBytes(bytes);\r\n\t\tfor(let i=1;i<this.heightmaps.length;i++){\r\n\t\t\tthis.heightmap.orBytes(this.heightmaps[i]);\r\n\t\t}\r\n\t\tthis.heightmap.heal();\r\n\t\tthis.heightmaps=[];\r\n\t}\r\n\r\n\tscratchGrid16(){\r\n\t\tconst scratch=this.scratch;\r\n\t\tconst context=scratch.get