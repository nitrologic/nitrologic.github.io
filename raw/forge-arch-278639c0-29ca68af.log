r\n\t\tconst y=(sy-h/2)*scale;\r\n\r\n\t\tconst rx=sin*y+cos*x;\r\n\t\tconst ry=cos*y-sin*x;\r\n\r\n\t\tconst mapx=this.layerx+rx;\r\n\t\tconst mapy=this.layery+ry;\r\n\r\n\t\tconst g=topo?topo.pick(mapx,mapy):0;\r\n\r\n\t\tconst ox=mapx-this.homex;\r\n\t\tconst oy=mapy-this.homey;\r\n\r\n\t\tconst oz=g;//0x1a0+g;\r\n\r\n\t\treturn [ox,oy,oz];\r\n\t}\r\n\r\n\trefreshCursor(){\r\n\t\tconst balls=this.cursorshape;\r\n\t\t// simon come here and fix level\r\n\t\tconst topo=this.topoTiles[1];\r\n\t\tif(balls){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tconst n=balls.count;\r\n\t\t\tconst posrot=balls.posrot32;\r\n\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\tconst xyz=this.screenPick(topo,w/2,h/2+(i-5)*10);\r\n\t\t\t\tposrot[i*8+0]=xyz[0];//Math.random()*20-10;\r\n\t\t\t\tposrot[i*8+1]=xyz[1];\r\n\t\t\t\tposrot[i*8+2]=xyz[2];\r\n\t\t\t\tposrot[i*8+3]=65536*0;\r\n\t\t\t\tposrot[i*8+4]+=16;\r\n\t\t\t\tposrot[i*8+5]+=32;\r\n\t\t\t\tposrot[i*8+6]+=48;\r\n//\t\t\t\tballs.position(i,xyz[0],xyz[1],xyz[2]);\r\n\t\t\t}\r\n\t\t\tballs.useShape();\r\n\t\t\tballs.writePosRot();\r\n\t\t}\r\n\t}\r\n\r\n\trefreshCursor2(){\r\n\t\tconst scale=100/this.zoom;\r\n\t\tconst ww=this.cursorWidth*scale/2;\r\n\t\tconst hh=this.cursorHeight*scale/2;\r\n\t\tconst context=this.context;\r\n\t\tif(context){\r\n\t\t\tconst w=this.canvas.width;\r\n\t\t\tconst h=this.canvas.height;\r\n\t\t\tcontext.fillStyle=CursorStyle;\r\n\t\t\tcontext.resetTransform();\r\n\t\t\tswitch(this.cursorType){\r\n\t\t\t\tcase 1:\r\n\t\t\t\t\tcontext.fillRect(w/2,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 2:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(w/2+ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tcontext.fillRect(0,h/2+hh,w,1);\r\n\t\t\t\t\tbreak;\r\n\t\t\t\tcase 3:\r\n\t\t\t\t\tcontext.fillRect(w/2-ww,0,1,h);\r\n\t\t\t\t\tcontext.fillRect(0,h/2-hh,w,1);\r\n\t\t\t\t\tfor(let i=0;i<16;i++){\r\n\t\t\t\t\t\tcontext.fillRect(w/2+ww*i,0,1,h);\r\n\t\t\t\t\t\tcontext.fillRect(0,h/2+hh*i,w,1);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// decrements this.frameElapsed in 18ms counts\r\n\t// ticks gamepads and apply drag to speed\r\n\t// if detect idle from max speed then snapshot address\r\n\r\n\trefreshGrid(){\r\n\t\tlet dirtygrid=this.dirty;\r\n\t\tthis.dirty=false;\r\n\r\n\t\tconst drag=this.mousedown?0.5:0.94;\r\n\t\tconst drag2=0.88;\r\n//\t\tconst drag=this.mousedown?0.5:0.95;\r\n//\t\tdirtygrid=true;\r\n\r\n\t\tlet frames=(((this.frameElapsed/6)|0)*2)||1;\r\n\t\tthis.frameElapsed=0;\r\n\r\n\t\tframes=1;\r\n\r\n\t\twhile(frames--){\r\n\r\n\t\t\tthis.layerx+=this.speed[0];\r\n\t\t\tthis.layery+=this.speed[1];\r\n\r\n\t\t\tthis.addZoom(this.speed[2]);\r\n\t\t\tthis.heading+=this.speed[3];\r\n\r\n\t\t\tthis.tickGamepads();\r\n\r\n\t\t\tthis.speed[0]*=drag;\r\n\t\t\tthis.speed[1]*=drag;\r\n\t\t\tthis.speed[2]*=drag2;\r\n\t\t\tthis.speed[3]*=drag2;\r\n\r\n\t\t\tconst max=VectorLengthSquared(this.speed);\r\n\t\t\tif(max<0.1){\r\n\t\t\t\tif(!this.idle){\r\n\t\t\t\t\tthis.idle=true;\r\n\t\t\t\t\t// ON IDLE snapeshot location in history state\r\n\t\t\t\t\tconst app=AppEditor;\r\n\t\t\t\t\tconst location=app.getLocation();\r\n\t\t\t\t\tif(location){\r\n\t\t\t\t\t\tconst locationHash=\"#\"+JSON.stringify(location);\r\n\t\t\t\t\t\thistory.replaceState(null, null, locationHash);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tthis.idle=false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\thome(){\r\n\t\tthis.layerx=this.homex;\r\n\t\tthis.layery=this.homey;\r\n\t}\r\n\r\n\ttoggleFullscreen2(){\r\n\t\tif(this.fullscreen){\r\n\t\t\tdocument.webkitExitFullscreen();\r\n\t\t\tthis.fullscreen=false;\r\n\t\t}else{\r\n\t\t\tconst element=AppMedia;\r\n\t\t\telement.webkitEnterFullScreen();\r\n\t\t\tthis.fullscreen=true;\r\n\t\t}\r\n\t}\r\n\r\n\ttoggleFullscreen(){\r\n//\t\tvar element=this.body;\r\n\t\tconst element=document.body;\r\n\t\tif(document.exitFullscreen){\r\n\t\t\tif(this.fullscreen){\r\n\t\t\t\tdocument.exitFullscreen();\r\n\t\t\t\tthis.fullscreen=false;\r\n\t\t\t}else{\r\n\t\t\t\t// on promise...\r\n\t\t\t\telement.requestFullscreen();\r\n\t\t\t\tthis.fullscreen=true;\r\n\t\t\t}\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tif(element.webkitEnterFullScreen){\r\n\t\t\t\treturn toggleFullscreen2();\r\n\t\t\t}else{\r\n\t\t\t\twindow.notify(\"html fullscreen support not detected\");\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n}\r\n\r\nfunction IgnoreContextMenu(pointerevent){\r\n\tpointerevent.preventDefault();\r\n\treturn false;\r\n}\r\n\r\nfunction SwitchAerial(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipAerial(on);\r\n}\r\nfunction SwitchHeight(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipHeight(on);\r\n}\r\nfunction SwitchOverlay(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipOverlay(on);\r\n}\r\nfunction SwitchRes(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tAppEditor.flipRes();\r\n}\r\n\r\n//function SetLevel(click,state){\r\n//\tAppEditor.flipLevel(state);\r\n//}\r\nfunction SwitchMode(click){\r\n\tAppEditor.flipMode()\r\n}\r\nfunction SwitchTilt(click){\r\n\tAppEditor.toggleTilt();\r\n}\r\n\r\nfunction SwitchGPS(click){\r\n\tAppEditor.toggleGPS();\r\n}\r\n\r\nfunction _deviceOrientation(o){\r\n\tif(!epoch){\r\n\t\tepoch=o.timestamp;\r\n\t}\r\n\tconst p=[o.absolute,o.alpha,o.beta,o.gamma];\r\n\tconst orientation={\r\n\t\to:p,\r\n\t\tts:o.timestamp-epoch\r\n\t}\r\n\tconst json=JSON.stringify(orientation);\r\n\tSetStatus(json);\r\n}\r\nlet JyroListener;\r\nfunction SwitchJyro(click){\r\n\tconst e=click.target;\r\n\tconst on=toggleAttribute(e,\"on\")\r\n\tif(on){\r\n\t\tJyroListener=window.addEventListener(\"deviceorientation\",_deviceOrientation);\r\n\t}else{\r\n\t\twindow.removeEventListener(\"deviceorientation\",JyroListener);\r\n\t\tJyroListener=null;\r\n\t\tSetStatus(\"\");\r\n\t}\r\n}\r\n\r\nlet _PixelLoader=null;\r\nlet _MeshLoader=null;\r\n\r\nfunction loadWire(){\r\n\tfetchTiles();\r\n\tfetchGrid();\r\n}\r\n\r\nfunction fetchTiles(){\r\n\tconst url=\"json/tiles.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_tiles=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.onTiles(_tiles);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchTiles fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\nfunction fetchGrid(){\r\n\tconst url=\"json/grid.json\";\r\n\tfetch(url).then(response=>response.json()).then(\r\n\t\t_grid=>{\r\n\t\t\tconst editor=AppEditor;\r\n\t\t\teditor.loadGrid(_grid);\r\n\t\t},_error=>{\r\n\t\t\tconsole.log(\"fetchGrid fail epix\");\r\n\t\t}\r\n\t);\r\n}\r\n\r\n// !!! replaced with loadWire\r\nfunction launchWire(){\r\n//\teditor.buildTopo(_nz3);\r\n//\teditor.buildTopo(_w1);\r\n//\teditor.buildTopo(_ak1);\r\n//\teditor.home();\r\n//\tvideo.addEventListener(\"pause\",editor.pause.bind(editor));\r\n//\teditor.animate();\r\n}\r\n\r\n// body,[screen]\r\n\r\nfunction goWireLocation(gpn6){\r\n\tAppEditor.setLocation(gpn6);\r\n}\r\n\r\n// 2025-10-2 - video is now null and we need fullscreen\r\n\r\nfunction initWireGrid(body){\r\n//\tdocument.title=\"nitrologic wire grid\";\r\n\tAppPlatform=new DesktopPlatform();\r\n//\tAppPlatform=new MobilePlatform();\r\n//\tAppPlatform=new EmbeddedPlatform();\r\n\tconst agent = navigator.userAgentData||UnidentifiedAgent;\r\n\tconsole.log(\"wire agent : \" + JSON.stringify(agent));\r\n\r\n\tconst license=AK17_License.join(\"\\n\");\r\n\tconst title=\"[]\";\r\n\tbody.setAttribute(\"title\",title);\r\n\r\n\tconst screen=document.createElement(\"div\");\r\n\tscreen.className=\"wiregrid\";\t//was screen\r\n\r\n//\teditor.toggleFullscreen();\r\n\r\n\tbody.appendChild(screen);\r\n\r\n\tconst video=null;\r\n\t_PixelLoader=new PixelLoader();\r\n\t_MeshLoader=new MeshLoader();\r\n\r\n\t// todo: wire mode 0 not supported\r\n\tconst editor=new TopoEditor(screen,video,1);\r\n\r\n\tAppScreen=screen;\r\n\tAppEditor=editor;\r\n\r\n\tconst root=[];\r\n\r\n\tconst hit_grid=editor.hitKey.bind(editor);\r\n\tconst panel=new Panel(screen,hit_grid,root);\r\n\r\n\tAppPanel=panel;\r\n\r\n\teditor.animate();\r\n\tloadWire();\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/wirejs/wire_graphics.js\",\"length\":50909,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_graphics.js\r\n// (c)2022 Simon Armstrong\r\n// All rights reserved\r\n\r\n//const ScratchRes=1024;\r\n//const ScratchScale=0.5;\r\n\r\nfunction drawLakeLines(context,outlines,lines,name,tile){\r\n\tlet cx=0;\r\n\tlet cy=0;\r\n\tlet cn=0;\r\n\tconst start=lines.start;\r\n\tconst count=lines.count;\r\n\tfor(let o=0;o<count;o++){\r\n\t\tconst outline=outlines[start+o];\r\n\t\tconst n=outline.length;\r\n\t\tfor(let r=0;r<n;r++){\r\n\t\t\tconst v=outline[r];\r\n\t\t\tconst x=v[0];\r\n\t\t\tconst y=v[1];\r\n\t\t\tconst z=v[2];\r\n\t\t\tcx+=x;\r\n\t\t\tcy+=y;\r\n/*\r\n\t\t\tconst dist=v[3];\r\n\t\t\tconst angle=v[4];\r\n\t\t\tconst bits=v[5];\r\n\t\t\tmaxx=Math.max(maxx,x);\r\n\t\t\tif(r==0){\r\n\t\t\t\tcontext.beginPath();\r\n\t\t\t\tcontext.moveTo(x/2,y/2);\r\n\t\t\t}else{\r\n\t\t\t\tlet clipped=(bits!=0);\r\n\t\t\t\t//((x==0&&y==0)||(x==0&&y==y1)||(x==x1&&y==0)||(x==x1&&y==y1));\r\n\t\t\t\tif (clipped){\r\n\t\t\t\t\tif(!wasclipped){\r\n\t\t\t\t\t\tcontext.lineTo(x/2,y/2);\r\n\t\t\t\t\t}\r\n\t\t\t\t\twasclipped=true;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(wasclipped){\r\n\t\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\t\tcontext.moveTo(x/2,y/2);\r\n\t\t\t\t\t\twasclipped=false;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse{\r\n\t\t\t\t\t\tcontext.lineTo(x/2,y/2);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n*/\t\t\t\t\r\n\t\t}\r\n\t\tcn+=n;\r\n\t}\r\n\tcx/=cn;\r\n\tcy/=cn;\r\n\tcontext.beginPath();\r\n\tcontext.ellipse(cx/2,cy/2,20,20,0,0,2*Math.PI);\r\n//\t\t\tcontext.fill();\r\n\tcontext.stroke();\r\n\r\n\ttile.floodLake(cx/2,cy/2);\r\n}\r\n\r\nconst RainbowPalette=[\"red\",\"orange\",\"yellow\",\"green\",\"blue\",\"indigo\",\"violet\",\"white\"];\r\n\r\nfunction circleOutlines(context,outlines,lines,color){\r\n\t\t\t\t\t\r\n\tconst start=lines.start;\r\n\tconst count=lines.count;\r\n\r\n\tcontext.strokeStyle=color;\r\n\tcontext.lineWidth=10;\r\n\r\n\tconst name=lines.attr[1];\r\n\tif(name) {\r\n\t\tconsole.log(name);\r\n\t}\r\n\tfor(let o=0;o<count;o++){\r\n\t\tconst outline=outlines[start+o];\r\n\t\tconst n=outline.length;\r\n\r\n\t\tfor(let r=0;r<n;r++){\r\n\t\t\tconst v=outline[r];\r\n\t\t\tconst x=v[0]/2;\r\n\t\t\tconst y=v[1]/2;\r\n\r\n\t\t\tif(r==0){\r\n\t\t\t\tcontext.beginPath();\r\n\t\t\t\tcontext.ellipse(x,y,20,20,0,0,2*Math.PI);\r\n\t\t\t\tcontext.stroke();\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\n\r\nclass DesktopPlatform{\r\n\tScratchRes=2048;\r\n\tScratchScale=1.0;\r\n\tOverlayRes=256;\r\n\tMipName=\"\";\t//hd- ftw\r\n\tMaxFetch=2;\r\n}\r\n\r\nclass MobilePlatform{\r\n//\tScratchRes=1024;\r\n//\tScratchScale=0.5;\r\n\tScratchRes=512;\r\n\tScratchScale=0.25;\r\n\tOverlayRes=256;\r\n\tMipName=\"sd-\";\r\n\tMaxFetch=2;\r\n}\r\n\r\nclass EmbeddedPlatform{\r\n\tScratchRes=256;\r\n\tScratchScale=0.125;\r\n\tOverlayRes=256;\r\n\tMipName=\"sd-\";\r\n\tMaxFetch=1;\r\n}\r\n\r\n\r\n// Node View GraphicsLayer GraphicsStack Builder PointCloud\r\n\r\nclass ParentNode{kids=[];}\r\n\r\nclass View{\r\n\tconstructor(layer){\r\n\t\tthis.layer=layer;\r\n\t\tthis.scene=new ParentNode();\r\n\t}\r\n\r\n\trefreshView(w,h){\r\n\t\tconst rawview=this.layer.RawView;\r\n\t\tconst rect=this.layer.viewport;\r\n\t\tTranslateZoomAngleAspect(rawview,this.tx,this.ty,this.zoom,this.angle,w,h,this.tilt,this.alt,this.hfac,rect);\r\n\t}\r\n\r\n\tisoView(tx,ty,zoom,angle,tilt,alt,hfac){\r\n\t\tthis.tx=tx;\r\n\t\tthis.ty=ty;\r\n\t\tthis.zoom=zoom;\r\n\t\tthis.angle=angle;\r\n\t\tthis.tilt=tilt;\r\n\t\tthis.alt=alt;\r\n\t\tthis.hfac=hfac;\r\n//\t\tTranslateZoomAngleAspect(rawview,tx,ty,zoom,angle,w,h,tilt,alt,hfac,rect);\r\n//\t\tthis.refreshView(w,h);\r\n\t}\r\n\r\n\taddScaleModel(model,positions){\r\n\t\treturn this.layer.addScaleModel(model,positions);\r\n\t}\r\n\r\n\taddFlatShape(surface,origin,count){\r\n\t\treturn this.layer.addFlatShape(surface,origin,count);\r\n\t}\r\n}\r\n\r\nclass GraphicsLayer{\r\n\r\n\tconstructor(glsl,glcontext) {\r\n\t\tthis.glsl=glsl;\r\n\t\tthis.glcontext=glcontext;\r\n\t\tthis.RawView=new Float32Array(16);\r\n\t\tthis.viewport=null;\r\n//\t\tthis.reset();\r\n\t}\r\n\r\n\tcompile(){\r\n\t\tconst layers=this.rawLayers();\r\n\t\tthis.compileLayers(layers);\r\n\t}\r\n\r\n\trawLayers(){\r\n\t\treturn [\r\n\t\t\tthis.modelLayer,\r\n\t\t\tthis.staticLayer,\r\n\t\t\tthis.tileLayer,\r\n\t\t\tthis.flatLayer,\r\n\t\t\tthis.lineLayer,\r\n\t\t\tthis.pointLayer,\r\n\t\t\tthis.edgeLayer\r\n\t\t];\r\n\t}\r\n\r\n\tcheckGL(){\r\n\t\treturn;\t//todo: switch gl checking\r\n\t\tconst error=this.glcontext.gl.getError();\r\n\t\tif(error){\r\n\t\t\tconst reason=this.glcontext.errorsInfo[error];\r\n\t\t\tconsole.log(\"webgl2 check glError:\"+error+\",reason:\"+reason);\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\treset(){\r\n\t\tconst glsl=this.glsl;\r\n\r\n\t\tthis.spriteLayer=this.addLayer(glsl.sprite_vertex,glsl.sprite_fragment,glsl.spriteAttributes,glsl.spriteUniforms,[\"depthDisable\"]);\r\n\t\tthis.checkGL();\t\r\n\r\n\t\tthis.lineLayer=this.addLayer(glsl.rayVertex,glsl.rayFragment,glsl.rayAttributes,glsl.rayUniforms,[\"depthDisable\"]);\r\n\t\tthis.checkGL();\t\r\n\t\tthis.flatLayer=this.addLayer(glsl.flat_vertex,glsl.flat_fragment,glsl.flatAttributes,glsl.flatUniforms,[\"depthEnable\"]);\r\n\t\tthis.checkGL();\r\n\t\tthis.tileLayer=this.addLayer(glsl.tile_vertex,glsl.tile_fragment,glsl.tileAttributes,glsl.tileUniforms,[\"depthEnable\"]);\r\n\t\tthis.checkGL();\r\n\t\tthis.staticLayer=this.addLayer(glsl.static_vertex,glsl.static_fragment,glsl.staticAttributes,glsl.staticUniforms,[\"depthEnable\"]);\r\n\t\tthis.checkGL();\r\n\t\tthis.modelLayer=this.addLayer(glsl.model_vertex,glsl.model_fragment,glsl.modelAttributes,glsl.modelUniforms,[\"depthEnable\"]);\r\n\t\tthis.checkGL();\r\n\t\tthis.pointLayer=this.addLayer(glsl.rayVertex,glsl.pointFragment,glsl.rayAttributes,glsl.rayUniforms,[\"depthEnable\",\"depthDisable\"]);\r\n\t\tthis.checkGL();\r\n\t\tthis.edgeLayer=this.addLayer(glsl.rayVertex,glsl.rayFragment,glsl.rayAttributes,glsl.rayUniforms,[\"depthEnable\"]);\r\n\t\tthis.checkGL();\r\n\t\tthis.displayAspect=glsl.displayAspect;\r\n\t}\r\n\r\n\taddLayer(vertexShader,fragmentShader,attributeNames,uniformNames,tags){\r\n\t\tconst maxHandles=this.glcontext.profile.MaxHandles;\r\n//\t\tconsole.log(\"addLayer maxHandles:\",maxHandles);\r\n\t\tconst vertexSource=vertexShader.replace(\"%MaxHandles%\",maxHandles);\r\n\r\n\t\tconst gl=this.glcontext.gl;\r\n\t\tconst vertex=new Shader(gl,vertexSource,gl.VERTEX_SHADER)\r\n\t\tif (vertex.error){\r\n\t\t\tshaderError(\"addLayer vertex.error\",vertex.error);\r\n\t\t\treturn null;\r\n\t\t}\r\n\t\tconst fragment=new Shader(gl,fragmentShader,gl.FRAGMENT_SHADER)\r\n\t\tif(fragment.error){\r\n\t\t\tshaderError(\"addLayer fragment.error\",fragment.error);\r\n\t\t\treturn null;\r\n\t\t}\r\n\t\tconst program=new WireProgram(gl,[vertex.shader,fragment.shader]);\t\r\n\t\tconst layer=new Layer(gl,program,attributeNames,uniformNames,tags);\r\n\r\n\t\treturn layer;\r\n\t}\r\n\r\n\tremoveMesh(mesh){\r\n\t\tthis.tileLayer.removeShape(mesh);\r\n\t\tthis.staticLayer.removeShape(mesh);\r\n\t\tthis.flatLayer.removeShape(mesh);\r\n\t}\r\n\r\n\r\n\r\n/*\r\n\taddLineShape(shorts,xyz){\r\n\t\tconst n=xyz.length;\r\n\t\tconst shape=new Shape(this.glcontext.gl,n);\r\n\t\tshape.addLines(shorts);\r\n\t\tshape.bindAttributes(this.lineLayer.attributes,4)\r\n\t\tthis.lineLayer.addShape(shape);\r\n\t\tshape.setPositions(xyz);\r\n\t\treturn shape;\r\n\t}\r\n*/\r\n\r\n\taddFlatShape(surface,origin,count){\r\n\t\tconst shape=new Shape(this.glcontext.gl,1,count);\r\n\t\tshape.addFlatSurface(surface);\r\n\t\tconst vertCount=surface.vertCount;\r\n\t\tshape.bindAttributes(this.flatLayer.attributes,4,vertCount);\r\n\t\tthis.flatLayer.addShape(shape);\r\n\t\tshape.setOrigin(origin);\r\n\t\treturn shape;\r\n\t}\r\n\r\n\taddTileShape(surface,basemap,scratch,origin){\r\n\t\tconst shape=new Shape(this.glcontext.gl,1);\r\n//\t\tshape.loadTexture(basemap,0);\r\n\t\tshape.loadTexture(scratch,0);\r\n\t\tshape.loadTexture(scratch,1);\r\n\t\tshape.addSurface(surface);\r\n\t\tconst count=surface.vertCount;\r\n\t\tshape.bindAttributes(this.tileLayer.attributes,4,count)\r\n\t\tthis.tileLayer.addShape(shape);\r\n\t\tshape.setOrigin(origin);\r\n\t\treturn shape;\r\n\t}\r\n\r\n\taddStaticShape(surface,basemap,wallmap,origin){\r\n\t\tconst shape=new Shape(this.glcontext.gl,1);\r\n\t\tshape.loadTexture(basemap,0);\r\n\t\tshape.loadTexture(wallmap,2);\r\n\t\tshape.addSurface(surface);\r\n\t\tconst count=surface.vertCount;\r\n\t\tshape.bindAttributes(this.staticLayer.attributes,4,count);\r\n\t\tthis.staticLayer.addShape(shape);\r\n\t\tshape.setOrigin(origin);\r\n\t\treturn shape;\r\n\t}\r\n\r\n\t// walls r us\r\n\taddStaticShapes(surfaces,basemap,wallmap,origin){\r\n\t\tconst shapes=[];\r\n\t\tfor(const surface of surfaces){\r\n\t\t\tconst shape=this.addStaticShape(surface,basemap,wallmap,origin);\r\n\t\t\tshapes.push(shape);\r\n\t\t}\t\r\n\t\treturn shapes;\r\n\t}\r\n\r\n\taddScaleModel(model,positions){\r\n\t\tconst diffuse=model.meep[0];\r\n\t\tconst shape=new Shape(this.glcontext.gl,1);\r\n\t\tshape.loadTexture(diffuse,0);\r\n\t\tshape.addMeshSurface(model.meesh[0]);\r\n\t\tshape.bindAttributes(this.modelLayer.attributes,4)\r\n\t\tthis.modelLayer.addShape(shape);\r\n\r\n\t\tconst transform=model.getMeshTransform(0.4);\r\n\t\tshape.setTransforms([transform]);\r\n\r\n\t\tconst posrot=shape.posrot32;\r\n\t\tconst n=positions.length;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tposrot[i*8+0]=positions[i][0];\r\n\t\t\tposrot[i*8+1]=positions[i][1];\r\n\t\t\tposrot[i*8+2]=positions[i][2];\r\n\t\t\tposrot[i*8+3]=positions[i][3];\r\n\t\t}\r\n\t\t\r\n//\t\tshape.setPositions(positions);\r\n//\t\tshape.setScales(scales);\r\n\r\n\t\tshape.writePosRot();\r\n\r\n\t\treturn shape;\r\n\t}\r\n\r\n\tcompileLayers(layers){\r\n\t\tthis.layers=layers;\r\n\t\tthis.drawlist=this.drawLayerList(layers);\r\n\t}\r\n\r\n\tsetViewport(x,y,w,h){\r\n\t\tthis.viewport=[x,y,w,h];\r\n\t}\r\n\r\n\tbake(gpu){\r\n\t\tthis.checkGL();\r\n\t\tconst color0=this.background;\r\n\t\tconst context=this.glcontext;\r\n\t\tconst gl=context.gl;\r\n\t\tconst rect=this.viewport;\r\n\t\tif(rect){\r\n\t\t\tconst x=rect[0];\r\n\t\t\tconst y=rect[1];\r\n\t\t\tconst w=rect[2];\r\n\t\t\tconst h=rect[3];\r\n\t\t\tconst height=context.canvas.height;\r\n\t\t\tgl.scissor(x,height-h-y,w,h);\r\n\t\t}else{\r\n\t\t\tconst w=context.canvas.width;\r\n\t\t\tconst h=context.canvas.height;\r\n\t\t\tgl.scissor(0,0,w,h);\r\n\t\t}\r\n\t\tgl.enable(gl.SCISSOR_TEST);\r\n\t\tcontext.clear(color0);\r\n\t\tthis.drawLayers(gpu,this.drawlist,this.layers);\r\n\t\tthis.checkGL();\r\n\t}\r\n\r\n\tdrawLayerList(layers){\r\n\t\tconst gl=this.glcontext.gl;\r\n\t\tconst draw=[];\r\n\t\tfor(const pass of [\"depthDisable\",\"depthEnable\"]){\r\n\t\t\tif(pass==\"depthEnable\"){\r\n\t\t\t\tdraw.push({command:gl.enable,arguments:[gl.DEPTH_TEST]});\r\n\t\t\t}\r\n\t\t\tfor(const layer of layers){\r\n\t\t\t\tif (layer.tags.includes(pass)){\r\n\t\t\t\t\tdraw.push({command:gl.useProgram,arguments:[layer.program.name]});\r\n\t\t\t\t\tconst handlesUniform=layer.uniforms[\"handles\"];\r\n\t\t\t\t\tconst shapes=layer.shapes;\r\n\t\t\t\t\tfor(const i in shapes){\r\n\t\t\t\t\t\tconst shape=shapes[i];\r\n\t\t\t\t\t\tshape.addDraw(draw,handlesUniform);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif(pass==\"depthEnable\"){\r\n\t\t\t\tdraw.push({command:gl.disable,arguments:[gl.DEPTH_TEST]});\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn draw;\r\n\t}\r\n\r\n\tdrawLayers(gpu,drawlist,layers){\r\n\t\tconst rawView=this.RawView;\r\n\t\tconst gl=this.glcontext.gl;\r\n\t\tfor(const layer of layers){\r\n\t\t\tlayer.useLayer();\r\n\t\t\tlayer.setMatrix(\"view\",rawView);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setFloats(\"palette\",gpu.RawPalette);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setFloats(\"sun\",gpu.RawSun);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setInts(\"style\",gpu.RawStyle);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setSampler(\"basemap\",0);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setSampler(\"scratch\",1);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setSampler(\"wallmap\",2);\r\n\t\t\tthis.checkGL();\r\n\t\t\tlayer.setSampler(\"diffuse\",0);\r\n\t\t\tthis.checkGL();\r\n\t\t}\r\n\t\tthis.checkGL();\r\n\t\tfor (const draw of drawlist){\r\n\t\t\ttry{\r\n\t\t\t\tdraw.command.apply(gl,draw.arguments)\r\n\t\t\t}catch(error){\r\n\t\t\t\tconsole.log(error);\r\n\t\t\t\tconsole.log(draw);\r\n\t\t\t\tdebugger;\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.checkGL();\r\n\t}\r\n\r\n}\r\n\r\n\r\n// tilemanager\r\n// connects abstrtact glsl to webgl2 context\r\n\r\nclass GraphicsStack{\r\n\r\n\tconstructor(canvas,glsl) {\r\n\t\tthis._activeTiles=[];\r\n\t\tthis.pixelRatio=window.devicePixelRatio;\r\n\r\n\t\t// todo profile display\r\n\t\tconst profile=DisplayProfiles.Intel1056;\t//at home\r\n//\t\tconst profile=DisplayProfiles[Nvidia4096];\t//at work\r\n\r\n\t\tconst context=new WebGL2Context(canvas,profile);\r\n\t\tif (!context.gl) throw \"GraphicsContext context missing gl\"\r\n\r\n\t\tthis.background=[16,20,24];\r\n\t\tcontext.clear(this.background);\t\t\r\n\r\n\t\tthis.glcontext=context;\r\n\t\tthis.frameCount=0;\r\n\t\tthis.glsl=glsl;\r\n\r\n\t\tthis.graphicsLayers=[];\r\n\t\tthis.graphicsViews=[];\r\n\r\n\t\tconst layer0=this.addGraphicsLayer();\r\n\r\n\t\tthis.view0=new View(layer0);\r\n\r\n\t\tthis.builder=new Builder();\r\n\r\n\r\n//\t\tnew GraphicsLayer(glsl,context);\r\n//\t\tthis.views=[];\r\n//\t\tthis.scene=scene;\r\n//\t\tthis.check();\r\n//\t\tthis.layer0.reset();\r\n\r\n\t}\r\n\t\r\n\tvalidateGL(){\r\n\t\tconst error=this.glcontext.gl.getError();\r\n\t\tif(error){\r\n\t\t\tconst reason=this.glcontext.errorsInfo[error];\r\n\t\t\tconsole.log(\"GraphicsStack webgl2 check glError:\"+error+\",reason:\"+reason);\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\taddGraphicsView(){\r\n\t\tconst layer=this.addGraphicsLayer();\r\n\t\tconst view=new View(layer);\r\n\t\tthis.graphicsViews.push(view);\r\n\t\treturn view;\r\n\t}\r\n\r\n\taddGraphicsLayer(){\r\n\t\tthis.validateGL();\r\n\t\tconst layer=new GraphicsLayer(this.glsl,this.glcontext);\r\n\t\tlayer.reset();\r\n//\t\tthis.check();\r\n\t\tthis.graphicsLayers.push(layer);\r\n\t\treturn layer;\r\n\t}\r\n\r\n\tcompile(){\r\n\t\tfor(const layer of this.graphicsLayers){\r\n\t\t\tlayer.compile();\r\n\t\t}\r\n\t}\r\n\r\n\tbake(gpu){\r\n\t\tfor(const layer of this.graphicsLayers){\r\n\t\t\tlayer.bake(gpu);\r\n\t\t}\r\n\t}\r\n\r\n\r\n\tflush(){\r\n//\t\tthis.lineLayer.flush();\r\n//\t\tfor(const layer of layers){}\r\n//\t\tthis.scene.flush();\r\n\t}\r\n\r\n\tpopulateScene(){\r\n//\t\tdraw.drawRing(12,500,12,50,3);\r\n//\t\tconst tris=draw.flushTris();\r\n//\t\tconst surf=new Surface(tris.verts,tris.indices,[]);\r\n\t}\r\n\r\n\tflushTile(tile){\r\n\t\tconst meesh=[tile.tilemesh,tile.floramesh,tile.staticmeesh,tile.flatmeesh].flat();\r\n\t\tfor(const mesh of meesh){\r\n\t\t\tif(mesh){\r\n\t\t\t\tconst layer0=this.graphicsLayers[0];\r\n\t\t\t\tlayer0.removeMesh(mesh);\r\n\t\t\t}\r\n\t\t}\r\n\t\ttile.flushMesh();\r\n\t\t// simon com here and remove from _tileMesh\r\n\t\ttile.retire();\r\n\t}\r\n\r\n\tbakeTileSurface(tile){\r\n\t\ttile.createTopo();\r\n\t\tconst topo=CreateTopoSurface(128,16,0,tile.heightmap);\r\n\t\ttopo.calcNormals();\r\n\t\ttile.topoSurface=topo;\r\n\t}\r\n\r\n\tmeshTile(tile,home){\r\n\t\tthis._activeTiles.push(tile);\r\n\r\n//\t\tconsole.log(\"meshTile \"+this._activeTiles.length);\r\n\r\n\t\tconst tx=(tile.x)*TileSize-home[0];\r\n\t\tconst ty=(tile.y)*TileSize-home[1];\r\n\t\tconst origin=[tx,ty,0x4000];\r\n\r\n\t\tconst layer0=this.view0.layer;\r\n\r\n//\t\ttile.createTopo();\r\n\r\n\t\ttile.createScratch(AppPlatform.ScratchRes);\r\n\r\n//\t\tconst surfaces=[];//simon come here \r\n\r\n\t\tconst surfaces=this.builder.buildTile(tile,2);\r\n\r\n\t\t// simon come here and move hex grid layer to shader\r\n//\t\ttile.scratchGrid32();\r\n\r\n\t\ttile.allocWallmap();\r\n\r\n\t\ttile.staticmeesh=layer0.addStaticShapes(surfaces,tile.scratch,tile.wallmap,origin);\r\n\r\n//\t\tconst topo=TopoSurface(128,16,0,tile.heightmap);\r\n//\t\ttopo.calcNormals();\r\n\r\n//\t\ttopo.normalfyVerts();\r\n\r\n\t\t//\t\tconst shorts=surface.normalfyVerts();\r\n\r\n\t\tconst topo=tile.topoSurface;\r\n\r\n//\t\tremove fuzz first\r\n//\t\ttopo.flatifyVerts();\r\n\r\n\t\ttile.tilemesh=layer0.addTileShape(topo,tile.basemap,tile.scratch,origin);\r\n\r\n// flora\r\n//\t\tconst flora=TopoFloraSurface(128,16,0,tile.heightmap);\r\n//\t\tconst flora=TopoFloraSurface(256,8,0,tile.heightmap);\r\n//\t\tconst flora=TopoFloraSurface(512,4,0,tile.heightmap,24);\r\n\r\n\t\tconst floraSurface=tile.floraSurface;//new Surface(flora.verts,flora.indices,[]);\r\n\r\n//\t\tconst flora=TopoFloraSurface(512,4,0,tile.heightmap,2);\r\n\r\n//\t\tsimon come here and fix floramesh\r\n\t\tconst floramesh=layer0.addTileShape(floraSurface,tile.basemap,tile.scratch,origin);\r\n\t\ttile.floramesh=floramesh;\r\n\t}\r\n\r\n\tpopulateHome(tiles,home){\r\n\t\tfor(const tile of tiles){\r\n\t\t\tif(!tile.tilemesh && tile.hasLoaded()){\r\n// simon come here and verify mesh first then tilesurface\r\n\t\t\t\tthis.meshTile(tile,home);\r\n\t\t\t\tif(!tile.hasBaker){\r\n\t\t\t\t\tthis.bakeTileSurface(tile);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\t\t\r\n\t}\r\n\r\n}\r\n\r\nclass Builder{\r\n\r\n\twallPixels=0;\r\n\r\n\tcheckGL2(){\r\n\t\treturn;\r\n\t\tconst error=this.glcontext.gl.getError();\r\n\t\tif(error){\r\n\t\t\tconst reason=this.glcontext.errorsInfo[error];\r\n\t\t\tconsole.log(\"webgl2 check glError:\"+error+\",reason:\"+reason);\r\n\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\tbuildRoadSegment(tile,outline,lanes,c){\r\n\t\tconst topo=tile.heightmap;\r\n\t\tconst v=[];\r\n\t\tconst i=[];\r\n\t\tconst n=outline.length;\r\n\t\tlet segcount=0;\r\n\t\tfor(let o=0;o<n-1;o++){\r\n\t\t\tconst x0=(outline[o][0]/2);\r\n\t\t\tconst y0=(outline[o][1]/2);\r\n\t\t\tconst x1=(outline[o+1][0]/2);\r\n\t\t\tconst y1=(outline[o+1][1]/2);\r\n\t\t\tconst dx=x1-x0;\r\n\t\t\tconst dy=y1-y0;\r\n\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\tif(d>0){\r\n\t\t\t\tconst nx=dy/d;\r\n\t\t\t\tconst ny=-dx/d;\r\n\t\t\t\tconst segs=(d/50)|0;\r\n\t\t\t\tconst end=(o==n-2)?1:0;\r\n\t\t\t\tfor(let j=0;j<segs+end;j++){\r\n\t\t\t\t\tconst jx0=x0+j*dx/segs;\r\n\t\t\t\t\tconst jy0=y0+j*dy/segs;\r\n\t\t\t\t\tconst LaneWidth=20;\r\n\t\t\t\t\tfor(let l=0;l<=lanes;l++){\r\n\t\t\t\t\t\tconst o=LaneWidth*(l-(lanes+1)/2);\r\n\t\t\t\t\t\tconst tx=jx0+o*nx;\r\n\t\t\t\t\t\tconst ty=jy0+o*ny;\r\n\t\t\t\t\t\tconst h0=topo.pickElevation(tx,ty);\r\n\t\t\t\t\t\tconst h1=topo.pickHeight(tx,ty);\r\n\t\t\t\t\t\tv.push([tx,-ty,h0+h1,3,0,0,0,c]);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tsegcount++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst w=lanes+1;\r\n\t\tfor(let j=0;j<segcount-1;j++){\r\n\t\t\tlet v0=j*w;\r\n\t\t\tlet v1=(j+1)*w;\r\n\t\t\tfor(let l=0;l<lanes;l++){\r\n\t\t\t\ti.push([v0,v1,v1+1]);\r\n\t\t\t\ti.push([v0,v1+1,v0+1]);\r\n\t\t\t\tv0++;\r\n\t\t\t\tv1++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(v.length){\r\n\t\t\treturn new Surface(v,i,[])\r\n\t\t}\r\n\t}\r\n\r\n\tbuildRoof(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,true,3,false,true);\r\n\t}\r\n\r\n// \tbuildOutline(tile,outline,walls,c,outer,fill){\r\n\r\n\tbuildWalls(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,true,3,false,false);\r\n\t}\r\n\r\n\tbuildTransit(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,false,4,false,true);\r\n\t}\r\n\r\n\tbuildPowerline(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,false,4,false,true);\r\n\t}\r\n\r\n\tbuildPylon(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,false,4,false,true);\r\n\t}\r\n\r\n\tbuildRail(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,false,4,false,false);\r\n\t}\r\n\r\n\tbuildCoast(tile,outline){\r\n\t\treturn this.buildOutline(tile,outline,false,5,true,false);\r\n\t}\r\n\r\n/*\r\n\t\tif(px<0 && x>0) enterEdge=4;\r\n\t\tif(py<0 && y>0) enterEdge=1;\r\n\t\tif(px>=clip&&x<clip) enterEdge=2;\r\n\t\tif(py>=clip&&py<clip) enterEdge=3;\r\n*/\r\n\r\n\r\n\tbuildOutline(tile,outline,walls,c,outer,fill){\r\n\t\tconst clip=2048;\r\n\t\tconst topo=tile.heightmap;\r\n\t\tlet xmin=1e9;\r\n\t\tlet xmax=-1e9;\r\n\t\tlet ymin=1e9;\r\n\t\tlet ymax=-1e9;\r\n\t\tlet zmin=1e9;\r\n\t\tlet zmax=-1e9;\r\n\t\tconst pts=[];\r\n\t\tconst n=outline.length;\r\n\t\tlet circumference=0;\r\n\t\tfor(const reverse of [false,true]){\r\n\t\t\tif((outer && !reverse)||(fill && reverse)){\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tlet wasOutside=true;\r\n\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\tconst w=reverse?n-i-1:i;\r\n\t\t\t\tconst o=outline[w];\r\n\t\t\t\tconst x=(o[0]/2)|0;\r\n\t\t\t\tconst y=(o[1]/2)|0;\r\n\t\t\t\tconst d=circumference;\r\n\r\n\t\t\t\tconst g0=topo.pickGround(x,y);\r\n\t\t\t\tconst h0=topo.pickElevation(x,y);\r\n\t\t\t\tconst h1=h0+topo.pickHeight(x,y)+200;\r\n\r\n\t\t\t\tzmin=Math.min(zmin,h0);\r\n\t\t\t\tzmax=Math.max(zmax,h1);\r\n\t\t\t\tymin=Math.min(ymin,y);\r\n\t\t\t\tymax=Math.max(ymax,y);\r\n\t\t\t\txmin=Math.min(xmin,x);\r\n\t\t\t\txmax=Math.max(xmax,x);\r\n\t\t\t\tconst outside=(x<0||y<0||x>=clip||y>=clip)?1:0;\r\n\t\t\t\tpts.push([x,y,d,outside]);\r\n\t\t\t\tif(i<n-1 && !(outside&&wasOutside)){\r\n\t\t\t\t\tconst ww=reverse?n-i-2:i+1;\r\n\t\t\t\t\tconst oo=outline[ww];\r\n\t\t\t\t\tconst dx=oo[0]-o[0];\r\n\t\t\t\t\tconst dy=oo[1]-o[1];\r\n\t\t\t\t\tconst d=Math.sqrt(dx*dx+dy*dy);\r\n\t\t\t\t\tcircumference+=d;\r\n\t\t\t\t}\r\n\t\t\t\twasOutside=outside;\r\n\t\t\t}\r\n\r\n\t\t\tconst width=(xmax-xmin)|0;\r\n\t\t\tconst height=(ymax-ymin)|0;\r\n\t\t\tconst pointcloud=new PointCloud(width,height,xmin,ymin);\r\n\t\t\tif(walls){\r\n\t\t\t\tconst maxh=zmax-zmin;\r\n\t\t\t\tconst circ=(circumference+64);\r\n\t\t\t\tthis.wallPixels+=(circ*maxh*WallFactor)|0;\r\n\t\t\t\tconst wallRect=tile.allocWallPixels(circ/8,maxh/8);\r\n\t\t\t\tconst surface=pointcloud.walledSpiral(pts,3,0x8003,topo,wallRect);\r\n\t\t\t\treturn surface;\r\n\t\t\t}else{\r\n\t\t\t\tconst surface=pointcloud.spiral(pts,3,topo,20,1);\r\n\t\t\t\treturn surface;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\t// adds wallmap\r\n\r\n\t// builder.\r\n\tbuildTile(tile,c){\r\n\r\n\t\tconst build_hiway=true;\r\n\t\tconst build_path=true;\r\n\r\n\t\t// simon come here\r\n\r\n\t\tconst build_roof=false;\r\n\t\tconst build_roof2=false;\r\n\t\tconst build_roof_basement=true;\r\n\t\tconst build_roof_geom=false;\r\n\t\tconst build_walls_geom=false;//true;\r\n\r\n\t\tconst build_land=false;//true;\r\n\t\tconst build_coast=true;\r\n\r\n\t\tconst build_power=false;\r\n\r\n\t\tconst detail=false;//tile.level<3;\r\n\t\tconst hidetail=false;//tile.level<2;\r\n\r\n\t\tconst build_marine=false;\r\n\t\tconst build_runways=false;\r\n\t\tconst build_landfill=false;\r\n\t\tconst build_mine=false;\r\n\t\tconst build_rail=false;//true;\r\n\t\tconst build_transit=hidetail;\r\n\t\tconst build_parcels=hidetail;\r\n\r\n\t\tconst build_road=true;//\tdetail;\r\n\t\tconst build_rivers=detail;\r\n\t\tconst build_lakes=true;\r\n\t\tconst build_bush=false;\r\n\r\n\t\tlet surfaces=[];\r\n\r\n\t\tconst context=tile.scratch.getContext(\"2d\");\r\n\r\n\t\tconst resScale=AppPlatform.ScratchScale;\r\n\t\tcontext.scale(resScale,resScale);\r\n\r\n\t\tfor(const drawing of tile.drawings){\r\n\t\t\tconst outlines=drawing.outlines;\r\n\t\t\tconst rail=drawing.data[\"RAIL\"];\r\n\t\t\tconst transit=drawing.data[\"TRANSIT\"];\r\n\r\n\t\t\tconst parcels=drawing.data[\"PARCEL\"];\r\n\t\t\tconst roofs=drawing.data[\"ROOF\"];\r\n\t\t\tconst roads1=drawing.data[\"ROAD1\"];\r\n\t\t\tconst roads=drawing.data[\"ROAD\"];\r\n\t\t\tconst coasts=drawing.data[\"COAST\"];\r\n\t\t\tconst bridges=drawing.data[\"BRIDGE\"];\r\n\t\t\tconst tunnels=drawing.data[\"TUNNEL\"];\r\n\t\t\tconst pylons=drawing.data[\"PYLON\"];\r\n\t\t\tconst powerlines=drawing.data[\"POWER\"];\r\n\t\t\tconst golf=drawing.data[\"GOLF\"];\r\n\t\t\tconst ski=drawing.data[\"SKI\"];\r\n\t\t\tconst sport=drawing.data[\"SPORT\"];\r\n\t\t\tconst reserve=drawing.data[\"RESERVE\"];\r\n\t\t\tconst bathy=drawing.data[\"BATHY\"];\r\n\t\t\tconst runways=drawing.data[\"AIRPORT\"];\r\n\r\n\t\t\tconst rivers=drawing.data[\"RIVER\"];\r\n\t\t\tconst riverbeds=drawing.data[\"RIVERBED\"];\r\n\t\t\tconst lakes=drawing.data[\"LAKE\"];\r\n\r\n\t\t\tconst landfill=drawing.data[\"LANDFILL\"];\r\n\t\t\tconst mines=drawing.data[\"MINE\"];\r\n\r\n\t\t\tconst land=drawing.data[\"LAND\"];\r\n\t\t\tconst native=drawing.data[\"NATIVE\"];\r\n\r\n\t\t\t//\t\t\tconsole.log(\"bridges:\"+bridges.length);\r\n\r\n\r\n\r\n\r\n\t\t\tif(build_parcels&&parcels){\r\n\t\t\t\tcontext.globalAlpha=0.8; \r\n\t\t\t\tcontext.strokeStyle=\"black\";\r\n\t\t\t\tcontext.lineWidth=1.2;\r\n\t\t\t//\tcontext.lineCap=\"round\";\r\n\t\t\t\tfor(const lines of parcels){\r\n\t\t\t\t\tconst start=lines.start;\r\n\t\t\t\t\tconst count=lines.count;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\tconst n=outline.length;\r\n\t\t\t\t\t\tfor(let r=0;r<n;r++){\r\n\t\t\t\t\t\t\tconst v=outline[r];\r\n\t\t\t\t\t\t\tconst x=v[0]/2;\r\n\t\t\t\t\t\t\tconst y=v[1]/2;\r\n\t\t\t\t\t\t\tif(r==0){\r\n\t\t\t\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\t\t\t\tcontext.moveTo(x,y);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tcontext.lineTo(x,y);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcontext.stroke();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\r\n\t\t\t}\r\n\r\n\t\t\tif(build_roof&&roofs){\r\n\t\t\t\tcontext.globalAlpha=0.8; \r\n\t\t\t\tcontext.strokeStyle=\"grape\";\r\n\t\t\t\tcontext.lineWidth=2.2;\r\n\t\t\t//\tcontext.lineCap=\"round\";\r\n\t\t\t\tfor(const lines of roofs){\r\n\t\t\t\t\tconst start=lines.start;\r\n\t\t\t\t\tconst count=lines.count;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\tconst n=outline.length;\r\n\t\t\t\t\t\tfor(let r=0;r<n;r++){\r\n\t\t\t\t\t\t\tconst v=outline[r];\r\n\t\t\t\t\t\t\tconst x=v[0]/2;\r\n\t\t\t\t\t\t\tconst y=v[1]/2;\r\n\t\t\t\t\t\t\tif(r==0){\r\n\t\t\t\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\t\t\t\tcontext.moveTo(x,y);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tcontext.lineTo(x,y);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcontext.stroke();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\r\n\t\t\t}\r\n\r\n\t\t\t// grab center, \r\n\r\n\t\t\tif(build_lakes&&lakes){\r\n\t\t\t\tcontext.globalAlpha=0.88; \r\n\t\t\t\tcontext.strokeStyle=\"blue\";\r\n\t\t\t\tcontext.lineWidth=5.25;\r\n\t\t\t\tfor(const lines of lakes){\r\n\t\t\t\t\tdrawLakeLines(context,outlines,lines,\"lake\",tile);\r\n\t\t\t\t}\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\t\t\t}\r\n\r\n\t\t\tif(build_rivers&&rivers){\r\n\t\t\t\tcontext.globalAlpha=0.5; \r\n\t\t\t\tcontext.strokeStyle=\"indigo\";\r\n\t\t\t\tcontext.lineWidth=16.2;\r\n\t\t\t\tlet wasbits=0;\r\n\t\t\t//\tcontext.lineCap=\"round\";\r\n\t\t\t\tfor(const lines of rivers){\r\n\t\t\t\t\tconst start=lines.start;\r\n\t\t\t\t\tconst count=lines.count;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\tconst n=outline.length;\r\n\t\t\t\t\t\tfor(let r=0;r<n;r++){\r\n\t\t\t\t\t\t\tconst v=outline[r];\r\n\t\t\t\t\t\t\tconst x=v[0]/2;\r\n\t\t\t\t\t\t\tconst y=v[1]/2;\r\n\t\t\t\t\t\t\tconst bits=v[5];\r\n\t\t\t\t\t\t\tif(r==0){\r\n\t\t\t\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\t\t\t\tcontext.moveTo(x,y);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tif(bits){\r\n\t\t\t\t\t\t\t\t\tif(wasbits){\r\n\t\t\t\t\t\t\t\t\t\tcontext.moveTo(x,y);\r\n\t\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\t\tcontext.lineTo(x,y);\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\tcontext.lineTo(x,y);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\twasbits=bits;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcontext.stroke();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\t\t\t}\r\n\r\n\t\t\tif(build_bush&&native){\r\n\t\t\t\tcontext.globalAlpha=0.8; \r\n\t\t\t\tcontext.strokeStyle=\"white\";\r\n\t\t\t\tcontext.lineWidth=2.2;\r\n\t\t\t//\tcontext.lineCap=\"round\";\r\n\t\t\t\tfor(const lines of native){\r\n\t\t\t\t\tconst start=lines.start;\r\n\t\t\t\t\tconst count=lines.count;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\tconst n=outline.length;\r\n\t\t\t\t\t\tfor(let r=0;r<n;r++){\r\n\t\t\t\t\t\t\tconst v=outline[r];\r\n\t\t\t\t\t\t\tconst x=v[0]/2;\r\n\t\t\t\t\t\t\tconst y=v[1]/2;\r\n\t\t\t\t\t\t\tif(r==0){\r\n\t\t\t\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\t\t\t\tcontext.moveTo(x,y);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tcontext.lineTo(x,y);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tcontext.stroke();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcontext.globalAlpha=1.0; \r\n\t\t\t}\r\n\r\n\t\t\tif(build_transit){\r\n\t\t\t\tcontext.globalAlpha=0.5; \r\n\t\t\t\tcontext.strokeStyle=\"blue\";\r\n\t\t\t\tcontext.lineWidth=15;\r\n\t\t\t\tfor(const lines of transit){\r\n\t\t\t\t\tconst start=lines.start;\r\n\t\t\t\t\tconst count=lines.count;\r\n\t\t\t\t\tfor(let o=0;o<count;o++){\r\n\t\t\t\t\t\tconst outline=outlines[start+o];\r\n\t\t\t\t\t\tconst n=outline.length;\r\n\t\t\t\t\t\tfor(let r=0;r<n;r++){\r\n\t\t\t\t\t\t\tconst v=outline[r];\r\n\t\t\t\t\t\t\tconst x=v[0]/2;\r\n\t\t\t\t\t\t\tconst y=v[1]/2;\r\n\t\t\t\t\t\t\tif(r==0){\r\n\t\t\t\t\t\t\t\tcontext.beginPath();\r\n\t\t\t\t\t\t\t\tcontext.moveTo(x,y);\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tconst color=RainbowPalette[r&7];\r\n\t\t\t\t\t\t\t\tcontext.strokeStyle=color;\r\n\t\t\t\t\t\t\t\tcontext.lineTo(x,y);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\