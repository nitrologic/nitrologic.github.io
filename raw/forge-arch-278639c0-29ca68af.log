tlog('> Connected:' + device.gatt.connected);\r\n\t\t})\r\n\t\t.catch(error => {\r\n\t\t\tlog('Argh! ' + error);\r\n\t\t});\r\n\t}\r\n}\r\n\r\nfunction onRequestWebBluetooth(device){\r\n}\r\n\r\nfunction onRequestWebBluetoothError(e){\r\n\tlog(\"onRequestBluetoothError \"+e);\r\n}\r\n\r\nfunction requestWebBluetooth(){\r\n\tif(navigator.bluetooth){\r\n\t\tvar options={acceptAllDevices:true};\r\n// var options={filters: [ {services: [A, B]} ]};\r\n\t\tnavigator.bluetooth.requestDevice(options).then(onRequestWebBluetooth).catch(onRequestWebBluetoothError);\r\n\t}\r\n}\r\n\r\nfunction initNavigator(){\r\n\tnavigatorDiv=document.getElementById(\"navigator\");\r\n\tif(!navigatorDiv) return false;\r\n\taddTitle(navigatorDiv,\"Navigator\");\r\n\r\n\tserialTools=addToolbar(navigatorDiv);\r\n\tSerialPorts=[];\r\n\taddTool(serialTools,\"Request Port\",\"port.request\",requestSerialPort);\r\n\taddTool(serialTools,\"Connect Bluetooth\",\"bluetooth.connect\",requestBluetooth);\r\n\tserialPorts=addSelect(serialTools,\"ports\");\r\n\tserialConnect=addTool(serialTools,\"Connect\",\"port.connect\",connectSerialPort);\r\n\tserialDisconnect=addTool(serialTools,\"Disconnect\",\"port.disconnect\",disconnectSerialPort);\r\n\r\n\tserialSendText=addTextInput(serialTools,\"Send\",sendSerial);\r\n\r\n\taudioTools=addToolbar(navigatorDiv);\r\n\taudioCanvas=new DSPNavigatorCanvas(audioTools,\"audio\");\r\n\taddTool(audioTools,\"Enumerate\",\"audio.enumerate\",enumerateMediaDevices);\r\n\taudioOuts=addSelect(audioTools,\"outs\");\r\n\taddTool(audioTools,\"Play\",\"audio.play\",playAudio);\r\n\taudioIns=addSelect(audioTools,\"ins\");\r\n\t//\taudioPlayer=addAudio(audioTools,\"Player1\",\"sinA440.wav\");\r\n\taudioPlayer=addAudio(audioTools,\"Audio Player\",\"nitrojs/wav/sinA440.wav\");\r\n\taddTool(audioTools,\"Monitor\",\"audio.monitor\",monitorAudio);\r\n\tvideoSources=addSelect(audioTools,\"videosources\");\r\n\taddTool(audioTools,\"Stream\",\"media.stream\",streamMedia);\r\n\r\n\tenumerateSerialPorts();\r\n\r\n//\tenumerateMediaDevices();\r\n\treturn true;\r\n}\r\n\r\nclass DSPNavigatorCanvas{\r\n\tdrawAnimation(node,ms){\r\n\t\tvar canvas=this.canvas;\r\n\t\tvar context=this.context;\r\n\t\tvar w=canvas.clientWidth;\r\n\t\tvar h=canvas.clientHeight;\r\n\t\tif(w!=canvas.width||h!=canvas.height){\r\n\t\t\tcanvas.width=w;\r\n\t\t\tcanvas.height=h;\r\n\t\t}\r\n\t\tcontext.fillStyle=\"rgba(20,200,200,0.33)\";\r\n\t\tvar fragment=this.readFragment;\r\n\t\tvar scopeX=this.scopeX;\r\n\t\tvar length=node.leftFragments.length;\r\n\t\twhile(fragment<length){\r\n\t\t\tvar left=node.leftFragments[fragment];\r\n\t\t\tvar right=node.rightFragments[fragment];\r\n\t\t\tvar n=left.length;\r\n\t\t\tfor(var i=0;i<n;i++){\r\n\t\t\t\tvar sample=left[i];\r\n\t\t\t\tvar sample=right[i];\r\n\t\t\t\tvar x=(scopeX*0.1)%w;\r\n\t\t\t\tscopeX++;\r\n\t\t\t\tvar y=h*((sample+1.0)/2.0);\r\n\t\t\t\tvar iix=((x|0)+2)%w;\r\n\t\t\t\tif(iix!=this.currentX){\r\n\t\t\t\t\tthis.currentX=iix;\r\n\t\t\t\t\tcontext.clearRect(iix,0,1,h);\r\n\t\t\t\t}\r\n\t\t\t\tcontext.fillRect(x,y,1,1);\r\n\t\t\t}\r\n\t\t\tfragment++;\r\n\t\t}\r\n\t\tthis.readFragment=fragment;\r\n\t\tthis.scopeX=scopeX;\r\n\t}\r\n\r\n\tconstructor(group,classname){\r\n\t\tthis.scopeX=0.0;\r\n\t\tthis.canvas=document.createElement(\"canvas\");\r\n\t\tthis.canvas.className=classname;\r\n\t\tthis.context=this.canvas.getContext(\"2d\",{antialias:true,depth:false});\r\n//\t\tthis.canvas.onresize=resizeCanvas;\r\n//\t\tthis.canvas.onresize=this.resize.bind(this);\r\n\t\tgroup.appendChild(this.canvas);\r\n\t\tthis.readFragment=0;\r\n\t}\r\n}\r\n\r\nfunction audioAnimation(timestamp){\r\n\tif (audioAnimationTime === undefined) audioAnimationTime = timestamp;\r\n\tconst elapsed = timestamp - audioAnimationTime;\r\n\tif(audioNode){\r\n//\t\tconsole.log(\"buffered:\"+audioNode.reads);\r\n\t\taudioCanvas.drawAnimation(audioNode,elapsed);\r\n\t}\r\n\twindow.requestAnimationFrame(audioAnimation);\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dsp_spectrum.js\",\"length\":3678,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dsp_spectrum.js\r\n// (c)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n// name:NitroSpectrumProcessor\r\n// type:AudioWorkletProcessor\r\n\r\n// emits \"pcm\" and \"fft\"\r\n// work in progress - this code aims to validate picofft.h fixed point implementation\r\n\r\nclass FixedComplex{\r\n\tconstructor(){\r\n\t\tthis.x=0.0;\r\n\t\tthis.y=0.0;\r\n\t}\r\n\r\n\tsetFloat(x,y){\r\n\t\tthis.x=0x4000*x;\r\n\t\tthis.y=0x4000*y;\r\n\t}\r\n\r\n\tsetFixed(x,y){\r\n\t\tthis.x=x;\r\n\t\tthis.y=y;\r\n\t}\r\n\r\n\tmagnitude(){\r\n\t\tvar xxyy=(this.x*this.x+this.y*this.y)/0x4000;\r\n\t\treturn Math.sqrt(xxyy/0x4000);\r\n\t}\r\n\r\n\tstatic multiply(a,b,c){\r\n\t\tc.x=(a.x*b.x-a.y*b.y)/0x4000;\r\n\t\tc.y=(a.x*b.y+a.y*b.x)/0x4000;\r\n\t}\r\n}\r\n\r\nclass FFT{\r\n\r\n\tstatic reverseBits(value,bits){\r\n\t\tvar result=0;\r\n\t\twhile(bits--){\r\n\t\t\tresult<<=1;\r\n\t\t\tresult|=value&1;\r\n\t\t\tvalue>>=1;\r\n\t\t}\r\n\t\treturn result;\r\n\t}\r\n\r\n\tconstructor(bits){\r\n\t\tvar n=1<<bits;\r\n\t\tthis.points=new Float32Array(n);\r\n\t\tthis.buffer=new Array(n);\r\n\t\tthis.reverseLup=new Array(n);\r\n\t\tthis.rotationLup=new Array(n);\r\n\t\tfor(var i=0;i<n;i++){\r\n\t\t\tthis.reverseLup[i]=FFT.reverseBits(i,bits);\r\n\t\t\tthis.buffer[i]=new FixedComplex();\r\n\t\t\tvar r=new FixedComplex();\r\n\t\t\tvar rad=i*2*Math.PI/n;\r\n\t\t\tr.setFloat(Math.cos(rad),Math.sin(rad));\r\n\t\t\tthis.rotationLup[i]=r\t\t\t\r\n\t\t}\r\n\t}\r\n\r\n\t// float => float pcm to frequency domain \r\n\r\n\treadPoints(pcm){\r\n\t\tvar n=this.buffer.length;\r\n\t\tvar nn=pcm.length;\t\t\r\n\t\tif(nn<n){\r\n\t\t\tthis.points.copyWithin(0,nn,n);\r\n\t\t}\r\n\t\tthis.points.set(pcm,n-nn);\r\n\t}\r\n\r\n\tspectrum(){\r\n\t\tvar buffer=this.buffer;\r\n\t\tvar n=this.buffer.length;\r\n\t\tvar result=new Float64Array(n);\r\n\t\tfor(var i=0;i<n;i++){\r\n\t\t\tbuffer[i].setFloat(this.points[this.reverseLup[i]],0);\r\n\t\t}\r\n\t\tvar twiddle=new FixedComplex(0,0);\r\n\t\tfor(var i=2;i<=n;i*=2){\r\n\t\t\tvar i2=(i/2)|0;\r\n\t\t\tvar wstep=(n/i)|0;\r\n\t\t\tfor(var j=0;j<n;j+=i){\r\n\t\t\t\tfor(var k=0;k<i2;k++){\r\n\t\t\t\t\tvar evenx=buffer[j+k].x;\r\n\t\t\t\t\tvar eveny=buffer[j+k].y;\r\n\t\t\t\t\tFixedComplex.multiply(buffer[j+k+i2],this.rotationLup[wstep*k],twiddle);\r\n\t\t\t\t\tbuffer[j+k].setFixed(evenx+twiddle.x,eveny+twiddle.y);\r\n\t\t\t\t\tbuffer[j+k+i2].setFixed(evenx-twiddle.x,eveny-twiddle.y);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(var i=0;i<n;i++){\r\n\t\t\tresult[i]=buffer[i].magnitude();\r\n\t\t}\r\n\t\treturn result;\r\n\t}\r\n}\r\n\r\nclass NitroSpectrumProcessor extends AudioWorkletProcessor {\r\n\tconstructor(options) {\t\t\r\n\t\tsuper();\r\n\t\tthis.rate=options.processorOptions.rate;\r\n\t\tthis.leftFFT=new FFT(11);\r\n\t\tthis.rightFFT=new FFT(11);\r\n\t\tthis.messageCount=0;\r\n\t}\r\n\r\n\tspectrum(){\r\n\t\tvar leftSpectrum=this.leftFFT.spectrum();\r\n\t\tvar rightSpectrum=this.rightFFT.spectrum();\r\n\t\tthis.port.postMessage({name:\"fft\",leftSpectrum,rightSpectrum},[\r\n\t\t\tleftSpectrum.buffer,rightSpectrum.buffer\r\n\t\t]);\r\n//\t\tthis.port.postMessage({name:\"fft\",leftSpectrum,rightSpectrum});\r\n//\t\tthis.port.postMessage({name:\"fft\"},[leftSpectrum,rightSpectrum]);\r\n\t}\r\n\r\n\tprocess(inputs, outputs, parameters) {\r\n\t\tif(inputs && inputs.length==1){\r\n\t\t\tvar in0=inputs[0];\r\n\t\t\tvar channels=in0.length;\r\n\t\t\t\r\n\t\t\tif(channels==2){\r\n\t\t\t\tvar left=in0[0];\r\n\t\t\t\tvar right=in0[1];\r\n\t\t\t\tvar n=left.length;\r\n\t\t\t\tthis.writes+=n;\r\n\t\t\t\tthis.leftFFT.readPoints(left);\r\n\t\t\t\tthis.rightFFT.readPoints(right);\r\n\r\n\t\t\t\tif(left.length==right.length){\r\n\t\t\t\t\tlet n=left.length;\r\n\t\t\t\t\tvar mem16=new Int16Array(n*2);\r\n\t\t\t\t\tlet gain16=16383;//32767;\r\n\t\t\t\t\tfor(let i=0;i<n;i++)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tmem16[i*2+0]=left[i]*gain16;\r\n\t\t\t\t\t\tmem16[i*2+1]=right[i]*gain16;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tvar count=++this.messageCount;\r\n\t\t\t\t\tvar rate=this.rate;\r\n\t\t\t\t\tthis.port.postMessage({name:\"pcm\",mem16,count,rate},[mem16.buffer]);\r\n\t\t\t\t\t//\r\n\t\t\t\t\tif((this.messageCount&3)==0){\r\n\t\t\t\t\t\tthis.spectrum();\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn true;\r\n\t}\r\n}\r\n\r\nregisterProcessor('NitroSpectrumProcessor', NitroSpectrumProcessor);\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspvideo.js\",\"length\":8258,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspvideo\r\n// (C)2024 nitrologic\r\n// ALL RIGHTS RESERVED\r\n\r\n// play paused live recording\r\n\r\n\"use strict\"\r\n\r\nconst LogData=false;\r\n\r\nvar videoStreamTool;\r\n\r\nvar videoFlags;\r\nvar videoFacing;\r\nvar videoDiv;\r\nvar videoTools;\r\nvar videoInSelect;\r\nvar videoContext;\t// this is an audio context?\r\nvar VideoStreams=[];\r\nvar videoAnimationId;\r\nvar videoAnimationTime;\r\n\r\nvar audioSource,audioNode,scriptNode,workletNode,microphone;\r\n\r\nvar videoStreamer;\r\n\r\n class VideoStream{\r\n\tconstructor(stream){\r\n\t\tthis.stream=stream;\r\n\t\tstream.onaddtrack=this.addTrack.bind(this);\r\n\t\tthis.tracks=stream.getTracks();\r\n//\t\tReturns a list of all MediaStreamTrack objects stored in the MediaStream object, regardless of the value of the kind attribute. The order is not defined, and may not only vary from one browser to another, but also from one call to another.\r\n\t\tthis.videos=stream.getVideoTracks();\r\n\t\tfor(var vid of this.videos){\r\n\t\t\tthis.addVideoTrack(vid);\r\n\t\t}\r\n\t}\r\n\taddTrack(track){\r\n\t\tlog(\"AddTrack:\");\r\n\t}\r\n\taddVideoTrack(vid){\r\n\t\tlog(\"vid : \"+vid.label);\r\n\t\ttry{\r\n\t\t\tvar imageCapture = new ImageCapture(vid);\r\n\t\t\tvar capturecaps=imageCapture.getPhotoCapabilities().then(function(photocaps){\r\n\t\t\t\tlog(\"capture caps:\"+JSON.stringify(capturecaps));\r\n\t\t\t\tlog(\"photo caps:\"+JSON.stringify(photocaps));\r\n\t\t\t});\r\n\t\t}catch(exception){\r\n\t\t\tlog(\"videostream error : \"+exception);\r\n\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction videoGranted(stream) {\r\n\tif(!videoAnimationId){\r\n\t\tvideoAnimationId=window.requestAnimationFrame(videoAnimation);\r\n\t}\r\n\tvar videoStream=new VideoStream(stream);\r\n\tVideoStreams.push(videoStream);\r\n    videoContext.audioWorklet.addModule('dspjs/dspnoise.js').then(function(){\r\n\r\n\t\tclass AudioNode extends AudioWorkletNode {\r\n\r\n\t\t\tonDSPMessage(e){\r\n\t\t//\t\tconsole.log(\"onDSPMessage:\");\r\n\t\t\t\tthis.leftFragments.push(e.data.left);\r\n\t\t\t\tthis.rightFragments.push(e.data.right);\r\n\t\t\t\tthis.reads+=e.data.left.length+e.data.right.length;\r\n\t\t\t\tvar count=e.data.count;\r\n\t\t//\t\tconsole.log(count);\r\n\t\t\t}\r\n\t\t\r\n\t\t\tconstructor(context) {\r\n\t\t\t\tsuper(context,'NitroNoiseProcessor');\r\n\t\t\t\tthis.leftFragments=[];\r\n\t\t\t\tthis.rightFragments=[];\r\n\t\t\t\tthis.reads=0;\r\n\t\t\t\tthis.port.onmessage=this.onDSPMessage.bind(this);\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\taudioSource=videoContext.createMediaStreamSource(stream);\r\n\t\taudioNode=new AudioNode(videoContext);\r\n\t\taudioSource.connect(audioNode)\r\n\t\taudioNode.connect(videoContext.destination);\r\n\t});\r\n}\r\n\r\nfunction videoDenied(e) {\r\n\tlog('dspvideo videoDenied:'+e.message);\r\n}\r\n\r\nconst videoFlagNames=[\"echo cancellation\",\"auto gain\",\"noise supression\"];\r\n\r\n//  prompt the user for permission to use media input to stream video\r\n\r\nfunction stopVideo(){\r\n\tvideoStreamTool.removeAttribute(\"on\");\r\n\tvideoStreamer.stopTracks();\r\n\tconst vid=videoStreamer.element;\r\n\tvid.remove();\r\n\tvideoStreamer=null;\r\n}\r\n\r\n// facing - true = user facing chat camera, false = best quality environment camera\r\nfunction streamVideo(){\r\n\tconst facing=videoFacing.checked;\r\n\tif(videoStreamTool.hasAttribute(\"on\")){\r\n\t\tstopVideo();\r\n\t\treturn;\r\n\t}\r\n\tvideoStreamTool.setAttribute(\"on\",\"\")\r\n\taddVideoStream();\r\n\tvar info=vidInfo[videoInSelect.value];\r\n\tconst caps=info.getCapabilities();\r\n\tconst jcaps=JSON.stringify(caps,null,\"\\t\");\r\n\tlog('[streamVideo] caps:'+jcaps);\r\n\tconst userFacing={exact: \"user\"};\r\n\tconst environmentFacing={exact:\"environment\"};\r\n\tvar constraints={ \t\t\r\n\t\tvideo: {\r\n//\t\t\tgroupId:info.groupId,\r\n\t\t\tdeviceId:{exact:info.deviceId},\r\n\t\t\tfacingMode:facing?userFacing:environmentFacing\r\n\t\t},\r\n\t\taudio: {\r\n\t\t\techoCancellation: true,\r\n\t\t\tautoGainControl: false,\r\n\t\t\tnoiseSuppression: false\r\n\t\t}\t\t\r\n\t}\r\n\tnavigator.mediaDevices\r\n\t.getUserMedia(constraints)\r\n\t.then((stream) => {\r\n\t\tvideoGranted(stream);\r\n\t})\r\n\t.catch((err) => {\r\n\t\tvideoDenied(err);\r\n\t});\r\n}\r\n\r\n//  prompt the user for permission to use media input to monitor audio\r\n\r\nlet vidInfo=[];\r\n\r\nfunction onEnumerateVideo(infos) {\r\n\tvideoInSelect.innerHTML=\"\";\r\n\tvar vidCount=0;\r\n\tvidInfo=[];\r\n\tfor (var i=0; i !== infos.length; ++i) {\r\n\t\tvar info=infos[i];\r\n//\t\tvar json=JSON.stringify(info);\r\n//\t\tlog(\"onEnumerateVideo \"+json);\r\n\t\tvar label=info.label||\"default\";\r\n\t\tvar attributes=label.startsWith(\"Default\")?{selected:\"\"}:{};\r\n\t\tswitch(info.kind){\r\n\t\t\tcase \"videoinput\":\r\n\t\t\t\tconst id=vidCount++;\r\n\t\t\t\tvidInfo[id]=info;\r\n\t\t\t\t// with windows lifecam these guys are blank\r\n\t\t\t\t//var devinfo=[info.groupId||\"default\",info.deviceId||\"default\"];\r\n\t\t\t\taddOption(videoInSelect,id,label,attributes);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction onEnumerateVideoError(error){\r\n\tlog(\"onEnumerateVideoError:\"+error);\r\n}\r\n\r\nfunction enumerateVideo(){\r\n\tvideoContext=new AudioContext();\r\n\tif(navigator.mediaDevices){\r\n\t\tnavigator.mediaDevices.enumerateDevices().then(onEnumerateVideo).catch(onEnumerateVideoError);\r\n\t}else{\r\n\t\tconsole.log(\"navigator.mediaDevices not found\")\r\n\t}\r\n}\r\n\r\nclass VideoStreamer{\r\n\tconstructor(){\r\n\t\tthis.recorders=[];\r\n\t\tthis.streams=[];\r\n\t\tthis.mediaStreams=[];\r\n\t\tthis.mediaTracks=[];\t\r\n\t\tthis.element=null;\r\n\t\tthis.dataType='';\r\n\t}\r\n\r\n\tstopTracks(){\r\n\t\tfor(var stream of this.mediaStreams){\r\n\t\t\tvar tracks = stream.getTracks();\r\n\t\t\tfor(var track of tracks){\r\n\t\t\t\ttrack.stop();\r\n\t\t\t}\r\n\t\t}\t\r\n\t}\r\n\r\n\taddMediaStream(stream){\r\n\t\tthis.mediaStreams.push(stream);\r\n\t}\r\n\r\n\trecordStreams(options){\r\n\t\tfor(var stream of this.mediaStreams){\r\n\t\t\tthis.recordStream(stream,options);\r\n\t\t}\r\n\r\n\t}\r\n\r\n\t// set camera live and camera recording states in gui\r\n\r\n\taddCamera(vid){\r\n\t\tthis.element=vid;\r\n\t\tthis.dataType='data:video/webm;';\r\n\t\tvar self=this;\r\n\t\tnavigator.mediaDevices.getUserMedia({audio:true,video:true}).then(\r\n\t\t\tstream=>{\r\n\t\t\t\tvid.srcObject=stream;\r\n\t\t\t\tconsole.log('video streaming',stream);\r\n\t\t\t\tself.addMediaStream(stream);\r\n\t\t\t},\r\n\t\t\terror=>{\r\n\t\t\t\tconsole.log(\"video stream error\",error);\r\n\t\t\t});\r\n\t\tvid.addEventListener(\"play\",()=>{\t\t\t\r\n\t\t\tvar options={mimeType: 'video/webm;codecs=vp9'};\r\n//\t\t\tself.recordStreams(options)\r\n\t\t});\r\n\t\tvid.addEventListener(\"pause\",()=>{\r\n\t\t\tconsole.log(\"pause\");\r\n\t\t\tfor(var r of self.recorders){\r\n\t\t\t\tr.stop();\r\n\t\t\t}\r\n\t\t\tself.recorders=[];\r\n\t\t});\r\n\t}\r\n\r\n\trecordStream(stream,options){\r\n\t\tvar tracks=document.createElement('div');\r\n\t\ttracks.setAttribute(\"track\",\"\");\r\n\r\n\t\tvar overlay=document.createElement('canvas');\r\n\t\toverlay.setAttribute(\"overlay\",\"\");\r\n\t\ttracks.appendChild(overlay);\r\n\r\n\t\tthis.tracks=tracks;\r\n\t\tthis.element.parentElement.appendChild(tracks)\r\n\r\n\t\tvar r=new MediaRecorder(stream,options);\r\n\t\tvar self=this;\r\n\t\tr.ondataavailable = function(){\r\n\t\t\tself.onRead();\r\n\t\t};\r\n\t\tr.start();\r\n\t\tthis.recorders.push(r);\r\n\t}\r\n\r\n\tonRead(){\r\n\t\tif(event.type=='dataavailable'){\r\n\t\t\tvar recorder=event.target;\r\n\t\t\tvar blob=event.data;\r\n\t\t\tconsole.log(\"dataavailable blob:\",blob.size,blob.type);\r\n\t\t\tvar reader=new FileReader();\r\n\t\t\treader.readAsBinaryString(blob);\r\n\t\t\treader.onprogress\r\n\t\t\treader.onload=function(){\r\n\t\t\t\tvar result=event.target.result;\r\n\t\t\t\tvar mime64=btoa(result);\r\n\t\t\t\tif(LogData){\r\n\t\t\t\t\tconsole.log('load data',mime64);\r\n\t\t\t\t}\r\n\t\t\t\tvar src=this.dataType+'base64,'+mime64;\r\n\t\t\t\tvar tag=(this.dataType=='data:audio/webm;')?'audio':'video';\r\n\t\t\t\tvar media=document.createElement(tag);\r\n\t\t\t\tmedia.setAttribute('controls','');\r\n\t\t\t\tmedia.setAttribute('clip','');\r\n\t\t\t\tmedia.src=src;\r\n\t\t\t\tthis.tracks.appendChild(media);\r\n\t\t\t}.bind(this);\r\n\t\t}\r\n\t}\t\r\n}\r\n\r\nfunction initVideo(){\r\n\tvideoDiv=document.getElementById(\"video\");\r\n\tif(!videoDiv) return false;\r\n\taddTitle(videoDiv,\"Video\");\r\n\tvideoTools=addToolbar(videoDiv);\r\n\taddTool(videoTools,\"Media Devices\",\"audio.enumerate\",enumerateVideo);\r\n\tvideoInSelect=addSelect(videoTools,\"videoinselect\");\r\n\tvideoFlags=addFlags(videoTools,\"video flags\",videoFlagNames);\t\r\n\tvideoFacing=addToggle(videoTools,\"Front\");\r\n\tvideoStreamTool=addTool(videoTools,\"Stream\",\"video.stream\",streamVideo);\r\n//\tenumerateVideo();\r\n\treturn true;\r\n}\r\n\r\nfunction addVideoStream(){\r\n\tvar vid=addVideo(videoDiv,\"Video\")\r\n\tvideoStreamer=new VideoStreamer();\r\n\tvideoStreamer.addCamera(vid)\r\n\treturn vid;\r\n}\r\n\r\nfunction videoAnimation(timestamp){\r\n\tif (videoAnimationTime === undefined) videoAnimationTime = timestamp;\r\n\tconst elapsed = timestamp - videoAnimationTime;\r\n\tif(audioNode){\r\n//\t\tconsole.log(\"buffered:\"+audioNode.reads);\r\n//\t\taudioCanvas.drawAnimation(audioNode,elapsed);\r\n\t}\r\n\twindow.requestAnimationFrame(videoAnimation);\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspcontrollers.js\",\"length\":5286,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// dspcontrollers.js\r\n// (c)2024 nitrologic\r\n// All rights reserved\r\n\r\n\"use strict\"\r\n\r\nconst GamepadFieldNames=[\"Index\",\"Description\",\"Reads\",\"Writes\",\"Action\"];\r\n\r\nconst AxisEpsilon=0.05;\r\n\r\nconst _GamePads={};\r\n\r\nconst RawUpdateDelay=5;\r\n\r\nvar SecureControllers=false;\r\n\r\n// controller events are src \"hid\"\r\n\r\nfunction PostHIDEvent(data,ts){\r\n//\tconsole.log(\"[dspcontroller.PostGamepadEvent] \"+JSON.stringify(data));\r\n\tvar message={src:\"hid\",data:data,timeStamp:ts};\r\n\tLocalEventQueueMessage(message);\r\n}\r\n\r\nfunction gamepadConnect(e){\r\n\tconst pad=e.gamepad;\r\n\tif(pad){\r\n\t\tvar name = \"gamepad\"+pad.index;\r\n\t\tvar gamepad = addGamepad(pad,name);\r\n\t\t_GamePads[pad.index]=gamepad;\r\n\t\tconsole.log(\"gamepadConnect : \",pad)\r\n\t\tconst haptic=gamepad.actuator;\r\n\t\tvar ts=(e.timeStamp*10)|0;\r\n\t\tPostHIDEvent({event:\"connect\",type:\"gamepad\",index:pad.index,haptic},ts);\r\n\t\tSecureControllers=true;\r\n\t}\r\n}\r\n\r\nfunction gamepadDisconnect(){\r\n\tconst pad=event.gamepad;\r\n\tdelete _GamePads[pad.index];\t\r\n}\r\n\r\nfunction PollControllers(millis){\r\n\tif(!SecureControllers) return;\r\n\tconst pads=navigator.getGamepads();\r\n\tfor(const index in _GamePads){\r\n\t\tconst mods=[];\r\n\t\tconst pad=_GamePads[index];\r\n\t\tpad.pollPad(pads,millis,mods);\r\n\t\tvar ts=(pad.timestamp*10)|0;\r\n\t\tif(mods.length){\r\n\t\t\tif(pad.trace) console.log(\"controller mods = \"+mods.length);\r\n\t\t\tupdateGamepadStats(index);\r\n\t\t\tPostHIDEvent({event:\"modify\",type:\"gamepad\",index:pad.index,mods},ts);\r\n\r\n\t\t}\r\n\t\tif(pad.dirty){\r\n\t\t\tupdateGamepadStats(index);\r\n\t\t\tpad.dirty=false;\r\n\t\t}\r\n\t}\r\n\r\n\r\n}\r\n\r\nconst StandardGampadAxis={0:\"turn\",1:\"forward\",2:\"y\",3:\"x\"}\r\n\r\nclass Controller{\r\n\tconstructor(pad){\r\n\t\tthis.trace=false;\r\n\t\tthis.index=pad.index;\r\n\t\tthis.pressed=new Array(pad.buttons.length);\r\n\t\tthis.deltas=new Array(pad.axes.length);\r\n\t\tthis.values=new Array(pad.axes.length);\r\n\t\tthis.modified=new Array(pad.axes.length);\r\n\t\tthis.reads=0;\r\n\t\tthis.writes=0;\r\n\t\tthis.dirty=true;\r\n\t\tthis.actuator=pad.vibrationActuator;\r\n\t\tthis.effects=(this.actuator&&this.actuator.effects)?this.actuator.effects:[];\r\n\t\tthis.timestamp=pad.timestamp;\r\n\t\tthis.effect=0;\r\n\t\tswitch(pad.mapping){\r\n\t\t\tcase \"standard\":\r\n\t\t\t\tthis.axisMap=StandardGampadAxis;\r\n\t\t}\r\n\t}\r\n\r\n\tplayRumble(index,duration,weak,strong){\r\n\t\tif(this.actuator){\r\n\t\t\tvar rumble = this.effects[index] || \"dual-rumble\";\r\n\t\t\tconst args={startDelay:0,duration:duration,weakMagnitude:weak,strongMagnitude:strong};\r\n\t\t\tthis.actuator.playEffect(rumble,args);\r\n\t\t\tthis.writes++;\r\n\t\t\tthis.dirty=true;\r\n\t\t}\r\n\t}\r\n\r\n\tonGui(id){\r\n\t\tvar from=event.target.id.split(\" \");\r\n\r\n\t\tswitch(from[0]){\r\n\t\t\tcase \"trace\":\r\n\t\t\t\tthis.trace=!this.trace;\r\n\t\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tconsole.log(\"onGui id = \"+id+\" event :\"+event.type);\r\n\t\tvar rumble=document.getElementById(\"rumble \"+id);\r\n\t\tvar effect=rumble.selectedOptions[0];\t\t\r\n\t\tvar min=document.getElementById(\"min \"+id);\r\n\t\tvar max=document.getElementById(\"max \"+id);\r\n\t\tthis.playRumble(effect.value,1,min.value/100,max.value/100);\r\n\t}\r\n\r\n\tpollPad(pads,millis,mods){\r\n\t\tconst index=this.index;\r\n\t\tconst pad=pads[index];\r\n\t\tif(pad.timestamp==this.timestamp){\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tthis.timestamp=pad.timestamp;\r\n\t\tconst buttons=pad.buttons;\r\n\t\tconst axes=pad.axes;\r\n\t\tfor(let i=0;i<buttons.length;i++){\r\n\t\t\tconst value=buttons[i].value;\r\n\t\t\tif(value!=this.pressed[i]){\r\n\t\t\t\tthis.pressed[i]=value;\r\n\t\t\t\tmods.push([index,0,i,value]);\r\n//\t\t\t\tthis.playRumble(30,0.77,0.88);\r\n\t\t\t}\r\n\t\t}\r\n\t\tfor(let i=0;i<axes.length;i++){\r\n\t\t\tlet value=axes[i];\r\n\t\t\tif(value*value<AxisEpsilon) value=0;\r\n\t\t\tlet delta=value-(this.values[i]||0);\r\n\t\t\tif(delta*delta>AxisEpsilon){\r\n\t\t\t\tthis.values[i]=value;\r\n\t\t\t\tmods.push([index,1,i,value]);\r\n\t\t\t\tthis.modified[i]=millis;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.reads+=mods.length;\r\n\t\tthis.dirty=true;\r\n\t}\r\n}\r\n\r\nfunction UpdateControllers(){\r\n\tvar millis = performance.now();\t\r\n\t//new Date().getMilliseconds();\r\n\tWatchDog.push(millis);\r\n\tPollControllers(millis);\r\n//\tpollMidi();\r\n//\tpollControls();\r\n//\twindow.setTimeout(UpdateControllers,RawUpdatePeriod);\r\n}\r\n\r\nvar gamepadDiv,gamepadTools,gamepadTable;\r\nvar gamepadDevices=[];\r\nvar gamepadRows=[];\r\n\r\nfunction updateGamepadStats(id)\r\n{\tvar controller=gamepadDevices[id];\r\n\tvar row=gamepadRows[id];\r\n\tsetRowValue(row,3,controller.reads);\r\n\tsetRowValue(row,4,controller.writes);\r\n}\r\n\r\nfunction addGamepad(pad,name){\r\n\tvar id = pad.index;\r\n\tvar row=addRow(gamepadTable,[name,\"\",\"\",\"\",\"\"]);\r\n\trow.setAttribute(\"gamepad\",id);\r\n\tvar gamepad=new Controller(pad);\r\n\tgamepadDevices[id]=gamepad;\r\n\tgamepadRows[id]=row;\r\n\tvar padname = pad.id.split(\" (\")[0];\r\n\tsetRowValue(row,2,padname);\r\n\tvar padgui=\"trace.button=trace:rumble.select=\"+gamepad.effects.join(\",\")+\":min.slider=0.5:max.slider=0.8\";\r\n\tvar span=getRowSpan(row,5);\r\n\tspan.id=id;\r\n\tvar bind=gamepad.onGui.bind(gamepad,id);\r\n\tsetRowGui(span,padgui,bind);\r\n\treturn gamepad;\r\n}\r\n\r\nfunction InitControllers(){\r\n\tgamepadDiv=document.getElementById(\"gamepad\");\r\n\tif(!gamepadDiv) return;\r\n\taddTitle(gamepadDiv,\"Controller\");\t\r\n\tgamepadTools=addToolbar(gamepadDiv);\r\n\taddLabel(gamepadTools,\"Press A to Detect\");\r\n\tgamepadTable=addTable(gamepadTools,GamepadFieldNames);\r\n\tself.window.addEventListener(\"gamepadconnected\",gamepadConnect);\r\n\tself.window.addEventListener(\"gamepaddisconnected\",gamepadDisconnect);\r\n//\tUpdateControllers();\r\n\tsetInterval(UpdateControllers,RawUpdateDelay);\r\n}\r\n\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/dspjs/dspnoise.js\",\"length\":1164,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrojs dspnoise \r\n// (C)2024 nitrologic\r\n// ALL RIGHTS RESERVED\r\n\r\n// NitroNoiseProcessor - emits \"noise\" when parameters beep\r\n\r\nclass NitroNoiseProcessor extends AudioWorkletProcessor {\r\n\tconstructor() {\t\t\r\n\t\tsuper();\r\n\t\tthis.reads=0;\r\n\t\tthis.writes=0;\r\n\t\tthis.outs=0;\r\n\t\tthis.count=0;\r\n\t}\r\n\r\n\tprocess(inputs, outputs, parameters) {\r\n\t\tif(inputs && inputs.length>0){\r\n\t\t\tvar in0=inputs[0];\r\n\t\t\tvar channels=in0.length;\r\n\t\t\tif(channels==2){\r\n\t\t\t\tvar name=\"noise\";\r\n\t\t\t\tvar left=in0[0];\r\n\t\t\t\tvar right=in0[1];\r\n\t\t\t\tvar n=left.length;\r\n\t\t\t\tthis.writes+=n;\r\n\t\t\t\tthis.port.postMessage({name,left,right,count:this.count++});\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(outputs && outputs.length>0 && parameters.beep){\r\n\t\t\tvar out0=outputs[0];\r\n\t\t\tvar channels=out0.length;\r\n\t\t\tif(channels==2){\r\n\t\t\t\tvar left=out0[0];\r\n\t\t\t\tvar right=out0[1];\r\n\t\t\t\tvar n=left.length;\r\n\t\t\t\tfor(var i=0;i<n;i++){\r\n                    var rnd=(Math.random()-0.5)*0.25;\r\n\t\t\t\t\tvar saw=(1.0-(osc%2.0));\r\n\t\t\t\t\tvar sin=Math.sin(osc*22);\r\n                    left[i]=rnd;\r\n\t\t\t\t\tright[i]=rnd;\r\n\t\t\t\t}\r\n\t\t\t\tthis.outs+=n;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn true;\r\n\t}\r\n}\r\n\r\nregisterProcessor('NitroNoiseProcessor', NitroNoiseProcessor);\r\n","name":"content"},{"role":"user","content":"Files shared. Feel free to comment if content is new or different.","name":"friend"}]}
