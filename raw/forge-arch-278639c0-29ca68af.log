28cabfeb [claude-sonnet-5] #Cache Purging Options with BunnyCDN for JS Files
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #BunnyCDN offers several ways to selectively purge cached JS files without flushing your entire
28cabfeb [claude-sonnet-5] #cache. Here are your main options:
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #1. Purge Single URL (Most Targeted)
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #Best for flushing one specific file after a deploy.
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #• Via Dashboard:*
28cabfeb [claude-sonnet-5] #Go to your Pull Zone → Caching → enter the exact URL → click Purge.
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #• Via API:*
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #async function purgeSingleFile(apiKey, fileUrl) {
28cabfeb [claude-sonnet-5] #	const endpoint = `https://api.bunny.net/purge?url=${encodeURIComponent(fileUrl)}`;
28cabfeb [claude-sonnet-5] #
28cabfeb [claude-sonnet-5] #	const response = await fetch(endpoint, {
28cabfeb [claude-sonnet-5] #		method: "POST",
28cabfeb [claude-sonnet-5] #		headers: {
28cabfeb [claude-sonnet-5] #			AccessKey: apiKey,
28cabfeb [claude-sonnet-5] #		},
28cabfeb [claude-sonnet-5] #	});
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #	return response.json();
28cabfec [claude-sonnet-5] #}
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #Usage:
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #purgeSingleFile("YOUR_API_KEY", "https://cdn.example.com/js/app.js");
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #2. Purge by Wildcard/Path Prefix
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #Useful if you version your files or have multiple JS assets to clear together.
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #Enable "Enable URL Purge with Wildcards" in your Pull Zone settings, then:
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #async function purgeByPattern(apiKey, pullZoneId, urlPattern) {
28cabfec [claude-sonnet-5] #	const endpoint = `https://api.bunny.net/pullzone/${pullZoneId}/purgeCache`;
28cabfec [claude-sonnet-5] #
28cabfec [claude-sonnet-5] #	const response = await fetch(endpoint, {
28cabfec [claude-sonnet-5] #		method: "POST",
28cabfec [claude-sonnet-5] #		headers: {
28cabfec [claude-sonnet-5] #			AccessKey: apiKey,
28cabfec [claude-sonnet-5] #			"Content-Type": "application/json",
28cabfec [claude-sonnet-5] #		},
28cabfec [claude-sonnet-5] #		body: JSON.stringify({ url: urlPattern }),
28cabfec [claude-sonnet-5] #	});
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #	return response.json();
28cabfed [claude-sonnet-5] #}
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #Example pattern: `https://cdn.example.com/js/*`
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #3. Use Cache-Busting Query Strings (Avoids Purging Entirely)
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #Instead of purging, force fresh files by changing the URL itself:
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #<script src="/js/app.js?v=1.2.3"></script>
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #Or use a content hash from your build tool:
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #<script src="/js/app.a1b2c3d.js"></script>
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #This is often the best long-term strategy — no manual purge step needed, and users always
28cabfed [claude-sonnet-5] #get the correct version instantly.
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #4. Set Shorter Cache-Control Headers for JS
28cabfed [claude-sonnet-5] #
28cabfed [claude-sonnet-5] #If you frequently update JS during active development, configure your origin server to send shorter
28cabfed [claude-sonnet-5] #cache lifetimes:
28cabfed [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #Cache-Control: public, max-age=300
28cabfee [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #Then BunnyCDN will naturally refetch every 5 minutes without needing manual purges.
28cabfee [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #Recommendation
28cabfee [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #╭────────────────────────────────┬─────────────────────────────────────╮
28cabfee [claude-sonnet-5] #│  Scenario                      │  Best Approach                      │
28cabfee [claude-sonnet-5] #├────────────────────────────────┼─────────────────────────────────────┤
28cabfee [claude-sonnet-5] #│  One-off fix to a single file  │  Single URL purge                   │
28cabfee [claude-sonnet-5] #│  Frequent JS deploys           │  Cache-busting filenames/hashes     │
28cabfee [claude-sonnet-5] #│  Active development            │  Short `max-age` + purge as needed  │
28cabfee [claude-sonnet-5] #│  CI/CD pipeline                │  API-based purge on each deploy     │
28cabfee [claude-sonnet-5] #╰────────────────────────────────┴─────────────────────────────────────╯
28cabfee [claude-sonnet-5] #
28cabfee [claude-sonnet-5] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28cabfee [claude-sonnet-5] #
