278685c4 [gemini-3.8-flash] #
278685c4 [gemini-3.8-flash] #• (Your system `ffmpeg` package already provides the required library headers).*
278685c4 [gemini-3.8-flash] #
278685c4 [gemini-3.8-flash] #2. DeckLink SDK Path
278685c5 [gemini-3.8-flash] #`bmdtools` needs to know where the Blackmagic SDK header files are located.
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #Depending on how the `decklink` AUR package installed them, they are typically either in
278685c5 [gemini-3.8-flash] #`/usr/include` or `/usr/include/decklink`.
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #You can check their location with:
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #ls /usr/include | grep -i decklink
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #• If headers are directly in `/usr/include`:
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #  git clone https://github.com/lu-zero/bmdtools.git
278685c5 [gemini-3.8-flash] #  cd bmdtools
278685c5 [gemini-3.8-flash] #  make
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #• If headers are in `/usr/include/decklink`:
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #  git clone https://github.com/lu-zero/bmdtools.git
278685c5 [gemini-3.8-flash] #  cd bmdtools
278685c5 [gemini-3.8-flash] #  make SDK_PATH=/usr/include/decklink
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #
278685c5 [gemini-3.8-flash] #Once compilation completes (usually only a few seconds), the `bmdcapture` binary will appear in the
278685c5 [gemini-3.8-flash] #directory. You can test it immediately by running `./bmdcapture -h`.
278685c5 [gemini-3.8-flash] #
