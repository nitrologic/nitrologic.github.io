: \"0.01\",\n\t\t\t\tmax: \"20\",\n\t\t\t\tpower: \"2\",\n\t\t\t\tdefault: \"1\"\n\t\t\t},\n\t\t\tgain: {\n\t\t\t\ttype: \"number\",\n\t\t\t\tmin:\"0\",\n\t\t\t\tmax:\"1.0\",\n\t\t\t\tdefault: \"1\"\n\t\t\t}\n\t\t}\n\t},\n\tamps:{\n\t\tparams:{\n\t\t\tid:{\n\t\t\t\ttype:\"string\"\n\t\t\t},\n\t\t\tlfo:{\n\t\t\t\ttype:\"integral\"\n\t\t\t},\n\t\t\ttarget:[\n\t\t\t\t{ type: \"tremolo\"},\n\t\t\t\t{ type: \"vibrato\"},\n\t\t\t\t{ type: \"filter\", param: \"cutoff\", index: \"0\", count: \"6\", gain: \"0.5\" },\n\t\t\t\t{ type: \"filter\", param: \"q\", index: \"0\", count: \"6\", gain: \"0.2\" },\n\t\t\t\t{ type: \"lfo\", param: \"fade\", index: \"0\", count: \"5\", gain: \"0.03\" },\n\t\t\t\t{ type: \"lfo\", param: \"rate\", index: \"0\", count: \"5\", gain: \"0.01\" },\n\t\t\t\t{ type: \"amp\", param: \"gain\", index: \"0\", count: \"64\", gain: \"0.1\" },\n\t\t\t\t{ type: \"amp\", param: \"phase\", index: \"0\", count: \"64\", gain: \"0.1\" },\n\t\t\t\t{ type: \"control\", param: \"value\", index: \"0\", count: \"64\", gain: \"0.1\" },\n\t\t\t],\n\t\t\tindex:{\n\t\t\t\ttype:\"integral\"\n\t\t\t},\n\t\t\tfactor:{\n\t\t\t\ttype: \"number\",\n\t\t\t\tmin: \"0\",\n\t\t\t\tmax: \"10.0\",\n\t\t\t\tpower: \"2\",\n\t\t\t\tdefault : \"1.0\"\n\t\t\t}\n\t\t}\n\t},\n\talgorithms: [\n\t\t{ value: \"0\", label: \"Still\" },\n\t\t{ value: \"1\", label: \"Natural\" },\n\t\t{ value: \"2\", label: \"Ascend\" },\n\t\t{ value: \"3\", label: \"Descend\" },\n\t\t{ value: \"4\", label: \"Tidal\" },\n\t\t{ value: \"5\", label: \"Wander\" },\n\t\t{ value: \"6\", label: \"Disorder\" }\n\t],\n\tprogressions: [\n\t\t{ value: \"0\", label: \"Clean\" },\n\t\t{ value: \"1\", label: \"Otto Loop\" },\n\t\t{ value: \"2\", label: \"Otto Rebel\" },\n\t\t{ value: \"3\", label: \"Deviant Rise\" },\n\t\t{ value: \"4\", label: \"Deviant Fall\" },\n\t\t{ value: \"5\", label: \"Janus Pivot\" },\n\t\t{ value: \"6\", label: \"Hydra Express\" },\n\t\t{ value: \"7\", label: \"Sisyphus Roll\" },\n\t\t{ value: \"8\", label: \"Entropy Shuffle\" },\n\t\t{ value: \"9\", label: \"Phoenix Rebirth\" },\n\t\t{ value: \"10\", label: \"Prometheus Bound\" },\n\t\t{ value: \"11\", label: \"Labyrinth Drift\" },\n\t\t{ value: \"12\", label: \"Oracle Pulse\" },\n\t\t{ value: \"13\", label: \"Origami Fold\" },\n\t\t{ value: \"14\", label: \"Elysian Echo\" },\n\t\t{ value: \"15\", label: \"Quantum Weave\" }\t\n\t],\n\tcontrols: {\n\t\thold: {\n\t\t\ttype: \"boolean\",\n\t\t\tlabel: \"Hold\",\n\t\t\tdefault: false\n\t\t},\n\t\tsustain: {\n\t\t\ttype: \"boolean\",\n\t\t\tlabel: \"Sustain\",\n\t\t\tdefault: false\n\t\t},\n\t\teffects: {\n\t\t\ttype: \"boolean\",\n\t\t\tlabel: \"Effects\",\n\t\t\tdefault: false\n\t\t},\n\t\ttempo: {\n\t\t\ttype: \"number\",\n\t\t\tlabel: \"Tempo (BPM)\",\n\t\t\tmin: \"20\",\n\t\t\tmax: \"240\",\n\t\t\tdefault: \"120\"\n\t\t},\n\t\tdivisor: {\n\t\t\ttype: \"integral\",\n\t\t\tlabel: \"Beat Divisions\",\n\t\t\tmin: \"1\",\n\t\t\tmax: \"10\",\n\t\t\tdefault: \"3\"\n\t\t},\n\t\tduty: {\n\t\t\ttype: \"number\",\n\t\t\tlabel: \"Duty Cycle\",\n\t\t\tmin: \"0.1\",\n\t\t\tmax: \"0.9\",\n\t\t\tdefault: \"0.5\",\n\t\t\tstep: \"0.1\"\n\t\t},\n\t\trepeats: {\n\t\t\ttype: \"integral\",\n\t\t\tlabel: \"Repeats\",\n\t\t\tmin: \"0\",\n\t\t\tmax: \"5\",\n\t\t\tdefault: \"0\"\n\t\t}\n\t}\n};\n\nspec.host = {\n\tdescription: \"A hive for VSynth worklet instances, managing MIDI and audio inputs.\",\n\tchannels: {\n\t\ttype: \"integral\",\n\t\tdescription: \"Number of local synth channels based on const LayerCount = 12\",\n\t\tdefault: \"12\"\n\t},\n\tsplit: {\n\t\tenabled: { type: \"boolean\", default: false, description: \"Toggles split keyboard.\" },\n\t\tmiddle: { type: \"number\", min: 0, max: 127, default: 60, description: \"Split point note.\" }\n\t},\n\thandlers: {\n\t\tmidi: { type: \"function\", description: \"Routes MIDI events to synths, respecting split.\" },\n\t\tsynth: { type: \"function\", description: \"Processes worklet state updates (e.g., midz).\" }\n\t},\n\tremote: {\n\t\ttype: \"boolean\",\n\t\tdescription: \"Enables support for remote synth instances (WIP).\",\n\t\tdefault: false\n\t},\n\tcommands: {\n\t\tdescription: \"Forwards commands to worklet (see spec.commands).\",\n\t\texamples: [\"noteon\", \"controlchange\", \"pcm64\"]\n\t},\n\tpatches: {\n\t\ttype: \"string\",\n\t\tdescription: \"Assigns a patch name to synth instances for routing.\",\n\t\tdefault: \"dsp1.patch.0\"\n\t},\n\ttempo: {\n\t\ttype: \"number\",\n\t\tdescription: \"Sets global tempo in BPM for synth synchronization.\",\n\t\tdefault: 120,\n\t\tmin: 20,\n\t\tmax: 240\n\t}\n};\n\n\n\nspec.commands = {\n\t\"pcm64\": {\n\t\tdescription: \"Streams raw audio data into an input stream.\",\n\t\tparameters: {\n\t\t\tdata: { type: \"Float64Array\", description: \"Audio samples.\" },\n\t\t\tcount: { type: \"integral\", description: \"Sample count for sequencing.\" },\n\t\t\trate: { type: \"integral\", description: \"Sample rate in Hz.\", default: 48000 },\n\t\t\tsource: { type: \"string\", description: \"Stream identifier.\" }\n\t\t}\n\t},\n\t\"stop\": {\n\t\tdescription: \"Stops all active notes and resets the synth.\",\n\t\tparameters: {}\n\t},\n\t\"panic\": {\n\t\tdescription: \"Stops all notes and emits a snapshot of the synth state.\",\n\t\tparameters: {}\n\t},\n\t\"noteon\": {\n\t\tdescription: \"Triggers a note with velocity, adjusted by transpose.\",\n\t\tparameters: {\n\t\t\tnote: { type: \"integral\", min: 0, max: 127, description: \"MIDI note number.\" },\n\t\t\tvelocity: { type: \"integral\", min: 0, max: 127, description: \"Note velocity.\" }\n\t\t}\n\t},\n\t\"noteoff\": {\n\t\tdescription: \"Releases a note, adjusted by transpose.\",\n\t\tparameters: {\n\t\t\tnote: { type: \"integral\", min: 0, max: 127, description: \"MIDI note number.\" }\n\t\t}\n\t},\n\t\"controlchange\": {\n\t\tdescription: \"Adjusts synth parameters via MIDI-style controls.\",\n\t\tparameters: {\n\t\t\tcontrol: {\n\t\t\t\ttype: \"integral\",\n\t\t\t\tdescription: \"Control number.\",\n\t\t\t\tvalues: {\n\t\t\t\t\t\"1\": \"Modulation\",\n\t\t\t\t\t\"4\": \"Foot pedal modulation\",\n\t\t\t\t\t\"6\": \"Generic value slider\",\n\t\t\t\t\t\"10\": \"Pan (-1 to 1)\",\n\t\t\t\t\t\"44\": \"Record toggle\",\n\t\t\t\t\t\"49\": \"Hold toggle\",\n\t\t\t\t\t\"50\": \"Effects toggle\",\n\t\t\t\t\t\"64\": \"Sustain toggle\",\n\t\t\t\t\t\"96\": \"Transpose up 12 semitones\",\n\t\t\t\t\t\"97\": \"Transpose down 12 semitones\",\n\t\t\t\t\t\"123\": \"Panic\",\n\t\t\t\t\t\"176\": \"Alternate modulation\",\n\t\t\t\t\t\"224\": \"Pitch bend (-1 to 1)\"\n\t\t\t\t}\n\t\t\t},\n\t\t\tvalue: { type: \"integral\", min: 0, max: 127, description: \"Control value.\" }\n\t\t}\n\t},\n\t\"beat\": {\n\t\tdescription: \"Sets arpeggiator beat parameters.\",\n\t\tparameters: {\n\t\t\tdiv: { type: \"integral\", min: 1, max: 10, default: 3, description: \"Beat divisions.\" },\n\t\t\tduty: { type: \"number\", min: 0.1, max: 0.9, default: 0.5, step: 0.1, description: \"Duty cycle.\" },\n\t\t\treps: { type: \"integral\", min: 0, max: 5, default: 0, description: \"Repeat count.\" }\n\t\t}\n\t},\n\t\"amp\": {\n\t\tdescription: \"Configures LFO amplitude modulation (WIP).\",\n\t\tparameters: {\n\t\t\tid: { type: \"string\", description: \"Amplitude ID.\" },\n\t\t\tlfo: { type: \"integral\", description: \"LFO index.\" },\n\t\t\ttarget: { type: \"integral\", description: \"Target parameter.\" },\n\t\t\tfactor: { type: \"number\", description: \"Modulation factor.\" }\n\t\t}\n\t},\n\t\"lfo\": {\n\t\tdescription: \"Configures a low-frequency oscillator.\",\n\t\tparameters: {\n\t\t\tindex: { type: \"integral\", description: \"LFO index.\" },\n\t\t\toscillator: { type: \"integral\", values: spec.oscillators, description: \"Waveform type.\" },\n\t\t\tpower: { type: \"number\", min: 0, description: \"Waveform power exponent.\" },\n\t\t\tfrequency: { type: \"number\", min: 0, description: \"Frequency in Hz.\" },\n\t\t\tsync: { type: \"boolean\", description: \"Sync to tempo.\" }\n\t\t}\n\t},\n\t\"filter\": {\n\t\tdescription: \"Configures a biquad filter.\",\n\t\tparameters: {\n\t\t\tindex: { type: \"integral\", description: \"Filter index.\" },\n\t\t\tenable: { type: \"boolean\", description: \"Enable filter.\" },\n\t\t\ttype: { type: \"integral\", values: spec.filters.types, description: \"Filter type.\" },\n\t\t\tcutoff: { type: \"number\", min: 20, max: 24000, default: 500, description: \"Cutoff frequency (Hz).\" },\n\t\t\tQ: { type: \"number\", min: 0.1, max: 50, default: 0.707, step: 0.1, description: \"Resonance.\" }\n\t\t}\n\t},\n\t\"arp\": {\n\t\tdescription: \"Sets arpeggiator algorithm and progression.\",\n\t\tparameters: {\n\t\t\talgo: { type: \"number\", values: spec.algorithms, description: \"Arpeggio pattern.\" },\n\t\t\tprog: { type: \"number\", values: spec.progressions, description: \"Pitch progression.\" }\n\t\t}\n\t},\n\t\"tempo\": {\n\t\tdescription: \"Sets the tempo for the arpeggiator.\",\n\t\tparameters: {\n\t\t\tbpm: { type: \"number\", min: 20, max: 240, default: 120, description: \"Beats per minute.\" }\n\t\t}\n\t},\n\t\"voice\": {\n\t\tdescription: \"Sets synth mode and timbre.\",\n\t\tparameters: {\n\t\t\tmode: { type: \"integral\", values: spec.modes, description: \"Synth mode.\" },\n\t\t\toscillator: { type: \"integral\", values: spec.oscillators, description: \"Oscillator type.\" },\n\t\t\tenvelope: { type: \"integral\", values: spec.envelopes, description: \"Envelope type.\" },\n\t\t\tpower: { type: \"number\", min: 0, description: \"Waveform power exponent.\" }\n\t\t}\n\t},\n\t\"snapshot\": {\n\t\tdescription: \"Requests a snapshot of the current synth state.\",\n\t\tparameters: {}\n\t},\n\t\"effect\": {\n\t\tdescription: \"Sets an effect parameter value.\",\n\t\tparameters: {\n\t\t\tcontrol: { type: \"string\", description: \"Effect parameter name (e.g., 'overdrive', 'gain').\" },\n\t\t\tvalue: { type: \"number\", description: \"Parameter value.\" }\n\t\t}\n\t}\n};\n\nspec.patch = {\n\tdescription: \"Template for synth patch data, stored and routed via hive.\",\n\tparameters: {\n\t\tvoice: {\n\t\t\ttype: \"object\",\n\t\t\tdescription: \"Synth voice settings (see spec.commands.voice).\",\n\t\t\tfields: {\n\t\t\t\toscillator: { type: \"integral\", values: spec.oscillators },\n\t\t\t\tpower: { type: \"number\", min: 0 },\n\t\t\t\tenvelope: { type: \"integral\", values: spec.envelopes },\n\t\t\t\tmode: { type: \"integral\", values: spec.modes }\n\t\t\t}\n\t\t},\n\t\tarp: {\n\t\t\ttype: \"object\",\n\t\t\tdescription: \"Arpeggiator settings (see spec.commands.arp).\",\n\t\t\tfields: {\n\t\t\t\talgo: { type: \"integral\", values: spec.algorithms },\n\t\t\t\tprog: { type: \"integral\", values: spec.progressions }\n\t\t\t}\n\t\t},\n\t\tbeat: {\n\t\t\ttype: \"object\",\n\t\t\tdescription: \"Beat settings (see spec.commands.beat).\",\n\t\t\tfields: {\n\t\t\t\tdiv: { type: \"number\", min: 1, max: 10 },\n\t\t\t\tduty: { type: \"number\", min: 0.1, max: 0.9, step: 0.1 },\n\t\t\t\treps: { type: \"integral\", min: 0, max: 5 }\n\t\t\t}\n\t\t},\n\t\ttempo: {\n\t\t\ttype: \"number\",\n\t\t\tdescription: \"Patch-specific tempo (see spec.hive.tempo).\",\n\t\t\tmin: 20,\n\t\t\tmax: 240,\n\t\t\tdefault: 120\n\t\t},\n\t\tmatrix: {\n\t\t\ttype: \"object\",\n\t\t\tdescription: \"Placeholder for filter, lfo, and amp configurations.\",\n\t\t\tfields: {}\n\t\t},\n\t\tname: {\n\t\t\ttype: \"string\",\n\t\t\tdescription: \"Patch identifier.\",\n\t\t\tdefault: \"dsp1.patch.0\"\n\t\t}\n\t}\n};\n\nspec.definitions = {\n\talgorithms: [\n\t\t{ label: \"Still\", description: \"Unadulterated restful sleep.\", mythos: \"zzzzzz\" },\n\t\t{ label: \"Natural\", description: \"Cycles through notes in the order they were played, maintaining their natural flow.\", mythos: \"A steady stream, notes trace their destined course.\" },\n\t\t{ label: \"Ascend\", description: \"Orders notes from lowest to highest pitch, ascending each cycle.\", mythos: \"A climb to the heavens, notes rise in golden light.\" },\n\t\t{ label: \"Descend\", description: \"Orders notes from highest to lowest pitch, descending each cycle.\", mythos: \"A fall to the depths, notes fade into shadow.\" },\n\t\t{ label: \"Tidal\", description: \"Bounces notes up and down the sorted range, like a tidal wave.\", mythos: \"An endless tide, notes sway in rhythmic swells.\" },\n\t\t{ label: \"Wander\", description: \"Randomly steps forward or backward through sorted notes, wandering unpredictably.\", mythos: \"A restless journey, notes roam without a map.\" },\n\t\t{ label: \"Disorder\", description: \"Selects notes randomly from the sorted set, embracing full entropy.\", mythos: \"A storm of chance, notes scatter in wild abandon.\" }\n\t],\n\tprogressions: [\n\t\t{ label: \"Clean\", description: \"No pitch progression is applied to the arpeggiated notes.\", mythos: \"A silent void, ambivalent of progress, an unadulterated present.\" },\n\t\t{ label: \"Otto Loop\", description: \"Cycles through note offsets based on the natural order, looping endlessly.\", mythos: \"Otto drifts, spiraling through his own circuitous path.\" },\n\t\t{ label: \"Otto Rebel\", description: \"Similar to Otto Loop but freely shifts offsets without resetting, creating an endless spiral.\", mythos: \"Freed from the loop, Otto rebels, spiraling beyond.\" },\n\t\t{ label: \"Deviant Rise\", description: \"Increments pitch upward by one semitone each cycle, defying expectations.\", mythos: \"Deviant rises, pushing upwards in defiance of the norm.\" },\n\t\t{ label: \"Deviant Fall\", description: \"Decrements pitch downward by one semitone each cycle, falling into rebellion.\", mythos: \"Deviant falls, resisting the pull of order and descending freely.\" },\n\t\t{ label: \"Janus Pivot\", description: \"Alternates pitch direction every cycle, shifting up then down like the two-faced god Janus.\", mythos: \"Janus gazes both ways, notes pivot in divine duality.\" },\n\t\t{ label: \"Hydra Express\", description: \"Expands pitch by 12 semitones per cycle, growing wildly like the Hydra’s heads.\", mythos: \"The Hydra sprouts, each head a new octave of fury.\" },\n\t\t{ label: \"Sisyphus Roll\", description: \"Increments pitch up to 12 semitones then resets, rolling back like Sisyphus’ boulder.\", mythos: \"Sisyphus heaves, only for the stone to tumble anew.\" },\n\t\t{ label: \"Entropy Shuffle\", description: \"Randomly shifts pitch between -5 and +5 semitones, blending chaos.\", mythos: \"Entropy reigns, reshuffling the universe’s patterns.\" },\n\t\t{ label: \"Phoenix Rebirth\", description: \"Rises through 12 semitones, pauses, then resets to zero, reborn like a Phoenix from ashes.\", mythos: \"The Phoenix burns, then rises anew from silent embers.\" },\n\t\t{ label: \"Prometheus Bound\", description: \"Steps up by 1 semitone four times, then drops by 5, bound to an inevitable cycle.\", mythos: \"Prometheus strains, chained to a torment of rising and falling.\" },\n\t\t{ label: \"Labyrinth Drift\", description: \"Wanders randomly within a -12 to +12 semitone range, drifting through a labyrinth.\", mythos: \"Lost in Daedalus’ maze, notes wander without end.\" },\n\t\t{ label: \"Oracle Pulse\", description: \"Pulses up by 3 semitones three times, then pauses, delivering a prophetic rhythm.\", mythos: \"The Oracle whispers, three beats foretell a silent fate.\" },\n\t\t{ label: \"Origami Fold\", description: \"Alternates between +6 and +1 semitone shifts, folding like signals at peak.\", mythos: \"Origami shift symantics.\" },\n\t\t{ label: \"Elysian Echo\", description: \"Echoes with a +7 semitone shift every fourth cycle, serene like the Elysian fields.\", mythos: \"Elysium calls, a heavenly echo every fourth breath.\" },\n\t\t{ label: \"Quantum Weave\", description: \"Weaves random shifts between -4 and +4 semitones, resetting every eighth cycle, threading chaos.\", mythos: \"Quantum forces\"}\n\t]\n};\n\nspec.effects={\n\ttypes: [\n\t\t{\n\t\t\tlabel: \"position\",\n\t\t\tparams: {\n\t\t\t\tPan: {\n\t\t\t\t\tlabel: \"pan\",\n\t\t\t\t\tvalue: \"0\",\n\t\t\t\t\tmin: \"-1\",\n\t\t\t\t\tmax: \"1\",\n\t\t\t\t\tdefault: \"0\"\n\t\t\t\t}\n\t\t\t}\n\t\t},\n\t\t{\n\t\t\tlabel: \"distortion\",\n\t\t\tparams: {\n\t\t\t\tOverdrive: {\n\t\t\t\t\tlabel: \"overdrive\",\n\t\t\t\t\tvalue: \"1\",\n\t\t\t\t\tmin: \"0\",\n\t\t\t\t\tmax: \"100\",\n\t\t\t\t\tdefault: \"20\",\n\t\t\t\t\tpower: \"1\"\n\t\t\t\t},\n\t\t\t\tGain: {\n\t\t\t\t\tlabel: \"gain\",\n\t\t\t\t\tvalue: \"2\",\n\t\t\t\t\tmin: \"0\",\n\t\t\t\t\tmax: \"2\",\n\t\t\t\t\tdefault: \"0.4\",\n\t\t\t\t\tpower: \"1\"\n\t\t\t\t}\n\t\t\t}\n\t\t},\n\t\t{\n\t\t\tlabel: \"reverb\",\n\t\t\tparams: {\n\t\t\t\tWet: {\n\t\t\t\t\tlabel: \"wet\",\n\t\t\t\t\tvalue: \"3\",\n\t\t\t\t\tmin: \"0\",\n\t\t\t\t\tmax: \"1\",\n\t\t\t\t\tdefault: \"1\",\n\t\t\t\t\tpower: \"1\"\n\t\t\t\t},\n\t\t\t\tDry: {\n\t\t\t\t\tlabel: \"dry\",\n\t\t\t\t\tvalue: \"4\",\n\t\t\t\t\tmin: \"0\",\n\t\t\t\t\tmax: \"1\",\n\t\t\t\t\tdefault: \"1\",\n\t\t\t\t\tpower: \"1\"\n\t\t\t\t},\n\t\t\t\tFalloff: {\n\t\t\t\t\tlabel: \"falloff\",\n\t\t\t\t\tvalue: \"5\",\n\t\t\t\t\tmin: \"0\",\n\t\t\t\t\tmax: \"2\",\n\t\t\t\t\tdefault: \"1.5\",\n\t\t\t\t\tpower: \"1\"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n}","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitrogui.js\",\"length\":20583,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrogui.js\r\n// (c)2024 nitrologic \r\n// All rights reserved\r\n\r\n// collection of DOM helpers for DSPTool project\r\n\r\n// UX builders apia\r\n// addTitle(group,name,labelClassName=\"dsplabel\")\r\n// addAudio(group,name,source)\r\n// addVideo(group,name)\r\n// addButton(group,name,handler,attributes={})\r\n// addOption(select,value,label,attributes={})\r\n// selectOption(select,index)\r\n// removeOption(select,value)\r\n// dropdownhideshow(e)\r\n// addDropdown(group,icon)\r\n// addSelect(group,name)\r\n// addSlider(group,name,value,handler)\r\n// addTextInput(group,name,changehandler,inputhandler)\r\n// labelInput(input,text)\r\n// addLabel(group,title,input=null,className=\"box\",info=\"\")\r\n// addForm(group)\r\n// addSliders(div,names)\r\n// addInput(type,group,nameinfo,divspan=\"span\",className=\"box\")\r\n// addFlagOptions(group,name,names,handler)\r\n// addTable(group,fieldNames,spanClass=\"fieldname\")\r\n// getRowSpan(row,index)\r\n// setRowGui(span,gui,bind)\r\n// setRowValue(row,index,content)\r\n// addRow(table,names,spanClass=\"fieldvalue\")\r\n// fillRow(table,name,columns,spanClass=\"fieldvalue\")\r\n// addRefresh(group,name,handler)\r\n// addLog(group)\r\n// addTool(group,name,command,handler)\r\n// addToolbar(group,tools)\r\n// hexString(byte)\r\n// cellColumns={}\r\n// flushColumn(group)\r\n// addCell(group,address,value,name,info)\r\n// addRegister(group,address,reg)\r\n// setPageStyle(e)\r\n// addRadioButton(group,name,title,value,handler)\r\n// addRadioButtons(group,name,tools,handler)\r\n// unselectCells(selected)\r\n// selectCell(selected,grid,x,y)\r\n// selectGrid(grid,selected,a,b,tool)\r\n// addStyleSelect(group,styles,onchange)\r\n// addToggle(group,name,handler)\r\n// addImage(group,handler)\r\n// addSpan(type,group,name)\r\n// addGrid(panel,width,height)\r\n\r\n// todo - complete addAudio\r\n\r\nfunction setLabelText(group,text){\r\n\tfor(var e of group.childNodes){\r\n\t\tif(e.nodeName==\"LABEL\"){\r\n\t\t\tfor(var ee of e.childNodes){\r\n\t\t\t\tif(ee.nodeName==\"#text\"){\r\n\t\t\t\t\tee.textContent=text;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction addTitle(group,name,labelClassName=\"dsplabel\"){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"group\";\r\n\tvar labelText=document.createTextNode(name);\r\n\tvar label=document.createElement(\"label\");\r\n\tlabel.appendChild(labelText);\r\n\tlabel.className=labelClassName;\r\n\tdiv.appendChild(label);\r\n\tgroup.appendChild(div);\r\n\treturn div;\r\n}\r\n\r\nfunction addAudio(group,name,source){\r\n\tvar element=document.createElement(\"audio\");\r\n\telement.src=source;\r\n\telement.setAttribute(\"controls\",\"\")\r\n\tgroup.appendChild(element);\r\n\treturn element;\r\n}\r\n\r\nfunction addVideo(group,name){\r\n\tvar vid=document.createElement(\"video\");\r\n//\taddLabel(group,\"Video\",vid);\r\n\tvid.setAttribute(\"autoplay\",\"\");\r\n\tvid.volume=0.0;\r\n//\tvar button=addButton(group,name,handler);\r\n\tgroup.appendChild(vid);\r\n\treturn vid;\r\n}\r\n\r\n// deprecated, consider addToolButton alternative\r\n\r\nfunction addTool(group,namehint,command,handler){\r\n\tconst attributes={\"command\":command};\r\n\tvar button=addButton(group,namehint,handler,attributes);\r\n//\tbutton.setAttribute(\"command\",command);\r\n\treturn button;\r\n}\r\n\r\nfunction rawButton(namehint,handler,attributes={}){\r\n\tvar button=document.createElement(\"button\");\r\n\tvar hint=\"\";\r\n\tvar name=namehint;\r\n\tvar i0=name.indexOf(\"<\");\r\n\tvar i1=name.lastIndexOf(\">\");\r\n\tif(i0 && i1>i0){\r\n\t\tname=namehint.slice(0,i0);\r\n\t\thint=namehint.slice(i0+1,i1);\r\n\t\tbutton.setAttribute(\"title\",hint);\r\n\t}\r\n\tbutton.id=name;\r\n\tbutton.setAttribute(\"tabindex\",0);\r\n\tfor(var key in attributes){\r\n\t\tvar attribute=attributes[key];\r\n\t\tbutton.setAttribute(key,attribute);\r\n\t}\r\n\tvar buttonText=document.createTextNode(name);\r\n\tbutton.onclick=handler;\r\n\tbutton.appendChild(buttonText);\r\n\treturn button;\r\n}\r\n\r\n\r\nfunction addButton(group,namehint,handler,attributes={}){\r\n\tvar span=document.createElement(\"span\");\r\n\tspan.className=\"dspbutton\";\r\n\tvar button=rawButton(namehint,handler,attributes);\r\n\tspan.appendChild(button);\r\n\tgroup.appendChild(span);\r\n\treturn button;\r\n}\r\n\r\nfunction addToolButton(group,namehint,handler,attributes){\r\n\tvar button=rawButton(namehint,handler,attributes);\r\n\tgroup.appendChild(button);\r\n\treturn button;\r\n}\r\n\r\n\r\nfunction addButton2(group,namehint,handler,attributes={}){\r\n\tvar span=document.createElement(\"span\");\r\n\tspan.className=\"dspbutton\";\r\n\tvar button=document.createElement(\"button\");\r\n\tvar hint=\"\";\r\n\tvar name=namehint;\r\n\tvar i0=name.indexOf(\"<\");\r\n\tvar i1=name.lastIndexOf(\">\");\r\n\tif(i0 && i1>i0){\r\n\t\tname=namehint.slice(0,i0);\r\n\t\thint=namehint.slice(i0+1,i1);\r\n\t\tbutton.setAttribute(\"title\",hint);\r\n\t}\r\n\tbutton.id=name;\r\n\tbutton.setAttribute(\"tabindex\",0);\r\n\tfor(var key in attributes){\r\n\t\tvar attribute=attributes[key];\r\n\t\tbutton.setAttribute(key,attribute);\r\n\t}\r\n\tvar buttonText=document.createTextNode(name);\r\n\tbutton.onclick=handler;\r\n\tbutton.appendChild(buttonText);\r\n\tspan.appendChild(button);\r\n\tgroup.appendChild(span);\r\n\treturn button;\r\n}\r\n\r\nfunction addEmptyOption(select,label){\r\n\treturn addOption(select,0,label,{disabled:\"\",selected:\"\"});\r\n}\r\n\r\nfunction addOption(select,value,label,attributes={},selected=false){\r\n\tvar option=new Option(label,value,selected,selected);\r\n//\tvar option=document.createElement(\"option\");\r\n//\tvar text=document.createTextNode(label);\r\n//\toption.appendChild(text);\r\n\toption.className=\"favourite\";\r\n//\toption.value=value;\r\n\tfor(var name in attributes){\r\n\t\tvar attribute=attributes[name];\r\n\t\toption.setAttribute(name,attribute);\r\n\t}\r\n\tselect.appendChild(option);\r\n\treturn option;\r\n}\r\n\r\nfunction selectOption(select,index){\r\n\tvar option=select.childNodes[index];\r\n\toption.setAttribute(\"selected\",\"\");\r\n}\r\n\r\nfunction removeOption(select,value){\r\n\tvar option=document.getElementById(value);\r\n\tselect.removeChild(option);\r\n}\r\n\r\nfunction dropdownhideshow(e){\r\n}\r\n\r\nfunction addToggleOption(select,name,handler){\r\n\tvar option=addOption(select,name,name,{});\r\n//\tvar input=addInput(\"checkbox\",group,name,\"span\",\"short\");\r\n//\tinput.onchange=handler;\r\n//\treturn input;\r\n\treturn option;\r\n}\r\n\r\nfunction addMultipleSelect(group,name){\r\n\tvar options=addSelect(group,name);\r\n\toptions.setAttribute(\"multiple\",\"\");\r\n\treturn options;\r\n}\r\n\r\nfunction addDropdown(group,icon){\r\n\tvar button=addButton(group,icon,dropdownhideshow);\r\n\treturn button;\r\n}\r\n\r\nfunction addSlider(group,name,value,handler){\r\n\tvar range=addInput(\"range\",group,name,\"span\",\"dspslider\");\r\n\trange.onchange=handler;\r\n\trange.oninput=handler;\r\n\trange.value=value;\r\n\treturn range;\r\n}\r\n\r\nfunction addTextInput(group,name,changehandler,inputhandler){\r\n\tvar input=addInput(\"text\",group,name,\"span\",\"dsptext\");\r\n\tinput.onchange=changehandler;\r\n\tinput.oninput=inputhandler;\r\n\treturn input;\r\n}\r\n\r\nfunction labelInput(input,text){\r\n\tvar label=input.parentElement;\r\n\tfor(var e of label.childNodes){\r\n\t\tif(e.nodeName==\"#text\") e.textContent=text;\r\n\t}\r\n}\r\n\r\nfunction addLabel(group,title,input=null,className=\"box\",info=\"\"){\r\n\tvar span=document.createElement(\"span\");\r\n\tspan.className=className;\r\n\tspan.setAttribute(\"title\",info)\r\n\tvar text=document.createTextNode(title);\r\n\tvar label=document.createElement(\"label\");\r\n\tlabel.className=\"dsplabel\";\r\n\tlabel.appendChild(text);\r\n\tif(input) label.appendChild(input);\r\n\tspan.appendChild(label);\r\n\tgroup.appendChild(span);\r\n}\r\n\r\nfunction addForm(group){\r\n\tvar form=document.createElement(\"form\");\r\n\tform.setAttribute(\"enctype\",\"multipart/form-data\")\r\n\tform.setAttribute(\"method\",\"post\");\r\n\tvar input=document.createElement(\"input\")\r\n\tinput.type=\"file\";\r\n\tinput.id=\"form.file.id\";\r\n\tinput.setAttribute(\"multiple\",\"\");\r\n\tinput.setAttribute(\"accept\",\"*/*\");\r\n\tform.appendChild(input);\r\n\tgroup.appendChild(form);\r\n}\r\n\r\n// ooops oops\r\n\r\nfunction addSliders(div,names){\r\n\tconsole.log(\"addSliders\");\r\n\tvar ranges=[];\r\n\tvar group=addSpan()\r\n\tfor(var name in names){\r\n\t\tvar range=addInput(\"range\",group,name,\"span\",\"slider\");\r\n\t\trange.setAttribute(\"vertical\",\"\");\r\n\t\tranges.push(range);\r\n\t}\r\n\treturn ranges;\r\n}\r\n\r\nfunction splitNameInfo(nameinfo){\r\n\tlet split=nameinfo.split(\"<\");\r\n\tlet info=split[1];\r\n\tif(info && info.endsWith(\">\"))\r\n\t{\r\n\t\tsplit[1]=info.substring(0,info.length-1);\r\n\t}\r\n\treturn split;\r\n}\r\n\r\nfunction addSelect(group,name,handler){\r\n\tvar span=document.createElement(\"span\");\r\n\tspan.className=\"dspselect\";\r\n\tspan.title=\"select.\"+name;\r\n\r\n\tvar text=document.createTextNode(name);\r\n\tvar label=document.createElement(\"label\");\r\n\tlabel.className=\"dsplabel\"; //todo - add input type\r\n\r\n\tvar select=document.createElement(\"select\");\r\n\tselect.id=name;\r\n\tselect.title=\"select.\"+name;\r\n\tselect.setAttribute(\"name\",name);\r\n\tselect.onchange=handler;\r\n\r\n\tlabel.appendChild(text);\r\n\tlabel.appendChild(select);\r\n\tspan.appendChild(label);\r\n\tgroup.appendChild(span);\r\n\r\n\treturn select;\r\n}\r\n\r\nfunction addInput(type,group,nameinfo,divspan=\"span\",className=\"box\"){\r\n\tvar span=document.createElement(divspan);\r\n\t// not sure about this\r\n\tspan.className=className;\r\n\tlet split=splitNameInfo(nameinfo)\r\n\tlet name=split[0];\r\n\tlet info=split[1]||\"anon input\";\r\n\tspan.setAttribute(\"title\",info)\r\n\tvar spantext=document.createElement(\"span\");\r\n\tvar text=document.createTextNode(name);\r\n\tspantext.className=\"dspspan\";\t\r\n\tspantext.appendChild(text);\r\n\tvar label=document.createElement(\"label\");\r\n\tlabel.className=\"dsplabel\"; //todo - add input type\r\n\tvar input=document.createElement(\"input\");\r\n\tinput.id=name;\r\n\tinput.className=className;\r\n\tinput.setAttribute(\"type\",type);\r\n\tif(type==\"text\"){\r\n\t\tlabel.appendChild(spantext);\r\n\t\tlabel.appendChild(input);\r\n\t\tinput.setAttribute(\"spellcheck\",false);\r\n\t}else{\r\n\t\tif(type==\"range\"){\r\n\t\t\tlabel.appendChild(spantext);\t\r\n\t\t\tlabel.appendChild(input);\r\n\t\t}else{\r\n\t\t\tlabel.appendChild(input);\r\n\t\t\tlabel.appendChild(spantext);\r\n\t\t}\r\n\t}\r\n\tspan.appendChild(label);\r\n\tgroup.appendChild(span);\r\n\treturn input;\r\n}\r\n\r\nvar refreshRates=[0,1,5,20]\r\n\r\n// refresh group appendage\r\n\r\nfunction setRefresh(e){\r\n\tvar select=e.target;\r\n\tif(select.hasAttribute(\"timer\")){\r\n\t\tvar timer=select.getAttribute(\"timer\")\r\n\t\tclearInterval(timer);\r\n\t\tselect.removeAttribute(\"timer\");\r\n\t}\r\n\tvar hz=parseInt(select.value);\r\n\tif(hz){\r\n\t\tvar period=1000.0/hz;\r\n\t\tvar timer=setInterval(select.handler,period);\r\n\t\tselect.setAttribute(\"timer\",timer);\r\n\t}\r\n}\r\n\r\n//wasmWatFlags=addFlags(wasmTools,\"wat2wasm flags\",wat2wasmFlags);\t\r\n\r\nfunction addFlags(group,name,names,handler){\r\n\tvar select=addMultipleSelect(group,name);\r\n\tfor(var name of names){\r\n\t\taddToggleOption(select,name,handler);\t\r\n\t}\r\n\treturn select;\r\n}\r\n\r\n\r\n// note: tables and pool.sheets share js class\r\n\r\nfunction addTable(group,fieldNames,spanClass=\"fieldname\"){\r\n\tvar tableview=document.createElement(\"div\");\r\n\ttableview.className=\"dsptable\";\r\n\r\n\tvar table=document.createElement(\"div\");\r\n\ttable.className=\"dspsheet\";\r\n\r\n\tvar namedFields=document.createElement(\"div\");\r\n\tnamedFields.className=\"namedfields\";\r\n\r\n\tvar cell=document.createElement(\"span\");\r\n\tcell.className=\"fieldcheck\";\r\n\tvar toggle=document.createElement(\"input\");\r\n\ttoggle.type=\"checkbox\";\r\n\tcell.appendChild(toggle);\r\n\tnamedFields.appendChild(cell);\r\n\r\n\tfor(var name of fieldNames){\r\n\t\tvar span=document.createElement(\"span\");\r\n\t\tspan.className=spanClass;//\"fieldname\";\r\n\t\tvar text=document.createTextNode(name);\r\n\t\tspan.appendChild(text);\r\n\t\tnamedFields.appendChild(span);\t\r\n\t}\r\n\r\n\ttable.appendChild(namedFields);\r\n\ttableview.appendChild(table);\r\n\tgroup.appendChild(tableview);\r\n\r\n\treturn table;\r\n}\r\n\r\nfunction getRowSpan(row,index)\r\n{\r\n\tvar span=row.children[index];\r\n\treturn span;\r\n}\r\n\r\n// gui uses a nitrojs gui encoding\r\n// example: \"trace.button=trace:rumble.select=\"+gamepad.effects.join(\",\")+\":min.slider=0.5:max.slider=0.8\";\r\n\r\nfunction setRowGui(span,gui,bind){\r\n\tvar lastname=span.id;\r\n\tvar split=gui.split(\":\");\r\n\tfor(var control of split)\r\n\t{\r\n\t\tvar namevalue=control.split(\"=\");\r\n\t\tvar value=namevalue[1];\r\n\t\tvar nametype=namevalue[0].split(\".\");\r\n\t\tvar firstname=nametype[0];\r\n\t\tvar name=firstname+\" \" +lastname;\r\n\t\tconsole.log(control)\r\n\t\tswitch(nametype[1])\r\n\t\t{\r\n\t\t\tcase \"slider\":\r\n\t\t\t\tvar slider=addSlider(span,name,value,bind);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"button\":\r\n\t\t\t\tvar button=addButton(span,name,bind);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"select\":\r\n\t\t\t\tvar select=addSelect(span,name);\r\n\t\t\t\tvar values=namevalue[1].split(\",\");\r\n\t\t\t\tfor(var value of values)\r\n\t\t\t\t{\r\n\t\t\t\t\taddOption(select,value,value,bind);\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n\r\nfunction setRowValue(row,index,content){\r\n\tvar span=row.children[index];\r\n\tspan.textContent=content;\r\n}\r\n\r\nfunction addRow(table,names,spanClass=\"fieldvalue\"){\r\n\tvar row=document.createElement(\"div\");\r\n\trow.className=\"fieldvalues\";\r\n\r\n\tvar toggle=document.createElement(\"input\");\r\n\ttoggle.type=\"checkbox\";\r\n\trow.appendChild(toggle);\r\n\r\n\tfor(var name of names){\r\n\t\tvar span=document.createElement(\"span\");\r\n\t\tspan.className=spanClass;\r\n\t\tif(name){\r\n\t\t\tvar text=document.createTextNode(name);\r\n\t\t\tspan.appendChild(text);\r\n\t\t}\r\n\t\trow.appendChild(span);\r\n\t}\r\n\r\n\ttable.appendChild(row);\r\n\treturn row;\r\n}\r\n\r\nfunction fillRow(table,name,columns,spanClass=\"fieldvalue\"){\r\n\r\n\tvar values=[];\r\n\r\n\tvar row=document.createElement(\"div\");\r\n\trow.className=\"fieldvalues\";\r\n\r\n\tvar title=document.createElement(\"span\");\r\n\ttitle.className=\"rowname\";\r\n\tif(name){\r\n\t\tvar text=document.createTextNode(name);\r\n\t\ttitle.appendChild(text);\r\n\t}\r\n\trow.appendChild(title);\r\n\r\n\tfor(var i=0;i<columns;i++){\r\n\t\tvar span=document.createElement(\"span\");\r\n\t\tspan.className=spanClass;//\"fieldvalue\";\r\n\t\tvar text=document.createTextNode(\"\");\r\n\t\tspan.appendChild(text);\r\n\t\trow.appendChild(span);\r\n\t\tvalues[i]=text;\r\n\t}\r\n\r\n\ttable.appendChild(row);\r\n\treturn values;\r\n}\r\n\r\n// return button\r\nfunction addRefresh(group,name,handler){\r\n\tlet minibar=addMinibar(group);\r\n\taddTitle(group,name);\r\n\r\n\tvar button=addButton(minibar,\"\\u21BB\",handler);\r\n\r\n\tvar select=document.createElement(\"select\");\t\r\n\tfor(var rate of refreshRates){\r\n\t\taddOption(select,rate,rate?\"\"+rate+\" Hz\":\"Off\");\r\n\t}\r\n\tselect.handler=handler;\r\n\tselect.onchange=setRefresh;\r\n\tminibar.appendChild(select);\r\n\treturn button;\t\r\n}\r\n\r\nfunction addLog(group){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"log\";\r\n\tgroup.appendChild(div);\r\n\treturn div;\r\n}\r\n\r\nvar MinibarCount=0;\r\n\r\nfunction addMinibar(group){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"minibar\";\r\n\tdiv.id=\"minibar-\"+(MinibarCount++)\r\n\tgroup.appendChild(div);\r\n\treturn div;\r\n}\r\n\r\nvar ToolbarCount=0;\r\n\r\nfunction addToolbar(group,handler){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"group\";\r\n\tdiv.id=\"toolbar-\"+(ToolbarCount++)\r\n\tgroup.appendChild(div);\r\n\tif(handler){\r\n\t\tdiv.setAttribute(\"tabindex\",1);\r\n\t\tdiv.onkeydown=handler;\r\n\t\tdiv.onkeyup=handler;\r\n\t}\r\n\treturn div;\r\n}\r\n\r\nfunction addToolbar2(group,tools){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"group\";\r\n\tgroup.appendChild(div);\r\n\tfor(tool in tools){\r\n\t\taddButton(div,name,handler,)\r\n\t}\r\n\treturn div;\r\n}\r\n\r\nfunction hexString(byte){\r\n\treturn byte.toString(16).padStart(2, '0').toUpperCase();\r\n//\treturn (\"00\" + byte.toString(16)).substr(-2).toUpperCase();\r\n}\r\n\r\nfunction HexString(bytes){\r\n\tlet r=[];\r\n\tfor(let i=0;i<bytes.length;i++){\r\n\t\tlet b=bytes[i];\r\n\t\tr.push(\"0x\"+(b.toString(16).padStart(2,'0')));\r\n\t}\r\n\treturn r.join(\",\");\r\n}\r\n\r\n\r\nvar cellColumns={};\r\n\r\nfunction flushColumn(group){\r\n\tdelete cellColumns[group];\r\n}\r\n\r\nfunction addCell(group,address,value,name,info){\r\n\tvar label=hexString(address)+\" \"+name;\r\n\tlet nameinfo=name+\"<\"+label+info+\">\";\r\n\tvar cell=addInput(\"text\",group,nameinfo,\"div\",\"cell\");\r\n\tcell.value=hexString(value);\r\n\tcell.setAttribute(\"register\",\"\");\r\n\treturn cell;\r\n}\r\n\r\nfunction addRegister(group,address,reg){\r\n\tif(!(group in cellColumns)){\r\n\t\tcellColumns[group]=[];\r\n\t}\r\n\tvar top=cellColumns[group].length-1;\r\n\tif(top<0 || cellColumns[group][top].childElementCount>15){\r\n\t\tcellColumns[group][++top]=addSpan(\"column\",group);//,top);\r\n\t}\r\n\tvar column=cellColumns[group][top];\r\n\tvar cell=addCell(column,address,reg.value,reg.name,reg.description+\" level \"+reg.level);\r\n\tcell.setAttribute(\"register\",\"\");\r\n\treturn cell;\r\n}\r\n\r\nfunction setPageStyle(e){\r\n\tvar select=e.target;\r\n\tvar options=select.selectedOptions;\r\n\tvar option=options[0];\r\n\tvar value=option.getAttribute(\"value\");\r\n\tpageBody.setAttribute(\"palette\",value);\r\n}\r\n\r\nfunction addRadioButton(group,name,title,value,handler){\r\n\tvar button=addInput(\"radio\",group,title,\"span\",\"radio\");\r\n\tbutton.name=name;\r\n\tbutton.value=value;\r\n\tbutton.onclick=handler;\r\n\treturn button;\r\n}\r\n\r\nfunction addRadioButtons(group,name,tools,handler){\r\n\tvar div=document.createElement(\"div\");\r\n\tdiv.className=\"group\";\r\n\tgroup.appendChild(div);\r\n\tfor(var toolValue in tools){\r\n\t\tvar toolName=tools[toolValue];\r\n\t\taddRadioButton(div,name,toolName,toolValue,handler)\r\n\t}\r\n\treturn div;\r\n}\r\n\r\nfunction unselectCells(selected){\r\n\tfor(var cell of selected){\r\n\t\tcell.removeAttribute(\"selected\");\r\n\t}\r\n\tselected.length=0;\r\n}\r\n\r\nfunction selectCell(selected,grid,x,y){\r\n\tvar cell=grid[y][x];\r\n\tif(!cell.hasAttribute(\"selected\")){\r\n\t\tcell.setAttribute(\"selected\",\"\");\r\n\t\tselected.push(cell);\r\n\t}\r\n}\r\n\r\nfunction selectGrid(grid,selected,a,b,tool){\r\n\tswitch(tool){\r\n\t\tcase \"point\":\r\n\t\t\tselectCell(selected,grid,b.x,b.y);\r\n\t\t\tbreak;\t\r\n\t\tcase \"line\":\r\n\t\t\tunselectCells(selected);\r\n\t\tcase \"draw\":\t\t\t\r\n\t\t\tvar n=Math.max(Math.abs(a.x-b.x),Math.abs(a.y-b.y));\r\n\t\t\tvar x=a.x;\r\n\t\t\tvar y=a.y;\r\n\t\t\tfor(var i=0;i<=n;i++){\r\n\t\t\t\tselectCell(selected,grid,(x+0.5)|0,(y+0.5)|0);\r\n\t\t\t\tx+=(b.x-a.x)/n;\r\n\t\t\t\ty+=(b.y-a.y)/n;\r\n\t\t\t}\r\n\t\t\tbreak;\t\r\n\t\tcase \"link\":\r\n\t\t\tunselectCells(selected);\r\n\t\t\tbreak;\r\n\t\tcase \"box\":\r\n\t\t\tunselectCells(selected);\r\n\t\t\tvar w=Math.abs(a.x-b.x);\r\n\t\t\tvar h=Math.abs(a.y-b.y);\r\n\t\t\tvar left=Math.min(a.x,b.x);\r\n\t\t\tvar top=Math.min(a.y,b.y);\r\n\t\t\tfor(var x=left;x<=(left+w);x++){\r\n\t\t\t\tselectCell(selected,grid,x,top);\r\n\t\t\t\tselectCell(selected,grid,x,top+h);\r\n\t\t\t}\r\n\t\t\tfor(var y=top;y<=(top+h);y++){\r\n\t\t\t\tselectCell(selected,grid,left,y);\r\n\t\t\t\tselectCell(selected,grid,left+w,y);\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t\tcase \"rect\":\r\n\t\t\tunselectCells(selected);\r\n\t\t\tvar w=Math.abs(a.x-b.x);\r\n\t\t\tvar h=Math.abs(a.y-b.y);\r\n\t\t\tvar left=Math.min(a.x,b.x);\r\n\t\t\tvar top=Math.min(a.y,b.y);\r\n\t\t\tfor(var y=top;y<=(top+h);y++){\r\n\t\t\t\tfor(var x=left;x<=(left+w);x++){\r\n\t\t\t\t\tselectCell(selected,grid,x,y);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tbreak;\r\n\t}\r\n}\r\n\r\nfunction addStyleSelect(group,styles,onchange){\r\n\tvar select=addSelect(group,\"pagestyle\");\r\n\tfor(var style in styles){\r\n\t\tvar name=styles[style];\r\n\t\taddOption(select,style,name);\r\n\t}\r\n\tselect.onchange=onchange;\r\n\treturn select;\r\n}\r\n\r\nfunction addToggle(group,name,handler){\r\n\tvar input=addInput(\"checkbox\",group,name,\"span\");\r\n//\tvar input=addInput(\"checkbox\",group,name,\"span\",\"short\");\r\n\tinput.onchange=handler;\r\n\treturn input;\r\n}\r\n\r\nfunction addImage(group,handler){\r\n\tvar span=document.createElement(\"span\");\r\n\tspan.className=\"frame\";\r\n\tvar image=document.createElement(\"img\");\r\n\timage.onload=handler;\r\n\tspan.appendChild(image);\r\n\tgroup.appendChild(span);\r\n\treturn image;\r\n}\r\n\r\nfunction addSpan(type,group,name){\r\n\tvar span=document.createElement(\"span\");\r\n\tspan.className=type;\r\n\tif(name){\r\n\t\tvar text=document.createTextNode(name);\r\n\t\tspan.appendChild(text);\r\n\t}\r\n\tgroup.appendChild(span);\r\n\treturn span;\r\n}\r\n\r\n// layout stuff\r\n\r\nvar layoutBrush=\"point\";\r\nvar layoutTool=\"led\";\r\nvar layoutStart;\r\nvar layoutEnd;\r\nvar layoutSelected=[];\r\nvar layoutGrid=[];\r\n\r\nfunction onLayoutBrush(e){\r\n\tlayoutBrush=e.target.value;\r\n}\r\nfunction onLayoutTool(e){\r\n\tlayoutTool=e.target.value;\r\n}\r\n\r\nfunction downLayout(e){\r\n\tvar cell=e.target;\r\n\tlayoutStart={x:cell.getAttribute(\"x\")|0,y:cell.getAttribute(\"y\")|0};\r\n\tlayoutEnd=layoutStart;\r\n\tselectGrid(layoutGrid,layoutSelected,layoutStart,layoutEnd,layoutBrush);\r\n}\r\n\r\nfunction ledCell(cell){\r\n\tcell.setAttribute(\"led\",\"red\");\r\n}\r\nfunction levelCell(cell){\r\n\tcell.setAttribute(\"level\",\"grey\");\r\n}\r\n\r\nfunction upLayout(e){\r\n\tif(e.shiftKey) return;\r\n\tfor(const cell of layoutSelected){\r\n\t\tswitch(layoutTool){\r\n\t\t\tcase \"led\":\r\n\t\t\t\tledCell(cell);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"level\":\r\n\t\t\t\tlevelCell(cell);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\tunselectCells(layoutSelected);\t\r\n}\r\n\r\nfunction enterLayout(e){\r\n\tif(e.buttons){\r\n\t\tvar cell=e.target;\r\n\t\tlayoutEnd={x:cell.getAttribute(\"x\")|0,y:cell.getAttribute(\"y\")|0};\r\n\t\tselectGrid(layoutGrid,layoutSelected,layoutStart,layoutEnd,layoutBrush);\r\n\t\tif(layoutBrush==\"point\"||layoutBrush==\"draw\"){\r\n\t\t\tlayoutStart=layoutEnd;\r\n\t\t}\r\n\t}\r\n}\r\n\r\n// grids use layouts wip\r\n\r\nfunction addGrid(panel,width,height){\r\n\tvar grid=[];\r\n\tfor(var y=0;y<height;y++){\r\n\t\tgrid[y]=[];\r\n\t\tfor(var x=0;x<width;x++){\r\n\t\t\tvar span=addSpan(\"quad\",panel,x+\",\"+y);\r\n\t\t\tspan.setAttribute(\"x\",x);\r\n\t\t\tspan.setAttribute(\"y\",y);\r\n\t\t\tspan.onmousedown=downLayout;\r\n\t\t\tspan.onmouseenter=enterLayout;\r\n\t\t\tspan.onmouseup=upLayout;\r\n\t\t\tgrid[y][x]=span;\r\n\t\t}\r\n\t\tvar brk=document.createElement(\"br\");\r\n\t\tpanel.appendChild(brk);\r\n\t}\r\n\treturn grid;\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitrolsystem.js\",\"length\":536,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitrolsystem.js\r\n// (c) 2024 nitrologic \r\n// All rights reserved\r\n\r\n// algorithm courtesy Aristid Lindenmayer\r\n\r\nclass LSystem {\r\n\tconstructor() {\r\n\t\tthis.rules = {};\r\n\t}\r\n\r\n\tsetRule(symbol, replacement) {\r\n\t\tthis.rules[symbol] = replacement;\r\n\t}\r\n\r\n\texpand(axiom, iterations) {\r\n\t\tlet currentString = axiom;\r\n\t\tfor (let i = 0; i < iterations; i++) {\r\n\t\t\tlet nextString = '';\r\n\t\t\tfor (let char of currentString) {\r\n\t\t\t\tnextString += this.rules[char] || char;\r\n\t\t\t}\r\n\t\t\tcurrentString = nextString;\r\n\t\t}\r\n\t\treturn currentString;\r\n\t}\r\n}","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker_baker.js\",\"length\":12101,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_baker.js\r\n\r\n// one per TopoTile\r\n\r\n// a worker thread for processing heightmaps for a topo tile\r\n\r\nconst FloraPen=32;\r\n\r\nconst SeaLevel=186*16;\t//depth of Taupo nui a Tia\r\nconst TopoLevel=0x4000;\r\n\r\n//const _unicode = new TextEncoder();\r\n\r\nlet topoCount;\r\nconst heightmaps=[];\r\n\r\n//let outgoingBaker=[];\r\n//let connectedBaker=false;\r\n\r\nonmessage = (message) => {\r\n\tconst commands=message.data;\r\n\tfor(const line of commands){\r\n//\t\tconsole.log(\"wire_baker \",line);\r\n\t\tswitch(line.command){\r\n\t\t\tcase \"heightmap\":\r\n\t\t\t\tonHeightmap(line.array);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"bake\":\r\n\t\t\t\tonTopoCount(line.value);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"build\":\r\n\t\t\t\tonBuild(line.value);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n//\tconsole.log(\"wire_baker woke\",data.name);\r\n//\toutgoing.push(data);\r\n}\r\n\r\nfunction refresh(){\r\n\tif(topoCount==heightmaps.length){\r\n//\t\tdebugger;\r\n\t\tcreateTopo();\r\n\t}\r\n}\r\n\r\nfunction onHeightmap(rawbytes){\r\n\tif(rawbytes.length==0){\r\n//\t\treturn;\r\n\t}\r\n\theightmaps.push(rawbytes);\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildTopo(plan){\r\n\t\r\n}\r\n\r\nfunction onTopoCount(count){\r\n\ttopoCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction onBuildCount(count){\r\n\tbuildCount=count;\r\n\trefresh();\r\n}\r\n\r\nfunction AllocBumpmap(bytes){\r\n\tconst res=bytes.length?Math.sqrt(bytes.length/4):1;\r\n\tconst map=new Bumpmap();\r\n\tmap.reset(res);\r\n\treturn map;\r\n}\r\n\r\nfunction createTopo(){\r\n\tconst bytes=heightmaps[0]||[];\r\n\tconst heightmap=AllocBumpmap(bytes);\r\n\theightmap.setBytes(bytes);\r\n\tconst n=heightmaps.length;\r\n\tfor(let i=1;i<n;i++){\r\n\t\tif(heightmaps[i].length==bytes.length){\r\n\t\t\theightmap.orBytes(heightmaps[i]);\r\n\t\t}\r\n\t\telse{\r\n//\t\t\theightmap.setBytes(heightmaps[i]);\r\n\t\t}\r\n\t}\r\n// simon come here and fix up flora\r\n//\theightmap.heal(n);\r\n\r\n//\theightmap.postFlora(1024,2,15,2);\r\n//\theightmap.postFlora(512,4,15,2);\r\n\theightmap.postFlora(256,8,FloraPen,22);\r\n//\theightmap.postFlora(128,16,0,22);\r\n\r\n\theightmap.post();\r\n\r\n\theightmaps.length=0;\r\n}\r\n\r\nclass Bumpmap{\r\n\tpost(){\r\n\t\tconst topo=this.topo;\r\n\t\tconst diff=this.diff;\r\n\t\tconst ground=this.ground;\r\n\t\tconst message=[{command:\"bump\",topo,diff,ground}];\r\n\t\tconst transfer=[topo.buffer,diff.buffer,ground.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n// a worker method that replies with a \"flora\" message containing a surface for flora placement\r\n\r\n\tpostFlora(count,mag,c,floraMin){\r\n\t\tconst p=2048/count;\r\n\t\tconst res=count+1;\r\n\t\tconst a=new Array(res);\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\ta[y]=new Array(res);\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tlet h0=this.pickElevation(x*p,y*p);\r\n\t//\t\t\tlet h1=topo.pickHeight(x*p,y*p);\r\n\t\t\t\tconst m=this.pickHeightMinMax(x*p,y*p);\r\n\t\t\t\tif(m.min>floraMin){\r\n\t\t\t\t\tconst h1=m.max;\r\n\t\t\t\t\ta[y][x]=h0+h1;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst vverts=[];\r\n\t\tconst v=[];\r\n\t\tconst i=[];\r\n\t\tfor(let y=0;y<=count;y++){\r\n\t\t\tfor(let x=0;x<=count;x++){\r\n\t\t\t\tconst mz=a[y][x];\r\n\t\t\t\tlet vert=-1;\r\n\t\t\t\tif(mz){\r\n\t\t\t\t\tconst mx=mag*x;\r\n\t\t\t\t\tconst my=-mag*y;\r\n\t\t\t\t\tvert=v.length;\r\n\t\t\t\t\tv.push([mx,my,mz,c, 0,0,0,0]);\r\n\t\t\t\t}\r\n\t\t\t\tvverts.push(vert);\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst d=count+1;\r\n\t\tfor(let y=0;y<count;y++){\r\n\t\t\tfor(let x=0;x<count;x++){\r\n\t\t\t\tconst v0=vverts[y*res+x];\r\n\t\t\t\tconst v1=vverts[y*res+x+1];\r\n\t\t\t\tconst v2=vverts[(y+1)*res+x+1];\r\n\t\t\t\tconst v3=vverts[(y+1)*res+x];\r\n\t\t\t\tif(v0>-1&&v1>-1&&v2>-1&&v3>-1){\r\n\t\t\t\t\ti.push([v0,v2,v1]);\r\n\t\t\t\t\ti.push([v0,v3,v2]);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tconst verts=new Int32Array(v.flat());\r\n\t\tconst indices=new Int32Array(i.flat());\r\n\t\tconst message=[{command:\"flora\",verts,indices}];\r\n\t\tconst transfer=[verts.buffer,indices.buffer];\r\n\t\tpostMessage(message,transfer);\r\n\t}\r\n\r\n\treset(res){\r\n\t\tthis.resolution=res;\t\t\r\n\t\tthis.topo=new Uint16Array(res*res);\r\n\t\tthis.diff=new Uint16Array(res*res);\r\n\t\tthis.ground=new Uint16Array(res*res);\r\n\t}\r\n\r\n\tcreate(topo,diff,ground){\r\n\t\tconst res=topo.length;\r\n\t\tthis.topo=topo;\r\n\t\tthis.diff=diff;\r\n\t\tthis.ground=ground;\r\n\t}\r\n\r\n\tclear(){\r\n\t\tthis.topo.fill(0);\r\n\t\tthis.diff.fill(0);\r\n\t\tthis.ground.fill(0);\r\n\t}\r\n\r\n\tsetBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\t\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n\t//\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}else{\r\n\t\t\t\t\ttopo[i]=-TopoLevel;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\torBytes(bytes){\r\n\t\tconst topo=this.topo;\r\n\t\tif (bytes.length==0) {\r\n\t\t\ttopo[0]=-0x4000;\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n//\t\tconst ground=this.ground;\r\n\t\tconst n=bytes.length;\r\n//\t\tconsole.log(\"Bumpmap n:\"+n+\" res:\"+res);\r\n\t\tlet p=0;\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet h=(bytes[p+1]<<8)+bytes[p+0];\r\n\t\t\t\tif(h){\r\n\t\t\t\t\th=(h-SeaLevel);\r\n\t\t\t\t\ttopo[i]=h-TopoLevel;\r\n\t\t\t\t\tlet d=(bytes[p+3]<<8)+bytes[p+2];\r\n\t\t\t\t\td=(d&0x7fff);\r\n\t\t\t\t\tif(d==0x7fff) d=0;\r\n\t\t\t\t\tif(d) {\r\n\t\t\t\t\t\td=d-0x1000;\r\n//\t\t\t\t\t\tif(d<20) d=0;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdiff[i]=d;\r\n\t\t\t\t}\r\n\t\t\t\ti++;\r\n\t\t\t\tp+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\t\t\r\n\theal(srccount){\r\n\t\tlet count=0;\r\n\t\tconst topo=this.topo;\r\n\t\tconst res=this.resolution;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tconst i=y*res+x;\r\n\t\t\t\tlet h=topo[i];\r\n\t\t\t\tif(h==0){\r\n\r\n//\t\t\t\t\ttopo[i]=SeaLevel-TopoLevel;\r\n\t\t\t\t\t// simon come here\r\n/*\r\n\t\t\t\t\tif(x>0&&topo[i-1]) h=topo[i-1];\r\n\t\t\t\t\tif(y>0&&topo[i-res]) h=topo[i-res];\r\n\t\t\t\t\tif(x<res-1&&topo[i+1]) h=topo[i+1];\r\n\t\t\t\t\tif(y<res-1&&topo[i+res]) h=topo[i+res];\r\n\t\t\t\t\ttopo[i]=h;\r\n*/\t\t\t\t\t\r\n\t\t\t\t\tcount++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(count){\r\n//\t\t\tdebugger;\r\n\t\t}\r\n\t}\r\n\r\n\tprocess(){\r\n\t\tthis.contract();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t\tthis.expand();\r\n\t}\r\n\r\n\tpickTopo(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*8;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax,ay-m);\r\n\t\tconst h2=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h3=this.pickElevation(ax-m,ay);\r\n\t\tconst h4=this.pickElevation(ax,ay);\r\n\t\tconst h5=this.pickElevation(ax+m,ay);\r\n\t\tconst h6=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h7=this.pickElevation(ax,ay+m);\r\n\t\tconst h8=this.pickElevation(ax+m,ay+m);\r\n\t\tconst ground=this.pickGround(ax,ay);\r\n\t\tconst min=Math.min(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\tconst max=Math.max(h0,h1,h2,h3,h4,h5,h6,h7,h8);\r\n\t\treturn {min,max,ground};\r\n\t}\r\n\r\n\r\n\t// pick is a get without filter \r\n\r\n\tpickMinMax2(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tconst m=factor*0.5;\r\n\t\tconst h0=this.pickElevation(ax-m,ay-m);\r\n\t\tconst h1=this.pickElevation(ax+m,ay-m);\r\n\t\tconst h2=this.pickElevation(ax-m,ay+m);\r\n\t\tconst h3=this.pickElevation(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tpickHeightMinMax(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n//\t\tconst m=factor*0.5;\r\n\t\tconst m=factor*1.0;\r\n\t\tconst h0=this.pickHeight(ax-m,ay-m);\r\n\t\tconst h1=this.pickHeight(ax+m,ay-m);\r\n\t\tconst h2=this.pickHeight(ax-m,ay+m);\r\n\t\tconst h3=this.pickHeight(ax+m,ay+m);\r\n\t\tconst min=Math.min(h0,h1,h2,h3);\r\n\t\tconst max=Math.max(h0,h1,h2,h3);\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tsampleHeight(ax,ay,r){\r\n\t\tconst span=this.resolution;\r\n\t\tconst factor=span/2048;\r\n\t\tlet min=1e6;\r\n\t\tlet max=-1e6;\r\n\t\tfor(let mx=-r;mx<=r;mx+=0.5){\r\n\t\t\tfor(let my=-r;my<=r;my+=0.5){\r\n\t\t\t\tif(mx*mx+my*my>r*r) continue;\r\n\t\t\t\tconst h=this.pickHeight(ax+mx,ay+my);\r\n\t\t\t\tif(h<min)min=h;\r\n\t\t\t\tif(h>max)max=h;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn {min,max};\r\n\t}\r\n\r\n\tindex(ax,ay){\r\n\t\tconst span=this.resolution;\r\n\t\tconst limit=span-1;\r\n\t\tconst factor=span/2048;\t//span or limit???\r\n\r\n\t\tax=(0.5+(ax*factor))|0;\t// shift is tilesize/res-1\r\n\t\tay=(0.5+(ay*factor))|0;\r\n\r\n\t\tif(ax<0) ax=0;\r\n\t\tif(ay<0) ay=0;\r\n\t\tif(ax>limit)ax=limit;\r\n\t\tif(ay>limit)ay=limit;\r\n\t\treturn ax+ay*span;\r\n\t}\r\n\r\n\tpickHeight(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tconst h=this.diff[i];\r\n\t\treturn h;\r\n\t}\r\n\t\r\n\tpickElevation(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tpickGround(ax,ay){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tlet h=this.ground[i];\r\n\t\tif(h==0) h=this.topo[i];\r\n\t\treturn h;\r\n\t}\r\n\r\n\tsetGround(ax,ay,depth){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.ground[i]=depth;\r\n\t}\r\n\tsetElevation(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.topo[i]=h;\r\n\t}\r\n\tsetHeight(ax,ay,h){\r\n\t\tconst i=this.index(ax,ay);\r\n\t\tthis.diff[i]=h;\r\n\t}\r\n\r\n\tcontract(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst inner=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet miss=0;\r\n\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n\t\t\t\t\t\t\tif(d2<20) miss++;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tlet d=diff[y*res+x];\r\n\t\t\t\tif(miss>0) d=0;\r\n\t\t\t\tinner[i++]=d;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=inner;\r\n\t}\r\n\r\n\texpand(){\r\n\t\tconst res=this.resolution;\r\n\t\tconst diff=this.diff;\r\n\t\tconst outer=new Uint16Array(res*res);\r\n\t\tlet i=0;\r\n\t\tfor(let y=0;y<res;y++){\r\n\t\t\tfor(let x=0;x<res;x++){\r\n\t\t\t\tlet d=diff[i];\r\n\t\t\t\tif(d<20){\r\n\t\t\t\t\tfor(let yy=y-1;yy<y+2;yy++){\r\n\t\t\t\t\t\tfor(let xx=x-1;xx<x+2;xx++){\r\n\t\t\t\t\t\t\tif(xx>=0 && yy>=0 && xx<res && yy<res){\r\n\t\t\t\t\t\t\t\tconst d2=diff[yy*res+xx];\r\n//\t\t\t\t\t\t\t\tif(d2>0 && (d==0 || d2<d)) d=d2;\r\n\t\t\t\t\t\t\t\tif(d2>d) d=d2;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\touter[i]=d;\r\n\t\t\t\ti++;\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.diff=outer;\r\n\t}\r\n}\r\n\r\n\r\n\r\n/*\r\n\r\nfunction heartbeat(){\r\n\tconst messages=outgoing;\r\n\toutgoing=[];\r\n\tif(connected){\r\n\t\tpost(\"tick\",messages);\r\n\t}\r\n}\r\n\r\nlet timer=setInterval(heartbeat,500);\r\n\r\nfunction post(name,body){\r\n\tevent={name:name,body:body};\r\n\tconst js=JSON.stringify(event);\r\n\tconst bytes=_unicode.encode(js);\r\n\tconst t0=new Date();\r\n\tfetch(\"/fetch\",{\r\n\t\tmethod:'POST',\r\n\t\theaders: {\r\n\t\t\t'Content-Type': 'application/json',\r\n\t\t\t'Content-Length': bytes.length\r\n\t\t},\r\n\t\tbody: bytes\r\n\t})\r\n\t.then(response => response.json())\r\n\t.then(data => {\r\n//\t\tconsole.log(data);\r\n\t\tconst t1=new Date();\r\n\t\tconst d=t1-t0;\r\n\t\tpostMessage({ping:d});\r\n\t});\t\t\r\n}\r\n\r\n*/\r\n\r\n\r\n// 0x4000 is new zero, count is typically 128, short index friendly\r\n\r\n// in which verticy sample is too steep skip edge\r\n\r\nfunction CreateTopoSurface(count,m,c,topo){\r\n\tconst a=new Array(count+1);\r\n\tconst p=2048/count;\r\n\tfor(let y=0;y<=count;y++){\r\n\t\ta[y]=new Array(count+1);\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tlet h=topo.pickTopo(x*p,y*p);\r\n\t\t\ta[y][x]=h;\r\n\t\t}\r\n\t}\r\n\t\r\n\tlet v=[];\r\n\tconst i=[];\r\n\r\n\tconst crack=[];\r\n\tconst max=[];\r\n\r\n\tfor(let y=0;y<=count;y++){\r\n\t\tfor(let x=0;x<=count;x++){\r\n\t\t\tconst mx=m*x;\r\n\t\t\tconst my=-m*y;\r\n\t\t\tconst ground=a[y][x].ground;\r\n\t\t\tconst minz=a[y][x].min;\r\n\t\t\tconst maxz=a[y][x].max;\r\n\t\t\tlet bits=0;\r\n\t\t\tif(ground==0 && maxz-minz>12){\r\n\t\t\t\tmax.push(crack.length);\r\n\t\t\t\tbits=1;\r\n\t\t\t\tcrack.push([mx,my,maxz,c, 0,0,0,bits]);\r\n\t\t\t}else{\r\n\t\t\t\tmax.push(-1);\r\n\t\t\t}\r\n\t\t\tconst z=ground||minz;\r\n\t\t\tv.push([mx,my,z,c, 0,0,0,bits]);\r\n\t\t}\r\n\t}\r\n\tconst crackOffset=v.length;\r\n\tv=v.concat(crack);\r\n\r\n\tconst d=count+1;\r\n\tfor(let y=0;y<count;y++){\r\n\t\tfor(let x=0;x<count;x++){\r\n\t\t\tconst v0=x+y*d;\r\n\t\t\tconst v1=x+1+y*d;\r\n\t\t\tconst v2=x+(y+1)*d;\r\n\t\t\tconst v3=x+1+(y+1)*d;\r\n\t\t\t\r\n\t\t\tconst b0=v[v0][7];\r\n\t\t\tconst b1=v[v1][7];\r\n\t\t\tconst b2=v[v2][7];\r\n\t\t\tconst b3=v[v3][7];\r\n\r\n\t\t\tif(!(b0|b1|b2|b3)){\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t\ti.push(v1);\r\n\r\n\t\t\t\ti.push(v0);\r\n\t\t\t\ti.push(v2);\r\n\t\t\t\ti.push(v3);\r\n\t\t\t}else{\r\n\t\t\t\tconst m0=max[v0]>=0?crackOffset+max[v0]:v0;\r\n\t\t\t\tconst m1=max[v1]>=0?crackOffset+max[v1]:v1;\r\n\t\t\t\tconst m2=max[v2]>=0?crackOffset+max[v2]:v2;\r\n\t\t\t\tconst m3=max[v3]>=0?crackOffset+max[v3]:v3;\r\n\r\n\t\t\t\tif(b0||b3||b1){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\t\t\t\tif(b0||b2||b3){\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b1||b0){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t\ti.push(m0);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif(b2||b3||b1){\r\n\t\t\t\t\ti.push(m2);\r\n\t\t\t\t\ti.push(m3);\r\n\t\t\t\t\ti.push(m1);\r\n\t\t\t\t}\r\n\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn new Surface(v,i,[]);\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitroshape.js\",\"length\":6689,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitroshape.js\r\n// (c)2024 nitrologic \r\n// All rights reserved\r\n\r\n\"use strict\"\r\n\r\nclass Drawing{\r\n\r\n\tconstructor(){\r\n\t\tthis.list=[];\t\r\n\t}\r\n\r\n\taddPaths(xyxy){\r\n\t\tthis.list.push(xyxy);\r\n\t}\r\n\r\n\tdrawPaths(context){\r\n\t\tcontext.beginPath();\r\n\t\tfor(var xyxy of this.list)\r\n\t\t{\r\n\t\t\tvar i=0;\r\n\t\t\twhile( i < xyxy.length ){\r\n\t\t\t\tvar x0=xyxy[i+0];\r\n\t\t\t\tvar y0=xyxy[i+1];\r\n\t\t\t\tvar x1=xyxy[i+2];\r\n\t\t\t\tvar y1=xyxy[i+3];\r\n\t\t\t\tcontext.moveTo(x0,y0);\r\n\t\t\t\tcontext.lineTo(x1,y1);\r\n\t\t\t\ti+=4;\r\n\t\t\t}\r\n\t\t}\r\n\t\tcontext.stroke();\r\n\t}\r\n};\r\n\r\n\r\n// a processing core built into single displays\r\n\r\nconst EightColorPalette=[\"black\",\"red\",\"green\",\"blue\",\"yellow\",\"cyan\",\"magenta\",\"white\"];\t\r\n\r\nlet pcmTimes={};\r\n\r\nclass DisplayBIOS{\r\n\tconstructor(){\r\n\t\tthis.shapeBuffer=new ShapeBuffer();\r\n\t\tthis.shapeBuffer.addPoint(0,0,20,4);//xyrc yellow sun\r\n\t\tthis.shapeBuffer.addShape(30,40,0,2,2,0);//xyarci green wire triangle\r\n\t\tthis.palette=EightColorPalette;\r\n\t\tthis.mousedown=false;\r\n\t\tthis.mousex=0;\r\n\t\tthis.mousey=0;\r\n\t\tthis.aspect=1;\r\n\t\tthis.width=0;\r\n\t\tthis.height=0;\r\n\t\tthis.originx=0;\r\n\t\tthis.originy=0;\r\n\t\tthis.frameCount=0;\r\n\t\tthis.dirty=true;\r\n\t\tthis.delays={};\r\n\t}\t\r\n\r\n\trefresh(){\r\n\t\tthis.frameCount++;\r\n\t}\r\n\r\n\tonGeo(e){\r\n\t\tlet source=e.source;\r\n\t\tlet pos=e.coords;\r\n\t\tlog(\"onGeo source:\"+source+\" pos:\"+JSON.stringify(pos));\r\n\t}\r\n\r\n\tonDraw(shape){\r\n\r\n\t\tlet frame=new ShapeBuffer();\r\n\r\n//\t\tconsole.log(\"DisplayBIOS onDraw shape:\"+shape);\r\n\t\tfor(var content of shape.content){\r\n\t\t\tlet lines=content.lines;\r\n\t\t\tfor(let line of lines){\r\n\t\t\t\tconsole.log(\"line:\"+line);\r\n//\t\t\t\tdrawLine(line[0],line[1],line[2],line[3]);\r\n\t\t\t\tframe.addPoint(line[0],line[1],10,4);\r\n\t\t\t\tframe.addPoint(line[2],line[3],10,4);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tthis.shapeBuffer=frame;\r\n\t}\r\n\r\n\t// type: button|stick,\r\n\t// buttons: x y a b lb rb ls rs lc rc\r\n\t// controller,type,control,value\r\n\r\n\tonKey(remote,keycode,depressed){\r\n\t\tconsole.log(\"DisplayBIOS onKey remote:\"+remote+\" keycode:\"+keycode+\" depressed:\"+depressed);\r\n\r\n\t}\r\n\r\n\tonModify(remote,mod){\r\n\t\tlet m=mod.join(\",\");\r\n\t\tconsole.log(\"DisplayBIOS onModify remote:\"+remote+\" modify:\"+m);\r\n\t}\r\n\r\n/*\r\n\t\t\t\tif(delay>0){\r\n//\t\t\t\t\tconsole.log(\"onMidiIn delay : \"+delay);\r\n\t\t\t\t\tsetTimeout(this.onMidi.bind(this,e),delay);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tthis.onMidi(e);\r\n\t\t\t\t}\r\n\r\n*/\r\n\r\n/*\r\n// e is event from onTick with additional tick and source fields\r\nonAudioIn(e){\r\n\tlet now=performance.now();\r\n\tconsole.log(\"audioIn\");\r\n\tlet src=e.src;\r\n\tlet data=e.data;//hex16\r\n\tlet t=e.timeStamp;\r\n\tlet t0=pcmTimes[e.source];\r\n\tif(t0 && t<t0){\r\n\t\tconsole.log(\"onAudioIn pcm underrun\");\r\n\t}\r\n\tpcmTimes[e.source]=t;\r\n}\r\n\r\nonAudio(e){ \r\n\tvar payload=e.data;\r\n\tvar ts=(e.timeStamp*10)|0;\r\n}\r\n*/\r\n\tonControlIn(e){\r\n\t\tlet now=performance.now();\r\n\t\tlet time=e.time;\r\n\t\tlet tick=e.tick;\r\n\t\tlet source=e.source;\r\n\t\tlet delay=0;\r\n\t\tif(source in this.delays){\r\n\t\t\tlet t=this.delays[source];\r\n\t\t\tlet delta1=(time-t.time)/10; // midi clock in millis\r\n\t\t\tlet delta2=now-t.now; // wall clock in millis\r\n\t\t\tdelay=12+delta1-delta2;\r\n\t\t}else{\r\n\t\t\tif(time!=0){\r\n\t\t\t\tthis.delays[source]={time,now};\r\n\t\t\t}\r\n\t\t}\r\n\t\t// todo; introduce delay\r\n\t\tthis.onControl(e);\r\n\t}\r\n\r\n\tonControl(e){ \r\n\t\tvar payload=e.data;\r\n\t\tvar ts=(e.timeStamp*10)|0;\r\n\t\tvar remote=(\"source\" in e)?e.source:0;\r\n\t\tswitch(payload.event){\r\n\t\t\tcase \"connect\":\r\n\t\t\t\tconsole.log(\"onControl connect remote : \"+remote);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"modify\":\r\n//\t\t\t\tconsole.log(\"onControl modify remote : \"+remote);\r\n\t\t\t\tvar mods=payload.mods;\r\n\t\t\t\tfor(var mod of mods){\r\n\t\t\t\t\tthis.onModify(remote,mod);\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"keydown\":\r\n\t\t\t\tthis.onKey(remote,payload.keycode,true);\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"keyup\":\r\n\t\t\t\tthis.onKey(remote,payload.keycode,false);\r\n\t\t\t\tbreak;\r\n\t\t\tdefault:\r\n\t\t\t\tconsole.log(\"onControl unhandled event : \"+payload.event);\r\n\t\t}\r\n\t}\t\r\n\r\n\tresize(w,h,ratio){\r\n\t\tthis.width=w;\r\n\t\tthis.height=h;\r\n\t\tthis.pixelratio=ratio;\r\n\t\tthis.aspect=w/h;\r\n\t\tthis.dirty=true;\r\n//\t\tthis.mousedown=false;\r\n\t}\r\n\r\n\tdraw(context){\r\n\t\tvar w=this.width;\r\n\t\tvar h=this.height;\t\t\r\n\t\t// maybe check dirty flag\r\n\t\tcontext.resetTransform();\r\n\t\tcontext.scale(this.pixelratio,this.pixelratio);\r\n\t\tcontext.clearRect(0, 0, w, h);\r\n\t\tcontext.fillStyle = \"black\";\r\n\t\tcontext.strokeStyle = \"white\";\r\n\t\tcontext.lineWidth = 1.25;\r\n\r\n\t\tthis.originx=-this.frameCount%w;\r\n\r\n\t\tthis.shapeBuffer.drawPoints(context,this.palette,this.originx,this.originy);\r\n\t\tthis.shapeBuffer.drawShapes(context,this.palette,this.originx,this.originy);\r\n\r\n\t\tcontext.resetTransform();\r\n\t}\t\r\n}\r\n\r\nconst PointSize=4;\r\nconst MaxPoints=1e6;\r\n\r\nconst ShapeSize=6;\r\nconst MaxShapes=1e6;\r\n\r\nfunction circlePath(){\r\n\tvar path=new Path2D();\r\n\tpath.arc(0,0,1,0,2*Math.PI);\r\n\treturn path;\r\n}\r\n\r\nfunction geomPath(nxy){\r\n\tvar path=new Path2D();\r\n\tvar i=0;\r\n\twhile(i<nxy.length){\r\n\t\tvar n=nxy[i++];\r\n\t\tvar x=nxy[i++];\r\n\t\tvar y=nxy[i++];\r\n\t\tpath.moveTo(x,y);\r\n\t\tfor(var j=1;j<n;j++){\r\n\t\t\tvar x0=x;\r\n\t\t\tvar y0=y;\r\n\t\t\tx=nxy[i++];\r\n\t\t\ty=nxy[i++];\r\n\t\t\tpath.lineTo(x,y);\r\n\t\t}\r\n\t}\r\n\treturn path;\r\n}\r\n\r\nclass ShapeBuffer{\r\n\tconstructor(){\r\n\t\tthis.xyrc16=new Int16Array(MaxPoints*PointSize);\r\n\t\tthis.xyarci16=new Int16Array(MaxShapes*ShapeSize);\r\n\r\n\t\tthis.pointCount=0;\r\n\t\tthis.shapeCount=0;\r\n\r\n\t\tthis.pointpath=circlePath();\r\n\t\tthis.trianglepath=geomPath([3,0,0,10,0,0,10,0,0]);\r\n\t\t\r\n//\t\tnew Path2D();\r\n//\t\tthis.pointpath.arc(0,0,1,0,2*Math.PI);\r\n\r\n//\t\tthis.pointpath=new Path2D();\r\n//\t\tthis.pointpath.arc(0,0,1,0,2*Math.PI);\r\n\r\n\t}\r\n\r\n\taddShape(x,y,a,r,c,i){\r\n\t\tvar j=this.shapeCount*ShapeSize;\r\n\t\tthis.xyarci16[j+0]=x;\r\n\t\tthis.xyarci16[j+1]=y;\r\n\t\tthis.xyarci16[j+2]=a;\r\n\t\tthis.xyarci16[j+3]=r;\r\n\t\tthis.xyarci16[j+4]=c;\r\n\t\tthis.xyarci16[j+5]=i;\r\n\t\treturn this.shapeCount++;\r\n\t}\t\r\n\r\n\taddPoint(x,y,r,c){\r\n\t\tvar i=this.pointCount*PointSize;\r\n\t\tthis.xyrc16[i+0]=x;\r\n\t\tthis.xyrc16[i+1]=y;\r\n\t\tthis.xyrc16[i+2]=r;\r\n\t\tthis.xyrc16[i+3]=c;\r\n\t\treturn this.pointCount++;\r\n\t}\r\n\r\n\tdrawPoints(context,palette,originx,originy){\r\n\t\tfor(var i=0;i<this.pointCount;i++){\r\n\t\t\tvar j=i*PointSize;\r\n\t\t\tvar x=this.xyrc16[j+0];\r\n\t\t\tvar y=this.xyrc16[j+1];\r\n\t\t\tvar r=this.xyrc16[j+2];\r\n\t\t\tvar c=this.xyrc16[j+3];\r\n\t\t\tvar path=this.pointpath;\r\n\t\t\tcontext.setTransform(r,0,0,r,x-originx,y-originy);\r\n\t\t\tcontext.beginPath();\r\n\t\t\tcontext.fillStyle = palette[c];\r\n\t\t\tcontext.fill(path);\r\n\t\t}\t\r\n\t}\r\n\r\n\tdrawShapes(context,palette,originx,originy){\r\n\t\tfor(var i=0;i<this.shapeCount;i++){\r\n\t\t\tvar j=i*ShapeSize;\r\n\t\t\tvar x=this.xyarci16[j+0];\r\n\t\t\tvar y=this.xyarci16[j+1];\r\n\t\t\tvar a=this.xyarci16[j+2];\r\n\t\t\tvar r=this.xyarci16[j+3];\r\n\t\t\tvar c=this.xyarci16[j+4];\r\n\t\t\tvar i=this.xyarci16[j+5];\r\n\t\t\tvar path=this.trianglepath;\r\n\t\t\tcontext.setTransform(r,0,0,r,x-originx,y-originy);\r\n\t\t\tcontext.beginPath();\r\n\t\t\tcontext.strokeStyle = palette[c];\r\n\t\t\tcontext.stroke(path);\r\n\t\t}\t\r\n\t}\r\n\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/nitro-vsynth.js\",\"length\":9812,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// nitro-vsynth.js\r\n// (c)2025 Simon Armstrong \r\n// All rights reserved\r\n\r\n// based on synth vicious from the skid monkey2 m2 projects\r\n// https://github.com/nitrologic/m2\r\n\r\n\"use strict\"\r\n\r\nvar synthSplit=false;\r\nvar synthSplitMiddle=60;\r\n\r\nvar synthRemote;\r\n\r\nvar synthLocalArray=[];\r\nvar synthRemoteArray=[];\r\n\r\nvar synthScope;\r\n\r\nvar synthLocal;\r\nvar synthLocalRight;\r\n\r\n// undocumented +1 \r\nfunction SetSynthChannel(channel){\r\n\tlet node=synthLocalArray[channel];\r\n\tif(node){\r\n\t\tsynthLocal=node;\r\n\t\tsynthLocal.post([{command:\"snapshot\"}]);\r\n\t}\r\n\r\n\tlet rnode=synthLocalArray[channel+1];\r\n\tif(rnode){\r\n\t\tsynthLocalRight=rnode;\r\n//\t\tsynthLocal.post([{command:\"snapshot\"}]);\r\n\t}\r\n\r\n}\r\n\r\n// split keyboard option\r\nfunction OnLocalMidi(e){\r\n\tlet synth=synthLocal;\r\n\tif(e.src==\"midi\"){\r\n\t\tlet data=e.data;\r\n\t\tlet code=data[0];\r\n\t\tif(code==144||code==128){\r\n\t\t\tlet note=data[1];\r\n\t\t\tif(synthSplit&&note>=synthSplitMiddle){\r\n\t\t\t\tsynth=synthLocalRight;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tsynth.onMidi(e)\r\n}\r\n\r\n\r\n// TODO: integrate with patcheditor\r\nfunction OnSynth(e){\r\n}\r\n\r\n\r\n// connects vsynth state to dspdisplay gui\r\nfunction OnSynth2(e){\r\n\tlet name=e.name; // local 0\r\n\tif(name==synthLocal.name){\r\n\t\tlet js=JSON.stringify(e.state,null,\" \");\r\n\r\n\t\tlog(\"OnSynth name:\"+name+\" state:\"+js);\r\n\r\n\t\tlet state=e.state;\r\n\t\tif(state.effecting!=!!effectState){\r\n\t\t\ttoggleEffect();\r\n\t\t}\r\n\t\tif(state.arp.hold!=!!holdState){\r\n\t\t\ttoggleHold();\r\n\t\t}\r\n\t\tlet mod=state.modulate*100/127;\r\n\t\tsoundMod.value=mod;\r\n\t\tlet detune=100*state.detune;\r\n\t\tif(detune>0){\r\n\t\t\tsoundGas.value=detune;\r\n\t\t\tsoundBrake.value=0;\r\n\t\t}else{\r\n\t\t\tsoundGas.value=0;\r\n\t\t\tsoundBrake.value=-detune;\r\n\t\t}\r\n\t\tlet arp=state.arp;\r\n\t\tlet output=arp.output;\r\n//\t\tlet tone=output.tone;\r\n\t\tlet voice=\"+\"+output.oscillator;\r\n\t\tsoundVoice.value=voice;\r\n\t\tlet power=\"+\"+output.power;\r\n\t\tsoundPower.value=power;\r\n\t\tlet mode=\"+\"+state.mode;\r\n\t\tsoundMode.value=mode;\r\n\t\tlet algo=\"+\"+arp.algorithm;\r\n\t\tsoundAlgorithm.value=algo;\r\n\t\tlet prog=\"+\"+arp.progression;\r\n\t\tsoundProgression=prog;\r\n\t\tlet divisor=\"+\"+arp.divisor;\r\n\t\tsoundDivisor.value=divisor;\r\n\t\tlet duty=arp.dutyCycle;\r\n\t\tlet index=DutyCycle.indexOf(duty);\r\n\t\tif(index!=-1){\r\n\t\t\tsoundDuty.value=\"+\"+index;\r\n\t\t}\r\n\t\tlet reps=arp.repeats;\r\n\t\tsoundRepeat.value=\"+\"+reps;\r\n\t}\r\n}\r\n\r\n// performance messages\r\nfunction sendSoundProcessors(synthmessage){\r\n\tif(synthRemote){\r\n\t\tsynthRemote.post(synthmessage);\r\n\t}\r\n\tif(synthLocal){\r\n\t\tsynthLocal.post(synthmessage);\r\n\t}\r\n}\r\n\r\n// used for tempo panic and stop messages\r\nfunction sendAllSoundProcessors(synthmessage){\r\n\tfor(let synth of synthLocalArray){\r\n\t\tsynth.post(synthmessage);\r\n\t}\r\n}\r\n\r\n// userd for voice arp and beat messages\r\nfunction sendPatchedSoundProcessors(patchname,synthmessage){\r\n\tfor(let synth of synthLocalArray){\r\n\t\tif(synth.patch==patchname){\r\n\t\t\tsynth.post(synthmessage);\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction beep(){\r\n\tconst synthmessage1=[\r\n\t\t{command:\"voice\", oscillator:1, power:1, envelope:1, mode:0},\r\n\t\t{command:\"noteon\", note:64, velocity:100},\r\n\t\t{command:\"noteon\", note:65, velocity:100},\r\n\t];\r\n\tconst synthmessage2=[\r\n\t\t{command:\"noteoff\", note:65, velocity:100},\r\n\t\t{command:\"noteoff\", note:64, velocity:100}\r\n\t];\r\n\tlet node=synthLocal;\r\n\tnode.post(synthmessage1);\r\n\tnode.post(synthmessage2);\r\n}\t\r\n\r\n// warning - complicated class extension post construction ahead\r\n\r\nasync function initSoundProcessor(context,gain,gain2) {\r\n\t\r\n\tif(!context.audioWorklet){\r\n\t\tconsole.log(\"initSoundProcessor: AudioWorklet not supported\");\r\n\t\treturn;\r\n\t}\r\n//dspprocessor\r\n\tcontext.audioWorklet.addModule('nitrojs/worker-vscope.js').then(function(){\r\n\t\tclass VScopeNode extends AudioWorkletNode {\r\n\t\t}\r\n\t}).catch(function(e){\r\n\t\tconsole.log(\"vscope error:\"+e);\r\n\t});\r\n\r\n//dspprocessor\r\n\tawait context.audioWorklet.addModule('nitrojs/worker-vsynth.js').then(function(){\r\n\t\tclass VSynthNode extends AudioWorkletNode {\r\n\r\n\t\t\tconstructor(context,name) {\r\n\t\t\t\tvar options={channelCount:2,channelCountMode:'explicit'};\r\n\t\t\t\tsuper(context,'VSynthAudioProcessor',options);\r\n\t\t\t\tthis.name=name;\r\n\t\t\t\tthis.leftFragments=[];\r\n\t\t\t\tthis.rightFragments=[];\r\n\t\t\t\tthis.reads=0;\r\n\t\t\t\tthis.port.onmessage=this.onSynthMessage.bind(this);\r\n\t\t\t\tthis.delays={};\r\n\t\t\t\tthis.pcmCounts={};\r\n\t\t\t\tthis.sampleRate=context.sampleRate;\r\n\t\t\t\tthis.recordBuffer = [];\r\n\t\t\t\tthis.recordLength = 0;\r\n\t\t\t}\r\n\r\n\t\t\tsetPatch(name){\r\n\t\t\t\tthis.patch=name;\r\n\t\t\t}\r\n\r\n\t\t\t// post to worklet - check name with id\r\n\t\t\tpost(message){\r\n\t\t\t\tthis.port.postMessage(message)\r\n\t\t\t}\r\n\r\n\t\t\tonSynthMessage(e){\r\n//\t\t\t\tlog(\"onSynthMessage 1\");\r\n\t\t\t\tlet name=e.data.name;\r\n\t\t\t\tswitch(name){\r\n\t\t\t\t\tcase \"log\":\r\n\t\t\t\t\t\tvar line=e.data.line;\r\n\t\t\t\t\t\tlog(\"synth: \"+line);\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tcase \"vcontrol\":\r\n\t\t\t\t\t\t// todo support vcontrol messaging\r\n\t\t\t\t\t\tvar names=e.data.controls;\r\n\t\t\t\t\t\tlog(\"vcontrol names:\"+names);\r\n\t\t\t\t\t\tbreak;\r\n\r\n\t\t\t\t\tcase \"vsynth\":\r\n\t\t//\t\tconsole.log(\"VSynthNode onSynthMessage:\");\r\n\t\t\t\t\t\tthis.leftFragments.push(e.data.left);\r\n\t\t\t\t\t\tthis.rightFragments.push(e.data.right);\r\n\t\t\t\t\t\tthis.reads+=e.data.left.length+e.data.right.length;\r\n\t\t\t\t\t\tvar count=e.data.count;\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t// sent from outboard arpeggiator\r\n\t\t\t\t\tcase \"midv\":\r\n\t\t\t\t\t\tlet commands=e.data.commands;\r\n\t\t\t\t\t\tthis.transmitCommands(commands);\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t// status report from vicious synth\r\n\t\t\t\t\tcase \"midz\":\r\n\t\t\t\t\t\tlet state=e.data.state;\r\n\t\t\t\t\t\tthis.refreshState(state);\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\tdefault:\r\n\t\t\t\t\t\tconsole.log(\"synthmessage name:\"+name);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\trefreshState(state){\r\n//\t\t\t\tlet js=JSON.stringify(state);\r\n//\t\t\t\tconsole.log(\"midz state:\"+js);\r\n\t\t\t\t// vsynth worker sends a midz state\r\n\t\t\t\tif(state.modulate){}\r\n\t\t\t\tLocalEventQueueMessage({src:\"synth\",name:this.name,state});\t\t\t\t\r\n\t\t\t}\r\n\r\n\t\t\ttransmitCommands(commands){\r\n\t\t\t\tfor(const line of commands){\r\n\t//\t\t\tconsole.log(\"[VSYNTH] \"+JSON.stringify(line));\r\n\t\t\t\t\tswitch(line.command){\t\t\t\t\r\n\t\t\t\t\t\tcase \"noteon\":\r\n\t\t\t\t\t\t\tlet note1=line.note;\r\n\t\t\t\t\t\t\tlet velocity=line.velocity;\r\n\t\t\t\t\t\t\tif (note1>0 && note1<128){\r\n\t\t\t\t\t\t\t\tBroadcastMidi([144,note1,velocity]);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase \"noteoff\":\r\n\t\t\t\t\t\t\tlet note2=line.note;\r\n\t\t\t\t\t\t\tif (note2>0 && note2<128){\r\n\t\t\t\t\t\t\t\tBroadcastMidi([128,note2,127]);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tbreak;\t\t\t\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tonAudioIn(e){ // \"pcm\" => \"pcm64\"\r\n\t\t\t\tlet now=performance.now();\r\n\t\t\t\tlet time=e.time;\r\n\t\t\t\tlet tick=e.tick;\r\n\t\t\t\tlet source=e.source;\r\n\t\t\t\tlet src=e.src;\r\n\t\t\t\tlet data=e.data;//hex16\r\n\t\t\t\t\r\n\t\t\t\tlet rate=e.rate;\r\n\t\t\t\tlet count=e.count;//timeStamp;\r\n\t\t\t\tif(!count){\r\n\t\t\t\t\tconsole.log(\"VSynthNode onAudioIn pcm count not defined\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\tlet count0=this.pcmCounts[source];\r\n\t\t\t\tif(count0 && count<count0){\r\n\t\t\t\t\tconsole.log(\"VSynthNode onAudioIn pcm count is out of order\");\r\n\t\t\t\t}\r\n\t\t\t\tthis.pcmCounts[source]=count;\r\n\r\n\t\t\t\t// transfer 16 bit hex to float64\r\n\t\t\t\tlet hex16=data;\r\n\t\t\t\tlet n=hex16.length/4;\r\n\t\t\t\tlet mem64=new Float64Array(n);\r\n\t\t\t\tlet gain16=0x7fff;\r\n\t\t\t\tfor(let i=0;i<n;i++){\r\n\t\t\t\t\tlet hexword=hex16.substring(i*4,i*4+4);\r\n\t\t\t\t\tlet word=parseInt(hexword,16);\r\n\t\t\t\t\tif(word&0x8000){\r\n\t\t\t\t\t\tword|=-0x8000;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmem64[i]=(20.0*word)/gain16;\r\n\t\t\t\t}\r\n\t\t\t\tlet message=[{command:\"pcm64\",source,count,rate,data:mem64}];\t//,sampleRate:this.sampleRate,channels:2\r\n\t\t\t\tthis.port.postMessage(message,[mem64.buffer]);\r\n\t\t\t}\r\n\r\n\t\t\t// midi events are smoothed out so they fire with accurate relative time\r\n\t\t\t// see the magic number 12 below\r\n\t\t\tresetDelays(){\r\n\t\t\t\tthis.delays={};\r\n\t\t\t}\r\n\r\n\t\t\tonMidiIn(e){\r\n\t\t\t\tlet source=e.source;\r\n\t\t\t\tlet time=e.time;\r\n\t\t\t\tlet tick=e.tick;\r\n\t\t\t\tlet now=performance.now();\r\n\t\t\t\tlet delay=0;\r\n\t\t\t\tif(source in this.delays){\r\n\t\t\t\t\tlet t=this.delays[source];\r\n\t\t\t\t\tlet delta1=(time-t.time)/10; // midi clock in millis\r\n\t\t\t\t\tlet delta2=now-t.now; // wall clock in millis\r\n\t\t\t\t\tdelay=12+delta1-delta2;\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(time!=0){\r\n\t\t\t\t\t\tthis.delays[source]={time,now};\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tif(delay>0 && delay<500){\r\n\t\t\t\t\tsetTimeout(this.onMidi.bind(this,e),delay);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tif(delay>=500 || delay<-50){\r\n\t\t\t\t\t\tconsole.log(\"onMidiIn delay : \"+delay);\r\n\t\t\t\t\t\tthis.resetDelays();\r\n\t\t\t\t\t}\r\n//\t\t\t\t\tthis.onMidi(e);\r\n\t\t\t\t\tlet bytes=e.data;\r\n\t\t\t\t\tthis.processMidi(bytes);\r\n\t\t\t\t}\r\n\t\t\t}\r\n// o\r\n\t\t\tonMidi(e){\r\n\t\t\t\tthis.processMidi(e.data);\r\n\t\t\t}\r\n\r\n\t\t\tprocessMidi(bytes){\r\n\t\t\t\tvar message=[];\r\n\t\t\t\tif(bytes.length>0){\r\n\t\t\t\t\tvar cmd=bytes[0];\r\n\t\t\t\t\tvar note=bytes[1];\r\n\t\t\t\t\tvar velocity=(bytes.length>1)?bytes[2]:0;\r\n\t\t\t\t\tswitch(cmd){\r\n\t\t\t\t\t\tcase 144://notedown\r\n\t\t\t\t\t\t\tif(velocity>0){\r\n\t\t\t\t\t\t\t\tmessage.push({command:\"noteon\", note, velocity})\r\n\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\tmessage.push({command:\"noteoff\", note, velocity})\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 128://noteoff\r\n\t\t\t\t\t\t\tmessage.push({command:\"noteoff\", note, velocity})\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 192://TODOL programchange\t\t\t\t\t\t\r\n//\t\t\t\t\t\t\tpushProgram(message,note);\r\n//\t\t\t\t\t\t\tmessage.push({command:\"voice\", oscillator:note,envelope:1, mode:1,power:1})\r\n//\t\t\t\t\t\t\tmessage.push({command:\"arp\", mode:0, algo:1, prog:1});\r\n//\t\t\t\t\t\t\tmessage.push({command:\"tempo\", bpm:120, div:2,duty:0,rept:0});\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 224:\r\n\t\t\t\t\t\t\tlet value=velocity*128+(note&127);\r\n\t\t\t\t\t\t\tmessage.push({command:\"controlchange\", control:224, value})\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\tcase 176://controlchange\r\n\t\t\t\t\t\t\tmessage.push({command:\"controlchange\", control:note, value:velocity})\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tif(message.length>0){\r\n\t\t\t\t\tthis.post(message);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tlet n=gain2.length;\r\n\t\tfor(let i=0;i<n;i++){\r\n\t\t\tlet name=\"local \"+i;\r\n\t\t\tlet vsynth=new VSynthNode(context,name);\r\n\t\t\tvsynth.connect(gain2[i]);\r\n\t\t\t// TODO: grab from storage\r\n\t\t\tlet patch=\"dsp1.patch.0\";\r\n\t\t\tvsynth.setPatch(patch);\r\n\t\t\tsynthLocalArray[i]=vsynth\r\n\t\t}\r\n\t\tsynthLocal=synthLocalArray[0];\r\n\t\tsynthLocalRight=synthLocalArray[1];\r\n\r\n\t\tLocalEventHandler(\"midi\",OnLocalMidi);\r\n\t\tLocalEventHandler(\"synth\",OnSynth);\r\n\r\n\t\tbeep();\r\n\t});\r\n}\r\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker_fetch.js\",\"length\":1015,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// wire_fetch.js\n// one per TopoGrid\n\n//const _unicode = new TextEncoder();\n\n//let outgoing=[];\n//let connected=false;\n\nfunction onFetch(url){\n    const options={headers:{'Accept':'application/json'}};\n    fetch(url).then(\n    (response)=>{\n            if(response.ok){\n                response.json().then(\n                    (data)=>\n                        onLoad(data)\n                    ,(_error)=>{\n                        this.error(\"json error 2 \"+_error+\" for \"+url);\n                        this.fetchBadJson(url);\n                    }\n                );\n            }else{\n                console.log(\"worker_fetch onFetch response not ok url:\",url);\n                this.drawingLoad(license,level,{});\n            }\n\n        },(_error)=>{\n            this.error(\"1\"+_error);\n        }\n    )\n}\n\nonmessage = (message) => {\n\tconst commands=message.data;\n\tfor(const line of commands){\n\t\tconsole.log(\"wire_baker \",line);\n\t\tswitch(line.command){\n\t\t\tcase \"fetch\":\n\t\t\t\tonFetch(line.url);\n\t\t\t\tbreak;\n\t\t}\n\t}\n}\n","name":"content"},{"role":"user","content":"{\"path\":\"/home/skid/nitrologic/dsptool/web/nitrojs/worker-vsynth.js\",\"length\":43031,\"type\":\"text/x-javascript\",\"tag\":\"\"}","name":"blob"},{"role":"user","content":"// worker-vsynth.js\r\n// (C)2025 Simon Armstrong\r\n// All rights reserved\r\n\r\n// hold issues with touch interface\r\n// 0xBn 0x7A all notes off incoming\r\n// filters and clocks per voice\r\n\r\n// based on nitrologic synth vicious\r\n// https://github.com/nitrologic/m2\r\n\r\n\"use strict\"\r\n\r\n// settings for filters are echoed to all voices via split type\r\n\r\nlet synthLog=[];\r\nfunction log(line,emit=false){\r\n\tif(emit) synthLog.push(line);\r\n\tif(synthLog.length>50){\r\n\t\tsynthLog=synthLog.slice(25);\r\n\t\tlog(\"synthlog Sliced\");\r\n\t}\r\n}\r\n\r\nfunction Snapshot(o,snap,depth){\r\n\tlet entries=Object.entries(o);\r\n\tlet n=entries.length;\r\n\tfor(let i=0;i<n;i++){\r\n\t\tlet name=entries[i][0];\r\n\t\t// hide _ members from snapshots\r\n\t\tlet index=name.indexOf('_');\r\n\t\tif(index==-1){\r\n\t\t\tlet value=entries[i][1];\r\n\t\t\tif(value && typeof value === 'object'){\r\n\t\t\t\tif(depth>0){\r\n\t\t\t\t\tlet isArray=value instanceof Array||ArrayBuffer.isView(value);\r\n\t\t\t\t\tlet values=isArray?[]:{};\r\n\t\t\t\t\tSnapshot(value,values,depth-1);\r\n\t\t\t\t\tsnap[name]=values;\r\n\t\t\t\t}\r\n\t\t\t}else{\r\n\t\t\t\tsnap[name]=value;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nclass VSynthAudioProcessor extends AudioWorkletProcessor {\r\n\tconstructor() {\r\n\t\tsuper();\r\n\t\tthis.osc=0.0;\r\n\t\tthis.reads=0;\r\n\t\tthis.writes=0;\r\n\t\tthis.outs=0;\r\n\t\tthis.count=0;\r\n\t\tvar vicious=new VSynth(this);\r\n\t\tthis.vsynth=vicious;\r\n\t\tthis.port.onmessage=(message) => {\r\n\t\t\tthis.vsynth.onCommands(message.data);\r\n\t\t};\r\n\t\tthis.reset();\r\n\t}\r\n\r\n\treset(){\r\n//\t\tthis.port.postMessage({name:\"snapshot\"});\r\n//\t\tvar name=\"vcontrol\";\r\n//\t\tlet controls=this.vsynth.controlNames;\t\t\r\n//\t\tthis.port.postMessage({name,controls,count:this.count++});\r\n\t}\r\n\r\n\tprocess(inputs,outputs,parameters) {\r\n\t\tif(inputs && inputs.length>0){\r\n\t\t\tvar in0=inputs[0];\r\n\t\t\tvar channels=in0.length;\r\n\t\t\tif(channels==2){\r\n\t\t\t\tvar name=\"vsynth\";\r\n\t\t\t\tvar left=in0[0];\r\n\t\t\t\tvar right=in0[1];\r\n\t\t\t\tvar n=left.length;\r\n\t\t\t\tthis.writes+=n;\r\n\t\t\t\tthis.port.postMessage({name,left,right,count:this.count++});\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(outputs && outputs.length>0 && parameters.beep || true){\r\n\t\t\tvar out0=outputs[0];\r\n\t\t\tvar channels=out0.length;\r\n\t\t\tvar left=out0[0];\r\n\t\t\tvar right=out0[1];\r\n\t\t\tvar osc=this.osc;\r\n\t\t\tvar n=left.length;\r\n\t\t\tvar float64s=this.vsynth.mixAudioBuffers(n);\r\n\t\t\tif(channels==1){\r\n\t\t\t\tfor(var i=0;i<n;i++){\r\n\t\t\t\t\tleft[i]=float64s[i*2];\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif(channels==2){\r\n\t\t\t\tfor(var i=0;i<n;i++){\r\n\t\t\t\t\tleft[i]=float64s[i*2];\r\n\t\t\t\t\tright[i]=float64s[i*2+1];\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tthis.osc=osc;\r\n\t\t\tthis.outs+=n;\r\n\t\t}\r\n\t\treturn true;\r\n\t}\r\n}\r\n\r\nregisterProcessor('VSynthAudioProcessor',VSynthAudioProcessor);\r\n\r\nconst FragmentSize=128;\r\nconst MaxPolyphony=128;\r\nconst SpeedOfSound=340.29;\r\n\r\nconst AudioFrequency = 48000;\r\nconst Nyquist = AudioFrequency / 2;\r\n\r\nconst BIQUAD_LOWPASS = 0;\r\nconst BIQUAD_HIGHPASS = 1;\r\nconst BIQUAD_BANDPASS = 2;\r\nconst BIQUAD_NOTCH = 3;\r\nconst BIQUAD_ALLPASS = 4;\r\n\r\nclass BiquadNode{\r\n\tconstructor(biquad){\r\n\t\tthis.owner=biquad;\r\n\t\tthis.reset();\r\n\t}\r\n\treset(){\r\n\t\tthis.z1 = 0;\r\n\t\tthis.z2 = 0;\r\n\t}\t\r\n\tfilterFragment(buffer, count) {\r\n\t\tlet biquad=this.owner;\r\n\t\tif(biquad.enabled){\r\n\t\t\tlet z1=this.z1;\r\n\t\t\tlet z2=this.z2;\r\n\t\t\tfor (let i = 0; i < count; i++) {\r\n\t\t\t\tconst input = buffer[i];\r\n\t\t\t\tconst w = input - biquad.a1 * z1 - biquad.a2 * z2;\r\n\t\t\t\tconst output = biquad.b0 * w + biquad.b1 * z1 + biquad.b2 * z2;\r\n\t\t\t\tz2 = z1;\r\n\t\t\t\tz1 = w;\r\n\t\t\t\tbuffer[i] = output;\r\n\t\t\t}\r\n\t\t\tthis.z1=z1;\r\n\t\t\tthis.z2=z2;\r\n\t\t}\r\n\t}\r\n}\r\n\r\nclass BiquadFilter {\r\n\tconstructor(){\r\n\t\tthis.enabled=false;\r\n\t\tthis.type=BIQUAD_LOWPASS;\r\n\t\tthis.cutoff=20;\r\n\t\tthis.cutoff2=0;\r\n\t\tthis.Q=0.1;\r\n\t\tthis.Q2=0;\r\n\t}\r\n\tSetFilterParam(enabled,type,cutoff,q) {\r\n\t\tthis.enabled=enabled;\r\n\t\tthis.type = Math.max(0, Math.min(type, 4));\r\n\t\tthis.cutoff=cutoff;\r\n\t\tthis.Q = q;\r\n\t\tthis.updateCoefficients();\r\n\t}\r\n\tupdateCoefficients() {\r\n\t\tlet cutoff = Math.max(20, Math.min(Nyquist, this.cutoff+this.cutoff2));\r\n\t\tlet Q = Math.max(0.1, Math.min(50, this.Q+this.Q2));\r\n\t\tconst w0 = 2 * Math.PI * cutoff / AudioFrequency;\r\n\t\tconst cosW0 = Math.cos(w0);\r\n\t\tconst sinW0 = Math.sin(w0);\r\n\t\tconst alpha = sinW0 / (2 * Q);\r\n\t\tconst a0 = 1 + alpha;\r\n\t\t// TODO: consider if (a0>0) guard\r\n\t\tswitch (this.type) {\r\n\t\t\tcase BIQUAD_LOWPASS: this.b0 = (1 - cosW0) / 2 / a0; this.b1 = (1 - cosW0) / a0; this.b2 = (1 - cosW0) / 2 / a0; break;\r\n\t\t\tcase BIQUAD_HIGHPASS: this.b0 = (1 + cosW0) / 2 / a0; this.b1 = -(1 + cosW0) / a0; this.b2 = (1 + cosW0) / 2 / a0; break;\r\n\t\t\tcase BIQUAD_BANDPASS: this.b0 = alpha / a0; this.b1 = 0; this.b2 = -alpha / a0; break;\r\n\t\t\tcase BIQUAD_NOTCH: this.b0 = 1 / a0; this.b1 = (-2 * cosW0) / a0; this.b2 = 1 / a0; break;\r\n\t\t\tcase BIQUAD_ALLPASS: this.b0 = (1 - alpha) / a0; this.b1 = (-2 * cosW0) / a0; this.b2 = (1 + alpha) / a0; break;\r\n\t\t}\r\n\t\tthis.a1 = (-2 * cosW0) / a0;\r\n\t\tthis.a2 = (1 - alpha) / a0;\r\n\t}\r\n}\r\n\r\nclass Tone{\r\n\tconstructor(note,velocity){\r\n\t\tthis.note=note;\r\n\t\tthis.velocity=velocity;\r\n\t}\r\n}\r\n\r\nclass Envelope{\r\n\tconstructor(){\r\n\t\tthis.t=0;\r\n\t\tthis.value=0;\r\n\t\tthis.noteOn=false;\r\n\t}\r\n\tOn(){\r\n\t\treturn 1.0;\r\n\t}\r\n\tOff(){\r\n\t\treturn 0.0;\r\n\t}\r\n}\r\n\r\nclass ADSR extends Envelope{\r\n\r\n\tconstructor(a,d,s,r){\r\n\t\tsuper();\r\n\t\tthis.attack=a;\r\n\t\tthis.decay=d;\r\n\t\tthis.sustain=s;\r\n\t\tthis.release=r;\r\n\t}\r\n\tOn(){\r\n\t\tif (!this.noteOn){\r\n\t\t\tthis.t=0;\r\n\t\t\tthis.noteOn=true;\r\n\t\t}\r\n\t\tthis.t += 1.0/AudioFrequency;\r\n\t\tlet v=this.sustain;\r\n\t\tif (this.t < this.attack){\r\n\t\t\tv=this.t/this.attack;\r\n\t\t}else if (this.t - this.attack < this.decay){\r\n\t\t\tv=1.0 - ((1-this.sustain)*(this.t-this.attack)/this.decay);\r\n\t\t}\r\n\t\tthis.value=v;\r\n\t\treturn v;\r\n\t}\r\n\tOff(){\r\n\t\tif (this.noteOn){\r\n\t\t\tthis.t=0;\r\n\t\t\tthis.noteOn=false;\r\n\t\t}\r\n\t\tthis.t += 1.0/AudioFrequency;\r\n\t\tif (this.t < this.release){\r\n\t\t\treturn this.value*(1.0-this.t/this.release);\r\n\t\t}\r\n\t\treturn 0.0;\r\n\t}\r\n}\r\n\r\nclass Oscillator\r\n{\r\n\tconstructor(){\r\n\t\tthis.delta=0;\r\n\t}\r\n\tSample(hz){\r\n\t\treturn 0;\r\n\t}\r\n}\r\n\r\nclass Sine extends Oscillator{\r\n\tSample(hz){\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tthis.delta=(this.delta+t)%1;\r\n\t\tlet s=Math.sin(2*Math.PI*this.delta);\r\n\t\treturn s;\r\n\t}\r\n}\t\r\n\r\nclass Sawtooth extends Oscillator{\r\n\tSample(hz){\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tthis.delta=(this.delta+t)%1;\r\n\t\treturn ((2*this.delta+1) % 2) - 1;\r\n\t}\r\n}\r\n\r\nclass Triangle extends Oscillator{\r\n\tSample(hz){\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tthis.delta=(this.delta+t)%1;\r\n\t\tlet v=this.delta;\r\n\t\treturn 4*Math.abs(((v+0.75)%1)-0.5)-1;\r\n\t}\r\n}\t\r\n\r\nclass Square extends Oscillator{\r\n\tSample(hz){\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tthis.delta=(this.delta+t)%1;\r\n\t\treturn -1 + 2*(Math.floor(this.delta*2) & 1);\r\n\t}\r\n}\t\r\n\r\nclass Noise extends Oscillator{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.a=0;\r\n\t}\r\n\tSample(hz){\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tlet delta0=this.delta;\r\n\t\tthis.delta += t;\r\n\t\tlet f=this.delta % 1;\r\n\t\tif (Math.floor(delta0) != Math.floor(this.delta)){\r\n\t\t\tthis.a=Math.random();\r\n\t\t}\r\n\t\treturn 1 - 2*this.a;\r\n\t}\r\n}\t\r\n\r\nclass Rompler extends Oscillator{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.a=0;\r\n\t}\r\n\tSample(hz){\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tlet delta0=this.delta;\r\n\t\tthis.delta += t;\r\n\t\tlet f=this.delta % 1;\r\n\t\tif (Math.floor(delta0) != Math.floor(this.delta)){\r\n\t\t\tthis.a=Math.random();\r\n\t\t}\r\n\t\treturn 1 - 2*this.a;\r\n\t}\r\n}\t\r\n\r\nclass NotePlayer{\r\n\tconstructor(){\r\n\t}\r\n\t// 4 noise\r\n\tSetOscillator(osc){\r\n\t}\r\n\tSetEnvelope(env){\r\n\t}\r\n\tSetPower(pow){\t\t\r\n\t}\r\n\tSetGain(value){\r\n\t}\r\n\tStop(){\r\n\t}\r\n\tNoteOn(note,velocity){\r\n\t}\r\n\tNoteOff(note){\r\n\t}\r\n}\r\n\r\nclass Amp{\r\n\tconstructor(id){\r\n\t\tthis.lfo=null;\r\n\t\tthis.id=id;\r\n\t\tthis.factor2=1.0;\r\n\t\tthis.phase=0;\r\n\t}\r\n\tSetParam(target,index,factor){\r\n\t\tthis.target=target;\r\n\t\tthis.index=index;\r\n\t\tthis.factor=factor;\r\n\t}\r\n}\r\n\r\nclass LFO{\r\n\t// amps are array of channel,gain pairs where gain is factor of signal at audio rate \r\n\tconstructor(){\r\n\t\tthis.amps=[];\r\n\t\tthis.phase=0.0;\r\n\t}\r\n\tAddAmp(amp){\r\n\t\tthis.amps.push(amp);\r\n\t}\r\n\tDropAmp(amp){\r\n\t\tlet index=this.amps.indexOf(amp);\r\n\t\tthis.amps.splice(index,1);\r\n\t}\r\n\tSetLFOParam(osc,pow,freq,sync,gain){\r\n\t\tthis.oscillator=osc;\t\r\n\t\tthis.power=pow;\r\n\t\tthis.frequency=freq;\r\n\t\tthis.gain=gain;\r\n\t\tthis.sync=sync;\r\n\t\tthis.fade=1.0;\r\n\t\tthis.rate=1.0;\r\n\t}\r\n\tStep(quantum){\r\n\t\tlet lfo=this;\r\n\t\tlet hz=lfo.frequency*lfo.rate;\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tthis.phase=(this.phase+quantum*t)%1;\r\n\t}\r\n\tSample(offset,phase){\r\n\t\tlet lfo=this;\r\n\t\tlet hz=lfo.frequency*lfo.rate;\r\n\t\tlet t=hz/AudioFrequency;\r\n\t\tlet v=Math.sin(2*Math.PI*(this.phase+offset*t-phase));\r\n\t\tlet pow=lfo.power;\r\n\t\tif(pow>1) v=Math.pow(v,pow);\r\n\t\tif(pow<1) v=Math.sign(v)*Math.pow(Math.abs(v),pow);\r\n\t\treturn v*lfo.fade*this.gain;\r\n\t}\r\n}\r\n\r\n// system lfo \r\n\r\nlet VoiceCount=0;\r\n\r\nconst temp=new Float64Array(FragmentSize)\r\n\r\nclass Voice extends NotePlayer{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.id=++VoiceCount;\r\n\t\tthis.noteOn=false;\r\n\t\tthis.hz=0;\r\n\t\tthis.gain=0.8;\r\n\t\tthis.amp=0;\r\n\t\tthis.filters=[]; // BiquadNode z0,z1\r\n\t\tthis.triggers=[];\r\n\t}\r\n\taddFilter(biquad){\r\n\t\tthis.filters.push(new BiquadNode(biquad));\r\n\t}\r\n\tSetOscillator(osc){\r\n\t\tthis.oscillator=osc;\r\n\t\tswitch(osc){\r\n\t\t\tcase 0:\r\n\t\t\t\tthis.waveform=new Noise();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 1:\r\n\t\t\t\tthis.waveform=new Sine();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 2:\r\n\t\t\t\tthis.waveform=new Square();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 3:\r\n\t\t\t\tthis.waveform=new Triangle();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 4:\r\n\t\t\t\tthis.waveform=new Sawtooth();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 5:\r\n\t\t\t\tthis.waveform=new Rompler();\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\tSetEnvelope(env){\r\n\t\tswitch(env){\r\n\t\t\tcase 0:\r\n\t\t\t\tthis.envelope=new Envelope();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 1:\r\n\t\t\t\tthis.envelope=new ADSR(0.001,1.5,0.2,0.5);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 2:\r\n\t\t\t\tthis.envelope=new ADSR(0.06,0.01,0.92,0.2);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 3:\r\n\t\t\t\tthis.envelope=new ADSR(0.06,2.0,0.2,1.2);\r\n\t\t\t\tbreak;\r\n\t\t\tcase 4:\r\n\t\t\t\tthis.envelope=new ADSR(0.2,0.2,0.92,0.4);\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n\tSetPower(pow){\t\t\r\n\t\tthis.power=pow;\r\n\t}\r\n\tSetGain(value){\r\n\t\tthis.gain=value;\r\n\t}\r\n\tStop(){\r\n\t\tthis.noteOn=false;\r\n\t\tthis.envelope.Off();\r\n\t}\r\n\tNoteOn(note,velocity){\r\n\t\t// tuned to Middle C 262\r\n\t\tthis.hz=262.0*Math.pow(2.0,(note-60.0)/12);\r\n\t\tthis.amp=velocity/100.0;\r\n\t\tthis.noteOn=true;\r\n\t}\r\n\tNoteOff(note){\r\n\t\tthis.Stop();\r\n\t}\r\n\tMixDown(buffer,samples,rate,fade,pan){\r\n\t\tlet silent=true;\r\n\t\tlet left=1.0;\r\n\t\tlet right=1.0;\r\n\t\tif (pan < 0){\r\n\t\t\tright += pan;\r\n\t\t}\r\n\t\tif (pan > 0){\r\n\t\t\tleft -= pan;\r\n\t\t}\r\n\t\tlet pow=this.power;\r\n\t\tfor (let i=0;i < samples;i++){\r\n\t\t\tlet hz=this.hz*rate[i];\r\n\t\t\tlet v=this.waveform.Sample(hz);\r\n\t\t\tif(pow>1) v=Math.pow(v,pow);\r\n\t\t\tif(pow<1) v=Math.sign(v)*Math.pow(Math.abs(v),pow);\r\n\t\t\tlet e=0;\r\n\t\t\tif (this.noteOn){\r\n\t\t\t\te=this.envelope.On();\r\n\t\t\t}else{\r\n\t\t\t\te=this.envelope.Off();\r\n\t\t\t}\r\n\t\t\tif (e != 0){\r\n\t\t\t\te*=this.gain;\r\n\t\t\t\te*=this.amp;\r\n\t\t\t\te*=fade[i];\r\n\t\t\t\ttemp[i]=e*v;\r\n\t\t\t\tsilent=false;\r\n\t\t\t}else{\r\n\t\t\t\ttemp[i]=0;\r\n\t\t\t}\r\n\t\t}\r\n\t\tif(!silent){\r\n\t\t\tfor(let filter of this.filters){\r\n\t\t\t\tfilter.filterFragment(temp,samples);\r\n\t\t\t}\r\n\t\t\tfor (let i=0;i < samples;i++){\r\n\t\t\t\tlet v=temp[i];\r\n\t\t\t\tbuffer[i*2+0]+=v*left;\r\n\t\t\t\tbuffer[i*2+1]+=v*right;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n}\r\n\r\nclass Synth{\r\n\tconstructor(){\r\n\t\tthis.keys=new Keys();\r\n\t}\r\n\tSetTempo(tempo){\r\n\t}\r\n\tSetBeat(div,duty,reps){\r\n\t}\r\n\tSetTimbre(osc,env,pow){\r\n\t}\r\n\tSetVolume(volume){\r\n\t}\r\n\tNoteOn(note,velocity){\r\n\t}\r\n\tNoteOff(note){\r\n\t}\r\n\tSetSustain(sustain){//footpedal key\r\n\t}\r\n\tSetHold(hold){//arpegiator key\r\n\t}\r\n\tFillAudioBuffer(buffer,samples,detune,fade,pan){\r\n\t}\r\n\tPanic(){\r\n\t}\r\n\tGetKeys(){\r\n\t}\r\n}\r\n\r\nclass Outboard extends Synth{\r\n\tconstructor(owner){\r\n\t\tsuper();\r\n\t\tthis.owner=owner;\r\n\t}\r\n\tPost(commands){\r\n\t\tlet port=this.owner.worklet.port;\r\n\t\tlet js=JSON.stringify(commands);\r\n\t\tlog(\"Outboard post midv commands : \"+js)\r\n\t\tport.postMessage({name:\"midv\",commands});\r\n\t}\r\n\tSetVolume(vol){\r\n\t\tthis.volume=vol;\r\n\t}\r\n\tSetSustain(sustain){\r\n\t}\r\n\tGetKeys(){\r\n\t\treturn this.keys;\r\n\t}\r\n\tPanic(){\r\n\t}\r\n\tSetTimbre(osc,env,pow){\r\n\t}\r\n\tNoteOn(note,velocity){\r\n\t\tthis.Post([{command:\"noteon\", note, velocity}]);\r\n\t}\r\n\tNoteOff(note){\r\n\t\tthis.Post([{command:\"noteoff\", note}]);\r\n\t}\r\n\tFillAudioBuffer(buffer,samples,detune,fade,pan){\r\n\t}\r\n}\r\n\r\nclass Effect{\r\n\tControlNames(){\r\n\t\treturn [];\r\n\t}\r\n\tEffectAudio(samples,sampleCount,control){\r\n\t}\r\n}\r\n\r\nclass NamedEffect{\r\n\tconstructor(name,effect){\r\n\t\tthis.name=name;\r\n\t\tthis.effect=effect;\r\n\t}\r\n}\r\n\r\nclass Chain extends Effect{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.chain=[];\r\n\t\tthis.values=[];\r\n\t}\r\n\t// attendance roll call\r\n\tControlNames(){\r\n\t\tlet names=[];\r\n\t\tfor (let link of this.chain){\r\n\t\t\tlet name=link.name;\r\n\t\t\tlet effect=link.effect;\r\n\t\t\tfor (let control of effect.ControlNames()){\r\n\t\t\t\tnames.push(name+\"_\"+control);\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn names;\r\n\t}\r\n\tAddEffect(effect,name){\r\n\t\tthis.chain.push(new NamedEffect(name,effect));\r\n\t}\r\n\tEffectAudio(samples,sampleCount,control){\t\t\r\n\t\tlet cursor=0;\r\n\t\tfor (let link of this.chain){\r\n\t\t\tlet count=link.effect.ControlNames().length;\r\n\t\t\tlet controls=control.slice(cursor,cursor+count);\r\n\t\t\tcursor += count;\r\n\t\t\tlink.effect.EffectAudio(samples,sampleCount,controls);\r\n\t\t}\r\n\t\tthis.values=control;\r\n\t}\r\n}\r\n\r\nclass Distortion extends Effect{\r\n\tControlNames(){\r\n\t\treturn [\"overdrive\",\"gain\"];\r\n\t}\r\n\tEffectAudio(samples,sampleCount,control){\r\n\t\tlet overdrive=control[0];\r\n\t\tlet gain=control[1];\r\n\t\tfor (let s=0;s < sampleCount*2;s++){\r\n\t\t\tlet i=s>>1;\r\n\t\t\tlet v=samples[s];\r\n\t\t\tv *= overdrive[i];\r\n\t\t\tif (v > 0){\r\n\t\t\t\tv=1-Math.exp(-v);\r\n\t\t\t}else{\r\n\t\t\t\tv=-1+Math.exp(v);\r\n\t\t\t}\r\n\t\t\tv *= gain[i];\r\n\t\t\tsamples[s]=v;\r\n\t\t}\r\n\t}\r\n}\r\n\r\nclass Reverb extends Effect{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.poles=[];\r\n\t\tthis.future=[];\r\n\t\tthis.removeSource=true;\r\n\t}\r\n\tControlNames(){\r\n\t\treturn [\"wet\",\"dry\",\"effect\"];\r\n\t}\r\n\tEffectAudio(samples,sampleCount,control){\r\n\t\tlet wetness=control[0];\r\n\t\tlet dryness=control[1];\r\n\t\tlet falloff=control[2];\r\n\t\tlet n1=Math.min(this.future.length,sampleCount*2);\r\n\t\tfor (let i=0;i < n1;i++){\r\n\t\t\tsamples[i] += this.future[i]*falloff[i/2];\r\n\t\t}\r\n\t\tfor (let pole of this.poles){\r\n\t\t\tlet seconds=pole.distance/SpeedOfSound;\r\n\t\t\tlet offset=Math.floor(AudioFrequency*seconds);\r\n\t\t\tlet maxOffset=(sampleCount+offset)*2;\r\n\t\t\tif (this.future.length < maxOffset){\r\n\t\t\t\tthis.future=this.future.slice(0,maxOffset);\r\n\t\t\t}\r\n\t\t\tlet dampen=pole.dampen;\r\n\t\t\tfor (let i=0;i < sampleCount;i++){\r\n\t\t\t\tlet l=samples[i*2+0];\r\n\t\t\t\tlet r=samples[i*2+1];\r\n\t\t\t\tthis.future[(offset+i)*2+0] += l*dampen;\r\n\t\t\t\tthis.future[(offset+i)*2+1] += r*dampen;\r\n\t\t\t}\r\n\t\t}\r\n\t\tlet n2=Math.min(this.future.length,sampleCount*2);\r\n\t\tfor (let i=0;i < n2;i++){\r\n\t\t\tlet wet=wetness[i/2];\r\n\t\t\tlet dry=dryness[i/2];\r\n\t\t\tsamples[i]=wet*this.future[i]+dry*(samples[i]-this.future[i]);\r\n\t\t}\r\n\t\tthis.future=this.future.slice(sampleCount*2);\r\n\t}\r\n}\r\n\r\nclass Keys{\r\n\tconstructor(){\r\n\t\tthis.lowhigh=new Uint32Array(4);\r\n\t}\r\n\tToJson(){\r\n\t\treturn \"[\"+this.lowhigh[0]+\",\"+this.lowhigh[1]+this.lowhigh[2]+\",\"+this.lowhigh[3]+\"]\";\r\n\t}\r\n\tFromJsonArray(){\r\n\t\treturn \"\";\r\n\t}\r\n\tKeyState(index){\r\n\t\tlet bit=1 << (index & 31);\r\n\t\tlet word=index >> 5;\r\n\t\treturn (this.lowhigh[word] & bit) == bit;\r\n\t}\r\n\tKeyOn(index){\r\n\t\tlet bit=1 << (index & 31);\r\n\t\tlet word=index >> 5;\r\n\t\tthis.lowhigh[word] |= bit;\r\n\t}\r\n\tKeyOff(index){\r\n\t\tlet bit=1 << (index & 31);\r\n\t\tlet word=index >> 5;\r\n\t\tthis.lowhigh[word] &= ~bit;\r\n\t}\r\n}\r\n\r\nclass BeatGenerator extends Synth{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.bpm=120;\r\n\t\tthis.divisor=3;\r\n\t\tthis.dutycycle=0.5;\r\n\t\tthis.output=null;\r\n\t\tthis.time=0;\r\n\t\tthis.clock=0;\r\n\t\tthis.oscillator=0;\r\n\t\tthis.envelope=0;\r\n\t\tthis.power=1;\r\n\t\tthis.repeats=0;\r\n\t\tthis.recent_tone=null;\r\n\t\tthis.count=0;\r\n\t\tthis.note_period=0;\r\n\t\tthis.duty_period=0;\r\n\t\tthis.noteDuration=[];\r\n\t}\r\n\t// called from SetTempo SetBeat and \r\n\tSetDivisor(div){\r\n\t\tif(div==0)div=1;\r\n\t\tlet denom=this.bpm*div;\r\n\t\tif (denom > 0){\r\n\t\t\tthis.note_period=60.0/denom;\r\n\t\t}else{\r\n\t\t\tthis.note_period=0;\r\n\t\t}\r\n\t\tthis.duty_period=this.dutycycle*this.note_period;\r\n\t}\r\n\tSetTempo(bpm){\r\n\t\tthis.bpm=bpm;\r\n\t\tthis.SetDivisor(this.divisor);\r\n\t}\r\n\tSetBeat(div,duty,reps){\r\n\t\tthis.divisor=div;\r\n\t\tthis.dutycycle=duty;\r\n\t\tthis.repeats=reps;\r\n\t\tthis.SetDivisor(div);\r\n\t}\r\n\tSetSustain(sustain){\r\n\t\tthis.output.SetSustain(sustain);\r\n\t}\r\n\tSetVolume(volume){\r\n\t\tthis.output.SetVolume(volume);\r\n\t}\r\n\tSetSynth(synth){\r\n\t\tthis.output=synth;\r\n\t\tthis.output.SetTimbre(this.oscillator,this.envelope,this.power);\r\n\t}\r\n\tSetTimbre(osc,env,pow){\r\n\t\tthis.oscillator=osc;\r\n\t\tthis.envelope=env;\r\n\t\tthis.power=pow;\r\n\t\tthis.output.SetTimbre(this.oscillator,this.envelope,this.power);\r\n\t}\r\n\tNoteOn(note,velocity){\r\n\t\tthis.recent_tone=new Tone(note,velocity);\r\n\t\tthis.keys.KeyOn(note);\r\n\t}\r\n\tNoteOff(note){\r\n\t\tthis.output.NoteOff(note);\r\n\t\tthis.keys.KeyOff(note);\r\n\t}\r\n\tBeat(){\r\n\t\tlet r=this.recent_tone;\r\n\t\tif (r){\r\n\t\t\tthis.NoteOn(r.note,r.velocity);\r\n\t\t}\r\n\t}\r\n\tUpdateBeatGenerator(duration){\r\n\t\tthis.time += duration;\r\n\t\tif (this.note_period > 0){\r\n\t\t\twhile (this.clock < this.time){\r\n\t\t\t\tthis.Beat();\r\n\t\t\t\tthis.clock += this.note_period;\r\n\t\t\t}\r\n\t\t\tthis.StepDuration(duration);\r\n\t\t}\r\n\t}\r\n\tStepDuration(duration){\r\n\t\tlet remaining=[]\r\n\t\tfor (let nd of this.noteDuration){\r\n\t\t\tnd.duration-=duration;\r\n\t\t\tif (nd.duration <= 0){\r\n\t\t\t\tthis.output.NoteOff(nd.note);\r\n\t\t\t}else{\r\n\t\t\t\tremaining.push(nd);\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.noteDuration=remaining;\r\n\t}\r\n\tFillAudioBuffer(buffer,samples,detune,fade,pan){\r\n\t\tlet duration=2.0*samples/AudioFrequency;\r\n\t\tthis.UpdateBeatGenerator(duration);\r\n\t\tthis.output.FillAudioBuffer(buffer,samples,detune,fade,pan);\r\n\t}\r\n\tGetKeys(){\r\n\t\treturn this.output.GetKeys();\r\n\t}\r\n\tPanic(){\r\n\t\tthis.ReleaseAll();\r\n\t\tthis.output.Panic();\r\n\t}\r\n\tTriggerNote(note,velocity){\r\n\t\tif(note<0||note>127) return;\r\n\t\tthis.output.NoteOn(note,velocity);\r\n\t\tlet duration=this.duty_period;\r\n\t\tthis.noteDuration.push({note,duration});\r\n\t}\r\n\tReleaseAll(){\r\n\t\tfor (let nd of this.noteDuration){\r\n\t\t\tthis.output.NoteOff(nd.note);\r\n\t\t}\r\n\t\tthis.noteDuration=[];\r\n\t}\r\n}\r\n\r\nfunction CompareNote(a,b){\r\n\treturn a.note-b.note;\r\n}\r\n\r\n// divisor 10 => natural.length\r\n\r\nclass Arpeggiator extends BeatGenerator{\r\n\tconstructor(){\r\n\t\tsuper();\r\n\t\tthis.note_map=new Map();\r\n\t\tthis.natural=[];\r\n\t\tthis._sorted=[];\r\n\t\tthis.index=0;\r\n\t\tthis.algorithm=0;\r\n\t\tthis.progression=0;\r\n\t\tthis.hold=false;\r\n\t\tthis.noteCount=0;\r\n\t\tthis.note=null;\r\n\t\tthis.noteOffset=0;\r\n\t\tthis.cycle=0;\r\n\t\tthis.noise=0xdeadbeef;\r\n\t}\r\n\r\n\trandom(){\r\n\t\tlet f=this.noise&0x7fffff;\t\t\r\n\t\tlet r1=f>>3;\r\n\t\tlet l1=f<<2;\r\n\t\tlet x1=(r1^l1)&0x7fffffff;\r\n\t\tthis.noise^=x1;\r\n\t\tlet r=f/0x800000;\r\n\t\treturn r;\r\n\t}\r\n\r\n\tUpdateBeatGenerator(duration){\r\n\t\tif(this.divisor==0){\r\n\t\t\tlet n=this.natural.length;\r\n\t\t\tsuper.SetDivisor(n);\r\n\t\t}\r\n\t\tsuper.UpdateBeatGenerator(duration);\r\n\t}\r\n\r\n\tPanic(){\r\n\t\t// help super panic should call this ReleaseAll?\r\n\t\tthis.ReleaseAll();\r\n\t\tsuper.Panic();\r\n\t}\r\n\t// orphan reset where state.notes is raw array of note,velocity pairs\r\n\tResetState(state){\r\n\t\tthis.ReleaseAll();\r\n\t\tlet notes=state.natural;\r\n\t\tif (notes){\r\n\t\t\tfor (let i=0;i<notes.length/2;i++){\r\n\t\t\t\tlet note=notes[i*2+0];\r\n\t\t\t\tlet velocity=notes[i*2+1];\r\n\t\t\t\tthis.natural.push(new Tone(note,velocity));\r\n\t\t\t}\r\n\t\t}\r\n\t\tthis.SortState();\r\n\t\tthis.index=this.natural.length;\r\n\t\tthis.noteCount=0;\r\n\t}\r\n\tSortState(){\r\n\t\t// make a copy and sort it\r\n\t\tthis._sorted=this.natural.slice();\r\n\t\tthis._sorted.sort(CompareNote);\r\n\t}\r\n\r\n\tSetArpeggiation(algo,prog){\r\n\t\tthis.algorithm=algo;\r\n\t\tthis.progression=prog;\r\n\t\tthis.noteOffset=0;\r\n\t}\r\n\tReleaseAll(){\r\n\t\tsuper.ReleaseAll();\r\n\t\tthis.natural=[];\r\n\t\tthis._sorted=[];\r\n\t\tthis.noteCount=0;\r\n\t\tthis.cycle=0;\r\n\t\tthis.noteOffset=0;\r\n\t\tthis.note_map.clear();\r\n\t}\r\n\tSetHold(down){\r\n\t\tif (this.hold && !down){\r\n\t\t\tthis.ReleaseAll();\r\n\t\t}\r\n\t\tthis.hold=down;\r\n\t}\r\n\tNoteUp(note){\r\n\t\tif (this.note_map.has(note)){\r\n\t\t\tthis.note_map.delete(note);\r\n\t\t\tlet i=this.natural.findIndex((element)=>element.note==note);\r\n\t\t\tlog(\"arp NoteUp natural splice i:\"+i+\" for note \"+note);\r\n\t\t\tthis.natural.splice(i,1);\r\n\t\t}\r\n\t}\r\n\tNoteOn(note,velocity){\r\n\t\tif (this.hold && this.noteCount==0){\r\n\t\t\tthis.ReleaseAll();\r\n\t\t\tlog(\"Release All\");\r\n\t\t}\r\n\t\tthis.noteCount++;\r\n\t\tlog(\"NoteOn noteCount : \"+this.noteCount);\r\n\t\tif (this.algorithm == 0){\r\n\t\t\tthis.output.NoteOn(note,velocity);\r\n\t\t}else{\r\n\t\t\tthis.NoteUp(note);\r\n\t\t\tsuper.NoteOn(note,velocity);\r\n\t\t\tlog(\"arp noteon note:\"+note);\r\n\t\t\tlet tone=new Tone(note,velocity);\r\n\t\t\tthis.natural.push(tone);\r\n\t\t\tthis.note_map.set(note,tone);\r\