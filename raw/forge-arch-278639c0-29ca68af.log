28b39133 [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b39133 [gemini-3.8-flash] #
28b39133 [gemini-3.8-flash] #Option 1: Using the `progress` utility
28b39133 [gemini-3.8-flash] #There is a dedicated utility named `progress` (formerly known as `cv` / Coreutils Viewer).
28b39133 [gemini-3.8-flash] #It searches `/proc` for running coreutils/tar commands and shows their current file position and
28b39133 [gemini-3.8-flash] #throughput.
28b39133 [gemini-3.8-flash] #
28b39133 [gemini-3.8-flash] #If you install it via `sudo pacman -S progress`, you can simply run:
28b39133 [gemini-3.8-flash] #
28b39133 [gemini-3.8-flash] #progress -m
28b39133 [gemini-3.8-flash] #
28b39133 [gemini-3.8-flash] #It will display the running `tar` process, percentage complete, and current transfer speed.
28b39133 [gemini-3.8-flash] #
28b39133 [gemini-3.8-flash] #━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
28b39133 [gemini-3.8-flash] #
28b39134 [gemini-3.8-flash] #Option 2: Checking disk write activity with `iostat`
28b39134 [gemini-3.8-flash] #If you have `sysstat` installed, you can check how fast data is actually landing on `/dev/sda`:
