29860687 [deepseek-flash] #
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #Accumulate rather than replace, so multiple drawings on one tile merge.
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #Ordering in `createTopo`
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #The whole point. Dig, then flora, then post:
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #
29860687 [deepseek-flash] #function createTopo(){
29860687 [deepseek-flash] #	const bytes=heightmaps[0]||[];
29860687 [deepseek-flash] #	const heightmap=AllocBumpmap(bytes);
29860687 [deepseek-flash] #	heightmap.setBytes(bytes);
29860687 [deepseek-flash] #	const n=heightmaps.length;
29860687 [deepseek-flash] #	for(let i=1;i<n;i++){
29860687 [deepseek-flash] #		if(heightmaps[i].length==bytes.length){
29860687 [deepseek-flash] #			heightmap.orBytes(heightmaps[i]);
29860687 [deepseek-flash] #		}
29860688 [deepseek-flash] #	}
29860688 [deepseek-flash] #	heightmaps.length=0;
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #	for(const outline of roofOutlines){
29860688 [deepseek-flash] #		digOutline(heightmap,outline,digDepth,digBorder);
29860688 [deepseek-flash] #	}
29860688 [deepseek-flash] #	roofOutlines.length=0;
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #	heightmap.postFlora(512,4,15,2);
29860688 [deepseek-flash] #	heightmap.post();
29860688 [deepseek-flash] #}
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #`digOutline` uses only `heightmap.pickTopo` and `heightmap.setGround/setHeight`, and the worker's
29860688 [deepseek-flash] #own `Bumpmap` implements all three — so the same free function works on both sides without
29860688 [deepseek-flash] #modification.
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #Getting `digOutline` into the worker
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #Two options.
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #• Option A — `importScripts`.* One line, but `wire_util.js` runs `const AppEventServer=new
29860688 [deepseek-flash] #EventServer();` at top level and `EventServer` constructs a `Worker` with a document-relative path.
29860688 [deepseek-flash] #Guard that line:
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #const AppEventServer=(typeof window!=="undefined")?new EventServer():null;
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #
29860688 [deepseek-flash] #Then:
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #importScripts("../wirejs/wire_util.js");
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #Path is relative to the worker's own URL (`.../nitrojs/worker_baker.js`), so `../wirejs/` is
29860689 [deepseek-flash] #correct.
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #• Option B — inline `Bits` and `digOutline` into the worker.* Self-contained, no import,
29860689 [deepseek-flash] #but duplicates the rasteriser. Only worth it if you want the worker to stay dependency-free.
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #I'd take A. The guard is one line and the worker stays in sync with the main-thread `Bits`.
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #Main thread — minimal
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #One helper, called from two places:
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #
29860689 [deepseek-flash] #maybeSendDig(){
29860689 [deepseek-flash] #	if(this.digSent) return;
29860689 [deepseek-flash] #	if(this.drawingCount!=this.drawings.length) return;
29860689 [deepseek-flash] #	this.digSent=true;
29860689 [deepseek-flash] #	const outlines=[];
29860689 [deepseek-flash] #	for(const drawing of this.drawings){
29860689 [deepseek-flash] #		for(const roof of drawing.data["ROOF"]){
29860689 [deepseek-flash] #			const start=roof.start;
29860689 [deepseek-flash] #			const count=roof.count;
29860689 [deepseek-flash] #			for(let i=0;i<count;i++){
29860689 [deepseek-flash] #				outlines.push(drawing.outlines[start+i]);
2986068a [deepseek-flash] #			}
2986068a [deepseek-flash] #		}
2986068a [deepseek-flash] #	}
2986068a [deepseek-flash] #	if(this.instance){
2986068a [deepseek-flash] #		this.instance.post([{
2986068a [deepseek-flash] #			command:"dig",
2986068a [deepseek-flash] #			outlines,
2986068a [deepseek-flash] #			depth:BasementDepth,
2986068a [deepseek-flash] #			border:BasementBorder
2986068a [deepseek-flash] #		}]);
2986068a [deepseek-flash] #	}
2986068a [deepseek-flash] #}
2986068a [deepseek-flash] #
2986068a [deepseek-flash] #
2986068a [deepseek-flash] #Call it at the end of `onDrawingResponse` and at the end of `fetchTopoTile` (after the instance is
2986068a [deepseek-flash] #created). The second call covers `level>=3` and `UseLINZ=false`, where no drawing is fetched and
2986068a [deepseek-flash] #`digReady` would otherwise never be set.
2986068a [deepseek-flash] #
2986068a [deepseek-flash] #Two decisions
2986068a [deepseek-flash] #
2986068a [deepseek-flash] #• Fail-open or strict gate.* As written, if the drawing fetch errors out without calling
2986068a [deepseek-flash] #`onDrawingResponse`, the worker stalls forever — no bump, no flora, no tile. `hasLoaded()` already
2986068a [deepseek-flash] #stalls in that case on the main side, so it's not a new failure mode, but it does move the stall
2986068a [deepseek-flash] #into the worker. If you'd rather degrade, drop the `digReady` gate and instead send an empty `dig`
2986068a [deepseek-flash] #from a timer, or just let `createTopo` run when the topo is ready and dig only if outlines happen
2986068a [deepseek-flash] #to have arrived.
2986068a [deepseek-flash] #
2986068a [deepseek-flash] #• Shared border or two.* `BasementBorder=40` is the carve halo. Flora clearance wants to be
2986068a [deepseek-flash] #wider than the basement (eaves, not wall line). If they're different, `digTopo` needs either two
2986068b [deepseek-flash] #passes or a separate flora mask, which is a bigger change than a message.
2986068b [deepseek-flash] #
2986068b [deepseek-flash] #What still has to be true
2986068b [deepseek-flash] #
2986068b [deepseek-flash] #- `BasementDepth` is `4`. At `SeaLevel=186*16` that's ~25 cm and won't read. Pick a value in those
2986068b [deepseek-flash] #units.
2986068b [deepseek-flash] #- `build_roof2` in `Builder.buildTile` must not also call `tile.digOutline` — remove that call, or
2986068b [deepseek-flash] #the main thread digs a heightmap the worker already transferred and dug.
2986068b [deepseek-flash] #- `Bits.poly` has the `y` clamp commented out. Worth a `bits.dump()` check before trusting edge
2986068b [deepseek-flash] #outlines, though `Bits` is allocated at the outline's own min so interior coordinates are
2986068b [deepseek-flash] #non-negative by construction.
2986068b [deepseek-flash] #
2986068b [deepseek-flash] #Want me to write this as the patch against `worker_baker.js`, `wire_util.js` and `wire_topo.js`?
2986068b [deepseek-flash] #
