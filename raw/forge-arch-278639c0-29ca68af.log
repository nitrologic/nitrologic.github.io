29a246cf [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.030 1.549MB 45.07s
29a246cf [deepseek-flash] #No — there's no separate scalar on terrain z. Terrain and wall vertices are both raw topo units,
29a246cf [deepseek-flash] #both offset by the same origin (`0x4000`), both pushed through the same `RawView` matrix. So the
29a246cf [deepseek-flash] #mismatch isn't a scale.
29a246cf [deepseek-flash] #
29a246cf [deepseek-flash] #Three real causes, in order of how much they'd move a wall base.
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #1. Terrain uses a 9-sample minimum; walls use a single sample
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #Terrain z, from `CreateTopoSurface`:
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #const z=ground||minz;   // minz = pickTopo(...).min, min of 9 elevations
29a246d0 [deepseek-flash] #v.push([mx,my,z,c, 0,0,0,bits]);
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #Wall base z, from `walledSpiral`:
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #const g0=topo.pickElevation(px,py);   // single sample
29a246d0 [deepseek-flash] #verts.push([px,-py,g0,pu,0,0,0,wallc]);
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #`pickTopo` samples at ±`factor*8` in index space; `pickElevation` samples once. On any relief, the
29a246d0 [deepseek-flash] #9-sample min sits below the single sample, and the difference is exactly the local relief.
29a246d0 [deepseek-flash] #Flat ground → no gap. Slope or edge → gap. That's your "varies".
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #The window is resolution-dependent: ±2 px at `res=1024`, ±8 px at `res=2048` (`m=factor*8`, then
29a246d0 [deepseek-flash] #`index` multiplies by `factor` again). So the gap also changes with tile resolution.
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #2. Missing data became a deep pit
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #`worker_baker.js setBytes` now does:
29a246d0 [deepseek-flash] #
29a246d0 [deepseek-flash] #
29a246d1 [deepseek-flash] #}else{
29a246d1 [deepseek-flash] #    topo[i]=TopoNoLevel;   // -0x4000
29a246d1 [deepseek-flash] #}
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #and `heal()` is not called in `createTopo`. Any pixel where `h==0` (LiDAR hole, water mask, swath
29a246d1 [deepseek-flash] #edge) is now −16384 units. `pickTopo` samples 9 points, so a single hole in the window pulls `minz`
29a246d1 [deepseek-flash] #to −16384 and the terrain vertex spikes down. That reads as wildly variable terrain around
29a246d1 [deepseek-flash] #buildings — much larger than the ±4–8 unit sampling effect above.
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #The old code left those as `0`, which was a benign sea-level-ish value. If you want holes visible,
29a246d1 [deepseek-flash] #that's a deliberate change; if not, `heal()` or clamp `minz` when any sample is `TopoNoLevel`.
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #3. The fixed top is 100 m
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #const h1=+1600;
29a246d1 [deepseek-flash] #verts.push([px,-py,h0+h1,pu,0,0,0,wallc]);
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #`SeaLevel=186*16` implies 16 units/m, so `1600` = 100 m. The previous line was
29a246d1 [deepseek-flash] #`sampleHeight(px,py,2).max + 16`, i.e. tracked the detail channel. If you want the wall to look
29a246d1 [deepseek-flash] #grounded, the top value is separate from the base gap — but a 100 m wall will read wrong regardless
29a246d1 [deepseek-flash] #of where the base sits.
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #What amplifies all of it
29a246d1 [deepseek-flash] #
29a246d1 [deepseek-flash] #`refreshGraphics` sets `hfac=0.77/hshift` with `hshift=1<<(level3)`, and
29a246d1 [deepseek-flash] #`TranslateZoomAngleAspect` uses `zoomz=zoomhfac/512`. So z is exaggerated 8× more at level
29a246d2 [deepseek-flash] #1 than at level 2. Terrain and walls scale together — it's not a mismatch — but any base gap
29a246d2 [deepseek-flash] #you fix at level 2 will look 8× worse at level 1.
29a246d2 [deepseek-flash] #
29a246d2 [deepseek-flash] #To close the gap
29a246d2 [deepseek-flash] #
29a246d2 [deepseek-flash] #Pick one, in increasing order of effort:
29a246d2 [deepseek-flash] #
29a246d2 [deepseek-flash] #- Match the sampling. Make the wall base `topo.pickTopo(px,py).min` instead of
29a246d2 [deepseek-flash] #`pickElevation`. Cheapest, directly cancels cause 1.
29a246d2 [deepseek-flash] #- Sink the base. `pickTopo(px,py).min - 64` (or whatever margin reads well). Robust to
29a246d2 [deepseek-flash] #future changes in terrain sampling.
29a246d2 [deepseek-flash] #- Fix the holes. Restore `heal()` in `createTopo`, or clamp in `pickTopo`:
29a246d2 [deepseek-flash] #
29a246d2 [deepseek-flash] #  if(h0===TopoNoLevel) h0=h4;   // fall back to centre sample
29a246d2 [deepseek-flash] #
29a246d2 [deepseek-flash] #  for each of the nine, before taking min. Without this, causes 1 and 3 don't matter — the pit
29a246d2 [deepseek-flash] #dominates.
29a246d2 [deepseek-flash] #- Reconsider `+1600`. If buildings should have varying height, drive it from
29a246d2 [deepseek-flash] #`sampleHeight(...).max` or from the drawing's storey attribute, not a constant.
29a246d2 [deepseek-flash] #
29a246d2 [deepseek-flash] #If after fixing 1 and 2 you still see a residual gap that scales with view level, that's `hfac` and
29a246d2 [deepseek-flash] #it's expected — both surfaces move together, so it's a look, not a bug.
29a246d2 [deepseek-flash] #
