2848b1ae [deepseek-flash] #🟠nitrologic Relay 2.0.3 deepseek-flash 🐋 🪣 0.7° $0.009 23.53KB 33.87s
2848b1ae [deepseek-flash] #No — GDScript doesn't force that. A single statement after the colon is legal, so your guard
2848b1ae [deepseek-flash] #clauses can be one-liners:
2848b1ae [deepseek-flash] #
2848b1ae [deepseek-flash] #
2848b1ae [deepseek-flash] #func is_fullscreen_toggle_event(event: InputEvent) -> bool:
2848b1ae [deepseek-flash] #	if not event is InputEventKey: return false
2848b1af [deepseek-flash] #	if not event.pressed: return false
2848b1af [deepseek-flash] #	if event.echo: return false
2848b1af [deepseek-flash] #	return event.keycode == KEY_F12
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #Three caveats:
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #- One statement only. `if x: return false` is fine; `if x: return false` plus anything else
2848b1af [deepseek-flash] #on that line is not.
2848b1af [deepseek-flash] #- `else` needs its own line. `if a: b` is allowed, but you can't chain `if a: b else: c` on
2848b1af [deepseek-flash] #one line — the `else:` starts a new line.
2848b1af [deepseek-flash] #- The style guide still prefers block form, so this is legal-but-discouraged. If your Godot
2848b1af [deepseek-flash] #build ever complains, the block form is always safe.
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #What you can't do is put a function's body on the same line as its `func` header — this is
2848b1af [deepseek-flash] #invalid:
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #func is_fullscreen_mode(mode: int) -> bool: return mode in FULLSCREEN_MODES  # invalid
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #`func` always needs a newline and an indented body.
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #If the real goal is fewer lines, though, the cleaner move is to drop the repeated `return false`
2848b1af [deepseek-flash] #and collapse the guards into one return, using a cast so you don't need the `is` check to narrow
2848b1af [deepseek-flash] #the type:
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #
2848b1af [deepseek-flash] #func is_fullscreen_toggle_event(event: InputEvent) -> bool:
2848b1b0 [deepseek-flash] #	var key_event := event as InputEventKey
2848b1b0 [deepseek-flash] #	return key_event != null \
2848b1b0 [deepseek-flash] #			and key_event.pressed \
2848b1b0 [deepseek-flash] #			and not key_event.echo \
2848b1b0 [deepseek-flash] #			and key_event.keycode == KEY_F12
2848b1b0 [deepseek-flash] #
2848b1b0 [deepseek-flash] #
2848b1b0 [deepseek-flash] #The `and` short-circuits, so `key_event.pressed` is never touched when the cast fails. One return,
2848b1b0 [deepseek-flash] #no inline calls, no repetition.
2848b1b0 [deepseek-flash] #
