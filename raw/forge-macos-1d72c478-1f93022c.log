1db18d96 [deepseek-v4] #Chroma timing verification
1db18d96 [deepseek-v4] #
1db18d96 [deepseek-v4] #Based on the updated code (`chromainit` now uses `smconfigsetout_shift(&config5,
1db18d96 [deepseek-v4] #true, true, 2)`), the autopull threshold is correctly set to 2 bits, ensuring the OSR refills after
1db18d96 [deepseek-v4] #every 16 samples.
1db18d96 [deepseek-v4] #
1db18d96 [deepseek-v4] #1. Sample rate and line alignment
1db18d96 [deepseek-v4] #
1db18d96 [deepseek-v4] #╭──────────────────────────────┬──────────────────────────────────────────────────────────────────┬───────────────────────────╮
1db18d96 [deepseek-v4] #│  Parameter                   │  Calculation                                                     │  Value                    │
1db18d96 [deepseek-v4] #├──────────────────────────────┼──────────────────────────────────────────────────────────────────┼───────────────────────────┤
1db18d96 [deepseek-v4] #│  System clock                │  `166.5 MHz`                                                     │                           │
1db18d96 [deepseek-v4] #│  Chroma PIO clock            │  `166.5 / 2.3471`                                                │  `70.94 MHz`              │
1db18d96 [deepseek-v4] #│  Sample interval             │  4 PIO cycles                                                    │  `4 / 70.94e6 = 56.4 ns`  │
1db18d96 [deepseek-v4] #│  Chroma sample rate          │  `70.94 MHz / 4`                                                 │  `17.735 MHz`             │
1db18d96 [deepseek-v4] #│  PAL colour subcarrier       │  `4.43361875 MHz × 4`                                            │  `17.734475 MHz` ✅        │
1db18d96 [deepseek-v4] #│  Active line video duration  │  (back porch + burst + active video) ≈ `5.79 + 0.56? + 51.9 μs`  │  `~54.5 μs`               │
1db18d96 [deepseek-v4] #│  Required samples per line   │  `54.5 μs × 17.735 MHz`                                          │  **≈ 967 samples**        │
1db18d96 [deepseek-v4] #╰──────────────────────────────┴──────────────────────────────────────────────────────────────────┴───────────────────────────╯
1db18d96 [deepseek-v4] #
1db18d97 [deepseek-v4] #2. Current counter and buffer size
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #- `int count = (colorWords-1)*16 - 1 = 2031` → 2031 samples per line.
1db18d97 [deepseek-v4] #- 2031 samples × 56.4 ns = 114.5 μs — exceeds the 64 μs PAL line by nearly a factor of two.
1db18d97 [deepseek-v4] #- The chroma output will overflow into the next line’s sync, corrupting the signal.
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #• Correct counter:* `967` (or 966 if zero‑indexed) → `int count = 966;`
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #3. Burst length
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #- `burst32` provides 32 samples = 8 subcarrier cycles.
1db18d97 [deepseek-v4] #- PAL requires 10±1 cycles (40±4 samples).
1db18d97 [deepseek-v4] #- Current burst length is too short by 2 cycles (8 instead of 10).
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #• Fix:* Use 40 samples: e.g., `colorWord[1] = burst32; colorWord[2] = burst32; colorWord[3]
1db18d97 [deepseek-v4] #= some 8‑sample word`.
1db18d97 [deepseek-v4] #Alternatively, store the entire burst in the first 2.5 words and adjust the data buffer
1db18d97 [deepseek-v4] #accordingly.
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #4. DMA synchronisation (critical flaw)
1db18d97 [deepseek-v4] #
1db18d97 [deepseek-v4] #The DMA is configured with `UINT32_MAX` (infinite transfer) and a ring buffer of size `2*colorWords
1db18d98 [deepseek-v4] #= 256` words.
1db18d98 [deepseek-v4] #After the first line, the chroma PIO will:
1db18d98 [deepseek-v4] #
1db18d98 [deepseek-v4] #- Wait for IRQ 4
1db18d98 [deepseek-v4] #- Read the next word from the TX FIFO as the counter
1db18d98 [deepseek-v4] #- Because the DMA never stops and keeps filling the FIFO, that word will not be the
1db18d98 [deepseek-v4] #intended counter ( `colorWord[0]` ), but a data word (e.g., `burst32` ).
1db18d98 [deepseek-v4] #
1db18d98 [deepseek-v4] #This causes the counter to be misinterpreted (e.g., `0x23102310` interpreted as a 32‑bit counter =
1db18d98 [deepseek-v4] #588,368,144 → > 1e9 samples → desync).
1db18d98 [deepseek-v4] #
1db18d98 [deepseek-v4] #• Required change:*
1db18d98 [deepseek-v4] #- Use per‑line DMA re‑trigger (like `vid_field` does for video).
1db18d98 [deepseek-v4] #- For each line, set:
1db18d98 [deepseek-v4] #  - `dmachannelsetreadaddr(chromadmachan, colorWord);` (address of counter)
1db18d98 [deepseek-v4] #  - `dmachannelsettranscount(chromadmachan, 1 + 960/16);` (1 counter word +
1db18d98 [deepseek-v4] #60 data words = 61 words)
1db18d98 [deepseek-v4] #- Restart the DMA after each IRQ, or use an interrupt when the video state machine sets IRQ 4 to
1db18d98 [deepseek-v4] #trigger the chroma DMA.
1db18d98 [deepseek-v4] #
1db18d98 [deepseek-v4] #5. V‑switch (PAL alternation)
1db18d98 [deepseek-v4] #
1db18d98 [deepseek-v4] #The buffer contains two halves (`colorWord[0..127]` for even field? Actually
1db18d98 [deepseek-v4] #`colorWord[colorWords*2]` with a ring of size 256).
1db18d99 [deepseek-v4] #There is no alternation of burst phase or colour data between lines – PAL requires the subcarrier
1db18d99 [deepseek-v4] #polarity (or at least the burst phase) to be inverted on alternate lines (the V‑switch). Without
1db18d99 [deepseek-v4] #this, the colour information will appear as hue errors on every other line.
1db18d99 [deepseek-v4] #
1db18d99 [deepseek-v4] #• Fix:*
1db18d99 [deepseek-v4] #- The buffer should contain two separate line patterns: one for even lines, one for odd lines (or
1db18d99 [deepseek-v4] #use the ring to switch between two buffers).
1db18d99 [deepseek-v4] #- The burst phase should be 180° shifted on alternate lines: e.g., use `0x3102` instead of `0x2310`
1db18d99 [deepseek-v4] #for the opposite phase.
1db18d99 [deepseek-v4] #
1db18d99 [deepseek-v4] #Summary of required corrections
1db18d99 [deepseek-v4] #
1db18d99 [deepseek-v4] #
1db18d99 [deepseek-v4] #╭──────────────────────────┬──────────────────────┬─────────────────────────────────╮
1db18d99 [deepseek-v4] #│  Aspect                  │  Current              │  Required                       │
1db18d99 [deepseek-v4] #├──────────────────────────┼──────────────────────┼─────────────────────────────────┤
1db18d99 [deepseek-v4] #│  Samples per line        │  2031                 │  967                            │
1db18d99 [deepseek-v4] #│  Burst length            │  32 samples (8 cycles)│  40 samples (10 cycles)         │
1db18d99 [deepseek-v4] #│  DMA mode                │  Infinite, ring       │  Single‑shot per line           │
1db18d99 [deepseek-v4] #│  DMA trigger             │  None (always running)│  On IRQ 4 from video PIO       │
1db18d99 [deepseek-v4] #│  PAL V‑switch            │  No alternation       │  Alternate burst phase + data  │
1db18d99 [deepseek-v4] #╰──────────────────────────┴──────────────────────┴─────────────────────────────────╯
1db18d99 [deepseek-v4] #
