1e071a8a [gemini-3.1-pro] #You cannot directly "jump on a bit" in the OSR or FIFO.
1e071a8a [gemini-3.1-pro] #
1e071a8a [gemini-3.1-pro] #There is a trick where you can use `out pc, 2` to shift 2 bits from the pixel stream
1e071a8a [gemini-3.1-pro] #directly into the Program Counter, acting like a `switch` statement. However, it is dangerous: it
1e071a8a [gemini-3.1-pro] #jumps to absolute addresses `0`, `1`, `2`, or `3` in the PIO instruction memory, which
1e071a8a [gemini-3.1-pro] #completely breaks if your program is loaded at any offset other than 0.
1e071a8a [gemini-3.1-pro] #
1e071a8a [gemini-3.1-pro] #But because you are using the RP2350, you don't need to jump at all. You can use the
1e071a8a [gemini-3.1-pro] #RP2350's indexed FIFO reads to create a branchless lookup table.
1e071a8a [gemini-3.1-pro] #
1e071a8a [gemini-3.1-pro] #Since `COLORI` (GP0-1) and `PUMPENABLE` (GP2-5) are perfectly contiguous, we can preload
1e071a8a [gemini-3.1-pro] #the `colorpump`'s unused RX FIFO with the exact 6-bit pin states for each color. This reduces your
1e071a8a [gemini-3.1-pro] #20-line decoding tree into two instructions, naturally taking exactly 10 cycles every time.
1e071a8a [gemini-3.1-pro] #
1e071a8a [gemini-3.1-pro] #1. The Branchless `colorpump.pio`
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #; colorpump.pio
1e071a8b [gemini-3.1-pro] #; Branchless 10-cycle pixel pump using RP2350 RX FIFO lookup
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #.program colorpump
1e071a8b [gemini-3.1-pro] #.wrap_target
1e071a8b [gemini-3.1-pro] #	wait 1 irq 0 clear
1e071a8b [gemini-3.1-pro] #	mov	x, isr                ; Load pixel count (863) into X
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #pixel:
1e071a8b [gemini-3.1-pro] #	out	y, 2                  ; [1] Pop 2-bit pixel index into Y
1e071a8b [gemini-3.1-pro] #	mov	pins, rxfifo[y]       ; [1] Output combined color index + pump pulse!
1e071a8b [gemini-3.1-pro] #	set	pins, 15 [1]          ; [2] Return pump pins (GP2-5) high. Color pins stay set.
1e071a8b [gemini-3.1-pro] #	nop	[4]                   ; [5] Pad to exactly 10 cycles
1e071a8b [gemini-3.1-pro] #	jmp	x--, pixel            ; [1] Loop until line is done
1e071a8b [gemini-3.1-pro] #.wrap
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #2. How to preload the Lookup Table in C++
1e071a8b [gemini-3.1-pro] #
1e071a8b [gemini-3.1-pro] #To make `mov pins, rxfifo[y]` work, we have to push the four 6-bit states into the RX FIFO before
1e071a8c [gemini-3.1-pro] #the state machine starts.
1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #Here are the 6-bit values for GP5 down to GP0:
1e071a8c [gemini-3.1-pro] #• Color 0 (00): Pump 0 low (GP2=0). Binary `1110 00` = 56
1e071a8c [gemini-3.1-pro] #• Color 1 (01): Pump 1 low (GP3=0). Binary `1101 01` = 53
1e071a8c [gemini-3.1-pro] #• Color 2 (10): Pump 2 low (GP4=0). Binary `1011 10` = 46
1e071a8c [gemini-3.1-pro] #• Color 3 (11): Pump 3 low (GP5=0). Binary `0111 11` = 31
1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #In `vidbit.cpp`, update your `colorpump_init` with this configuration. Notice we change the `out`
1e071a8c [gemini-3.1-pro] #pin count to 6 so `mov pins` can drive both the color and the pump pins simultaneously:
1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #	pio_sm_config config6 = colorpump_program_get_default_config(offset6);
