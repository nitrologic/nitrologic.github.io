1eee43c2 [deepseek-v4] #
1eee43c2 [deepseek-v4] #The inner loop body is `nop [31]` (32 cycles) + `jmp x--, inner` (1 cycle) = 33 cycles per inner
1eee43c2 [deepseek-v4] #iteration.
