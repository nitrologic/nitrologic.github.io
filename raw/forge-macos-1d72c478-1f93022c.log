1eee43c2 [deepseek-v4] #│  Step                        │  Cycles                         │
1eee43c2 [deepseek-v4] #├──────────────────────────────┼─────────────────────────────────┤
1eee43c2 [deepseek-v4] #│  `set pins,1`                │  1                              │
1eee43c2 [deepseek-v4] #│  `set z,5`                   │  1                              │
1eee43c2 [deepseek-v4] #│  **Outer loop** (6 times)    │                                 │
1eee43c2 [deepseek-v4] #│  `set y,31`                  │  1                              │
1eee43c2 [deepseek-v4] #│  **Middle loop** (32 times)  │                                 │
1eee43c2 [deepseek-v4] #│  `set x,31`                  │  1                              │
1eee43c2 [deepseek-v4] #│  **Inner loop** (32 times)   │                                 │
1eee43c2 [deepseek-v4] #│  `nop [31]`                  │  32                             │
1eee43c2 [deepseek-v4] #│  `jmp x--,inner`             │  1                              │
1eee43c3 [deepseek-v4] #│  *inner total*               │  33×32 = 1056                   │
1eee43c3 [deepseek-v4] #│  `jmp y--,mid`               │  1                              │
