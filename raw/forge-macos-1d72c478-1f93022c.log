1eacfda5 [deepseek-v4] #throughput matches the pixel rate: 864 pixels per line at 10 cycles/pixel gives 8640 cycles active;
1eacfda5 [deepseek-v4] #the remaining 2016 cycles (sync + porch) must be accounted for in all stages, including stalling
