1e072972 [gemini-3.1-pro] #
1e072972 [gemini-3.1-pro] #.program colorpump
1e072972 [gemini-3.1-pro] #.wrap_target
1e072972 [gemini-3.1-pro] #	wait	1 irq 0 clear
1e072972 [gemini-3.1-pro] #	mov	y, isr
1e072972 [gemini-3.1-pro] #
1e072972 [gemini-3.1-pro] #pixel:
1e072972 [gemini-3.1-pro] #	out	pins, 2        ; [1] Output 2 color bits to GP0, GP1
1e072972 [gemini-3.1-pro] #	out	x, 2           ; [1] Shift 2 pump select bits into X
1e072972 [gemini-3.1-pro] #
1e072972 [gemini-3.1-pro] #	jmp	!x t0          ; [1] If X==0, jump to t0
1e072973 [gemini-3.1-pro] #	jmp	x-- check_1    ; [1] X was >0, decrement to check next
1e072973 [gemini-3.1-pro] #check_1:
1e072973 [gemini-3.1-pro] #	jmp	!x t1          ; [1] If X==0 (was 1), jump to t1
