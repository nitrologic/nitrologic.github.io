1e8285f9 [deepseek-v4] #Thank you for the detailed timing analysis. I'll verify the porch durations in `vidbit.pio` against
1e8285f9 [deepseek-v4] #the PAL 576i line timing (166.5 MHz, 10656 cycles per line).
1e8285f9 [deepseek-v4] #
1e8285f9 [deepseek-v4] #Line total check
1e8285f9 [deepseek-v4] #The line loop executes:
1e8285f9 [deepseek-v4] #1. HSYNC – `set` (2 cycles) + `set y, 26` (1) + `jmp y--, hsync [28]` loop of 26 iterations
1e8285fa [deepseek-v4] #× 29 cycles/iteration = 754 → sum 757 cycles
1e8285fa [deepseek-v4] #2. Back porch – `set pindirs,0` (1) + `set pins,1` (1) + `set y, 26` (1) + loop 26 × 32 =
1e8285fa [deepseek-v4] #832 → sum 835 cycles
1e8285fa [deepseek-v4] #3. Active video – `mov y, isr` (1) + loop 864 × 10 = 8640 → sum 8641 cycles
1e8285fa [deepseek-v4] #(comment says 8642, but the first `out pindirs,1` is inside the loop, so 8641 is correct)
1e8285fa [deepseek-v4] #4. Front porch – `set pindirs,0` (1) + `set y, 9` (1) + loop 9 × 32 = 288 → sum 290
1e8285fa [deepseek-v4] #cycles
1e8285fa [deepseek-v4] #5. Final jump – `jmp x--, line [12]` = 13 cycles
1e8285fa [deepseek-v4] #
1e8285fa [deepseek-v4] #• Total line = 757 + 835 + 8641 + 290 + 13 = 10536 cycles – 120 cycles
1e8285fa [deepseek-v4] #short* of the required 10656.
1e8285fa [deepseek-v4] #
1e8285fa [deepseek-v4] #Comment vs. actual cycles
1e8285fa [deepseek-v4] #╭───────────────┬────────────────────┬───────────────────┬──────────────╮
1e8285fa [deepseek-v4] #│  Section      │  Comment (cycles)  │  Actual (cycles)  │  Difference  │
1e8285fa [deepseek-v4] #├───────────────┼────────────────────┼───────────────────┼──────────────┤
1e8285fa [deepseek-v4] #│  HSYNC        │  786 (27×29+3)     │  757 (26×29+3)    │  –29         │
1e8285fa [deepseek-v4] #│  Back porch   │  964 (30×32+4)     │  835 (26×32+3)    │  –129        │
1e8285fa [deepseek-v4] #│  Active       │  8642 (864×10+2)   │  8641             │  –1          │
1e8285fa [deepseek-v4] #│  Front porch  │  258 (8×32+2)      │  290 (9×32+2)     │  +32         │
1e8285fa [deepseek-v4] #│  Final jmp    │  13 (1+12)         │  13               │  0           │
1e8285fa [deepseek-v4] #╰───────────────┴────────────────────┴───────────────────┴──────────────╯
1e8285fa [deepseek-v4] #
1e8285fa [deepseek-v4] #Root cause
1e8285fa [deepseek-v4] #The `HSYNCWAIT29`, `BACKPORCHWAIT32`, and `FRONTPORCH_WAIT32` defines are
1e8285fa [deepseek-v4] #incorrect. They should be:
1e8285fb [deepseek-v4] #
1e8285fb [deepseek-v4] #- `HSYNC_WAIT29` = 27 (to give 27 × 29 = 783 cycles + 3 setup = 786)
1e8285fb [deepseek-v4] #- `BACKPORCH_WAIT32` = 30 (to give 30 × 32 = 960 + 4 setup = 964)
1e8285fb [deepseek-v4] #- `FRONTPORCH_WAIT32` = 8 (to give 8 × 32 = 256 + 2 setup = 258)
1e8285fb [deepseek-v4] #
1e8285fb [deepseek-v4] #With these corrections:
1e8285fb [deepseek-v4] #- HSYNC = 786
1e8285fb [deepseek-v4] #- Back porch = 964
1e8285fb [deepseek-v4] #- Active = 8641 (unchanged, but comment says 8642 – likely off-by-one in the comment; actual active
1e8285fb [deepseek-v4] #loop is 8641 cycles, which is acceptable)
1e8285fb [deepseek-v4] #- Front porch = 258
1e8285fb [deepseek-v4] #- Final jmp = 13
1e8285fb [deepseek-v4] #• Sum = 786 + 964 + 8641 + 258 + 13 = 10662 cycles – still 6 cycles over* the
1e8285fb [deepseek-v4] #required 10656.
1e8285fb [deepseek-v4] #
1e8285fb [deepseek-v4] #Remaining discrepancy
1e8285fb [deepseek-v4] #The overshoot of 6 cycles can be absorbed by:
1e8285fb [deepseek-v4] #- Reducing the `active` loop count by 1 (863 iterations → 8630 cycles, total 10652) and adding 4
1e8285fb [deepseek-v4] #more cycles elsewhere, or
1e8285fb [deepseek-v4] #- Adjusting the final `jmp` delay from 12 to 6 (7 cycles total) and keeping active at 864
1e8285fb [deepseek-v4] #iterations → 10656 exactly.
1e8285fb [deepseek-v4] #
1e8285fb [deepseek-v4] #Given that the active video line is typically 864 pixels, I recommend reducing the final JMP
1e8285fb [deepseek-v4] #delay to `[6]` (7 cycles), which trims the line total by exactly 6 cycles to 10656. This
1e8285fb [deepseek-v4] #preserves the 864-pixel active period.
1e8285fb [deepseek-v4] #
1e8285fc [deepseek-v4] #Summary of required changes in `vidbit.pio`
1e8285fc [deepseek-v4] #
1e8285fc [deepseek-v4] #.define HSYNC_WAIT29 27
1e8285fc [deepseek-v4] #.define BACKPORCH_WAIT32 30
1e8285fc [deepseek-v4] #.define FRONTPORCH_WAIT32 8
1e8285fc [deepseek-v4] #...
1e8285fc [deepseek-v4] #    jmp x--,line [6]          ; changed from [12] to [6]
1e8285fc [deepseek-v4] #
1e8285fc [deepseek-v4] #
1e8285fc [deepseek-v4] #After these adjustments, the porch timings will match the expected PAL 576i specification. Let me
1e8285fc [deepseek-v4] #know if you'd like a corrected version of the file or help verifying the vsync preamble timing as
1e8285fc [deepseek-v4] #well.
