1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #	// SET maps only to the 4 pump pins (GP2..GP5) to pull them back high
1e071a8c [gemini-3.1-pro] #	sm_config_set_set_pins(&config6, PUMP0_ENABLE, 4);
1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #	for(int i = 0; i < 6; i++) pio_gpio_init(pio, COLOR_I0 + i);
1e071a8c [gemini-3.1-pro] #
1e071a8c [gemini-3.1-pro] #	pio_sm_set_consecutive_pindirs(pio, sm, COLOR_I0, 6, true);
1e071a8c [gemini-3.1-pro] #
1e071a8d [gemini-3.1-pro] #	pio_sm_init(pio, sm, offset6, &config6);
1e071a8d [gemini-3.1-pro] #
