1e072973 [gemini-3.1-pro] #check_2:
1e072973 [gemini-3.1-pro] #	jmp	!x t2          ; [1] If X==0 (was 2), jump to t2
1e072973 [gemini-3.1-pro] #
1e072973 [gemini-3.1-pro] #t3: ; Reached in 7 cycles (X=3)
1e072973 [gemini-3.1-pro] #	set	pins, 7        ; [1] Pulse PUMP3 low
1e072973 [gemini-3.1-pro] #	set	pins, 15       ; [1] Return all pumps high
1e072973 [gemini-3.1-pro] #	jmp	y--, pixel     ; [1] -> Total 10 cycles
1e072973 [gemini-3.1-pro] #
1e072973 [gemini-3.1-pro] #t2: ; Reached in 7 cycles (X=2)
1e072973 [gemini-3.1-pro] #	set	pins, 11       ; [1] Pulse PUMP2 low
1e072973 [gemini-3.1-pro] #	set	pins, 15       ; [1] Return all pumps high
1e072973 [gemini-3.1-pro] #	jmp	y--, pixel     ; [1] -> Total 10 cycles
1e072973 [gemini-3.1-pro] #
1e072973 [gemini-3.1-pro] #t1: ; Reached in 5 cycles (X=1)
1e072973 [gemini-3.1-pro] #	nop	[1]            ; [2] Pad to balance timing
1e072973 [gemini-3.1-pro] #	set	pins, 13       ; [1] Pulse PUMP1 low
1e072973 [gemini-3.1-pro] #	set	pins, 15       ; [1] Return all pumps high
1e072973 [gemini-3.1-pro] #	jmp	y--, pixel     ; [1] -> Total 10 cycles
1e072974 [gemini-3.1-pro] #
1e072974 [gemini-3.1-pro] #t0: ; Reached in 3 cycles (X=0)
1e072974 [gemini-3.1-pro] #	nop	[3]            ; [4] Pad to balance timing
