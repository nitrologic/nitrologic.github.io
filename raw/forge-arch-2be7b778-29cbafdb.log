29cec94e [deepseek-flash] #
29cec94e [deepseek-flash] #- venv + pip – `python -m venv env1 && source env1/bin/activate && pip install ultralytics`
29cec94e [deepseek-flash] #→ `env1/bin/yolo`
29cec94e [deepseek-flash] #- pip --user – `pip install --user ultralytics` → `~/.local/bin/yolo`
29cec94e [deepseek-flash] #- pipx – `pipx install ultralytics` → `~/.local/bin/yolo`
29cec94e [deepseek-flash] #- system pip – `sudo pip install ultralytics` → `/usr/local/bin/yolo`
29cec94e [deepseek-flash] #- AUR – `yay -S python-ultralytics` → `/usr/bin/yolo`
29cec94e [deepseek-flash] #- conda/mamba – `conda install -c conda-forge ultralytics` → `$CONDA_PREFIX/bin/yolo`
29cec94e [deepseek-flash] #- uv tool – `uv tool install ultralytics` → `~/.local/bin/yolo`
29cec94e [deepseek-flash] #
29cec94e [deepseek-flash] #If you created the venv with `--system-site-packages`, it can import system packages, but the
29cec94e [deepseek-flash] #`yolo` script stays in `/usr/bin`. That would still be found if `/usr/bin` is on `PATH`.
29cec94e [deepseek-flash] #
29cec94e [deepseek-flash] #To reinstall cleanly with NVIDIA CUDA support on Arch:
29cec94e [deepseek-flash] #
29cec94e [deepseek-flash] #1. Make sure the NVIDIA driver and CUDA are working:
29cec94e [deepseek-flash] #
29cec94e [deepseek-flash] #   nvidia-smi
29cec94e [deepseek-flash] #
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #2. Create and activate a fresh venv:
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #   python -m venv ~/yolo-env
29cec94f [deepseek-flash] #   source ~/yolo-env/bin/activate
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #3. Install PyTorch with CUDA. Check the current command at <https://pytorch.org>. For CUDA 12.1:
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #   pip install torch torchvision --index-url https://download.pytorch.org/whl/cu121
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #   For CUDA 12.4:
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #   pip install torch torchvision --index-url https://download.pytorch.org/whl/cu124
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #4. Verify CUDA is visible to PyTorch:
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #   python -c "import torch; print(torch.cuda.is_available())"
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #5. Install Ultralytics:
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #   pip install ultralytics
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #
29cec94f [deepseek-flash] #6. Now `yolo` should be in `~/yolo-env/bin/yolo`. With the venv active, run:
29cec950 [deepseek-flash] #
29cec950 [deepseek-flash] #   yolo predict model=yolov8n.pt source=image.jpg
29cec950 [deepseek-flash] #
29cec950 [deepseek-flash] #
29cec950 [deepseek-flash] #If `ultralytics` is importable but the `yolo` script is missing, force a reinstall to regenerate
29cec950 [deepseek-flash] #entry points:
29cec950 [deepseek-flash] #
29cec950 [deepseek-flash] #
29cec950 [deepseek-flash] #pip install --force-reinstall ultralytics
29cec950 [deepseek-flash] #
29cec950 [deepseek-flash] #
