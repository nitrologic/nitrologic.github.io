29cebb8e [deepseek-flash] #Yes — `ls -d */` is the standard way to list only directories in the current directory.
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #How it works:
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #- `*/` is expanded by the shell, not by `ls`. It matches only directory entries.
29cebb8e [deepseek-flash] #- `-d` tells `ls` to show the directory names themselves, not their contents.
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #Caveats:
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #- Hidden directories are not included.
29cebb8e [deepseek-flash] #- If there are no matching directories:
29cebb8e [deepseek-flash] #  - Bash by default passes the literal `/` to `ls`, causing an error like `ls: cannot access
29cebb8e [deepseek-flash] #'/': No such file or directory`.
29cebb8e [deepseek-flash] #  - Zsh errors with `no matches found`.
29cebb8e [deepseek-flash] #- Directory names beginning with `-` can be mistaken for options. Using `--` helps:
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #ls -d -- */
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #
29cebb8e [deepseek-flash] #If you want hidden directories too, or a more robust listing, `find` is usually better:
29cebb8e [deepseek-flash] #
29cebb8f [deepseek-flash] #
29cebb8f [deepseek-flash] #find . -mindepth 1 -maxdepth 1 -type d
29cebb8f [deepseek-flash] #
29cebb8f [deepseek-flash] #
29cebb8f [deepseek-flash] #For just names, sorted:
29cebb8f [deepseek-flash] #
29cebb8f [deepseek-flash] #
29cebb8f [deepseek-flash] #find . -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
29cebb8f [deepseek-flash] #
