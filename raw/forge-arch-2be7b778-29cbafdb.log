29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #head -n 5 ak1.txt; wc -l ak1.txt
29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #Likely causes, in order of probability:
29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #1. `run.sh` points at a directory with no images. The previous run pointed at a hardcoded
29cef74a [deepseek-flash] #path that didn’t exist; you probably edited it to something else that’s also wrong — an empty dir,
29cef74a [deepseek-flash] #or `runs/`, or `content/`.
29cef74a [deepseek-flash] #2. `run.sh` points at `ak1.txt` thinking Ultralytics will parse it. Ultralytics treats a
29cef74a [deepseek-flash] #`.txt` source as a list of image paths, one per line. If `ak1.txt` holds annotations
29cef74a [deepseek-flash] #(`class x1 y1 x2 y2 …`), none of those lines are valid files and the loader ends up with nothing
29cef74a [deepseek-flash] #usable.
29cef74a [deepseek-flash] #3. Shell glob that expanded to nothing. If `run.sh` has `source=/some/dir/.jpg` and no
29cef74a [deepseek-flash] #jpgs match, bash passes the literal `.jpg` through.
29cef74a [deepseek-flash] #
29cef74a [deepseek-flash] #Isolate it with a known-good source:
