29ceb95a [deepseek-flash] #
29ceb95a [deepseek-flash] #  Bad `LD_PRELOAD` can make every dynamically linked program fail. `env -i /bin/ls` bypasses that.
29ceb95a [deepseek-flash] #- It hangs in a directory: likely stale NFS/CIFS or a huge directory. Check `mount`, `df -h .`, and
29ceb95a [deepseek-flash] #try:
