29ced996 [deepseek-flash] #For your setup the relevant question is two-fold: does PyTorch see CUDA (for `.pt` models), and
29ced996 [deepseek-flash] #does ONNX Runtime use the CUDA execution provider (for `.onnx` models). They’re independent.
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #• 1. PyTorch / Ultralytics path (`.pt` files like `yolov8n.pt`, `yolo11m-obb.pt`):*
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #cd ~/nitrologic/onnx
29ced996 [deepseek-flash] #source env3/bin/activate
29ced996 [deepseek-flash] #python -c "import torch; print(torch.__version__, torch.version.cuda, torch.cuda.is_available(), torch.cuda.get_device_name(0))"
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #Want: a CUDA version (e.g. `12.4`), `True`, and your GPU name. If `torch.version.cuda` is `None`,
29ced996 [deepseek-flash] #that’s a CPU-only wheel.
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #Then confirm Ultralytics is picking the GPU:
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #yolo predict model=models/yolov8n.pt source=data/images/84802.png device=0 verbose=True
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #Look for `device=0` or `cuda:0` in the header, not `cpu`.
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #• 2. ONNX Runtime path (`.onnx` files like `yoloe_model.onnx`):*
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #python -c "import onnxruntime as ort; print(ort.__version__); print(ort.get_available_providers())"
29ced996 [deepseek-flash] #
29ced996 [deepseek-flash] #
29ced997 [deepseek-flash] #You want `CUDAExecutionProvider` in that list. If you only see `CPUExecutionProvider`, you have
29ced997 [deepseek-flash] #`onnxruntime` (CPU) installed instead of `onnxruntime-gpu`:
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #pip uninstall -y onnxruntime onnxruntime-gpu
29ced997 [deepseek-flash] #pip install onnxruntime-gpu
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #Check the CUDA/cuDNN libs it can find:
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #python - <<'EOF'
29ced997 [deepseek-flash] #import onnxruntime as ort
29ced997 [deepseek-flash] #print(ort.get_device())
29ced997 [deepseek-flash] #print(ort.get_available_providers())
29ced997 [deepseek-flash] #EOF
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #If `CUDAExecutionProvider` is listed but inference still runs on CPU, ONNX Runtime couldn’t load
29ced997 [deepseek-flash] #`libcublas` / `libcudnn` at runtime. The `onnxruntime-gpu` wheel bundles compatible CUDA libs for
29ced997 [deepseek-flash] #recent versions; mismatched versions between torch’s CUDA and ORT’s expected CUDA is the usual
29ced997 [deepseek-flash] #culprit.
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #• 3. In your scripts, check how the device/provider is chosen.*
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #Look at `predict.py` and `count.py`:
29ced997 [deepseek-flash] #
29ced997 [deepseek-flash] #
29ced998 [deepseek-flash] #grep -nE 'device|providers|CUDAExecutionProvider|torch\.cuda|onnxruntime|SessionOptions' predict.py count.py
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #Typical patterns you want to see:
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #- Ultralytics: `model.predict(..., device=0)` or `model.to('cuda')`.
29ced998 [deepseek-flash] #- Raw ONNX Runtime: `ort.InferenceSession(path, providers=['CUDAExecutionProvider',
29ced998 [deepseek-flash] #'CPUExecutionProvider'])`. Provider order matters — CUDA first.
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #If the script hardcodes `providers=['CPUExecutionProvider']` or passes `device='cpu'`, that’s why
29ced998 [deepseek-flash] #it’s slow, not a driver problem.
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #• 4. Sanity check that the driver itself is fine:*
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #nvidia-smi
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #If this works, the kernel driver is loaded and CUDA libraries from the wheels should be able to
29ced998 [deepseek-flash] #talk to it. If it doesn’t, nothing above will help — fix the driver first.
29ced998 [deepseek-flash] #
29ced998 [deepseek-flash] #• 5. If you want the actual device being used at runtime*, add this to whichever script is
29ced998 [deepseek-flash] #the entry point and run it once:
