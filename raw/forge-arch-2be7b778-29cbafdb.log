29ef885a [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.002 515B 9.65s
29ef885a [deepseek-flash] #It depends what you mean by “simplest”:
29ef885a [deepseek-flash] #
29ef885a [deepseek-flash] #- Just play files, minimal player: `mpg123`
29ef885a [deepseek-flash] #  - Install: `sudo pacman -S mpg123`
29ef885a [deepseek-flash] #  - Play: `mpg123 song.mp3`
29ef885a [deepseek-flash] #  - Play a folder: `mpg123 *.mp3`
29ef885a [deepseek-flash] #  - Controls: `mpg123 -C *.mp3` then use `p` pause, `s` stop, `f`/`b` next/back.
29ef885a [deepseek-flash] #
29ef885a [deepseek-flash] #- One player for most formats, still simple: `mpv`
29ef885a [deepseek-flash] #  - Install: `sudo pacman -S mpv`
29ef885a [deepseek-flash] #  - Audio only: `mpv --no-video song.flac`
29ef885a [deepseek-flash] #  - Playlist: `mpv --no-video ~/Music/*.flac`
29ef885a [deepseek-flash] #  - Keys: space pause, `>` next, `<` previous, `q` quit.
29ef885b [deepseek-flash] #
29ef885b [deepseek-flash] #- Simple TUI with library/playlists: `cmus`
29ef885b [deepseek-flash] #  - Install: `sudo pacman -S cmus`
29ef885b [deepseek-flash] #  - Run: `cmus`
29ef885b [deepseek-flash] #  - Press `5` for file browser, `a` to add, `Enter` to play.
29ef885b [deepseek-flash] #
29ef885b [deepseek-flash] #- Alternative simple TUI: `moc`
29ef885b [deepseek-flash] #  - Install: `sudo pacman -S moc`
29ef885b [deepseek-flash] #  - Run: `mocp`
29ef885b [deepseek-flash] #
29ef885b [deepseek-flash] #For the absolute simplest command-line player, use mpg123. If you want broad format support
29ef885b [deepseek-flash] #with almost no setup, use mpv. If you want a proper music library interface, use
29ef885b [deepseek-flash] #cmus or moc.
29ef885b [deepseek-flash] #
