29cbd387 [deepseek-flash] #`slopDate(minDate)` will then compute `epoch + MAX_SAFE_INTEGER * 62.5` — roughly year 4.4 billion
29cbd387 [deepseek-flash] #— and print something absurd. Guard it:
29cbd387 [deepseek-flash] #
29cbd387 [deepseek-flash] #
29cbd387 [deepseek-flash] #if(maxDate>0){
29cbd387 [deepseek-flash] #	console.log("nitrologic slop fountain relay usage from",slopDate(minDate),"to",slopDate(maxDate));
29cbd387 [deepseek-flash] #}
29cbd387 [deepseek-flash] #
29cbd387 [deepseek-flash] #
29cbd388 [deepseek-flash] #• Stats still cover the raw input*
29cbd388 [deepseek-flash] #
29cbd388 [deepseek-flash] #`sessionCount`, `failCount`, `vendors` and `models` are all updated before the cutoff test, so the
29cbd388 [deepseek-flash] #printed histograms don't match the files in `history/`. If that's intentional (raw summary
29cbd388 [deepseek-flash] #alongside refined output), fine — but the log doesn't say so, and a future reader will assume they
29cbd388 [deepseek-flash] #agree.
29cbd388 [deepseek-flash] #
29cbd388 [deepseek-flash] #• Unused*
29cbd388 [deepseek-flash] #
29cbd388 [deepseek-flash] #- `slopmark` — nothing calls it now.
29cbd388 [deepseek-flash] #- `bigCount` — incremented, never read.
29cbd388 [deepseek-flash] #- `m` in `parseHeader` — parsed, never used.
