2a1b021c [deepseek-flash] #🟠nitrologic Relay 2.0.4 deepseek-flash 🐋 🪠 0.7° $0.015 1.377MB 23.75s
2a1b021c [deepseek-flash] #Yes, and it is a natural extension of what that script already does. The current output captures
2a1b021c [deepseek-flash] #shape (which classes exist and which category they fall into); it does not capture
2a1b021c [deepseek-flash] #interface. `ClassDB` exposes enough to close most of that gap.
2a1b021c [deepseek-flash] #
2a1b021d [deepseek-flash] #What ClassDB can give you
2a1b021d [deepseek-flash] #
2a1b021d [deepseek-flash] #For each registered class:
2a1b021d [deepseek-flash] #
2a1b021d [deepseek-flash] #- `class_get_method_list(class, no_inheritance)` — name, arguments (each with `name`, `type`,
2a1b021d [deepseek-flash] #`class_name`, `hint`, `hint_string`), return dict of the same shape, and `flags` you can mask
2a1b021d [deepseek-flash] #against `METHOD_FLAG_STATIC`, `METHOD_FLAG_VIRTUAL`, `METHOD_FLAG_VARARG`, `METHOD_FLAG_CONST`.
2a1b021d [deepseek-flash] #- `class_get_property_list(class, no_inheritance)` — name, type, hint, `usage` flags, `class_name`.
2a1b021d [deepseek-flash] #- `class_get_signal_list(class, no_inheritance)` — signal name and argument list.
2a1b021d [deepseek-flash] #- `class_get_integer_constant_list` plus `class_get_integer_constant` and
2a1b021d [deepseek-flash] #`class_get_integer_constant_enum` — constant values and which enum they belong to.
2a1b021d [deepseek-flash] #- `class_get_enum_list` and `class_get_enum_constants` — enum membership.
2a1b021d [deepseek-flash] #- `get_parent_class`, `class_get_api_type` (`"core"`, `"editor"`, `"extension"`),
2a1b021d [deepseek-flash] #`can_instantiate`, `is_class_enabled`.
2a1b021d [deepseek-flash] #
2a1b021d [deepseek-flash] #Passing `no_inheritance = true` keeps each class entry compact and lets a consumer walk the parent
2a1b021d [deepseek-flash] #chain itself — which is usually what you want for tooling.
2a1b021d [deepseek-flash] #
2a1b021d [deepseek-flash] #What ClassDB cannot give you
2a1b021d [deepseek-flash] #
2a1b021d [deepseek-flash] #Four things have to come from elsewhere:
2a1b021d [deepseek-flash] #
2a1b021d [deepseek-flash] #1. Argument default values. The method dict does not carry them, so you cannot recover
2a1b021d [deepseek-flash] #`delta: float = 0.0` from reflection.
2a1b021d [deepseek-flash] #2. Property setter/getter names. `PropertyInfo` holds them in C++ but they are not exported
2a1b021d [deepseek-flash] #into the scripting dictionary.
2a1b021d [deepseek-flash] #3. Prose. Descriptions, notes, `[b]`-marked warnings, code samples, "see also".
2a1b021d [deepseek-flash] #4. `@GlobalScope` and `@GDScript` members. Global functions are not enumerable through
2a1b021d [deepseek-flash] #ClassDB; the current script hardcodes the two pseudo-class names for this reason.
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #All four live in the class reference XML under `doc/classes/*.xml` in the Godot source tree, tagged
2a1b021e [deepseek-flash] #per release. Fetching the tag that matches `Engine.get_version_info().string` and parsing with the
2a1b021e [deepseek-flash] #built-in `XMLParser` is the straightforward path.
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #Two realistic shapes
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #- Structural only. Everything ClassDB knows, no prose. Roughly 10–25 MB of JSON for a full
2a1b021e [deepseek-flash] #4.x tree, dropping to a couple of MB gzipped. Works at runtime, no network, no XML.
2a1b021e [deepseek-flash] #- Merged with doc XML. Adds descriptions, defaults, setter/getter, globals. Multiplies the
2a1b021e [deepseek-flash] #raw size but makes the file self-sufficient offline.
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #Either can be emitted as one file or split per class with a manifest — splitting is friendlier for
2a1b021e [deepseek-flash] #diffing between engine versions and for lazy loading.
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #Caveats worth knowing up front
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #- Editor-only classes require an editor binary. A standalone `--script` run on a template build
2a1b021e [deepseek-flash] #will silently omit them; the current `editors.is_empty()` case would be the signal to watch.
2a1b021e [deepseek-flash] #- `type_string` and `TYPE_MAX` are stable enough for the variant list, but the numeric range shifts
2a1b021e [deepseek-flash] #between releases.
2a1b021e [deepseek-flash] #- The current `0.2.0` shape is a fine index. A richer document is a different artifact;
2a1b021e [deepseek-flash] #keeping both, with the index as a manifest pointing into per-class files, is probably the cleanest
2a1b021e [deepseek-flash] #arrangement.
2a1b021e [deepseek-flash] #
2a1b021e [deepseek-flash] #If you want, I can draft the extension to `scrapeSchema.gd` that adds methods, properties, signals,
2a1b021e [deepseek-flash] #constants, and enums per class — either as one expanded schema or as a manifest plus per-class
2a1b021e [deepseek-flash] #files. The doc-XML merge is a separate piece and can follow once the structural half is settled.
2a1b021e [deepseek-flash] #
